<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <!--Ahead-of-time compilation. The AOT *step* runs on publish only, so `dotnet build` and `dotnet run`
        stay as quick as they were and the whole test suite still runs against an ordinary build.

        The `wasm-tools` workload is a different matter: it is required the moment this project is
        evaluated, not when it is published.

            dotnet workload install wasm-tools

        Without it `dotnet restore` fails with NETSDK1147 before anything is compiled - which is what CI
        did on the first push, on a runner that had the SDK and not the workload. Both workflows install
        it now; this comment and those steps say the same thing so neither can quietly stop being true.

        What it buys and what it costs are measured, not assumed - see DOCUMENTATION.md. In short: opening
        twenty thousand elements goes from 1,366 ms to 748 ms, the payload roughly doubles, and the publish
        takes minutes instead of seconds. Editing and panning do not move, because those are the browser
        laying out nodes rather than anything C# does.

        Set to false to get all three back - but delete obj\Release first. An incremental publish across
        the switch reuses intermediates built for the other mode and produces an app that dies on boot
        with a mono interpreter assertion, rather than anything that looks like a build error.-->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <!--The other three projects all sit under this one's directory, so keep their sources out of the app's
      default globs. GdsII is referenced below as a project; the CLI and the tests reference inward.

      Their obj folders matter as much as their sources: a generated AssemblyInfo.cs swept up from one of
      them collides with this project's own, and the error names this project's file rather than the one
      that was picked up.-->
  <ItemGroup>
    <Compile Remove="GdsII\**" />
    <Content Remove="GdsII\**" />
    <EmbeddedResource Remove="GdsII\**" />
    <None Remove="GdsII\**" />

    <Compile Remove="GdsII.Cli\**" />
    <Content Remove="GdsII.Cli\**" />
    <EmbeddedResource Remove="GdsII.Cli\**" />
    <None Remove="GdsII.Cli\**" />

    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!--The GDSII format itself: reading, writing, validating, flattening. The app is one consumer of it.-->
  <ItemGroup>
    <ProjectReference Include="GdsII\GdsII.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.0.6" />

    <!--Reads the words out of a PDF for a model set to take them as text - see Ai/PdfText.cs (2026-11-07, from
        GraphDBViewer, which pins the same version). Part of the download from the start, about 810 KB compressed of
        some 10 MB: GraphDBViewer fetches it on first use with BlazorWebAssemblyLazyLoad, and here, compiled ahead of
        time, an app with it set aside dies on boot with a mono interpreter assertion (measured 2026-11-07). The AOT
        code for it is in dotnet.native.wasm either way, so setting it aside saved only its metadata.-->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>


  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!--Never published. dev-secrets.json holds a developer's real API keys, for a Development build to add under
      Settings - see Ai/DevSecrets.cs - and everything else under wwwroot goes to the site. The dev server reads it
      off the disk, so development is unaffected; a publish leaves it behind. Git-ignored as well, so it is never
      committed either. DevSecretsTests holds this line in place.-->
  <ItemGroup>
    <Content Update="wwwroot\dev-secrets.json" CopyToPublishDirectory="Never" />

    <!--Its template holds no key, but is no part of the app either: a JSON file at the root is content, and was
        published beside the site.-->
    <Content Update="dev-secrets.example.json" CopyToPublishDirectory="Never" />

    <!--A developer's own MCP registration for Claude Code - gds mcp over this folder, with absolute paths of this
        machine in it - which is git-ignored and, like the two above, a JSON file at the root the SDK takes for
        content. Found evaluating as publishable on 2026-11-03; it would have gone out beside the site.-->
    <Content Update=".mcp.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\fonts\" />
  </ItemGroup>

  <!--The example picker is driven by a manifest of the bundled sample files rather than a list written
      into the markup, so dropping a .gds into the folder is all it takes to offer it.

      The manifest is generated here and also checked in. Generated, so it cannot go stale; checked in,
      because the SDK globs wwwroot at project evaluation - before any target runs - and a file that
      only appears during the build would not be picked up as a static asset until the build after.
      WriteOnlyWhenDifferent leaves the file, and the incremental build, alone when nothing changed.

      Mosfet.gds is excluded because the picker lists it separately, above the sky130 cells.

      GF180's cells and IHP's each get a manifest of their own the same way, gf180-examples.json and
      ihp-examples.json, since 2026-11-02 - each their own group in the picker, opening under their PDK.

      The designs - whole open-source chips rather than single cells - are not globbed. Each one is somebody
      else's work with a license and a source, and a glob cannot write a credit, so designs.json,
      gf180-designs.json and ihp-designs.json beside them are written by hand and a test holds each to its folder,
      or to the commit it is downloaded from.-->
  <Target Name="GenerateExampleGdsManifest" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ExampleGdsFile
        Include="wwwroot\resources\GDS Files\Sky130 GDS\*.gds"
        Exclude="wwwroot\resources\GDS Files\Sky130 GDS\Mosfet.gds" />
    </ItemGroup>

    <PropertyGroup>
      <ExampleGdsManifest>[%0A@(ExampleGdsFile->'  &quot;%(Filename)%(Extension)&quot;', ',%0A')%0A]</ExampleGdsManifest>
    </PropertyGroup>

    <WriteLinesToFile
      File="wwwroot\resources\GDS Files\examples.json"
      Lines="$(ExampleGdsManifest)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Gf180ExampleGdsFile Include="wwwroot\resources\GDS Files\GF180 GDS\*.gds" />
    </ItemGroup>

    <PropertyGroup>
      <Gf180ExampleGdsManifest>[%0A@(Gf180ExampleGdsFile->'  &quot;%(Filename)%(Extension)&quot;', ',%0A')%0A]</Gf180ExampleGdsManifest>
    </PropertyGroup>

    <WriteLinesToFile
      File="wwwroot\resources\GDS Files\gf180-examples.json"
      Lines="$(Gf180ExampleGdsManifest)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <IhpExampleGdsFile Include="wwwroot\resources\GDS Files\IHP GDS\*.gds" />
    </ItemGroup>

    <PropertyGroup>
      <IhpExampleGdsManifest>[%0A@(IhpExampleGdsFile->'  &quot;%(Filename)%(Extension)&quot;', ',%0A')%0A]</IhpExampleGdsManifest>
    </PropertyGroup>

    <WriteLinesToFile
      File="wwwroot\resources\GDS Files\ihp-examples.json"
      Lines="$(IhpExampleGdsManifest)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
