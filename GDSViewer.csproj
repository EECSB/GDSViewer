<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <!--Ahead-of-time compilation. The AOT *step* runs on publish only, so `dotnet build` and `dotnet run`
        stay as quick as they were and the whole test suite still runs against an ordinary build.

        The `wasm-tools` workload is a different matter: it is required the moment this project is
        evaluated, not when it is published.

            dotnet workload install wasm-tools

        Without it `dotnet restore` fails with NETSDK1147 before anything is compiled - which is what CI
        did on the first push, on a runner that had the SDK and not the workload. Both workflows install
        it now; this comment and those steps say the same thing so neither can quietly stop being true.

        What it buys and what it costs are measured, not assumed - see DOCUMENTATION.md. In short: opening
        twenty thousand elements goes from 1,366 ms to 748 ms, the payload roughly doubles, and the publish
        takes minutes instead of seconds. Editing and panning do not move, because those are the browser
        laying out nodes rather than anything C# does.

        Set to false to get all three back - but delete obj\Release first. An incremental publish across
        the switch reuses intermediates built for the other mode and produces an app that dies on boot
        with a mono interpreter assertion, rather than anything that looks like a build error.-->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <!--The other three projects all sit under this one's directory, so keep their sources out of the app's
      default globs. GdsII is referenced below as a project; the CLI and the tests reference inward.

      Their obj folders matter as much as their sources: a generated AssemblyInfo.cs swept up from one of
      them collides with this project's own, and the error names this project's file rather than the one
      that was picked up.-->
  <ItemGroup>
    <Compile Remove="GdsII\**" />
    <Content Remove="GdsII\**" />
    <EmbeddedResource Remove="GdsII\**" />
    <None Remove="GdsII\**" />

    <Compile Remove="GdsII.Cli\**" />
    <Content Remove="GdsII.Cli\**" />
    <EmbeddedResource Remove="GdsII.Cli\**" />
    <None Remove="GdsII.Cli\**" />

    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!--The GDSII format itself: reading, writing, validating, flattening. The app is one consumer of it.-->
  <ItemGroup>
    <ProjectReference Include="GdsII\GdsII.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Viewer2DSvg\" />
    <Folder Include="wwwroot\css\fonts\" />
  </ItemGroup>

  <!--The example picker is driven by a manifest of the bundled sample files rather than a list written
      into the markup, so dropping a .gds into the folder is all it takes to offer it.

      The manifest is generated here and also checked in. Generated, so it cannot go stale; checked in,
      because the SDK globs wwwroot at project evaluation - before any target runs - and a file that
      only appears during the build would not be picked up as a static asset until the build after.
      WriteOnlyWhenDifferent leaves the file, and the incremental build, alone when nothing changed.

      Mosfet.gds is excluded because the picker lists it separately, above the sky130 cells.-->
  <Target Name="GenerateExampleGdsManifest" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ExampleGdsFile
        Include="wwwroot\resources\GDS Files\Sky130 GDS\*.gds"
        Exclude="wwwroot\resources\GDS Files\Sky130 GDS\Mosfet.gds" />
    </ItemGroup>

    <PropertyGroup>
      <ExampleGdsManifest>[%0A@(ExampleGdsFile->'  &quot;%(Filename)%(Extension)&quot;', ',%0A')%0A]</ExampleGdsManifest>
    </PropertyGroup>

    <WriteLinesToFile
      File="wwwroot\resources\GDS Files\examples.json"
      Lines="$(ExampleGdsManifest)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
