# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# Used only in development and testing of the AI assistant. Nobody using the app needs this
# file, and the app never reads it: the live tests do. For the app itself to have a model under
# Settings while developing, copy dev-secrets.example.json to wwwroot/dev-secrets.json instead.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
