    ///<summary>
    ///Turns where the pointer landed into a color: across for saturation, down for value.
    ///
    ///The hue is left alone - it is the slider's, and the field has no way to say anything about it.
    ///</summary>
    private async Task pickFromField(MouseEventArgs e)
    {
        double saturation = e.OffsetX / FieldWidth;
        double value = 1 - (e.OffsetY / FieldHeight);

        pickedColor = new HsvColor(pickedColor.Hue, saturation, value);

        await applyColor(pickedColor.ToHex());
    }

    private async Task hueChanged(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double hue))
            return;

        pickedColor = new HsvColor(hue, pickedColor.Saturation, pickedColor.Value);

        await applyColor(pickedColor.ToHex());
    }

    ///<summary>The current color as the three boxes show it, with what each one is called.</summary>
    private IEnumerable<(string Letter, string Name, int Level)> rgbChannels()
    {
        var (red, green, blue) = pickedColor.ToRgb();

        yield return ("R", "Red", red);
        yield return ("G", "Green", green);
        yield return ("B", "Blue", blue);
    }

    ///<summary>
    ///Takes a typed channel. The other two are read back off the color rather than kept alongside, so
    ///there is one place the color lives and the boxes cannot drift out of step with the field.
    ///
    ///Settled immediately: typing a number is arriving at a color rather than passing through one, so
    ///unlike a drag there is nothing to wait for before remembering it.
    ///</summary>
    private async Task channelTyped(ChangeEventArgs e, string letter)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int level))
            return;

        var (red, green, blue) = pickedColor.ToRgb();

        if (letter == "R")
            red = level;
        else if (letter == "G")
            green = level;
        else
            blue = level;

        pickedColor = HsvColor.FromRgb(red, green, blue);

        await applyColor(pickedColor.ToHex());

        colorSettled();
    }

    ///<summary>
    ///Takes a color from the history strip, moving the picker onto it as well as the layer.
    ///
    ///Separate from applyColor because the field and the slider must **not** do this: they hold the hue
    ///and saturation the pointer is on, and reading those back out of the hex would lose them - see
    ///<see cref="pickedColor"/>. Coming from the history there is nothing to lose, and the picker moving
    ///to show what was chosen is the point.
    ///</summary>
    private async Task chooseRecentColor(string color)
    {
        pickedColor = HsvColor.FromHex(color);

        await applyColor(color);

        //Straight to the front, since picking one again is what says it is the one being worked with.
        rememberColor(color);
    }

    ///<summary>
    ///The end of a drag or a slide: the color that was landed on is the one worth keeping.
    ///
    ///Remembering is deliberately not part of applying. Applying happens on every mousemove and every
    ///tick of the hue slider, which is what makes the layout recolor as you move - and doing both together
    ///filled the history with every shade the pointer passed over on the way, so by the time you let go
    ///the strip was a gradient of near-identical squares and the colors actually chosen had been pushed
    ///off the end of it.
    ///</summary>
    private void colorSettled()
    {
        if (settingsLayer() is null)
            return;

        rememberColor(pickedColor.ToHex());
    }

    ///<summary>
    ///Applies while the picker is being dragged, so the layout recolors as you move rather than after.
    ///That is the whole reason to have this next to the drawing.
    ///</summary>
    private async Task applyColor(string color)
    {
        if (settingsLayer() is not Layer layer)
            return;

        if (colorTarget == ColorTarget.Pattern)
        {
            layer.PatternColor = color;
        }
        else
        {
            layer.Color = color;
            layer.ColorIsCustom = true;
        }

        await settingsApplied(redraw: true);
    }

    ///
    ///Which of a layer's two colors the picker is aimed at.
    ///
    ///One picker rather than two, because the second one would be the same square, the same slider and the
    ///same three boxes again in a popup that is already the tallest thing on screen - and a layer has one
    ///pattern color at most, which is a switch rather than a second control.
    ///
    private enum ColorTarget
    {
        ///<summary>The layer's own color, which is what the picker has always changed.</summary>
        Background,

        ///<summary>The marks of its pattern, when it has one. See Layer.PatternColor.</summary>
        Pattern
    }

    ///
    ///Which one the picker is on, reset to the layer's own each time the popup opens.
    ///
    ///Not remembered between layers: the pattern side is only reachable for a layer that has a pattern, so
    ///a sticky choice would open the popup on a control that is not there half the time.
    ///
    private ColorTarget colorTarget = ColorTarget.Background;

    ///<summary>Whether the pattern side is offered at all - a solid layer has no marks to color.</summary>
    private bool canColorPattern()
    {
        return settingsLayer() is Layer layer && layer.Fill != LayerFill.None;
    }

    ///<summary>What the picker is currently showing, which is whichever of the two it is aimed at.</summary>
    private string colorBeingPicked()
    {
        if (settingsLayer() is not Layer layer)
            return "#000000";

        if (colorTarget == ColorTarget.Pattern)
            return SvgWriter.MarksColorOf(layer);

        return layer.Color;
    }

    ///
    ///Aims the picker at one of the two, and moves it onto that color.
    ///
    ///Moving it is the whole point: leaving the square where it was would mean the first nudge of the
    ///pointer writes the *background's* shade into the pattern, which is a color nobody chose arriving as
    ///the side effect of pressing a toggle.
    ///
    private void aimColorAt(ColorTarget target)
    {
        if (target == ColorTarget.Pattern && !canColorPattern())
            return;

        colorTarget = target;
        pickedColor = HsvColor.FromHex(colorBeingPicked());
    }

    ///<summary>
    ///Puts a layer back on the gradient. The palette is worked out from how many layers a file has, so
    ///rather than recomputing one entry, the whole set is reassigned and the other custom colors put back
    ///over it - which keeps the gradient's spacing right.
    ///</summary>
    private async Task resetColor()
    {
        //A PDK's row loses its color of its own - "auto" in the manager's table, the palette's on a file - or its pattern
        //goes back to following the layer.
        if (pdkSettings is not null)
        {
            if (colorTarget == ColorTarget.Pattern)
            {
                pdkSettings.Layer.PatternColor = null;
            }
            else
            {
                pdkSettings.Layer.ColorIsCustom = false;
                pdkSettings.Layer.Color = pdkRowColor(pdkSettings.Pair);
            }

            await writePdkSettings();

            pickedColor = HsvColor.FromHex(colorBeingPicked());

            return;
        }

        if (gds is null || settingsFor is null)
            return;

        //
        //The pattern's own reset is a different thing: there is no palette entry for it, and what "back to
        //normal" means for a hatch is following the layer again rather than landing on some other color.
        //
        if (colorTarget == ColorTarget.Pattern)
        {
            if (gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var patterned))
                patterned.PatternColor = null;

            pickedColor = HsvColor.FromHex(colorBeingPicked());

            await RenderGDS();

            rememberLayer(settingsFor.Id);

            await saveChangedFile();

            return;
        }

        var information = gds.AdditionalInformation;

        var kept = information.Layers
            .Where(entry => entry.Value.ColorIsCustom && entry.Key != settingsFor.Id)
            .ToDictionary(entry => entry.Key, entry => entry.Value.Color);

        information.RestorePaletteColors();

        foreach (var entry in kept)
        {
            information.Layers[entry.Key].Color = entry.Value;
            information.Layers[entry.Key].ColorIsCustom = true;
        }

        //Onto whatever the palette gave it back, so the field and the slider show where it landed.
        pickedColor = HsvColor.FromHex(colorOf(settingsFor.Id));

        await RenderGDS();

        rememberLayer(settingsFor.Id);

        await saveChangedFile();
    }

    ///<summary>
    ///Keeps a color at the front of the recent list, without duplicates, capped.
    ///
    ///Capped because this is a shortcut rather than a history: past a handful the row stops being something
    ///you can pick from at a glance, which is the only thing it is for.
    ///</summary>
    private void rememberColor(string color)
    {
        recentColors.Remove(color);
        recentColors.Insert(0, color);

        while (recentColors.Count > MaximumRecentColors)
            recentColors.RemoveAt(recentColors.Count - 1);
    }

    #region The layer stack **********************************

    ///<summary>Whether the layer the settings are open on has been given a height of its own rather than taking the even spacing.</summary>
    private bool stackIsCustom()
    {
        return settingsLayer() is Layer layer && layer.StackIsCustom;
    }

    ///<summary>
    ///What the height or thickness box shows.
    ///
    ///The automatic value rather than a blank, because that is what the layer is actually at - a box that
    ///said nothing would suggest the layer had no height, when the view has already given it one. Typing
    ///over it is what makes it the layer's own.
    ///</summary>
    private LayerRole settingsRole()
    {
        if (settingsLayer() is not Layer layer)
            return LayerRole.None;

        return layer.Role;
    }

    ///
    ///Takes a role chosen in the popup.
    ///
    ///No redraw: a role changes nothing about how the layout is drawn, only what a net traces through. It is
    ///saved, though, for the same reason a name is - it is a thing about the process that somebody worked out
    ///once and should not have to work out again.
    ///
    private async Task roleChosen(ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out LayerRole role))
            return;

        if (settingsLayer() is not Layer layer)
            return;

        layer.Role = role;

        await settingsApplied(redraw: false);
    }

    #region A layer's fill pattern ***************************

    ///<summary>The patterns offered, in the order the popup shows them, lightest first.</summary>
    private static IEnumerable<(LayerFill Fill, string Name)> fillChoices()
    {
        yield return (LayerFill.None, "Solid");
        yield return (LayerFill.Dots, "Dots");
        yield return (LayerFill.Squares, "Squares");
        yield return (LayerFill.Grid, "Grid");
        yield return (LayerFill.Dashes, "Dashes");
        yield return (LayerFill.Diagonal, "Diagonal");
        yield return (LayerFill.BackDiagonal, "Back diagonal");
        yield return (LayerFill.CrossHatch, "Cross hatch");
    }

    private LayerFill fillOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return LayerFill.None;

        return layer.Fill;
    }

    ///<summary>The pattern of the layer the settings are open on.</summary>
    private LayerFill settingsFill()
    {
        if (settingsLayer() is not Layer layer)
            return LayerFill.None;

        return layer.Fill;
    }

    ///
    ///One swatch, drawn by the writer that fills the layer.
    ///
    ///In the layer's own color when there is one on screen to be in, so the choice shown is the choice as it
    ///will look rather than a generic gray - the whole question being asked is whether *this* layer stays
    ///told apart from the one above it.
    ///
    ///The id has to be unique in the page: eight of these are open at once and an id already taken is an id
    ///the browser resolves to the first one, so all eight would draw whatever came first.
    ///
    private string patternTile(LayerFill fill)
    {
        string color = "#41464b";
        string? marks = null;
        int pixels = Layer.DefaultPatternPixels;

        if (settingsLayer() is Layer layer)
        {
            color = layer.Color;
            marks = layer.PatternColor;
            pixels = layer.PatternPixels ?? Layer.DefaultPatternPixels;
        }

        return SvgWriter.SwatchFor(fill, color, $"swatch_{fill}", 24, marks, pixels);
    }

    ///<summary>
    ///What this layer's pattern is drawn in, or null where it follows the layer's own color. Null rather
    ///than the resolved color, so a swatch can be handed the same "has it been set" the layer holds.
    ///</summary>
    private string? patternColorOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return null;

        return layer.PatternColor;
    }

    ///
    ///Takes a pattern chosen in the popup.
    ///
    ///A redraw, unlike a role: this is the one thing in the lower half of the popup that changes the picture
    ///rather than what the picture means. Saved with it, the same as a color.
    ///
    private async Task fillChosen(LayerFill fill)
    {
        if (settingsLayer() is not Layer layer)
            return;

        if (layer.Fill == fill)
            return;

        layer.Fill = fill;

        //A solid layer has no marks to color, so the picker cannot be left aimed at them - it would be a
        //field with nothing on the other end of it, writing a color into a layer that draws none.
        if (fill == LayerFill.None && colorTarget == ColorTarget.Pattern)
            aimColorAt(ColorTarget.Background);

        await settingsApplied(redraw: true);
    }

    ///<summary>How big this layer's pattern is held on screen - a row's swatch draws it so.</summary>
    private int patternPixelsOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return Layer.DefaultPatternPixels;

        return layer.PatternPixels ?? Layer.DefaultPatternPixels;
    }

    ///<summary>How big the pattern of the layer the settings are open on is held on screen, which is the number the box shows.</summary>
    private int settingsPatternPixels()
    {
        if (settingsLayer() is not Layer layer)
            return Layer.DefaultPatternPixels;

        return layer.PatternPixels ?? Layer.DefaultPatternPixels;
    }

    ///
    ///Takes a typed pattern size, in screen pixels.
    ///
    ///Held to the same range the layermap column is, and for the same reasons - below it every fill is a
    ///flat tone and above it a shape holds less than one repeat. Out of range is clamped rather than
    ///refused: this is a spinner somebody is nudging, and a box that silently keeps the old number when
    ///the arrow is pressed once too often reads as the control having stopped working.
    ///
    ///The default back means "no size of its own" rather than "nine", so a layer nudged back to where it
    ///started stops being written into the session and the layermap at all.
    ///
    private async Task patternSizeTyped(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int pixels))
            return;

        if (settingsLayer() is not Layer layer)
            return;

        pixels = Math.Clamp(pixels, LayerNames.LeastPatternPixels, LayerNames.MostPatternPixels);

        if (pixels == Layer.DefaultPatternPixels)
            layer.PatternPixels = null;
        else
            layer.PatternPixels = pixels;

        await settingsApplied(redraw: true);
    }

    ///<summary>The name of the picture the layer the settings are open on is drawn with in 3D, or null for none.</summary>
    private string? settingsTexture()
    {
        if (settingsLayer() is not Layer layer)
            return null;

        if (layer.Texture is string name && name.Length > 0)
            return name;

        return null;
    }

    ///<summary>The picture the popup shows of the layer's texture, as a data URL - empty while it loads, or for none.</summary>
    private string textureShown = "";

    ///<summary>Whether the layer names a picture this browser does not keep, which the popup says.</summary>
    private bool textureMissing = false;

    ///<summary>Which load of the picture is the newest, so one for a row left behind does not land on the next.</summary>
    private int textureLoads = 0;

    ///<summary>The picture the popup shows for the layer it is open on, out of the store - see showSettingsFor.</summary>
    private async Task loadTextureShown()
    {
        int load = ++textureLoads;

        textureShown = "";
        textureMissing = false;

        if (settingsTexture() is not string name)
            return;

        try
        {
            byte[]? picture = await textures.GetAsync(name);

            if (load != textureLoads)
                return;

            if (picture is null)
                textureMissing = true;
            else
                textureShown = pictureUrl(picture);

            StateHasChanged();
        }
        catch { }
    }

    ///
    ///A picture chosen for the layer's 3D texture: kept in this browser under its file name, the layer given the name,
    ///and the 3D view's Show textures turned on, so the layer is seen with it when that view opens. Remembered and saved
    ///like a name typed on a row, so it is there on the next visit and carries onto the next file.
    ///
    ///**Under the file's name** - see textureNameFor - since that is how a layermap finds it again beside the CSV: a
    ///picture chosen under a name already kept takes its place, for every layer that names it.
    ///
    private async Task textureChosen(InputFileChangeEventArgs e)
    {
        if (settingsLayer() is null)
            return;

        byte[]? picture = null;
        string failed = "";

        try
        {
            await using var stream = e.File.OpenReadStream(TextureStore.LargestPicture);
            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            picture = memory.ToArray();
        }
        catch (Exception ex)
        {
            failed = ex.Message;
        }

        //Read or not, so choosing the same file again - changed, or after a failure - is a change the input reports.
        await js.InvokeVoidAsync("forgetChosenFile", "layerTextureFile");

        if (picture is null)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}: {failed}");

            return;
        }

        string name = textureNameFor(e.File.Name);

        await textures.SetAsync(name, picture);

        //Asked for again rather than held across the reads above: a PDK's row is read afresh whenever its PDK changes.
        if (settingsLayer() is not Layer layer)
            return;

        layer.Texture = name;

        textureLoads++;
        textureShown = pictureUrl(picture);
        textureMissing = false;

        await js.InvokeVoidAsync("setViewOptionInterOp", "textures", true);

        await settingsApplied(redraw: false);
    }

    ///<summary>The layer drawn in 3D without a picture again. The picture stays kept, for any other layer naming it.</summary>
    private async Task removeTexture()
    {
        if (settingsLayer() is not Layer layer)
            return;

        layer.Texture = null;
        layer.TextureSize = null;

        textureLoads++;
        textureShown = "";
        textureMissing = false;

        await settingsApplied(redraw: false);
    }

    ///<summary>How big one repeat of the texture is, in database units, or empty for the micron it starts at.</summary>
    private string settingsTextureUnits()
    {
        if (settingsLayer() is not Layer layer || layer.TextureSize is not int units)
            return "";

        return units.ToString(CultureInfo.InvariantCulture);
    }

    ///<summary>A micron in this file's database units, which is what a texture repeats every until it is told otherwise.</summary>
    private string defaultTextureUnits()
    {
        return Math.Round(Layer.DefaultTextureMicrons / micronsPerUnit()).ToString(CultureInfo.InvariantCulture);
    }

    ///
    ///Takes a typed texture size, in database units. Blank goes back to the micron it starts at, rather than to a
    ///number - so a layer put back stops carrying one in its row of the layermap - and nothing over nothing is refused.
    ///
    private async Task textureSizeTyped(ChangeEventArgs e)
    {
        if (settingsLayer() is not Layer layer)
            return;

        string typed = e.Value?.ToString()?.Trim() ?? "";

        if (typed.Length == 0)
            layer.TextureSize = null;
        else if (int.TryParse(typed, NumberStyles.Integer, CultureInfo.InvariantCulture, out int units) && units > 0)
            layer.TextureSize = units;
        else
            return;

        await settingsApplied(redraw: false);
    }

    ///
    ///The name a chosen picture is kept and written under: its file name, with what a layermap row cannot hold - a comma,
    ///which would split it - and what would make it a path rather than a name put as underscores. See
    ///LayerNames.IsTextureName.
    ///
    private static string textureNameFor(string fileName)
    {
        var name = new StringBuilder();

        foreach (char character in Path.GetFileName(fileName))
        {
            if (character == ',' || character == '/' || character == '\\' || character == ':' || char.IsControl(character))
                name.Append('_');
            else
                name.Append(character);
        }

        string kept = name.ToString().Trim();

        if (!LayerNames.IsTextureName(kept))
            return "texture.png";

        return kept;
    }

    ///<summary>A picture as a data URL for an img, its type told from its first bytes - the store keeps the bytes alone.</summary>
    private static string pictureUrl(byte[] picture)
    {
        return $"data:{pictureType(picture) ?? "image/png"};base64,{Convert.ToBase64String(picture)}";
    }

    ///<summary>The pictures a layer's texture can be - the kinds pictureType knows - as the file dialog's filter.</summary>
    private const string TexturePictures = "image/png,image/jpeg,image/webp,image/gif,image/bmp,.png,.jpg,.jpeg,.webp,.gif,.bmp";

    ///<summary>What kind of picture these bytes are, by the few every file of that kind starts with - or null for none of them.</summary>
    private static string? pictureType(byte[] bytes)
    {
        if (bytes.Length >= 4 && bytes[0] == 0x89 && bytes[1] == (byte)'P' && bytes[2] == (byte)'N' && bytes[3] == (byte)'G')
            return "image/png";

        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
            return "image/jpeg";

        if (bytes.Length >= 3 && bytes[0] == (byte)'G' && bytes[1] == (byte)'I' && bytes[2] == (byte)'F')
            return "image/gif";

        if (bytes.Length >= 12 && bytes[0] == (byte)'R' && bytes[1] == (byte)'I' && bytes[8] == (byte)'W' && bytes[9] == (byte)'E' && bytes[10] == (byte)'B' && bytes[11] == (byte)'P')
            return "image/webp";

        if (bytes.Length >= 2 && bytes[0] == (byte)'B' && bytes[1] == (byte)'M')
            return "image/bmp";

        return null;
    }

    ///
    ///The patterns somebody has set, as "65/20=Dots", for storing in a session.
    ///
    ///**A layer with a pattern color or a size of its own extends the same entry** rather than getting a
    ///list of its own: "65/20=Dots:#ff0000:14", with an empty middle where only the size was set. All three
    ///are how one layer's pattern is drawn and none of them means anything without the fill in front, so
    ///one list keeps them arriving together - and a session written before any of this existed still reads,
    ///because everything after the first colon is optional.
    ///
    private List<string> customFills()
    {
        if (gds is null)
            return new List<string>();

        //Only the ones that have one. LayerFill.None is every layer until somebody says otherwise, so a
        //list of those would be a list of every layer in the file saying nothing.
        return gds.AdditionalInformation.Layers
            .Where(entry => entry.Value.Fill != LayerFill.None)
            .Select(entry => $"{entry.Key}={describeFill(entry.Value)}")
            .ToList();
    }

    ///<summary>One layer's pattern as a session holds it: the fill, and the two settings that shape it.</summary>
    private static string describeFill(Layer layer)
    {
        string fill = layer.Fill.ToString();

        if (layer.PatternPixels is int pixels)
            return FormattableString.Invariant($"{fill}:{layer.PatternColor}:{pixels}");

        if (layer.PatternColor is string marks && marks.Length > 0)
            return $"{fill}:{marks}";

        return fill;
    }

    ///<summary>Puts the stored patterns back onto the layers a file has, ignoring any it no longer does.</summary>
    private void applyStoredFills(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string named))
                continue;

            string[] parts = named.Split(':');

            if (!Enum.TryParse(parts[0], out LayerFill fill))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            layer.Fill = fill;

            //Set rather than merged: this is what the layer's pattern was, so a part the entry does not
            //carry is a part that was not set - and leaving whatever the file arrived with in place would
            //be a session that can add a hatch color but never take one away.
            layer.PatternColor = null;
            layer.PatternPixels = null;

            if (parts.Length > 1 && parts[1].Length > 0)
                layer.PatternColor = parts[1];

            if (parts.Length > 2 && int.TryParse(parts[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out int pixels))
                layer.PatternPixels = Math.Clamp(pixels, LayerNames.LeastPatternPixels, LayerNames.MostPatternPixels);
        }
    }

    #endregion ***********************************************

    private string stackValue(bool height)
    {
        if (settingsLayer() is not Layer layer)
            return "";

        //A PDK's row that places nothing has no height to show: each file's view stacks such a layer for itself.
        if (pdkSettings is not null && !layer.StackIsCustom)
            return "";

        if (height)
            return layer.Offset.ToString(CultureInfo.InvariantCulture);

        return layer.Depth.ToString(CultureInfo.InvariantCulture);
    }

    ///<summary>
    ///Takes a height or a thickness typed into the popup.
    ///
    ///Emptying the box puts the layer back on the even spacing, which is the only way to undo one field
    ///without the other - and it reads the way clearing the name box does.
    ///</summary>
    private async Task stackTyped(ChangeEventArgs e, bool height)
    {
        if (settingsLayer() is not Layer layer)
            return;

        string typed = e.Value?.ToString()?.Trim() ?? "";

        if (typed.Length == 0)
        {
            await resetStack();

            return;
        }

        if (!int.TryParse(typed, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value))
            return;

        if (height)
        {
            layer.Offset = value;

            //Where it was asked to sit, which the spacing slider spreads from rather than refusing to move.
            layer.CustomHeight = value;
        }
        else
        {
            //A layer of no thickness draws nothing, which looks like the layer having disappeared rather
            //than like a number being wrong. The box says min=1; this is the half a browser cannot enforce
            //against a value typed and committed with the keyboard.
            if (value < 1)
                return;

            layer.Depth = value;
        }

        layer.StackIsCustom = true;

        await settingsApplied(redraw: true);
    }

    ///<summary>Puts one layer back on the stack the view works out for itself.</summary>
    private async Task resetStack()
    {
        //A PDK's row gives its height and thickness up, back to wherever each file's view stacks a layer nobody placed.
        if (pdkSettings is not null)
        {
            pdkSettings.Layer.StackIsCustom = false;
            pdkSettings.Layer.CustomHeight = null;

            await writePdkSettings();

            return;
        }

        if (gds is null || settingsFor is null)
            return;

        //Through the spacing the 3D view is currently showing, not the default. Restoring to a spacing
        //nobody is looking at would drop the layer somewhere that matches neither the slider nor the rest
        //of the stack.
        gds.AdditionalInformation.RestoreStacking(settingsFor.Id, layerSpacing());

        await RenderGDS();

        rememberLayer(settingsFor.Id);

        await saveChangedFile();
    }

    #region Adding and removing a layer *********************************

    ///<summary>Whether the two boxes for a new layer's pair are open. Closed is the ordinary state.</summary>
    private bool addingLayer = false;

    private string newLayerNumber = "";

    private string newLayerDataType = "";

    ///<summary>What was wrong with what was typed, shown under the boxes rather than in a dialog.</summary>
    private string addLayerProblem = "";

    private void startAddingLayer()
    {
        addingLayer = true;
        newLayerNumber = "";
        newLayerDataType = "0";
        addLayerProblem = "";
    }

    private void cancelAddingLayer()
    {
        addingLayer = false;
        addLayerProblem = "";
    }

    ///<summary>Enter adds and Escape closes, so two numbers do not need the mouse to finish.</summary>
    private async Task onAddLayerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await addLayer();
        else if (e.Key == "Escape")
            cancelAddingLayer();
    }

    ///
    ///Puts a layer in the list that no shape is on yet.
    ///
    ///**Which is the only way to draw on a layer a file does not already use.** The list is built from what
    ///the layout draws, so a new layout has none at all and an existing one offers only the numbers it
    ///happens to carry - and the draw tool draws onto a row of that list. Without this, an empty layout was
    ///somewhere you could not put anything.
    ///
    ///**An empty layer is not something GDSII can record**, and that is worth saying plainly rather than
    ///hiding: the format stores elements, and a layer is only the number written on one. So a layer added
    ///here and left empty is gone when the file is written and read back. Draw on it and it is in the file
    ///like any other. Naming it is enough to keep it too, since a name is carried in the layermap the
    ///session stores.
    ///
    private async Task addLayer()
    {
        if (gds is null)
            return;

        if (!short.TryParse(newLayerNumber.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out short number) || number < 0)
        {
            addLayerProblem = "The layer is a whole number, 0 or more.";

            return;
        }

        if (!short.TryParse(newLayerDataType.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out short dataType) || dataType < 0)
        {
            addLayerProblem = "The datatype is a whole number, 0 or more.";

            return;
        }

        var key = new LayerKey(number, dataType);

        if (gds.AdditionalInformation.Layers.ContainsKey(key))
        {
            addLayerProblem = $"{key} is already in the list.";

            return;
        }

        //
        //**Named by the PDK in use, on a file drawn in it**: 66/20 added to a sky130 layout is poly, with poly's height
        //and role, the way it is on every sky130 file that draws on it - and the way it came back after a reload, which
        //lays the PDK over the file again. It used to come in bare, on the argument that nothing had said what the
        //layout was; the PDK in use says it. A pair the PDK has no row for comes in bare, as before. Through the one
        //place every way a layer arrives goes through - see rowsForNewLayers.
        //
        gds.AddLayer(key);

        //A new row changes what the stack is spaced over, so it is worked out again at the spacing in force
        //- the same restack every other route that changes the layer table does. See SetStackingOffsets.
        gds.AdditionalInformation.SetStackingOffsets(layerSpacing());

        addingLayer = false;
        addLayerProblem = "";

        getLayers();

        //Not beside the text, where a redraw writes the whole file's text again - see redrawShown. A layer with no
        //shapes on it changes nothing there.
        await redrawShown();

        await saveChangedFile();
    }

    ///
    ///Takes a layer out of the list, and its shapes out of the file.
    ///
    ///**Every shape on it, in every cell.** A layer belongs to the library rather than to the cell you
    ///happen to be inside, so removing it from one cell would leave it in the list, in the file, and drawn
    ///the moment you stepped into another cell - which is not what the word means.
    ///
    ///The shapes go through the edit history as one step, so it takes back in one press. The row itself is
    ///dropped outside that, which needs no undo of its own: putting an element back registers its layer
    ///again - see LayoutEdit.Put - so an undo restores both halves.
    ///
    private async Task removeLayer(CheckboxItem item)
    {
        //Guarded here as well as in the markup, because this takes shapes out of the file and a control being
        //absent is not the same as an action being refused.
        if (gds is null || noEditing)
            return;

        var key = item.Id;
        var edits = new List<LayoutEdit>();

        foreach (var structure in gds.StreamFormat.Structures)
        {
            foreach (var group in Hierarchy.LayersIn(structure))
            {
                if (group.Layer != key)
                    continue;

                foreach (var model in group.Shapes)
                    edits.Add(new DeleteElement(gds, structure, model));
            }
        }

        //
        //**Always asked, because the control is one press at the end of a row.**
        //
        //It was asked only where shapes would go with the layer, on the reading that an empty row is
        //nothing to lose. That was right while this lived behind a gear and two clicks; on a × beside the
        //checkbox it is a mis-click away from the thing next to it, and a row with a name, a color and a
        //height on it is not nothing even when no shape carries it.
        //
        string question = $"Remove {item.Label}?";

        if (edits.Count == 1)
            question = $"Delete 1 shape on {item.Label} and remove the layer?";
        else if (edits.Count > 1)
            question = $"Delete {edits.Count} shapes on {item.Label} and remove the layer?";

        if (!await js.InvokeAsync<bool>("confirm", question))
            return;

        if (edits.Count > 0)
            editHistory.Do(new CompoundEdit("Remove layer", edits));

        //
        //Kept, so taking the deletion back puts the row back as it was.
        //
        //Putting an element in registers its layer - see LayoutEdit.Put - so an undo does restore the row
        //on its own. What it cannot restore is what the row *said*: a re-registered layer arrives with the
        //gray a new one gets and no name, no height and no role, because none of that is in the file. So
        //the object itself is held here and put back by restoreRemovedLayers.
        //
        //Only where something was deleted. With nothing to undo there is nothing that can bring the row
        //back, and holding the object would just be waiting for a key that never returns.
        //
        if (edits.Count > 0)
            removedLayers[key] = gds.AdditionalInformation.Layers[key];

        gds.AdditionalInformation.Layers.Remove(key);
        gds.AdditionalInformation.SetStackingOffsets(layerSpacing());

        settingsFor = null;

        await afterLayersRemoved(edits.Count > 0);
    }

    ///
    ///What follows a layer row taken out: a change to the file, when shapes went with it, and only a change to
    ///the list otherwise.
    ///
    ///**Shapes taken out are an edit, and go where every edit goes** - see changedOnHistory. This went straight
    ///to rebuilding the list and a save, so nothing heard that the file had changed: a bundled example's session
    ///went on naming the example and came back from a reload with the shapes in it, an edited file's bytes were
    ///written as they were before the shapes went, and the 2D view's tree went on listing the layer.
    ///
    private async Task afterLayersRemoved(bool shapesWent)
    {
        if (shapesWent)
        {
            await changedOnHistory(Array.Empty<GDS.ElementModel>());

            return;
        }

        getLayers();

        await RenderGDS();

        await saveChangedFile();
    }

    ///
    ///Takes every layer out of the list and every shape on them out of the file: the × of every row, at once.
    ///
    ///**Asked first, with the count.** It empties the drawing, and a press on the header is as close to a
    ///mis-click as the × on a row is - so the question says how much goes, the way removeLayer's does.
    ///
    ///**One step of the edit history**, so one undo puts the whole drawing back, and the rows come back
    ///saying what they said before - every one of them, see removedLayers. What is left in the file is the
    ///cells and their placements, which carry no layer.
    ///
    private async Task removeAllLayers()
    {
        if (gds is null || noEditing)
            return;

        var edits = new List<LayoutEdit>();
        var emptied = new HashSet<LayerKey>();

        foreach (var structure in gds.StreamFormat.Structures)
        {
            foreach (var group in Hierarchy.LayersIn(structure))
            {
                foreach (var model in group.Shapes)
                    edits.Add(new DeleteElement(gds, structure, model));

                emptied.Add(group.Layer);
            }
        }

        int layers = gds.AdditionalInformation.Layers.Count;
        string question = $"Remove all {layers} layer(s)?";

        if (edits.Count > 0)
            question = $"Delete all {edits.Count} shape(s) and remove all {layers} layer(s)?";

        if (!await js.InvokeAsync<bool>("confirm", question))
            return;

        if (edits.Count > 0)
            editHistory.Do(new CompoundEdit("Remove every layer", edits));

        //Held for an undo, the ones it can bring back - see removeLayer.
        foreach (var (key, layer) in gds.AdditionalInformation.Layers)
        {
            if (emptied.Contains(key))
                removedLayers[key] = layer;
        }

        gds.AdditionalInformation.Layers.Clear();
        gds.AdditionalInformation.SetStackingOffsets(layerSpacing());

        settingsFor = null;

        await afterLayersRemoved(edits.Count > 0);
    }

    ///
    ///The rows taken out with shapes on them, and what each said. See removeLayer.
    ///
    ///Several rather than the last one: removing every layer takes them all at once, and one undo brings
    ///every one of them back. Taking two out one after the other is the same case, a press apart.
    ///
    private Dictionary<LayerKey, Layer> removedLayers = new();

    ///
    ///Puts removed layers' settings back on the rows an undo has just re-registered.
    ///
    ///Run after every edit rather than hooked onto the undo, because the shell does not own the undo - the
    ///2D view does, and it reports an edit having happened without saying which way round it went. Asking
    ///"is a row I am holding back, and bare?" answers the same question without the two having to agree
    ///about anything.
    ///
    private void restoreRemovedLayers()
    {
        if (gds is null || removedLayers.Count == 0)
            return;

        bool restored = false;

        foreach (var (key, was) in removedLayers.ToList())
        {
            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var now))
                continue;

            //Only the bare row a re-registered layer arrives as. Somebody who has drawn on that pair again and
            //set it up themselves has said something about it, and this has nothing to put back over that.
            if (now.Name is not null || now.Color != AdditionalGDSInformation.NewLayerColor)
                continue;

            //
            //**Into the row that is there, not over it.** The 2D view flattens before this runs - see its afterEdit
            //- and every element it drew holds the bare row's instance, so a replacement in the table left the
            //shapes in that row's gray under a swatch showing the color put back. See Layer.TakeSettingsFrom.
            //
            now.TakeSettingsFrom(was);
            removedLayers.Remove(key);

            restored = true;
        }

        if (restored)
            gds.AdditionalInformation.SetStackingOffsets(layerSpacing());
    }

    ///<summary>How many shapes are on a layer, for the row that offers to remove it.</summary>
    private int shapesOn(LayerKey key)
    {
        if (gds is null)
            return 0;

        int found = 0;

        foreach (var structure in gds.StreamFormat.Structures)
        {
            foreach (var group in Hierarchy.LayersIn(structure))
            {
                if (group.Layer == key)
                    found += group.Shapes.Count;
            }
        }

        return found;
    }

    #endregion ***********************************************

    ///<summary>
    ///Where the 3D view's spacing slider is, or the default when that view has not been opened. The shell
    ///does not own the slider - the view does - so this reads it back out of a written session rather than
    ///keeping a second copy that could disagree with it.
    ///</summary>
    private int layerSpacing()
    {
        if (gds is null)
            return DefaultLayerSpread;

        var settings = new SavedSession();

        viewer?.WriteSettings(settings);

        //
        //**Any spread at all, zero included.**
        //
        //This asked for one greater than zero, from when zero was below the slider's own minimum and could
        //only mean "the view has not been opened, so it wrote nothing". Zero is now where the slider starts
        //and the commonest thing it will ever report, and reading it as "unset" would put the default back
        //in its place - which happens to be the same number today and would stop being one the moment the
        //default moved. A spread cannot be negative, so that is the test.
        //
        if (settings.LayerSpacing >= 0)
            return settings.LayerSpacing;

        return DefaultLayerSpread;
    }

    ///<summary>
    ///What a file opens at, taken from the library rather than copied here.
    ///
    ///It was a 50 written next to a comment saying it matched two other 50s. Three copies of one number,
    ///and the third - the 3D view's slider - had already drifted to 10.
    ///
    ///Now zero: a file opens on the heights the layermap gives it, with nothing added between them. The
    ///50 it used to be lives on as <see cref="AdditionalGDSInformation.DefaultLayerSpacing"/>, which was
    ///always doing a second job - the rung height of the even stack a file with no layermap at all gets -
    ///and keeps doing only that.
    ///</summary>
    private const int DefaultLayerSpread = AdditionalGDSInformation.DefaultLayerSpread;

    ///<summary>The custom stack, as "65/20=100,50" - height then thickness - for storing in a session.</summary>
    private List<string> customStack()
    {
        if (gds is null)
            return new List<string>();

        return gds.AdditionalInformation.OrderedLayers()
            .Where(entry => entry.Value.StackIsCustom)
            .Select(entry => $"{entry.Key}={storedHeightOf(entry.Value).ToString(CultureInfo.InvariantCulture)},{entry.Value.Depth.ToString(CultureInfo.InvariantCulture)}")
            .ToList();
    }

    ///
    ///The height to write down for a layer, or -1 for a layer that was never given one.
    ///
    ///**Not its drawn position**, which is where the spacing slider has pushed it to and is nobody's setting.
    ///A layer whose thickness alone was typed is stored too - the thickness is worth keeping - and it has no
    ///height of its own to store, which is what the -1 says. Read back, that leaves it on the automatic stack
    ///and moving with the slider like everything else.
    ///
    ///A session written before this stored the position of a layer that was pinned against the slider, which
    ///was the same number as the height it had been given - so those read back as the height they always
    ///meant.
    ///
    private static int storedHeightOf(Layer layer)
    {
        return layer.CustomHeight ?? -1;
    }

    ///<summary>Puts those back onto a file that has just been opened.</summary>
    private void applyStoredStack(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string value))
                continue;

            string[] parts = value.Split(',');

            if (parts.Length != 2)
                continue;

            if (!int.TryParse(parts[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out int offset))
                continue;

            if (!int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out int depth))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            //A height of its own, or -1 for a layer that only ever had a thickness - see storedHeightOf.
            if (offset >= 0)
            {
                layer.Offset = offset;
                layer.CustomHeight = offset;
            }

            layer.Depth = depth;
            layer.StackIsCustom = true;
        }
    }

    ///<summary>
    ///Splits a stored "65/20=something" into the pair and the rest of it. Shared by the colors and the
    ///stack, which are stored the same way and were reading it apart twice.
    ///</summary>
    private static bool splitStoredLayer(string entry, out LayerKey key, out string value)
    {
        key = default;
        value = "";

        string[] halves = entry.Split('=');

        if (halves.Length != 2)
            return false;

        string[] numbers = halves[0].Split('/');

        if (numbers.Length != 2)
            return false;

        if (!short.TryParse(numbers[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out short number))
            return false;

        if (!short.TryParse(numbers[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out short dataType))
            return false;

        key = new LayerKey(number, dataType);
        value = halves[1];

        return true;
    }

    #endregion ***********************************************

    ///<summary>The custom colors, as "65/20=#00ff00", for storing in a session.</summary>
    private List<string> customColors()
    {
        if (gds is null)
            return new List<string>();

        return gds.AdditionalInformation.OrderedLayers()
            .Where(entry => entry.Value.ColorIsCustom)
            .Select(entry => $"{entry.Key}={entry.Value.Color}")
            .ToList();
    }

    ///<summary>Puts those back onto a file that has just been opened.</summary>
    private void applyStoredColors(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string color))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            layer.Color = color;
            layer.ColorIsCustom = true;
        }
    }

    #endregion ***********************************************

    #region Renaming a layer in place ************************

    ///<summary>
    ///Starts editing one row. The box is seeded with the name alone rather than with the label, since the
    ///label carries the numbers too and nobody wants to delete "(65/20)" before typing.
    ///</summary>
    ///
    ///The 2D view, when that is the one open and the Draw tool is out. Null the rest of the time.
    ///
    ///A cast rather than something on <see cref="IRenderable"/>, because drawing is not a thing every view
    ///does - a text editor and a three-dimensional model have no layer to draw a shape on, and an interface
    ///member they both had to answer for would be two more places saying no.
    ///
    private Viewer2DSvg? drawingView
    {
        get
        {
            if (viewer is Viewer2DSvg svg && svg.DrawingShapes)
                return svg;

            return null;
        }
    }

    ///<summary>Whether this row is the layer a drawn shape would go on.</summary>
    private bool drawingOnLayer(CheckboxItem item)
    {
        return drawingView is Viewer2DSvg svg && svg.DrawOn == item.Id;
    }

    ///
    ///How many chosen shapes each layer holds, for marking their rows. Empty outside the 2D view, which is the
    ///only one that chooses anything.
    ///
    ///**Asked once per render, not once per row.** A band across a large layout can choose a hundred thousand
    ///shapes, and counting them again for each of fifty rows is a cost that only shows on the files it
    ///matters for.
    ///
    ///The view is checked as well as the cast, because the reference is only replaced after the render that
    ///creates the new view: on the way out of 2D, the first render still holds the old one.
    ///
    private Dictionary<LayerKey, int> chosenByLayer()
    {
        if (view != ViewType.View2DSvg || viewer is not Viewer2DSvg svg)
            return new Dictionary<LayerKey, int>();

        return svg.ChosenByLayer();
    }

    ///<summary>What a lit row means and what a click on it does - a question while a shape is being drawn or the settings are up.</summary>
    private string rowTitle(CheckboxItem item, Dictionary<LayerKey, int> chosenOn)
    {
        if (drawingView is null)
        {
            if (chosenOn.TryGetValue(item.Id, out int count))
            {
                string holds = holdsChosen(count, chosenOn.Values.Sum());

                if (settingsFor is not null && !settingsOpenFor(item))
                    return $"{holds}. Click to show its settings";

                return holds;
            }

            if (settingsFor is not null)
                return "Show this layer's settings";

            return "";
        }

        if (drawingOnLayer(item))
        {
            if (settingsFor is not null && !settingsOpenFor(item))
                return "Drawing on this layer. Click to show its settings";

            return "Drawing on this layer";
        }

        if (settingsFor is not null)
            return "Draw on this layer, and show its settings";

        return "Draw on this layer";
    }

    ///<summary>What a row lit for the selection says: how much of what is chosen is on that layer.</summary>
    private static string holdsChosen(int count, int total)
    {
        if (total == 1)
            return "The chosen shape is on this layer";

        if (count == total)
            return FormattableString.Invariant($"All {total:N0} chosen shapes are on this layer");

        if (count == 1)
            return FormattableString.Invariant($"One of the {total:N0} chosen shapes is on this layer");

        return FormattableString.Invariant($"{count:N0} of the {total:N0} chosen shapes are on this layer");
    }

    ///
    ///The rule that fades the locked layers, or nothing at all when none are locked.
    ///
    ///**A stylesheet rather than a redraw.** The picture already carries a class per layer - see
    ///SvgWriter.ClassFor - so which layers recede is a question CSS can answer on its own, and locking one
    ///costs a style recalculation instead of rebuilding every path in the document. Unlocking is then exact:
    ///nothing about the drawing was changed to get into it.
    ///
    ///**This is the half that only *looks* like the feature.** Fading says which layers are not in hand;
    ///what actually puts them out of reach is <see cref="CheckboxItem.EditableLayers"/> over in the view,
    ///because whether a shape answers a click is settled in C# by Picking.At walking the layout. The
    ///`pointer-events` here is on the layer's paths alone - a label is a `text` node with no layer class, so
    ///a locked layer's labels stay at full strength and are kept from answering by HitTest instead, which
    ///refuses a label off the reachable set the same as a shape. On its own a rule like this grays the shapes
    ///out and changes nothing about which of them can be picked up and dragged.
    ///
    ///Scoped by id, so it beats the per-layer opacity the picture sets on itself without needing to shout.
    ///
    private MarkupString lockedStyle()
    {
        var locked = CheckboxItem.LockedLayers(checkboxItems);

        if (locked.Count == 0)
            return new MarkupString("");

        var selectors = locked.Select(key => $"#gdsSVG path.{SvgWriter.ClassFor(key)}");

        return new MarkupString(
            $"<style>{string.Join(",", selectors)}{{opacity:0.12;pointer-events:none}}</style>");
    }

    ///
    ///A press on a layer row.
    ///
    ///**The open settings follow it.** With the popup up, the row pressed is the layer somebody wants to look
    ///at next, and the popup went on showing the one it was opened for - so moving on to another layer meant
    ///closing it and finding that row's gear. It changes in place now, and stays where it is rather than
    ///jumping level with the new row: a panel that moves on every press has to be found again after each one.
    ///
    ///Then whatever the press meant already, which the settings being up does not change - see useDrawLayer.
    ///
    private async Task layerRowPressed(CheckboxItem item)
    {
        if (settingsFor is not null)
            showSettingsFor(item);

        await useDrawLayer(item);
    }

    private async Task useDrawLayer(CheckboxItem item)
    {
        //
        //**In 3D the same press asks a different question, because the first one has no answer there.**
        //
        //Picking a layer to draw on means nothing in a view with no draw tool, so the press did nothing at
        //all - and the question that view *does* raise is which of the slabs the row names. So it flashes
        //the one it names. See Viewer3D.PulseLayer.
        //
        if (viewer is Viewer3D stack)
        {
            await stack.PulseLayer(item.Id);

            //
            //And the row that was pressed, so the answer starts where the press did.
            //
            //A slab flashing somewhere in the stack is easy to miss: it can be behind another one, off the
            //side of the view, scrolled past, or turned off entirely - and a press that appears to do
            //nothing reads as a press that was not registered. The row is the one part of this that is
            //certainly in front of you, because it is what was just clicked.
            //
            await flashLayerRow(item.Id);

            return;
        }

        //
        //**In 2D the press says where a new shape goes, and only that.**
        //
        //It briefly meant more: a press isolated that layer and worked on it alone. That was one layer at a
        //time, and a layout is not edited one layer at a time - a via and the two metals it joins are three
        //layers in hand together. Which layers are in hand is said by the locks on the rows now, so the
        //press is back to the one question it can answer.
        //
        if (drawingView is not Viewer2DSvg svg)
            return;

        await svg.UseDrawLayer(item.Id);
    }

    ///
    ///Hands a right-click on a layer row to the 2D view, which draws the menu.
    ///
    ///Nothing happens in the other views. The menu's three lines are a rename and two edits to the shapes
    ///on that layer, and only that component knows how to make either kind - so rather than a menu here
    ///offering one working line and two disabled ones, the browser's own menu comes up as usual.
    ///
    private async Task openLayerRowMenu(CheckboxItem item, MouseEventArgs e)
    {
        if (viewer is not Viewer2DSvg editor)
            return;

        await editor.OpenLayerMenu(e, item.Id);
    }

    ///<summary>
    ///Names one layer, from the box at the top of that layer's settings.
    ///
    ///Split out when the settings grew a name box, back when the sidebar row could be typed into as well and
    ///the two had to be kept from drifting. The row is a readout now - see the layerName span - so this has
    ///two callers, the box and a layer renamed in the 2D view's cell tree (OnLayerRenamed), and is left separate
    ///because what it does is a named step rather than part of the box's own key handling: clear the name on
    ///blank, redraw, and take it into the PDK in use.
    ///</summary>
    private async Task applyLayerName(LayerKey key, string typed)
    {
        if (gds is null)
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return;

        typed = typed.Trim();

        if (typed.Length == 0)
            layer.Name = null;
        else
            layer.Name = typed;

        rememberLayer(key);

        getLayers();

        await RenderGDS();

        await saveChangedFile();
    }

    #endregion ***********************************************



    #region The saved session ********************************

    ///<summary>
    ///Writes what is on screen, so closing the tab does not throw it away.
    ///
    ///Called from every handler that changes something worth keeping, and the result is also handed to the
    ///unload handler as the snapshot to write if the page goes away. Both, because neither is enough on its
    ///own: saving only on change misses nothing but cannot run once the tab is closing, and saving only on
    ///the way out never happens at all when a mobile browser kills the tab without warning.
    ///
    ///Best effort throughout. This is a viewer, and a session that could not be written is a disappointment
    ///rather than a reason to interrupt what someone is doing.
    ///</summary>
    private async Task saveSession()
    {
        await saveSession(whole: false);
    }

    ///
    ///The same, writing the file's bytes whole even where the steps since they were last written would do - see
    ///writeWhole, for the moments the file is finished with for now.
    ///
    private async Task saveSession(bool whole)
    {
        if (gds is null)
            return;

        //Half of a state being put back is not worth writing, and writing it destroys the other half.
        if (restoringState)
            return;

        var session = buildSession(gds);

        //
        //**The steps since the file was last written, rather than the file, when they will do.**
        //
        //Writing the whole file was most of what an edit cost on a real chip: serialized, compressed and
        //stored after every one, 100 - 140 ms of each corner dropped on the RGB mixer on a published build, to
        //keep one corner. The bytes beside the session stay the file as it was last written whole, and the
        //session carries the steps taken since, which a reload takes again - see SavedSession.Journal. A step
        //is a few numbers, so a save is the settings and those.
        //
        if (!whole && journalWillDo() is BytesBeside beside && editHistory.Journal is IReadOnlyList<SavedStep> steps)
        {
            session.BytesApart = true;
            session.Base = beside.Name;

            if (steps.Count > 0)
                session.Journal = steps.ToList();

            string stepped = AppStorage.Encode(SavedSession.Serialize(session));

            await storage.SetEncodedAsync(SessionStorageKey, stepped);
            await storage.HoldForExitAsync(SessionStorageKey, stepped);

            //The row's bytes are this same writing - journalWillDo asked - so the steps are all it needs too.
            await rememberInHistory(stepped, "", null, beside);

            await restoreTabsOnce();
            await saveTabs();

            return;
        }

        //
        //**The file's bytes go beside the session.** A save is far more frequent than an edit - every pan that
        //comes to rest is one - and with the bytes inside, each save serialized and compressed the whole file
        //again: a third of a second after every pan of an eight megabyte upload on a published build, seconds on
        //the dev server. See SavedSession.BytesApart.
        //
        string bytes = sessionFileBytes();
        BytesBeside? writing = null;

        session.BytesApart = bytes.Length > 0;

        //Under a name of their own, which the steps saved from here on belong to. See SavedSession.Base.
        if (session.BytesApart)
        {
            writing = new BytesBeside(gds, fileVersion, Guid.NewGuid().ToString("N")[..12]);
            session.Base = writing.Name;
        }

        //
        //**Compressed once, for all three places it goes.** The session is written to its own key, handed to
        //the exit handler and written into the history row - and each of those used to compress it for
        //itself.
        //
        string encoded = AppStorage.Encode(SavedSession.Serialize(session));

        //The bytes encoded once a save too, for both places that take them.
        string? encodedBytes = null;

        if (writing is not null)
        {
            encodedBytes = AppStorage.Encode(SavedSession.Stored(writing.Name, bytes));

            //
            //Together, so a reload never finds the settings and undo stack of one writing beside another's bytes
            //- and handed to the exit handler together, so a page that goes away between the two cannot leave it
            //holding one of each.
            //
            await storage.SetEncodedTogetherAsync(SessionStorageKey, encoded, SessionBytesKey, encodedBytes);
            await storage.HoldTogetherForExitAsync(SessionStorageKey, encoded, SessionBytesKey, encodedBytes);

            sessionBytesHeld = writing;
            sessionBytesLeft = true;

            //And the steps are counted again from here, against what has just been written.
            editHistory.Written();
            changedOffJournal = false;
        }
        else
        {
            await storage.SetEncodedAsync(SessionStorageKey, encoded);

            //And keep the exit handler's copy current, for the close it cannot await a save through.
            await storage.HoldForExitAsync(SessionStorageKey, encoded);
        }

        //A file that carries no bytes leaves none behind it: they are megabytes, and nothing would read them.
        if (!session.BytesApart && sessionBytesLeft)
        {
            await storage.RemoveAsync(SessionBytesKey);
            await storage.ReleaseForExitAsync(SessionBytesKey);

            sessionBytesHeld = null;
            sessionBytesLeft = false;
        }

        //The same state, into the history list, if this file belongs there - with the bytes, since this is a new
        //writing of them that the row's session now names.
        await rememberInHistory(encoded, bytes, encodedBytes, writing);

        //And the tabs: put back the first time a file is on screen, and written from then on when they have
        //changed - a file opened into the tab on screen renames it. See saveTabs.
        await restoreTabsOnce();
        await saveTabs();
    }

    ///
    ///One writing of a file's bytes beside its session: which file, after which edit, and the name they were
    ///stored under - see SavedSession.Base. A history row is told the same, so the two can be asked whether they
    ///hold one writing.
    ///
    private sealed record BytesBeside(GDS File, int Version, string Name);

    ///
    ///The writing beside the session that the steps since will do for, or null when the file has to be written
    ///whole: it carries no bytes, or they are not this file's, or something has changed it that the steps do not
    ///say, or they have grown long enough that a reload taking them all again would be the slow part.
    ///
    ///**And the history row has to hold the same writing**, since it is given the same session: steps taken
    ///again on a row's older bytes would put them onto the wrong shapes. A row that does not is written whole
    ///with the file, which is once - the first save after a reload, or after the row was opened.
    ///
    private BytesBeside? journalWillDo()
    {
        if (gds is null || !carriesBytes())
            return null;

        if (sessionBytesHeld is not BytesBeside held || !ReferenceEquals(held.File, gds) || held.Name.Length == 0)
            return null;

        if (changedOffJournal || editHistory.Journal is not IReadOnlyList<SavedStep> steps)
            return null;

        if (steps.Count > EditHistory.MostSteps || editHistory.JournalWeight > EditHistory.MostPayload)
            return null;

        string name = CurrentlySelectedFileName + CurrentlySelectedFileType;

        if (fileIsHistoryWorthy && name.Length > 0 && !history.HoldsBytes(name, held))
            return null;

        return held;
    }

    ///
    ///Writes the file whole beside the session, when steps have been saved in its place since it last was - see
    ///SavedSession.Journal. For the moments a file is finished with for now: downloaded, or the page hidden,
    ///which on a phone is the last moment anything is sure to run.
    ///
    private async Task writeWhole()
    {
        //Whole already: the bytes beside the session are the file as it stands.
        if (journalWillDo() is not null && editHistory.Journal is { Count: 0 })
            return;

        await saveSession(whole: true);
    }

    ///
    ///The page has been hidden: another tab, the window minimized, a phone's home screen, or on its way out.
    ///Reported by the exit handler after it has written its own copy - see gdsExitSave.whenHidden.
    ///
    [JSInvokable]
    public async Task OnPageHidden()
    {
        await writeWhole();
    }

    ///
    ///Whether the file has changed other than through the edit history since its bytes were last written, which
    ///the steps cannot say - so the next save writes it whole. See onFileEdited.
    ///
    private bool changedOffJournal = false;

    ///<summary>Where the edit history stood when a change to the file was last reported. See onFileEdited.</summary>
    private int historyVersionSeen = -1;

    ///
    ///Takes what a link brought out of the address, once it has landed: the file it named, and where it was
    ///looking.
    ///
    ///**Read from the address, and never written back to it.** The app used to write the framing in a second
    ///after every pan or orbit, and the file whenever one was chosen, so the address bar was always a link to
    ///what was on screen - a navigation on every gesture, to keep up a link that Share now makes on demand.
    ///See openShare.
    ///
    ///**Taken out rather than left**, because the address outranks the session. A file= left in it opened that
    ///file fresh on a reload, without the layers hidden, the colors or the edits made since; a box= put the
    ///view back on the link's framing however far it had moved. From here the session carries all of it like
    ///anything else of your own, so a reload brings back what was on screen.
    ///
    ///**And the view written in with it.** OnParametersSet reads `view` back out of the query on every
    ///navigation, so an address that does not name one would put a link's 3D view back to the 2D default.
    ///Only when there is something to take out: a bare link stays bare rather than gaining a view.
    ///
    ///**Never inside an iframe.** There the address is the embedding page's, and the browser can bring the
    ///frame back at the address it has now rather than at the one the page wrote - going Back to the page
    ///does, and some browsers do it on a reload. A frame that had lost its file= would open whatever the
    ///session last held, and every viewer on the page shares that one session: two embeds of two files would
    ///both come back as the same one.
    ///
    ///Replacing rather than pushing, because tidying the address is not somewhere to go Back to.
    ///
    private void takeOutOfAddress(params string[] names)
    {
        if (inIframe)
            return;

        var query = Embedding.SplitQuery(NavigationManager.Uri);

        if (!names.Any(query.ContainsKey))
            return;

        var wanted = new Dictionary<string, object?> { ["view"] = slugOf(view) };

        foreach (string name in names)
            wanted[name] = null;

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(wanted), replace: true);
    }


    ///<summary>
    ///Saves, having noted that the user changed something about the file itself.
    ///
    ///The distinction this draws is what keeps the history list worth opening: the records, the layer
    ///names, the colors and what is switched off are the file as somebody left it, and are worth coming
    ///back to. The opacity, the layer spacing, the backdrop and which view is up are how it was being
    ///looked at, and on their own are not a reason to have kept a bundled example.
    ///</summary>
    private async Task saveChangedFile()
    {
        fileIsHistoryWorthy = true;

        await saveSession();
    }

    ///<summary>
    ///Everything worth keeping about what is on screen, in the shape both the session and a history entry
    ///hold. Takes the file rather than reading the field, so the caller's null check is the one the
    ///compiler sees.
    ///</summary>
    private SavedSession buildSession(GDS file)
    {
        var session = new SavedSession
        {
            ExampleName = selectedExample,
            FileName = CurrentlySelectedFileName,
            FileType = CurrentlySelectedFileType,
            View = slugOf(view),
            LayerNames = LayerNames.Named(file.AdditionalInformation),
            Deck = deckToRemember(),
            RulesOff = rulesOff.Order(StringComparer.Ordinal).ToList(),
            Waived = waived.Order(StringComparer.Ordinal).ToList(),
            PdkTaken = pdkTaken,
            PdkLaidOver = pdkLaidOver(),
            HiddenLayers = checkboxItems.Where(item => !item.IsSelected).Select(item => item.Id.ToString()).ToList(),
            LockedLayers = checkboxItems.Where(item => item.IsLocked).Select(item => item.Id.ToString()).ToList(),
            LabelsOffLayers = checkboxItems.Where(item => !item.ShowLabels).Select(item => item.Id.ToString()).ToList(),
            LayerColors = customColors(),
            LayerStack = customStack(),
            LayerFills = customFills(),
            RecentColors = recentColors,
            DownloadFormat = downloadFormat,
            FullScreen = fullScreen,
            Layers = layersOpen,
            CellTree = cellTreeOpen,

            //No FileBytes: the bytes are stored beside the session, and only saveSession writes those. The
            //other callers want the settings alone, and working the file out for them was wasted.
            Edits = describedEdits()
        };

        //Each view writes its own controls; the shell deliberately does not know what they are.
        viewer?.WriteSettings(session);

        return session;
    }

    ///<summary>
    ///Writes the open file into the history list, when it belongs there.
    ///
    ///**Two ways in.** A file off the user's machine goes in the moment it is opened, edited or not - it
    ///exists nowhere else, and losing it because nothing was changed would be the worst case this feature
    ///has. A bundled example goes in once something about it is changed, because an untouched one is
    ///already a click away in the list next door and a history full of files nobody altered is a history
    ///nobody can find anything in.
    ///
    ///**And once in, it stays current.** Everything a session holds is written on every save, so the
    ///opacity and the view a file was last looked at in come back with it - but only for a file that has
    ///already earned a row. Moving a slider on an untouched example does not create one.
    ///
    ///**A shared name is not enough.** This used to write to any row whose name matched, which meant
    ///opening the bundled Mosfet destroyed the row holding somebody's edited copy of it: same name, same
    ///row, and the pristine file written over the top. What decides is whether the file on screen *is*
    ///that row - uploaded, changed, or restored out of the history - not what it happens to be called.
    ///
    ///**The file's bytes go with it only when the row does not already hold that writing of them.** They sit
    ///beside the row rather than in it, as they sit beside the session - see SavedSession.BytesApart - so a
    ///save that changed a setting writes the setting. `encodedBytes` is what saveSession already encoded for
    ///its own key, and is used rather than encoding the same file twice; a save of steps rather than of the file
    ///passes none, having made sure the row holds the writing they belong to - see journalWillDo.
    ///</summary>
    private async Task rememberInHistory(string encodedSession, string bytes, string? encodedBytes, BytesBeside? writing)
    {
        if (gds is null || !fileIsHistoryWorthy)
            return;

        string name = CurrentlySelectedFileName + CurrentlySelectedFileType;

        if (name.Length == 0)
            return;

        string? rowBytes = null;

        if (bytes.Length > 0 && writing is not null && !history.HoldsBytes(name, writing))
            rowBytes = encodedBytes ?? AppStorage.Encode(SavedSession.Stored(writing.Name, bytes));

        await history.RememberEncodedAsync(new HistoryEntry
        {
            Name = name,
            ExampleName = selectedExample,
            Edited = fileEdited,
            When = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture)
        }, encodedSession, rowBytes, writing);

        //Held so the popup can be opened without a read, and so it lists what was just done rather than
        //what the store said when the app started.
        historyEntries = await history.ListAsync();
    }

    ///<summary>
    ///The file's bytes, or nothing when they can be fetched again.
    ///
    ///An unedited bundled example is one of the 1,220 already on the server, so keeping a copy of
    ///one buys nothing. An uploaded file, or any file that has been edited, exists only in this tab - and
    ///that is exactly what a session is for.
    ///</summary>
    private string sessionFileBytes()
    {
        if (gds is null || !carriesBytes())
            return "";

        //
        //**Written out again only when the file has changed since.** A session is saved for all sorts of
        //reasons that leave the file alone - a pan settling is one - and once an edit has made the session
        //carry the file, each of those serialized all of it again: a couple of megabytes for a real chip, on
        //every pan. The same file and no edit since is the same bytes.
        //
        //Safe for the same reason fileEdited is: onFileEdited is the one funnel every change to the file
        //goes through, and it is what moves fileVersion on.
        //
        //**And the edit history's step besides**, since a step is the file changing whether or not anything
        //reported it. Removing a layer took its shapes out through the history and went straight to a save, and
        //the bytes kept from before it were written as the file - with the shapes still in it.
        //
        if (bytesWritten is (GDS File, int Version, int Steps, string Bytes) kept
            && ReferenceEquals(kept.File, gds)
            && kept.Version == fileVersion
            && kept.Steps == editHistory.Version)
            return kept.Bytes;

        string bytes = Convert.ToBase64String(gds.Serialize());

        bytesWritten = (gds, fileVersion, editHistory.Version, bytes);

        return bytes;
    }

    ///<summary>
    ///Whether the session carries the file's bytes: anything but a bundled example nobody has changed, which can
    ///be fetched again by name. See sessionFileBytes.
    ///</summary>
    private bool carriesBytes()
    {
        return selectedExample.Length == 0 || fileEdited;
    }

    ///<summary>Moved on by every edit, so the bytes a session holds can tell whether they are still the file's.</summary>
    private int fileVersion = 0;

    ///<summary>The file's bytes as the last session wrote them, and which file, which edit and which step of the history they were of.</summary>
    private (GDS File, int Version, int Steps, string Bytes)? bytesWritten = null;

    ///<summary>
    ///Puts a session back, and says whether it had a file in it.
    ///
    ///Only reached when the address names no file, since a link is a deliberate request for something
    ///specific and has to win over what happened to be open last time.
    ///</summary>
    private async Task<bool> restoreSession(Pacer pacer)
    {
        var session = SavedSession.Deserialize(await storage.GetAsync(SessionStorageKey));

        if (session is null)
            return false;

        //Its file, from beside it - see SavedSession.BytesApart. A session whose bytes are gone has no file.
        if (session.BytesApart)
        {
            string? bytes = await storage.GetAsync(SessionBytesKey);

            if (string.IsNullOrEmpty(bytes))
                return false;

            session.BytesFrom(bytes);
        }

        //The address wins when it names a view, the same way it wins when it names a file: a link is a
        //deliberate request for something specific, and handing someone their own last view instead would
        //make a shared ?view= mean different things to different people.
        //
        //This was always wrong and could not show until a bare start began opening a file: with nothing
        //loaded there was no session to save, so ?view= on a second visit had nothing to lose to.
        bool restored = await applySavedState(session, addressWins: !string.IsNullOrEmpty(ViewSlug), pacer);

        //
        //What is beside the session is this file now, so the next save need not write it again - and the steps
        //saved from here are counted from it. **Unless steps were taken again on it**, when it is the file as it
        //was before them and the next save writes it whole. A session from before the bytes were kept apart had
        //them inside, and nothing is beside it yet.
        //
        //Not over a writing a save has already made of this file, which is newer than what was read.
        //
        bool alreadyWritten = sessionBytesHeld is BytesBeside held && ReferenceEquals(held.File, gds);

        if (restored && session.BytesApart && gds is not null && !journalTakenAgain && !alreadyWritten)
        {
            sessionBytesHeld = new BytesBeside(gds, fileVersion, session.BytesBase);

            editHistory.Written();
        }

        return restored;
    }

    ///
    ///Whether the last state put back had steps taken again on its bytes - see SavedSession.Journal - which makes
    ///the bytes it was read from the file as it was before them, rather than as it is.
    ///
    private bool journalTakenAgain = false;

    ///<summary>
    ///Puts a whole saved state on screen: the file, how its layers were named, colored and shown, and the
    ///view it was left in.
    ///
    ///Shared by the session restored on arrival and by a file chosen out of the history list, which are the
    ///same thing read from two different keys. False when the state could not be used - a payload that will
    ///not parse, or an example that is no longer served.
    ///
    ///**At the pace of the caller's load, handed over rather than looked up** - a tab, a history row, the last
    ///session, a cancel's way back. Looked up as the load in hand, a restore overtaken while its caller waited - on
    ///storage, say - would go on as the newer load, and put its file in over that one's. See fetchExample, where
    ///that happened.
    ///</summary>
    private async Task<bool> applySavedState(SavedSession session, bool addressWins, Pacer pacer)
    {
        //Overtaken already, and none of what follows is this restore's to change any more.
        pacer.Token.ThrowIfCancellationRequested();

        //Nothing may write while this runs; see restoringState. Cleared in the finally below if the state
        //never reaches the view, and in applyRestoredSettings if it does.
        restoringState = true;
        restoredSession = null;

        //Which restore is the latest - see the finally below.
        var mine = new object();

        restoringFor = mine;

        try
        {
            if (session.View.Length > 0 && !addressWins)
                view = viewOf(session.View);

            //Once the view it will be drawn in is known, since the text view says nothing - see showLoading.
            await showLoading(session.FileName + session.FileType);

            journalTakenAgain = false;

            //A file that was edited or uploaded travels in the state; anything else is fetched by name.
            if (session.CarriesFile)
            {
                GDS parsed;
                byte[] written;

                try
                {
                    written = await session.FileAsync(pacer.Pause);
                    parsed = await GDS.FromBytesAsync(written, pacer.Pause);
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch
                {
                    return false;
                }

                //
                //**And the steps taken since those bytes were written, taken again** - see SavedSession.Journal.
                //
                //Only on the writing they were saved against. Bytes of another one - the exit handler's older copy,
                //or another tab's file under the same key - are not what the steps or the undo stack describe, and
                //taking either to them would put somebody's edits onto the wrong shapes; so is a journal with a
                //step that will not go back on. The file is then what was last written whole, without both.
                //
                bool otherWriting = !string.IsNullOrEmpty(session.Base) && !session.JournalFits;

                if (otherWriting)
                {
                    Console.WriteLine($"The bytes beside the session for {session.FileName}{session.FileType} are not the ones it was saved with, so it opens as they are, without its steps or its undo stack.");

                    session.Journal = null;
                    session.Edits = null;
                }
                else if (session.Journal is { Count: > 0 } steps)
                {
                    if (EditHistory.Replay(parsed, steps))
                        journalTakenAgain = true;
                    else
                    {
                        Console.WriteLine($"The {steps.Count} step(s) saved since {session.FileName}{session.FileType} was last written whole do not go back onto it, so it opens as it was then.");

                        try
                        {
                            parsed = await GDS.FromBytesAsync(written, pacer.Pause);
                        }
                        catch (OperationCanceledException)
                        {
                            throw;
                        }
                        catch
                        {
                            return false;
                        }

                        session.Edits = null;
                    }
                }

                //Flattened and indexed before it goes in, at the load's pace - see openParsedFile, which does the
                //same for the same reason: a cancel up to here has nothing on screen to put back.
                var layout = await GdsFlattener.FlattenAsync(parsed, pacer.Pause);

                await layout.IndexAsync(pacer.Pause);

                //Given up where those did not stop to look - see openParsedFile.
                pacer.Token.ThrowIfCancellationRequested();

                gds = parsed;
                gds.RowsForNewLayers = rowsForNewLayers;

                //What a cancel from here on puts back - see openParsedFile. Taken before fileWentIn lets go of it.
                var before = leaving ?? givingWay;
                bool gotTab = leaving is not null;

                //What openParsedFile does for a file going in, which this one does not pass through.
                fileWentIn();
                leaveTheLastFile();

                if (pacer.CanCancel)
                    undoLoad = undoNext ?? undoOpen(before, gotTab);

                flattened = layout;
                flattenedFor = gds;

                CurrentlySelectedFileName = session.FileName;
                CurrentlySelectedFileType = session.FileType;
                selectedExample = session.ExampleName;
                fileEdited = true;
            }
            else
            {
                if (session.ExampleName.Length == 0)
                    return false;

                //Set before fetching, the way the ?file= path does it: fetchExample loads and draws but does
                //not touch the picker, so leaving this empty showed the first name in the list next to
                //somebody else's layout - and the save that followed would then have stored the whole file,
                //having no example name to point at.
                selectedExample = session.ExampleName;

                if (!await fetchExample(session.ExampleName, pacer))
                {
                    selectedExample = "";

                    return false;
                }
            }

            applyRestoredLayers(session);

            //After the file is open, whichever of the two ways it arrived - the example branch goes through
            //openParsedFile, which clears the stack, and doing this before it would be undone by it.
            restoreEdits(session);

            //After the file, because opening one sets this from the format it arrived as - which is only
            //the default, and a session that says otherwise is somebody having chosen.
            downloadFormat = session.DownloadFormat;

            //Nothing to wait for: it is a class on the page rather than anything a view owns.
            fullScreen = session.FullScreen;
            layersOpen = session.Layers;
            cellTreeOpen = session.CellTree;

            //A state put back is the file as somebody left it rather than a fresh copy of it, so if that
            //file has a history row this *is* that row - and the saves from here on keep it current.
            //Opening the bundled version of the same file does not go through here, which is what keeps it
            //from writing over an edited copy that happens to share its name.
            fileIsHistoryWorthy = await history.ContainsAsync(CurrentlySelectedFileName + CurrentlySelectedFileType);

            //Held for the render that creates the view, which is the only thing that can take its controls.
            restoredSession = session;

            await RenderGDS();

            //Given up while the view drew it, which has put the page back already - see openParsedFile.
            pacer.Token.ThrowIfCancellationRequested();

            return true;
        }
        finally
        {
            //
            //A state that got nowhere never reaches applyRestoredSettings, so if nothing is waiting on a
            //view the block on saving has to come off here - or nothing would ever be saved again. Nor will
            //a view draw it, so the note saying it is loading comes down here too.
            //
            //**Only for the latest restore.** One given up while its view drew has its way back begun before it
            //unwinds - a restore of its own, which has just set both of these for itself - and lifting the block
            //here would let saves through in the middle of putting the old file back.
            //
            //And the note only while no other load has put up its own: an example chosen over a tab on its way in
            //is no restore, and leaves this one the latest - but its note is its own.
            //
            if (ReferenceEquals(restoringFor, mine) && restoredSession is null)
            {
                restoringState = false;

                if (loading is null || ReferenceEquals(loading, pacer))
                    loadingWhat = "";
            }
        }
    }

    ///<summary>The restore under way, by applySavedState's own token, so one that was overtaken leaves the next one's state alone.</summary>
    private object? restoringFor = null;

    ///<summary>
    ///The undo stack for a session, or null when there is nothing to take back - which is most files, most
    ///of the time, and should not pay a key and two empty lists for the privilege.
    ///</summary>
    private SavedEdits? describedEdits()
    {
        var written = editHistory.Describe();

        if (written.Done.Count == 0 && written.Undone.Count == 0)
            return null;

        return written;
    }

    ///<summary>
    ///Puts the undo stack back, so a refresh costs the page and not what was changed.
    ///
    ///**Against the file that has just been opened, not the one the edits were made on.** That is what an
    ///edit is written down to survive: the models it pointed at are gone, and what comes back addresses the
    ///same shapes by where they sit. Anything that does not fit the file in hand is left out rather than
    ///guessed at - a stack is a convenience, and the one thing it must never do is undo the wrong shape.
    ///</summary>
    private void restoreEdits(SavedSession session)
    {
        editHistory.Clear();

        if (gds is null || session.Edits is null)
            return;

        editHistory.Restore(gds, session.Edits);
    }

    ///<summary>
    ///Applies the parts of a session that describe the layers rather than the file: their names and colors,
    ///and which were switched off. Run after the file is open, since both are keyed by pairs that only
    ///exist once it has been read.
    ///</summary>
    private void applyRestoredLayers(SavedSession session)
    {
        if (gds is null)
            return;

        //Whether the file is drawn in the PDK in use, which it may have been put under by hand - see fileUnderPdk. The
        //names that used to carry from file to file are the PDK's to carry now, so a session's are not read back as them.
        pdkTaken = session.PdkTaken;
        fileUnderPdk = fileFitsPdk();

        //And this file as it was left, with everything that was on it.
        if (session.LayerNames.Length > 0)
        {
            var named = LayerNames.Parse(session.LayerNames);

            //
            //**With the layers it named that nothing is drawn on** - added with Add layer, or started from the PDK's -
            //which the file's own records cannot bring back: the format writes a layer only on the shapes carrying it.
            //A session keeps a row for each layer something was said about, so a named one comes back, as AddLayer
            //says it does; it did not, until a layout started from sky130's lost every layer it had not drawn on
            //yet at the first reload.
            //
            //**Together, so the palette is divided over them as it was** when they were added together: a layout
            //started from a PDK's layers gets its colors that way, and a reload that added them one gray at a time put
            //every one of them in gray. A color chosen comes back from its row, over the palette's.
            //
            gds.AdditionalInformation.AddLayers(named.Pairs);

            named.ApplyTo(gds.AdditionalInformation.Layers);

            //And the stack worked out over the heights it just brought, which is what puts the layers it says
            //nothing about clear of the ones it does. ApplyTo writes heights onto layers; only this reads them
            //back as a stack. See SetStackingOffsets.
            gds.AdditionalInformation.SetStackingOffsets(layerSpacing());
        }

        getLayers();

        recentColors = session.RecentColors;

        applyStoredColors(session.LayerColors);

        //After the names, which may have carried a stack of their own out of a layermap - what was set on
        //the layer last is what the session holds, so it is what wins.
        applyStoredStack(session.LayerStack);

        //After the stack for no reason but order; nothing else touches a fill, so nothing can overwrite it.
        applyStoredFills(session.LayerFills);

        //
        //**And the PDK in use over all of it, as it is now**, where the names the file was put away with were a PDK's.
        //That PDK has been edited since, from other files or the PDK manager, or another put in use, and the file follows
        //it the way a file opening fresh does: what a PDK put on it comes off, and the one in use goes on if the file is
        //drawn in it. Its rules too - see carryDeckOver.
        //
        //**Only there.** A file a page's own layermap named was not under the PDK, and comes back as it was left, the
        //page gone or not - see the layermap in the address; a session from before PDKs keeps its names as they were.
        //
        if (session.PdkLaidOver)
        {
            LayerNames.Clear(gds.AdditionalInformation);

            if (pdkLaidOver())
                LayerNames.Parse(pdkLayers(pdks.InUse)).ApplyTo(gds.AdditionalInformation.Layers);

            gds.AdditionalInformation.SetStackingOffsets(layerSpacing());

            getLayers();
        }

        carryDeckOver();

        //Both are stored as the set that is switched **off**, so anything a session does not mention comes
        //back on - which is also what a layer the file has gained since should do.
        var hidden = new HashSet<string>(session.HiddenLayers);
        var labelsOff = new HashSet<string>(session.LabelsOffLayers);

        //And the locks, as the set switched **on** - a layer opens unlocked, so one a session does not name is.
        var locked = new HashSet<string>(session.LockedLayers);

        foreach (var item in checkboxItems)
        {
            item.IsSelected = !hidden.Contains(item.Id.ToString());
            item.ShowLabels = !labelsOff.Contains(item.Id.ToString());
            item.IsLocked = locked.Contains(item.Id.ToString());
        }

        //The faults waived in this file, which a run after the reload finds waived again - see waived.
        waived = new HashSet<string>(session.Waived, StringComparer.Ordinal);
    }

    ///<summary>
    ///Hands a restored session's own controls to whichever view is now mounted. Kept until it has been
    ///applied rather than applied on restore, because the view is created by the render that follows.
    ///</summary>
    private async Task applyRestoredSettings()
    {
        if (restoredSession is null || viewer is null)
            return;

        var session = restoredSession;
        restoredSession = null;

        await viewer.ApplySettings(session);

        //The last of the state has landed, so writing is safe again - and the write that follows is what
        //makes the store agree with the screen, which matters most for a file opened out of the history:
        //the session key has to name it now, not whatever was open before.
        restoringState = false;

        await RenderGDS();

        await saveSession();

        await applyEmbedding();
    }

    ///
    ///What each view had, kept across the switches that destroy the view holding it.
    ///
    ///**One carrier, written over.** Every view writes only the settings it owns - see WriteSettings - so
    ///this ends up holding the 3D view's spacing beside the 2D view's opacity, each as of the last visit to
    ///that view, and neither disturbed by visits to the other.
    ///
    ///Separate from <see cref="restoredSession"/> rather than folded into it, because the two are not the
    ///same event. A restore is the whole of the state coming back from storage and everything downstream of
    ///it - the layers, the embedding, the flag that says writing is unsafe - hangs off that one moment. This
    ///is one component handing a handful of values to the next, with the file and the layers already right.
    ///
    ///Seeded from a full <see cref="buildSession"/> the first time, so a view arriving before anything has
    ///been written for it gets what is on screen rather than a blank record's defaults.
    ///
    private SavedSession? acrossViews = null;

    ///<summary>Set when a switch has just happened, so this lands once rather than on every render.</summary>
    private bool handingOver = false;

    ///
    ///Hands them over, once the view that takes them is mounted.
    ///
    ///Called from the same render hook as <see cref="applyRestoredSettings"/> and after it, so a restore
    ///that lands on the same render wins - what came out of storage is the visitor's own state, where this
    ///is only what the previous views happened to be showing.
    ///
    ///Once per switch, not once per render: applying every time would put the slider back where the last
    ///switch left it in the middle of a drag.
    ///
    private async Task applyCarriedSettings()
    {
        if (!handingOver || acrossViews is null || viewer is null)
            return;

        handingOver = false;

        await viewer.ApplySettings(acrossViews);

        //A draw, because what just landed changes the picture: the spacing is written onto the layers and
        //the opacity is an argument to the next build, and neither shows until something asks for one.
        await RenderGDS();
    }

    ///
    ///And then whatever the page hosting this asked for, over the top of it.
    ///
    ///**Last, so a named parameter wins.** The session has just been put back, which is where the visitor's
    ///own choices live; anything the address names is the embedder overruling that for this load. What is
    ///not named is left exactly as the session had it, so a page can pin the grid and still have somebody's
    ///zoom, colors and history come back.
    ///
    ///Through a SavedSession rather than by reaching into the view, because that is already how every one of
    ///these settings is applied - see Embedding.Over. Built from the state on screen rather than from
    ///nothing, so the values the address is silent about survive the round trip.
    ///
    ///Once. Re-applying on every render would put the grid back on each time somebody switched it off.
    ///
    ///**Never while a restore is landing**, which is what "last" needs once two renders can overlap. Restoring
    ///hands the view its settings across awaits, and a render in between - the view saying its picture is in
    ///takes down the loading note, which is one - ran this in the gap: the address turned the grid on, and the
    ///session's own setting then turned it off again. applyRestoredSettings calls this itself once the last of
    ///it has landed.
    ///
    private async Task applyEmbedding()
    {
        if (embeddingApplied || embedding.IsEmpty || gds is null || viewer is null || restoringState)
            return;

        embeddingApplied = true;

        if (embedding.FullScreen is bool wanted)
            fullScreen = wanted;

        //The two sidebars, which are the shell's rather than the view's - so they are set here rather than
        //going down with the rest through ApplySettings.
        if (embedding.CellTree is bool tree)
            cellTreeOpen = tree;

        if (embedding.Layers is bool layers)
            layersOpen = layers;

        //
        //Before the session is built from the file, because a layermap changes what that session holds: the
        //names, the colors, the roles and the fills all come off the layers, and buildSession reads them.
        //Applied straight to the file rather than through Over, unlike everything else here - see
        //Embedding.LayerMap for why a mapping is not session state.
        //
        await fetchLayerMap();

        await viewer.ApplySettings(embedding.Over(buildSession(gds)));

        await RenderGDS();

        //The framing was a way in rather than a setting to keep, so it leaves the address now it has landed.
        takeOutOfAddress("box", "camera");

        //So the visitor's next change writes over the embed's values rather than beside them.
        await saveSession();
    }

    #endregion ***********************************************

    ///
    ///Keeps the pictures the texture column of a layermap an address names, from those fetched from beside it or out
    ///of its zip, and hands back the names neither brought nor this browser already keeps. Those layers are drawn
    ///without one until it is chosen in the layer's settings; saying so is the caller's, in the strip over the view.
    ///A PDK's pictures are kept by the PDK manager's own - see PdkManager.keepTextures.
    ///
    private async Task<List<string>> keepTextures(LayerNames names, IReadOnlyDictionary<string, byte[]> brought)
    {
        var missing = new List<string>();

        foreach (string name in names.Textures.Values.Distinct(StringComparer.Ordinal))
        {
            if (brought.TryGetValue(name, out byte[]? picture))
            {
                await textures.SetAsync(name, picture);

                continue;
            }

            if (await textures.GetAsync(name) is null)
                missing.Add(name);
        }

        return missing;
    }

    private async Task onFileInputChanged(InputFileChangeEventArgs e)
    {
        var chosen = e.GetMultipleFiles(e.FileCount).FirstOrDefault();

        if (chosen is null)
            return;

        if (e.FileCount > 1)
            await js.InvokeVoidAsync("alert", "For now only one file is supported. If multiple files present only the first one will be read.");

        //
        //**A KLayout report is laid over what is open, not opened in its place** - and so ahead of every
        //question below, each of which is about replacing the file on screen. Known by its name: this is the door
        //layouts come through, and a layout is never called .lyrdb. Since the rules panel's Import went to the PDK
        //manager (2026-10-19), this and a drop on the drawing are the ways a report comes in.
        //
        if (chosen.Name.EndsWith(".lyrdb", StringComparison.OrdinalIgnoreCase))
        {
            await openReport(chosen);

            return;
        }

        //
        //**A file opened while another one is already open is a question, not an answer.**
        //
        //Both answers are ordinary: somebody has finished with this layout and is opening the next, or they
        //want this file inside the one on screen. Nothing about the upload says which, and guessing wrong
        //costs the visitor either their open file or the placement they meant to make. So it is asked - but
        //only when there is something to ask about, which is a file open, editing allowed, and the incoming
        //file holding cells that can be brought across.
        //
        if (await mayOfferImport(chosen))
            return;

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        //
        //**After that offer, never before it.** The offer is the one question an upload still asks: what was
        //asked here - whether to close the file on screen - has no answer to give now, since that file keeps a
        //tab of its own unless it gives way to this one. See makeRoomForFile.
        //
        makeRoomForFile();

        //Needed by downloadFile, which names its output after whatever is currently loaded.
        CurrentlySelectedFileName = Path.GetFileNameWithoutExtension(chosen.Name);
        CurrentlySelectedFileType = Path.GetExtension(chosen.Name);

        //An uploaded file exists only in this tab, so it has to stop being taken for a bundled example -
        //otherwise Share would name one, and the link would hand someone a different layout than the one on
        //screen.
        forgetExample();

        //Claimed before the stream is read, so an example still being fetched cannot land on top of this.
        //See openWanted: dropping a file in while the app is opening its own default is exactly the case.
        int wanted = wantAnOpen();

        //And said to be on its way, so the app does not open its own default over it - see fileArriving.
        fileArriving = true;

        try
        {
            //Straight into the parser rather than through a MemoryStream and then ToArray.
            //
            //That was three copies of the file alive at once - the browser's, the stream's growing buffer,
            //and the array copied out of it - before a single record existed. The parser takes the stream
            //now, so what is held is the records and nothing else.
            using var stream = chosen.OpenReadStream(MaximumUploadSize);

            //Into the history whether or not it is touched afterwards. This file exists in this tab and
            //nowhere else - there is no list to find it in again and no address that names it - so it is
            //the one kind of file where not keeping it means losing it.
            await selectFile(stream, pacer, intoHistory: true, wanted: wanted);
        }
        catch (OperationCanceledException) when (pacer.Canceled)
        {
            //Given up while it was being read, which is not a file that would not read: nothing to say.
            readingGivenUp(pacer);
        }
        catch (Exception ex)
        {
            loadingWhat = "";

            openFailed();

            endLoad(pacer);

            await js.InvokeVoidAsync("alert", $"Error loading the GDS file: {ex.Message}");

            _ = InvokeAsync(StateHasChanged);
        }
        finally
        {
            fileArriving = false;
        }
    }

    ///
    ///Whether a file somebody dropped or chose is on its way in, from the moment it is claimed until it is open.
    ///
    ///**For the app's own default, which must stand aside for it.** The default opens when there is nothing to
    ///restore - see restoreSessionOnce - and it asked only whether a file was open yet. A file being read is not
    ///open yet, so a drop during the start-up made the default open over it: newer by the token, so the dropped
    ///file's own open arrived stale and was thrown away. Waiting for the loading note to be on screen before
    ///reading widened that gap from rare to most of the time under load, which is what showed it.
    ///
    private bool fileArriving = false;

    #region Opening a file into the one already open ***********************************************

    ///<summary>The file waiting on the dialog's answer, parsed, with the plan for bringing it in.</summary>
    private Importing.Plan? importPlan = null;

    private byte[]? importBytes = null;
    private string importName = "";
    private string importType = "";

    ///<summary>The cell the placement would go into: the one being edited, or the one on screen.</summary>
    private string importInto = "";

    ///
    ///Puts the question up, and answers whether it was put up at all.
    ///
    ///False for every case where there is nothing to ask - no file open, a read-only page, a 3D or text view
    ///where there is no pointer to place anything with, or an incoming file with no cells in it. Each of
    ///those falls through to the ordinary open, which is what the visitor gets today.
    ///
    ///The bytes are read here rather than streamed straight into the parser, which the ordinary path is
    ///careful not to do. That care is worth keeping where it applies: it is one open of one file, and the
    ///alternative is a stream that has already been consumed by the time the question is answered. They are
    ///let go on either answer.
    ///
    private async Task<bool> mayOfferImport(IBrowserFile chosen)
    {
        if (gds is null || noEditing || view != ViewType.View2DSvg)
            return false;

        //
        //**Nothing on screen is theirs yet, so there is nothing to ask about.**
        //
        //The app opens an example of its own when there is no link and no session, which means there is
        //always a file open and the question would be asked on the very first upload - about a layout the
        //visitor never chose and has not touched. Asked then it is not a choice, it is a step: the answer
        //is always "open on its own", because adding to a suggestion nobody made is not a thing anybody
        //wants.
        //
        //One edit and the question comes back, which is the line that matters. A shape drawn into the
        //example makes it theirs, and from then on replacing it silently would throw away work.
        //
        if (openedItself && !fileEdited)
            return false;

        byte[] raw;

        try
        {
            using var stream = chosen.OpenReadStream(MaximumUploadSize);
            using var held = new MemoryStream();

            await stream.CopyToAsync(held);

            raw = held.ToArray();
        }
        catch
        {
            //Unreadable here is unreadable on the ordinary path too, which reports it properly.
            return false;
        }

        GDS incoming;

        try
        {
            incoming = parsedFrom(raw);
        }
        catch
        {
            return false;
        }

        if (Importing.PlanFor(gds, incoming) is not Importing.Plan plan)
            return false;

        importPlan = plan;
        importBytes = raw;
        importName = Path.GetFileNameWithoutExtension(chosen.Name);
        importType = Path.GetExtension(chosen.Name);
        importInto = cellOnScreen();

        StateHasChanged();

        return true;
    }

    ///<summary>Read as whichever of the four it is - the one sniff selectFile makes, see LayoutFile - so the question is asked about the same file the ordinary open would have produced.</summary>
    private static GDS parsedFrom(byte[] raw)
    {
        return LayoutFile.Read(raw);
    }

    ///
    ///The examples the picker lists, for the AI assistant to read beside the layout - see ExampleTools (2026-11-01,
    ///asked for). The transistor and the designs first, as the picker has them, then the cells; null when the
    ///manifests gave nothing.
    ///
    private GDSViewer.Ai.ExampleLibrary? assistantExamples;

    private GDSViewer.Ai.ExampleLibrary? examplesForAssistant()
    {
        if (exampleFiles.Count == 0 && pdkExamples.All(pdk => pdk.Cells.Count == 0) && designs.Count == 0)
            return null;

        var files = new List<GDSViewer.Ai.ExampleFile> { new GDSViewer.Ai.ExampleFile { Name = MosfetExample, Kind = "transistor", About = "A single sky130 MOSFET: diffusion, poly gate, contacts and li1.", Pdk = Pdk.Sky130 } };

        foreach (var design in designs)
            files.Add(new GDSViewer.Ai.ExampleFile { Name = design.File, Kind = "design", About = $"{design.Title}, by {design.Author}: {design.About}", Pdk = pdkOfBundled(design.File) });

        foreach (string cell in exampleFiles.Concat(pdkExamples.SelectMany(pdk => pdk.Cells)))
            files.Add(new GDSViewer.Ai.ExampleFile { Name = cell, Kind = "cell", Pdk = pdkOfBundled(cell) });

        return new GDSViewer.Ai.ExampleLibrary { Files = files, Open = openExampleForAssistant };
    }

    ///<summary>One example fetched and read on its own, named by the layermap its PDK ships with - never put in the place of the file open.</summary>
    private async Task<GDS> openExampleForAssistant(string name, CancellationToken ct)
    {
        byte[] raw = await httpClient.GetByteArrayAsync(bundledAddressOf(name), ct);
        var example = parsedFrom(raw);
        string layers = shippedLayers.GetValueOrDefault(pdkOfBundled(name), "");

        if (layers.Length > 0)
            LayerNames.Parse(layers).ApplyTo(example.AdditionalInformation.Layers);

        return example;
    }

    ///<summary>Where a placement would go: the file's first top cell, which is what the 2D view draws.</summary>
    private string cellOnScreen()
    {
        if (gds is null)
            return "";

        foreach (var summary in Hierarchy.Summarize(gds))
        {
            if (summary.IsTop)
                return summary.Name;
        }

        return "";
    }

    ///<summary>Opening it on its own after all, which is what the app did before the question existed.</summary>
    private async Task openImportedOnItsOwn()
    {
        if (importBytes is not byte[] raw)
            return;

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        //Into a tab of its own, the file on screen keeping its - see makeRoomForFile. Before the names change,
        //since those are what is put aside.
        makeRoomForFile();

        CurrentlySelectedFileName = importName;
        CurrentlySelectedFileType = importType;

        forgetImport();

        forgetExample();

        int wanted = wantAnOpen();

        try
        {
            await selectFile(raw, pacer, intoHistory: true, wanted: wanted);
        }
        catch (OperationCanceledException) when (pacer.Canceled)
        {
            readingGivenUp(pacer);
        }
        catch (Exception ex)
        {
            loadingWhat = "";

            openFailed();

            endLoad(pacer);

            await js.InvokeVoidAsync("alert", $"Error loading the GDS file: {ex.Message}");

            _ = InvokeAsync(StateHasChanged);
        }
    }

    ///
    ///Brings the cells in and hands the top one to the pointer.
    ///
    ///**One undo step for the whole import**, which is why the edits are wrapped rather than applied one at
    ///a time: a file of forty cells that took forty presses of undo to back out would be a worse answer than
    ///not offering the import. The placement is a second step on purpose - it is a separate decision, made
    ///later, with the pointer.
    ///
    ///The file is not marked as opened: what is on screen is still the visitor's own layout, under its own
    ///name, now holding one more cell. Naming the address after the imported file would offer a link that
    ///hands somebody else a different layout entirely.
    ///
    private async Task importAsCell()
    {
        if (gds is null || importPlan is not Importing.Plan plan)
            return;

        string top = plan.TopCell;
        string into = importInto;

        forgetImport();

        editHistory.Do(new CompoundEdit($"Import {importName}", plan.Edits));

        //Where every edit made outside a view goes - see changedOnHistory. This went to the shell's redraw alone,
        //and the 2D view keeps its flattened layout for the same file, so the cells just added were in the library
        //and not on screen until the view was switched away and back.
        await changedOnHistory(Array.Empty<GDS.ElementModel>());

        //After the redraw, so the cell it picks up is one the view has already been told about.
        if (viewer is Viewer2DSvg drawing)
            await drawing.CarryImported(top, into);
    }

    ///<summary>What the file holds and where it would go, in one sentence the dialog puts under the name.</summary>
    private string describeImport()
    {
        if (importPlan is not Importing.Plan plan)
            return "";

        string cells = "cells";

        if (plan.Cells == 1)
            cells = "cell";

        string holds = FormattableString.Invariant($"{plan.Cells} {cells}");

        if (importInto.Length == 0)
            return FormattableString.Invariant($"This file holds {holds}. Add them to the open library, or open the file on its own?");

        return FormattableString.Invariant(
            $"This file holds {holds}. Add them to the open library and place {plan.TopCell} in {importInto}, or open the file on its own?");
    }

    ///<summary>The renames, named - one is worth spelling out, and a long list is worth counting instead.</summary>
    private string renamedNote()
    {
        if (importPlan is not Importing.Plan plan || plan.Renamed.Count == 0)
            return "";

        if (plan.Renamed.Count == 1)
        {
            (string from, string to) = plan.Renamed[0];

            return FormattableString.Invariant($"This library already has a cell called {from}, so the one coming in is named {to}.");
        }

        return FormattableString.Invariant($"{plan.Renamed.Count} of its cells have names this library already uses, and arrive under numbered ones.");
    }

    private void forgetImport()
    {
        importPlan = null;
        importBytes = null;
    }

    ///<summary>Escape and the backdrop both mean "neither" - the file is dropped and nothing changes.</summary>
    private void cancelImport()
    {
        forgetImport();

        importName = "";
        importType = "";
    }

    #endregion ***********************************************

    ///<summary>
    ///Opens a bundled example and names it in the address, so the page can be linked, bookmarked, or
    ///carried onto a phone by the QR code.
    ///</summary>
    private async Task openExample(string fileName, bool itself = false)
    {
        //
        //**Here rather than in fetchExample, which is the difference between a press and everything else.**
        //This is the row click and the app's own first open, and the first open has nothing on screen to put
        //aside. The address watcher, the session restore and a tab put back go to fetchExample directly and
        //are untouched, which is right: following a link, or coming back to a file, is not opening another.
        //See makeRoomForFile.
        //
        //Already open in a tab, untouched, it is that tab - not the same example again beside it.
        //
        if (await switchToExample(fileName))
        {
            if (!itself)
                closeLists();

            return;
        }

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        makeRoomForFile();

        //
        //Chosen, so the list has done its job - see closeOnChoice.
        //
        //**But not by the app's own open, which nobody chose out of it.** A list pointed at while the app was still
        //starting is the visitor's, and the default example arriving under it shut it in their face - measured
        //2026-11-02 with the manifests held back two seconds, the list open at 3.1 s and shut at 4.7 s, a moment
        //before Mosfet's name went up. embedding.spec opens the list that early on purpose, to choose a row a page
        //brought in, and lost it whenever the machine was slow: filed as a flake under load on 2026-10-07.
        //
        if (!itself)
            closeLists();

        //Set before fetching, the way the ?file= path and a restore both do it.
        //
        //Fetching loads, draws *and saves*, so a name set afterwards meant that save recorded the example
        //that had been open before this one - a session naming one file and carrying another's layers.
        //Reopening the app then handed back the wrong file entirely, and the layer state that had been
        //saved against the right one was written over by the wrong one's defaults.
        string previous = selectedExample;
        selectedExample = fileName;

        bool opened;

        try
        {
            opened = await fetchExample(fileName, pacer, itself);
        }
        catch (OperationCanceledException)
        {
            readingGivenUp(pacer);

            return;
        }

        if (!opened)
        {
            //Put back only if nothing has been chosen since. A newer open - a file dropped in while this was
            //being fetched, which superseded it - has written its own, and this would write over it; and it
            //owns what was put aside for a tab, too.
            if (selectedExample == fileName)
            {
                selectedExample = previous;

                openFailed();
            }

            endLoad(pacer);

            return;
        }

        //
        //**Not written into the address**, which does not follow what is open - see takeOutOfAddress. This
        //used to write ?file= here, and that is what made a superseded open dangerous: the watcher on the
        //address opened the named example again as a fresh request, so an open somebody had moved on from
        //came back round and won the second time. With nothing written there is nothing to come back round.
        //
        //Only a file= a link left behind is taken out, which is one that did not open - a reload would
        //otherwise go back to that link rather than to this file.
        //
        takeOutOfAddress("file");
    }

    ///<summary>
    ///Fetches an example over HTTP and hands it to the parser. False if it could not be fetched, which
    ///?file= makes reachable from the address bar - a name that is in the picker but missing from the
    ///served folder used to reach the Blazor error UI instead of saying anything.
    ///
    ///**At the pace of the caller's load, handed over and handed on** - to selectFile, and from there to
    ///openParsedFile. Each of them used to look up the load in hand as it began, which after a wait can be another
    ///one: New pressed as an example's bytes arrived, and the rest of the example's read went on as New's load - and
    ///put the example in over the empty layout.
    ///</summary>
    private async Task<bool> fetchExample(string fileName, Pacer pacer, bool itself = false)
    {
        byte[] rawGDS;

        //Overtaken already, and not this load's page to put a note on any more.
        pacer.Token.ThrowIfCancellationRequested();

        //Claimed before the fetch, not after it. A token taken once the bytes are in would be the *newest*
        //by then, so a slow example finishing after an upload would still win - which is the whole failure.
        int wanted = wantAnOpen();

        var injected = injectedNamed(fileName);

        await showLoading(Path.GetFileName(fileName));

        try
        {
            rawGDS = await httpClient.GetByteArrayAsync(addressOf(fileName), pacer.Token);
        }
        catch (OperationCanceledException) when (pacer.Canceled)
        {
            //Given up, which is not a fetch that failed: nothing to say, and the caller puts the page back.
            throw;
        }
        catch (Exception ex)
        {
            loadingWhat = "";

            //An injected file says where it was going, and says the thing that is almost always wrong.
            //The fetch is cross-origin, the browser reports it as a plain failure with nothing in the
            //message about why, and a page that has just embedded this has no other way to find out.
            if (injected is not null)
                await js.InvokeVoidAsync("alert", $"Could not fetch \"{fileName}\" from {injected.Url}. {ex.Message}\n\nA file on another host has to be served with a cross-origin header that allows this page to read it.");
            else
                await js.InvokeVoidAsync("alert", $"Could not fetch the example \"{fileName}\". {ex.Message}");

            endLoad(pacer);

            return false;
        }

        //
        //**Given up while the bytes were on their way**, and they came all the same - the browser's fetch had
        //finished before the cancel reached it. Nothing about the page is this load's to change now.
        //
        pacer.Token.ThrowIfCancellationRequested();

        //
        //**Superseded while it was fetching**, which is the last moment nothing has been written yet. A file
        //dropped in meanwhile - the case openWanted is about - has put its own name in the fields below, and
        //writing this one's over it labeled the dropped file with this one's name: the download, the history
        //row and the shell's data-file all said Mosfet over a different layout. openParsedFile would throw the
        //stale result away, but the name was written before it got there.
        //
        if (wanted != openWanted)
            return false;

        //Set after the fetch, so a failed one does not rename what the download button would write.
        //GetExtension keeps the leading dot, matching how Viewer3D holds ModelDownloadFileType.
        //
        //An injected file is named by the embedder and their name need not carry an extension, so the
        //kind comes off the address instead - what to call the download is theirs, what it *is* is the
        //file's. A URL with no extension either leaves it empty, which is what an unnamed kind was
        //before this.
        if (injected is not null)
        {
            CurrentlySelectedFileName = fileName;
            CurrentlySelectedFileType = Path.GetExtension(new Uri(injected.Url).AbsolutePath);
        }
        else
        {
            CurrentlySelectedFileName = Path.GetFileNameWithoutExtension(fileName);
            CurrentlySelectedFileType = Path.GetExtension(fileName);
        }

        await selectFile(rawGDS, pacer, wanted: wanted, itself: itself);

        return true;
    }

    ///<summary>
    ///Acts on ?file= when the address brings one, and then takes it out of the address - see
    ///takeOutOfAddress.
    ///
    ///Deferred to after a render rather than done in OnParametersSet, because it needs the example list
    ///fetched during initialization and it reports a bad name through a JavaScript alert.
    ///</summary>
    private async Task openFileFromQuery()
    {
        if (string.IsNullOrEmpty(FileSlug))
        {
            await restoreSessionOnce();

            return;
        }

        if (string.Equals(FileSlug, openedFileSlug, StringComparison.OrdinalIgnoreCase))
            return;

        //Nothing can be resolved yet, and the slug must not be consumed - the render that completing the
        //fetch triggers brings us back here with the list in hand.
        if (!exampleListFetched)
            return;

        //Recorded before the await: loading renders, which brings us back here before it has finished.
        openedFileSlug = FileSlug;

        string? fileName = exampleNamed(FileSlug);

        if (fileName is null)
        {
            //Naming one that does exist is more use than saying this one does not: the names are long and
            //a link is usually wrong by a character or two.
            string example = exampleFiles.FirstOrDefault() ?? MosfetExample;

            await js.InvokeVoidAsync("alert", $"There is no bundled example called \"{FileSlug}\". Names look like \"{Path.GetFileNameWithoutExtension(example)}\" - or choose one from the list.");

            return;
        }

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        selectedExample = fileName;

        bool opened;

        try
        {
            opened = await fetchExample(fileName, pacer);
        }
        catch (OperationCanceledException)
        {
            readingGivenUp(pacer);

            //
            //**Given up, so the link has had its answer**, and is taken out of the address like one that opened -
            //where one that failed is left so it can be corrected. With nothing open behind it, that address is a
            //bare one, and the next render does what a bare one does: the last session, or the app's own example.
            //
            takeOutOfAddress("file");

            StateHasChanged();

            return;
        }

        //Open, and in the session by now - fetching saves - so the address can let go of it, and a reload
        //comes back to this file as it is left rather than to a fresh copy of it. A link that did not open
        //keeps saying what it asked for, as the bad name above does, so it can be corrected where it was typed.
        if (opened)
            takeOutOfAddress("file");
        else
            endLoad(pacer);

        StateHasChanged();
    }

    ///<summary>
    ///Restores last time's session, once, when the address does not name a file.
    ///
    ///The address wins when it names one: a link is a deliberate request for something specific, and
    ///handing someone their own last file instead would make a shared link mean different things to
    ///different people. Gated on the example list the same way the ?file= path is, since a session naming
    ///an example cannot be resolved before that list has arrived.
    ///</summary>
    private async Task restoreSessionOnce()
    {
        if (sessionRestoreAttempted || gds is not null || fileArriving || !exampleListFetched)
            return;

        sessionRestoreAttempted = true;

        //A load of its own, from nothing: a cancel of last session's file falls through to the app's own example
        //below, which is what an empty start opens.
        var pacer = beginLoad();

        bool restored;

        try
        {
            restored = await restoreSession(pacer);
        }
        catch (OperationCanceledException)
        {
            readingGivenUp(pacer);

            restored = false;
        }

        if (restored)
        {
            StateHasChanged();

            return;
        }

        endLoad(pacer);

        //
        //**A file may have arrived while that was reading.**
        //
        //The guard at the top is checked before an IndexedDB round trip, and an upload lands on its own
        //event - so somebody who drops a file in during that read has it replaced by the default example a
        //moment later.
        //
        //A hazard rather than a diagnosis: the flaky DXF specs turned out to be an extra read serialized in
        //front of the example list, not this - see OnInitializedAsync. Kept because losing a file somebody
        //just dropped in is worth one comparison, whether or not a spec has caught it.
        //
        //**Arrived, or arriving.** A file still being read is not open yet, and the default opened over it -
        //file-drop.spec caught that one. See fileArriving.
        //
        if (gds is not null || fileArriving)
            return;

        //Nothing to restore and no link to follow, so open the hand-made example rather than sit on an
        //empty canvas. It is the small one, and it is the file every other part of this is described
        //against - somewhere to start rather than a picker and a blank page.
        //
        //Through openExample, the way a press on its row goes: arriving here and arriving on ?file=Mosfet
        //end up in the same state, a bare address included, and the picker agrees with both.
        //
        //**Nobody asked for this one**, which is what makes it the file an upload may replace without asking -
        //so it is opened as the app's own, and openParsedFile says so as the file goes in. See mayOfferImport.
        //
        await openExample(MosfetExample, itself: true);

        //Nothing was restored, so the embed's settings have nothing to land after - they land here instead.
        await applyEmbedding();

        StateHasChanged();
    }

    ///
    ///An empty layout: one cell, no layers, nothing drawn.
    ///
    ///**Every other way in needs a file.** The picker, the examples, a link, a drop - all of them start from
    ///something that already exists, so there was no way to begin a layout of your own except by opening
    ///somebody else's and deleting it. `GDS.NewLibrary` is the library's answer to the same gap; this is the
    ///button on it.
    ///
    ///**Drawn in the PDK in use.** A blank layout has no layers to fit the PDK or not, so it counts as drawn in
    ///whichever PDK is in use (`LayerNames.Fits`, see fileFitsPdk): a layer added to it comes in named by that
    ///PDK, and the PDK's rules check it. It used to get no names at all, when only a bundled example was named.
    ///
    ///**In a tab of its own.** It used to replace what was on screen, and asked first: New sits in the toolbar
    ///beside Open and Download, and a button that wipes the drawing with one press is one people learn to be
    ///afraid of. With tabs the drawing is not wiped - it keeps its tab - so there is nothing to ask about. See
    ///makeRoomForFile.
    ///
    private async Task newLayout()
    {
        //A load of its own, which overtakes any still going - an empty library is read in no time, but the press is
        //a new file all the same and what was loading is no longer wanted.
        var pacer = beginLoad();

        makeRoomForFile();

        //Not a bundled example any more, so a link stops naming one.
        forgetExample();

        CurrentlySelectedFileName = NewLayoutName;
        CurrentlySelectedFileType = ".gds";

        //The library's own name follows the file's, so a download and the thing inside it agree.
        //
        //The one cell is entered by the 2D view rather than here: a layout with exactly one top cell is
        //opened into automatically, which is what gives the draw tool somewhere to put a shape. See
        //Viewer2DSvg.onlyTopCell.
        try
        {
            await openParsedFile(GDS.NewLibrary(NewLayoutName.ToUpperInvariant(), NewLayoutCell), pacer, intoHistory: true);
        }
        catch (OperationCanceledException)
        {
            //Overtaken by a newer load before it was drawn, which has the page now.
        }

        StateHasChanged();
    }

    ///<summary>What a new layout and its one cell are called.</summary>
    private const string NewLayoutName = "Untitled";

    private const string NewLayoutCell = "TOP";

    ///
    ///Stops taking what is loaded for a bundled example, for when it no longer is one: the picker stops
    ///marking it, Share and the QR code stop naming it, and the layer panel stops offering its mapping.
    ///
    ///**Not a navigation any more.** This used to take ?file= out of the address every time, back when the
    ///address named what was open. Now it does not follow what is open, so all that can be left there is a
    ///link that did not open, and only that goes. openedFileSlug is left alone for the same reason: it only
    ///matters while a file= is still there, which inside an iframe is the embedder's own - and forgetting it
    ///would have that file fetched again over the top of whatever replaced it.
    ///
    private void forgetExample()
    {
        selectedExample = "";

        takeOutOfAddress("file");
    }

    ///<summary>
    ///The example whose name matches, ignoring case and the .gds that the slug leaves off - or given whole, which is
    ///how a link names one that shares its name with another: GF180's tt_um_vga_clock.oas beside sky130's .gds.
    ///</summary>
    private string? exampleNamed(string slug)
    {
        if (string.Equals(slug, Path.GetFileNameWithoutExtension(MosfetExample), StringComparison.OrdinalIgnoreCase)
            || string.Equals(slug, MosfetExample, StringComparison.OrdinalIgnoreCase))
            return MosfetExample;

        var bundled = designFiles
            .Concat(pdkExamples.SelectMany(pdk => pdk.Designs))
            .Concat(exampleFiles)
            .Concat(pdkExamples.SelectMany(pdk => pdk.Cells))
            .ToList();

        if (bundled.FirstOrDefault(file => string.Equals(file, slug, StringComparison.OrdinalIgnoreCase)) is string whole)
            return whole;

        return bundled.FirstOrDefault(file => string.Equals(Path.GetFileNameWithoutExtension(file), slug, StringComparison.OrdinalIgnoreCase));
    }

    ///<summary>Reads a file's bytes, at the pace of the load it arrived in - see fetchExample - and opens it.</summary>
    private async Task selectFile(byte[] rawGDS, Pacer pacer, bool intoHistory = false, int? wanted = null, bool itself = false)
    {
        GDS parsed;
        LayoutFormat format = LayoutFile.FormatOf(rawGDS);
        bool oasis = format == LayoutFormat.Oasis;
        bool dxf = format == LayoutFormat.Dxf;
        bool svg = format == LayoutFormat.Svg;

        //Overtaken already, and not this load's page to put a note on any more.
        pacer.Token.ThrowIfCancellationRequested();

        await showLoading(CurrentlySelectedFileName + CurrentlySelectedFileType);

        //The parser rejects anything that is not a well-formed GDSII stream. Report that rather than
        //letting it reach the Blazor error UI, and leave whatever was already loaded on screen.
        try
        {
            //
            //**GDSII a record at a time, at the load's pace**, so a big one can be given up while it is read and
            //the page answers meanwhile - see GDS.FromBytesAsync. The other three have readers with no record
            //loop of that kind to pace, and read as they always did.
            //
            if (oasis)
                parsed = OasisReader.Read(rawGDS);
            else if (dxf)
                parsed = DxfReader.Read(rawGDS);
            else if (svg)
                parsed = SvgReader.Read(rawGDS);
            else
                parsed = await GDS.FromBytesAsync(rawGDS, pacer.Pause);
        }
        catch (InvalidDataException ex)
        {
            loadingWhat = "";

            endLoad(pacer);

            await js.InvokeVoidAsync("alert", $"Could not read this file. {ex.Message}");

            return;
        }

        await openParsedFile(parsed, pacer, intoHistory, oasis, dxf || svg, wanted, itself);
    }

    ///<summary>
    ///The same, off a stream that has not been drained into an array first.
    ///
    ///For the file the user chose off their machine, which arrives as a stream and is the one that can be
    ///large. Asynchronous because it has to be: the browser's file stream refuses a synchronous read.
    ///</summary>
    private async Task selectFile(Stream stream, Pacer pacer, bool intoHistory = false, int? wanted = null)
    {
        GDS parsed;

        //Which format it is, read off the front of the file rather than guessed from its name - see LayoutFile,
        //whose sniff this is. A file called .gds that is OASIS - or the other way round, which is what a rename
        //produces - opens correctly either way.
        byte[] head = await peekAsync(stream, LayoutFile.HeadLength);
        LayoutFormat format = LayoutFile.FormatOf(head);
        bool oasis = format == LayoutFormat.Oasis;
        bool dxf = format == LayoutFormat.Dxf;
        bool svg = format == LayoutFormat.Svg;

        //Overtaken while the front of it was read, and not this load's page to put a note on any more.
        pacer.Token.ThrowIfCancellationRequested();

        await showLoading(CurrentlySelectedFileName + CurrentlySelectedFileType);

        try
        {
            //The browser hands the file over a piece at a time, so reading it already lets the page in between
            //pieces - all a cancel needs here is the load's token, which stops the next piece being asked for.
            using var whole = new ConcatenatedStream(head, stream);

            if (oasis)
                parsed = await OasisReader.ReadAsync(whole, pacer.Token);
            else if (dxf)
                parsed = await DxfReader.ReadAsync(whole, pacer.Token);
            else if (svg)
                parsed = await SvgReader.ReadAsync(whole, pacer.Token);
            else
                parsed = await GDS.FromStreamAsync(whole, pacer.Token);
        }
        catch (InvalidDataException ex)
        {
            loadingWhat = "";

            endLoad(pacer);

            await js.InvokeVoidAsync("alert", $"Could not read this file. {ex.Message}");

            return;
        }

        await openParsedFile(parsed, pacer, intoHistory, oasis, dxf || svg, wanted);
    }

    ///<summary>
    ///The first few bytes of a stream, which is all it takes to know which format this is.
    ///
    ///Read off rather than peeked at, because the stream a browser hands over cannot be rewound - so what
    ///was taken is put back in front of it by ConcatenatedStream.
    ///</summary>
    private static async Task<byte[]> peekAsync(Stream stream, int count)
    {
        var head = new byte[count];
        int filled = 0;

        while (filled < count)
        {
            int read = await stream.ReadAsync(head.AsMemory(filled, count - filled));

            if (read == 0)
                break;

            filled += read;
        }

        return head[..filled];
    }

    ///
    ///How many opens have been asked for, so a slow one cannot land on top of a later one.
    ///
    ///**Every route in bumps this before it starts fetching, and only the newest gets to install.** Opening a
    ///file is a fetch or a disk read and then a parse, and nothing stopped two of those overlapping: whichever
    ///finished last won, which is not the same as whichever was asked for last. Two examples clicked quickly,
    ///or a file dropped in while the app is opening one of its own, are both that.
    ///
    ///**Hardening, and said plainly: this is not what fixed the flaky DXF specs.** Those came from an extra
    ///read serialized in front of the example list, which moved the app's fallback open into collision with
    ///the upload - see OnInitializedAsync. This guard was written while chasing that, it did not stop it, and
    ///it is kept because the hazard it describes is real rather than because it was shown to catch one.
    ///
    private int openWanted = 0;

    ///<summary>Marks a new open as the one that counts, and gives back the token to check against.</summary>
    private int wantAnOpen()
    {
        return ++openWanted;
    }

    ///<summary>Everything that happens once a file has been read, whichever way it was read - at the pace of the load it was read in, see fetchExample.</summary>
    private async Task openParsedFile(
        GDS parsed,
        Pacer pacer,
        bool intoHistory,
        bool fromOasis = false,
        bool fromDrawing = false,
        int? wanted = null,
        bool itself = false)
    {
        //Superseded while it was being read, so this result is stale. Dropped rather than installed: the
        //file somebody asked for most recently is the one that should be on screen.
        if (wanted is int token && token != openWanted)
            return;

        //
        //What the flattener made of it, so the banner can say when it is not the whole file - and where its
        //elements are, which every picture of it is drawn from.
        //
        //Flattened here rather than asked of the view, because the two views are separate components with
        //separate caches and the text view has no layout at all - and this has to be true whichever of the
        //three somebody happens to be looking at when they open a file.
        //
        //**Before the file goes in, and at the load's pace.** On a real chip these two walks are most of an
        //open - seven of the RGB mixer's twelve seconds on the dev server - and done before anything on screen
        //changes, a cancel during either has nothing to put back but the page's name. See cancelLoad.
        //
        var layout = await GdsFlattener.FlattenAsync(parsed, pacer.Pause);

        await layout.IndexAsync(pacer.Pause);

        //And again, since a newer open may have been asked for while those ran.
        if (wanted is int stillWanted && stillWanted != openWanted)
            return;

        //
        //And given up, if Cancel was heard where none of those walks stopped to look: a small file is read in one
        //go and has no pause left to throw from. Nothing on screen has changed yet, which is what readingGivenUp
        //puts back - from here on it would be the wrong way back.
        //
        pacer.Token.ThrowIfCancellationRequested();

        gds = parsed;
        gds.RowsForNewLayers = rowsForNewLayers;

        //
        //What a cancel from here on puts back: the file on screen as this began, and whether it was given a tab of
        //its own or gave way to this one. Taken before fileWentIn, which lets go of both.
        //
        var before = leaving ?? givingWay;
        bool gotTab = leaving is not null;

        //The file it replaces into a tab of its own, if it did not give way to this one - see makeRoomForFile.
        fileWentIn();

        if (pacer.CanCancel)
            undoLoad = undoNext ?? undoOpen(before, gotTab);

        //A different file, so the edits made to the last one point at a library that is no longer open -
        //and would apply themselves to nothing, or worse, to something. A session restore puts its own
        //stack back afterwards; see restoreEdits.
        editHistory.Clear();

        flattened = layout;
        flattenedFor = parsed;

        //What the download button writes. An OASIS, a DXF or an SVG is read into a GDSII library, so what
        //leaves here is GDSII whatever arrived - and naming it .oas, .dxf or .svg would hand someone a file
        //their tools would refuse on sight. A drawing is a DXF or an SVG: something drawn rather than laid out.
        openedConverted = fromOasis || fromDrawing;

        //The download starts on the format the file arrived as, since keeping it is the rule and
        //converting the exception. A restored session overrules this afterwards, which is somebody having
        //chosen rather than the default that was picked for them.
        //
        //A drawing opens on GDSII rather than on the format it came in. An SVG has no writer to go back
        //through, and a DXF's writer is offered in the picker for somebody who asks for it - but a drawing
        //opened here is opened to become a layout, and GDSII is what a layout is.
        if (fromOasis)
            downloadFormat = OasisExtension;
        else
            downloadFormat = ".gds";

        //A freshly opened file matches what it came from again, so a session can go back to naming it
        //rather than carrying a copy. Without this, one edit would make every file opened afterwards store
        //its whole self.
        fileEdited = false;

        //
        //Every route in but one is a file somebody asked for, and that one says so - see restoreSessionOnce,
        //the only place the app picks a file on its own behalf.
        //
        //**Here, as the file goes in, rather than set afterwards by the route that asked.** It was cleared here
        //and set back once the app's own open had finished - after its drawing, its save and the address - and
        //a file dropped on the drawing in that gap found a file "somebody chose" and was offered the import
        //instead of the plain question. file-drop.spec caught it once the loading note had made the gap longer.
        //
        openedItself = itself;

        //And it earns its history row on its own terms rather than inheriting the last file's. An example
        //opened after an upload is an untouched example, not something worth keeping.
        fileIsHistoryWorthy = intoHistory;

        leaveTheLastFile();

        //A file opened fresh is under the PDK in use if it is drawn in it - see fileUnderPdk. Put under it by hand is
        //a thing done to a file, and this one has had nothing done to it yet; a session that says otherwise comes back
        //through applyRestoredLayers.
        pdkTaken = false;
        fileUnderPdk = fileFitsPdk();

        //
        //**An example drawn in another built-in puts that one in use** (2026-11-02, with gf180mcu built in beside
        //sky130, and ihp-sg13g2 the same day): a GF180 example opened while sky130 was in use came in as bare numbers,
        //though the PDK that names it was a press away in the PDK manager. The chip over the layer list says which it is
        //now. See builtInForExample for why only an example, and only between the built-ins.
        //
        if (!fileUnderPdk && builtInForExample() is Pdk drawnIn)
        {
            pdks.Selected = drawnIn.Id;
            fileUnderPdk = fileFitsPdk();

            _ = savePdks();
        }

        //Names carry across files rather than belonging to one: a layer number means the same thing
        //throughout a technology, so naming 65/20 while looking at one cell names it in the next. The PDK in
        //use is what carries them.
        carryLayerNamesOver();

        //And its rules, on the same argument.
        carryDeckOver();

        //A different file, so its rows start where a file's rows start rather than inheriting what was set
        //on the last one's. Names do carry over, above; which layers were hidden does not.
        getLayers(keepSettings: false);

        //Nothing here for the preview frame. It used to hold a thumbnail of the open file, which had to be
        //rebuilt when a different one arrived; it holds whatever row the pointer is on now, and opening a
        //file does not move the pointer. Clearing it here wiped the picture under the pointer at the moment
        //a row was clicked, which is the one moment somebody is looking at it.

        await RenderGDS();

        //
        //Given up while the view drew it, which has put the page back already - or overtaken by a newer load,
        //which will save its own. Either way this file is not the one to write down, and whatever called this has
        //nothing left to do with it: thrown rather than returned, so a caller that would carry on - a session
        //being put back, laying its layers over the file - stops too. See cancelLoad.
        //
        pacer.Token.ThrowIfCancellationRequested();

        await saveSession();

        //The text view draws no picture to report, so nothing else ends the load. See viewDrawn.
        if (view == ViewType.ViewText)
            endLoad(pacer);
    }

    ///
    ///Takes off everything that was about the file that was open: what a run found in it and what was waived,
    ///a KLayout report of it, what it was compared with, and what its last download had to leave out.
    ///
    ///**Every way a file goes in, not only openParsedFile.** A saved state that carries its file - one from the
    ///history list, or a tab put back - sets the file itself rather than going through there, and it used to
    ///leave the last file's markers drawn over the one it put up. A tab switched to is exactly that, every time.
    ///
    private void leaveTheLastFile()
    {
        //Whatever the last download had to leave behind was about the last file.
        downloadNotice = "";

        //Rows held back for an undo of the last one's edits belong to nothing.
        removedLayers.Clear();

        //And whatever it was compared with was compared with the last one.
        staleComparison("A different file is open. Compare again to lay it over the one chosen.");

        //
        //And a report is what KLayout found in the last one, and a run's result was measured on it.
        //
        //**The run's went unnoticed until the report's was added beside it.** Left up, its markers were drawn
        //over this file where the last one's faults had been, under a line still counting them - 340 of the
        //555 timer's, across a transistor - which is the one thing a marker must never be: a claim about a
        //layout that is not the one on screen. An edit already takes them off for that reason; see onFileEdited.
        //
        forgetReport();

        drcResult = null;
        drcMarkers = "";

        //And what was waived in it: a waiver is about a fault in that layout, and this one has its own. A saved
        //state brings its own back - see applyRestoredLayers.
        waived.Clear();

        summarizeDrc();
    }

    ///<summary>
    ///Applies the names already in hand to a file that has just been opened.
    ///
    ///From the PDKs in hand rather than from storage, because this runs on every file open and a read there would
    ///put an IndexedDB round trip in front of every draw. They are read once, in OnInitializedAsync, and an edit
    ///in the layer panel goes into the one in use in hand before it is saved - see <see cref="rememberLayer"/> - so
    ///they hold the same thing the store does without being asked each time.
    ///</summary>
    private void carryLayerNamesOver()
    {
        if (gds is null)
            return;

        string pdk = pdkLayersForThisFile();
        string page = pageLayerMapForThisFile();

        if (pdk.Length == 0 && page.Length == 0)
            return;

        //
        //**The PDK's whole mapping**, every row of it at once. What carried from file to file used to be the names
        //read off whatever file was open last, laid over the bundled mapping - and that set was usually smaller than a
        //mapping, so after a reload on Mosfet.gds a standard cell opened with nwell unnamed and at no height at all,
        //since Mosfet has no nwell for a name to have been read off. A layer with no height is one the 3D view leaves
        //out entirely - see AdditionalGDSInformation.HasProcessStack - so a mapping with holes in it is geometry that
        //goes missing. A PDK is a whole mapping, and an edit in the sidebar goes into it - see rememberLayer - so what
        //somebody chose still lands on every layer it says anything about.
        //
        if (pdk.Length > 0)
            LayerNames.Parse(pdk).ApplyTo(gds.AdditionalInformation.Layers);

        //
        //**And the layermap an address named, over both, on an example opened in that page** - in place of the
        //bundled one, which stands aside for it. Last, because that is where it lands on the file the address
        //opened: fetched after that file was, it is laid over the names in hand there too. A page names its own
        //process, and the names a visitor carries from somewhere else could be another one's.
        //
        if (page.Length > 0)
            LayerNames.Parse(page).ApplyTo(gds.AdditionalInformation.Layers);

        //And the stack worked out over the heights it just brought. ApplyTo writes heights onto layers; only
        //this reads them back as a stack. See SetStackingOffsets.
        gds.AdditionalInformation.SetStackingOffsets(layerSpacing());
    }

    ///
    ///The PDK's layermap, for the file being opened when it is drawn in the PDK in use - see fileUnderPdk.
    ///
    ///**And only where the address has not said.** `layermap=` wins: it is laid over the file the address opens once
    ///it has been fetched, and in place of this one on every example opened in that page - see pageLayerMapForThisFile.
    ///Clear on the layers used to decline it for one file, until it went with the row it was in (2026-10-19): a file
    ///is drawn in a PDK or it is not, and which PDK is in use is the PDK manager's to say.
    ///
    private string pdkLayersForThisFile()
    {
        if (!pdkLaidOver())
            return "";

        return pdkLayers(pdks.InUse);
    }

    ///<summary>Whether the PDK's layers belong on the open file: drawn in it, and no address naming a layermap of its own.</summary>
    private bool pdkLaidOver()
    {
        return fileUnderPdk && embedding.LayerMap is null;
    }

    ///
    ///What a layer arriving on the open file takes its row from - GDS.RowsForNewLayers, handed to every file as it goes
    ///in: the PDK in use where it is laid over the file, and nothing anywhere else. Asked when the layer arrives, so it
    ///is the PDK in use then. Before the 2026-10-21 audit only the panel's Add layer did this, and a layer the AI assistant or the
    ///MCP link started came in bare - no name, no height for the 3D view, no role for Trace net.
    ///
    private LayerNames? rowsForNewLayers()
    {
        if (!pdkLaidOver())
            return null;

        return LayerNames.Parse(pdkLayers(pdks.InUse));
    }

    ///<summary>A PDK's layermap: its own, or for a built-in the one it ships with until it is changed.</summary>
    private string pdkLayers(Pdk pdk)
    {
        return pdk.Layers ?? shippedLayersOf(pdk);
    }

    ///<summary>A PDK's rules: its own, or for a built-in the deck it ships with until it is changed.</summary>
    private string pdkRules(Pdk pdk)
    {
        return pdk.Rules ?? shippedRulesOf(pdk);
    }

    ///<summary>The layermap a PDK ships with - empty for one made here, or for a built-in's that could not be read.</summary>
    private string shippedLayersOf(Pdk pdk)
    {
        return shippedLayers.GetValueOrDefault(pdk.Id, "");
    }

    ///<summary>The deck a PDK ships with, on the same terms as shippedLayersOf.</summary>
    private string shippedRulesOf(Pdk pdk)
    {
        return shippedRules.GetValueOrDefault(pdk.Id, "");
    }

    ///
    ///The built-in an example the app ships or lists is drawn in, while another built-in is in use - which the
    ///example's open puts in use. Null for anything else.
    ///
    ///**Only an example, whose PDK is known rather than guessed.** It was every file at first, judged by
    ///LayerNames.Fits against each PDK kept, and the spec suite answered within the hour: a DXF drawing's two layers,
    ///numbered from 0, fitted gf180mcu by its 0/0 and came in named as GF180 - and a file off somebody's machine is
    ///named only by the PDK in use, as it always was. **And only between the built-ins**: a PDK somebody made and put
    ///in use is one they chose, and an example opened under it stays under it - the one that names nothing included,
    ///which slider-carry.spec opens a sky130 cell under on purpose. Never for a file a page brought in, or one opened
    ///where an address names a layermap.
    ///
    private Pdk? builtInForExample()
    {
        if (selectedExample.Length == 0 || injectedNamed(selectedExample) is not null || embedding.LayerMap is not null)
            return null;

        if (!pdks.InUse.BuiltIn || exampleNamed(selectedExample) != selectedExample)
            return null;

        var drawnIn = pdks.Find(pdkOfBundled(selectedExample));

        if (drawnIn is null || drawnIn == pdks.InUse)
            return null;

        return drawnIn;
    }

    ///
    ///Whether the open file is drawn in the PDK in use - see fileUnderPdk: put under it by hand, or most of its layers
    ///the PDK's own. An example a page brought into the picker is somebody else's file and not this app's to name,
    ///short of being put under the PDK by hand.
    ///
    private bool fileFitsPdk()
    {
        if (gds is null)
            return false;

        if (pdkTaken)
            return true;

        if (selectedExample.Length > 0 && injectedNamed(selectedExample) is not null)
            return false;

        return LayerNames.Parse(pdkLayers(pdks.InUse)).Fits(gds.AdditionalInformation.Layers.Keys);
    }

    ///
    ///Takes an edit made to one of the open file's layers into the PDK in use: the row for <paramref name="key"/> made
    ///what the layer now says, so every file drawn in that PDK has it. Asked for 2026-10-18 - the layer panel edits the
    ///PDK, the way the PDK manager does.
    ///
    ///**Only on a file the PDK is laid over**, whose layer carries the PDK's row as well as the edit. On any other the
    ///edit is the file's own, kept in its session: written into the PDK it would put a row there knowing nothing of the
    ///PDK's - a layer renamed on a file from another process would lose the PDK's heights for that pair.
    ///
    private void rememberLayer(LayerKey key)
    {
        if (gds is null || !pdkLaidOver())
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return;

        var pdk = pdks.InUse;
        var rows = LayerNames.Parse(pdkLayers(pdk));

        rows.SetRow(key, layer);

        pdk.Layers = rows.Write();

        _ = savePdks();
    }

    ///
    ///Takes a deck put in place from the rules panel - a rule added, changed or taken away - into the PDK in use, on a
    ///file it checks, the way rememberLayer takes a layer's edit. Anywhere else it is a deck loaded by hand, as it always
    ///was, and stays the file's.
    ///
    private void rememberRules(string text)
    {
        if (!fileUnderPdk)
        {
            deckFromPdk = false;

            return;
        }

        var pdk = pdks.InUse;

        //Back to the one that ships, for a built-in, when that is what it has been made to say again.
        if (pdk.BuiltIn && text == shippedRulesOf(pdk))
            pdk.Rules = null;
        else
            pdk.Rules = text;

        deckFromPdk = true;

        _ = savePdks();
    }

    ///<summary>Keeps the PDKs. Best effort, like everything kept - see AppStorage.</summary>
    private async Task savePdks()
    {
        try
        {
            await pdkStore.SaveAsync(pdks);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not keep the PDKs: {ex.Message}");
        }
    }

    ///
    ///Carries what came before PDKs into sky130, the one built-in there was, once, in a browser that never kept a PDK list: the names that
    ///carried from file to file, which were the visitor's own choices - see SavedSession.CarriedLayerNames - and carry
    ///now as the built-in's rows. Laid over the shipped mapping, so a name chosen wins and everything else stays.
    ///
    ///**Not their colors.** A layout started from sky130's layers before 2026-10-18 marked all 21 colors as chosen, to
    ///keep them through a reload, and they carried as choices that nobody made - carried into the built-in, they would
    ///have pinned every sky130 file's palette to that one layout's. A color somebody did choose is still on their file.
    ///
    private async Task carryIntoPdk()
    {
        if (pdksKept)
            return;

        pdksKept = true;

        string shipped = shippedLayersOf(pdks.Default);

        if (carriedBeforePdks.Length > 0 && shipped.Length > 0)
        {
            var rows = LayerNames.Parse(shipped);
            var carried = LayerNames.Parse(carriedBeforePdks);

            carried.Colors.Clear();

            rows.MergeFrom(carried);

            if (rows.Write() != LayerNames.Parse(shipped).Write())
                pdks.Default.Layers = rows.Write();
        }

        await savePdks();
    }

    ///<summary>The empty layer list's offer - see setPdk.</summary>
    private string startPdkTitle()
    {
        return $"Pick a PDK in the PDK manager, and start with its layers, named, stacked and colored, ready to draw on. {pdks.InUse.Name} is in use now";
    }

    ///
    ///**The way into the PDK manager, at the top of the layer panel's list** - whichever list is up - with a line under
    ///it over "All layers" or the rules (asked for 2026-11-01). "PDK:" and the name of the PDK in use, as wide as the list.
    ///
    ///It was asked for 2026-10-19 over the names, in place of each list's own Import, Export, Clear and Example and of the
    ///PDK's name at the end of their rows, then in the names' row as the chip and "PDK", at the far left of the heading.
    ///**What names a file's layers and checks it is the PDK in use**, and the PDKs are kept there: their layermaps and
    ///decks brought in, written out and edited, and the one in use chosen. Those rows loaded a layermap or a deck into the
    ///open file alone, beside the PDK rather than into it, which was two ways to say what a layer is.
    ///
    ///Whether the PDK names this file is said when it is pointed at - see pdkLinkTitle.
    ///
    private RenderFragment pdkRow()
    {
        return (__builder) =>
        {
            <div class="sidebarPdkRow">
                <button type="button" id="sidebarPdkManager" class="sidebarPdkLink" @onclick="openPdkManager"
                        aria-haspopup="dialog" aria-label="PDK manager" title="@pdkLinkTitle()">
                    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                        <rect x="4.2" y="4.2" width="7.6" height="7.6" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M6.4 1.6v2.6M9.6 1.6v2.6M6.4 11.8v2.6M9.6 11.8v2.6M1.6 6.4h2.6M1.6 9.6h2.6M11.8 6.4h2.6M11.8 9.6h2.6"
                              fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                    PDK:

                    @*Not set while the list waits for one's layers (2026-11-01, asked for): the name there read as set.*@
                    @if (layersWaitForPdk)
                    {
                        <span id="sidebarPdkName" class="sidebarPdkName sidebarPdkNotSet">not set</span>
                    }
                    else
                    {
                        <span id="sidebarPdkName" class="sidebarPdkName">@pdks.InUse.Name</span>
                    }

                    @*The two arrows in a circle the README's Replace has, at the end: the PDK can be changed here (2026-11-01, asked for).*@
                    <svg class="sidebarPdkChange" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                        <path d="M13 6.5A5.2 5.2 0 0 0 3.4 4.6M3 9.5a5.2 5.2 0 0 0 9.6 1.9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        <path d="M13.4 2.4v4.3H9.1M2.6 13.6V9.3h4.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        };
    }

    ///
    ///What the PDK manager's link over the layer panel says when pointed at - see sidebarPdkManager: which PDK is in use,
    ///and whether it names and checks the open file. The link says only "PDK manager", so this is where the name is.
    ///
    private string pdkLinkTitle()
    {
        string name = pdks.InUse.Name;

        if (layersWaitForPdk)
            return "No PDK is set for this layout yet. Press to pick one, and start with its layers";

        if (gds is not null && !fileUnderPdk)
            return $"The PDK in use is {name}. This file's layers are not mostly {name}'s, so {name} names and checks nothing here. Press to manage your PDKs, or put another in use";

        return $"The PDK in use is {name}: it names this file's layers and checks it. Press to manage your PDKs, or put another in use";
    }

    ///<summary>Whether the PDK manager's window is up - see Components/PdkManager.razor.</summary>
    private bool pdkManagerOpen = false;

    ///<summary>Whether it was opened by the empty layer list's Set PDK, so the PDK used there lays its layers on - see setPdk.</summary>
    private bool pickingPdk = false;

    ///<summary>Whether the layer list is empty and offers Set PDK - a new layout, whose layers a PDK has not laid on yet.</summary>
    private bool layersWaitForPdk => gds is not null && layersAreEditable && checkboxItems.Count == 0;

    ///
    ///Opens the PDK manager, for picking whenever the layer list waits for a PDK - by Set PDK, the PDK row over the list,
    ///the settings menu or the palette alike (2026-11-01, asked for). Only Set PDK picked until then, so the row over the
    ///list opened the same manager on "in use", with the list still empty under it, and the two read as out of step.
    ///
    private void openPdkManager()
    {
        pdkManagerOpen = true;
        appSettingsOpen = false;
        pickingPdk = layersWaitForPdk;
    }

    ///
    ///**The empty layer list's Set PDK**: the PDK manager, opened to pick a PDK with, and the one used there - the one
    ///already in use as well, which offers its use pill while picking - lays its layers on the new layout and closes it.
    ///See usePdk. Asked for 2026-10-31 in place of a button that only ever offered the PDK in use.
    ///
    private void setPdk()
    {
        openPdkManager();
    }

    private void closePdkManager()
    {
        pdkManagerOpen = false;
        pickingPdk = false;

        //The settings opened on one of its rows go with it.
        pdkSettings = null;
    }

    ///<summary>A rule switched on or off from the PDK manager's list, the way its eye in the rules panel does.</summary>
    private async Task pdkRuleToggled(string id)
    {
        var rule = drcDeck?.Rules.FirstOrDefault(each => each.Id == id);

        if (rule is not null)
            await ruleToggled(rule);
    }

    ///
    ///Puts another PDK in use, from the PDK manager: it names and checks every file drawn in it from now on, and the open
    ///one if that is - see reapplyPdk.
    ///
    private async Task usePdk(string id)
    {
        if (pdks.Find(id) is null)
            return;

        if (pdks.Selected != id)
        {
            pdks.Selected = id;

            await savePdks();

            await reapplyPdk();
        }

        if (!pickingPdk)
            return;

        //Picked from Set PDK: its layers, on a list that is still empty.
        closePdkManager();

        if (layersWaitForPdk)
            await startWithPdkLayers();
    }

    ///
    ///A PDK changed in the PDK manager - its layers, its rules, the layers a layout starts with, its name. Kept, and laid
    ///over the open file again when it is the one in use.
    ///
    private async Task pdkEdited(Pdk pdk)
    {
        await savePdks();

        if (pdk == pdks.InUse)
            await reapplyPdk();
        else
            StateHasChanged();

        //The row the layer settings are open on, read again: the manager's table may just have changed it, and a switch
        //in the popup would otherwise write back what it read before.
        if (pdkSettings is not null && pdkSettings.Pdk == pdk)
            pdkSettings.Layer = pdkRowLayer(pdk, pdkSettings.Pair);
    }

    ///<summary>A PDK made or deleted in the PDK manager. Kept, and laid over the open file again if the one in use went with it.</summary>
    private async Task pdksChanged()
    {
        //Settings open on a row of a PDK just deleted would be writing into nothing.
        if (pdkSettings is not null && !pdks.Pdks.Contains(pdkSettings.Pdk))
            pdkSettings = null;

        string before = pdks.Selected;

        pdks.Selected = pdks.InUse.Id;

        await savePdks();

        if (pdks.Selected != before)
            await reapplyPdk();
        else
            StateHasChanged();
    }

    ///
    ///Lays the PDK in use over the open file again, after it changed or another was put in use: what a PDK had put on the
    ///file's layers taken off, the PDK's laid on if the file is drawn in it, and its rules the same way. A file put under
    ///a PDK by hand follows whichever one is in use.
    ///
    private async Task reapplyPdk()
    {
        if (gds is null)
        {
            StateHasChanged();

            return;
        }

        bool wasLaidOver = pdkLaidOver();

        fileUnderPdk = fileFitsPdk();

        if (wasLaidOver || pdkLaidOver())
        {
            LayerNames.Clear(gds.AdditionalInformation);

            //Restacked here, since LayerNames.Clear cannot know the 3D view's spacing, and laid on again the way a
            //file opening is, with an address's layermap over the PDK's.
            gds.AdditionalInformation.SetStackingOffsets(layerSpacing());

            carryLayerNamesOver();

            getLayers();
        }

        carryDeckOver();

        //Checked again where that was asked for, so the markers are about the rules in the panel.
        if (drcContinuous && drcDeck is not null)
            await runDrc();

        await RenderGDS();

        await saveChangedFile();

        StateHasChanged();
    }

    ///
    ///The three views: what each one is called, and the token the switch shows.
    ///
    ///The long name is the tooltip and the short one is the box. "2D Editor" rather than "2D Viewer"
    ///because it is one - shapes are drawn, dragged, retyped and combined there - and a name that
    ///undersells what a screen does is a screen people do not open.
    ///
    private static readonly (ViewType Which, string Says, string Shorthand)[] Views = new[]
    {
        (ViewType.ViewText, "Text Editor", "Txt"),
        (ViewType.View2DSvg, "2D Editor", "2D"),
        (ViewType.View3D, "3D Viewer", "3D")
    };

    ///
    ///One box of the view switch: the view it opens, as a picture, lit while it is on.
    ///
    ///**The cube opens the 3D view's settings while that view is on** - see the switch - and says so then: open or shut
    ///to a screen reader, what it opens in its tooltip, and to the eye a corner cut in under it, the mark a button with
    ///a menu carries where there is no room for a caret - see .viewPickOpens in app.css. Its id is the one the 3D view
    ///names it by, for the press anywhere else that puts the menu away.
    ///
    private RenderFragment viewPickBox(ViewType which, string says, string shorthand)
    {
        bool opens = opensViewSettings(which);

        return (__builder) =>
        {
            <button id="@(which == ViewType.View3D ? Viewer3D.SettingsOpener : null)"
                    class="buttonStyle2 toolbarButton toolButton buttonIcon viewPickBox @(view == which ? "toolButtonOn" : "") @(opens ? "viewPickOpens" : "")"
                    data-view="@which"
                    aria-pressed="@(view == which ? "true" : "false")"
                    aria-expanded="@viewSettingsShown(opens)"
                    aria-label="@says"
                    data-shorthand="@shorthand"
                    title="@viewPickSays(says, opens)"
                    @onclick="() => viewPicked(which)"
                    @onmouseenter="() => viewPointedAt(which)">
                @*
                    Pictures rather than the tokens, now that the tools two columns
                    along are pictures too - a row of words next to a row of glyphs
                    reads as two kinds of control where there is one.

                    A page of writing, a plan, and a cube: the three drawings every
                    program uses for exactly these three, and the only trio that tells
                    2D from 3D without reading them. The words survive as the label a
                    reader hears and the tooltip a pointer gets.
                *@
                @if (which == ViewType.ViewText)
                {
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <rect x="2.6" y="1.6" width="10.8" height="12.8" rx="1.4"
                              fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M5.2 5.2h5.6M5.2 8h5.6M5.2 10.8h3.4"
                              fill="none" stroke="currentColor" stroke-width="1.4"
                              stroke-linecap="round" />
                    </svg>
                }
                else if (which == ViewType.View2DSvg)
                {
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
