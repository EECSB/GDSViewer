    #region Initialization ***********************************

    protected override async Task OnInitializedAsync()
    {
        //Read once here rather than on every file open. It has to be before anything can open a file, and
        //it is: the ?file= path waits on exampleListFetched, which loadExampleFileList sets below.
        await loadStoredLayerNames();

        //
        //**Together, not one after the other.**
        //
        //Both are one same-origin read and neither needs the other, and awaiting them in sequence put an
        //extra round trip in front of the example list - which is what everything downstream waits on. That
        //moved the app's own fallback open later by exactly that much, into collision with a file dropped in
        //at the same moment: measured, the DXF specs went from stable to five flaky in four runs, and back to
        //stable when this read was taken out. WhenAll costs the slower of the two rather than the sum.
        //
        await Task.WhenAll(loadShippedRoles(), loadShippedDeck(), loadExampleFileList());
    }

    ///
    ///The layermap that ships, read once, so a bundled example arrives named.
    ///
    ///**Because every example in the picker is a sky130 cell.** The app deliberately compiles no PDK table in
    ///- see the note in Known gaps - and that is still right for a file somebody opens off their own machine,
    ///which could be any technology. It was never right for the files the app itself chose to ship: those are
    ///sky130, the mapping for them is sitting in the same folder, and leaving them as bare numbers meant the
    ///one feature that needs a mapping - Trace net - was a greyed-out button on every file the app offers.
    ///
    ///Read here rather than per open, because it is one 3 KB file from this app's own origin and every
    ///example open would otherwise wait on it. Best effort: a viewer that would not draw because a
    ///convenience file was missing is worse than one that shows numbers.
    ///
    private async Task loadShippedRoles()
    {
        try
        {
            shippedRoles = await httpClient.GetStringAsync(ShippedRolesPath);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the bundled layermap from {ShippedRolesPath}: {ex.Message}");
        }
    }

    ///
    ///The bundled deck, read once at start rather than on the open that needs it.
    ///
    ///The same arrangement as the layermap beside it and for the same reason: it is one 10 KB file from
    ///this app's own origin, and fetching it per example open would put a round trip in front of every
    ///one. Best effort - a viewer that would not draw because a convenience file was missing is worse
    ///than one that shows an empty rule panel.
    ///
    private async Task loadShippedDeck()
    {
        try
        {
            shippedDeck = await httpClient.GetStringAsync(ShippedDeckPath);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the bundled deck from {ShippedDeckPath}: {ex.Message}");
        }
    }

    ///<summary>Where the bundled layermap is served from. Beside the examples, since it is about them.</summary>
    private const string ShippedRolesPath = "resources/GDS Files/sky130-roles.csv";

    ///<summary>The bundled layermap's text, or empty if it could not be read. See loadShippedRoles.</summary>
    private string shippedRoles = "";

    ///
    ///Whether the visitor has said they do not want the bundled mapping.
    ///
    ///**So Clear means it, and goes on meaning it.** Without this, dropping the names and then opening
    ///another example hands them straight back - the app arguing with somebody who has just said they want
    ///the numbers.
    ///
    ///This was a per-page-load flag first, which was wrong in a way a spec already knew about: Clear has
    ///always dropped the *stored* names as well as the ones on screen, so bare numbers survived a reload -
    ///and a default that came back on the next load made Clear a button whose effect the reload undid. It
    ///lives in the session now; see SavedSession.NoBundledLayerNames.
    ///
    private bool declinedBundledRoles = false;

    ///<summary>
    ///Seeds the layer names from the saved session, so a file opened by a ?file= link on a fresh page is
    ///named too - not only one restored from a session.
    ///</summary>
    private async Task loadStoredLayerNames()
    {
        var session = SavedSession.Deserialize(await storage.GetAsync(SessionStorageKey));

        if (session is null)
            return;

        layerNames = session.LayerNames;

        //The deck alongside the names, for the same reason and by the same route. A reload that put one
        //back and not the other sent somebody to the file picker for something they had already chosen.
        restoreDeck(session.Deck);

        //Read here as well as on a full restore, because this is what a ?file= link on a fresh page gets -
        //and Clear has to outlast a reload however the next file arrives.
        //
        //With the file it was made against, since that is what keeps it to that file: restoring the flag on
        //its own would decline the mapping for whatever the link happens to name.
        declinedBundledRoles = session.NoBundledLayerNames;
        declinedBundledDeck = session.NoBundledDeck;
        declinedOn = session.ExampleName;
    }

    ///
    ///What the page hosting this asked for, read out of the address.
    ///
    ///Re-read on every parameter change rather than held from the first, so the back button through a set of
    ///embed links lands on what each of them says - the same reason ?view= is applied here.
    ///
    private Embedding embedding = new Embedding();

    ///<summary>Whether the embed's settings have been put on screen, which is done once and after the file.</summary>
    private bool embeddingApplied = false;

    ///<summary>Only the canvas, for a page that wants a picture rather than an editor.</summary>
    private bool viewerOnly
    {
        get { return embedding.Mode == AppMode.Viewer; }
    }

    ///<summary>The whole app, with everything that would change the file turned off.</summary>
    private bool noEditing
    {
        get { return embedding.Mode == AppMode.NoEdit; }
    }

    ///<summary>
    ///Applies ?view= from the address, on the first load and on every later change to it - which covers
    ///arriving on a shared link, and the back button walking through one.
    ///
    ///An address with no view stays that way rather than being rewritten to say "2d": a bare link should
    ///keep working as a bare link, and it already lands where a bare link should.
    ///</summary>
    protected override void OnParametersSet()
    {
        view = viewOf(ViewSlug);

        //Read here rather than held from the first load, so walking back through a set of embed links lands
        //on what each of them says. Its own parse rather than [SupplyParameterFromQuery] - see Embedding.
        embedding = Embedding.ReadFrom(NavigationManager.Uri);

        //And the picker rebuilt if this address names files the built list does not have. See
        //injectedSignature: the list is put together before this runs.
        if (exampleListFetched && injectedSignature() != injectedInList)
            rebuildFilteredExamples();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await openFileFromQuery();

        //The rename box only exists after the render that swapped it in, so the caret has to be put there
        //from here rather than when the click was handled.
        if (focusLayerNameBox)
        {
            focusLayerNameBox = false;

            await layerNameBox.FocusAsync();
        }

        //A restored session's own controls, once the view that owns them exists - which is this render.
        await applyRestoredSettings();

        //And the same for a view that was simply switched to, which destroys the component holding them.
        await applyCarriedSettings();

        //
        //And then what the address asked for, over the top.
        //
        //**Here rather than only after a restore**, because a restore is one of several ways to arrive: a
        //?file= link opens its file directly and never goes near the session, and hooking this to the
        //restore alone meant an embed that named a file - which is nearly all of them - had every one of its
        //other settings quietly ignored. Measured: banner and mode worked, and full, grid, tool and pitch
        //did not.
        //
        //Guarded on having been done, so it lands once and a later change to any of these is the visitor's.
        await applyEmbedding();

        //Re-render once whenever the active view changes, so its toolbar appears now that @ref has been
        //assigned. Comparing instances rather than using a flag means this settles by itself: the next
        //pass sees them equal and stops.
        if (ReferenceEquals(toolbarRenderedFor, viewer))
            return;

        toolbarRenderedFor = viewer;

        StateHasChanged();
    }

    ///<summary>
    ///Reads the manifest the build generates from the sample folder. A failure here only costs the
    ///example picker its entries, so it is reported to the console rather than to the user.
    ///</summary>
    private async Task loadExampleFileList()
    {
        try
        {
            exampleFiles = await httpClient.GetFromJsonAsync(ExampleManifestPath, SavedJson.Default.ListString) ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the example file list from {ExampleManifestPath}: {ex.Message}");
        }

        //Set either way: the list has been tried, so ?file= should stop waiting and say what it found.
        exampleListFetched = true;

        //The picker draws from the filtered list, so it has to be built once the names are in - otherwise
        //the popup opens on an empty list until something is typed into the filter.
        rebuildFilteredExamples();
    }

    #endregion ***********************************************



    #region Methods ******************************************


    ///<summary>
    ///Writes the open file out in whichever format the picker beside the button is on.
    ///
    ///An OASIS file is a GDSII library by the time it reaches here - the reader converts on the way in -
    ///so this is the same conversion in the other direction rather than a special case for files that
    ///arrived one way.
    ///</summary>
    private async Task downloadFile()
    {
        if (gds is null)
        {
            await js.InvokeVoidAsync("alert", "No GDS file loaded. Please upload a file or open an example.");
            return;
        }

        downloadNotice = "";

        byte[] file;
        string extension;

        try
        {
            (file, extension) = writeDownload();
        }
        catch (InvalidDataException refused)
        {
            //
            //**A refusal has to arrive as a message, not as Blazor's error bar.**
            //
            //Nothing here caught anything before, because nothing here threw: the writers took what they
            //were given. An uncaught exception out of an event handler takes the whole app down to a strip
            //of red and a reload - losing the edit that produced the shape it was complaining about.
            //
            //Rarer than it was. A shape too large for one GDSII record is cut into several now rather than
            //refused - see Fracture - so what is left to arrive here is the shape that will not part along
            //either axis, and whatever the writers come to throw later.
            //
            //Into the same line the download notices use, since it is the same question: what happened to
            //the file you just asked for.
            //
            downloadNotice = $"{refused.Message} Saving as OASIS instead has no such limit.";

            return;
        }

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + extension, "application/octet-stream", file);
    }

    ///<summary>The bytes and the extension for whichever format is chosen. Throws if they cannot be written.</summary>
    private (byte[] File, string Extension) writeDownload()
    {
        byte[] file;
        string extension;

        if (downloadFormat == OasisExtension)
        {
            file = OasisWriter.Write(gds, out int skipped);
            extension = OasisExtension;

            //A NODE has no OASIS spelling, so it is said out loud rather than quietly missing from the
            //file - which is the kind of thing found much later by whoever opens it.
            if (skipped > 0)
                downloadNotice = $"{skipped} element(s) had no OASIS equivalent and were left out of the download. NODE elements are the usual reason.";
        }
        else if (downloadFormat == DxfExtension)
        {
            file = DxfWriter.Write(gds);
            extension = DxfExtension;

            //
            //**Said every time, because it is the one thing about the conversion somebody has to know.**
            //
            //A DXF has no layer numbers - its layers are names - so the pair is written into the name. A
            //mask shop expecting 68/20 receives a layer called L68D20, and a reader that knows the
            //convention takes the numbers back out. Not a warning: nothing is lost. It is a thing to be
            //told before the file is sent on rather than after.
            //
            downloadNotice = "Layers are named L<layer>D<datatype> in the drawing, since DXF has no layer numbers of its own.";
        }
        else
        {
            file = gds.Serialize();

            //The name the file came in as, so a .GDS stays a .GDS - but never the OASIS one, since what is
            //written here is a GDSII library and handing it back as .oas is a file every tool refuses.
            extension = CurrentlySelectedFileType;

            if (openedConverted || extension.Length == 0)
                extension = ".gds";
        }

        return (file, extension);
    }

    private async Task changeDownloadFormat(ChangeEventArgs e)
    {
        downloadFormat = e.Value?.ToString() ?? ".gds";
        downloadNotice = "";

        await saveSession();
    }

    private void dismissDownloadNotice()
    {
        downloadNotice = "";
    }

    ///<summary>
    ///Redraws the bar after a view changes which of its tools is active.
    ///
    ///Empty on purpose. A view's toolbar is a RenderFragment rendered here rather than in the view, so
    ///which button looks pressed is decided during *this* component's render - and the view calling its
    ///own StateHasChanged does not cause one. Handling the callback at all is what does; there is nothing
    ///for this to actually do.
    ///</summary>
    private void redrawToolbar()
    {
    }

    ///<summary>
    ///Loads a layer/datatype to name mapping and relabels the sidebar with it.
    ///
    ///Kept separate from the GDS upload on purpose: this does not touch the file, only what the layers in
    ///it are called. Nothing is parsed out of the layout, so a mapping that turns out to be for another
    ///technology costs a message rather than the open file.
    ///</summary>
    #region Design rules ****************************************************************

    ///<summary>
    ///The deck in force, or null until one is loaded.
    ///
    ///Held here rather than in the view for the same reason the layermap is: both are PDK data that the
    ///file cannot carry, both arrive from a file somebody chooses, and both outlive whichever view is
    ///mounted. Switching to the 3D view and back should not lose a deck.
    ///</summary>
    private DrcDeck? drcDeck;

    ///<summary>
    ///The deck's own text, kept so a session can carry it back.
    ///
    ///Beside the parsed form rather than rebuilt from it: a deck is written by hand, and a round trip
    ///through the parser would hand back only what this build understood - dropping the comments, the
    ///blank lines and any rule it refused. The file that came back would not be the file that went in, and
    ///a second reload would erode it again.
    ///</summary>
    private string drcDeckText = "";

    ///<summary>
    ///Where the starter deck is served from. Beside the examples, since it is written for them.
    ///
    ///The same arrangement as the bundled layermap, and the file itself lives here rather than under
    ///OtherResources so that there is one copy of it - a second would be the one that went stale.
    ///</summary>
    private const string ShippedDeckPath = "resources/GDS Files/sky130A.drc";

    ///<summary>The starter deck's text, or empty until it is asked for. Fetched once.</summary>
    private string shippedDeck = "";

    ///<summary>
    ///Whether somebody has cleared the deck, so it stops being laid over the examples.
    ///
    ///The same flag the bundled layermap has, for the same reason: Clear has to mean something. Without it
    ///the deck would come straight back on the next example opened, and the button would read as broken.
    ///</summary>
    private bool declinedBundledDeck = false;

    ///
    ///The bundled deck, over a bundled example, unless somebody has said otherwise.
    ///
    ///**Every example this app ships is a sky130 cell**, and the deck for them is in the same folder as
    ///the layermap that is already applied this way. Opening one and finding the rules panel empty made
    ///the visitor go and fetch a file the app was already holding - for the one PDK every bundled file
    ///belongs to.
    ///
    ///Only where nothing is loaded and nothing was cleared, and only for a file this app ships: an upload
    ///is somebody else's layout and guessing sky130 rules at it would be wrong.
    ///
    private void carryDeckOver()
    {
        if (drcDeck is not null || declinedBundledDeck || shippedDeck.Length == 0)
            return;

        //A bundled example rather than an upload, a history entry, or a file an embedding page brought.
        if (selectedExample.Length == 0 || injectedNamed(selectedExample) is not null)
            return;

        var deck = DrcDeck.Parse(shippedDeck);

        if (deck.Rules.Count == 0)
            return;

        drcDeck = deck;
        drcDeckText = shippedDeck;

        drcResult = null;
        drcMarkers = "";

        summarizeDrc();
    }
    ///<summary>
    ///The deck to carry, which is nothing when it is the bundled one.
    ///
    ///**A deck the app already ships is not worth copying into the session.** It is ten kilobytes, and it
    ///is laid over every bundled example automatically - so storing it turned a session that was a file
    ///*name* into one carrying a file's worth of text, and a test that pins an unedited example at under
    ///1.5 KB caught it at 5.5. Restoring re-applies it through carryDeckOver, which is where it came from.
    ///
    ///The same reasoning as the bundled layermap, which is deliberately not written into layerNames.
    ///</summary>
    private string deckToRemember()
    {
        if (drcDeckText == shippedDeck)
            return "";

        return drcDeckText;
    }

    ///<summary>
    ///Loads the deck that ships beside the examples.
    ///
    ///**Fetched when it is pressed for rather than at startup**, unlike the layermap. That one is laid over
    ///every example automatically and has to be in hand before the first file opens; this is only ever
    ///wanted by somebody who has asked for it, and a viewer should not spend a request on a rule deck
    ///nobody has mentioned.
    ///</summary>
    private async Task loadBundledDeck()
    {
        if (shippedDeck.Length == 0)
        {
            try
            {
                shippedDeck = await httpClient.GetStringAsync(ShippedDeckPath);
            }
            catch (Exception ex)
            {
                await js.InvokeVoidAsync("alert", $"Could not read the bundled deck from {ShippedDeckPath}: {ex.Message}");

                return;
            }
        }

        var deck = DrcDeck.Parse(shippedDeck);

        if (deck.Rules.Count == 0 && deck.Refused.Count == 0)
            return;

        //Asked for, so it stops being declined - the same thing loadBundledLayerNames does one panel over.
        //Without it, taking the deck back after a Clear got it for this file only, and the next example
        //opened empty again.
        declinedBundledDeck = false;

        drcDeck = deck;
        drcDeckText = shippedDeck;

        //What the last deck found is not what this one would find.
        drcResult = null;
        drcMarkers = "";

        summarizeDrc();

        await saveSession();

        StateHasChanged();
    }

    ///<summary>
    ///Where the deliberately-failing deck is served from, for seeing what a violation looks like.
    ///</summary>
    private const string StrictDeckPath = "resources/GDS Files/sky130A-strict.drc";

    ///<summary>
    ///Loads a deck the bundled cells cannot satisfy.
    ///
    ///**Because a correct deck over signed-off layout finds nothing**, which is the right answer and a
    ///useless demonstration - somebody trying the feature for the first time gets "no violations" and no
    ///way to tell a working check from a broken one. This one has the same rules with the limits tightened
    ///past what the layout is, so every marker, count and color has something to show.
    ///</summary>
    private async Task loadStrictDeck()
    {
        string text;

        try
        {
            text = await httpClient.GetStringAsync(StrictDeckPath);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read the demonstration deck from {StrictDeckPath}: {ex.Message}");

            return;
        }

        var deck = DrcDeck.Parse(text);

        if (deck.Rules.Count == 0)
            return;

        drcDeck = deck;
        drcDeckText = text;

        drcResult = null;
        drcMarkers = "";

        summarizeDrc();
        closeInfo();

        await saveSession();

        StateHasChanged();
    }

    ///<summary>
    ///Puts a stored deck back, quietly.
    ///
    ///No message and no alert, unlike picking one from the dialog: this happens while the page is loading,
    ///for something the visitor chose on a previous visit and has not asked about now. A deck that no
    ///longer parses is dropped rather than reported, the way a stored layermap that no longer applies is.
    ///</summary>
    private void restoreDeck(string text)
    {
        if (text.Length == 0)
            return;

        var deck = DrcDeck.Parse(text);

        if (deck.Rules.Count == 0 && deck.Refused.Count == 0)
            return;

        drcDeckText = text;
        drcDeck = deck;
    }

    ///<summary>What the last check found, or null when none has been run since the deck was loaded.</summary>
    private DrcResult? drcResult;

    ///<summary>The markers as markup, handed to the 2D view. Empty when there is nothing to draw.</summary>
    private string drcMarkers = "";

    ///<summary>
    ///A ceiling on the deck file. The same one the layermap uses, and for the same reason: OpenReadStream
    ///refuses anything larger than 512 KB unless told otherwise, and a deck is smaller than a layermap.
    ///</summary>
    private const long MaximumDeckSize = 4 * 1024 * 1024;

    private async Task onDrcDeckChosen(InputFileChangeEventArgs e)
    {
        string text;

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaximumDeckSize));

            text = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}: {ex.Message}");

            return;
        }

        var deck = DrcDeck.Parse(text);

        if (deck.Rules.Count == 0 && deck.Refused.Count == 0)
        {
            await js.InvokeVoidAsync("alert", $"{e.File.Name} holds no rules.\n\n{string.Join("\n", deck.Problems)}");

            return;
        }

        drcDeck = deck;
        drcDeckText = text;

        //A deck loaded over another one invalidates what the last one found, and leaving the old markers on
        //screen beside a new deck's name would be the most confusing state available.
        drcResult = null;
        drcMarkers = "";

        summarizeDrc();

        //Kept, the way a loaded layermap is. Choosing a deck is the way somebody sets up a whole PDK's
        //rules, and it was the one route of the two that did not stick.
        await saveSession();

        StateHasChanged();
    }

    ///
    ///Runs the deck over what is open.
    ///
    ///On the prepared layout where there is one: the shell already holds one after a file opens, and
    ///resolving the hierarchy is the expensive part of that. See GdsFlattener.Flattens, which exists to
    ///catch exactly this kind of quiet second walk.
    ///
    ///**Where there is not one, it works one out rather than doing nothing.** An edit drops the shell's copy
    ///- the library is changed in place, so what is held is of the file as it was, and RenderGDS hands the
    ///view a null that means "work it out for yourself". This read the same null as "nothing to check" and
    ///returned, which made **DRC Check a button that did nothing from the first edit onward** - and took
    ///"check on edit" down with it, since that comes through here too. Silent both times: no marks, no
    ///message, and a deck listed above saying the rules were loaded.
    ///
    ///Worked out here and kept, because the next edit nulls it again - onFileEdited is the one funnel every
    ///edit passes through, so a layout cached here cannot outlive the file it was taken from.
    ///
    private async Task runDrc()
    {
        if (drcDeck is null || gds is null)
            return;

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        drcResult = Drc.Check(drcDeck, flattened!);
        drcMarkers = SvgWriter.Markers(drcResult.Violations);

        summarizeDrc();

        StateHasChanged();

        await Task.CompletedTask;
    }

    ///<summary>
    ///Drops the deck and everything that came from it.
    ///
    ///**The same thing Clear does in the layer panel**, which drops an imported layermap rather than
    ///merely what it is currently drawing. The two sit in the same place in the same row, so they had
    ///better mean the same thing - and this one used to keep the deck and take only the markers off,
    ///which made one Clear a reset and the other a tidy-up.
    ///
    ///The deck's text goes with it, so a reload does not bring back a file that was deliberately dropped.
    ///Import and the bundled deck are both one press away again once it has.
    ///</summary>
    private async Task clearDrc()
    {
        drcDeck = null;
        drcDeckText = "";

        drcResult = null;
        drcMarkers = "";

        //Off with the deck. Left on, it would go on re-checking against rules that are no longer loaded -
        //a run that cannot happen under a switch saying it is happening.
        drcContinuous = false;

        //And it stays cleared for this file, reload included: without this a restore would lay the bundled
        //deck straight back over it, and Clear would read as a button that does nothing. Opening a different
        //file lets it apply again - see reArmBundledPdkData.
        declinedBundledDeck = true;
        declinedOn = selectedExample;

        summarizeDrc();

        await saveSession();
    }

    ///<summary>
    ///What the Check button will do, which is worth saying before it is pressed.
    ///
    ///It says what the press *does* as well as what it will run, because "Check against 30 rules" tells
    ///somebody who already knows what a check is nothing they did not know.
    ///
    ///The same sentence with the switch on, because the press does the same thing. It used to say "nothing
    ///to press" and the button was disabled to match - see the markup for why both went.
    ///</summary>
    private string drcDeckDescription()
    {
        if (drcDeck is null)
            return "";

        var said = new StringBuilder();

        said.Append($"Measure the layout against all {drcDeck.Rules.Count} rule(s) in the deck and mark on the drawing what fails.");

        if (drcDeck.Refused.Count > 0)
            said.Append($" {drcDeck.Refused.Count} more cannot be measured by this build and will not run.");

        return said.ToString();
    }

    ///<summary>
    ///What the switch beside it does, in both of its positions.
    ///
    ///**The off position needs saying as much as the on one.** What happens to a result when the layout
    ///changes under it is the part nobody would guess: it is taken away rather than left to go stale, so
    ///a marker on screen is always a claim about the layout on screen.
    ///</summary>
    private string drcContinuousDescription()
    {
        if (drcContinuous)
            return "On: the deck is run again after every edit, so the marks always match what is drawn. The button still runs it whenever you press. Turn this off to check only when you do.";

        return "Off: press the button to check. An edit takes the last result off the drawing rather than leaving it out of date. Turn this on to have every edit checked as well.";
    }

    private string? drcDescriptionOf(string ruleId)
    {
        if (drcDeck is null)
            return null;

        foreach (var rule in drcDeck.Rules)
        {
            if (rule.Id == ruleId)
                return rule.Description;
        }

        return null;
    }

    ///<summary>
    ///Where a violation is, in database units.
    ///
    ///A point for an off-grid fault, which has no extent - printing a box for one would be drawing a fact
    ///that is not there.
    ///</summary>
    private static string drcWhere(DrcViolation violation)
    {
        var bounds = violation.Bounds;

        if (violation.Check == DrcCheck.OffGrid)
            return FormattableString.Invariant($"{bounds.Left},{bounds.Bottom}");

        return FormattableString.Invariant($"{bounds.Left},{bounds.Bottom} to {bounds.Right},{bounds.Top}");
    }

    ///<summary>Frames the 2D view on one fault. Nothing to do if the view is not the one mounted.</summary>
    private async Task showViolation(DrcViolation violation)
    {
        if (viewer is Viewer2DSvg drawing)
            await drawing.FrameOn(violation.Bounds);
    }

    ///<summary>
    ///Writes the deck in force back out as a file.
    ///
    ///The text that came in rather than the parse printed back, which is why drcDeckText is kept at all.
    ///A deck round-tripped through the parser would come back without its comments, its blank lines and
    ///any rule this build refused - so Export would quietly be a way of losing part of your own file.
    ///</summary>
    private async Task exportDeck()
    {
        if (drcDeck is null)
            return;

        byte[] deck = Encoding.UTF8.GetBytes(drcDeckText);

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + " rules.drc", "text/plain", deck);
    }

    ///<summary>
    ///Whether every edit is checked, rather than waiting to be asked.
    ///
    ///Off to begin with. A check walks the whole layout, and on a large one that is seconds - which is a
    ///pause after every dragged vertex if it is not asked for. Somebody who wants it says so, and the
    ///Check button steps aside once they have, because with this on there is nothing left for it to do.
    ///</summary>
    private bool drcContinuous;

    private async Task toggleContinuous(ChangeEventArgs e)
    {
        drcContinuous = e.Value is bool on && on;

        //Turned on with a deck already loaded, it owes an answer straight away rather than at the next
        //edit - the switch says the panel is current, and a stale result under it would say otherwise.
        if (drcContinuous)
            await runDrc();
    }

    ///<summary>
    ///Which rules the last run found something under. Empty when nothing has run.
    ///
    ///A set rather than a walk of the violations per row: a run over a real layout returns thousands, and
    ///the rule list asks this question once per rule on every render.
    ///</summary>
    private HashSet<string> brokenRules = new();

    ///<summary>How many faults a rule accounted for, for the count beside its row.</summary>
    private Dictionary<string, int> drcCounts = new();

    private int countFor(string ruleId)
    {
        if (drcCounts.TryGetValue(ruleId, out int many))
            return many;

        return 0;
    }

    ///<summary>
    ///The first fault a rule found, so clicking its row goes to it.
    ///
    ///The first rather than a list: a rule with four hundred faults under it is not a thing to page
    ///through in a sidebar, and the markers are already drawn on all four hundred. This puts the view
    ///where one of them is, and the rest are in front of you once it is there.
    ///</summary>
    private Dictionary<string, DrcViolation> drcFirst = new();

    private async Task showRule(string ruleId)
    {
        if (drcFirst.TryGetValue(ruleId, out var violation))
            await showViolation(violation);
    }

    ///<summary>
    ///What the run found, said in the view rather than in the panel.
    ///
    ///**Where the drawing hint goes**, and in its shape - because it is the same kind of thing: one line
    ///about what the view is showing you right now, over the drawing it is about. The faults themselves
    ///are the markers; this is the sentence that says how many there are and whether the answer can be
    ///trusted, which is the part a marker cannot say.
    ///
    ///Empty when no run has happened, which is what keeps the banner off the view until it has.
    ///</summary>
    private string drcNotice = "";

    ///<summary>
    ///Whether that notice is bad news, so the view can color it like the markers rather than like a hint.
    ///</summary>
    private bool drcNoticeIsFault;

    ///<summary>
    ///Takes the run's message off the drawing and leaves the markers on it.
    ///
    ///Two different things: the sentence says how many faults there are and whether every rule ran, and
    ///the markers say where each one is. Somebody who has read the first still wants the second - so this
    ///closes the message only. Clear in the panel is what takes the marks off.
    ///</summary>
    private void dismissDrcNotice()
    {
        drcNotice = "";
    }

    ///<summary>
    ///Sorts a finished run into what the panel and the view each need from it.
    ///
    ///Once, here, rather than from the render: the rule list asks about every rule and the notice asks
    ///about the whole run, and a run over a real layout has thousands of violations in it.
    ///</summary>
    private void summarizeDrc()
    {
        brokenRules = new HashSet<string>();
        drcCounts = new Dictionary<string, int>();
        drcFirst = new Dictionary<string, DrcViolation>();

        if (drcResult is not DrcResult found)
        {
            drcNotice = "";
            drcNoticeIsFault = false;

            return;
        }

        foreach (var violation in found.Violations)
        {
            brokenRules.Add(violation.RuleId);

            drcCounts.TryGetValue(violation.RuleId, out int seen);
            drcCounts[violation.RuleId] = seen + 1;

            if (!drcFirst.ContainsKey(violation.RuleId))
                drcFirst[violation.RuleId] = violation;
        }

        drcNotice = drcSentence(found);
        drcNoticeIsFault = found.Violations.Count > 0 || !found.Complete;
    }

    ///<summary>
    ///The one line the view shows.
    ///
    ///**What did not run is said first, and said even when nothing was found.** A count of faults reads as
    ///an answer, and it is only an answer when every rule actually ran - so "no violations" under a rule
    ///that was skipped would be the one sentence in the app that is not true.
    ///</summary>
    private string drcSentence(DrcResult found)
    {
        var said = new StringBuilder();

        if (found.Violations.Count == 0)
            said.Append("no violations");
        else if (found.Violations.Count == 1)
            said.Append("1 violation");
        else
            said.Append($"{found.Violations.Count} violations");

        if (brokenRules.Count > 0)
            said.Append($" \u00b7 {string.Join(", ", brokenRules.OrderBy(rule => rule, StringComparer.Ordinal))}");

        if (found.Complete)
            said.Append($" \u00b7 all {drcDeck!.Rules.Count} rule(s) ran");
        else
            said.Append($" \u00b7 not fully checked: {string.Join("; ", found.NotRun.Concat(found.Problems))}");

        return said.ToString();
    }

    #endregion **************************************************************************

    private async Task onLayerNamesChosen(InputFileChangeEventArgs e)
    {
        if (gds is null)
        {
            await js.InvokeVoidAsync("alert", "Open a GDS file first - layer names are applied to the layers it uses.");

            return;
        }

        string text;

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaximumLayerNamesSize));

            text = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}: {ex.Message}");

            return;
        }

        var names = applyLayerMapText(text, out int applied);

        await RenderGDS();

        //Kept, like a name typed on a row. Loading a mapping and not remembering it was the odd one out:
        //it is the way most people would name a whole PDK, and it was the one route that did not stick.
        await saveChangedFile();

        await reportLayerMap(names, applied);
    }

    ///<summary>
    ///Applies the bundled sky130 layermap, the same one an example gets laid over it automatically.
    ///
    ///Through applyLayerMapText like an imported file, so it is remembered, carries onto the next file and
    ///reports what it matched - the offer is a shortcut past the file picker, not a second way in.
    ///</summary>
    private async Task loadBundledLayerNames()
    {
        if (gds is null || shippedRoles.Length == 0)
            return;

        //Asked for, so it stops being declined: Clear set that, and this is somebody undoing it.
        declinedBundledRoles = false;

        var names = applyLayerMapText(shippedRoles, out int applied);

        await RenderGDS();

        await saveChangedFile();

        await reportLayerMap(names, applied);
    }

    ///
    ///Lays a mapping over the open file's layers. The part both ways in share.
    ///
    ///Split out when the address learned to name one: a mapping picked from the file dialog and a mapping
    ///fetched from `layermap=` have to land identically, and the drawing and the saving are left to the
    ///caller because the two differ there - the dialog renders and speaks up straight away, where an embed
    ///has a render of its own coming and nothing to say if it worked.
    ///
    private LayerNames applyLayerMapText(string text, out int applied)
    {
        var names = LayerNames.Parse(text);

        applied = names.ApplyTo(gds!.AdditionalInformation.Layers);

        layerNamesLoaded = applied > 0;

        rememberLayerNames();

        //Rebuilt rather than relabeled in place, because the labels are read off the layers themselves.
        getLayers();

        return names;
    }

    ///
    ///Fetches the layermap the address named, and lays it over the open file.
    ///
    ///**Quiet when it works.** Every other way into a layermap is somebody pressing something, so a report
    ///is the answer to what they just did; this one is a page arriving as its author intended, and a modal
    ///over every visitor's first sight of the layout would be the report answering nobody's question.
    ///
    ///**Not quiet when it does not.** A layermap that fails to arrive leaves the layers as bare numbers and
    ///Trace net refusing to work, which looks exactly like the app being broken - so the notice above the
    ///view says what was asked for and what went wrong. In the inline strip rather than an alert, because
    ///this is a thing the page's author has to fix and not a thing the visitor can do anything about.
    ///
    ///CORS is the likely cause and worth naming: a layermap on another host has to be served with a header
    ///allowing this app's origin, exactly as an injected example does.
    ///
    private async Task fetchLayerMap()
    {
        if (gds is null || embedding.LayerMap is not string address)
            return;

        string text;

        try
        {
            text = await httpClient.GetStringAsync(address);
        }
        catch (Exception ex)
        {
            layerMapNotice = $"Could not load the layermap at {address}: {ex.Message}. A layermap on another host has to be served with a header allowing this app's origin.";

            return;
        }

        var names = applyLayerMapText(text, out int applied);

        //Read but matching nothing is the one failure that is not an error: a mapping usually covers a whole
        //PDK where a file uses a handful of layers. Zero matching, though, means it is for another
        //technology or its columns are the wrong way round - and that is worth saying, because the layers
        //stay as numbers and nothing else explains why.
        if (applied == 0)
            layerMapNotice = layerNamesMessage(names, applied);

        await saveChangedFile();
    }

    ///<summary>What went wrong with a layermap the address named, or empty. See fetchLayerMap.</summary>
    private string layerMapNotice = "";

    private void dismissLayerMapNotice()
    {
        layerMapNotice = "";
    }

    ///
    ///Says something about a mapping that has just been applied, when there is something to say.
    ///
    ///**A mapping that worked says nothing.** Its rows land in the panel one line away, named and colored,
    ///which is the whole result - so a dialog reporting it stands between somebody and the thing they asked
    ///for, and has to be dismissed before the layers it is describing can be looked at. Every route in
    ///reports through here, so that was a click in the way of loading a mapping however it was loaded.
    ///
    ///What is left is the two cases the panel cannot show, because in both of them it looks exactly like a
    ///mapping nobody loaded: **nothing matched**, and **a row could not be read**. The same policy
    ///fetchLayerMap already applies to a mapping named by `layermap=`.
    ///
    private async Task reportLayerMap(LayerNames names, int applied)
    {
        if (applied > 0 && names.Problems.Count == 0)
            return;

        await js.InvokeVoidAsync("alert", layerNamesMessage(names, applied));
    }

    ///<summary>
    ///What to say about a mapping. The case worth a real explanation is **none applied**: rows matching
    ///nothing is normal, since a mapping usually covers a whole PDK where a file uses a handful of layers,
    ///but *zero* matching means the mapping is for another technology or its columns are the wrong way
    ///round - and left unexplained that looks like the feature not working.
    ///</summary>
    private static string layerNamesMessage(LayerNames names, int applied)
    {
        var message = new StringBuilder();

        //"Updated" rather than "Named": a row can now set a color or a height without naming anything, so
        //a mapping that lands is not necessarily one that named something.
        if (applied > 0)
            message.Append($"Updated {applied} of this file's layers from {names.Count} row(s).");
        else if (names.Count > 0)
            message.Append($"Read {names.Count} row(s), but none of them match a layer this file uses. Check the mapping is for the right technology, and that the columns are layer,datatype,name.");
        else
            message.Append("No usable rows. Each line should be layer,datatype,name - for example 65,20,diff.drawing. A color, a height and a thickness can follow it.");

        foreach (string problem in names.Problems)
            message.Append("\n").Append(problem);

        return message.ToString();
    }

    private async Task clearLayerNames()
    {
        if (gds is null)
            return;

        LayerNames.Clear(gds.AdditionalInformation);

        layerNamesLoaded = false;

        layerNames = "";

        //Said, and remembered for this file: bare numbers are what was asked for, so the bundled mapping
        //stops being laid over it, reload included. Opening a different file lets it apply again - see
        //reArmBundledPdkData.
        declinedBundledRoles = true;
        declinedOn = selectedExample;

        getLayers();

        await RenderGDS();

        await saveChangedFile();
    }

    #region Labels and colors ********************************

    ///<summary>
    ///Turns one layer's labels on or off. Per layer rather than for the file: which labels are worth
    ///reading depends on the layer, and one switch could only ever be all of them or none.
    ///</summary>
    private async Task labelsToggled(ChangeEventArgs e)
    {
        if (e.Value is not bool selected || settingsFor is null)
            return;

        settingsFor.ShowLabels = selected;

        await RenderGDS();

        await saveChangedFile();
    }

    #region The example list *********************************

    ///<summary>Narrows the list. Everything, in the order the picker had them, when nothing is typed.</summary>
    private void onExampleFilterInput(ChangeEventArgs e)
    {
        exampleFilter = e.Value?.ToString() ?? "";

        rebuildFilteredExamples();
    }

    ///<summary>
    ///Held in a field rather than worked out in the markup: this list is nine hundred long, and the popup
    ///re-renders on every keystroke in the filter box and every step of a pointer down the rows.
    ///</summary>
    private void rebuildFilteredExamples()
    {
        string wanted = exampleFilter.Trim();

        var rows = new List<ExampleRow>();

        //A heading only when something is left under it, so filtering to one sky130 cell does not leave
        //"Test GDS Files" standing over nothing.
        addExampleGroup(rows, InjectedExamplesHeading, embedding.Examples.Select(one => one.Name), wanted);
        addExampleGroup(rows, TestExamplesHeading, new[] { MosfetExample }, wanted);
        addExampleGroup(rows, Sky130ExamplesHeading, exampleFiles, wanted);

        filteredExamples = rows;

        injectedInList = injectedSignature();
    }

    ///<summary>
    ///What the picker is showing from the address, as one string to compare against.
    ///
    ///The list is built when the manifest arrives, which is before OnParametersSet has read the address -
    ///so an embed that injects files finds them missing from a list that is already built, and has to ask
    ///for it again. Only when they have actually changed, since that runs on every navigation and a
    ///rebuild walks nine hundred names.
    ///</summary>
    private string injectedSignature()
    {
        return string.Join("\n", embedding.Examples.Select(one => $"{one.Name}\t{one.Url}"));
    }

    ///<summary>
    ///Where a row's file is fetched from: the embedder's own address if they named this one, the served
    ///folder otherwise.
    ///
    ///Injected first, so a page that calls its own file "Mosfet" gets its own. The list is theirs.
    ///
    ///**Their address is used whole.** It has already been held to an absolute http or https URL by
    ///InjectedExample - which is the check that matters, since this is the one place the app fetches
    ///something the address told it to - and beyond that it is not this side's business whether the file
    ///is on the embedder's own host. What is their business is CORS: a cross-origin file has to be served
    ///with a header allowing this app's origin, or the browser refuses the read and the row reports it.
    ///</summary>
    private string addressOf(string fileName)
    {
        if (injectedNamed(fileName) is InjectedExample one)
            return one.Url;

        return $"{ExampleFolder}/{fileName}";
    }

    ///<summary>The injected example this name belongs to, or null for a bundled one.</summary>
    private InjectedExample? injectedNamed(string fileName)
    {
        foreach (var one in embedding.Examples)
        {
            if (string.Equals(one.Name, fileName, StringComparison.Ordinal))
                return one;
        }

        return null;
    }

    private static void addExampleGroup(List<ExampleRow> rows, string heading, IEnumerable<string> files, string wanted)
    {
        var matching = files
            .Where(name => wanted.Length == 0 || name.Contains(wanted, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matching.Count == 0)
            return;

        rows.Add(new ExampleRow(heading, true));

        foreach (string name in matching)
            rows.Add(new ExampleRow(name, false));
    }

    ///<summary>
    ///Shows the row being pointed at, after a pause.
    ///
    ///The pause is what makes this affordable. Every distinct file has to be fetched and parsed to be
    ///drawn, and a pointer crossing the list touches dozens of rows on the way to one - so a sweep would
    ///fetch dozens of files to show none of them. Each new row cancels the last one's wait.
    ///</summary>
    private async Task previewOnHover(string fileName)
    {
        if (fileName == previewFor)
            return;

        previewWait?.Cancel();

        var waiting = new CancellationTokenSource();
        previewWait = waiting;

        try
        {
            await Task.Delay(PreviewHoverDelayMs, waiting.Token);
        }
        catch (TaskCanceledException)
        {
            //The pointer moved on. Whichever row it moved to is now the one being waited for.
            return;
        }

        await showPreviewOf(fileName);
    }

    ///<summary>Puts the open file's thumbnail back, for when the pointer leaves either list.</summary>
    private void showSelectedPreview()
    {
        previewWait?.Cancel();

        previewFor = "";
        historyPreviewFor = "";
        previewMarkup = selectedPreview?.Markup ?? "";
        previewViewBox = selectedPreview?.ViewBox ?? "0 0 1 1";
    }

    ///<summary>
    ///Fetches and draws one example, without disturbing what is open.
    ///
    ///Its own GDS rather than the shell's: this is a look at a file, not a load of one, so nothing here
    ///touches the layer list, the views, the address or the session.
    ///</summary>
    private async Task showPreviewOf(string fileName)
    {
        previewFor = fileName;

        if (previewCache.TryGetValue(fileName, out var cached))
        {
            previewMarkup = cached.Markup;
            previewViewBox = cached.ViewBox;

            return;
        }

        (string Markup, string ViewBox) built;

        try
        {
            byte[] bytes = await httpClient.GetByteArrayAsync(addressOf(fileName));

            built = previewOf(new GDS(bytes), fileName);
        }
        catch
        {
            //A file that will not fetch or will not parse costs its thumbnail, not the popup. The list is
            //still usable and choosing the row still reports properly through the path that opens it.
            built = ("", "0 0 1 1");
        }

        remember(fileName, built);

        //Only if the pointer is still on this row: the fetch is awaited, and it may have moved on since.
        if (previewFor != fileName)
            return;

        previewMarkup = built.Markup;
        previewViewBox = built.ViewBox;

        StateHasChanged();
    }

    private void remember(string fileName, (string Markup, string ViewBox) preview)
    {
        if (previewCache.ContainsKey(fileName))
            return;

        previewCache[fileName] = preview;
        previewCacheOrder.Enqueue(fileName);

        while (previewCacheOrder.Count > MaximumCachedPreviews)
            previewCache.Remove(previewCacheOrder.Dequeue());
    }

    #endregion ***********************************************



    #region The history list *********************************

    ///<summary>
    ///Opens the History popup on what the store actually holds.
    ///
    ///Re-read rather than trusted, because the list in hand is only as current as the last save this tab
    ///made - and a second tab of the same app has been writing to the same store all along.
    ///</summary>
    ///
    ///Opens the history list, from a press or from the pointer arriving.
    ///
    ///Both, rather than one or the other. Hovering is how it is meant to be used and is what makes the
    ///list cost nothing to glance at; a press is what a touchscreen has instead, and there is no harm in
    ///a control that answers to both when the answer is the same.
    ///
    ///Already open is not a change, which matters here: the pointer crossing the button on its way
    ///somewhere else would otherwise re-read the store and redraw the preview on every pass.
    ///
    private async Task openHistory()
    {
        if (showHistory)
            return;

        historyEntries = await history.ListAsync();

        showExamples = false;
        showHistory = true;

        drawSelectedPreview();

        //Whatever is open, until a row is pointed at. The same starting picture the Examples popup shows.
        showSelectedPreview();
    }

    ///<summary>The same for the bundled ones, which need no store read to list.</summary>
    private void openExamples()
    {
        if (showExamples)
            return;

        showHistory = false;
        showExamples = true;

        drawSelectedPreview();
    }

    ///
    ///And both go when the pointer leaves the two buttons and whichever list is hanging off them.
    ///
    ///One handler on the column rather than one per list: an absolutely positioned list is still a
    ///descendant of it, so crossing from a button onto a list - or from one button to the other - never
    ///leaves the host, and the list does not flicker on the way.
    ///
    private void closeLists()
    {
        showExamples = false;
        showHistory = false;
    }

    ///
    ///And a cross on each, for anybody who does not discover the move.
    ///
    ///Closing by leaving is quick once it is known and is nothing at all before then: there is no control
    ///to look for, so the way out has to be found by accident. The same method as above, since what a cross
    ///does and what leaving does are the same thing.
    ///
    private void hideExamples()
    {
        closeLists();
    }

    ///<summary>Narrows the list. Everything, newest first, when nothing is typed.</summary>
    private void onHistoryFilterInput(ChangeEventArgs e)
    {
        historyFilter = e.Value?.ToString() ?? "";
    }

    ///<summary>What a row says when it is pointed at: what it is, and when it was last put here.</summary>
    private static string rowTitle(HistoryEntry entry)
    {
        var title = new StringBuilder(entry.Name);

        if (entry.ExampleName.Length > 0)
            title.Append(" - from the bundled examples");
        else
            title.Append(" - opened from this computer");

        if (DateTime.TryParse(entry.When, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var when))
            title.Append(", last here ").Append(when.ToLocalTime().ToString("f", CultureInfo.CurrentCulture));

        return title.ToString();
    }

    ///<summary>
    ///Shows the history row being pointed at, after the same pause the example list uses and for the same
    ///reason: a pointer crossing the list touches every row on the way to one.
    ///</summary>
    private async Task historyPreviewOnHover(string name)
    {
        if (name == historyPreviewFor)
            return;

        previewWait?.Cancel();

        var waiting = new CancellationTokenSource();
        previewWait = waiting;

        try
        {
            await Task.Delay(PreviewHoverDelayMs, waiting.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await showHistoryPreviewOf(name);
    }

    ///<summary>
    ///Draws one history entry, without disturbing what is open.
    ///
    ///Cached under a key of its own rather than the file's name, because a history entry called
    ///"Mosfet.gds" is somebody's edited copy and the bundled cell of that name is not - and a shared cache
    ///would show whichever of the two was looked at first for both.
    ///</summary>
    private async Task showHistoryPreviewOf(string name)
    {
        historyPreviewFor = name;

        string key = HistoryPreviewPrefix + name;

        if (previewCache.TryGetValue(key, out var cached))
        {
            previewMarkup = cached.Markup;
            previewViewBox = cached.ViewBox;

            return;
        }

        (string Markup, string ViewBox) built;

        try
        {
            built = previewOf(new GDS(await historyBytes(name)), name);
        }
        catch
        {
            //A payload that was lost or will not parse costs its thumbnail rather than the popup. Choosing
            //the row still reports it properly, through the path that opens it.
            built = ("", "0 0 1 1");
        }

        remember(key, built);

        //Only if the pointer is still on this row: reading and parsing are awaited, and it may have moved.
        if (historyPreviewFor != name)
            return;

        previewMarkup = built.Markup;
        previewViewBox = built.ViewBox;

        StateHasChanged();
    }

    ///<summary>
    ///One history entry's file. Its own bytes when it carries them, and the bundled example it names when
    ///it does not - which is the same rule the entry was written under.
    ///</summary>
    private async Task<byte[]> historyBytes(string name)
    {
        var session = await history.ReadAsync(name);

        if (session is null)
            throw new InvalidDataException($"Nothing stored for {name}.");

        if (session.FileBytes.Length > 0)
            return Convert.FromBase64String(session.FileBytes);

        return await httpClient.GetByteArrayAsync($"{ExampleFolder}/{session.ExampleName}");
    }

    ///<summary>
    ///Opens a file out of the history, as it was left.
    ///
    ///The popup stays up afterwards, the way the Examples one does: looking through what you have opened
    ///means coming back to the list.
    ///</summary>
    private async Task openFromHistory(string name)
    {
        var session = await history.ReadAsync(name);

        //A row whose payload is gone - a quota that refused the write, or storage cleared underneath the
        //app. Dropped rather than left standing: a row that opens nothing is worse than no row, and it
        //would go on failing every time it was pressed.
        if (session is null)
        {
            await forgetFromHistory(name);

            await js.InvokeVoidAsync("alert", $"\"{name}\" is no longer stored, so it has been removed from the history.");

            return;
        }

        //The address does not win here. Choosing a row *is* the deliberate request, so it is the address
        //that gets rewritten to match rather than the other way round.
        if (!await applySavedState(session, addressWins: false))
        {
            await js.InvokeVoidAsync("alert", $"\"{name}\" could not be opened. It may have been written by a different version of this app.");

            return;
        }

        addressForRestoredFile(session);

        historyEntries = await history.ListAsync();
    }

    ///<summary>
    ///Makes the address say what is now on screen.
    ///
    ///A file carrying its own bytes cannot keep a ?file=, whatever it started as: the link would hand
    ///somebody else the bundled example rather than the copy that was actually opened.
    ///</summary>
    private void addressForRestoredFile(SavedSession session)
    {
        string? slug = null;

        if (session.FileBytes.Length == 0 && session.ExampleName.Length > 0)
            slug = Path.GetFileNameWithoutExtension(session.ExampleName);

        //Recorded before navigating, or the render that follows treats the new ?file= as a link to act on
        //and fetches the example again over the top of what was just restored.
        openedFileSlug = slug;

        //Both at once. Written as two calls, the second reads the address the first left behind - which
        //works, but only by relying on that ordering.
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["file"] = slug,
            ["view"] = slugOf(view)
        }), replace: true);
    }

    ///<summary>Drops one file from the list, its stored state with it.</summary>
    private async Task forgetFromHistory(string name)
    {
        await history.ForgetAsync(name);

        historyEntries = await history.ListAsync();

        //The thumbnail may be of the row that has just gone, and the cached copy of it would be handed
        //straight back if a file of that name were opened again.
        previewCache.Remove(HistoryPreviewPrefix + name);

        if (historyPreviewFor == name)
            showSelectedPreview();
    }

    ///<summary>
    ///Empties the list, once.
    ///
    ///Asked about first, because this is the only thing in the app that throws away something that cannot
    ///be got back: an uploaded file's only copy in the browser is the one in here, and a row deleted by a
    ///misplaced click is a file gone. Deleting one row is not asked about - it is one file, named on the
    ///button that does it - but "all of them" is worth a moment.
    ///</summary>
    private async Task clearHistory()
    {
        int count = historyEntries.Count;

        string s = "s";

        if (count == 1)
            s = "";

        string question = $"Forget all {count} file{s} in the history?"
            + "\n\nAny that were opened from your computer are only stored here, so this is the last copy."
            + " The files on your computer are untouched.";

        if (!await js.InvokeAsync<bool>("confirm", question))
            return;

        await history.ClearAsync();

        historyEntries = await history.ListAsync();

        //Nothing left for it to narrow, and a box still holding a name over an empty list reads as though
        //something is being hidden rather than that there is nothing there.
        historyFilter = "";

        //Whatever is on screen stays on screen - this clears a list of files, not the one being looked at.
        //It does mean the open file can earn its row back on the next change, which is right: it is still
        //an uploaded or edited file.
        showSelectedPreview();
    }

    ///<summary>Keeps history thumbnails out of the way of the example ones. See showHistoryPreviewOf.</summary>
    private const string HistoryPreviewPrefix = "history:";

    #endregion ***********************************************

    ///<summary>
    ///Draws the open file into the thumbnail beside the example picker.
    ///
    ///Every layer, whatever the sidebar has switched off, and no labels: this answers "what is this cell"
    ///rather than showing the state of the view, and at a couple of hundred pixels a label is a smudge.
    ///
    ///No Y flip, so it is the same way up as the 2D view. That view draws the format's Y downward, which
    ///is upside down against a layout tool - a long-standing thing recorded under Known gaps. A preview
    ///that quietly corrected it would be the one picture in the app that disagreed with the rest.
    ///</summary>
    ///
    ///Marks the open file's thumbnail as needing to be drawn, without drawing it.
    ///
    ///**A thumbnail is only ever seen inside the Examples or History popup**, and drawing one is a flatten
    ///and a full-fidelity SVG build of the whole layout - the same work the viewer does, for a picture two
    ///hundred pixels across. Measured at twenty thousand elements it was about half the cost of opening the
    ///file, paid every time, for something most people never look at.
    ///
    ///So it is deferred to <see cref="drawSelectedPreview"/>, which runs when a popup opens. Still once per
    ///file rather than per keystroke, which is why this was moved out of the popup's own render in the first
    ///place - the point was never to do it eagerly, only to stop doing it repeatedly.
    ///
    private void buildExamplePreview()
    {
        selectedPreview = null;

        //
        //**Unless a popup is already open, in which case it is on screen and has to change now.**
        //
        //Choosing a cell from the Examples list leaves the list open - that is what makes it worth having,
        //since it is the difference between reading names and seeing what they are. Invalidating without
        //drawing blanked the picture the moment a row was clicked.
        //
        //So what is actually deferred is the case where nobody is looking: an upload, a link, a restored
        //session. Which is also the case where the file is most likely to be a large one.
        //
        if (showExamples || showHistory)
        {
            drawSelectedPreview();

            return;
        }

        //Nothing is being hovered when a file has just been opened, so this is also what to show.
        showSelectedPreview();
    }

    ///<summary>Draws the open file's thumbnail if it has not been drawn yet. Called when a popup opens.</summary>
    private void drawSelectedPreview()
    {
        if (selectedPreview is not null)
            return;

        if (gds is null)
            selectedPreview = ("", "0 0 1 1");
        else
            selectedPreview = previewOf(gds, CurrentlySelectedFileName);

        showSelectedPreview();
    }

    ///
    ///Draws any file into a thumbnail: the markup, and a viewBox framing it.
    ///
    ///The framing itself is <see cref="Preview"/>'s, in the library, because the cell list wants the same
    ///picture of a single cell and two copies of a viewBox calculation is two ways for two thumbnails to be
    ///framed differently from each other.
    ///
    ///
    ///<paramref name="named"/> is what the thumbnail is of, and is not decoration: a picture's styles and
    ///its pattern definitions are resolved across the whole document however deeply its SVG is nested, so
    ///two unnamed pictures of one file fight over both. Measured before this: opening the cell tree and
    ///pointing at a row redrew the *layout* at the thumbnail's opacity.
    ///
    private (string Markup, string ViewBox) previewOf(GDS file, string named)
    {
        return Preview.Of(GdsFlattener.Flatten(file), PreviewOpacity, named);
    }

    ///<summary>Solid enough to read as a shape at thumbnail size, where the view's own 0.5 goes to mush.</summary>
    private const float PreviewOpacity = 0.85f;

    ///<summary>The color to paint a row's swatch, which is simply the layer's own.</summary>
    private string colorOf(LayerKey key)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return "#ffffff";

        return layer.Color;
    }

    ///<summary>
    ///Opens the settings beside the gear that was clicked, rather than in the middle of the window.
    ///
    ///Placed from the click's own page coordinates, since the gear is one of a list and the popup has no
    ///other way to know which row it belongs to. Nudged left of the pointer by roughly its own width so it
    ///opens over the layout rather than off the right edge, and clamped so a row near the bottom does not
    ///push it below the fold.
    ///</summary>
    private async Task openLayerSettings(CheckboxItem item, MouseEventArgs e)
    {
        settingsFor = item;

        //On the layer's own color, whichever one the last popup was left on: the pattern side is only
        //reachable for a layer that has a pattern, and opening onto a control that half of them do not
        //offer would make the picker point somewhere different depending on the row before.
        colorTarget = ColorTarget.Background;

        //Seeded from the layer, once. After this the picker keeps its own hue and saturation - see
        //pickedColor for why reading them back off the hex on every render will not do.
        pickedColor = HsvColor.FromHex(colorOf(item.Id));

        settingsName = nameOrPair(item.Id);

        //
        //Against the right-hand edge of the canvas, level with the row it was opened from.
        //
        //**Pinned there rather than placed beside the pointer.** It used to be worked out from the click and
        //only clamped to the edge when that put it over the sidebar, which is nearly always: the gear sits
        //at the end of a layer row, the popup is wider than the row, so subtracting its width from the
        //pointer lands it a long way left - a quarter of the view away from the list it belongs to, with
        //nothing in between. The edge is where it belongs, and the clamp was already computing that
        //position; this just stops treating it as the exception.
        //
        //The view's own right edge is the thing to measure from, and C# does not know it - the sidebar's
        //width follows its contents. One call across for one number, on a gesture that happens a handful of
        //times and already re-renders the page.
        //
        //Six pixels off it, which is a seam rather than a gap.
        //
        double edge = 0;

        try
        {
            edge = await js.InvokeAsync<double>("viewRightEdge");
        }
        catch { }

        //No view to sit against - the state the app opens in - so beside the pointer, as it always was.
        double beside = e.ClientX - PickerWidth - 16;

        if (edge > 0)
            beside = edge - PickerWidth - 6;

        pickerLeft = Math.Max(8, beside);
        pickerTop = Math.Max(8, e.ClientY - 24);
    }

    private void closeLayerSettings()
    {
        settingsFor = null;
    }

    #endregion ***********************************************



    #region Naming a layer from its settings *****************

    ///<summary>
    ///What a layer is called: its name, or the pair it is known by when it has none. What the box holds.
    ///</summary>
    private string nameOrPair(LayerKey key)
    {
        if (gds is not null && gds.AdditionalInformation.Layers.TryGetValue(key, out var layer) && layer.Name is not null)
            return layer.Name;

        return key.ToString();
    }

    private void onSettingsNameInput(ChangeEventArgs e)
    {
        settingsName = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps the name, Escape puts back what it was. Clicking away keeps it too.</summary>
    private async Task onSettingsNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (settingsFor is not null)
                settingsName = nameOrPair(settingsFor.Id);

            return;
        }

        if (e.Key == "Enter")
            await commitSettingsName();
    }

    ///<summary>
    ///Applies what is in the box.
    ///
    ///The pair typed back counts as no name, the same as an empty box. The box starts out holding the
    ///pair, so leaving it alone must not name a layer after itself - "65/20" would then be a name, the
    ///row would read "65/20 (65/20)", and the file would count as having a layermap loaded.
    ///</summary>
    private async Task commitSettingsName()
    {
        if (settingsFor is null)
            return;

        string typed = settingsName.Trim();

        if (typed == settingsFor.Id.ToString())
            typed = "";

        await applyLayerName(settingsFor.Id, typed);

        //Back to whatever the layer is called now, so clearing the box shows the pair rather than nothing.
        settingsName = nameOrPair(settingsFor.Id);
    }

    #endregion ***********************************************



    #region Picking a color **********************************

    ///<summary>The hue on its own, at full strength - the background the field's two gradients wash out.</summary>
    private string hueColor()
    {
        return new HsvColor(pickedColor.Hue, 1, 1).ToHex();
    }

    ///<summary>A 0-to-1 position as the percentage the marker is placed at.</summary>
    private string percent(double fraction)
    {
        return (fraction * 100).ToString("F2", CultureInfo.InvariantCulture) + "%";
    }

    private async Task fieldPressed(MouseEventArgs e)
    {
        await pickFromField(e);
    }

    ///<summary>
    ///Only while a button is held. mousemove fires whenever the pointer crosses the field, so without this
    ///the color would follow the pointer over it without anyone having asked for a change.
    ///</summary>
    private async Task fieldDragged(MouseEventArgs e)
    {
        if (e.Buttons != 1)
            return;

        await pickFromField(e);
    }

    ///<summary>
    ///Turns where the pointer landed into a color: across for saturation, down for value.
    ///
    ///The hue is left alone - it is the slider's, and the field has no way to say anything about it.
    ///</summary>
    private async Task pickFromField(MouseEventArgs e)
    {
        double saturation = e.OffsetX / FieldWidth;
        double value = 1 - (e.OffsetY / FieldHeight);

        pickedColor = new HsvColor(pickedColor.Hue, saturation, value);

        await applyColor(pickedColor.ToHex());
    }

    private async Task hueChanged(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double hue))
            return;

        pickedColor = new HsvColor(hue, pickedColor.Saturation, pickedColor.Value);

        await applyColor(pickedColor.ToHex());
    }

    ///<summary>The current color as the three boxes show it, with what each one is called.</summary>
    private IEnumerable<(string Letter, string Name, int Level)> rgbChannels()
    {
        var (red, green, blue) = pickedColor.ToRgb();

        yield return ("R", "Red", red);
        yield return ("G", "Green", green);
        yield return ("B", "Blue", blue);
    }

    ///<summary>
    ///Takes a typed channel. The other two are read back off the color rather than kept alongside, so
    ///there is one place the color lives and the boxes cannot drift out of step with the field.
    ///
    ///Settled immediately: typing a number is arriving at a color rather than passing through one, so
    ///unlike a drag there is nothing to wait for before remembering it.
    ///</summary>
    private async Task channelTyped(ChangeEventArgs e, string letter)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int level))
            return;

        var (red, green, blue) = pickedColor.ToRgb();

        if (letter == "R")
            red = level;
        else if (letter == "G")
            green = level;
        else
            blue = level;

        pickedColor = HsvColor.FromRgb(red, green, blue);

        await applyColor(pickedColor.ToHex());

        colorSettled();
    }

    ///<summary>
    ///Takes a color from the history strip, moving the picker onto it as well as the layer.
    ///
    ///Separate from applyColor because the field and the slider must **not** do this: they hold the hue
    ///and saturation the pointer is on, and reading those back out of the hex would lose them - see
    ///<see cref="pickedColor"/>. Coming from the history there is nothing to lose, and the picker moving
    ///to show what was chosen is the point.
    ///</summary>
    private async Task chooseRecentColor(string color)
    {
        pickedColor = HsvColor.FromHex(color);

        await applyColor(color);

        //Straight to the front, since picking one again is what says it is the one being worked with.
        rememberColor(color);
    }

    ///<summary>
    ///The end of a drag or a slide: the color that was landed on is the one worth keeping.
    ///
    ///Remembering is deliberately not part of applying. Applying happens on every mousemove and every
    ///tick of the hue slider, which is what makes the layout recolor as you move - and doing both together
    ///filled the history with every shade the pointer passed over on the way, so by the time you let go
    ///the strip was a gradient of near-identical squares and the colors actually chosen had been pushed
    ///off the end of it.
    ///</summary>
    private void colorSettled()
    {
        if (settingsFor is null)
            return;

        rememberColor(pickedColor.ToHex());
    }

    ///<summary>
    ///Applies while the picker is being dragged, so the layout recolors as you move rather than after.
    ///That is the whole reason to have this next to the drawing.
    ///</summary>
    private async Task applyColor(string color)
    {
        if (gds is null || settingsFor is null)
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return;

        if (colorTarget == ColorTarget.Pattern)
        {
            layer.PatternColor = color;
        }
        else
        {
            layer.Color = color;
            layer.ColorIsCustom = true;
        }

        await RenderGDS();

        await saveChangedFile();
    }

    ///
    ///Which of a layer's two colors the picker is aimed at.
    ///
    ///One picker rather than two, because the second one would be the same square, the same slider and the
    ///same three boxes again in a popup that is already the tallest thing on screen - and a layer has one
    ///pattern color at most, which is a switch rather than a second control.
    ///
    private enum ColorTarget
    {
        ///<summary>The layer's own color, which is what the picker has always changed.</summary>
        Background,

        ///<summary>The marks of its pattern, when it has one. See Layer.PatternColor.</summary>
        Pattern
    }

    ///
    ///Which one the picker is on, reset to the layer's own each time the popup opens.
    ///
    ///Not remembered between layers: the pattern side is only reachable for a layer that has a pattern, so
    ///a sticky choice would open the popup on a control that is not there half the time.
    ///
    private ColorTarget colorTarget = ColorTarget.Background;

    ///<summary>Whether the pattern side is offered at all - a solid layer has no marks to color.</summary>
    private bool canColorPattern()
    {
        return settingsFor is not null && fillOf(settingsFor) != LayerFill.None;
    }

    ///<summary>What the picker is currently showing, which is whichever of the two it is aimed at.</summary>
    private string colorBeingPicked()
    {
        if (settingsFor is null)
            return "#000000";

        if (colorTarget == ColorTarget.Pattern && gds is not null
            && gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return SvgWriter.MarksColorOf(layer);

        return colorOf(settingsFor.Id);
    }

    ///
    ///Aims the picker at one of the two, and moves it onto that color.
    ///
    ///Moving it is the whole point: leaving the square where it was would mean the first nudge of the
    ///pointer writes the *background's* shade into the pattern, which is a color nobody chose arriving as
    ///the side effect of pressing a toggle.
    ///
    private void aimColorAt(ColorTarget target)
    {
        if (target == ColorTarget.Pattern && !canColorPattern())
            return;

        colorTarget = target;
        pickedColor = HsvColor.FromHex(colorBeingPicked());
    }

    ///<summary>
    ///Puts a layer back on the gradient. The palette is worked out from how many layers a file has, so
    ///rather than recomputing one entry, the whole set is reassigned and the other custom colors put back
    ///over it - which keeps the gradient's spacing right.
    ///</summary>
    private async Task resetColor()
    {
        if (gds is null || settingsFor is null)
            return;

        //
        //The pattern's own reset is a different thing: there is no palette entry for it, and what "back to
        //normal" means for a hatch is following the layer again rather than landing on some other color.
        //
        if (colorTarget == ColorTarget.Pattern)
        {
            if (gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var patterned))
                patterned.PatternColor = null;

            pickedColor = HsvColor.FromHex(colorBeingPicked());

            await RenderGDS();

            await saveChangedFile();

            return;
        }

        var information = gds.AdditionalInformation;

        var kept = information.Layers
            .Where(entry => entry.Value.ColorIsCustom && entry.Key != settingsFor.Id)
            .ToDictionary(entry => entry.Key, entry => entry.Value.Color);

        information.RestorePaletteColors();

        foreach (var entry in kept)
        {
            information.Layers[entry.Key].Color = entry.Value;
            information.Layers[entry.Key].ColorIsCustom = true;
        }

        //Onto whatever the palette gave it back, so the field and the slider show where it landed.
        pickedColor = HsvColor.FromHex(colorOf(settingsFor.Id));

        await RenderGDS();

        await saveChangedFile();
    }

    ///<summary>
    ///Keeps a color at the front of the recent list, without duplicates, capped.
    ///
    ///Capped because this is a shortcut rather than a history: past a handful the row stops being something
    ///you can pick from at a glance, which is the only thing it is for.
    ///</summary>
    private void rememberColor(string color)
    {
        recentColors.Remove(color);
        recentColors.Insert(0, color);

        while (recentColors.Count > MaximumRecentColors)
            recentColors.RemoveAt(recentColors.Count - 1);
    }

    #region The layer stack **********************************

    ///<summary>Whether this layer has been given a height of its own rather than taking the even spacing.</summary>
    private bool stackIsCustom(CheckboxItem item)
    {
        if (gds is null)
            return false;

        return gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer) && layer.StackIsCustom;
    }

    ///<summary>
    ///What the height or thickness box shows.
    ///
    ///The automatic value rather than a blank, because that is what the layer is actually at - a box that
    ///said nothing would suggest the layer had no height, when the view has already given it one. Typing
    ///over it is what makes it the layer's own.
    ///</summary>
    private LayerRole roleOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return LayerRole.None;

        return layer.Role;
    }

    ///
    ///Takes a role chosen in the popup.
    ///
    ///No redraw: a role changes nothing about how the layout is drawn, only what a net traces through. It is
    ///saved, though, for the same reason a name is - it is a thing about the process that somebody worked out
    ///once and should not have to work out again.
    ///
    private async Task roleChosen(ChangeEventArgs e)
    {
        if (settingsFor is null || gds is null)
            return;

        if (!Enum.TryParse(e.Value?.ToString(), out LayerRole role))
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return;

        layer.Role = role;

        await saveChangedFile();
    }

    #region A layer's fill pattern ***************************

    ///<summary>The patterns offered, in the order the popup shows them, lightest first.</summary>
    private static IEnumerable<(LayerFill Fill, string Name)> fillChoices()
    {
        yield return (LayerFill.None, "Solid");
        yield return (LayerFill.Dots, "Dots");
        yield return (LayerFill.Squares, "Squares");
        yield return (LayerFill.Grid, "Grid");
        yield return (LayerFill.Dashes, "Dashes");
        yield return (LayerFill.Diagonal, "Diagonal");
        yield return (LayerFill.BackDiagonal, "Back diagonal");
        yield return (LayerFill.CrossHatch, "Cross hatch");
    }

    private LayerFill fillOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return LayerFill.None;

        return layer.Fill;
    }

    ///
    ///One swatch, drawn by the writer that fills the layer.
    ///
    ///In the layer's own color when there is one on screen to be in, so the choice shown is the choice as it
    ///will look rather than a generic gray - the whole question being asked is whether *this* layer stays
    ///told apart from the one above it.
    ///
    ///The id has to be unique in the page: eight of these are open at once and an id already taken is an id
    ///the browser resolves to the first one, so all eight would draw whatever came first.
    ///
    private string patternTile(LayerFill fill)
    {
        string color = "#41464b";
        string? marks = null;
        int pixels = Layer.DefaultPatternPixels;

        if (settingsFor is not null)
        {
            color = colorOf(settingsFor.Id);
            marks = patternColorOf(settingsFor);
            pixels = patternPixelsOf(settingsFor);
        }

        return SvgWriter.SwatchFor(fill, color, $"swatch_{fill}", 24, marks, pixels);
    }

    ///<summary>
    ///What this layer's pattern is drawn in, or null where it follows the layer's own color. Null rather
    ///than the resolved color, so a swatch can be handed the same "has it been set" the layer holds.
    ///</summary>
    private string? patternColorOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return null;

        return layer.PatternColor;
    }

    ///
    ///Takes a pattern chosen in the popup.
    ///
    ///A redraw, unlike a role: this is the one thing in the lower half of the popup that changes the picture
    ///rather than what the picture means. Saved with it, the same as a color.
    ///
    private async Task fillChosen(LayerFill fill)
    {
        if (settingsFor is null || gds is null)
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return;

        if (layer.Fill == fill)
            return;

        layer.Fill = fill;

        //A solid layer has no marks to color, so the picker cannot be left aimed at them - it would be a
        //field with nothing on the other end of it, writing a color into a layer that draws none.
        if (fill == LayerFill.None && colorTarget == ColorTarget.Pattern)
            aimColorAt(ColorTarget.Background);

        await RenderGDS();

        await saveChangedFile();
    }

    ///<summary>How big this layer's pattern is held on screen, which is the number the box shows.</summary>
    private int patternPixelsOf(CheckboxItem item)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return Layer.DefaultPatternPixels;

        return layer.PatternPixels ?? Layer.DefaultPatternPixels;
    }

    ///
    ///Takes a typed pattern size, in screen pixels.
    ///
    ///Held to the same range the layermap column is, and for the same reasons - below it every fill is a
    ///flat tone and above it a shape holds less than one repeat. Out of range is clamped rather than
    ///refused: this is a spinner somebody is nudging, and a box that silently keeps the old number when
    ///the arrow is pressed once too often reads as the control having stopped working.
    ///
    ///The default back means "no size of its own" rather than "nine", so a layer nudged back to where it
    ///started stops being written into the session and the layermap at all.
    ///
    private async Task patternSizeTyped(ChangeEventArgs e)
    {
        if (gds is null || settingsFor is null)
            return;

        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int pixels))
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return;

        pixels = Math.Clamp(pixels, LayerNames.LeastPatternPixels, LayerNames.MostPatternPixels);

        if (pixels == Layer.DefaultPatternPixels)
            layer.PatternPixels = null;
        else
            layer.PatternPixels = pixels;

        await RenderGDS();

        await saveChangedFile();
    }

    ///
    ///The patterns somebody has set, as "65/20=Dots", for storing in a session.
    ///
    ///**A layer with a pattern color or a size of its own extends the same entry** rather than getting a
    ///list of its own: "65/20=Dots:#ff0000:14", with an empty middle where only the size was set. All three
    ///are how one layer's pattern is drawn and none of them means anything without the fill in front, so
    ///one list keeps them arriving together - and a session written before any of this existed still reads,
    ///because everything after the first colon is optional.
    ///
    private List<string> customFills()
    {
        if (gds is null)
            return new List<string>();

        //Only the ones that have one. LayerFill.None is every layer until somebody says otherwise, so a
        //list of those would be a list of every layer in the file saying nothing.
        return gds.AdditionalInformation.Layers
            .Where(entry => entry.Value.Fill != LayerFill.None)
            .Select(entry => $"{entry.Key}={describeFill(entry.Value)}")
            .ToList();
    }

    ///<summary>One layer's pattern as a session holds it: the fill, and the two settings that shape it.</summary>
    private static string describeFill(Layer layer)
    {
        string fill = layer.Fill.ToString();

        if (layer.PatternPixels is int pixels)
            return FormattableString.Invariant($"{fill}:{layer.PatternColor}:{pixels}");

        if (layer.PatternColor is string marks && marks.Length > 0)
            return $"{fill}:{marks}";

        return fill;
    }

    ///<summary>Puts the stored patterns back onto the layers a file has, ignoring any it no longer does.</summary>
    private void applyStoredFills(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string named))
                continue;

            string[] parts = named.Split(':');

            if (!Enum.TryParse(parts[0], out LayerFill fill))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            layer.Fill = fill;

            //Set rather than merged: this is what the layer's pattern was, so a part the entry does not
            //carry is a part that was not set - and leaving whatever the file arrived with in place would
            //be a session that can add a hatch color but never take one away.
            layer.PatternColor = null;
            layer.PatternPixels = null;

            if (parts.Length > 1 && parts[1].Length > 0)
                layer.PatternColor = parts[1];

            if (parts.Length > 2 && int.TryParse(parts[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out int pixels))
                layer.PatternPixels = Math.Clamp(pixels, LayerNames.LeastPatternPixels, LayerNames.MostPatternPixels);
        }
    }

    #endregion ***********************************************

    private string stackValue(CheckboxItem item, bool height)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            return "";

        if (height)
            return layer.Offset.ToString(CultureInfo.InvariantCulture);

        return layer.Depth.ToString(CultureInfo.InvariantCulture);
    }

    ///<summary>
    ///Takes a height or a thickness typed into the popup.
    ///
    ///Emptying the box puts the layer back on the even spacing, which is the only way to undo one field
    ///without the other - and it reads the way clearing the name box does.
    ///</summary>
    private async Task stackTyped(ChangeEventArgs e, bool height)
    {
        if (gds is null || settingsFor is null)
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return;

        string typed = e.Value?.ToString()?.Trim() ?? "";

        if (typed.Length == 0)
        {
            await resetStack();

            return;
        }

        if (!int.TryParse(typed, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value))
            return;

        if (height)
        {
            layer.Offset = value;

            //Where it was asked to sit, which the spacing slider spreads from rather than refusing to move.
            layer.CustomHeight = value;
        }
        else
        {
            //A layer of no thickness draws nothing, which looks like the layer having disappeared rather
            //than like a number being wrong. The box says min=1; this is the half a browser cannot enforce
            //against a value typed and committed with the keyboard.
            if (value < 1)
                return;

            layer.Depth = value;
        }

        layer.StackIsCustom = true;

        await RenderGDS();

        await saveChangedFile();
    }

    ///<summary>Puts one layer back on the stack the view works out for itself.</summary>
    private async Task resetStack()
    {
        if (gds is null || settingsFor is null)
            return;

        //Through the spacing the 3D view is currently showing, not the default. Restoring to a spacing
        //nobody is looking at would drop the layer somewhere that matches neither the slider nor the rest
        //of the stack.
        gds.AdditionalInformation.RestoreStacking(settingsFor.Id, layerSpacing());

        await RenderGDS();

        await saveChangedFile();
    }

    ///<summary>
    ///Where the 3D view's spacing slider is, or the default when that view has not been opened. The shell
    ///does not own the slider - the view does - so this reads it back out of a written session rather than
    ///keeping a second copy that could disagree with it.
    ///</summary>
    private int layerSpacing()
    {
        if (gds is null)
            return DefaultLayerSpacing;

        var settings = new SavedSession();

        viewer?.WriteSettings(settings);

        if (settings.LayerSpacing > 0)
            return settings.LayerSpacing;

        return DefaultLayerSpacing;
    }

    ///<summary>
    ///What a file opens at, taken from the library rather than copied here.
    ///
    ///It was a 50 written next to a comment saying it matched two other 50s. Three copies of one number,
    ///and the third - the 3D view's slider - had already drifted to 10.
    ///</summary>
    private const int DefaultLayerSpacing = AdditionalGDSInformation.DefaultLayerSpacing;

    ///<summary>The custom stack, as "65/20=100,50" - height then thickness - for storing in a session.</summary>
    private List<string> customStack()
    {
        if (gds is null)
            return new List<string>();

        return gds.AdditionalInformation.OrderedLayers()
            .Where(entry => entry.Value.StackIsCustom)
            .Select(entry => $"{entry.Key}={storedHeightOf(entry.Value).ToString(CultureInfo.InvariantCulture)},{entry.Value.Depth.ToString(CultureInfo.InvariantCulture)}")
            .ToList();
    }

    ///
    ///The height to write down for a layer, or -1 for a layer that was never given one.
    ///
    ///**Not its drawn position**, which is where the spacing slider has pushed it to and is nobody's setting.
    ///A layer whose thickness alone was typed is stored too - the thickness is worth keeping - and it has no
    ///height of its own to store, which is what the -1 says. Read back, that leaves it on the automatic stack
    ///and moving with the slider like everything else.
    ///
    ///A session written before this stored the position of a layer that was pinned against the slider, which
    ///was the same number as the height it had been given - so those read back as the height they always
    ///meant.
    ///
    private static int storedHeightOf(Layer layer)
    {
        return layer.CustomHeight ?? -1;
    }

    ///<summary>Puts those back onto a file that has just been opened.</summary>
    private void applyStoredStack(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string value))
                continue;

            string[] parts = value.Split(',');

            if (parts.Length != 2)
                continue;

            if (!int.TryParse(parts[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out int offset))
                continue;

            if (!int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out int depth))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            //A height of its own, or -1 for a layer that only ever had a thickness - see storedHeightOf.
            if (offset >= 0)
            {
                layer.Offset = offset;
                layer.CustomHeight = offset;
            }

            layer.Depth = depth;
            layer.StackIsCustom = true;
        }
    }

    ///<summary>
    ///Splits a stored "65/20=something" into the pair and the rest of it. Shared by the colors and the
    ///stack, which are stored the same way and were reading it apart twice.
    ///</summary>
    private static bool splitStoredLayer(string entry, out LayerKey key, out string value)
    {
        key = default;
        value = "";

        string[] halves = entry.Split('=');

        if (halves.Length != 2)
            return false;

        string[] numbers = halves[0].Split('/');

        if (numbers.Length != 2)
            return false;

        if (!short.TryParse(numbers[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out short number))
            return false;

        if (!short.TryParse(numbers[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out short dataType))
            return false;

        key = new LayerKey(number, dataType);
        value = halves[1];

        return true;
    }

    #endregion ***********************************************

    ///<summary>The custom colors, as "65/20=#00ff00", for storing in a session.</summary>
    private List<string> customColors()
    {
        if (gds is null)
            return new List<string>();

        return gds.AdditionalInformation.OrderedLayers()
            .Where(entry => entry.Value.ColorIsCustom)
            .Select(entry => $"{entry.Key}={entry.Value.Color}")
            .ToList();
    }

    ///<summary>Puts those back onto a file that has just been opened.</summary>
    private void applyStoredColors(List<string> stored)
    {
        if (gds is null)
            return;

        foreach (string entry in stored)
        {
            if (!splitStoredLayer(entry, out var key, out string color))
                continue;

            if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
                continue;

            layer.Color = color;
            layer.ColorIsCustom = true;
        }
    }

    #endregion ***********************************************

    #region Renaming a layer in place ************************

    ///<summary>
    ///Starts editing one row. The box is seeded with the name alone rather than with the label, since the
    ///label carries the numbers too and nobody wants to delete "(65/20)" before typing.
    ///</summary>
    ///
    ///The 2D view, when that is the one open and the Draw tool is out. Null the rest of the time.
    ///
    ///A cast rather than something on <see cref="IRenderable"/>, because drawing is not a thing every view
    ///does - a text editor and a three-dimensional model have no layer to draw a shape on, and an interface
    ///member they both had to answer for would be two more places saying no.
    ///
    private Viewer2DSvg? drawingView
    {
        get
        {
            if (viewer is Viewer2DSvg svg && svg.DrawingShapes)
                return svg;

            return null;
        }
    }

    ///<summary>Whether this row is the layer a drawn shape would go on.</summary>
    private bool drawingOnLayer(CheckboxItem item)
    {
        return drawingView is Viewer2DSvg svg && svg.DrawOn == item.Id;
    }

    ///<summary>What a click on the row does, which is not the same thing while a shape is being drawn.</summary>
    private string rowTitle(CheckboxItem item)
    {
        if (drawingView is null)
            return "";

        if (drawingOnLayer(item))
            return "Drawing on this layer";

        return "Draw on this layer";
    }

    private async Task useDrawLayer(CheckboxItem item)
    {
        if (drawingView is not Viewer2DSvg svg)
            return;

        await svg.UseDrawLayer(item.Id);
    }

    ///
    ///Hands a right-click on a layer row to the 2D view, which draws the menu.
    ///
    ///Nothing happens in the other views. The menu's three lines are a rename and two edits to the shapes
    ///on that layer, and only that component knows how to make either kind - so rather than a menu here
    ///offering one working line and two disabled ones, the browser's own menu comes up as usual.
    ///
    private async Task openLayerRowMenu(CheckboxItem item, MouseEventArgs e)
    {
        if (viewer is not Viewer2DSvg editor)
            return;

        await editor.OpenLayerMenu(e, item.Id);
    }

    private void startRenaming(CheckboxItem item)
    {
        if (gds is null)
            return;

        //Not while a shape is being drawn. There a click on the row is choosing which layer that shape goes
        //on, and opening a text box over the name as well would be answering a question nobody asked - the
        //click has to mean one thing. Renaming is a tool away.
        if (drawingView is not null)
            return;

        editingLayer = item.Id;
        editingName = gds.AdditionalInformation.Layers[item.Id].Name ?? "";
        focusLayerNameBox = true;
    }

    private void onLayerNameInput(ChangeEventArgs e)
    {
        editingName = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps the name, Escape abandons it. Anywhere else, clicking away keeps it too.</summary>
    private async Task onLayerNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            editingLayer = null;

            return;
        }

        if (e.Key == "Enter")
            await commitLayerName();
    }

    ///<summary>
    ///Applies the typed name and remembers it. Blank clears the name rather than storing an empty one, so
    ///the row goes back to bare numbers - which is the only way to undo a single rename without dropping
    ///the whole mapping.
    ///</summary>
    private async Task commitLayerName()
    {
        if (editingLayer is null)
            return;

        var key = editingLayer.Value;
        string typed = editingName;

        editingLayer = null;

        await applyLayerName(key, typed);
    }

    ///<summary>
    ///Names one layer, from wherever the typing happened - the row in the sidebar or the box at the top of
    ///that layer's settings. Split out when the settings grew a name box, so the two cannot drift: both
    ///have to clear the name on blank, redraw, and remember it for the next file.
    ///</summary>
    private async Task applyLayerName(LayerKey key, string typed)
    {
        if (gds is null)
            return;

        if (!gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return;

        typed = typed.Trim();

        if (typed.Length == 0)
            layer.Name = null;
        else
            layer.Name = typed;

        layerNamesLoaded = gds.AdditionalInformation.Layers.Values.Any(each => each.Name is not null);

        rememberLayerNames();

        getLayers();

        await RenderGDS();

        await saveChangedFile();
    }

    #endregion ***********************************************



    #region The saved session ********************************

    ///<summary>
    ///Writes what is on screen, so closing the tab does not throw it away.
    ///
    ///Called from every handler that changes something worth keeping, and the result is also handed to the
    ///unload handler as the snapshot to write if the page goes away. Both, because neither is enough on its
    ///own: saving only on change misses nothing but cannot run once the tab is closing, and saving only on
    ///the way out never happens at all when a mobile browser kills the tab without warning.
    ///
    ///Best effort throughout. This is a viewer, and a session that could not be written is a disappointment
    ///rather than a reason to interrupt what someone is doing.
    ///</summary>
    private async Task saveSession()
    {
        if (gds is null)
            return;

        //Half of a state being put back is not worth writing, and writing it destroys the other half.
        if (restoringState)
            return;

        var session = buildSession(gds);

        carryFramingIntoAddress(session);

        string json = SavedSession.Serialize(session);

        await storage.SetAsync(SessionStorageKey, json);

        //And keep the exit handler's copy current, for the close it cannot await a save through.
        await storage.HoldForExitAsync(SessionStorageKey, AppStorage.Encode(json));

        //The same state, into the history list, if this file belongs there. The serialized session is
        //handed over rather than rebuilt: it is the whole file base64'd, and doing that twice per save
        //would double the cost of dragging a slider.
        await rememberInHistory(json);
    }

    ///
    ///Puts what is on screen into the address, so a link carries the framing and not only the file.
    ///
    ///**Here rather than in the views**, though both of them are where the numbers come from. Neither view
    ///holds a NavigationManager and only one of them did, so writing this at each end would have meant
    ///giving the other one a reason to know about the address - and two places composing the same two
    ///parameters is two places for them to start disagreeing. The session is already the shape both views
    ///hand their state over in, so this reads it there and writes it once.
    ///
    ///**Only the view that is open.** buildSession asks the *active* view for its settings and nothing
    ///asks the other, so the one that is not on screen leaves its field empty - and a writer that treated
    ///empty as "take it out" would drop camera= from the address the moment somebody looked at the 2D
    ///view. Which is the parameter an embedder is most likely to have set by hand.
    ///
    ///**Commas in the address, spaces everywhere else.** A viewBox is spaces because that is what the SVG
    ///attribute is, and an address carrying spaces shows %20 to anybody who looks at it. Embedding.NumbersIn
    ///reads either.
    ///
    ///Replacing rather than pushing, because panning is not somewhere to go Back to.
    ///
    private void carryFramingIntoAddress(SavedSession session)
    {
        var wanted = new Dictionary<string, object?>();

        if (view == ViewType.View2DSvg && session.View2DBox.Length > 0)
            wanted["box"] = session.View2DBox.Replace(' ', ',');

        if (view == ViewType.View3D && session.View3DCamera.Length > 0)
            wanted["camera"] = session.View3DCamera.Replace(' ', ',');

        //
        //Nothing to say, which is not the same as saying nothing is there.
        //
        //**This only ever sets a parameter; taking one out is centerView's job.** An empty field means the
        //view has not reported a framing yet, and the first save after a ?box= link arrives is exactly
        //that - applyEmbedding ends in one, before anything has settled. Treating empty as "remove it"
        //made a link delete its own framing on the way in, which is a thing a probe found and reading did
        //not: the address was already back to ?file= by the first frame anybody could look at.
        //
        if (wanted.Count == 0)
            return;

        //
        //And the view, because navigating at all makes the address the authority on it.
        //
        //OnParametersSet runs on every navigation and reads `view` back out of the query - so a save on an
        //address that does not name one recomputes it as the 2D default, throwing away a view the session
        //had just restored. Writing it alongside keeps the address saying what is on screen, which is what
        //choosing a view from the picker writes anyway.
        //
        //Found by session.spec.js's "the angle you left the 3D view at comes back", which came back to the
        //2D view instead and failed on a slider that was no longer in the page.
        //
        wanted["view"] = slugOf(view);

        string was = NavigationManager.Uri;
        string address = NavigationManager.GetUriWithQueryParameters(was, wanted);

        //Nothing moved, so nothing to say. Navigating to the address already showing still costs a pass
        //through OnParametersSet and a render, and a save happens for reasons that have nothing to do
        //with the framing - every layer switched off, every color chosen.
        if (address == was)
            return;

        NavigationManager.NavigateTo(address, replace: true);
    }


    ///<summary>
    ///Saves, having noted that the user changed something about the file itself.
    ///
    ///The distinction this draws is what keeps the history list worth opening: the records, the layer
    ///names, the colors and what is switched off are the file as somebody left it, and are worth coming
    ///back to. The opacity, the layer spacing, the backdrop and which view is up are how it was being
    ///looked at, and on their own are not a reason to have kept a bundled example.
    ///</summary>
    private async Task saveChangedFile()
    {
        fileIsHistoryWorthy = true;

        await saveSession();
    }

    ///<summary>
    ///Everything worth keeping about what is on screen, in the shape both the session and a history entry
    ///hold. Takes the file rather than reading the field, so the caller's null check is the one the
    ///compiler sees.
    ///</summary>
    private SavedSession buildSession(GDS file)
    {
        var session = new SavedSession
        {
            ExampleName = selectedExample,
            FileName = CurrentlySelectedFileName,
            FileType = CurrentlySelectedFileType,
            View = slugOf(view),
            LayerNames = LayerNames.Named(file.AdditionalInformation),
            Deck = deckToRemember(),
            NoBundledLayerNames = declinedBundledRoles,
            NoBundledDeck = declinedBundledDeck,
            HiddenLayers = checkboxItems.Where(item => !item.IsSelected).Select(item => item.Id.ToString()).ToList(),
            LabelsOffLayers = checkboxItems.Where(item => !item.ShowLabels).Select(item => item.Id.ToString()).ToList(),
            LayerColors = customColors(),
            LayerStack = customStack(),
            LayerFills = customFills(),
            RecentColors = recentColors,
            DownloadFormat = downloadFormat,
            FullScreen = fullScreen,
            Layers = layersOpen,
            CellTree = cellTreeOpen,
            FileBytes = sessionFileBytes(),
            Edits = describedEdits()
        };

        //Each view writes its own controls; the shell deliberately does not know what they are.
        viewer?.WriteSettings(session);

        return session;
    }

    ///<summary>
    ///Writes the open file into the history list, when it belongs there.
    ///
    ///**Two ways in.** A file off the user's machine goes in the moment it is opened, edited or not - it
    ///exists nowhere else, and losing it because nothing was changed would be the worst case this feature
    ///has. A bundled example goes in once something about it is changed, because an untouched one is
    ///already a click away in the list next door and a history full of files nobody altered is a history
    ///nobody can find anything in.
    ///
    ///**And once in, it stays current.** Everything a session holds is written on every save, so the
    ///opacity and the view a file was last looked at in come back with it - but only for a file that has
    ///already earned a row. Moving a slider on an untouched example does not create one.
    ///
    ///**A shared name is not enough.** This used to write to any row whose name matched, which meant
    ///opening the bundled Mosfet destroyed the row holding somebody's edited copy of it: same name, same
    ///row, and the pristine file written over the top. What decides is whether the file on screen *is*
    ///that row - uploaded, changed, or restored out of the history - not what it happens to be called.
    ///</summary>
    private async Task rememberInHistory(string sessionJson)
    {
        if (gds is null || !fileIsHistoryWorthy)
            return;

        string name = CurrentlySelectedFileName + CurrentlySelectedFileType;

        if (name.Length == 0)
            return;

        await history.RememberAsync(new HistoryEntry
        {
            Name = name,
            ExampleName = selectedExample,
            Edited = fileEdited,
            When = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture)
        }, sessionJson);

        //Held so the popup can be opened without a read, and so it lists what was just done rather than
        //what the store said when the app started.
        historyEntries = await history.ListAsync();
    }

    ///<summary>
    ///The file's bytes, or nothing when they can be fetched again.
    ///
    ///An unedited bundled example is 9 MB of the 897 that are already on the server, so keeping a copy of
    ///one buys nothing. An uploaded file, or any file that has been edited, exists only in this tab - and
    ///that is exactly what a session is for.
    ///</summary>
    private string sessionFileBytes()
    {
        if (gds is null)
            return "";

        if (selectedExample.Length > 0 && !fileEdited)
            return "";

        return Convert.ToBase64String(gds.Serialize());
    }

    ///<summary>
    ///Puts a session back, and says whether it had a file in it.
    ///
    ///Only reached when the address names no file, since a link is a deliberate request for something
    ///specific and has to win over what happened to be open last time.
    ///</summary>
    private async Task<bool> restoreSession()
    {
        var session = SavedSession.Deserialize(await storage.GetAsync(SessionStorageKey));

        if (session is null)
            return false;

        //The address wins when it names a view, the same way it wins when it names a file: a link is a
        //deliberate request for something specific, and handing someone their own last view instead would
        //make a shared ?view= mean different things to different people.
        //
        //This was always wrong and could not show until a bare start began opening a file: with nothing
        //loaded there was no session to save, so ?view= on a second visit had nothing to lose to.
        return await applySavedState(session, addressWins: !string.IsNullOrEmpty(ViewSlug));
    }

    ///<summary>
    ///Puts a whole saved state on screen: the file, how its layers were named, colored and shown, and the
    ///view it was left in.
    ///
    ///Shared by the session restored on arrival and by a file chosen out of the history list, which are the
    ///same thing read from two different keys. False when the state could not be used - a payload that will
    ///not parse, or an example that is no longer served.
    ///</summary>
    private async Task<bool> applySavedState(SavedSession session, bool addressWins)
    {
        //Nothing may write while this runs; see restoringState. Cleared in the finally below if the state
        //never reaches the view, and in applyRestoredSettings if it does.
        restoringState = true;
        restoredSession = null;

        try
        {
            if (session.View.Length > 0 && !addressWins)
                view = viewOf(session.View);

            //A file that was edited or uploaded travels in the state; anything else is fetched by name.
            if (session.FileBytes.Length > 0)
            {
                try
                {
                    gds = new GDS(Convert.FromBase64String(session.FileBytes));
                }
                catch
                {
                    return false;
                }

                CurrentlySelectedFileName = session.FileName;
                CurrentlySelectedFileType = session.FileType;
                selectedExample = session.ExampleName;
                fileEdited = true;
            }
            else
            {
                if (session.ExampleName.Length == 0)
                    return false;

                //Set before fetching, the way the ?file= path does it: fetchExample loads and draws but does
                //not touch the picker, so leaving this empty showed the first name in the list next to
                //somebody else's layout - and the save that followed would then have stored the whole file,
                //having no example name to point at.
                selectedExample = session.ExampleName;

                if (!await fetchExample(session.ExampleName))
                {
                    selectedExample = "";

                    return false;
                }
            }

            applyRestoredLayers(session);

            //After the file is open, whichever of the two ways it arrived - the example branch goes through
            //openParsedFile, which clears the stack, and doing this before it would be undone by it.
            restoreEdits(session);

            //After the file, because opening one sets this from the format it arrived as - which is only
            //the default, and a session that says otherwise is somebody having chosen.
            downloadFormat = session.DownloadFormat;

            //Nothing to wait for: it is a class on the page rather than anything a view owns.
            fullScreen = session.FullScreen;
            layersOpen = session.Layers;
            cellTreeOpen = session.CellTree;

            //A state put back is the file as somebody left it rather than a fresh copy of it, so if that
            //file has a history row this *is* that row - and the saves from here on keep it current.
            //Opening the bundled version of the same file does not go through here, which is what keeps it
            //from writing over an edited copy that happens to share its name.
            fileIsHistoryWorthy = await history.ContainsAsync(CurrentlySelectedFileName + CurrentlySelectedFileType);

            //Held for the render that creates the view, which is the only thing that can take its controls.
            restoredSession = session;

            await RenderGDS();

            return true;
        }
        finally
        {
            //A state that got nowhere never reaches applyRestoredSettings, so if nothing is waiting on a
            //view the block on saving has to come off here - or nothing would ever be saved again.
            if (restoredSession is null)
                restoringState = false;
        }
    }

    ///<summary>
    ///The undo stack for a session, or null when there is nothing to take back - which is most files, most
    ///of the time, and should not pay a key and two empty lists for the privilege.
    ///</summary>
    private SavedEdits? describedEdits()
    {
        var written = editHistory.Describe();

        if (written.Done.Count == 0 && written.Undone.Count == 0)
            return null;

        return written;
    }

    ///<summary>
    ///Puts the undo stack back, so a refresh costs the page and not what was changed.
    ///
    ///**Against the file that has just been opened, not the one the edits were made on.** That is what an
    ///edit is written down to survive: the models it pointed at are gone, and what comes back addresses the
    ///same shapes by where they sit. Anything that does not fit the file in hand is left out rather than
    ///guessed at - a stack is a convenience, and the one thing it must never do is undo the wrong shape.
    ///</summary>
    private void restoreEdits(SavedSession session)
    {
        editHistory.Clear();

        if (gds is null || session.Edits is null)
            return;

        editHistory.Restore(gds, session.Edits);
    }

    ///<summary>
    ///Applies the parts of a session that describe the layers rather than the file: their names and colors,
    ///and which were switched off. Run after the file is open, since both are keyed by pairs that only
    ///exist once it has been read.
    ///</summary>
    private void applyRestoredLayers(SavedSession session)
    {
        if (gds is null)
            return;

        //Before the names, so a restore that has both does not lay the bundled mapping over a session that
        //had already declined it. With the file it was declined for, which is what keeps it to that file.
        declinedBundledRoles = session.NoBundledLayerNames;
        declinedBundledDeck = session.NoBundledDeck;
        declinedOn = session.ExampleName;

        if (session.LayerNames.Length > 0)
        {
            //Held whether or not any matched this file: the next file opened may well use those layers.
            layerNames = session.LayerNames;

            int applied = LayerNames.Parse(session.LayerNames).ApplyTo(gds.AdditionalInformation.Layers);

            layerNamesLoaded = applied > 0;
        }

        getLayers();

        recentColors = session.RecentColors;

        applyStoredColors(session.LayerColors);

        //After the names, which may have carried a stack of their own out of a layermap - what was set on
        //the layer last is what the session holds, so it is what wins.
        applyStoredStack(session.LayerStack);

        //After the stack for no reason but order; nothing else touches a fill, so nothing can overwrite it.
        applyStoredFills(session.LayerFills);

        //Both are stored as the set that is switched **off**, so anything a session does not mention comes
        //back on - which is also what a layer the file has gained since should do.
        var hidden = new HashSet<string>(session.HiddenLayers);
        var labelsOff = new HashSet<string>(session.LabelsOffLayers);

        foreach (var item in checkboxItems)
        {
            item.IsSelected = !hidden.Contains(item.Id.ToString());
            item.ShowLabels = !labelsOff.Contains(item.Id.ToString());
        }
    }

    ///<summary>
    ///Hands a restored session's own controls to whichever view is now mounted. Kept until it has been
    ///applied rather than applied on restore, because the view is created by the render that follows.
    ///</summary>
    private async Task applyRestoredSettings()
    {
        if (restoredSession is null || viewer is null)
            return;

        var session = restoredSession;
        restoredSession = null;

        await viewer.ApplySettings(session);

        //The last of the state has landed, so writing is safe again - and the write that follows is what
        //makes the store agree with the screen, which matters most for a file opened out of the history:
        //the session key has to name it now, not whatever was open before.
        restoringState = false;

        await RenderGDS();

        await saveSession();

        await applyEmbedding();
    }

    ///
    ///What each view had, kept across the switches that destroy the view holding it.
    ///
    ///**One carrier, written over.** Every view writes only the settings it owns - see WriteSettings - so
    ///this ends up holding the 3D view's spacing beside the 2D view's opacity, each as of the last visit to
    ///that view, and neither disturbed by visits to the other.
    ///
    ///Separate from <see cref="restoredSession"/> rather than folded into it, because the two are not the
    ///same event. A restore is the whole of the state coming back from storage and everything downstream of
    ///it - the layers, the embedding, the flag that says writing is unsafe - hangs off that one moment. This
    ///is one component handing a handful of values to the next, with the file and the layers already right.
    ///
    ///Seeded from a full <see cref="buildSession"/> the first time, so a view arriving before anything has
    ///been written for it gets what is on screen rather than a blank record's defaults.
    ///
    private SavedSession? acrossViews = null;

    ///<summary>Set when a switch has just happened, so this lands once rather than on every render.</summary>
    private bool handingOver = false;

    ///
    ///Hands them over, once the view that takes them is mounted.
    ///
    ///Called from the same render hook as <see cref="applyRestoredSettings"/> and after it, so a restore
    ///that lands on the same render wins - what came out of storage is the visitor's own state, where this
    ///is only what the previous views happened to be showing.
    ///
    ///Once per switch, not once per render: applying every time would put the slider back where the last
    ///switch left it in the middle of a drag.
    ///
    private async Task applyCarriedSettings()
    {
        if (!handingOver || acrossViews is null || viewer is null)
            return;

        handingOver = false;

        await viewer.ApplySettings(acrossViews);

        //A draw, because what just landed changes the picture: the spacing is written onto the layers and
        //the opacity is an argument to the next build, and neither shows until something asks for one.
        await RenderGDS();
    }

    ///
    ///And then whatever the page hosting this asked for, over the top of it.
    ///
    ///**Last, so a named parameter wins.** The session has just been put back, which is where the visitor's
    ///own choices live; anything the address names is the embedder overruling that for this load. What is
    ///not named is left exactly as the session had it, so a page can pin the grid and still have somebody's
    ///zoom, colors and history come back.
    ///
    ///Through a SavedSession rather than by reaching into the view, because that is already how every one of
    ///these settings is applied - see Embedding.Over. Built from the state on screen rather than from
    ///nothing, so the values the address is silent about survive the round trip.
    ///
    ///Once. Re-applying on every render would put the grid back on each time somebody switched it off.
    ///
    private async Task applyEmbedding()
    {
        if (embeddingApplied || embedding.IsEmpty || gds is null || viewer is null)
            return;

        embeddingApplied = true;

        if (embedding.FullScreen is bool wanted)
            fullScreen = wanted;

        //The two sidebars, which are the shell's rather than the view's - so they are set here rather than
        //going down with the rest through ApplySettings.
        if (embedding.CellTree is bool tree)
            cellTreeOpen = tree;

        if (embedding.Layers is bool layers)
            layersOpen = layers;

        //
        //Before the session is built from the file, because a layermap changes what that session holds: the
        //names, the colors, the roles and the fills all come off the layers, and buildSession reads them.
        //Applied straight to the file rather than through Over, unlike everything else here - see
        //Embedding.LayerMap for why a mapping is not session state.
        //
        await fetchLayerMap();

        await viewer.ApplySettings(embedding.Over(buildSession(gds)));

        await RenderGDS();

        //So the visitor's next change writes over the embed's values rather than beside them.
        await saveSession();
    }

    #endregion ***********************************************

    ///<summary>
    ///Writes the open file's layers out in the format the loader reads - names, colors, heights and
    ///thicknesses - so what is on screen can be edited in a spreadsheet and loaded back.
    ///</summary>
    private async Task exportLayerNames()
    {
        if (gds is null)
            return;

        byte[] csv = Encoding.UTF8.GetBytes(LayerNames.Export(gds.AdditionalInformation));

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + " layers.csv", "text/csv", csv);
    }

    private async Task onFileInputChanged(InputFileChangeEventArgs e)
    {
        var chosen = e.GetMultipleFiles(e.FileCount).FirstOrDefault();

        if (chosen is null)
            return;

        if (e.FileCount > 1)
            await js.InvokeVoidAsync("alert", "For now only one file is supported. If multiple files present only the first one will be read.");

        //
        //**A file opened while another one is already open is a question, not an answer.**
        //
        //Both answers are ordinary: somebody has finished with this layout and is opening the next, or they
        //want this file inside the one on screen. Nothing about the upload says which, and guessing wrong
        //costs the visitor either their open file or the placement they meant to make. So it is asked - but
        //only when there is something to ask about, which is a file open, editing allowed, and the incoming
        //file holding cells that can be brought across.
        //
        if (await mayOfferImport(chosen))
            return;

        //Needed by downloadFile, which names its output after whatever is currently loaded.
        CurrentlySelectedFileName = Path.GetFileNameWithoutExtension(chosen.Name);
        CurrentlySelectedFileType = Path.GetExtension(chosen.Name);

        //An uploaded file exists only in this tab, so the address has to stop claiming a bundled example -
        //otherwise sharing the link would hand someone a different layout than the one on screen.
        clearExampleFromQuery();

        //Claimed before the stream is read, so an example still being fetched cannot land on top of this.
        //See openWanted: dropping a file in while the app is opening its own default is exactly the case.
        int wanted = wantAnOpen();

        try
        {
            //Straight into the parser rather than through a MemoryStream and then ToArray.
            //
            //That was three copies of the file alive at once - the browser's, the stream's growing buffer,
            //and the array copied out of it - before a single record existed. The parser takes the stream
            //now, so what is held is the records and nothing else.
            using var stream = chosen.OpenReadStream(MaximumUploadSize);

            //Into the history whether or not it is touched afterwards. This file exists in this tab and
            //nowhere else - there is no list to find it in again and no address that names it - so it is
            //the one kind of file where not keeping it means losing it.
            await selectFile(stream, intoHistory: true, wanted: wanted);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Error loading the GDS file: {ex.Message}");

            _ = InvokeAsync(StateHasChanged);
        }
    }

    #region Opening a file into the one already open ***********************************************

    ///<summary>The file waiting on the dialog's answer, parsed, with the plan for bringing it in.</summary>
    private Importing.Plan? importPlan = null;

    private byte[]? importBytes = null;
    private string importName = "";
    private string importType = "";

    ///<summary>The cell the placement would go into: the one being edited, or the one on screen.</summary>
    private string importInto = "";

    ///
    ///Puts the question up, and answers whether it was put up at all.
    ///
    ///False for every case where there is nothing to ask - no file open, a read-only page, a 3D or text view
    ///where there is no pointer to place anything with, or an incoming file with no cells in it. Each of
    ///those falls through to the ordinary open, which is what the visitor gets today.
    ///
    ///The bytes are read here rather than streamed straight into the parser, which the ordinary path is
    ///careful not to do. That care is worth keeping where it applies: it is one open of one file, and the
    ///alternative is a stream that has already been consumed by the time the question is answered. They are
    ///let go on either answer.
    ///
    private async Task<bool> mayOfferImport(IBrowserFile chosen)
    {
        if (gds is null || noEditing || view != ViewType.View2DSvg)
            return false;

        //
        //**Nothing on screen is theirs yet, so there is nothing to ask about.**
        //
        //The app opens an example of its own when there is no link and no session, which means there is
        //always a file open and the question would be asked on the very first upload - about a layout the
        //visitor never chose and has not touched. Asked then it is not a choice, it is a step: the answer
        //is always "open on its own", because adding to a suggestion nobody made is not a thing anybody
        //wants.
        //
        //One edit and the question comes back, which is the line that matters. A shape drawn into the
        //example makes it theirs, and from then on replacing it silently would throw away work.
        //
        if (openedItself && !fileEdited)
            return false;

        byte[] raw;

        try
        {
            using var stream = chosen.OpenReadStream(MaximumUploadSize);
            using var held = new MemoryStream();

            await stream.CopyToAsync(held);

            raw = held.ToArray();
        }
        catch
        {
            //Unreadable here is unreadable on the ordinary path too, which reports it properly.
            return false;
        }

        GDS incoming;

        try
        {
            incoming = parsedFrom(raw);
        }
        catch
        {
            return false;
        }

        if (Importing.PlanFor(gds, incoming) is not Importing.Plan plan)
            return false;

        importPlan = plan;
        importBytes = raw;
        importName = Path.GetFileNameWithoutExtension(chosen.Name);
        importType = Path.GetExtension(chosen.Name);
        importInto = cellOnScreen();

        StateHasChanged();

        return true;
    }

    ///<summary>The same three-format sniff selectFile does, so the question is asked about the same file the
    ///ordinary open would have produced.</summary>
    private static GDS parsedFrom(byte[] raw)
    {
        if (OasisReader.LooksLikeOasis(raw))
            return OasisReader.Read(raw);

        if (DxfReader.LooksLikeAnyDxf(raw))
            return DxfReader.Read(raw);

        return new GDS(raw);
    }

    ///<summary>Where a placement would go: the file's first top cell, which is what the 2D view draws.</summary>
    private string cellOnScreen()
    {
        if (gds is null)
            return "";

        foreach (var summary in Hierarchy.Summarize(gds))
        {
            if (summary.IsTop)
                return summary.Name;
        }

        return "";
    }

    ///<summary>Opening it on its own after all, which is what the app did before the question existed.</summary>
    private async Task openImportedOnItsOwn()
    {
        if (importBytes is not byte[] raw)
            return;

        CurrentlySelectedFileName = importName;
        CurrentlySelectedFileType = importType;

        forgetImport();

        clearExampleFromQuery();

        int wanted = wantAnOpen();

        try
        {
            await selectFile(raw, intoHistory: true, wanted: wanted);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Error loading the GDS file: {ex.Message}");

            _ = InvokeAsync(StateHasChanged);
        }
    }

    ///
    ///Brings the cells in and hands the top one to the pointer.
    ///
    ///**One undo step for the whole import**, which is why the edits are wrapped rather than applied one at
    ///a time: a file of forty cells that took forty presses of undo to back out would be a worse answer than
    ///not offering the import. The placement is a second step on purpose - it is a separate decision, made
    ///later, with the pointer.
    ///
    ///The file is not marked as opened: what is on screen is still the visitor's own layout, under its own
    ///name, now holding one more cell. Naming the address after the imported file would offer a link that
    ///hands somebody else a different layout entirely.
    ///
    private async Task importAsCell()
    {
        if (gds is null || importPlan is not Importing.Plan plan)
            return;

        string top = plan.TopCell;
        string into = importInto;

        forgetImport();

        editHistory.Do(new CompoundEdit($"Import {importName}", plan.Edits));

        await onFileEdited();

        //After the redraw, so the cell it picks up is one the view has already been told about.
        if (viewer is Viewer2DSvg drawing)
            await drawing.CarryImported(top, into);
    }

    ///<summary>What the file holds and where it would go, in one sentence the dialog puts under the name.</summary>
    private string describeImport()
    {
        if (importPlan is not Importing.Plan plan)
            return "";

        string cells = "cells";

        if (plan.Cells == 1)
            cells = "cell";

        string holds = FormattableString.Invariant($"{plan.Cells} {cells}");

        if (importInto.Length == 0)
            return FormattableString.Invariant($"This file holds {holds}. Add them to the open library, or open the file on its own?");

        return FormattableString.Invariant(
            $"This file holds {holds}. Add them to the open library and place {plan.TopCell} in {importInto}, or open the file on its own?");
    }

    ///<summary>The renames, named - one is worth spelling out, and a long list is worth counting instead.</summary>
    private string renamedNote()
    {
        if (importPlan is not Importing.Plan plan || plan.Renamed.Count == 0)
            return "";

        if (plan.Renamed.Count == 1)
        {
            (string from, string to) = plan.Renamed[0];

            return FormattableString.Invariant($"This library already has a cell called {from}, so the one coming in is named {to}.");
        }

        return FormattableString.Invariant($"{plan.Renamed.Count} of its cells have names this library already uses, and arrive under numbered ones.");
    }

    private void forgetImport()
    {
        importPlan = null;
        importBytes = null;
    }

    ///<summary>Escape and the backdrop both mean "neither" - the file is dropped and nothing changes.</summary>
    private void cancelImport()
    {
        forgetImport();

        importName = "";
        importType = "";
    }

    #endregion ***********************************************

    ///<summary>
    ///Opens a bundled example and names it in the address, so the page can be linked, bookmarked, or
    ///carried onto a phone by the QR code.
    ///</summary>
    private async Task openExample(string fileName)
    {
        //Set before fetching, the way the ?file= path and a restore both do it.
        //
        //Fetching loads, draws *and saves*, so a name set afterwards meant that save recorded the example
        //that had been open before this one - a session naming one file and carrying another's layers.
        //Reopening the app then handed back the wrong file entirely, and the layer state that had been
        //saved against the right one was written over by the wrong one's defaults.
        string previous = selectedExample;
        selectedExample = fileName;

        int wanted = openWanted + 1;

        if (!await fetchExample(fileName))
        {
            selectedExample = previous;

            return;
        }

        //
        //**Nothing after this if the open was superseded.**
        //
        //Dropping the parsed file is not enough on its own: the navigation below writes ?file= into the
        //address, and the watcher on that opens the named example as a *fresh* request - so a superseded
        //open would come back round and win the second time. This is where the chain has to stop.
        //
        //Not what the DXF specs were catching - that was the init ordering, see OnInitializedAsync - but the
        //same hazard one step further on: a superseded open must not leave the address naming its file.
        //
        if (wanted != openWanted)
            return;

        openedFileSlug = Path.GetFileNameWithoutExtension(fileName);

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("file", openedFileSlug), replace: true);
    }

    ///<summary>
    ///Fetches an example over HTTP and hands it to the parser. False if it could not be fetched, which
    ///?file= makes reachable from the address bar - a name that is in the picker but missing from the
    ///served folder used to reach the Blazor error UI instead of saying anything.
    ///</summary>
    private async Task<bool> fetchExample(string fileName)
    {
        byte[] rawGDS;

        //Claimed before the fetch, not after it. A token taken once the bytes are in would be the *newest*
        //by then, so a slow example finishing after an upload would still win - which is the whole failure.
        int wanted = wantAnOpen();

        var injected = injectedNamed(fileName);

        try
        {
            rawGDS = await httpClient.GetByteArrayAsync(addressOf(fileName));
        }
        catch (Exception ex)
        {
            //An injected file says where it was going, and says the thing that is almost always wrong.
            //The fetch is cross-origin, the browser reports it as a plain failure with nothing in the
            //message about why, and a page that has just embedded this has no other way to find out.
            if (injected is not null)
                await js.InvokeVoidAsync("alert", $"Could not fetch \"{fileName}\" from {injected.Url}. {ex.Message}\n\nA file on another host has to be served with a cross-origin header that allows this page to read it.");
            else
                await js.InvokeVoidAsync("alert", $"Could not fetch the example \"{fileName}\". {ex.Message}");

            return false;
        }

        //Set after the fetch, so a failed one does not rename what the download button would write.
        //GetExtension keeps the leading dot, matching how Viewer3D holds ModelDownloadFileType.
        //
        //An injected file is named by the embedder and their name need not carry an extension, so the
        //kind comes off the address instead - what to call the download is theirs, what it *is* is the
        //file's. A URL with no extension either leaves it empty, which is what an unnamed kind was
        //before this.
        if (injected is not null)
        {
            CurrentlySelectedFileName = fileName;
            CurrentlySelectedFileType = Path.GetExtension(new Uri(injected.Url).AbsolutePath);
        }
        else
        {
            CurrentlySelectedFileName = Path.GetFileNameWithoutExtension(fileName);
            CurrentlySelectedFileType = Path.GetExtension(fileName);
        }

        await selectFile(rawGDS, wanted: wanted);

        return true;
    }

    ///<summary>
    ///Acts on ?file= - on arrival, and if it changes later, which the back button walking through a link
    ///does.
    ///
    ///Deferred to after a render rather than done in OnParametersSet, because it needs the example list
    ///fetched during initialization and it reports a bad name through a JavaScript alert.
    ///</summary>
    private async Task openFileFromQuery()
    {
        if (string.IsNullOrEmpty(FileSlug))
        {
            await restoreSessionOnce();

            return;
        }

        if (string.Equals(FileSlug, openedFileSlug, StringComparison.OrdinalIgnoreCase))
            return;

        //Nothing can be resolved yet, and the slug must not be consumed - the render that completing the
        //fetch triggers brings us back here with the list in hand.
        if (!exampleListFetched)
            return;

        //Recorded before the await: loading renders, which brings us back here before it has finished.
        openedFileSlug = FileSlug;

        string? fileName = exampleNamed(FileSlug);

        if (fileName is null)
        {
            //Naming one that does exist is more use than saying this one does not: the names are long and
            //a link is usually wrong by a character or two.
            string example = exampleFiles.FirstOrDefault() ?? MosfetExample;

            await js.InvokeVoidAsync("alert", $"There is no bundled example called \"{FileSlug}\". Names look like \"{Path.GetFileNameWithoutExtension(example)}\" - or choose one from the list.");

            return;
        }

        selectedExample = fileName;

        await fetchExample(fileName);

        StateHasChanged();
    }

    ///<summary>
    ///Restores last time's session, once, when the address does not name a file.
    ///
    ///The address wins when it names one: a link is a deliberate request for something specific, and
    ///handing someone their own last file instead would make a shared link mean different things to
    ///different people. Gated on the example list the same way the ?file= path is, since a session naming
    ///an example cannot be resolved before that list has arrived.
    ///</summary>
    private async Task restoreSessionOnce()
    {
        if (sessionRestoreAttempted || gds is not null || !exampleListFetched)
            return;

        sessionRestoreAttempted = true;

        if (await restoreSession())
        {
            StateHasChanged();

            return;
        }

        //
        //**A file may have arrived while that was reading.**
        //
        //The guard at the top is checked before an IndexedDB round trip, and an upload lands on its own
        //event - so somebody who drops a file in during that read has it replaced by the default example a
        //moment later.
        //
        //A hazard rather than a diagnosis: the flaky DXF specs turned out to be an extra read serialized in
        //front of the example list, not this - see OnInitializedAsync. Kept because losing a file somebody
        //just dropped in is worth one comparison, whether or not a spec has caught it.
        //
        if (gds is not null)
            return;

        //Nothing to restore and no link to follow, so open the hand-made example rather than sit on an
        //empty canvas. It is the small one, and it is the file every other part of this is described
        //against - somewhere to start rather than a picker and a blank page.
        //
        //Through openExample, so the address says what is on screen: arriving here and arriving on
        //?file=Mosfet end up in the same state, and the picker agrees with both.
        await openExample(MosfetExample);

        //
        //**Nobody asked for this one**, which is what makes it the file an upload may replace without asking.
        //
        //Set after the open rather than before it: selectFile clears this on the way through, because every
        //other route to it is a file somebody chose - a link, the picker, their own last session, an upload.
        //This is the one that is nothing but somewhere to start. See mayOfferImport.
        //
        openedItself = true;

        //Nothing was restored, so the embed's settings have nothing to land after - they land here instead.
        await applyEmbedding();

        StateHasChanged();
    }

    ///<summary>Drops ?file= from the address, for when what is loaded is no longer a bundled example.</summary>
    private void clearExampleFromQuery()
    {
        selectedExample = "";
        openedFileSlug = null;

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("file", (string?)null), replace: true);
    }

    ///<summary>
    ///The example whose name matches, ignoring case and the .gds that the slug leaves off.
    ///</summary>
    private string? exampleNamed(string slug)
    {
        if (string.Equals(slug, Path.GetFileNameWithoutExtension(MosfetExample), StringComparison.OrdinalIgnoreCase))
            return MosfetExample;

        return exampleFiles.FirstOrDefault(file => string.Equals(Path.GetFileNameWithoutExtension(file), slug, StringComparison.OrdinalIgnoreCase));
    }

    private async Task selectFile(byte[] rawGDS, bool intoHistory = false, int? wanted = null)
    {
        GDS parsed;
        bool oasis = OasisReader.LooksLikeOasis(rawGDS);
        bool dxf = !oasis && DxfReader.LooksLikeAnyDxf(rawGDS);

        //The parser rejects anything that is not a well-formed GDSII stream. Report that rather than
        //letting it reach the Blazor error UI, and leave whatever was already loaded on screen.
        try
        {
            if (oasis)
                parsed = OasisReader.Read(rawGDS);
            else if (dxf)
                parsed = DxfReader.Read(rawGDS);
            else
                parsed = new GDS(rawGDS);
        }
        catch (InvalidDataException ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read this file. {ex.Message}");

            return;
        }

        await openParsedFile(parsed, intoHistory, oasis, dxf, wanted);
    }

    ///<summary>
    ///The same, off a stream that has not been drained into an array first.
    ///
    ///For the file the user chose off their machine, which arrives as a stream and is the one that can be
    ///large. Asynchronous because it has to be: the browser's file stream refuses a synchronous read.
    ///</summary>
    private async Task selectFile(Stream stream, bool intoHistory = false, int? wanted = null)
    {
        GDS parsed;

        //Which format it is, read off the front of the file rather than guessed from its name. The two
        //are told apart by what they start with, and a file called .gds that is OASIS - or the other way
        //round, which is what a rename produces - opens correctly either way.
        byte[] head = await peekAsync(stream, OasisHeaderLength);
        bool oasis = OasisReader.LooksLikeOasis(head);
        bool dxf = !oasis && DxfReader.LooksLikeAnyDxf(head);

        try
        {
            using var whole = new ConcatenatedStream(head, stream);

            if (oasis)
                parsed = await OasisReader.ReadAsync(whole);
            else if (dxf)
                parsed = await DxfReader.ReadAsync(whole);
            else
                parsed = await GDS.FromStreamAsync(whole);
        }
        catch (InvalidDataException ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read this file. {ex.Message}");

            return;
        }

        await openParsedFile(parsed, intoHistory, oasis, dxf, wanted);
    }

    ///<summary>
    ///The first few bytes of a stream, which is all it takes to know which format this is.
    ///
    ///Read off rather than peeked at, because the stream a browser hands over cannot be rewound - so what
    ///was taken is put back in front of it by ConcatenatedStream.
    ///</summary>
    private static async Task<byte[]> peekAsync(Stream stream, int count)
    {
        var head = new byte[count];
        int filled = 0;

        while (filled < count)
        {
            int read = await stream.ReadAsync(head.AsMemory(filled, count - filled));

            if (read == 0)
                break;

            filled += read;
        }

        return head[..filled];
    }

    ///<summary>
    ///Enough to hold "%SEMI-OASIS\r\n", and enough of a DXF to see past a comment line to the SECTION after
    ///it - which is the longer of the two, so it is the one that sets this.
    ///</summary>
    private const int OasisHeaderLength = 256;

    ///<summary>
    ///A few bytes already read, and then the rest of the stream they came from. Lets the format be
    ///decided from the front of a file that can only be read forwards.
    ///</summary>
    private sealed class ConcatenatedStream : Stream
    {
        private readonly byte[] head;
        private readonly Stream rest;
        private int at;

        public ConcatenatedStream(byte[] head, Stream rest)
        {
            this.head = head;
            this.rest = rest;
        }

        public override bool CanRead => true;
        public override bool CanSeek => false;
        public override bool CanWrite => false;
        public override long Length => throw new NotSupportedException();

        public override long Position
        {
            get => throw new NotSupportedException();
            set => throw new NotSupportedException();
        }

        public override int Read(byte[] buffer, int offset, int count)
        {
            if (at < head.Length)
            {
                int taking = Math.Min(count, head.Length - at);

                Array.Copy(head, at, buffer, offset, taking);

                at += taking;

                return taking;
            }

            return rest.Read(buffer, offset, count);
        }

        public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
        {
            if (at < head.Length)
            {
                int taking = Math.Min(buffer.Length, head.Length - at);

                head.AsMemory(at, taking).CopyTo(buffer);

                at += taking;

                return taking;
            }

            return await rest.ReadAsync(buffer, cancellationToken);
        }

        public override void Flush()
        {
        }

        public override long Seek(long offset, SeekOrigin origin)
        {
            throw new NotSupportedException();
        }

        public override void SetLength(long value)
        {
            throw new NotSupportedException();
        }

        public override void Write(byte[] buffer, int offset, int count)
        {
            throw new NotSupportedException();
        }
    }

    ///
    ///How many opens have been asked for, so a slow one cannot land on top of a later one.
    ///
    ///**Every route in bumps this before it starts fetching, and only the newest gets to install.** Opening a
    ///file is a fetch or a disk read and then a parse, and nothing stopped two of those overlapping: whichever
    ///finished last won, which is not the same as whichever was asked for last. Two examples clicked quickly,
    ///or a file dropped in while the app is opening one of its own, are both that.
    ///
    ///**Hardening, and said plainly: this is not what fixed the flaky DXF specs.** Those came from an extra
    ///read serialized in front of the example list, which moved the app's fallback open into collision with
    ///the upload - see OnInitializedAsync. This guard was written while chasing that, it did not stop it, and
    ///it is kept because the hazard it describes is real rather than because it was shown to catch one.
    ///
    private int openWanted = 0;

    ///<summary>Marks a new open as the one that counts, and gives back the token to check against.</summary>
    private int wantAnOpen()
    {
        return ++openWanted;
    }

    ///<summary>Everything that happens once a file has been read, whichever way it was read.</summary>
    private async Task openParsedFile(GDS parsed, bool intoHistory, bool fromOasis = false, bool fromDxf = false, int? wanted = null)
    {
        //Superseded while it was being read, so this result is stale. Dropped rather than installed: the
        //file somebody asked for most recently is the one that should be on screen.
        if (wanted is int token && token != openWanted)
            return;

        gds = parsed;

        //A different file, so the edits made to the last one point at a library that is no longer open -
        //and would apply themselves to nothing, or worse, to something. A session restore puts its own
        //stack back afterwards; see restoreEdits.
        editHistory.Clear();

        //
        //What the flattener made of it, so the banner can say when it is not the whole file.
        //
        //Flattened here rather than asked of the view, because the two views are separate components with
        //separate caches and the text view has no layout at all - and this has to be true whichever of the
        //three somebody happens to be looking at when they open a file.
        //
        flattened = GdsFlattener.Flatten(parsed);
        flattenedFor = parsed;

        //What the download button writes. An OASIS or a DXF is read into a GDSII library, so what leaves
        //here is GDSII whatever arrived - and naming it .oas or .dxf would hand someone a file their tools
        //would refuse on sight.
        openedConverted = fromOasis || fromDxf;

        //The download starts on the format the file arrived as, since keeping it is the rule and
        //converting the exception. A restored session overrules this afterwards, which is somebody having
        //chosen rather than the default that was picked for them.
        //
        //A DXF is the one that cannot keep its format: this reads one and nothing writes one, so a drawing
        //opens on GDSII - which is a conversion the picker cannot offer a way out of, and should not
        //pretend to.
        if (fromOasis)
            downloadFormat = OasisExtension;
        else
            downloadFormat = ".gds";

        //Whatever the last download had to leave behind was about the last file.
        downloadNotice = "";

        //A freshly opened file matches what it came from again, so a session can go back to naming it
        //rather than carrying a copy. Without this, one edit would make every file opened afterwards store
        //its whole self.
        fileEdited = false;

        //Every route in but one is a file somebody asked for. The exception sets this back afterwards -
        //see restoreSessionOnce, which is the only place the app picks a file on its own behalf.
        openedItself = false;

        //And it earns its history row on its own terms rather than inheriting the last file's. An example
        //opened after an upload is an untouched example, not something worth keeping.
        fileIsHistoryWorthy = intoHistory;

        //A different file, so a Clear made on the last one stops speaking for this one.
        reArmBundledPdkData();

        //Names carry across files rather than belonging to one: a layer number means the same thing
        //throughout a technology, so naming 65/20 while looking at one cell names it in the next.
        carryLayerNamesOver();

        //And the rules for it, on the same argument: every bundled example is a sky130 cell and the deck for
        //them ships beside the layermap that is already applied here.
        carryDeckOver();

        //A different file, so its rows start where a file's rows start rather than inheriting what was set
        //on the last one's. Names do carry over, above; which layers were hidden does not.
        getLayers(keepSettings: false);

        //Here rather than when the popup renders: this is the one place a different file arrives, and it
        //is a pass over every element that must not be paid for on every keystroke elsewhere.
        buildExamplePreview();

        await RenderGDS();

        await saveSession();
    }

    ///<summary>The file a Clear of the bundled layermap or deck was made against. See reArmBundledPdkData.</summary>
    private string declinedOn = "";

    ///
    ///Lets the bundled sky130 layermap and deck apply again, once a different file is on screen.
    ///
    ///**Clear is about the layout in front of you, not a setting.** It has to outlast a reload, or the panel
    ///would fill straight back up and Clear would look broken - which is what the session flags are for. But
    ///it was outlasting everything: one Clear during a look round the examples, and every example opened
    ///afterwards arrived with an empty panel, for a PDK the app ships the data for and knows the file
    ///belongs to. There was no way back to it either, short of finding the offer behind a hover.
    ///
    ///So the decline is scoped to the file it was made on. Reopening that same file keeps it - including
    ///across a reload, where the session restores the name alongside the flag - and choosing a different one
    ///is a fresh start on a file whose technology is known.
    ///
    ///An upload is a file, so it re-arms too. Both auto-loads refuse an upload on their own account, since
    ///sky130 names laid over another PDK's layout would be wrong - see defaultRolesForThisFile.
    ///
    private void reArmBundledPdkData()
    {
        if (declinedOn == selectedExample)
            return;

        declinedBundledRoles = false;
        declinedBundledDeck = false;

        declinedOn = "";
    }

    ///<summary>
    ///Applies the names already in hand to a file that has just been opened.
    ///
    ///From a field rather than from storage, because this runs on every file open and a read there would
    ///put an IndexedDB round trip in front of every draw. The field is filled once when a session is
    ///restored and kept current by <see cref="rememberLayerNames"/>, so it holds the same thing the store
    ///does without being asked each time.
    ///</summary>
    private void carryLayerNamesOver()
    {
        if (gds is null)
            return;

        //What is in hand first; the bundled mapping only where there is nothing in hand at all.
        string mapping = layerNames;

        if (mapping.Length == 0)
            mapping = defaultRolesForThisFile();

        if (mapping.Length == 0)
            return;

        int applied = LayerNames.Parse(mapping).ApplyTo(gds.AdditionalInformation.Layers);

        if (applied > 0)
            layerNamesLoaded = true;
    }

    ///
    ///The bundled sky130 mapping, when the file being opened is one of the app's own examples.
    ///
    ///**Only for those.** Every file in the picker is a sky130 cell, so naming its layers is a fact rather
    ///than a guess - where a file off somebody's machine could be any technology, and sky130 names laid over
    ///a file from another PDK would be worse than numbers: wrong labels read as right ones. An injected
    ///example is somebody else's file in this app's picker, so it is not ours to name either.
    ///
    ///**And only where nothing else has said.** Names in hand win, because they are the visitor's own or came
    ///from a mapping they loaded. `layermap=` in the address wins too - it is applied later, in
    ///applyEmbedding, so it would land over the top anyway, and doing this first would be a mapping applied
    ///and replaced on the same load.
    ///
    ///Deliberately *not* written into <see cref="layerNames"/>. That field is what carries across file opens,
    ///including onto a file somebody uploads next - which is right for a mapping they chose and wrong for one
    ///the app assumed. If they touch a name afterwards, rememberLayerNames picks it up and it carries from
    ///then on, which is the point at which it stopped being an assumption.
    ///
    private string defaultRolesForThisFile()
    {
        if (declinedBundledRoles || shippedRoles.Length == 0)
            return "";

        if (embedding.LayerMap is not null)
            return "";

        //A bundled example: one this app ships, rather than an upload, a history entry, or a file a page
        //embedding the viewer brought with it.
        if (selectedExample.Length == 0 || injectedNamed(selectedExample) is not null)
            return "";

        return shippedRoles;
    }

    ///<summary>
    ///Takes a copy of the current names, so the next file opened gets them. Called wherever a name changes:
    ///a mapping loaded, a row renamed, the lot cleared.
    ///</summary>
    private void rememberLayerNames()
    {
        if (gds is null)
            return;

        layerNames = LayerNames.Named(gds.AdditionalInformation);
    }

    ///
    ///The three views: what each one is called, and the token the switch shows.
    ///
    ///The long name is the tooltip and the short one is the box. "2D Editor" rather than "2D Viewer"
    ///because it is one - shapes are drawn, dragged, retyped and combined there - and a name that
    ///undersells what a screen does is a screen people do not open.
    ///
    private static readonly (ViewType Which, string Says, string Shorthand)[] Views = new[]
    {
        (ViewType.ViewText, "Text Editor", "Txt"),
        (ViewType.View2DSvg, "2D Editor", "2D"),
        (ViewType.View3D, "3D Viewer", "3D")
    };

    ///<summary>Chosen from the switch. Pressing the one that is already on is not a change.</summary>
    private async Task chooseView(ViewType chosen)
    {
        if (chosen == view)
            return;

        //
        //What the view being left had set, so the one arriving starts where it did.
        //
        //**Switching views destroys the component that owns those controls.** The 3D distance and the 2D
        //opacity live in their view - the shell deliberately does not know what a view's settings are, see
        //WriteSettings - and a new instance of it starts at the defaults. Measured before this: set the
        //distance to 350, turn to 2D, turn back, and the slider and the scene both read 50. The opacity
        //does the same, 0.2 out and 0.5 back.
        //
        //That a session records both says they are meant to survive, so losing them on a switch inside one
        //session was a hole rather than a decision.
        //
        //Read here rather than after the switch, because `viewer` is still the *outgoing* component until
        //the render below replaces it - which is the whole reason this can be captured at all.
        //
        //**Updated rather than rebuilt**, and that distinction is the whole of it. Each view writes only
        //the settings it owns, so a session built fresh on the way out of 2D carries SavedSession's default
        //spacing of 50 rather than the 350 the 3D view had - and applying that to the 3D view arriving
        //would actively destroy the value instead of merely failing to carry it. It did: the first version
        //of this made the round trip worse than leaving it alone. Writing over one carrier leaves each
        //view's own values where the last visit to that view put them.
        //
        if (gds is not null && viewer is not null)
        {
            acrossViews ??= buildSession(gds);

            viewer.WriteSettings(acrossViews);

            handingOver = true;
        }

        view = chosen;

        //Replace rather than push: switching views is not somewhere the back button should have to walk
        //back through, and the address still ends up describing what is on screen.
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("view", slugOf(view)), replace: true);

        StateHasChanged();

        await saveSession();
    }

    private async Task RenderGDS()
    {
        if (gds is null)
            return;

        //A view is always mounted by the time a file can be loaded, but @ref is only filled in after the
        //component renders, so this is not something the type system can promise.
        if (viewer is null)
            return;

        //
        //The layout the shell already worked out, when it is still the one for this file.
        //
        //An edit mutates the library in place, so the flattened copy held here goes stale the moment one
        //happens - and handing over a stale layout would draw the file as it was before the edit. The view
        //re-flattens after an edit anyway, which is what makes null the right answer here rather than a
        //problem: it means "work it out", and it is only ever passed when nothing has touched the file.
        //
        await viewer.Render(gds, checkboxItems, preparedLayout);
    }

    private async Task layersChanged(ChangeEventArgs e, CheckboxItem item)
    {
        if (e.Value is not bool isSelected)
            return;

        item.IsSelected = isSelected;

        await RenderGDS();

        await saveChangedFile();
    }

    ///<summary>
    ///A view reports that it changed the loaded file. The layer list is rebuilt from scratch because an
    ///edit can add or remove a layer, which also means per-layer visibility resets - the same as loading a
    ///file, and better than a sidebar that no longer matches what is on screen.
    ///</summary>
    private async Task onFileEdited()
    {
        //From here on the loaded file is not what the server would hand back, so a session has to carry its
        //bytes rather than the example's name - otherwise returning would quietly undo the edit.
        fileEdited = true;

        //The library was changed in place, so the copy held here is of the file as it was.
        flattened = null;
        flattenedFor = null;

        getLayers();

        await RenderGDS();

        //
        //Checked again, if that was asked for.
        //
        //**After the redraw rather than before it.** The check reads the prepared layout, which RenderGDS
        //is what rebuilds - run first, it would measure the shape that was there before the edit and draw
        //markers on geometry that has moved out from under them.
        //
        //Not asked for, the last run's markers come off instead. They were measured against a layout that
        //no longer exists, and a marker is a claim about where something is.
        //
        if (drcContinuous && drcDeck is not null)
            await runDrc();
        else if (drcResult is not null)
        {
            drcResult = null;
            drcMarkers = "";

            summarizeDrc();
        }

        await saveChangedFile();
    }

    ///<summary>
    ///Builds the sidebar from the layers the parser already found, rather than walking the structures
    ///again to look for them.
    ///
    ///It used to be a second copy of that walk - same filters, same extraction - wrapped in a catch that
    ///discarded anything it went wrong on. Two independent answers to the same question is the problem:
    ///AdditionalInformation.Layers is what the renderers take an element's color and stacking offset
    ///from, while this list is what they filter it against, so any disagreement between them shows up as
    ///geometry that is drawn in a color whose layer has no checkbox, or silently not drawn at all.
    ///
    ///One row per layer/datatype pair rather than per layer number, since the pair is what identifies a
    ///layer - see <see cref="LayerKey"/>. Ordered by number then data type, which is both the order the 3D
    ///view stacks them in and the order a person reads them; the walk produced whatever order the elements
    ///happened to appear in.
    ///
    ///The label comes off the layer itself, so a name loaded from a layermap shows up here without this
    ///having to know where names come from.
    ///</summary>
    private void getLayers(bool keepSettings = true)
    {
        //What each layer was set to, carried across the rebuild.
        //
        //This runs again whenever the layer table changes under the list, and a rename is the common one -
        //so rebuilding every row switched on meant naming one layer un-hid every layer somebody had
        //hidden, and now would turn every layer's labels back on with it. Opening a different file passes
        //false: that is a new set of layers, and its rows start where a file's rows start.
        var previous = new Dictionary<LayerKey, CheckboxItem>();

        if (keepSettings)
        {
            foreach (var item in checkboxItems)
                previous[item.Id] = item;
        }

        checkboxItems.Clear();

        if (gds is null)
            return;

        foreach (var layer in gds.AdditionalInformation.OrderedLayers())
        {
            previous.TryGetValue(layer.Key, out var was);

            checkboxItems.Add(new CheckboxItem
            {
                Id = layer.Key,
                Label = layer.Value.DisplayName,
                IsSelected = was?.IsSelected ?? true,
                ShowLabels = was?.ShowLabels ?? true
            });
        }

        //The settings popup holds one of these rather than a key, so it has to be pointed at the row that
        //replaced the one it had - otherwise its switches read a detached object and do nothing.
        if (settingsFor is not null)
            settingsFor = checkboxItems.FirstOrDefault(item => item.Id == settingsFor.Id);
    }

    #endregion ***********************************************
}
