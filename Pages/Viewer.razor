    ///<summary>
    ///Only while a button is held. mousemove fires whenever the pointer crosses the field, so without this
    ///the color would follow the pointer over it without anyone having asked for a change.
    ///</summary>
    private async Task fieldDragged(MouseEventArgs e)
    {
        if (e.Buttons != 1)
            return;

        await pickFromField(e);
