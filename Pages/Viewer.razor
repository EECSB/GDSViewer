    ///so without it the setting would only be kept if you went on to do something else.
    ///</summary>
    private async Task toggleFullScreen()
    {
        fullScreen = !fullScreen;

        await saveSession();
    }

    ///
    ///Puts the layout back in the middle of whichever view is open.
    ///
    ///**A cast rather than a member on IRenderable**, for the same reason the draw layer is reached that
    ///way: it is not a question every view can answer. The text view has no framing at all, so the only
    ///implementation it could carry is one that does nothing - and a method that means nothing on a third
    ///of the things holding it is worse than a test for the two it does mean something on.
    ///
    ///Each view answers it its own way, which is the point of asking here rather than doing it here: 2D
    ///fits the drawing into the viewBox, 3D works out how far back a camera has to stand.
    ///
    private async Task centerView()
    {
        if (viewer is Viewer2DSvg shaded)
        {
            await shaded.CenterView();

            //
            //And the address stops naming a framing, which only here can reach.
            //
            //The 2D fit is where a file opens, so there is nothing left to say - CenterView has already
            //emptied the session's copy for the same reason. The 3D one is not: its opening position is a
            //fixed guess that suits a layout on the origin, so a centered camera is worth keeping and
            //worth sharing, and the settle report writes it in the ordinary way.
            //
            NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("box", (string?)null), replace: true);
        }
        else if (viewer is Viewer3D stacked)
        {
            await stacked.CenterView();
        }
    }

    ///
    ///The two sidebars, and whether each is showing.
    ///
    ///**Both here, though only one of them is drawn here.** The layer list is the shell's markup and the
    ///cell tree is the 2D view's, but the pair of switches belongs together in one place - they read as one
    ///decision about how much room the drawing gets, and the layer list stands beside the 3D view too,
    ///where the 2D component does not exist. The tree goes down as a parameter; see Viewer2DSvg.CellTreeOpen.
    ///
    ///Saved for the same reason full screen is: it is the page laid out one way rather than another, and
    ///somebody who wants the whole window for a layout wants it for the next one too.
    ///
    ///
    ///The layout this page is wrapped in, so the title bar can be reached from the bar.
    ///
