@page "/viewer"

@using System.IO;
@using System.Net.Http
@using System.Text.Json
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using System.Runtime.InteropServices.JavaScript;

@using GDSViewer.Models;
@using GDSViewer.Components;

@inject HttpClient httpClient
@inject IJSRuntime js;
@inject NavigationManager NavigationManager


<PageTitle>GDSII Viewer</PageTitle>


<div id="gdsWrapper" class="row">

    <!-- *********************************************** Info. Text ****************************************************** -->
   
    <!--Temp. warning while in dev. -->
    <div class="row">
        <center>
            <p style="background-color: lightcoral; color: darkred; padding: 10px; font-weight: 700; width: fit-content;">WARNING: This app is in development. It might not work or display things correctly, files don't get validated for the correct structure after editing, etc...</p>
        </center>
    </div>

    <!-- Add some spacing -->
    <div class="row">
        <p></p>
    </div>

    <!-- Info. Text -->
    <div class="row">
        <center>
            <p>This is a free and open source online GDSII file viewer/editor. It allows you to view GDS files in 2D/3D, edit them in 2D or directly via a text editor.</p>
        </center>
    </div>

    <!-- ***************************************************************************************************************** -->


    <!-- Add some spacing -->
    <div class="row">
        <p></p>
        <p></p>
    </div>


    <!-- *********************************************** Main App ***************************************************** -->
    
    <div class="row d-flex justify-content-center-on-over-990">
        <div class="col" style="max-width: 62em; min-width: 990px;"> <!-- For now keep fixed at 990px-->

            <!-- *********************************************** Top Toolbar ***************************************************** -->

            <div class="row">
                <div class="col">
                    <div class="row toolbar">

                        <div class="col-1 toolbarItem" style="align-items: end; display: flex;">
                            <div class="buttonStyle2">
                                <InputFile Id='fileUpload' style="margin-left: 10px; display:none;" OnChange="onFileInputChanged" multiple />
                                <label for='fileUpload'>Upload GDS</label>
                            </div>
                        </div>

                        <div class="col-1 toolbarItem" style="align-items: end; display: flex;">
                            <button class="buttonStyle2" @onclick="downloadFile">Download GDS</button>
                        </div>

                        <div class="col-4 toolbarItem">
                            <div><b>Sky130 GDS Examples</b></div>
                            <select @onchange="openExampleGDSFile" style="max-width: 12em;">
                                <option value="" disabled selected>Temp. Test GDS Files</option>
                                @foreach (var file in exampleFiles)
                                {
                                    <option value="@file">@file</option>
                                }
                            </select>
                        </div>

                        <div class="col-3 toolbarItem" style="width: 25%;">
                            @if (currentlySelectedFileName.Contains("sky130"))
                            {
                                <a href="https://skywater-pdk.readthedocs.io/en/main/contents/libraries/foundry-provided.html">PDK Docs</a>
                                <a href="https://antmicro-skywater-pdk-docs.readthedocs.io/en/test-submodules-in-rtd/contents/libraries/sky130_fd_sc_hd/cells/nand2/README.html">Example PDK NAND2 Cell Docs</a>
                            }
                        </div>

                    </div>
                </div>
            </div>

            <!-- ***************************************************************************************************************** -->
            
            <!-- Add some spacing -->
            <br>

            <div class="row">
                <div class="col">
                    <!-- *********************************************** View Change ***************************************************** -->

                    <div class="row viewBorderBackground" style="border-bottom: none;"><!-- For now keep fixed at 182px-->
                        <div class="col">
                            <div class="col-1 toolbarItem">
                                <div><b>View</b></div>
                                <div>
                                    <select @onchange="viewChange">
                                        <option value="@ViewType.ViewText">Text</option>
                                        <option selected value="@ViewType.View2DSvg">2D SVG</option>
                                        <option value="@ViewType.View2D">2D</option>
                                        <option value="@ViewType.View3D">3D</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ***************************************************************************************************************** -->

                    
                    <!-- *************************************************** View ******************************************************** -->

                    <div class="row flex-nowrap">
            
                        <!-- ************************************************** View ********************************************************* -->

                        <div class="col-9 viewBorderBackground" style="background-color: white; width: 802px; padding: 0;">
                            <!-- For now keep it fixed at 802px -->
                            @switch (view)
                            {
                                case ViewType.ViewText: <TextEditor @ref="viewer" Gds="gds"></TextEditor>;
                                    break;
                                case ViewType.View2DSvg: <Viewer2DSvg @ref="viewer" Gds="gds" ShowLayers="checkboxItems"></Viewer2DSvg>;
                                    break;
                                case ViewType.View2D: <Viewer2D @ref="viewer" Gds="gds" ShowLayers="checkboxItems"></Viewer2D>;
                                    break;
                                case ViewType.View3D: <Viewer3D @ref="viewer" Gds="gds" ShowLayers="checkboxItems"></Viewer3D>;
                                    break;

                                default:
                                    break;
                            }
                        </div>
            
                        <!-- ***************************************************************************************************************** -->
            
                        <!-- ************************************************** Layers ******************************************************* -->
            
                        <div class="col viewBorderBackground" style="border-left: none;">

                            <div class="row" style="text-align: center;"><b>Layers</b></div>

                            <div class="row" style="text-align: center; overflow-y: auto; padding: 2px;">
                                <div class="col" style="min-width: 182px;"><!-- For now keep fixed at 182px-->
                                    @if(view != ViewType.ViewText)
                                    {
                                        @for (int i = 0; i < checkboxItems.Count - 1; i++)
                                        {
                                            var item = checkboxItems[i];

                                            <div class="row">
                                                <div class="col-1">

                                                </div>

                                                <div class="col-1" style="padding: 0.3em 0em; font-size: 12px;">
                                                    @(i + 1).
                                                </div>

                                                <div class="col-8">
                                                    <label>
                                                        @item.Label
                                                        <input type="checkbox" @onchange="async e => await layersChanged(e, item)" checked="@item.IsSelected" style="margin-left: 10px;" />
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                        </div>
            
                        <!-- ***************************************************************************************************************** -->
            
                    </div>

                    <!-- ***************************************************************************************************************** -->
                </div>
            </div>

        </div>
    </div>

    <!-- ************************************************************************************************************** -->


    <!-- Add some spacing -->
    <div class="row">
        <p></p>
        <p></p>
        <p></p>
    </div>
</div>

