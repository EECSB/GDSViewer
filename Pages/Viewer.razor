    #region Methods ******************************************

    private async Task downloadFile()
    {
        if (gds is null)
        {
            //todo: show warning to user
            return;
        }

        byte[] file = gds.Serialize();

        await js.InvokeVoidAsync("BlazorDownloadFile", currentlySelectedFileName, "application/octet-stream", file);
    }


    private async Task onFileInputChanged(InputFileChangeEventArgs e)
    {
        byte[] rawGDS = new byte[0];

        try
        {
            using (MemoryStream ms = new MemoryStream())
            {
                foreach (var file in e.GetMultipleFiles(e.FileCount))
                {
                    //Only one file is supported. If multiple files present only the first one will be read. //todo: inform user about this?
                    await file.OpenReadStream().CopyToAsync(ms);
                    rawGDS = ms.ToArray();

                    break;
                }
            }
        }
        catch (Exception ex)
        {
            //todo: tell user about read error
            //exceptionErrorMessage = ex.Message;
            _ = InvokeAsync(StateHasChanged);
        }

        await selectFile(rawGDS);
    }


    private async Task openExampleGDSFile(ChangeEventArgs e)
    {
        currentlySelectedFileName = e.Value.ToString();

        string filePath = $"resources/GDS Files/Sky130 GDS/{currentlySelectedFileName}";

        byte[] rawGDS = await httpClient.GetByteArrayAsync(filePath);

        await selectFile(rawGDS);
    }

    private async Task selectFile(byte[] rawGDS)
    {
        gds = new GDS(rawGDS);

        getLayers();

        await RenderGDS();
    }


    private async Task viewChange(ChangeEventArgs e)
    {
        view = (ViewType)Enum.Parse(typeof(ViewType), e.Value.ToString());

        StateHasChanged();
    }

    private async Task RenderGDS()
    {
        if(gds is not null)
            await viewer.Render(gds, checkboxItems);                    
    }


    private async Task layersChanged(ChangeEventArgs e, CheckboxItem item)
    {
        item.IsSelected = (bool)e.Value;

        await RenderGDS();
    }

    private void getLayers()
    {
        checkboxItems.Clear();

        foreach (var element in gds.StreamFormat.Structure.Elements)
        {
            var boundry = element.Boundry.First();

            try //Temp
            {
                short layer = boundry.Layer.Data;

                if (checkboxItems.Where(x => x.Id == layer).Count() == 0)
                    checkboxItems.Add(new CheckboxItem { Id = layer, Label = $"Layer {layer}", IsSelected = true });
            }
            catch (Exception)
            {

            }
        }
    }

