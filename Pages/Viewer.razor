    ///
    ///The bundled example a shared link can name, or null when what is open is not one.
    ///
    ///**Off the picker's own record of what is open, not off the address**, which does not follow it: a
    ///link's file= leaves the address once its file is open - see takeOutOfAddress. What decides is whether
    ///the name comes back through exampleNamed - the lookup a link's file= goes through - which is what a
    ///bundled example is. The 3D view's QR code is handed its file from here too, for the same reason.
    ///
    ///An injected file is recorded the same way, under the name its page gave it, and opens only on that page;
    ///it is no more linkable than an upload. Named as an address names it: without the extension.
    ///
    private string? linkableFile()
    {
        if (selectedExample.Length == 0 || injectedNamed(selectedExample) is not null)
            return null;

        string slug = Path.GetFileNameWithoutExtension(selectedExample);

        if (exampleNamed(slug) == selectedExample)
            return slug;

        //Whole where another example has the same name without it - GF180's VGA clock, tt_um_vga_clock.oas, beside sky130's.
        if (exampleNamed(selectedExample) == selectedExample)
            return selectedExample;

        return null;
    }

    ///<summary>Why what is open cannot go in a link, for the place in the popup where the file would be named.</summary>
    private string unlinkableReason()
    {
        if (selectedExample.Length > 0 && injectedNamed(selectedExample) is not null)
            return "This file came from the page the viewer is part of, so only that page can open it. The link opens the viewer without it.";

        return "What is open did not come from the bundled examples, and a link cannot carry a file - nothing is ever uploaded. The link opens the viewer without it.";
    }

    ///
    ///Puts the layout back in the middle of whichever view is open.
    ///
    ///**A cast rather than a member on IRenderable**, for the same reason the draw layer is reached that
    ///way: it is not a question every view can answer. The text view has no framing at all, so the only
    ///implementation it could carry is one that does nothing - and a method that means nothing on a third
    ///of the things holding it is worse than a test for the two it does mean something on.
    ///
    ///Each view answers it its own way, which is the point of asking here rather than doing it here: 2D
    ///fits the drawing into the viewBox, 3D works out how far back a camera has to stand.
    ///
    private async Task centerView()
    {
        if (viewer is Viewer2DSvg shaded)
            await shaded.CenterView();
        else if (viewer is Viewer3D stacked)
            await stacked.CenterView();
    }

    ///
    ///What is being loaded, said over the view while it is, or empty when nothing is.
    ///
    ///**A load holds the page.** Reading a file, flattening it and drawing it is C# on the page's only thread, and
    ///on a large design that is seconds in which nothing on screen moves - which reads as the app having frozen
    ///rather than as it working. So the view's box says what it is doing.
    ///
    ///Taken down by the view itself, once its first picture of the file is on the page - see viewDrawn - and by
    ///each route that gives up on a file before then. Never put up in the text view, which draws no picture to
    ///report and so would never take it down.
    ///
    private string loadingWhat = "";

    ///<summary>Puts the note up and waits until it is on screen, so the work that follows cannot hold it back. See Painting.</summary>
    private async Task showLoading(string what)
    {
        if (view == ViewType.ViewText)
            return;

        if (what.Trim().Length == 0)
            loadingWhat = "Loading";
        else
            loadingWhat = $"Loading {what.Trim()}";

        StateHasChanged();

        await js.AfterPaintAsync();
    }

    ///
    ///The load under way - a file opening, a tab or a history row coming back, a view being built - or null when
    ///nothing is. Its pace is what lets the page go on answering while a big file is read and drawn, and Cancel on
    ///the note gives it up. See Pacer.
    ///
    private Pacer? loading;

    ///<summary>The load under way, asked for by a view as a file arrives in it - see Viewer2DSvg's Loading for why it asks.</summary>
    private Pacer? loadInHand()
    {
        return loading;
    }

    ///
    ///What the page was called, and the view it was in, when the load began - put back if the load is given up
    ///before its file goes in.
    ///
    ///**Because every way in renames the page before the file has been read**, so that a save during the read
    ///records the right name - and a load given up there would leave the file on screen under the other one's name.
    ///
    private (string Name, string Type, string Example, ViewType View) loadingFrom = ("", "", "", ViewType.View2DSvg);

    ///
    ///What puts the page back as it was, once the load has changed what is on screen - or null until it has. Set
    ///where each way in puts its file on screen, and by a switch of view. See cancelLoad.
    ///
    private Func<Task>? undoLoad;

    ///
    ///How to put the page back once this load's file goes in, for a way in that knows better than the default -
    ///a tab switch goes back to the tab it came from, where an open closes the tab it made. Null for the default,
    ///which is undoOpen; set after beginLoad, which clears it.
    ///
    private Func<Task>? undoNext;

    ///
    ///What else the load in hand changed ahead of its file, beyond the page's name and view, to go back with them if
    ///the file never arrives - a tab switch's tabs, which say the tab pressed is on screen from the press. Null for
    ///nothing; set after beginLoad, which clears it, and let go of as the file goes in. See putBackAhead.
    ///
    private Action? undoAhead;

    ///<summary>Whether the load in hand has put its file on screen yet - or, a switch of view, its view. See beginLoad.</summary>
    private bool fileGoneIn = false;

    ///<summary>The same, asked by the note - which can be drawn again on its own, and so asks rather than holds it. See LoadingNote.</summary>
    private bool loadFileIn()
    {
        return fileGoneIn;
    }

    ///<summary>The note over the view while something loads.</summary>
    private LoadingNote? loadingNote;

    ///
    ///Starts a load, before anything about the page has changed for it: whatever was still loading gives way to
    ///this one, and what the page is called now is noted for a cancel.
    ///
    ///**Overtaken is not canceled.** A load that gives way to a newer one stops at its next pause, and the page is the
    ///newer one's from here - see readingGivenUp, which only the load in hand may do. **But what it changed ahead of
    ///its file goes back now**, if the file never went in: the page's name and view, a tab switch's tabs. Left for its
    ///walk to put back at its next pause, they would be noted below as how the page was - and a cancel of this load
    ///would then put the other one's name back over the file on screen, and an open would put that file away into
    ///the tab the switch was headed for, which held something else.
    ///
    private Pacer beginLoad(bool canCancel = true)
    {
        if (loading is Pacer overtaken)
        {
            overtaken.Cancel();

            if (!fileGoneIn)
                putBackAhead();
        }

        loading = new Pacer { CanCancel = canCancel };
        fileGoneIn = false;
        undoLoad = null;
        undoNext = null;
        undoAhead = null;
        loadingFrom = (CurrentlySelectedFileName, CurrentlySelectedFileType, selectedExample, view);

        return loading;
    }

    ///<summary>The load is over - drawn, failed or given up - unless a newer one has taken its place, which is left alone.</summary>
    private void endLoad(Pacer? pacer)
    {
        if (pacer is null || !ReferenceEquals(loading, pacer))
            return;

        loading = null;
        undoLoad = null;
        undoNext = null;
        undoAhead = null;
    }

    ///
    ///What the load in hand changed before its file went in, put back: the name and the view the page had, a tab
    ///switch's tabs, and what an open put aside to go into a tab of its own. The file on screen is the one it always
    ///was, and keeps its tab.
    ///
    private void putBackAhead()
    {
        (CurrentlySelectedFileName, CurrentlySelectedFileType, selectedExample, view) = loadingFrom;

        undoAhead?.Invoke();
        undoAhead = null;

        openFailed();
    }

    ///
    ///A load given up before its file went in: the page goes back to how it was - see putBackAhead.
    ///
    ///Only for the load in hand. One overtaken by a newer load had the same done for it as it was overtaken - see
    ///beginLoad - and the page is that one's now.
    ///
    private void readingGivenUp(Pacer pacer)
    {
        if (!ReferenceEquals(loading, pacer))
            return;

        putBackAhead();

        loadingWhat = "";

        endLoad(pacer);

        StateHasChanged();
    }

    ///
    ///Cancel, on the note.
    ///
    ///**Still reading**, nothing is on screen yet but the page's new name: the walk under way stops at its next
    ///pause and whatever began the load puts the name back - see readingGivenUp. **Drawing**, the file is in and
    ///only its picture is still to come: the view's walk stops by itself, and the page is put back from here - see
    ///undoLoad, which takes the road a tab switch takes.
    ///
    ///The note goes at once either way, so the press is answered before the walk has noticed it.
    ///
    private async Task cancelLoad()
    {
        if (loading is not Pacer pacer || !pacer.CanCancel)
            return;

        pacer.Cancel();

        loadingWhat = "";

        if (undoLoad is not Func<Task> undo)
            return;

        endLoad(pacer);

        await undo();
    }

    ///
    ///What puts the page back after a file opened over another is given up while it is being drawn: the tab it was
    ///given is closed and the file that was on screen comes back onto its own - or, where the old file gave way to
    ///the new one rather than keeping a tab, comes back in its place. With nothing open before, the app's own
    ///example, which is what it opens on when there is nothing to come back to.
    ///
    ///**Not itself canceled by Cancel.** It is the answer to Cancel; see Pacer.CanCancel.
    ///
    private Func<Task> undoOpen(SavedSession? before, bool gotTab)
    {
        return async () =>
        {
            if (gotTab && activeTab > 0 && activeTab < tabs.Count)
            {
                tabs.RemoveAt(activeTab);
                activeTab--;
                tabs[activeTab].Parked = null;
                tabsChanged++;
            }

            if (before is null)
            {
                //
                //Nothing to come back to, so what the app opens then - and the file given up gives its place to it,
                //as the app's own example would, rather than keeping a tab: it is the one file here nobody wants.
                //See activeTabGivesWay.
                //
                openedItself = true;
                fileEdited = false;

                await openExample(MosfetExample, itself: true);

                return;
            }

            await putBack(before);
        };
    }

    ///
    ///A saved state back on screen, as the way back from a cancel or a tab that would not open - a load of its own,
    ///which Cancel does not offer to give up.
    ///
    ///A newer load can still overtake it - a file chosen while it comes back - and then that one has the page.
    ///
    private async Task putBack(SavedSession before)
    {
        var pacer = beginLoad(canCancel: false);

        try
        {
            if (await applySavedState(before, addressWins: false, pacer))
                addressForRestoredFile();

            await saveTabs();
        }
        catch (OperationCanceledException)
        {
        }

        StateHasChanged();
    }

    ///
    ///The view's first picture of what was loading is on the page, which takes the note down and ends the load.
    ///
    ///And starts the chip game, when Play game was pressed in another view and this is the 3D view's scene it was
    ///waiting for - see playGame.
    ///
    ///**Not while the load in hand is still reading its file**, whose picture this cannot be. A tab or a history row
    ///puts the page in the view it was left in before its file is read, and the view that mounts for it draws the
    ///file still on screen and says so - which took the note down and ended the load there, so the rest of it ran as
    ///a load of its own, and a cancel of that one had forgotten the tab it was meant to go back to.
    ///
    private async Task viewDrawn()
    {
        if (loading is not null && !fileGoneIn)
            return;

        loadingWhat = "";

        endLoad(loading);

        if (!gameWhenDrawn)
            return;

        gameWhenDrawn = false;

        if (viewer is Viewer3D stacked && !stacked.GameRunning)
            await stacked.ToggleGame();
    }

    ///<summary>Whether the chip game is waiting for the 3D view's scene to be built before it starts - see playGame.</summary>
    private bool gameWhenDrawn = false;

    ///<summary>Whether the chip game is running, which is the 3D view's to know. It says Play or Stop in the menu.</summary>
    private bool gamePlaying => viewer is Viewer3D stacked && stacked.GameRunning;

    ///
    ///Play game, from the Settings menu: the chip game started in the 3D view, or stopped if it is running.
    ///
    ///**From the 2D or text view it goes to 3D first**, and the game starts once the scene is built, in viewDrawn.
    ///Started straight away it would find nothing to drive on, since the view arriving builds its scene after it
    ///has mounted - and leaving for another view before then calls it off, in chooseView.
    ///
    private async Task playGame()
    {
        appSettingsOpen = false;

        if (viewer is Viewer3D stacked)
        {
            await stacked.ToggleGame();

            return;
        }

        if (gds is null)
            return;

        gameWhenDrawn = true;

        await chooseView(ViewType.View3D);
    }

