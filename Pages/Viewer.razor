    }

    ///<summary>Whether a box of the view switch opens the 3D view's settings: the cube, while that view is on.</summary>
    private bool opensViewSettings(ViewType which)
    {
        return which == ViewType.View3D && view == ViewType.View3D;
    }

    ///<summary>Whether the cube's settings are open, for a screen reader - or nothing, for a box that opens none.</summary>
    private string? viewSettingsShown(bool opens)
    {
        if (!opens)
            return null;

        if (viewer is Viewer3D three && three.ViewSettingsOpen)
            return "true";

        return "false";
    }

    ///<summary>A box's tooltip: the view it opens - and for the cube while that view is on, what it opens as well.</summary>
    private static string viewPickSays(string says, bool opens)
    {
        if (!opens)
            return says;

        return says + " - its settings: how far it draws, textures, Admire and the background";
    }

    ///
    ///A box of the view switch pressed: its view - or for the cube, the 3D view already on, that view's settings, which
    ///hang from it. Pressing either other lit box is no change; see chooseView.
    ///
    private async Task viewPicked(ViewType which)
    {
        if (opensViewSettings(which) && viewer is Viewer3D three)
        {
            await three.ShowViewSettings();

            return;
        }

        await chooseView(which);
    }

    ///<summary>The cube pointed at, the 3D view on: its settings open, as the pointer arriving opens every menu in the bar.</summary>
    private async Task viewPointedAt(ViewType which)
    {
        if (opensViewSettings(which) && viewer is Viewer3D three)
            await three.ShowViewSettings();
    }

    ///<summary>The pointer gone from the cube and the settings under it, which puts them away.</summary>
    private async Task viewSettingsLeft()
    {
        if (viewer is Viewer3D three)
            await three.OnViewSettingsDismissed();
    }

    ///<summary>Chosen from the switch. Pressing the one that is already on is not a change.</summary>
    private async Task chooseView(ViewType chosen)
    {
        await chooseView(chosen, canCancel: true);
    }

    ///
    ///The same, saying whether Cancel is offered while the view arriving builds its picture - not when this is
    ///itself the way back from a cancel. See backToView.
    ///
    private async Task chooseView(ViewType chosen, bool canCancel)
    {
        if (chosen == view)
            return;

        //
        //**A load, since the view arriving builds its whole picture.** Anything still loading gives way - the view
        //it was being drawn for is about to go - and a cancel while this one builds puts back the view it left.
        //
        var previous = view;
        var pacer = beginLoad(canCancel);

        //A game waiting for the 3D view to be built has nothing to start in once another view is chosen.
        if (chosen != ViewType.View3D)
            gameWhenDrawn = false;

        //
        //**Said before the switch, because the view arriving is the wait** - the 3D view merges and builds the
        //whole scene as it mounts, and the 2D view draws the whole picture. The text view draws no picture to
        //report when it is done, so it takes down any note that is up rather than putting one up.
        //
        if (chosen == ViewType.View3D && gds is not null)
            await showLoading("the 3D view");
        else if (chosen == ViewType.View2DSvg && gds is not null)
            await showLoading("the 2D view");
        else
            loadingWhat = "";

        //
        //What the view being left had set, so the one arriving starts where it did.
        //
        //**Switching views destroys the component that owns those controls.** The 3D distance and the 2D
        //opacity live in their view - the shell deliberately does not know what a view's settings are, see
        //WriteSettings - and a new instance of it starts at the defaults. Measured before this: set the
        //distance to 350, turn to 2D, turn back, and the slider and the scene both read 50. The opacity
        //does the same, 0.2 out and 0.5 back.
        //
        //That a session records both says they are meant to survive, so losing them on a switch inside one
        //session was a hole rather than a decision.
        //
        //Read here rather than after the switch, because `viewer` is still the *outgoing* component until
        //the render below replaces it - which is the whole reason this can be captured at all.
        //
        //**Updated rather than rebuilt**, and that distinction is the whole of it. Each view writes only
        //the settings it owns, so a session built fresh on the way out of 2D carries SavedSession's default
        //spacing of 50 rather than the 350 the 3D view had - and applying that to the 3D view arriving
        //would actively destroy the value instead of merely failing to carry it. It did: the first version
        //of this made the round trip worse than leaving it alone. Writing over one carrier leaves each
        //view's own values where the last visit to that view put them.
        //
        if (gds is not null && viewer is not null)
        {
            acrossViews ??= buildSession(gds);

            viewer.WriteSettings(acrossViews);

            handingOver = true;
        }

        view = chosen;

        //
        //Nothing to draw in the text view, and nothing at all without a file, so the load is over. Otherwise the
        //view arriving draws, and a cancel meanwhile goes back to the one it replaced - see backToView.
        //
        //Only while this is still the load in hand, since the note above let the page in: a load begun meanwhile
        //has its own to say how far it got and the way back from it.
        //
        if (ReferenceEquals(loading, pacer))
        {
            //Its view is what a switch puts in, so a load that overtakes it starts from the view chosen - see beginLoad.
            fileGoneIn = true;

            if (chosen == ViewType.ViewText || gds is null)
                endLoad(pacer);
            else if (pacer.CanCancel)
                undoLoad = () => backToView(previous);
        }

        //Replace rather than push: switching views is not somewhere the back button should have to walk
        //back through, and the address still ends up describing what is on screen.
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("view", slugOf(view)), replace: true);

        StateHasChanged();

        await saveSession();
    }

    ///
    ///The view a switch came from, back on screen after a cancel while the one arriving was being built.
    ///
    ///Drawn again from the file, which has not changed: a view's picture goes with the view. A load like any other,
    ///with the note and the pace, though Cancel is not offered - this is what Cancel asked for.
    ///
    private async Task backToView(ViewType previous)
    {
        await chooseView(previous, canCancel: false);
    }

    private async Task RenderGDS()
    {
        if (gds is null)
            return;

        //A view is always mounted by the time a file can be loaded, but @ref is only filled in after the
        //component renders, so this is not something the type system can promise.
        if (viewer is null)
            return;

        //
        //The layout the shell already worked out, when it is still the one for this file.
        //
        //An edit mutates the library in place, so the flattened copy held here goes stale the moment one
        //happens - and handing over a stale layout would draw the file as it was before the edit. The view
        //re-flattens after an edit anyway, which is what makes null the right answer here rather than a
        //problem: it means "work it out", and it is only ever passed when nothing has touched the file.
        //
        await viewer.Render(gds, checkboxItems, preparedLayout);
    }

    ///
    ///The eye: whether this layer is drawn.
    ///
    ///Toggled from the row's own state rather than read off an event, because the control is a button now
    ///and not a checkbox - a checkbox reports what it was set to, a button reports only that it was pressed.
    ///
    private async Task layerShownToggled(CheckboxItem item)
    {
        item.IsSelected = !item.IsSelected;

        await redrawShown();

        await saveChangedFile();
    }

    ///
    ///A layer shown or hidden, redrawn - **except beside the text**, which writes every record whatever is shown: a
    ///redraw there makes the whole file's text again, to come out the same - most of a second for a chip. The
    ///drawings read the eyes as they open.
    ///
    private async Task redrawShown()
    {
        if (view == ViewType.ViewText)
            return;

        await RenderGDS();
    }

    ///
    ///The padlock: whether this layer can be worked on.
    ///
    ///**No redraw.** What locking changes is which layers answer a click, and that is read per press from
    ///<see cref="CheckboxItem.EditableLayers"/> - so the picture is the same picture. The fade over it is a
    ///stylesheet the render puts out, which this render is about to do anyway; rebuilding every path to say
    ///a layer is out of reach would be paying a redraw for a style change.
    ///
    ///Saved, because a lock is a statement about how the file is being worked on and belongs with the rest
    ///of what a session carries.
    ///
    private async Task layerLockToggled(CheckboxItem item)
    {
        item.IsLocked = !item.IsLocked;

        await saveChangedFile();
    }

    ///<summary>Whether every layer is drawn, which is what the header's eye shows open for.</summary>
    private bool everyLayerShown()
    {
        return checkboxItems.All(item => item.IsSelected);
    }

    ///<summary>Whether any layer is locked, which is what the header's padlock shows shut for.</summary>
    private bool anyLayerLocked()
    {
        return checkboxItems.Any(item => item.IsLocked);
    }

    ///<summary>A header switch's aria-pressed: every row on, none of them, or some of each.</summary>
    private static string columnState(int on, int of)
    {
        if (on == of)
            return "true";

        if (on == 0)
            return "false";

        return "mixed";
    }

    private string allLayersShownTitle()
    {
        if (everyLayerShown())
            return "Every layer is drawn. Click to hide them all";

        return "Some layers are hidden. Click to draw every layer";
    }

    private string allLayersLockedTitle()
    {
        if (anyLayerLocked())
            return "Some layers are locked. Click to unlock every layer";

        return "Click to lock every layer: still drawn, but not selectable";
    }

    ///<summary>How many layers the header stands over, and how many of them are put away. Its tooltip.</summary>
    private string layerListSummary()
    {
        int hidden = checkboxItems.Count(item => !item.IsSelected);
        int locked = checkboxItems.Count(item => item.IsLocked);

        return $"{checkboxItems.Count} layer(s): {hidden} hidden, {locked} locked";
    }

    ///
    ///The header's eye: every layer drawn - or, when every one already is, none.
    ///
    ///Back to normal first, for the reason the header's markup gives: any layer hidden, and the press
    ///draws them all.
    ///
    private async Task allLayersShownToggled()
    {
        bool show = !everyLayerShown();

        foreach (var item in checkboxItems)
            item.IsSelected = show;

        await redrawShown();

        await saveChangedFile();
    }

    ///
    ///The header's padlock: every lock off while any is on, and every layer locked while none is.
    ///
    ///No redraw, for the reason layerLockToggled gives: a lock changes which layers answer a click and the
    ///fade over them is a stylesheet, which the render after this press puts out anyway.
    ///
    private async Task allLayersLockedToggled()
    {
        bool lockThem = !anyLayerLocked();

        foreach (var item in checkboxItems)
            item.IsLocked = lockThem;

        await saveChangedFile();
    }

    ///
    ///The text view has read the whole file back in from what was typed.
    ///
    ///**Every record is a new one, and every cell and shape a new object** - so an edit on the undo stack points
    ///at a library that is no longer the file, and taking it back would change nothing on screen while saying it
    ///had. Saved, the step would then be taken again on the real file at the next reload. So the stack goes, as
    ///it does for any file read in, and the next save writes the file whole: no step of the history says what
    ///the text did. See SavedSession.Journal.
    ///
    private async Task onFileRewritten()
    {
        editHistory.Clear();
        changedOffJournal = true;

        //
        //**The tools' sessions are over with it.** Every record is new, so the shape numbers the assistant's and
        //the MCP server's sessions gave out name nothing - and the file is the same object, which is how both tell
        //one file from another. Each starts again and says so: the assistant through FileRewrites, the link through
        //linkRewritten.
        //
        fileRewrites++;
        linkSession = null;
        linkRewritten = true;

        await onFileEdited();
    }

    ///<summary>How many times the file has been written from the text view, for AskAi to notice one - see onFileRewritten.</summary>
    private int fileRewrites;

    ///<summary>Whether the next call over the link is the first since the file was written from the text view.</summary>
    private bool linkRewritten;

    ///<summary>
    ///A view reports that it changed the loaded file. The layer list is rebuilt from scratch because an
    ///edit can add or remove a layer, which also means per-layer visibility resets - the same as loading a
    ///file, and better than a sidebar that no longer matches what is on screen.
    ///</summary>
    private async Task onFileEdited()
    {
        //From here on the loaded file is not what the server would hand back, so a session has to carry its
        //bytes rather than the example's name - otherwise returning would quietly undo the edit.
        fileEdited = true;

        //And the bytes it carried last are of the file before this edit. See sessionFileBytes.
        fileVersion++;

        //
        //**A change with no step of the edit history behind it is one the saved steps cannot say**, so the next
        //save writes the file whole - see SavedSession.Journal. Every edit reaches here after its step: a view's,
        //the assistant's, an import. A report with none behind it is the file changed some other way.
        //
        if (editHistory.Version == historyVersionSeen)
            changedOffJournal = true;

        historyVersionSeen = editHistory.Version;

        //And a comparison of the file before it is not one of this file.
        staleComparison("The file has changed since it was compared. Compare again to see how it differs now.");

        //The library was changed in place, so the copy held here is of the file as it was.
        flattened = null;
        flattenedFor = null;

        //
        //**And the 3D view told so**, which cannot see it: it builds a file's scene once and knows the file by the
        //object, which an edit hands back unchanged - so the assistant's change, or the MCP server's, was drawn as the
        //scene from before it. See Viewer3D.FileEditedInPlace.
        //
        if (viewer is Viewer3D three)
            three.FileEditedInPlace();

        //Before the list is rebuilt from the layer table, since this is what that table should say.
        restoreRemovedLayers();

        getLayers();

        await RenderGDS();

        //
        //Checked again, if that was asked for.
        //
        //**After the redraw rather than before it.** The check reads the prepared layout, which RenderGDS
        //is what rebuilds - run first, it would measure the shape that was there before the edit and draw
        //markers on geometry that has moved out from under them.
        //
        //Not asked for, the last run's markers come off instead. They were measured against a layout that
        //no longer exists, and a marker is a claim about where something is.
        //
        if (drcContinuous && drcDeck is not null)
            await runDrc();
        else if (drcResult is not null)
        {
            drcResult = null;
            drcMarkers = "";

            summarizeDrc();
        }

        await saveChangedFile();
    }

    ///<summary>
    ///Builds the sidebar from the layers the parser already found, rather than walking the structures
    ///again to look for them.
    ///
    ///It used to be a second copy of that walk - same filters, same extraction - wrapped in a catch that
    ///discarded anything it went wrong on. Two independent answers to the same question is the problem:
    ///AdditionalInformation.Layers is what the renderers take an element's color and stacking offset
    ///from, while this list is what they filter it against, so any disagreement between them shows up as
    ///geometry that is drawn in a color whose layer has no checkbox, or silently not drawn at all.
    ///
    ///One row per layer/datatype pair rather than per layer number, since the pair is what identifies a
    ///layer - see <see cref="LayerKey"/>. Ordered by number then data type, which is both the order the 3D
    ///view stacks them in and the order a person reads them; the walk produced whatever order the elements
    ///happened to appear in.
    ///
    ///The label comes off the layer itself, so a name loaded from a layermap shows up here without this
    ///having to know where names come from.
    ///</summary>
    private void getLayers(bool keepSettings = true)
    {
        //What each layer was set to, carried across the rebuild.
        //
        //This runs again whenever the layer table changes under the list, and a rename is the common one -
        //so rebuilding every row switched on meant naming one layer un-hid every layer somebody had
        //hidden, and now would turn every layer's labels back on with it. Opening a different file passes
        //false: that is a new set of layers, and its rows start where a file's rows start.
        var previous = new Dictionary<LayerKey, CheckboxItem>();

        if (keepSettings)
        {
            foreach (var item in checkboxItems)
                previous[item.Id] = item;
        }

        checkboxItems.Clear();

        if (gds is null)
            return;

        foreach (var layer in gds.AdditionalInformation.OrderedLayers())
        {
            previous.TryGetValue(layer.Key, out var was);

            checkboxItems.Add(new CheckboxItem
            {
                Id = layer.Key,
                Label = layer.Value.DisplayName,
                IsSelected = was?.IsSelected ?? true,
                ShowLabels = was?.ShowLabels ?? true,

                //Carried across a rename like the rest, and false for a layer this list has not seen: a new
                //file opens with everything in hand, the same way it opens with everything shown.
                IsLocked = was?.IsLocked ?? false
            });
        }

        //The settings popup holds one of these rather than a key, so it has to be pointed at the row that
        //replaced the one it had - otherwise its switches read a detached object and do nothing.
        if (settingsFor is not null)
            settingsFor = checkboxItems.FirstOrDefault(item => item.Id == settingsFor.Id);
    }

