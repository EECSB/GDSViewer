    private string compareTitle()
    {
        if (view != ViewType.View2DSvg)
            return "Comparing is drawn in the 2D view";

        if (compareOpen)
            return "Put the comparison away. Its marks stay on the drawing";

        return "Compare this file with another: what only one of them draws is marked on the drawing";
    }

    ///<summary>The file this one is compared with, kept once chosen. See onCompareChosen.</summary>
    private GDS? otherFile;

    private string otherName = "";

    ///<summary>What the last comparison found, or null when there is none - or it is of a file that has since changed.</summary>
    private Comparison? comparison;

    ///<summary>Why there is no comparison on screen, when a file is chosen and there is not.</summary>
    private string compareWaiting = "";

    ///<summary>Which difference is being looked at.</summary>
    private int differenceAt;

    ///<summary>The differences as markup, handed to the 2D view beside the rule markers.</summary>
    private string compareMarkers = "";

    ///<summary>How thin a difference may be and still be left out, in microns. Nothing, to start with.</summary>
    private double compareIgnoreMicrons;

    ///<summary>The largest file the comparison reads. The same ceiling an upload has.</summary>
    private const long MaximumCompareSize = 512L * 1024 * 1024;

    private async Task onCompareChosen(InputFileChangeEventArgs e)
    {
        GDS chosen;

        try
        {
            using var stream = e.File.OpenReadStream(MaximumCompareSize);
            using var copy = new MemoryStream();

            await stream.CopyToAsync(copy);

            chosen = parsedFrom(copy.ToArray());
        }
        catch (Exception ex) when (ex is InvalidDataException || ex is IOException)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}. {ex.Message}");

            return;
        }

        otherFile = chosen;
        otherName = e.File.Name;

        await runCompare();
    }

    ///
    ///Lays this file over the other one, and goes to the first place they differ.
    ///
    ///**In this file's units**: the other is scaled onto them when the two differ, so two files of the same
    ///layout in nanometers and in ångströms compare as the same - see Compare.Layouts.
    ///
    private async Task runCompare()
    {
        if (gds is null || otherFile is null)
            return;

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        double here = micronsPerUnit();
        double scale = micronsPerUnitOf(otherFile) / here;
        int ignore = (int)Math.Round(compareIgnoreMicrons / here);

        comparison = Compare.Layouts(flattened!, GdsFlattener.Flatten(otherFile), scale, ignore);
        compareWaiting = "";
        differenceAt = 0;

        drawDifferences();

        StateHasChanged();

        if (!comparison.Same)
            await goToDifference(0);
    }

    private void drawDifferences()
    {
        if (comparison is null)
        {
            compareMarkers = "";

            return;
        }

        compareMarkers = SvgWriter.Differences(comparison.Differences, differenceAt);
    }

    private async Task stepDifference(int by)
    {
        if (comparison is null || comparison.Differences.Count == 0)
            return;

        int count = comparison.Differences.Count;

        await goToDifference(((differenceAt + by) % count + count) % count);
    }

    ///<summary>Picks one out and frames the 2D view on it, the way pressing a rule's row frames a fault.</summary>
    private async Task goToDifference(int at)
    {
        if (comparison is null || at < 0 || at >= comparison.Differences.Count)
            return;

        differenceAt = at;

        drawDifferences();

        if (viewer is Viewer2DSvg drawing)
            await drawing.FrameOn(comparison.Differences[at].Bounds);
    }

    private void clearCompare()
    {
        otherFile = null;
        otherName = "";
        comparison = null;
        compareWaiting = "";
        compareMarkers = "";
    }

    ///<summary>A comparison that no longer describes this file comes off, with the other file kept to compare again.</summary>
    private void staleComparison(string why)
    {
        if (comparison is null)
            return;

        comparison = null;
        compareMarkers = "";
        compareWaiting = why;
    }

    private void changeCompareIgnore(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double microns) && microns >= 0)
            compareIgnoreMicrons = microns;
    }

    ///<summary>The one line that says what the comparison came to.</summary>
    private string compareSentence()
    {
        if (comparison is null)
            return "";

        if (comparison.Same)
            return $"The same as {otherName} on all {comparison.Compared.Count} layer(s).";

        int here = comparison.Differences.Count(difference => difference.Side == DifferenceSide.OnlyHere);
        int there = comparison.Differences.Count - here;
        int layers = comparison.Differences.Select(difference => difference.Layer).Distinct().Count();

        return $"{comparison.Differences.Count} difference(s) on {layers} of {comparison.Compared.Count} layer(s): {here} only in this file, {there} only in {otherName}.";
    }

    private string layerNameOf(LayerKey key)
    {
        if (gds is not null && gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return layer.DisplayName;

        if (otherFile is not null && otherFile.AdditionalInformation.Layers.TryGetValue(key, out var theirs))
            return theirs.DisplayName;

        return key.ToString();
    }

    private string describeDifference(Difference difference)
    {
        string side = "only in this file";

        if (difference.Side == DifferenceSide.OnlyThere)
            side = "only in " + otherName;

        double microns = micronsPerUnit();
        var at = difference.Bounds;

        //Rounded to a ten-thousandth of a micron, which is past any grid a file is drawn on - a unit times a
        //micron a unit is a double, and 0.005 written out in full is 0.0050000000000000001.
        return FormattableString.Invariant($"{layerNameOf(difference.Layer)}: {side}, {difference.Area * microns * microns:0.####} µm² at {at.Left * microns:0.####}, {at.Bottom * microns:0.####} µm");
    }

    private sealed record CompareRow(string Layer, string Name, string Counts, int First);

    ///<summary>A row for each layer that differs: how many each way, and where its first difference is.</summary>
    private List<CompareRow> compareRows()
    {
        var rows = new List<CompareRow>();

        if (comparison is null)
            return rows;

        for (int i = 0; i < comparison.Differences.Count; i++)
        {
            var layer = comparison.Differences[i].Layer;

            if (rows.Count > 0 && rows[^1].Layer == layer.ToString())
                continue;

            int here = comparison.Differences.Count(difference => difference.Layer == layer && difference.Side == DifferenceSide.OnlyHere);
            int there = comparison.Differences.Count(difference => difference.Layer == layer && difference.Side == DifferenceSide.OnlyThere);

            rows.Add(new CompareRow(layer.ToString(), layerNameOf(layer), $"{here} here · {there} there", i));
        }

        return rows;
    }

