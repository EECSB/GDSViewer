                Layers = ruleLayers,
                Guide = async () => deckGuide ??= await httpClient.GetStringAsync("resources/WRITING-A-DECK.md"),
                Replace = replaceRules,
                Layermap = () => pdkLayers(rulesPdk()),
                LayermapGuide = async () => layermapGuide ??= await httpClient.GetStringAsync("resources/WRITING-A-LAYERMAP.md"),
                ReplaceLayers = replaceLayers
            };

            return ruleBookMade;
        }
