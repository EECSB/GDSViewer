    ///
    ///How strongly the pictures beside the Examples and History lists are drawn: solid enough to read as a shape at
    ///thumbnail size, where the view's own 0.5 goes to mush.
    ///
    ///Every layer, whatever the sidebar has switched off, and no labels: a picture answers "what is this file" rather
    ///than showing the state of the view, and at a couple of hundred pixels a label is a smudge. Framed by
    ///<see cref="Preview"/>, in the library, as the cell lists' pictures are.
    ///
    ///**No Y flip**, so it is the same way up as the 2D view. That view draws the format's Y downward, which is upside
    ///down against a layout tool - a long-standing thing recorded under Known gaps. A preview that quietly corrected it
    ///would be the one picture in the app that disagreed with the rest.
    ///
    private const float PreviewOpacity = 0.85f;

    ///<summary>The color to paint a row's swatch, which is simply the layer's own.</summary>
    private string colorOf(LayerKey key)
    {
        if (gds is null || !gds.AdditionalInformation.Layers.TryGetValue(key, out var layer))
            return "#ffffff";

        return layer.Color;
    }

    ///<summary>
    ///Opens the settings beside the gear that was clicked, rather than in the middle of the window.
    ///
    ///Placed from the click's own page coordinates, since the gear is one of a list and the popup has no
    ///other way to know which row it belongs to. Nudged left of the pointer by roughly its own width so it
    ///opens over the layout rather than off the right edge, and clamped so a row near the bottom does not
    ///push it below the fold.
    ///</summary>
    private async Task openLayerSettings(CheckboxItem item, MouseEventArgs e)
    {
        showSettingsFor(item);

        //
        //Against the right-hand edge of the canvas, level with the row it was opened from.
        //
        //**Pinned there rather than placed beside the pointer.** It used to be worked out from the click and
        //only clamped to the edge when that put it over the sidebar, which is nearly always: the gear sits
        //at the end of a layer row, the popup is wider than the row, so subtracting its width from the
        //pointer lands it a long way left - a quarter of the view away from the list it belongs to, with
        //nothing in between. The edge is where it belongs, and the clamp was already computing that
        //position; this just stops treating it as the exception.
        //
        //The view's own right edge is the thing to measure from, and C# does not know it - the sidebar's
        //width follows its contents. One call across for one number, on a gesture that happens a handful of
        //times and already re-renders the page.
        //
        //Six pixels off it, which is a seam rather than a gap.
        //
        double edge = 0;

        try
        {
            edge = await js.InvokeAsync<double>("viewRightEdge");
        }
        catch { }

        //No view to sit against - the state the app opens in - so beside the pointer, as it always was.
        double beside = e.ClientX - PickerWidth - 16;

        if (edge > 0)
            beside = edge - PickerWidth - 6;

        pickerLeft = Math.Max(8, beside);
        pickerTop = Math.Max(8, e.ClientY - 24);
    }

    ///
    ///Points the settings at a layer: the name it is called, and the picker on its color.
    ///
    ///What opening them does before placing them, and all a press on another row does while they are up -
    ///see layerRowPressed. The row is looked up again by its pair rather than taken as pressed: the list is
    ///rebuilt whenever the layer table changes, and a press that lands while a rename is being applied would
    ///otherwise leave the popup editing a row the list no longer holds.
    ///
    private void showSettingsFor(CheckboxItem item)
    {
        pdkSettings = null;
        settingsFor = checkboxItems.FirstOrDefault(each => each.Id == item.Id) ?? item;

        //On the layer's own color, whichever one the last popup was left on: the pattern side is only
        //reachable for a layer that has a pattern, and opening onto a control that half of them do not
        //offer would make the picker point somewhere different depending on the row before.
        colorTarget = ColorTarget.Background;

        //Seeded from the layer, once. After this the picker keeps its own hue and saturation - see
        //pickedColor for why reading them back off the hex on every render will not do.
        pickedColor = HsvColor.FromHex(colorOf(item.Id));

        settingsName = nameOrPair(item.Id);

        //And its texture's picture, out of the store - which takes a moment, so the popup opens without it.
        _ = loadTextureShown();
    }

    ///<summary>Whether the settings are up and showing this row's layer, which lights the row's gear.</summary>
    private bool settingsOpenFor(CheckboxItem item)
    {
        return settingsFor is not null && settingsFor.Id == item.Id;
    }

    private void closeLayerSettings()
    {
        settingsFor = null;
        pdkSettings = null;
    }

    ///
    ///The layer the settings are open on: the open file's, or the one standing in for a PDK's row. What every switch in
    ///the popup reads and changes, so the two are one popup.
    ///
    private Layer? settingsLayer()
    {
        if (pdkSettings is not null)
            return pdkSettings.Layer;

        if (gds is null || settingsFor is null)
            return null;

        if (gds.AdditionalInformation.Layers.TryGetValue(settingsFor.Id, out var layer))
            return layer;

        return null;
    }

    ///<summary>The pair the settings are open on.</summary>
    private LayerKey settingsKey()
    {
        if (pdkSettings is not null)
            return pdkSettings.Pair;

        if (settingsFor is not null)
            return settingsFor.Id;

        return default;
    }

    ///
    ///What every switch in the settings does once it has changed the layer. On a file's layer: the drawing redrawn where
    ///the change is to the picture, the change taken into the PDK in use, and the file saved. On a PDK's row: the row
    ///written back into the PDK, which is laid over the open file again if it is the one in use - see writePdkSettings.
    ///
    private async Task settingsApplied(bool redraw)
    {
        if (pdkSettings is not null)
        {
            await writePdkSettings();

            return;
        }

        if (settingsFor is null)
            return;

        if (redraw)
            await RenderGDS();

        rememberLayer(settingsFor.Id);

        await saveChangedFile();
    }

    ///
    ///Opens the settings on a PDK's row, from the PDK manager - the popup a layer in the sidebar opens, every switch in it,
    ///changing the row rather than the open file's layer: what is chosen goes into the PDK's layermap, and onto the open
    ///file only as the PDK in use is laid over it. Asked for 2026-10-18, in place of the manager's own color picker, which
    ///had nothing else of how a layer is drawn.
    ///
    ///Beside the swatch that was pressed, since the window it came from sits over the middle of the page; to its left
    ///when the right has no room.
    ///
    private async Task openPdkLayerSettings(PdkManager.LayerStyleAsked asked)
    {
        settingsFor = null;
        pdkSettings = new PdkLayerSettings { Pdk = asked.Pdk, Pair = asked.Pair, Layer = pdkRowLayer(asked.Pdk, asked.Pair) };

        colorTarget = ColorTarget.Background;
        pickedColor = HsvColor.FromHex(pdkSettings.Layer.Color);
        settingsName = settingsNameNow();

        _ = loadTextureShown();

        double across = 0;

        try
        {
            var window = await js.InvokeAsync<WindowSize>("windowSize");

            across = window.Width;
        }
        catch { }

        double left = asked.X + 18;

        if (across > 0 && left + PickerWidth + 8 > across)
            left = asked.X - PickerWidth - 18;

        pickerLeft = Math.Max(8, left);
        pickerTop = Math.Max(8, asked.Y - 24);
    }

    ///
    ///A layer standing in for a PDK's row: what the row says, laid on it the way a file's layer takes a layermap - and for
    ///a color the row does not say, the one the open file's layer of that pair has, or the gray a new layer gets.
    ///
    private Layer pdkRowLayer(Pdk pdk, LayerKey pair)
    {
        var layer = new Layer(pair, pdkRowColor(pair), 0);

        LayerNames.Parse(pdkLayers(pdk)).ApplyTo(new Dictionary<LayerKey, Layer> { [pair] = layer });

        return layer;
    }

    private string pdkRowColor(LayerKey pair)
    {
        if (gds is not null && gds.AdditionalInformation.Layers.TryGetValue(pair, out var layer))
            return layer.Color;

        return AdditionalGDSInformation.NewLayerColor;
    }

    ///<summary>The row the settings are open on, made what the layer standing in for it says, and the PDK kept - see pdkEdited.</summary>
    private async Task writePdkSettings()
    {
        if (pdkSettings is not PdkLayerSettings open)
            return;

        var rows = LayerNames.Parse(pdkLayers(open.Pdk));

        rows.SetRow(open.Pair, open.Layer);

        open.Pdk.Layers = rows.Write();

        await pdkEdited(open.Pdk);
    }

    #endregion ***********************************************



    #region Naming a layer from its settings *****************

    ///<summary>
    ///What a layer is called: its name, or the pair it is known by when it has none. What the box holds.
    ///</summary>
    private string nameOrPair(LayerKey key)
    {
        if (gds is not null && gds.AdditionalInformation.Layers.TryGetValue(key, out var layer) && layer.Name is not null)
            return layer.Name;

        return key.ToString();
    }

    private void onSettingsNameInput(ChangeEventArgs e)
    {
        settingsName = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps the name, Escape puts back what it was. Clicking away keeps it too.</summary>
    private async Task onSettingsNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            settingsName = settingsNameNow();

            return;
        }

        if (e.Key == "Enter")
            await commitSettingsName();
    }

    ///<summary>
    ///Applies what is in the box.
    ///
    ///The pair typed back counts as no name, the same as an empty box. The box starts out holding the
    ///pair, so leaving it alone must not name a layer after itself - "65/20" would then be a name, the
    ///row would read "65/20 (65/20)", and the file would count as having a layermap loaded.
    ///</summary>
    private async Task commitSettingsName()
    {
        //A PDK's row takes the name, or loses it, the same way: its pair typed back is no name.
        if (pdkSettings is not null)
        {
            string named = settingsName.Trim();

            if (named.Length == 0 || named == pdkSettings.Pair.ToString())
                pdkSettings.Layer.Name = null;
            else
                pdkSettings.Layer.Name = named;

            await writePdkSettings();

            settingsName = settingsNameNow();

            return;
        }

        if (settingsFor is null)
            return;

        string typed = settingsName.Trim();

        if (typed == settingsFor.Id.ToString())
            typed = "";

        await applyLayerName(settingsFor.Id, typed);

        //Back to whatever the layer is called now, so clearing the box shows the pair rather than nothing.
        settingsName = nameOrPair(settingsFor.Id);
    }

    ///<summary>What the name box holds for the layer the settings are open on: its name, or its pair where it has none.</summary>
    private string settingsNameNow()
    {
        if (pdkSettings is not null)
            return pdkSettings.Layer.Name ?? pdkSettings.Pair.ToString();

        if (settingsFor is not null)
            return nameOrPair(settingsFor.Id);

        return "";
    }

