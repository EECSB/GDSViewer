    #region Methods ******************************************


    ///<summary>
    ///Writes the open file out in whichever format the picker beside the button is on.
    ///
    ///An OASIS file is a GDSII library by the time it reaches here - the reader converts on the way in -
    ///so this is the same conversion in the other direction rather than a special case for files that
    ///arrived one way.
    ///</summary>
    private async Task downloadFile()
    {
        if (gds is null)
        {
            await js.InvokeVoidAsync("alert", "No GDS file loaded. Please upload a file or open an example.");
            return;
        }

        downloadNotice = "";
        downloadRefused = false;

        //Two that are not a file of bytes written here: a picture the browser draws, and a set of masks that
        //asks a question first.
        if (downloadFormat == PngExtension)
        {
            await savePng();

            return;
        }

        if (downloadFormat == MasksChoice)
        {
            await openMasks();

            return;
        }

        byte[] file;
        string extension;

        try
        {
            (file, extension) = writeDownload(gds);
        }
        catch (InvalidDataException refused)
        {
            //
            //**A refusal has to arrive as a message, not as Blazor's error bar.**
            //
            //Nothing here caught anything before, because nothing here threw: the writers took what they
            //were given. An uncaught exception out of an event handler takes the whole app down to a strip
            //of red and a reload - losing the edit that produced the shape it was complaining about.
            //
            //Rarer than it was. A shape too large for one GDSII record is cut into several now rather than
            //refused - see Fracture - so what is left to arrive here is the shape that will not part along
            //either axis, and whatever the writers come to throw later.
            //
            //Into the same line the download notices use, since it is the same question: what happened to
            //the file you just asked for.
            //
            downloadNotice = $"{refused.Message} Saving as OASIS instead has no such limit.";
            downloadRefused = true;

            return;
        }

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + extension, "application/octet-stream", file);

        //A file downloaded is a file finished with for now, so the steps saved since it was last written are
        //written into it. See writeWhole.
        await writeWhole();
    }

    ///<summary>The bytes and the extension for whichever format is chosen. Throws if they cannot be written.</summary>
    private (byte[] File, string Extension) writeDownload(GDS library)
    {
        byte[] file;
        string extension;

        if (downloadFormat == OasisExtension)
        {
            file = OasisWriter.Write(library, out int skipped);
            extension = OasisExtension;

            //A NODE has no OASIS spelling, so it is said out loud rather than quietly missing from the
            //file - which is the kind of thing found much later by whoever opens it.
            if (skipped > 0)
                downloadNotice = $"{skipped} element(s) had no OASIS equivalent and were left out of the download. NODE elements are the usual reason.";
        }
        else if (downloadFormat == DxfExtension)
        {
            file = DxfWriter.Write(library);
            extension = DxfExtension;

            //
            //**Said every time, because it is the one thing about the conversion somebody has to know.**
            //
            //A DXF has no layer numbers - its layers are names - so the pair is written into the name. A
            //mask shop expecting 68/20 receives a layer called L68D20, and a reader that knows the
            //convention takes the numbers back out. Not a warning: nothing is lost. It is a thing to be
            //told before the file is sent on rather than after.
            //
            downloadNotice = "Layers are named L<layer>D<datatype> in the drawing, since DXF has no layer numbers of its own.";
        }
        else if (downloadFormat == SvgExtension)
        {
            file = Encoding.UTF8.GetBytes(svgDocument());
            extension = SvgExtension;
        }
        else
        {
            file = library.Serialize();

            //The name the file came in as, so a .GDS stays a .GDS - but never the OASIS one, since what is
            //written here is a GDSII library and handing it back as .oas is a file every tool refuses.
            extension = CurrentlySelectedFileType;

            if (openedConverted || extension.Length == 0)
                extension = ".gds";
        }

        return (file, extension);
    }

    ///
    ///The file as a picture, for the SVG choice beside the download button.
    ///
    ///**The whole layout, framed to fit** - see Preview.Document - rather than what the 2D view is showing:
    ///this button writes the file, and the camera on the canvas is what keeps the view. It works the same from
    ///the 3D and text views, which have no picture of their own to take.
    ///
    ///What the rows say still holds - a hidden layer is left out and a layer's labels go only where they are
    ///switched on - at the 2D view's opacity when that is the view open, and its default otherwise.
    ///
    private string svgDocument()
    {
        if (gds is null)
            return "";

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        float opacity = DefaultSvgOpacity;

        if (viewer is Viewer2DSvg drawing)
            opacity = drawing.Opacity;

        return Preview.Document(flattened!, CheckboxItem.VisibleLayers(checkboxItems), CheckboxItem.LabeledLayers(checkboxItems), opacity);
    }

    ///<summary>The 2D view's own starting opacity, for a picture written while that view is not the one open.</summary>
    private const float DefaultSvgOpacity = 0.5f;

    ///<summary>What the save button will do, which depends on what the picker beside it is set to.</summary>
    private string downloadTitle()
    {
        if (downloadFormat == PngExtension)
            return "Save a picture of the whole layout, as a PNG";

        if (downloadFormat == MasksChoice)
            return "Save a black and white picture of each layer, for a mask writer - asks the pixel size first";

        return "Save the file as it currently stands, edits included";
    }

    ///
    ///The whole layout as a PNG: the SVG choice's picture, drawn by the browser.
    ///
    ///**The same document the SVG choice writes**, so the two are one picture at two kinds of resolution, and
    ///the browser draws it because the browser is what drew it on screen. See downloadLayoutPng.
    ///
    private async Task savePng()
    {
        string? problem = await js.InvokeAsync<string?>("downloadLayoutPng", CurrentlySelectedFileName + PngExtension, svgDocument(), PngLongestSide);

        if (problem is null)
            return;

        downloadNotice = problem;
        downloadRefused = true;
    }

    #region Masks ********************************************

    ///<summary>Whether the masks' question is showing.</summary>
    private bool masksOpen = false;

    ///<summary>How big one pixel of a mask is, in microns. A micron to start, which is what a lab laser writer resolves.</summary>
    private double maskMicrons = 1;

    ///<summary>Whether shapes come out white on black rather than black on white.</summary>
    private bool maskShapesLight = false;

    private DotNetObjectReference<Viewer>? masksHandle;

    private async Task openMasks()
    {
        masksOpen = !masksOpen;

        if (!masksOpen)
            return;

        masksHandle ??= DotNetObjectReference.Create(this);

        StateHasChanged();

        //Put away by a press anywhere else, the way the settings are. Hung up after the render that puts it
        //in the page, since the listener looks for it by id.
        await Task.Yield();

        await js.InvokeVoidAsync("registerBarMenu", masksHandle, "masksPanel", "downloadGds", nameof(OnMasksDismissed));
    }

    [JSInvokable]
    public void OnMasksDismissed()
    {
        masksOpen = false;

        StateHasChanged();
    }

    private void changeMaskPixel(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double microns) && microns > 0)
            maskMicrons = microns;
    }

    private void changeMaskShapesLight(ChangeEventArgs e)
    {
        maskShapesLight = e.Value is bool light && light;
    }

    ///<summary>How many microns one of the file's units is, or a micron when its UNITS say nothing usable.</summary>
    private double micronsPerUnit()
    {
        return micronsPerUnitOf(gds);
    }

    private static double micronsPerUnitOf(GDS? file)
    {
        return file?.MicronsPerDatabaseUnit ?? 1;
    }

    ///
    ///What a set of masks would be: the shapes on each layer that is showing, and the box round all of them.
    ///
    ///**One box for every layer**, so every bitmap is the same size and the same pixel is the same place on
    ///each - which is what lets a writer expose one layer over another. Labels and lines of no width are left
    ///out: neither is an area, and a mask is nothing but area.
    ///
    private (Bounds Frame, List<(Layer Layer, List<IReadOnlyList<Element.Point>> Shapes)> Layers) maskContents()
    {
        var empty = (Bounds.Empty, new List<(Layer, List<IReadOnlyList<Element.Point>>)>());

        if (gds is null)
            return empty;

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        var visible = CheckboxItem.VisibleLayers(checkboxItems);
        var byLayer = new Dictionary<LayerKey, List<IReadOnlyList<Element.Point>>>();
        var frame = Bounds.Empty;

        foreach (var element in flattened!.Elements)
        {
            if (element.Text is not null || element.IsOpen || !visible.Contains(element.Layer.Key))
                continue;

            if (!byLayer.TryGetValue(element.Layer.Key, out var shapes))
            {
                shapes = new List<IReadOnlyList<Element.Point>>();
                byLayer[element.Layer.Key] = shapes;
            }

            shapes.Add(element.Points);
            frame = frame.Union(element.Box);
        }

        var layers = new List<(Layer, List<IReadOnlyList<Element.Point>>)>();

        foreach (var layer in gds.AdditionalInformation.OrderedLayers())
        {
            if (byLayer.TryGetValue(layer.Key, out var shapes))
                layers.Add((layer.Value, shapes));
        }

        return (frame, layers);
    }

    ///<summary>What Save would write, said before it is pressed: how many files, and how many pixels each.</summary>
    private string masksSize()
    {
        var (frame, layers) = maskContents();

        if (layers.Count == 0)
            return "No layer that is showing has any shapes on it.";

        var (width, height) = MaskBitmaps.SizeOf(frame, maskMicrons / micronsPerUnit());

        return FormattableString.Invariant($"{layers.Count} layer(s), {width:N0} × {height:N0} pixels each.");
    }

    ///
    ///Writes the masks and saves them as one zip.
    ///
    ///Said in the download line afterwards - how many, how big, at what pixel - since a mask set is something
    ///sent to a machine, and the numbers on it are what somebody checks before it is.
    ///
    private async Task saveMasks()
    {
        if (gds is null)
            return;

        var (frame, layers) = maskContents();

        masksOpen = false;
        downloadNotice = "";
        downloadRefused = false;

        if (layers.Count == 0)
        {
            downloadNotice = "No layer that is showing has any shapes on it, so there are no masks to write.";
            downloadRefused = true;

            return;
        }

        double unitsPerPixel = maskMicrons / micronsPerUnit();
        var files = new List<(string Name, byte[] Bytes)>();

        try
        {
            foreach (var (layer, shapes) in layers)
            {
                var bitmap = MaskBitmaps.Rasterize(shapes, frame, unitsPerPixel);

                files.Add((MaskBitmaps.FileNameFor(layer), MaskBitmaps.Png(bitmap, !maskShapesLight, maskMicrons)));
            }
        }
        catch (ArgumentException refused)
        {
            downloadNotice = refused.Message;
            downloadRefused = true;

            return;
        }

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + " masks.zip", "application/zip", MaskBitmaps.Zip(files));

        var (width, height) = MaskBitmaps.SizeOf(frame, unitsPerPixel);

        downloadNotice = FormattableString.Invariant($"{files.Count} mask(s), {width:N0} × {height:N0} pixels at {SvgWriter.FormatNumber(maskMicrons)} µm a pixel, lined up on the same box.");
    }

