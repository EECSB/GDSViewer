    ///a parameter, before it initializes and renders itself, and as an argument every time the shell asks it
    ///to draw. Those two answering differently is how a view comes to flatten for itself while the shell
    ///holds a perfectly good layout - which is what it did until something counted.
    ///
    ///`ReferenceEquals` rather than a flag: the cache is good for the library it was built from and nothing
    ///else, and comparing the object itself cannot be fooled by a file that happens to look the same. Null
    ///after an edit, because the library changed in place and what is held is of the file as it was.
    ///
    private FlattenedLayout? preparedLayout
    {
        get
        {
            if (ReferenceEquals(flattenedFor, gds))
                return flattened;

            return null;
        }
    }

    ///<summary>Which file that layout is of, so a stale one is never handed to a view. See RenderGDS.</summary>
    private GDS? flattenedFor = null;

    ///
    ///What is wrong with what is on screen, in one line, or nothing when it is a whole layout.
    ///
    ///Worked out on demand rather than stored: it depends only on the flattened layout, which is replaced
    ///wholesale, and a stored copy is one more thing to remember to clear.
    ///
    private string layoutNotice()
    {
        if (flattened is null)
            return "";

        var said = new List<string>();

        if (flattened.Stopped)
        {
            said.Add(FormattableString.Invariant(
                $"This layout is larger than this app will draw, so only the first {flattened.Elements.Count:N0} shapes of it are here."));
        }

        if (flattened.DepthLimitReached)
            said.Add("A cell in this file contains itself, so the nesting was cut short.");

        if (flattened.UnresolvedReferences.Count > 0)
        {
            //Named, up to a point. One missing cell is worth naming; forty is a list nobody reads, and the
            //count is the part that matters - it says this is a cell on its own rather than a broken file.
            var names = flattened.UnresolvedReferences.Take(3).ToList();

            string listed = string.Join(", ", names);

            if (flattened.UnresolvedReferences.Count > names.Count)
                listed += FormattableString.Invariant($" and {flattened.UnresolvedReferences.Count - names.Count:N0} more");

            said.Add(FormattableString.Invariant(
                $"{flattened.UnresolvedReferences.Count:N0} cell(s) this file places are not in it, so they are not drawn: {listed}."));
        }

        return string.Join(" ", said);
    }

