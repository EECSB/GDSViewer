    ///rather than another, and somebody who wants the whole window for a layout wants it for the next one
    ///too. It is not the browser's full screen either: that needs a gesture and could not be put back at
    ///all, where this is four rems of padding.
    ///</summary>
    private bool fullScreen = false;

    ///<summary>
