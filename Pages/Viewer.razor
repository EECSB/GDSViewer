    private string? rulesPdkId = null;

    ///<summary>The PDK the assistant's rule tools work on: the one Write with AI was pressed on, while it is there, or the one in use.</summary>
    private Pdk rulesPdk()
    {
        if (rulesPdkId is string id && pdks.Find(id) is Pdk chosen)
            return chosen;

