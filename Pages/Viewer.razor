    #region Design rules ****************************************************************

    ///<summary>
    ///The deck in force, or null when nothing checks the open file.
    ///
    ///Held here rather than in the view for the same reason the layermap is: both are PDK data that the
    ///file cannot carry, both come from the PDK in use, and both outlive whichever view is mounted.
    ///Switching to the 3D view and back should not lose a deck.
    ///</summary>
    private DrcDeck? drcDeck;

    ///<summary>
    ///The deck's own text, kept so a session can carry it back.
    ///
    ///Beside the parsed form rather than rebuilt from it: a deck is written by hand, and a round trip
    ///through the parser would hand back only what this build understood - dropping the comments, the
    ///blank lines and any rule it refused. The file that came back would not be the file that went in, and
    ///a second reload would erode it again.
    ///</summary>
    private string drcDeckText = "";

    ///<summary>
    ///A built-in's starter deck, read now if the read at startup failed - and empty, said so, if it fails again. For
    ///the two things that want it on a press: the deck itself, and the layers it checks for a layout started from
    ///nothing - see startWithPdkLayers.
    ///
    ///Each is served from beside the examples, since it is written for them, and lives there rather than under
    ///OtherResources so that there is one copy of it - a second would be the one that went stale.
    ///</summary>
    private async Task<string> bundledDeckText(Pdk pdk)
    {
        string shipped = shippedRulesOf(pdk);

        if (shipped.Length > 0 || pdk.Shipped is null)
            return shipped;

        try
        {
            shipped = await httpClient.GetStringAsync(pdk.Shipped.RulesPath);

            shippedRules[pdk.Id] = shipped;
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read the bundled deck from {pdk.Shipped.RulesPath}: {ex.Message}");
        }

        return shipped;
    }

    ///
    ///The PDK's rules over a file drawn in the PDK in use - see fileUnderPdk.
    ///
    ///**Every example this app ships is drawn in a built-in**, and opening one to find the rules panel empty made the
    ///visitor go and fetch a file the app was already holding. An upload drawn in the PDK in use is the same file to its
    ///rules, and gets them now; a layout from another process is not checked against them, which is the reason the deck
    ///used to stop at the examples.
    ///
    ///**Never over a deck loaded by hand** - the one that fails on purpose, or one from before decks went to the PDK
    ///manager - which stays for the files after it as it always has, until the rules panel takes it back off: see
    ///backToPdkRules. A deck the PDK put on the last file comes off one it does not check, another process's.
    ///
    private void carryDeckOver()
    {
        //A deck somebody loaded is theirs, whatever opens next.
        if (drcDeck is not null && !deckFromPdk)
            return;

        string rules = pdkRules(pdks.InUse);

        if (!fileUnderPdk || rules.Length == 0)
        {
            if (deckFromPdk)
                dropPdkDeck();

            return;
        }

        if (drcDeck is not null && drcDeckText == rules)
            return;

        var deck = DrcDeck.Parse(rules);

        if (deck.Rules.Count == 0 && deck.Refused.Count == 0)
        {
            if (deckFromPdk)
                dropPdkDeck();

            return;
        }

        drcDeck = deck;
        drcDeckText = rules;
        deckFromPdk = true;

        drcResult = null;
        drcMarkers = "";

        summarizeDrc();
    }

    ///<summary>Takes the PDK's rules off, and what they found with them.</summary>
    private void dropPdkDeck()
    {
        drcDeck = null;
        drcDeckText = "";
        deckFromPdk = false;

        drcResult = null;
        drcMarkers = "";

        summarizeDrc();
    }

    ///<summary>
    ///The deck to carry, which is nothing when it is the PDK's.
    ///
    ///**A deck the app already holds is not worth copying into the session.** It is ten kilobytes, and laid back over
    ///the file by carryDeckOver - so storing it turned a session that was a file *name* into one carrying a file's
    ///worth of text, and a test that pins an unedited example at under 1.5 KB caught it at 5.5. A deck loaded by hand
    ///- the one that fails on purpose - is not the PDK's, and is kept.
    ///</summary>
    private string deckToRemember()
    {
        if (deckFromPdk || shippedRules.ContainsValue(drcDeckText))
            return "";

        return drcDeckText;
    }

    ///
    ///Takes a deck that is not the PDK's off, and puts the PDK's rules back where the PDK checks this file - the rules
    ///panel's way back from the deck that fails on purpose, or from one loaded by hand before decks went to the PDK
    ///manager. What Clear and Example did between them until 2026-10-19, for the one deck neither the PDK manager nor a
    ///file opening takes off: see carryDeckOver.
    ///
    ///**Its switches go with it**, as they went with a deck loaded over another: the PDK's rules start on - see rulesOff.
    ///And with nothing left to check, nothing to check on every edit either.
    ///
    private async Task backToPdkRules()
    {
        drcDeck = null;
        drcDeckText = "";
        deckFromPdk = false;
        rulesOff.Clear();

        drcResult = null;
        drcMarkers = "";

        carryDeckOver();

        summarizeDrc();

        if (drcDeck is null)
            drcContinuous = false;
        else if (drcContinuous)
            await runDrc();

        await saveSession();

        StateHasChanged();
    }

    ///<summary>Whether the PDK in use checks the open file and has rules to check it with - which backToPdkRules then puts on.</summary>
    private bool pdkChecksThisFile()
    {
        return fileUnderPdk && pdkRules(pdks.InUse).Length > 0;
    }

    ///<summary>The line over a deck that is not the PDK's: whose it is not, and what its button does - see backToPdkRules.</summary>
    private string notPdkDeckSaid()
    {
        string name = pdks.InUse.Name;

        if (pdkChecksThisFile())
            return $"A deck loaded by hand, not {name}'s rules.";

        return $"A deck loaded by hand. {name} checks nothing in this file.";
    }

    private string backToPdkLabel()
    {
        if (pdkChecksThisFile())
            return $"Back to {pdks.InUse.Name}'s";

        return "Take it off";
    }

    ///
    ///What the rules panel says with no deck in it: why, and where rules come from now - the PDK manager over the panel.
    ///Short, in a column a layer row wide; how a KLayout report comes in is the PDK manager's information to say.
    ///
    private string noRulesSaid()
    {
        string name = pdks.InUse.Name;

        if (gds is not null && !fileUnderPdk)
            return $"No rules here: this file is not drawn in {name}, the PDK in use. Choose or make another in the PDK manager above.";

        return $"No rules here: {name}, the PDK in use, has none yet. Give it some in the PDK manager above.";
    }

    #region Adding and removing a rule **********************************

    ///<summary>Whether the box for a new rule line is open.</summary>
    private bool addingRule = false;

    private string newRuleLine = "";

    ///<summary>What the parser said about what was typed, shown under the box.</summary>
    private string addRuleProblem = "";

    private void startAddingRule()
    {
        addingRule = true;
        newRuleLine = "";
        addRuleProblem = "";
    }

    private void cancelAddingRule()
    {
        addingRule = false;
        addRuleProblem = "";
    }

    ///<summary>Enter adds and Escape closes, the same as the layer boxes one panel over.</summary>
    private async Task onAddRuleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await addRule();
        else if (e.Key == "Escape")
            cancelAddingRule();
    }

    ///
    ///Adds a rule by adding its line to the deck and reading the deck again.
    ///
    ///**One box holding a line of the deck's own grammar, rather than a form of dropdowns.** A rule is a
    ///check, some layers, a number and a description, and it can also carry `except`, a window and a step -
    ///so a form that covered the grammar would be most of a form builder, and one that did not would be a
    ///panel that quietly cannot express half the decks people write. The grammar is documented, the guide
    ///is a press away in this same panel, and the parser already says exactly what is wrong with a line.
    ///
    ///**Read back as a whole deck rather than appended to the parsed one.** The text is what a deck is -
    ///it is what gets saved, exported and re-read - so a rule that existed only in the parsed list would
    ///vanish the next time anything re-read the text, and a rule referring to a layer the deck derives
    ///would be accepted here and rejected there.
    ///
    private async Task addRule()
    {
        string line = newRuleLine.Trim();

        if (line.Length == 0)
        {
            addRuleProblem = "Type a rule line - the guide above says what one looks like.";

            return;
        }

        string was = drcDeckText;
        string proposed = was;

        if (proposed.Length > 0 && !proposed.EndsWith('\n'))
            proposed += "\n";

        proposed += line + "\n";

        var deck = DrcDeck.Parse(proposed);

        //The parser reports by line, and the line that changed is the one that was added - so a complaint
        //about any other line was already there and is not this rule's fault.
        string? complaint = deck.Problems.FirstOrDefault();

        if (complaint is not null)
        {
            addRuleProblem = complaint;

            return;
        }

        //Understood but not measurable is still a refusal, and one worth showing here rather than letting
        //the rule land in the list as "not measurable" with no explanation of when that happened.
        if (deck.Rules.Count <= (drcDeck?.Rules.Count ?? 0))
        {
            addRuleProblem = deck.Refused.LastOrDefault() ?? "That line added no rule.";

            return;
        }

        await useDeck(deck, proposed);

        addingRule = false;
        addRuleProblem = "";
        newRuleLine = "";
    }

    ///
    ///Takes a rule out by removing its line and reading the deck again.
    ///
    ///By line rather than by id, because a deck may carry the same id twice - and that deck is exactly the
    ///one somebody is in this panel to fix. See DrcRule.Line.
    ///
    private async Task removeRule(DrcRule rule)
    {
        if (drcDeck is null || noEditing || rule.Line <= 0)
            return;

        var lines = drcDeckText.Replace("\r\n", "\n").Split('\n').ToList();

        if (rule.Line > lines.Count)
            return;

        //Asked, the same as taking a layer out - a × at the end of a row is one press from the row itself,
        //and a rule removed by accident is a check that silently stops being made.
        if (!await js.InvokeAsync<bool>("confirm", $"Remove rule {rule.Id}?"))
            return;

        lines.RemoveAt(rule.Line - 1);

        string proposed = string.Join("\n", lines);

        await useDeck(DrcDeck.Parse(proposed), proposed);
    }

    ///
    ///Takes every rule out of the deck: the × of every rule row, at once.
    ///
    ///By taking their lines out and reading the deck again, as removeRule does for one - so the deck's
    ///layers, derivations and comments stay, and the next rule added has the names it needs. Clear is the way
    ///to drop the deck itself. See DrcDeck.WithoutRules.
    ///
    private async Task removeAllRules()
    {
        if (drcDeck is null || noEditing || drcDeck.Rules.Count == 0)
            return;

        int rules = drcDeck.Rules.Count + drcDeck.Refused.Count;

        //Asked, with the count, as removing one rule is.
        if (!await js.InvokeAsync<bool>("confirm", $"Remove all {rules} rule(s) from the deck?"))
            return;

        string proposed = DrcDeck.WithoutRules(drcDeckText);

        rulesOff.Clear();

        await useDeck(DrcDeck.Parse(proposed), proposed);
    }

    ///
    ///Rules switched off: left out of every run, and so out of the marks, the counts and the sentence.
    ///
    ///**By id**, which is what a violation carries back and what survives the deck being read again after a
    ///rule is added, changed or removed - a line number points at a different rule after any of those. Two
    ///rules sharing an id go off together, which is as finely as a run that reports by id can tell them apart.
    ///
    ///Kept while the panel holds the same deck, and in the session. A different deck loaded empties it: its
    ///rules start on, the way a different file's layers start drawn.
    ///
    private HashSet<string> rulesOff = new();

    private bool ruleIsOn(DrcRule rule)
    {
        return !rulesOff.Contains(rule.Id);
    }

    private bool everyRuleOn()
    {
        return drcDeck is null || drcDeck.Rules.All(ruleIsOn);
    }

    ///
    ///Whether a run would measure nothing: a deck with rules in it, every one of them switched off.
    ///
    ///"No violations" is then a claim about nothing at all - see drcSentence, which says so instead.
    ///
    private bool nothingChecked()
    {
        return drcDeck is not null && drcDeck.Rules.Count > 0 && !drcDeck.Rules.Any(ruleIsOn);
    }

    private string allRulesTitle()
    {
        if (everyRuleOn())
            return "Every rule is checked. Click to leave them all out";

        return "Some rules are left out. Click to check every rule";
    }

    ///<summary>One rule's eye.</summary>
    private async Task ruleToggled(DrcRule rule)
    {
        if (!rulesOff.Remove(rule.Id))
            rulesOff.Add(rule.Id);

        await rulesSwitched();
    }

    ///<summary>The header's eye: every rule on while any is off, and every rule off while none is.</summary>
    private async Task allRulesToggled()
    {
        if (drcDeck is null)
            return;

        if (everyRuleOn())
        {
            foreach (var rule in drcDeck.Rules)
                rulesOff.Add(rule.Id);
        }
        else
        {
            rulesOff.Clear();
        }

        await rulesSwitched();
    }

    ///
    ///What a switch does to a result already on screen: the check runs again, so the marks, the counts and
    ///the sentence are about the rules now on. Nothing to redo where nothing has run - the next run reads the
    ///switches.
    ///
    ///**Run again rather than filtered.** Filtering would take a switched-off rule's marks away at no cost,
    ///but a rule switched back on has nothing to show until it has been measured - and a panel that could
    ///take marks away and not put them back would be saying two different things about the same rule.
    ///
    private async Task rulesSwitched()
    {
        if (drcResult is not null && gds is not null)
            await runDrc();

        await saveSession();
    }

    ///<summary>Which rule's settings are open, or null when none are. One at a time.</summary>
    private DrcRule? ruleSettingsFor = null;

    ///<summary>That rule's line as it is being typed, and whatever the parser said about it last.</summary>
    private string ruleSettingsLine = "";
    private string ruleSettingsProblem = "";

    ///<summary>Where the popup sits. Its own pair rather than the layer picker's, so opening one does not
    ///move the other - the two panels are in different sidebars and can both be up.</summary>
    private double ruleSettingsLeft = 0;
    private double ruleSettingsTop = 0;

    ///
    ///Opens one rule's settings, filled from the deck's own text.
    ///
    ///**Read out of the text by line rather than rebuilt from the parsed rule**, for the reason the popup's
    ///own note gives: the line is the rule, and everything a DrcRule holds came from it. Reading it back is
    ///also what makes Apply a no-op when nothing was typed.
    ///
    private async Task openRuleSettings(DrcRule rule, MouseEventArgs e)
    {
        ruleSettingsFor = rule;
        ruleSettingsProblem = "";
        ruleSettingsLine = lineOfRule(rule);

        //Against the right-hand edge of the view, level with the row - the same placement and the same
        //reasoning as openLayerSettings, which that method's own note sets out.
        double edge = 0;

        try
        {
            edge = await js.InvokeAsync<double>("viewRightEdge");
        }
        catch { }

        double beside = e.ClientX - PickerWidth - 16;

        if (edge > 0)
            beside = edge - PickerWidth - 6;

        ruleSettingsLeft = Math.Max(8, beside);
        ruleSettingsTop = Math.Max(8, e.ClientY - 24);
    }

    ///<summary>
    ///The deck line a rule was parsed from, or empty where the deck no longer has one there.
    ///
    ///<see cref="DrcRule.Line"/> is one-based and counted in the text as it was parsed, so this reads the
    ///same text back the same way removeRule does.
    ///</summary>
    private string lineOfRule(DrcRule rule)
    {
        var lines = drcDeckText.Replace("\r\n", "\n").Split('\n');

        if (rule.Line < 1 || rule.Line > lines.Length)
            return "";

        return lines[rule.Line - 1];
    }

    private void closeRuleSettings()
    {
        ruleSettingsFor = null;
        ruleSettingsProblem = "";
    }

    ///
    ///Applies a typed rule line by putting it back where it came from and reading the whole deck again.
    ///
    ///**The whole deck, not this rule on its own**, which is addRule's reasoning exactly: the text is what a
    ///deck is, so a rule that existed only in the parsed list would vanish the next time anything re-read
    ///the text - and a line naming a layer this deck derives has to be judged against the deck that derives
    ///it rather than against itself.
    ///
    ///**Refused rather than half-applied.** A line the parser complains about, or one that reads as no rule
    ///at all, leaves the deck exactly as it was and says so in the popup - the same two refusals adding a
    ///rule can hit, for the same reasons.
    ///
    private async Task commitRuleSettings()
    {
        if (ruleSettingsFor is not DrcRule rule)
            return;

        string typed = ruleSettingsLine.Trim();

        if (typed.Length == 0)
        {
            ruleSettingsProblem = "A rule needs a line. Use the × on the row to take it out.";

            return;
        }

        var lines = drcDeckText.Replace("\r\n", "\n").Split('\n').ToList();

        if (rule.Line < 1 || rule.Line > lines.Count)
        {
            ruleSettingsProblem = "That rule is no longer where the deck had it. Close this and try again.";

            return;
        }

        //Unchanged is not an edit, and re-reading the deck for it would throw away the results on screen.
        if (lines[rule.Line - 1] == typed)
        {
            closeRuleSettings();

            return;
        }

        lines[rule.Line - 1] = typed;

        string proposed = string.Join("\n", lines);

        var deck = DrcDeck.Parse(proposed);

        //
        //**Complaints about this line only.**
        //
        //A deck can arrive already carrying problems on other lines - that is what the panel is for - so
        //taking the first complaint the way addRule does would blame this edit for a fault it did not make.
        //The parser reports by line, and the line that changed is this one.
        //
        string? complaint = deck.Problems.FirstOrDefault(each => each.Contains($"Line {rule.Line}"));

        if (complaint is not null)
        {
            ruleSettingsProblem = complaint;

            return;
        }

        //Understood but not measurable is still a refusal - see addRule. Counted rather than searched,
        //because a deck may carry the same id twice and this one is edited by line.
        if (deck.Rules.Count < (drcDeck?.Rules.Count ?? 0))
        {
            ruleSettingsProblem = deck.Refused.LastOrDefault() ?? "That line reads as no rule.";

            return;
        }

        await useDeck(deck, proposed);

        closeRuleSettings();
    }

    ///<summary>
    ///Puts a changed deck in place: the parsed form, the text it came from, and everything the last one's
    ///results were about. Shared by adding and removing so the two cannot leave different things behind.
    ///</summary>
    private async Task useDeck(DrcDeck deck, string text)
    {
        drcDeck = deck;
        drcDeckText = text;

        //Into the PDK in use, on a file it checks - see rememberRules.
        rememberRules(text);

        //What the last deck found is not what this one would find - the same reset a loaded deck does.
        drcResult = null;
        drcMarkers = "";

        summarizeDrc();

        //Re-checked where that was asked for, so the markers on screen are about the deck in the panel.
        if (drcContinuous && gds is not null)
            await runDrc();

        await saveSession();

        StateHasChanged();
    }

    #endregion ***********************************************

    ///<summary>
    ///Where the deliberately-failing deck is served from, for seeing what a violation looks like.
    ///</summary>
    private const string StrictDeckPath = "resources/GDS Files/sky130A-strict.drc";

    ///<summary>
    ///Loads a deck the bundled cells cannot satisfy.
    ///
    ///**Because a correct deck over signed-off layout finds nothing**, which is the right answer and a
    ///useless demonstration - somebody trying the feature for the first time gets "no violations" and no
    ///way to tell a working check from a broken one. This one has the same rules with the limits tightened
    ///past what the layout is, so every marker, count and color has something to show.
    ///</summary>
    private async Task loadStrictDeck()
    {
        string text;

        try
        {
            text = await httpClient.GetStringAsync(StrictDeckPath);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read the demonstration deck from {StrictDeckPath}: {ex.Message}");

            return;
        }

        var deck = DrcDeck.Parse(text);

        if (deck.Rules.Count == 0)
            return;

        drcDeck = deck;
        drcDeckText = text;

        //A demonstration, loaded by hand, and not a PDK's rules: the PDK in use keeps its own.
        deckFromPdk = false;

        //A different deck, so its rules start on - see rulesOff.
        rulesOff.Clear();

        drcResult = null;
        drcMarkers = "";

        summarizeDrc();

        //Asked for from the PDK manager's information on rules, so put away, with the rules panel up where the deck is.
        closePdkManager();
        showSidebarPanel(SidebarPanel.Rules);

        await saveSession();

        StateHasChanged();
    }

    ///<summary>
    ///Puts a stored deck back, quietly.
    ///
    ///No message and no alert, unlike picking one from the dialog: this happens while the page is loading,
    ///for something the visitor chose on a previous visit and has not asked about now. A deck that no
    ///longer parses is dropped rather than reported, the way a stored layermap that no longer applies is.
    ///</summary>
    private void restoreDeck(string text)
    {
        if (text.Length == 0)
            return;

        var deck = DrcDeck.Parse(text);

        if (deck.Rules.Count == 0 && deck.Refused.Count == 0)
            return;

        drcDeckText = text;
        drcDeck = deck;

        //A session keeps only a deck loaded by hand - see deckToRemember.
        deckFromPdk = false;
    }

    ///<summary>What the last check found, or null when none has been run since the deck was loaded.</summary>
    private DrcResult? drcResult;

    ///<summary>The markers as markup, handed to the 2D view. Empty when there is nothing to draw.</summary>
    private string drcMarkers = "";

    ///
    ///Runs the deck over what is open.
    ///
    ///On the prepared layout where there is one: the shell already holds one after a file opens, and
    ///resolving the hierarchy is the expensive part of that. See GdsFlattener.Flattens, which exists to
    ///catch exactly this kind of quiet second walk.
    ///
    ///**Where there is not one, it works one out rather than doing nothing.** An edit drops the shell's copy
    ///- the library is changed in place, so what is held is of the file as it was, and RenderGDS hands the
    ///view a null that means "work it out for yourself". This read the same null as "nothing to check" and
    ///returned, which made **DRC Check a button that did nothing from the first edit onward** - and took
    ///"check on every edit" down with it, since that comes through here too. Silent both times: no marks, no
    ///message, and a deck listed above saying the rules were loaded.
    ///
    ///Worked out here and kept, because the next edit nulls it again - onFileEdited is the one funnel every
    ///edit passes through, so a layout cached here cannot outlive the file it was taken from.
    ///
    ///
    ///DRC Check, pressed - or the palette's. **In the text view what has been typed is saved first**: the rules are
    ///checked on the file, which typing has not reached until it is saved. Text that cannot be read checks nothing,
    ///and the strip under the editor says which line.
    ///
    ///**Not inside runDrc**, which a save itself comes back through when "check on every edit" is on: there the editor has
    ///not been handed the saved text yet, so it would look typed in again and be saved again, and again. And not run
    ///twice either - a save with that switch on has checked the file already.
    ///
    private async Task checkRules()
    {
        long before = fileVersion;

        if (!await saveTextFirst())
            return;

        if (fileVersion != before && drcContinuous)
            return;

        await runDrc();
    }

    private async Task runDrc()
    {
        if (drcDeck is null || gds is null)
            return;

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        drcResult = Drc.Check(drcDeck, flattened!, rulesOff);

        //A new run, so nothing in it is stepped to yet. Its waived faults are found by what they are - see waived.
        drcAt = -1;

        summarizeDrc();
        drawDrc();

        StateHasChanged();

        await Task.CompletedTask;
    }

    ///<summary>
    ///What the Check button will do, which is worth saying before it is pressed.
    ///
    ///It says what the press *does* as well as what it will run, because "Check against 30 rules" tells
    ///somebody who already knows what a check is nothing they did not know.
    ///
    ///The same sentence with the switch on, because the press does the same thing. It used to say "nothing
    ///to press" and the button was disabled to match - see the markup for why both went.
    ///</summary>
    private string drcDeckDescription()
    {
        if (drcDeck is null)
            return "";

        var said = new StringBuilder();

        int off = drcDeck.Rules.Count(rule => !ruleIsOn(rule));

        if (off == 0)
            said.Append($"Measure the layout against all {drcDeck.Rules.Count} rule(s) in the deck and mark on the drawing what fails.");
        else
            said.Append($"Measure the layout against the {drcDeck.Rules.Count - off} rule(s) switched on and mark on the drawing what fails. {off} switched off will not run.");

        if (drcDeck.Refused.Count > 0)
            said.Append($" {drcDeck.Refused.Count} more cannot be measured by this build and will not run.");

        return said.ToString();
    }

    ///<summary>
    ///What the switch beside it does, in both of its positions.
    ///
    ///**The off position needs saying as much as the on one.** What happens to a result when the layout
    ///changes under it is the part nobody would guess: it is taken away rather than left to go stale, so
    ///a marker on screen is always a claim about the layout on screen.
    ///</summary>
    private string drcContinuousDescription()
    {
        if (drcContinuous)
            return "On: the deck is run again after every edit, so the marks always match what is drawn. The button still runs it whenever you press. Turn this off to check only when you do.";

        return "Off: press the button to check. An edit takes the last result off the drawing rather than leaving it out of date. Turn this on to have every edit checked as well.";
    }

    private string? drcDescriptionOf(string ruleId)
    {
        if (drcDeck is null)
            return null;

        foreach (var rule in drcDeck.Rules)
        {
            if (rule.Id == ruleId)
                return rule.Description;
        }

        return null;
    }

    ///<summary>
    ///Where a violation is, in database units.
    ///
    ///A point for an off-grid fault, which has no extent - printing a box for one would be drawing a fact
    ///that is not there.
    ///</summary>
    private static string drcWhere(DrcViolation violation)
    {
        var bounds = violation.Bounds;

        if (violation.Check == DrcCheck.OffGrid)
            return FormattableString.Invariant($"{bounds.Left},{bounds.Bottom}");

        return FormattableString.Invariant($"{bounds.Left},{bounds.Bottom} to {bounds.Right},{bounds.Top}");
    }

    ///
    ///Shows one fault: the 2D view framed on it, or in the text the lines of the shape it is on - see
    ///TextEditor.GoToShape. Nothing in the 3D view, which has no rules panel to step from.
    ///
    private async Task showViolation(DrcViolation violation)
    {
        if (viewer is Viewer2DSvg drawing)
            await drawing.FrameOn(violation.Bounds);
        else if (viewer is TextEditor text)
            await text.GoToShape(violation.Source?.Model, violation.Source?.Structure);
    }

    ///<summary>
    ///Whether every edit is checked, rather than waiting to be asked.
    ///
    ///Off to begin with. A check walks the whole layout, and on a large one that is seconds - which is a
    ///pause after every dragged vertex if it is not asked for. Somebody who wants it says so, and the
    ///Check button steps aside once they have, because with this on there is nothing left for it to do.
    ///</summary>
    private bool drcContinuous;

    private async Task toggleContinuous(ChangeEventArgs e)
    {
        drcContinuous = e.Value is bool on && on;

        //Turned on with a deck already loaded, it owes an answer straight away rather than at the next
        //edit - the switch says the panel is current, and a stale result under it would say otherwise.
        if (drcContinuous)
            await runDrc();
    }

    ///<summary>
    ///Which rules the last run found something under that nobody has waived. Empty when nothing has run.
    ///
    ///A set rather than a walk of the violations per row: a run over a real layout returns thousands, and
    ///the rule list asks this question once per rule on every render.
    ///</summary>
    private HashSet<string> brokenRules = new();

    ///<summary>How many faults a rule accounted for that nobody has waived, for the count beside its row.</summary>
    private Dictionary<string, int> drcCounts = new();

    ///<summary>How many of a rule's faults are waived.</summary>
    private Dictionary<string, int> drcWaivedCounts = new();

    private int countFor(string ruleId)
    {
        if (drcCounts.TryGetValue(ruleId, out int many))
            return many;

        return 0;
    }

    ///<summary>How many faults the last run found that nobody has waived.</summary>
    private int standing()
    {
        return drcCounts.Values.Sum();
    }

    ///<summary>
    ///Each rule's faults, by their place in the run, in the order it found them - what its row steps through.
    ///
    ///**The waived ones too**, since stepping to one is the way to take its waiver back. Not a list in the
    ///sidebar: a rule with four hundred faults under it is not a thing to page through there, and the markers
    ///are drawn on all four hundred. The row walks the view through them, one press at a time.
    ///</summary>
    private Dictionary<string, List<int>> drcSteps = new(StringComparer.Ordinal);

    ///<summary>The fault the view was last taken to, by its place in the run, or -1 before any.</summary>
    private int drcAt = -1;

    ///
    ///The faults somebody has looked at and let stand, by DrcViolation.Key.
    ///
    ///**Kept by what the fault is rather than by its place in the run**, so a run again finds the same faults
    ///waived - and one that has moved, or changed because something beside it did, is a different fault and
    ///comes back to be looked at. Drawn gray, left out of every count, written into the report with KLayout's
    ///own tag, and told to the assistant, which leaves them alone. With the file in the session, and dropped
    ///when a different one opens: a waiver is about a fault in this layout.
    ///
    private HashSet<string> waived = new(StringComparer.Ordinal);

    ///<summary>The run's markers as markup, the waived faults gray and the one stepped to picked out.</summary>
    private void drawDrc()
    {
        if (drcResult is null)
        {
            drcMarkers = "";

            return;
        }

        drcMarkers = SvgWriter.Markers(drcResult.Violations, waived, drcAt);
    }

    ///<summary>The fault the view has been taken to, or null when no row has been stepped into since the run.</summary>
    private DrcViolation? currentFault()
    {
        if (drcResult is null || drcAt < 0 || drcAt >= drcResult.Violations.Count)
            return null;

        return drcResult.Violations[drcAt];
    }

    ///
    ///Takes the view to a rule's next fault, and the first one again after its last.
    ///
    ///**From where the last press left off**, which is what makes the row a way through the rule rather than
    ///a link to the top of it - the walk a report's row takes, for the same reason.
    ///
    private async Task stepRule(string ruleId)
    {
        if (drcResult is null || !drcSteps.TryGetValue(ruleId, out var steps) || steps.Count == 0)
            return;

        int next = 0;
        int at = steps.IndexOf(drcAt);

        if (at >= 0)
            next = (at + 1) % steps.Count;

        drcAt = steps[next];

        drawDrc();

        await showViolation(drcResult.Violations[drcAt]);
    }

    ///<summary>A row's count: how many of its faults stand, or how far through them the view is once a press has gone into it.</summary>
    private string ruleCount(string ruleId)
    {
        if (drcSteps.TryGetValue(ruleId, out var steps))
        {
            int at = steps.IndexOf(drcAt);

            if (at >= 0)
                return $"{at + 1}/{steps.Count}";
        }

        int stands = countFor(ruleId);

        if (stands == 0 && drcWaivedCounts.ContainsKey(ruleId))
            return "waived";

        return stands.ToString(CultureInfo.InvariantCulture);
    }

    ///<summary>What a rule's row says on hover: the rule in words, and once it has found something, what pressing it does.</summary>
    private string ruleTitle(DrcRule rule)
    {
        if (!drcSteps.TryGetValue(rule.Id, out var steps))
            return rule.Description;

        var said = new StringBuilder();

        if (rule.Description.Length > 0)
            said.Append(rule.Description).Append(". ");

        said.Append(counted(steps.Count, "fault", "faults"));

        if (drcWaivedCounts.TryGetValue(rule.Id, out int waivedHere))
            said.Append($", {waivedHere} waived");

        said.Append(". Click to go to the next one");

        return said.ToString();
    }

    ///<summary>The fault in front of the view, in a line: the rule, how far through it, where, and in which cell.</summary>
    private string faultSentence(DrcViolation fault)
    {
        var said = new StringBuilder(fault.RuleId);

        if (drcSteps.TryGetValue(fault.RuleId, out var steps))
            said.Append($" {steps.IndexOf(drcAt) + 1} of {steps.Count}");

        said.Append(" at ").Append(drcWhere(fault));

        if (fault.Source is ElementSource source)
            said.Append(", in ").Append(source.Structure);

        if (waived.Contains(fault.Key))
            said.Append(" · waived");

        return said.ToString();
    }

    ///<summary>Waives the fault in front of the view, or takes its waiver back - and the counts, the notice and the markers with it.</summary>
    private async Task toggleWaiver()
    {
        if (currentFault() is not DrcViolation fault)
            return;

        if (!waived.Remove(fault.Key))
            waived.Add(fault.Key);

        summarizeDrc();
        drawDrc();

        //A waiver is something said about the file, as the eye and the padlock are - so the save that makes a
        //history row of an untouched example, or a waived fault on one was gone with its tab.
        await saveChangedFile();
    }

    ///<summary>What the run found, as the report KLayout's marker browser opens, the faults waived here tagged waived - see DrcReport.Write.</summary>
    private async Task exportRun()
    {
        if (drcResult is null || drcDeck is null || gds is null)
            return;

        string top = Hierarchy.Summarize(gds).Where(cell => cell.IsTop).Select(cell => cell.Name).FirstOrDefault() ?? "";
        string text = DrcReport.Write(drcResult, drcDeck, gds, top, $"{CurrentlySelectedFileName} against its rule deck, from GDS Viewer", waived);

        await js.InvokeVoidAsync("BlazorDownloadFile", CurrentlySelectedFileName + " report.lyrdb", "application/xml", Encoding.UTF8.GetBytes(text));
    }

    ///<summary>
    ///What the run found, said in the view rather than in the panel.
    ///
    ///**Where the drawing hint goes**, and in its shape - because it is the same kind of thing: one line
    ///about what the view is showing you right now, over the drawing it is about. The faults themselves
    ///are the markers; this is the sentence that says how many there are and whether the answer can be
    ///trusted, which is the part a marker cannot say.
    ///
    ///Empty when no run has happened, which is what keeps the banner off the view until it has.
    ///</summary>
    private string drcNotice = "";

    ///<summary>
    ///Whether that notice is bad news, so the view colors it like the markers rather than in the green of a
    ///clean run. The markers' orange is the hints' too now, so what this decides is only whether it is green.
    ///</summary>
    private bool drcNoticeIsFault;

    ///<summary>
    ///Takes the run's message off the drawing and leaves the markers on it.
    ///
    ///Two different things: the sentence says how many faults there are and whether every rule ran, and
    ///the markers say where each one is. Somebody who has read the first still wants the second - so this
    ///closes the message only. An edit, another file or another deck is what takes the marks off.
    ///</summary>
    private void dismissDrcNotice()
    {
        drcNotice = "";
    }

    ///<summary>
    ///Sorts a finished run into what the panel and the view each need from it.
    ///
    ///Once, here, rather than from the render: the rule list asks about every rule and the notice asks
    ///about the whole run, and a run over a real layout has thousands of violations in it.
    ///</summary>
    private void summarizeDrc()
    {
        brokenRules = new HashSet<string>();
        drcCounts = new Dictionary<string, int>();
        drcWaivedCounts = new Dictionary<string, int>();
        drcSteps = new Dictionary<string, List<int>>(StringComparer.Ordinal);

        if (drcResult is not DrcResult found)
        {
            drcAt = -1;
            drcNotice = "";
            drcNoticeIsFault = false;

            return;
        }

        for (int i = 0; i < found.Violations.Count; i++)
        {
            var violation = found.Violations[i];

            //A fault with nothing to draw has nowhere to take the view, so its row does not step to it.
            if (violation.Marker.Count > 0)
            {
                if (!drcSteps.TryGetValue(violation.RuleId, out var steps))
                {
                    steps = new List<int>();
                    drcSteps[violation.RuleId] = steps;
                }

                steps.Add(i);
            }

            if (waived.Contains(violation.Key))
            {
                drcWaivedCounts.TryGetValue(violation.RuleId, out int already);
                drcWaivedCounts[violation.RuleId] = already + 1;

                continue;
            }

            brokenRules.Add(violation.RuleId);

            drcCounts.TryGetValue(violation.RuleId, out int seen);
            drcCounts[violation.RuleId] = seen + 1;
        }

        if (drcAt >= found.Violations.Count)
            drcAt = -1;

        drcNotice = drcSentence(found);
        //Not good news either when nothing was measured, so not the green that says the layout passed.
        drcNoticeIsFault = standing() > 0 || !found.Complete || nothingChecked();
    }

    ///<summary>
    ///The one line the view shows.
    ///
    ///**What did not run is said first, and said even when nothing was found.** A count of faults reads as
    ///an answer, and it is only an answer when every rule actually ran - so "no violations" under a rule
    ///that was skipped would be the one sentence in the app that is not true.
    ///</summary>
    private string drcSentence(DrcResult found)
    {
        var said = new StringBuilder();

        int stands = standing();

        if (nothingChecked())
            said.Append("nothing checked");
        else if (stands == 0)
            said.Append("no violations");
        else if (stands == 1)
            said.Append("1 violation");
        else
            said.Append($"{stands} violations");

        //Said, so a clean answer with faults waived under it does not read as a layout with nothing found.
        int waivedNow = drcWaivedCounts.Values.Sum();

        if (waivedNow > 0)
            said.Append($" · {waivedNow} waived");

        if (brokenRules.Count > 0)
            said.Append($" \u00b7 {string.Join("; ", brokenRules.OrderBy(rule => rule, StringComparer.Ordinal).Select(describeRule))}");

        if (found.Complete)
        {
            //Saying how many were left out, so a clean answer over a deck with rules switched off does not read
            //as the whole deck passing.
            int off = drcDeck!.Rules.Count(rule => !ruleIsOn(rule));

            if (off == 0)
                said.Append($" \u00b7 all {drcDeck.Rules.Count} rule(s) ran");
            else if (off == drcDeck.Rules.Count)
                said.Append($" \u00b7 all {off} rule(s) are switched off");
            else
                said.Append($" \u00b7 all {drcDeck.Rules.Count - off} rule(s) switched on ran, {off} switched off");
        }
        else
            said.Append($" \u00b7 not fully checked: {string.Join("; ", found.NotChecked.Concat(found.NotRun).Concat(found.Problems))}");

        return said.ToString();
    }

    ///
    ///A broken rule, named and then said in words.
    ///
    ///**The description as well as the id**, which is the same sentence the rule's own row shows on hover.
    ///An id like "poly.1a" says which rule without saying what it wanted, and this message is the one place
    ///a run's result is read - so it was naming rules at somebody who then had to go and point at each one
    ///in turn to find out what had actually gone wrong.
    ///
    ///**The first rule carrying that id**, because a deck may hold the same id twice - see removeRule - and
    ///an id is all a violation carries back. A rule with no description of its own falls back to the bare
    ///id rather than trailing a colon with nothing after it.
    ///
    private string describeRule(string id)
    {
        var rule = drcDeck?.Rules.FirstOrDefault(each => each.Id == id);

        if (rule is null || rule.Description.Length == 0)
            return id;

        return $"{id}: {rule.Description}";
    }

    #endregion **************************************************************************

    #region A KLayout report ****************************************************************

    ///<summary>
    ///What another tool found, laid over the layout - KLayout's DRC, usually - or null when there is none.
    ///
    ///**Not kept in the session**, for the reason a run's result is not: it is a finding about one file, and a
    ///chip's can run to megabytes. Opening a different file takes it off. An edit does not, unlike a run's
    ///markers - those are this app's claim about the layout on screen, where a report is what KLayout said
    ///about the file it was given, and that stays what it said.
    ///</summary>
    private DrcReportFile? report;

    ///<summary>The file it came from, which heads its list.</summary>
    private string reportName = "";

    ///<summary>Its markers as markup, handed to the 2D view beside a run's.</summary>
    private string reportMarkers = "";

    ///<summary>The item the view was last taken to, by its place in the report, or -1 before any.</summary>
    private int reportAt = -1;

    ///<summary>The categories whose markers are off the drawing.</summary>
    private HashSet<string> reportHidden = new HashSet<string>(StringComparer.Ordinal);

    ///<summary>Each category's items that draw something, in the report's order - what its row steps through.</summary>
    private Dictionary<string, List<int>> reportSteps = new Dictionary<string, List<int>>(StringComparer.Ordinal);

    ///
    ///How many of a report's items are drawn at once.
    ///
    ///Every marker is an element the browser lays out and paints, and a report from a whole chip can hold more
    ///than a view can carry. Past this the summary says how many are drawn, and the one stepped to is always
    ///drawn whatever the count - see SvgWriter.ReportMarkers.
    ///
    private const int MostReportMarkers = 10_000;

    ///<summary>The largest report read. The ceiling a comparison's file has: a chip's report can be most of one.</summary>
    private const long MaximumReportSize = 512L * 1024 * 1024;

    ///<summary>A report chosen through Open or dropped on the drawing: read whole, and laid over what is open.</summary>
    private async Task openReport(IBrowserFile chosen)
    {
        byte[] bytes;

        try
        {
            using var stream = chosen.OpenReadStream(MaximumReportSize);
            using var held = new MemoryStream();

            await stream.CopyToAsync(held);

            bytes = held.ToArray();
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {chosen.Name}: {ex.Message}");

            return;
        }

        await loadReport(bytes, chosen.Name);
    }

    ///
    ///Lays a report over the layout that is open.
    ///
    ///**Over it rather than in its place**, which is why Open does not take it for a file to open: a report
    ///names a cell and gives coordinates, and is nothing to look at without the layout they are in. Placed on
    ///the shell's flattened layout, whose chains of placements are how a cell the report does not place
    ///itself is found - see DrcReport.Read.
    ///
    private async Task loadReport(byte[] bytes, string name)
    {
        if (gds is null)
            return;

        if (preparedLayout is null)
        {
            flattened = GdsFlattener.Flatten(gds);
            flattenedFor = gds;
        }

        DrcReportFile read;

        try
        {
            read = DrcReport.Read(bytes, gds, flattened!);
        }
        catch (InvalidDataException ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {name}. {ex.Message}");

            return;
        }

        report = read;
        reportName = name;
        reportAt = -1;
        reportHidden.Clear();
        reportSteps = stepsOf(read);

        drawReport();

        drcNotice = $"{name}: {reportSummary()}";
        drcNoticeIsFault = read.Items.Count > 0 || read.Problems.Count > 0 || read.NotChecked.Count > 0;

        //Its list open, so one that came in through Open or a drop shows what it held.
        sidebarAsked = SidebarPanel.Rules;
        layersOpen = true;

        StateHasChanged();
    }

    private static Dictionary<string, List<int>> stepsOf(DrcReportFile read)
    {
        var steps = new Dictionary<string, List<int>>(StringComparer.Ordinal);

        for (int i = 0; i < read.Items.Count; i++)
        {
            var item = read.Items[i];

            if (item.Markers.Count == 0)
                continue;

            if (!steps.TryGetValue(item.Category, out var those))
            {
                those = new List<int>();
                steps[item.Category] = those;
            }

            those.Add(i);
        }

        return steps;
    }

    private void drawReport()
    {
        if (report is null)
        {
            reportMarkers = "";

            return;
        }

        reportMarkers = SvgWriter.ReportMarkers(report.Items, reportHidden, reportAt, MostReportMarkers);
    }

    ///
    ///Takes the view to a category's next item, and the first one again after its last.
    ///
    ///**From where the last press left off**, which is what makes one row a way through a category rather
    ///than a link to the top of it: KLayout's marker browser is a list somebody works down, and this is the
    ///same walk with a row standing in for the list.
    ///
    private async Task stepReport(string category)
    {
        if (report is null || !reportSteps.TryGetValue(category, out var steps) || steps.Count == 0)
            return;

        int next = 0;
        int at = steps.IndexOf(reportAt);

        if (at >= 0)
            next = (at + 1) % steps.Count;

        reportAt = steps[next];

        //Gone to, so wanted on the drawing: a category taken off it comes back.
        reportHidden.Remove(category);

        drawReport();

        if (viewer is Viewer2DSvg drawing)
            await drawing.FrameOn(report.Items[reportAt].Bounds);
    }

    private void toggleReportCategory(string category)
    {
        if (!reportHidden.Remove(category))
            reportHidden.Add(category);

        drawReport();
    }

    private void forgetReport()
    {
        report = null;
        reportName = "";
        reportMarkers = "";
        reportAt = -1;
        reportHidden.Clear();
        reportSteps.Clear();
    }

    ///<summary>The report's ×: off the drawing and out of the panel, with the notice back to what a run said, if one did.</summary>
    private void forgetReportPressed()
    {
        forgetReport();

        summarizeDrc();
    }

    ///<summary>What the report says about itself, for the hover on its name.</summary>
    private string reportTitle()
    {
        if (report is null)
            return "";

        var said = new List<string>();

        if (report.Description.Length > 0)
            said.Add(report.Description);

        if (report.Generator.Length > 0)
            said.Add($"written by {report.Generator}");

        if (report.TopCell.Length > 0)
            said.Add($"about the cell {report.TopCell}");

        return string.Join(", ", said);
    }

    ///<summary>The line under its name: how much is in it, and what could not be drawn.</summary>
    private string reportSummary()
    {
        if (report is null)
            return "";

        var said = new StringBuilder();

        said.Append(counted(report.Items.Count, "item", "items"));
        said.Append(" in ");
        said.Append(counted(report.Categories.Count(category => category.Items > 0), "category", "categories"));

        if (report.Waived > 0)
            said.Append($" · {report.Waived} waived");

        if (report.NotChecked.Count > 0)
            said.Append(" · not fully checked");

        int drawable = reportSteps.Values.Sum(steps => steps.Count);

        if (drawable > MostReportMarkers)
            said.Append($" · the first {MostReportMarkers.ToString("N0", CultureInfo.InvariantCulture)} drawn");

        foreach (string problem in report.Problems)
            said.Append(' ').Append(problem);

        return said.ToString();
    }

    private static string counted(int count, string one, string many)
    {
        if (count == 1)
            return $"1 {one}";

        return $"{count.ToString("N0", CultureInfo.InvariantCulture)} {many}";
    }

    ///<summary>A row's count, or how far through it the view has been taken once a press has gone into it.</summary>
    private string reportCount(DrcReportCategory category)
    {
        if (report is not null
            && reportAt >= 0
            && report.Items[reportAt].Category == category.Name
            && reportSteps.TryGetValue(category.Name, out var steps))
        {
            int at = steps.IndexOf(reportAt);

            if (at >= 0)
                return $"{at + 1}/{steps.Count}";
        }

        return category.Items.ToString(CultureInfo.InvariantCulture);
    }

    private static string reportRowTitle(DrcReportCategory category)
    {
        var said = new StringBuilder();

        if (category.Description.Length > 0)
            said.Append(category.Description).Append(". ");

        said.Append(counted(category.Items, "item", "items"));

        if (category.Waived > 0)
            said.Append($", {category.Waived} waived");

        said.Append(". Click to go to the next one");

        return said.ToString();
    }

    ///<summary>The item the view was taken to, in a line: where it is filed, and anything it says beside where it is.</summary>
    private static string reportItemSentence(DrcReportItem item)
    {
        var said = new StringBuilder();

        said.Append(item.Category).Append(", in ").Append(item.Cell);

        if (item.Waived)
            said.Append(" · waived");

        if (item.Comment.Length > 0)
            said.Append(" · “").Append(item.Comment).Append('”');

        if (item.Notes.Count > 0)
            said.Append(" · ").Append(string.Join("; ", item.Notes.Take(3)));

        return said.ToString();
    }

    #endregion **************************************************************************

    ///
    ///**A layout with nothing drawn yet, started from the PDK's layers**, named, stacked and given their roles by its
    ///layermap, each in a color of its own - so a new layout has layers to draw on, and to check against the PDK's
    ///rules, without a layermap of anybody's own. Asked for 2026-10-17, for sky130; every PDK's since 2026-10-18.
    ///
    ///**Which layers is the PDK's to say** - see Pdk.StartingLayers. For sky130 its drawing layers, the 21 its rules
    ///check, with the 16 pins and labels the layermap names on them, which is where ports and net names go; not the
    ///markers and implants nobody starts a layout on, which are named once a file drawing on them opens. And only on a
    ///press: a new layout is deliberately named after nothing - see newLayout.
    ///
    ///**Their colors are the palette's**, divided over them as over any file's layers, and a reload divides it the same
    ///way - see applyRestoredLayers, which puts the layers with nothing drawn on them back together for that reason.
    ///
    ///**And the ones a layout drawn in the PDK lacks** (2026-11-01, asked for), for the assistant's use_pdk - see
    ///usePdkForAssistant: AddLayers takes only the pairs not there, divides the palette again over the whole list, the gray
    ///of a layer added on its own included, and keeps a color somebody chose. A layout that has every one of them already
    ///is left as it is.
    ///
    private async Task startWithPdkLayers()
    {
        var pdk = pdks.InUse;
        string layers = pdkLayers(pdk);

        if (gds is null || layers.Length == 0)
            return;

        //A built-in's rules are read at start, and read again here if that read failed - see bundledDeckText.
        string rules = pdkRules(pdk);

        if (pdk.BuiltIn && pdk.Rules is null)
            rules = await bundledDeckText(pdk);

        bool hadLayers = gds.AdditionalInformation.Layers.Count > 0;
        int added = gds.AdditionalInformation.AddLayers(pdk.StartingLayers(LayerNames.Parse(layers), DrcDeck.Parse(rules)));

        if (added == 0 && hadLayers)
            return;

        takeUnderPdk();

        //The names, the stack and the roles, through the way every mapping lands - which also restacks and lists them.
        var names = applyLayerMapText(layers, out int applied);

        //And the rules, which check what is drawn on them.
        carryDeckOver();

        await RenderGDS();

        await saveChangedFile();

        await reportLayerMap(names, applied);
    }

    ///<summary>Puts the open file under the PDK in use by hand - see pdkTaken.</summary>
    private void takeUnderPdk()
    {
        pdkTaken = true;
        fileUnderPdk = true;
    }

    ///
    ///Lays a mapping over the open file's layers. The part the ways in share.
    ///
    ///Split out when the address learned to name one: the PDK's mapping a layout starts from and a mapping fetched
    ///from `layermap=` have to land identically, and the drawing and the saving are left to the caller because the two
    ///differ there - a press renders and speaks up straight away, where an embed has a render of its own coming and
    ///nothing to say if it worked.
    ///
    ///**Neither goes into the PDK in use**: the PDK's own is already in it, and the one an address names is the page's,
    ///staying with the files the page opens - see pageLayerMap. A layermap of the visitor's own goes into a PDK, in the
    ///PDK manager, since the layer panel's Import went there (2026-10-19).
    ///
    private LayerNames applyLayerMapText(string text, out int applied)
    {
        var names = LayerNames.Parse(text);

        applied = names.ApplyTo(gds!.AdditionalInformation.Layers);

        //And the stack worked out over the heights it just brought, which is what puts the layers it says
        //nothing about clear of the ones it does. ApplyTo writes heights onto layers; only this reads them
        //back as a stack. See SetStackingOffsets.
        gds!.AdditionalInformation.SetStackingOffsets(layerSpacing());

        //Rebuilt rather than relabeled in place, because the labels are read off the layers themselves.
        getLayers();

        return names;
    }

    ///
    ///Fetches the layermap the address named, and lays it over the open file.
    ///
    ///**Quiet when it works.** Every other way into a layermap is somebody pressing something, so a report
    ///is the answer to what they just did; this one is a page arriving as its author intended, and a modal
    ///over every visitor's first sight of the layout would be the report answering nobody's question.
    ///
    ///**Not quiet when it does not.** A layermap that fails to arrive leaves the layers as bare numbers and
    ///Trace net refusing to work, which looks exactly like the app being broken - so the notice above the
    ///view says what was asked for and what went wrong. In the inline strip rather than an alert, because
    ///this is a thing the page's author has to fix and not a thing the visitor can do anything about.
    ///
    ///CORS is the likely cause and worth naming: a layermap on another host has to be served with a header
    ///allowing this app's origin, exactly as an injected example does.
    ///
    ///**The page's, and never the visitor's own.** Kept for the page as <see cref="pageLayerMap"/>, so an example
    ///opened here afterwards is named from it too - and not remembered as the names that carry: an upload does not
    ///get it, and nothing of it but the file it named comes back on the next visit. It used to be remembered like the
    ///layer panel's Import, which put a link's mapping on every file the visitor opened from then on.
    ///
    private async Task fetchLayerMap()
    {
        if (gds is null || embedding.LayerMap is not string address)
            return;

        byte[] fetched;

        try
        {
            fetched = await httpClient.GetByteArrayAsync(address);
        }
        catch (Exception ex)
        {
            layerMapNotice = $"Could not load the layermap at {address}: {ex.Message}. A layermap on another host has to be served with a header allowing this app's origin.";

            return;
        }

        //
        //**A zip of one, with its pictures in it** - see LayermapPackage - or a CSV, whose pictures are fetched from
        //beside it: the texture column names each from the CSV's own folder, which on a host is the CSV's address.
        //A picture that does not arrive is left out, and its layer drawn without one.
        //
        string text;
        var brought = new Dictionary<string, byte[]>(StringComparer.Ordinal);

        if (LayermapPackage.IsZip(fetched))
        {
            var package = LayermapPackage.Read(fetched);

            if (package is null)
            {
                layerMapNotice = $"The zip at {address} has no layermap in it - a zip of one holds a CSV, and the pictures it names beside it.";

                return;
            }

            text = package.Value.Csv;

            foreach (var file in package.Value.Files)
                brought[file.Key] = file.Value;
        }
        else
        {
            text = Encoding.UTF8.GetString(fetched);

            foreach (string name in LayerNames.Parse(text).Textures.Values.Distinct(StringComparer.Ordinal))
            {
                try
                {
                    brought[name] = await httpClient.GetByteArrayAsync(new Uri(new Uri(address), name));
                }
                catch { }
            }
        }

        pageLayerMap = text;

        var names = applyLayerMapText(text, out int applied);

        var missing = await keepTextures(names, brought);

        if (missing.Count > 0)
            layerMapNotice = $"The layermap at {address} names {string.Join(", ", missing)}, which could not be fetched from beside it, so those layers are drawn in 3D without a texture.";

        //Read but matching nothing is the one failure that is not an error: a mapping usually covers a whole
        //PDK where a file uses a handful of layers. Zero matching, though, means it is for another
        //technology or its columns are the wrong way round - and that is worth saying, because the layers
        //stay as numbers and nothing else explains why.
        if (applied == 0)
            layerMapNotice = layerNamesMessage(names, applied, fileHasLayers(), pdks.InUse.Name, keptInPdk: false);

        await saveChangedFile();
    }

    ///<summary>What went wrong with a layermap the address named, or empty. See fetchLayerMap.</summary>
    private string layerMapNotice = "";

    ///<summary>The layermap the address named, as it arrived, for the rest of the page - see fetchLayerMap. Empty until it has.</summary>
    private string pageLayerMap = "";

    ///
    ///The address's layermap, for a file the page offers: an example, the app's own or one the page brought, as
    ///the bundled mapping is for an example - and not a file somebody uploaded, which could be any technology.
    ///Empty until it has been fetched, and once the address stops naming it.
    ///
    private string pageLayerMapForThisFile()
    {
        if (embedding.LayerMap is null || selectedExample.Length == 0)
            return "";

        return pageLayerMap;
    }

    private void dismissLayerMapNotice()
    {
        layerMapNotice = "";
    }

    ///
    ///Says something about a mapping that has just been applied, when there is something to say.
    ///
    ///**A mapping that worked says nothing.** Its rows land in the panel one line away, named and colored,
    ///which is the whole result - so a dialog reporting it stands between somebody and the thing they asked
    ///for, and has to be dismissed before the layers it is describing can be looked at. Every route in
    ///reports through here, so that was a click in the way of loading a mapping however it was loaded.
    ///
    ///What is left is the two cases the panel cannot show, because in both of them it looks exactly like a
    ///mapping nobody loaded: **nothing matched**, and **a row could not be read**. The same policy
    ///fetchLayerMap already applies to a mapping named by `layermap=`.
    ///
    private async Task reportLayerMap(LayerNames names, int applied)
    {
        if (applied > 0 && names.Problems.Count == 0)
            return;

        await js.InvokeVoidAsync("alert", layerNamesMessage(names, applied, fileHasLayers(), pdks.InUse.Name, pdkLaidOver()));
    }

    ///<summary>
    ///What to say about a mapping. The case worth a real explanation is **none applied**: rows matching
    ///nothing is normal, since a mapping usually covers a whole PDK where a file uses a handful of layers,
    ///but *zero* matching means the mapping is for another technology or its columns are the wrong way
    ///round - and left unexplained that looks like the feature not working.
    ///</summary>
    ///
    ///**Unless the file has no layers at all**, which is a new layout: then the mapping is fine and there was simply
    ///nothing for it to name, and sending somebody to check their technology was the wrong thing to say. That case says
    ///where layers come from instead - see startWithPdkLayers.
    ///
    private static string layerNamesMessage(LayerNames names, int applied, bool fileHasLayers, string pdk, bool keptInPdk)
    {
        var message = new StringBuilder();

        //"Updated" rather than "Named": a row can now set a color or a height without naming anything, so
        //a mapping that lands is not necessarily one that named something.
        if (applied > 0)
            message.Append($"Updated {applied} of this file's layers from {names.Count} row(s).");
        else if (names.Count > 0 && !fileHasLayers && keptInPdk)
            message.Append($"Read {names.Count} row(s) into {pdk}. This file has no layers yet for them to name - a layermap names the layers a file draws on. Add one with Add layer at the foot of the list, and a layer they name comes in named, or start from {pdk}'s layers with the button there.");
        else if (names.Count > 0 && !fileHasLayers)
            message.Append($"Read {names.Count} row(s), but this file has no layers yet for them to name - a layermap names the layers a file draws on. Add one with Add layer at the foot of the list, or start from {pdk}'s layers with the button there.");
        else if (names.Count > 0)
            message.Append($"Read {names.Count} row(s), but none of them match a layer this file uses. Check the mapping is for the right technology, and that the columns are layer,datatype,name.");
        else
            message.Append("No usable rows. Each line should be layer,datatype,name - for example 65,20,diff.drawing. A color, a height and a thickness can follow it.");

        foreach (string problem in names.Problems)
            message.Append("\n").Append(problem);

        return message.ToString();
    }

    ///<summary>Whether the open file has any layer in its list, drawn on or added - a new layout has none.</summary>
    private bool fileHasLayers()
    {
        return gds is not null && gds.AdditionalInformation.Layers.Count > 0;
    }

    #region Labels and colors ********************************

    ///<summary>
    ///Turns one layer's labels on or off. Per layer rather than for the file: which labels are worth
    ///reading depends on the layer, and one switch could only ever be all of them or none.
    ///</summary>
    private async Task labelsToggled(ChangeEventArgs e)
    {
        if (e.Value is not bool selected || settingsFor is null)
            return;

        settingsFor.ShowLabels = selected;

        await RenderGDS();

        await saveChangedFile();
    }

    #region The example list *********************************

    ///<summary>Narrows the list. Everything, in the order the picker had them, when nothing is typed.</summary>
    private void onExampleFilterInput(ChangeEventArgs e)
    {
        exampleFilter = e.Value?.ToString() ?? "";

        rebuildFilteredExamples();
    }

    ///<summary>
    ///Held in a field rather than worked out in the markup: this list is nine hundred long, and the popup
    ///re-renders on every keystroke in the filter box and every step of a pointer down the rows.
    ///</summary>
    private void rebuildFilteredExamples()
    {
        string wanted = exampleFilter.Trim();

        var rows = new List<ExampleRow>();

        //A heading only when something is left under it, so filtering to one sky130 cell does not leave
        //"Test GDS Files" standing over nothing.
        addExampleGroup(rows, InjectedExamplesHeading, embedding.Examples.Select(one => one.Name), wanted);
        addExampleGroup(rows, TestExamplesHeading, new[] { MosfetExample }, wanted);
        addExampleGroup(rows, DesignExamplesHeading, designFiles, wanted);

        foreach (var pdk in pdkExamples)
            addExampleGroup(rows, pdk.DesignsHeading, pdk.Designs, wanted);

        addExampleGroup(rows, Sky130ExamplesHeading, exampleFiles, wanted);

        foreach (var pdk in pdkExamples)
            addExampleGroup(rows, pdk.CellsHeading, pdk.Cells, wanted);

        filteredExamples = rows;

        injectedInList = injectedSignature();
    }

    ///<summary>
    ///What the picker is showing from the address, as one string to compare against.
    ///
    ///The list is built when the manifest arrives, which is before OnParametersSet has read the address -
    ///so an embed that injects files finds them missing from a list that is already built, and has to ask
    ///for it again. Only when they have actually changed, since that runs on every navigation and a
    ///rebuild walks nine hundred names.
    ///</summary>
    private string injectedSignature()
    {
        return string.Join("\n", embedding.Examples.Select(one => $"{one.Name}\t{one.Url}"));
    }

    ///<summary>
    ///Where a row's file is fetched from: the embedder's own address if they named this one, the served
    ///folder otherwise.
    ///
    ///Injected first, so a page that calls its own file "Mosfet" gets its own. The list is theirs.
    ///
    ///**Their address is used whole.** It has already been held to an absolute http or https URL by
    ///InjectedExample - which is the check that matters, since this is one of the two places the app fetches
    ///something the address told it to, a layermap= being the other - and beyond that it is not this side's
    ///business whether the file
    ///is on the embedder's own host. What is their business is CORS: a cross-origin file has to be served
    ///with a header allowing this app's origin, or the browser refuses the read and the row reports it.
    ///</summary>
    private string addressOf(string fileName)
    {
        if (injectedNamed(fileName) is InjectedExample one)
            return one.Url;

        return bundledAddressOf(fileName);
    }

    ///<summary>
    ///Where a file the app lists is fetched from: a design downloaded when opened from its own repository, a sky130 design
    ///from sky130's designs' folder, another built-in's cell from its cells' folder, anything else from sky130's cells'.
    ///The one place that decides, so the picker, a link and a history entry cannot disagree about it.
    ///</summary>
    private string bundledAddressOf(string fileName)
    {
        if (downloadedDesign(fileName) is BundledDesign fetched)
            return fetched.Download;

        if (designFiles.Contains(fileName))
            return $"{DesignFolder}/{fileName}";

        foreach (var pdk in pdkExamples)
        {
            if (pdk.Cells.Contains(fileName))
                return $"{pdk.CellFolder}/{fileName}";
        }

        return $"{ExampleFolder}/{fileName}";
    }

    ///
    ///**The design of this name that is downloaded when it is opened**, or null for one the app ships and anything
    ///else - see BundledDesign.Download. The other built-ins' designs are listed this way (2026-11-02, asked for: "add the link and
    ///the users can click to download it at that point in time instead of having it preloaded"). Opening one fetches
    ///it from its own repository at the commit its credit names; pointing at one waits for a press before fetching
    ///anything - see showPreviewOf.
    ///
    private BundledDesign? downloadedDesign(string fileName)
    {
        if (injectedNamed(fileName) is null && designNamed(fileName) is BundledDesign design && design.Downloaded)
            return design;

        return null;
    }

    ///<summary>The PDK a bundled example is drawn in, by its id: another built-in's for its cells and designs, sky130 for the rest.</summary>
    private string pdkOfBundled(string fileName)
    {
        foreach (var pdk in pdkExamples)
        {
            if (pdk.Designs.Contains(fileName) || pdk.Cells.Contains(fileName))
                return pdk.PdkId;
        }

        return Pdk.Sky130;
    }

    ///<summary>The bundled design of this name, or null for anything else.</summary>
    private BundledDesign? designNamed(string fileName)
    {
        return designs.FirstOrDefault(design => string.Equals(design.File, fileName, StringComparison.Ordinal));
    }

    ///<summary>
    ///What pointing at a row says. A design's file name is its maker's - tt_um_mcs4_cpu - and says little to
    ///anybody else, so a design's row says what it is and whose it is; anything else, its name.
    ///</summary>
    private string exampleTooltip(string fileName)
    {
        if (downloadedDesign(fileName) is BundledDesign fetched)
            return $"{fetched.Title}, by {fetched.Author} - downloaded from GitHub when opened, {GDSViewer.Ai.AiAttachment.Size(fetched.Size)}";

        if (injectedNamed(fileName) is null && designNamed(fileName) is BundledDesign design)
            return $"{design.Title}, by {design.Author}";

        return fileName;
    }

    ///
    ///The design that is open, for its credit under the list, or null when what is open is anything else.
    ///
    ///Off the picker's own record of what is open, the way linkableFile is - and never for a file a page
    ///injected under the same name, which is that page's and not the design.
    ///
    private BundledDesign? openDesign()
    {
        if (selectedExample.Length == 0 || injectedNamed(selectedExample) is not null)
            return null;

        return designNamed(selectedExample);
    }

    ///<summary>
    ///The license a design is published under, as text the app ships beside the files it covers - so the terms
    ///travel with the design, which is what they ask for.
    ///</summary>
    private static string licenseAddress(BundledDesign design)
    {
        return $"resources/GDS%20Files/LICENSE-{design.License}.txt";
    }

    ///<summary>The injected example this name belongs to, or null for a bundled one.</summary>
    private InjectedExample? injectedNamed(string fileName)
    {
        foreach (var one in embedding.Examples)
        {
            if (string.Equals(one.Name, fileName, StringComparison.Ordinal))
                return one;
        }

        return null;
    }

    private static void addExampleGroup(List<ExampleRow> rows, string heading, IEnumerable<string> files, string wanted)
    {
        var matching = files
            .Where(name => wanted.Length == 0 || name.Contains(wanted, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matching.Count == 0)
            return;

        rows.Add(new ExampleRow(heading, true));

        foreach (string name in matching)
            rows.Add(new ExampleRow(name, false));
    }

    ///<summary>
    ///Shows the row being pointed at, after a pause.
    ///
    ///The pause is what makes this affordable. Every distinct file has to be fetched and parsed to be
    ///drawn, and a pointer crossing the list touches dozens of rows on the way to one - so a sweep would
    ///fetch dozens of files to show none of them. Each new row cancels the last one's wait.
    ///</summary>
    private async Task previewOnHover(string fileName)
    {
        if (fileName == previewFor)
            return;

        previewWait?.Cancel();

        var waiting = new CancellationTokenSource();
        previewWait = waiting;

        try
        {
            await Task.Delay(PreviewHoverDelayMs, waiting.Token);
        }
        catch (TaskCanceledException)
        {
            //The pointer moved on. Whichever row it moved to is now the one being waited for.
            return;
        }

        await showPreviewOf(fileName);
    }

    ///<summary>
    ///Empties the frame, for when the pointer leaves either list.
    ///
    ///**It used to put the open file's thumbnail there instead**, on the reasoning that when the pointer
    ///leaves the list the answer is the file that is actually open. What that produced is a popup for
    ///choosing a file whose picture, most of the time, is of the file you already have - and the drawing on
    ///the canvas behind it, shrunk into a box. It reads as though a row is selected when none is, and the
    ///one moment the picture is worth anything is the moment the pointer is on a row, which is exactly when
    ///it is not showing this.
    ///
    ///So the idle state is empty and says what to do. Three things went with the picture: the field holding
    ///it, the pair of methods that deferred building it, and the call on every file open that rebuilt it -
    ///which was a flatten and a full-fidelity SVG build of the whole layout, about half the cost of opening
    ///a large file, for a thumbnail nobody asked for.
    ///
    ///**And this is only ever called by the pointer leaving.** It used to be called on file open as well,
    ///to throw away a thumbnail that had gone stale. With no thumbnail there is nothing stale about a
    ///preview of the row under the pointer, and clearing it there blanked the picture at the exact moment a
    ///row was clicked - which is the moment somebody is looking at it.
    ///</summary>
    private void clearPreview()
    {
        previewWait?.Cancel();

        //And the picture being drawn for the row it left, given up at its next pause - nobody is looking at it now.
        previewPictures.Stop();

        previewFor = "";
        historyPreviewFor = "";
        previewPicture = "";
        previewShownFor = "";
        previewDrawing = false;
        previewWaiting = false;
    }

    ///<summary>Puts a picture in the frame - a PNG's or an SVG's address, or empty for none - as the picture of this file.</summary>
    private void showPicture(string fileName, string picture)
    {
        previewPicture = picture;
        previewShownFor = fileName;
    }

    ///
    ///Whether the file pointed at is waiting for a press on Generate preview - Auto-generate preview is off, and it
    ///has not been drawn. See autoPreview.
    ///
    private bool previewWaiting = false;

    ///
    ///The pointer off either list. With previews drawing themselves the frame empties, for the reason clearPreview
    ///gives; **waiting for a press it keeps the file last pointed at**, since the press is in the frame beside the list
    ///and the pointer has to leave the list to get there. The popup going takes it with it either way.
    ///
    private void listLeft()
    {
        if (!autoPreview || previewWaiting)
            return;

        clearPreview();
    }

    ///<summary>What Generate preview says: that it draws the file - and for a design downloaded when opened, that it downloads it first.</summary>
    private string previewGenerateSays()
    {
        if (downloadedDesign(previewFor) is BundledDesign fetched)
            return $"Download {GDSViewer.Ai.AiAttachment.Size(fetched.Size)} and preview";

        return "Generate preview";
    }

    private string previewGenerateTitle()
    {
        if (downloadedDesign(previewFor) is not null)
            return $"Download {previewFor} from GitHub, and draw it here";

        return $"Draw {previewFor}";
    }

    ///<summary>Generate preview, pressed: the file waiting in whichever list it was pointed at in, drawn now.</summary>
    private async Task generatePreview()
    {
        if (historyPreviewFor.Length > 0)
            await showHistoryPreviewOf(historyPreviewFor, asked: true);
        else if (previewFor.Length > 0)
            await showPreviewOf(previewFor, asked: true);
    }

    ///<summary>
    ///Fetches and draws one example, without disturbing what is open.
    ///
    ///Its own GDS rather than the shell's: this is a look at a file, not a load of one, so nothing here
    ///touches the layer list, the views, the address or the session.
    ///</summary>
    ///
    ///**At a pace, given up when the pointer moves on, and as a picture** - see PreviewPictures, which says why each.
    ///The fetch is given up with the rest: on the site, a design is megabytes to download for a row the pointer has
    ///already left. The big designs are kept for the next visit as well - see PreviewStore - and looked for there
    ///before anything is read.
    ///
    private async Task showPreviewOf(string fileName, bool asked = false)
    {
        previewFor = fileName;
        previewWaiting = false;

        if (previewPictures.TryGet(fileName, out string kept))
        {
            previewPictures.Stop();
            previewDrawing = false;

            showPicture(fileName, kept);

            return;
        }

        //Drawn only when asked for, with Auto-generate preview off - see autoPreview. One already drawn is shown. And
        //always so for a design downloaded when opened: a pointer crossing the list would otherwise fetch megabytes
        //from GitHub for rows nobody chose.
        if ((!autoPreview || downloadedDesign(fileName) is not null) && !asked)
        {
            previewPictures.Stop();
            previewDrawing = false;

            showPicture("", "");
            previewWaiting = true;

            StateHasChanged();

            return;
        }

        previewDrawing = true;

        StateHasChanged();

        var pixels = await PreviewPictures.PixelsFor(js, ".examplePreviewFrame");

        //Closed while the frame was measured - the row chosen, or the pointer gone - or another row pointed at, which
        //draws its own: either way there is nothing to begin here.
        if (!showExamples || previewFor != fileName)
            return;

        var pacer = previewPictures.Begin();
        string picture;
        string stored = "";
        int drawn = 0;

        try
        {
            byte[] bytes = await httpClient.GetByteArrayAsync(addressOf(fileName), pacer.Token);

            stored = PreviewStore.KeyFor(fileName, bytes);

            if (await previewStore.GetAsync(stored) is string found)
                picture = found;
            else
            {
                var file = await exampleFromBytesAsync(bytes, pacer.Pause);
                var layout = await GdsFlattener.FlattenAsync(file, pacer.Pause);

                drawn = layout.Elements.Count;
                picture = await PreviewPictures.PictureAsync(layout, pixels, PreviewOpacity, pacer);
            }
        }
        catch (OperationCanceledException)
        {
            //Given up: the pointer settled on another row, or left, or the popup went - and whichever it was has its
            //own picture to draw, or none. Closing the popup gives it up too, which is what stops a row pressed while
            //its picture was being drawn from drawing it on under the load the press began.
            previewDrawing = previewPictures.Drawing;

            return;
        }
        catch
        {
            //A file that will not fetch or will not parse costs its picture, not the popup. The list is still usable,
            //and choosing the row still reports properly through the path that opens it.
            picture = "";
        }
        finally
        {
            previewPictures.End(pacer);
        }

        previewPictures.Keep(fileName, picture);

        //Only if the pointer is still on this row: the walk let the page in as it went, and the pointer may have left.
        if (previewFor == fileName)
        {
            previewDrawing = false;

            showPicture(fileName, picture);

            StateHasChanged();
        }

        //Kept for the next visit once it is on screen, if it was costly enough to be worth keeping - see PreviewStore. Never
        //markup, which a small layout is drawn as and which is no cost to draw again.
        if (drawn >= PreviewStore.WorthKeeping && picture.StartsWith(PreviewPictures.PngAddress, StringComparison.Ordinal))
            await previewStore.SetAsync(stored, picture);
    }

    #endregion ***********************************************



    #region The history list *********************************

    ///<summary>
    ///Opens the History popup on what the store actually holds.
    ///
    ///Re-read rather than trusted, because the list in hand is only as current as the last save this tab
    ///made - and a second tab of the same app has been writing to the same store all along.
    ///</summary>
    ///
    ///Opens the history list, from a press or from the pointer arriving.
    ///
    ///Both, rather than one or the other. Hovering is how it is meant to be used and is what makes the
    ///list cost nothing to glance at; a press is what a touchscreen has instead, and there is no harm in
    ///a control that answers to both when the answer is the same.
    ///
    ///Already open is not a change, which matters here: the pointer crossing the button on its way
    ///somewhere else would otherwise re-read the store and redraw the preview on every pass.
    ///
    private async Task openHistory()
    {
        if (showHistory)
            return;

        historyEntries = await history.ListAsync();

        showExamples = false;
        showHistory = true;

        //Empty until a row is pointed at, the same as the Examples popup opens.
        clearPreview();
    }

    ///<summary>The same for the bundled ones, which need no store read to list.</summary>
    private void openExamples()
    {
        if (showExamples)
            return;

        showHistory = false;
        showExamples = true;

        clearPreview();
    }

    ///
    ///And both go when the pointer leaves the two buttons and whichever list is hanging off them.
    ///
    ///One handler on the column rather than one per list: an absolutely positioned list is still a
    ///descendant of it, so crossing from a button onto a list - or from one button to the other - never
    ///leaves the host, and the list does not flicker on the way.
    ///
    ///<remarks id="closeOnChoice">
    ///**And when a file is chosen out of one**, which is a reversal worth writing down because the other way
    ///round used to be the point.
    ///
    ///The list stayed up so several cells could be looked at without reopening it each time, and that was
    ///right when clicking a row was how you looked at one. It is not any more. Pointing at a row previews it
    ///without opening anything, which is the looking; and a row that is *chosen* now asks first, so clicking
    ///through a list is a dialog per cell rather than a glance. What is left after a choice is a list nobody
    ///is reading, sitting over the file it just opened.
    ///
    ///**At the moment of the choice, not when the file finishes arriving.** Closing it at the end read
    ///better - the list would survive a file that failed to parse - and it is a race: opening one is a
    ///fetch and a parse, and the name is on screen well before that returns. Reach for the list again in
    ///that window and it opens, then the tail of the previous choice runs and shuts it under you. Three
    ///specs caught it as flakiness, which is what it looks like from outside.
    ///
    ///A question answered with Cancel still returns before this, which is the case worth keeping. An open
    ///that then fails says so with an alert and leaves the list to be reopened, which is a keystroke.
    ///</remarks>
    private void closeLists()
    {
        showExamples = false;
        showHistory = false;

        //
        //**And a preview still waiting on its pause goes with them.** Pointing at a row and then pressing it is
        //how a row is chosen, so the wait for that row's preview is nearly always still running at the press -
        //and it used to run out a moment later, under the load just begun, and draw the whole file a second
        //time for a list nobody could see: sixteen seconds of the RGB mixer on the dev server, holding the page
        //against the Cancel on the load's own note.
        //
        //**So does one being drawn**, which since previews are drawn at a pace is the other half of the same case: a
        //row pressed while its picture is still coming. Given up at its next pause, so the load has the page.
        //
        previewWait?.Cancel();
        previewPictures.Stop();
        previewDrawing = false;
    }

    ///
    ///And a cross on each, for anybody who does not discover the move.
    ///
    ///Closing by leaving is quick once it is known and is nothing at all before then: there is no control
    ///to look for, so the way out has to be found by accident. The same method as above, since what a cross
    ///does and what leaving does are the same thing.
    ///
    private void hideExamples()
    {
        closeLists();
    }

    ///<summary>Narrows the list. Everything, newest first, when nothing is typed.</summary>
    private void onHistoryFilterInput(ChangeEventArgs e)
    {
        historyFilter = e.Value?.ToString() ?? "";
    }

    ///<summary>What a row says when it is pointed at: what it is, and when it was last put here.</summary>
    private static string rowTitle(HistoryEntry entry)
    {
        var title = new StringBuilder(entry.Name);

        if (entry.ExampleName.Length > 0)
            title.Append(" - from the bundled examples");
        else
            title.Append(" - opened from this computer");

        if (DateTime.TryParse(entry.When, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var when))
            title.Append(", last here ").Append(when.ToLocalTime().ToString("f", CultureInfo.CurrentCulture));

        return title.ToString();
    }

    ///<summary>
    ///Shows the history row being pointed at, after the same pause the example list uses and for the same
    ///reason: a pointer crossing the list touches every row on the way to one.
    ///</summary>
    private async Task historyPreviewOnHover(string name)
    {
        if (name == historyPreviewFor)
            return;

        previewWait?.Cancel();

        var waiting = new CancellationTokenSource();
        previewWait = waiting;

        try
        {
            await Task.Delay(PreviewHoverDelayMs, waiting.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await showHistoryPreviewOf(name);
    }

    ///<summary>
    ///Draws one history entry, without disturbing what is open.
    ///
    ///Cached under a key of its own rather than the file's name, because a history entry called
    ///"Mosfet.gds" is somebody's edited copy and the bundled cell of that name is not - and a shared cache
    ///would show whichever of the two was looked at first for both.
    ///</summary>
    private async Task showHistoryPreviewOf(string name, bool asked = false)
    {
        historyPreviewFor = name;
        previewWaiting = false;

        string key = HistoryPreviewPrefix + name;

        if (previewPictures.TryGet(key, out string kept))
        {
            previewPictures.Stop();
            previewDrawing = false;

            showPicture(name, kept);

            return;
        }

        //Drawn only when asked for, with Auto-generate preview off - see showPreviewOf.
        if (!autoPreview && !asked)
        {
            previewPictures.Stop();
            previewDrawing = false;

            showPicture("", "");
            previewWaiting = true;

            StateHasChanged();

            return;
        }

        previewDrawing = true;

        StateHasChanged();

        //At a pace and given up when the pointer moves on, as an example's is. A payload that was lost or will not parse
        //costs its picture rather than the popup; choosing the row still reports it properly, through the path that
        //opens it.
        var pixels = await PreviewPictures.PixelsFor(js, ".examplePreviewFrame");

        //Closed while the frame was measured, or another row pointed at - see showPreviewOf.
        if (!showHistory || historyPreviewFor != name)
            return;

        string? picture = await previewPictures.DrawAsync(
            key,
            async pacer => await GdsFlattener.FlattenAsync(await historyFile(name, pacer), pacer.Pause),
            pixels,
            PreviewOpacity);

        //Given up for another row, or for none.
        if (picture is null)
        {
            previewDrawing = previewPictures.Drawing;

            return;
        }

        //Only if the pointer is still on this row: reading and drawing let the page in, and it may have moved.
        if (historyPreviewFor != name)
            return;

        previewDrawing = false;

        showPicture(name, picture);

        StateHasChanged();
    }

    ///
    ///An example's bytes read as what they are: OASIS in one go, the way its reader reads, and GDSII at the pace given -
    ///see GDS.FromBytesAsync. Every example was GDSII until GF180's Tiny Tapeout designs, which their shuttle keeps as
    ///OASIS alone (2026-11-02).
    ///
    private static async ValueTask<GDS> exampleFromBytesAsync(byte[] bytes, Func<ValueTask> pause)
    {
        if (LayoutFile.FormatOf(bytes) == LayoutFormat.Oasis)
            return OasisReader.Read(bytes);

        return await GDS.FromBytesAsync(bytes, pause);
    }

    ///<summary>
    ///One history entry's file. Its own bytes when it carries them, with the steps saved since they were
    ///written taken again - see SavedSession.Journal - and the bundled example it names when it does not, which
    ///is the same rule the entry was written under.
    ///</summary>
    ///
    ///Read at the pace of the picture it is for, and fetched with its way out - see showHistoryPreviewOf.
    ///
    private async Task<GDS> historyFile(string name, Pacer pacer)
    {
        //Its bytes read and decoded at the picture's pace too: in one go they were the longest pause pointing at a row
        //made - 116 ms on gpiov2. See AppStorage.ReadAtAPaceAsync.
        var session = await history.ReadAsync(name, pacer.Pause);

        if (session is null)
            throw new InvalidDataException($"Nothing stored for {name}.");

        if (!session.CarriesFile)
            return await exampleFromBytesAsync(await httpClient.GetByteArrayAsync(bundledAddressOf(session.ExampleName), pacer.Token), pacer.Pause);

        byte[] written = await session.FileAsync(pacer.Pause);
        var file = await GDS.FromBytesAsync(written, pacer.Pause);

        if (session.Journal is not { Count: > 0 } steps)
            return file;

        //A journal that does not fit is drawn as the file was last written whole, the way opening the row opens it.
        if (session.JournalFits && EditHistory.Replay(file, steps))
            return file;

        return await GDS.FromBytesAsync(written, pacer.Pause);
    }

    ///<summary>
    ///Opens a file out of the history, as it was left.
    ///
    ///The popup stays up afterwards, the way the Examples one does: looking through what you have opened
    ///means coming back to the list.
    ///</summary>
    private async Task openFromHistory(string name)
    {
        //At a pace of its own, since the load's has not begun - a row is read before anything is put aside for it,
        //below. Its bytes are the file, megabytes of it, and read in one go they stopped the page. See historyFile.
        var session = await history.ReadAsync(name, new Pacer().Pause);

        //A row whose payload is gone - a quota that refused the write, or storage cleared underneath the
        //app. Dropped rather than left standing: a row that opens nothing is worse than no row, and it
        //would go on failing every time it was pressed.
        if (session is null)
        {
            await forgetFromHistory(name);

            await js.InvokeVoidAsync("alert", $"\"{name}\" is no longer stored, so it has been removed from the history.");

            return;
        }

        //
        //**After the row is known to be good, and not before.** A row whose payload has gone opens nothing, so
        //the file on screen is not put aside for it - see makeRoomForFile, which gives it a tab of its own
        //unless it gives way to the row.
        //
        //Already open in a tab, the row is that tab: the two are one file, kept current by the same saves.
        //
        if (await switchToKeptFile(name))
        {
            closeLists();

            return;
        }

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        makeRoomForFile();

        //Chosen, so the list has done its job - see closeOnChoice.
        closeLists();

        bool restored;

        //The address does not win here. Choosing a row *is* the deliberate request, so it is the address
        //that gets rewritten to match rather than the other way round.
        try
        {
            restored = await applySavedState(session, addressWins: false, pacer);
        }
        catch (OperationCanceledException)
        {
            readingGivenUp(pacer);

            return;
        }

        if (!restored)
        {
            openFailed();

            endLoad(pacer);

            await js.InvokeVoidAsync("alert", $"\"{name}\" could not be opened. It may have been written by a different version of this app.");

            return;
        }

        //The bytes beside the row are this file now, so its next save need not write them again - unless steps
        //were taken again on them, which makes them the file as it was before those. A row from before the bytes
        //were kept apart had them inside, and nothing is beside it yet.
        if (session.BytesApart && gds is not null && !journalTakenAgain)
            history.HeldBytes(name, new BytesBeside(gds, fileVersion, session.BytesBase));

        addressForRestoredFile();

        historyEntries = await history.ListAsync();
    }

    ///<summary>
    ///Makes the address agree with a file put back out of the history list.
    ///
    ///**The view**, because the row brings back the one it was left in, and OnParametersSet reads the
    ///address's back on every navigation. **And no file**: the address does not follow what is open - see
    ///takeOutOfAddress - and a file= left over from a link that did not open would put that link back in
    ///place of this file on a reload. Inside an iframe the embedder's file= stays, and so does
    ///openedFileSlug, which is what stops it being fetched again over the top of this one.
    ///</summary>
    private void addressForRestoredFile()
    {
        var wanted = new Dictionary<string, object?> { ["view"] = slugOf(view) };

        if (!inIframe)
            wanted["file"] = null;

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(wanted), replace: true);
    }

    ///<summary>Drops one file from the list, its stored state with it.</summary>
    private async Task forgetFromHistory(string name)
    {
        await history.ForgetAsync(name);

        historyEntries = await history.ListAsync();

        //The thumbnail may be of the row that has just gone, and the cached copy of it would be handed
        //straight back if a file of that name were opened again.
        previewPictures.Forget(HistoryPreviewPrefix + name);

        if (historyPreviewFor == name)
            clearPreview();
    }

    ///<summary>
    ///Empties the list, once.
    ///
    ///Asked about first, because it throws away something that cannot be got back, as deleting a PDK does:
    ///an uploaded file's only copy in the browser is the one in here, and a row deleted by a
    ///misplaced click is a file gone. Deleting one row is not asked about - it is one file, named on the
    ///button that does it - but "all of them" is worth a moment.
    ///</summary>
    private async Task clearHistory()
    {
        int count = historyEntries.Count;

        string s = "s";

        if (count == 1)
            s = "";

        string question = $"Forget all {count} file{s} in the history?"
            + "\n\nAny that were opened from your computer are only stored here, so this is the last copy."
            + " The files on your computer are untouched.";

        if (!await js.InvokeAsync<bool>("confirm", question))
            return;

        await history.ClearAsync();

        historyEntries = await history.ListAsync();

        //Nothing left for it to narrow, and a box still holding a name over an empty list reads as though
        //something is being hidden rather than that there is nothing there.
        historyFilter = "";

        //Whatever is on screen stays on screen - this clears a list of files, not the one being looked at.
        //It does mean the open file can earn its row back on the next change, which is right: it is still
        //an uploaded or edited file.
        clearPreview();
    }

    ///<summary>Keeps history thumbnails out of the way of the example ones. See showHistoryPreviewOf.</summary>
    private const string HistoryPreviewPrefix = "history:";

    #endregion ***********************************************



    #region Files in tabs ************************************

    ///
    ///A file open in a tab: what it is called and, while another tab is on screen, the state it was left in.
    ///
    ///**Put away as a session**, the shape a reload and the history list already put a file back from. All the
    ///page holds about a file goes into one - the file as edited and its undo, the layers named and hidden, the
    ///view it was in, the faults waived - and applySavedState is the one road back, so a tab is a third way
    ///down that road rather than a new way of keeping a file.
    ///
    private sealed class OpenTab
    {
        public string Label { get; set; } = "";

        ///<summary>The file as it was left, or null for the tab on screen, whose state is the page's own.</summary>
        public SavedSession? Parked { get; set; }

        ///<summary>Whether the history list keeps this file - somebody changed it or brought it in - so that its row and this tab are one file.</summary>
        public bool InHistory { get; set; }
    }

    ///<summary>The files open, in the order their tabs stand. The one on screen is always among them.</summary>
    private readonly List<OpenTab> tabs = new List<OpenTab> { new OpenTab() };

    ///<summary>Which tab is on screen.</summary>
    private int activeTab = 0;

    ///<summary>Moved on by every change to the tabs, so a save can tell they changed without writing them out to compare. See saveTabs.</summary>
    private int tabsChanged = 0;

    ///<summary>Which change, which tab and which file the tabs were last written at.</summary>
    private string tabsWritten = "";

    ///<summary>Where the tabs are kept between visits - see SavedTabs.</summary>
    private const string TabsStorageKey = "gdsviewer.tabs";

    ///
    ///Whether the file on screen gives its tab up to the next one opened, rather than keeping it: only the
    ///example the app opened for itself, untouched.
    ///
    ///**Opening a file closes nothing.** Opening one over another used to ask, every time and whether or not
    ///anything had been changed, because the point was to know that the file on screen was about to go. With
    ///tabs it does not go - it keeps its tab, and closing one is its own press on the cross. The one exception
    ///is the file nobody chose: the app opens an example when there is nothing to come back to, and a first
    ///file put beside it would be a tab of something the visitor never asked for. See mayOfferImport, which
    ///draws the same line for its own question.
    ///
    private bool activeTabGivesWay()
    {
        return openedItself && !fileEdited;
    }

    ///
    ///The file on screen as it was when an open began, to go into its own tab once the new file is in - or null
    ///when it gives way to the new one, or nothing is opening.
    ///
    ///**Taken as the open begins, and used as the file arrives.** Every way in renames what is on screen before
    ///the new file has been read - so a save during the read records the right name - which means that by the
    ///time it is in, the page no longer says what the old one was. And a tab made as the open began would be
    ///wrong the other way: the old file is still the one on screen until the new one lands, and a second open
    ///started in between would put it away a second time under the first one's name.
    ///
    private SavedSession? leaving = null;

    ///<summary>Whether the file put aside is one the history list keeps - see OpenTab.InHistory.</summary>
    private bool leavingInHistory = false;

    ///
    ///Before a file is opened: puts the one on screen aside to go into its own tab, unless it gives way to the
    ///new one - see activeTabGivesWay and fileWentIn.
    ///
    ///**This replaces a question.** Opening a file over one somebody had made their own asked whether to close
    ///it; with tabs it keeps its tab instead, and the question had nothing left to ask about.
    ///
    ///**An open already on its way keeps what it put aside.** The file on screen is still that one, and what the
    ///page says about it may already be the incoming file's.
    ///
    private void makeRoomForFile()
    {
        if (gds is null || leaving is not null || givingWay is not null)
            return;

        //The file that gives way is put aside all the same - not into a tab, but for a cancel to put back. See undoOpen.
        if (activeTabGivesWay())
        {
            givingWay = putAway(gds);

            return;
        }

        leaving = putAway(gds);
        leavingInHistory = fileIsHistoryWorthy;
    }

    ///
    ///The file on screen as an open began, when it is the one that gives way to the new file rather than keeping a
    ///tab - kept only so that a cancel can put it back. See makeRoomForFile and undoOpen.
    ///
    private SavedSession? givingWay = null;

    ///
    ///The new file is in: the one it replaced goes into its tab and the new one gets a tab after it - or, when
    ///the old one gave way, the new one simply has its tab. Called where every way in sets the file.
    ///
    ///And its load is past the point of putting back only what it changed ahead of the file, which is right now -
    ///see beginLoad and putBackAhead - which the note says. See LoadingNote.Refresh.
    ///
    private void fileWentIn()
    {
        fileGoneIn = true;
        undoAhead = null;
        renamingTab = false;

        //A double-click waiting on a tab coming back is kept for it: that is the file going in here. Another file is not.
        if (!restoringState)
            renameWhenOn = -1;

        loadingNote?.Refresh();

        givingWay = null;

        if (leaving is not SavedSession left)
            return;

        leaving = null;

        tabs[activeTab].Parked = left;
        tabs[activeTab].Label = left.FileName + left.FileType;
        tabs[activeTab].InHistory = leavingInHistory;

        tabs.Insert(activeTab + 1, new OpenTab());
        activeTab++;
        tabsChanged++;
    }

    ///<summary>An open that did not arrive: what was put aside for it is let go, and the file on screen keeps its tab.</summary>
    private void openFailed()
    {
        leaving = null;
        givingWay = null;
    }

    ///<summary>Puts the file on screen away into its tab, as a session - see putAway.</summary>
    private void park(int index)
    {
        if (gds is null)
            return;

        tabs[index].Parked = putAway(gds);
        tabs[index].Label = currentLabel();
        tabs[index].InHistory = fileIsHistoryWorthy;
    }

    ///
    ///The file on screen as a session to keep in a tab.
    ///
    ///**The file itself inside it**, rather than beside it as the session saved for a reload keeps it: nothing
    ///else holds a tab's bytes - it is not the session, and not necessarily a history row - and an example
    ///nobody changed carries none, since it is fetched again by name.
    ///
    private SavedSession putAway(GDS file)
    {
        var session = buildSession(file);

        session.FileBytes = sessionFileBytes();
        session.BytesApart = false;

        return session;
    }

    private string currentLabel()
    {
        return CurrentlySelectedFileName + CurrentlySelectedFileType;
    }

    ///<summary>A tab's name: the open file's for the tab on screen, and what each other was called when it was put away.</summary>
    private string tabLabel(int index)
    {
        if (index == activeTab)
            return currentLabel();

        return tabs[index].Label;
    }

    ///<summary>What a tab says on hover: which file, and what a press on it does.</summary>
    private string tabTitle(int index)
    {
        if (index == activeTab)
            return $"{tabLabel(index)}, on screen. Double-click the name to rename it";

        return $"{tabLabel(index)}. Click to put it back on screen, as it was left. Double-click the name to rename it";
    }

    ///<summary>Whether the tab on screen has its name in a box, being renamed - see startRenamingTab.</summary>
    private bool renamingTab = false;

    private string tabRenameText = "";

    ///<summary>Why what is typed cannot be the name, or empty when it can. Said on the box, which turns red.</summary>
    private string tabRenameProblem = "";

    private ElementReference tabRenameBox;

    private bool focusTabRename = false;

    ///<summary>A tab double-clicked while another was on screen: renamed once its own file is - see switchTab.</summary>
    private int renameWhenOn = -1;

    ///<summary>The characters no file name may hold on the systems a download lands on.</summary>
    private static readonly char[] NotInFileNames = { '\\', '/', ':', '*', '?', '"', '<', '>', '|' };

    ///
    ///**A double-click on a tab's name renames its file** (asked for 2026-10-31): the name without its extension, in a
    ///box where it was, Enter or leaving the box keeping what is typed and Esc not. The tab on screen at once; another
    ///once the click that went with the double-click has put it on screen.
    ///
    private void startRenamingTab(int index)
    {
        if (gds is null)
            return;

        //Still coming on screen - the double-click's first click began the switch - so renamed once it is there.
        if (index != activeTab || restoringState)
        {
            renameWhenOn = index;

            return;
        }

        renameWhenOn = -1;
        tabRenameText = CurrentlySelectedFileName;
        tabRenameProblem = "";
        renamingTab = true;
        focusTabRename = true;
    }

    private async Task tabRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await finishRenamingTab();
        else if (e.Key == "Escape")
            renamingTab = false;
    }

    ///<summary>Whether a name is being checked and kept, which a blur on the way is no second request for.</summary>
    private bool tabRenameBusy = false;

    ///<summary>The box left: what is typed is kept if it can be the name, and otherwise the old name stays.</summary>
    private async Task tabRenameLeft()
    {
        if (tabRenameBusy)
            return;

        await finishRenamingTab();

        renamingTab = false;
    }

    private string tabRenameTitle()
    {
        if (tabRenameProblem.Length > 0)
            return tabRenameProblem;

        return "The file's new name. Enter keeps it, Esc puts the old one back";
    }

    ///
    ///Says why a name typed for the file on screen cannot be its name, or null when it can: one with nothing in it,
    ///a character a file name may not hold, or the name of another file - a history row's, which saving under it
    ///would write over, or another tab's, which a history row would then answer for both.
    ///
    private async Task<string?> tabNameProblem(string name)
    {
        if (name.Length == 0)
            return "A file needs a name";

        if (name.IndexOfAny(NotInFileNames) >= 0 || name.Any(char.IsControl))
            return "A file name cannot hold \\ / : * ? \" < > |";

        string label = name + CurrentlySelectedFileType;

        for (int i = 0; i < tabs.Count; i++)
        {
            if (i != activeTab && string.Equals(tabs[i].Label, label, StringComparison.OrdinalIgnoreCase))
                return $"Another tab holds a file called {label}";
        }

        if (await history.ContainsAsync(label))
            return $"The history list already holds a file called {label}. Open or delete that one first, or choose another name";

        return null;
    }

    ///
    ///Renames the file on screen to what was typed: what its tab says, what a download is called, and the row the
    ///history list keeps it under, which moves to the new name - written there first and only then taken from the old,
    ///so a save cut short leaves two rows rather than none. **A renamed file is the person's own**, so an example
    ///renamed carries its bytes from then on, as an edited one does: opened again by the example's name, it would come
    ///back under that name. A name that cannot be keeps the box open, red, saying why; leaving the box then puts the
    ///old name back.
    ///
    private async Task finishRenamingTab()
    {
        if (!renamingTab || tabRenameBusy)
            return;

        tabRenameBusy = true;

        try
        {
            await renameTab();
        }
        finally
        {
            tabRenameBusy = false;
        }
    }

    private async Task renameTab()
    {
        string typed = tabRenameText.Trim().TrimEnd('.', ' ');

        //Typed with its extension, which the box leaves out: the file is still what it was.
        if (CurrentlySelectedFileType.Length > 0 && typed.EndsWith(CurrentlySelectedFileType, StringComparison.OrdinalIgnoreCase))
            typed = typed.Substring(0, typed.Length - CurrentlySelectedFileType.Length).TrimEnd('.', ' ');

        if (gds is null || typed == CurrentlySelectedFileName)
        {
            renamingTab = false;

            return;
        }

        if (await tabNameProblem(typed) is string problem)
        {
            tabRenameProblem = problem;

            return;
        }

        renamingTab = false;

        string was = currentLabel();
        bool hadRow = fileIsHistoryWorthy && await history.ContainsAsync(was);

        CurrentlySelectedFileName = typed;

        if (selectedExample.Length > 0 && !fileEdited)
        {
            fileEdited = true;
            fileVersion++;
            changedOffJournal = true;
        }

        fileIsHistoryWorthy = true;

        await saveSession(whole: true);

        if (hadRow)
            await history.ForgetAsync(was);

        tabsChanged++;

        await saveTabs();
    }

    ///
    ///Goes to the tab already holding a file the history list keeps - one somebody changed or brought in - rather
    ///than opening its row again beside it; true when there is one. An example of the same name the history does
    ///not keep is a different file: the row is the copy that was changed.
    ///
    private async Task<bool> switchToKeptFile(string label)
    {
        if (gds is null)
            return false;

        if (currentLabel() == label && fileIsHistoryWorthy)
            return true;

        for (int i = 0; i < tabs.Count; i++)
        {
            if (i != activeTab && tabs[i].Label == label && tabs[i].InHistory && tabs[i].Parked is not null)
            {
                await switchTab(i);

                return true;
            }
        }

        return false;
    }

    ///
    ///Goes to the tab already holding an example, untouched, rather than opening it again beside itself - true
    ///when there is one. An example somebody has changed is theirs now, and opening the example gets a fresh
    ///copy in a tab of its own.
    ///
    private async Task<bool> switchToExample(string fileName)
    {
        if (gds is null)
            return false;

        if (selectedExample == fileName && !fileEdited)
            return true;

        for (int i = 0; i < tabs.Count; i++)
        {
            if (tabs[i].Parked is SavedSession parked && parked.ExampleName == fileName && parked.FileBytes.Length == 0)
            {
                await switchTab(i);

                return true;
            }
        }

        return false;
    }

    ///
    ///Puts a tab's file on screen, and the one there now away into its own.
    ///
    ///Through applySavedState, the same road a reload and the history list take - so the file comes back as it
    ///was left, undo and all, in the view it was left in. A file that will not come back - an example no longer
    ///served - leaves the one that was on screen there, and says so.
    ///
    private async Task switchTab(int index)
    {
        if (index == activeTab || index < 0 || index >= tabs.Count || gds is null || restoringState)
            return;

        if (tabs[index].Parked is not SavedSession parked)
            return;

        //A name being typed is the tab's that is going: its box does not follow to the next. Nor does a double-click
        //left waiting by a switch that failed - one on this tab comes after this click, and sets it again.
        renamingTab = false;
        renameWhenOn = -1;

        int from = activeTab;

        //Before anything about the page changes, so a cancel knows what to put back - see beginLoad.
        var pacer = beginLoad();

        park(from);

        activeTab = index;
        tabs[index].Parked = null;
        tabsChanged++;

        //
        //Given up before the tab's file is in, the file from the tab this came from is the one still on screen - only
        //the tabs say otherwise, and they go back to saying so: by readingGivenUp for a cancel, and by beginLoad for a
        //load that overtakes this one, before it puts anything away into a tab.
        //
        undoAhead = () =>
        {
            tabs[index].Parked = parked;
            activeTab = from;
            tabs[from].Parked = null;
            tabsChanged++;
        };

        //Given up once the tab's file is in, the tab this came from comes back - rather than the default way back,
        //which closes the tab an open made. See undoLoad.
        undoNext = () => backToTab(index, parked, from);

        bool came;

        try
        {
            came = await applySavedState(parked, addressWins: false, pacer);
        }
        catch (OperationCanceledException)
        {
            //Only for the load in hand: one overtaken, or given up while drawing, has had the page put right already.
            readingGivenUp(pacer);

            return;
        }

        if (came)
        {
            addressForRestoredFile();

            await saveTabs();

            return;
        }

        await backToTab(index, parked, from);

        await js.InvokeVoidAsync("alert", $"{tabs[index].Label} could not be opened again, so its tab is left as it was.");
    }

    ///
    ///The tab a switch came from, back on screen: the one it went to gets its saved state back as it was, and the
    ///file from the other is put back - for a switch that failed, and for one given up once its file was in.
    ///
    private async Task backToTab(int index, SavedSession parked, int from)
    {
        tabs[index].Parked = parked;
        activeTab = from;

        var back = tabs[from].Parked!;

        tabs[from].Parked = null;
        tabsChanged++;

        await putBack(back);
    }

    ///
    ///Closes a tab, and nothing is lost by it: anything somebody changed or brought in is in the history list, and
    ///an example is in the Examples list. So this asks nothing - which is also what opening over a file asks now.
    ///
    ///The tab on screen hands over to the one after it, or the one before when it is the last.
    ///
    private async Task closeTab(int index)
    {
        if (tabs.Count < 2 || index < 0 || index >= tabs.Count || restoringState)
            return;

        if (index == activeTab)
        {
            int next = index + 1;

            if (next >= tabs.Count)
                next = index - 1;

            await switchTab(next);

            //Still on screen: the switch did not happen, and a tab is not closed out from under its own file.
            if (activeTab == index)
                return;
        }

        tabs.RemoveAt(index);

        if (index < activeTab)
            activeTab--;

        tabsChanged++;

        await saveTabs();
    }

    ///
    ///Writes the tabs down, when they or the file on screen have changed since they were last written.
    ///
    ///**Called with every save, and nearly always gone at the first line.** A save follows every pan that comes
    ///to rest, and the tabs hold whole files; so whether to write is asked of a counter and a name rather than
    ///by writing them out to compare. One tab is no tabs, and leaves nothing stored.
    ///
    ///**Not from inside a page that is someone else's**: an embedded viewer opens one file and keeps no tabs, and
    ///it shares its storage with the app - writing its single tab there would close the app's.
    ///
    private async Task saveTabs()
    {
        if (gds is null || viewerOnly || inIframe || restoringState)
            return;

        string at = FormattableString.Invariant($"{tabsChanged}|{activeTab}|{tabs.Count}|{currentLabel()}");

        if (at == tabsWritten)
            return;

        tabsWritten = at;

        if (tabs.Count < 2)
        {
            await storage.RemoveAsync(TabsStorageKey);

            return;
        }

        var saved = new SavedTabs { Active = activeTab };

        for (int i = 0; i < tabs.Count; i++)
            saved.Tabs.Add(new SavedTab { Label = tabLabel(i), InHistory = tabs[i].InHistory, Session = tabs[i].Parked });

        await storage.SetAsync(TabsStorageKey, SavedTabs.Serialize(saved));
    }

    ///<summary>Whether the tabs a last visit left have been put back - once, after the first file is on screen.</summary>
    private bool tabsRestored;

    ///
    ///Puts back the tabs a last visit left, around the file now on screen.
    ///
    ///**That file is the one that was on screen, if a reload brought it back** - the session did, and its tab
    ///goes back where it stood. If something else opened instead - a link names a file, and a link wins - the
    ///tabs are put back all the same and the file the link opened gets a tab after them. The one that was on
    ///screen then is not among them, its state having been the session's; anything in it worth keeping is a
    ///row of the history list.
    ///
    private async Task restoreTabsOnce()
    {
        if (tabsRestored || gds is null || viewerOnly || inIframe)
            return;

        tabsRestored = true;

        if (SavedTabs.Deserialize(await storage.GetAsync(TabsStorageKey)) is not SavedTabs saved)
            return;

        var restored = new List<OpenTab>();
        int onScreen = -1;

        for (int i = 0; i < saved.Tabs.Count; i++)
        {
            var tab = saved.Tabs[i];

            if (tab.Session is SavedSession session)
            {
                restored.Add(new OpenTab { Label = tab.Label, InHistory = tab.InHistory, Parked = session });

                continue;
            }

            if (i == saved.Active && onScreen < 0 && tab.Label == currentLabel())
            {
                onScreen = restored.Count;

                restored.Add(new OpenTab { Label = tab.Label });
            }
        }

        if (onScreen < 0)
        {
            onScreen = restored.Count;

            restored.Add(new OpenTab());
        }

        tabs.Clear();
        tabs.AddRange(restored);
        activeTab = onScreen;
        tabsChanged++;

        //Drawn now: this runs from the save a restore ends on, which no press is waiting to redraw after - so
        //without it the strip waited for the next thing to happen on the page.
        StateHasChanged();
    }

