    ///
    ///A call over the live link, answered on the file open here.
    ///
    ///**The AI assistant's own runner**, so what Claude does through gds mcp is what the assistant would do in the chat: the same
    ///tools, look drawn by this browser, and each change one step on this page's undo, drawn as it lands. Nothing waits
    ///for a press here - the client Claude runs in asks the person before each call, which is the gate, and a second one
    ///in the tab would be two questions about one thing.
    ///
    ///**Shape numbers are for one file and one link.** A new Start, or another file under the tab - one opened, or
    ///another tab of the app's chosen - starts them again, and the answer says so, since a number the model holds would
    ///otherwise name nothing or the wrong shape.
    ///
    ///**The cell the person opens becomes the one the tools work in**, from when they open it, as a message in the AI assistant
    ///does - and until they open another, open_cell from the model stands.
    ///
    private async Task<GDSViewer.Ai.LlmToolOutput> answerLinkCall(string name, string argumentsJson, CancellationToken ct)
    {
        if (gds is null || liveLink is null)
            return new GDSViewer.Ai.LlmToolOutput { Text = "No layout is open in the GDS Viewer tab. Ask the person to open one.", IsError = true };

        if (noEditing)
            return new GDSViewer.Ai.LlmToolOutput { Text = "This GDS Viewer page is read-only, so nothing can be done through it.", IsError = true };

        //In the text view, what has been typed goes into the file first - as it does before the assistant reads
        //the file, see saveTextFirst. Without this a call answered about the file as it was, and a change drawn
        //through the link rewrote the editor over the typing.
        if (!await saveTextFirst())
            return new GDSViewer.Ai.LlmToolOutput { Text = "The text view holds an edit that could not be read back into the file - the editor says what is wrong under it. Ask the person to fix or undo it first.", IsError = true };

        string note = "";

        //A file written from the text view is every record new, so the numbers the model holds name nothing - see
        //onFileRewritten, which puts the session aside, and the note says why the numbers start again.
        if (linkRewritten && linkStarted == liveLink.Started)
            note = "The person saved the file from the text view, so shape numbers start again. ";

        linkRewritten = false;

        if (linkSession is null || !ReferenceEquals(linkSession.Gds, gds) || linkStarted != liveLink.Started)
        {
            if (linkSession is not null && linkStarted == liveLink.Started)
                note = $"The person has {CurrentlySelectedFileName} open now, so shape numbers start again. ";

            linkSession = new AgentSession(gds, editHistory) { HowToLoadRules = "The rules come from the PDK in use: give it some, or put one that has them in use, in GDS Viewer's PDK manager." };
            linkStarted = liveLink.Started;
            linkEditing = null;
        }

        linkSession.Deck = drcDeck;
        linkSession.RulesOff = rulesOff;
        linkSession.Waived = waived;

        string? editing = null;

        if (view == ViewType.View2DSvg && viewer is Viewer2DSvg drawing)
            editing = drawing.EditingContext?.Structure;

        if (editing != linkEditing)
        {
            linkEditing = editing;

            if (editing is not null)
                linkSession.Cell = editing;
        }

        if (name == "describe_tab")
        {
            var facts = await describeForAssistant(linkSession);

            return new GDSViewer.Ai.LlmToolOutput { Text = note + GDSViewer.Ai.LayoutPrompt.Describe(facts) };
        }

        var runner = new GDSViewer.Ai.LayoutToolRunner(linkSession, lookForAssistant) { AllowEdits = true, Changed = linkChanged };
        var output = await runner.RunToolAsync(name, argumentsJson, ct);

        if (note.Length == 0)
            return output;

        return new GDSViewer.Ai.LlmToolOutput { Text = note + output.Text, IsError = output.IsError, Png = output.Png };
    }

    ///<summary>A change over the link landed: drawn, with what it made picked out, as the assistant's are.</summary>
    private async Task linkChanged(AgentResult result)
    {
        var made = new List<GDS.ElementModel>();

        foreach (int id in result.Made)
        {
            if (linkSession?.ShapeNumbered(id) is GDS.ElementModel model)
                made.Add(model);
        }

        await changedOnHistory(made);

        //Called from the link rather than from a press, so the page is told to draw what changed - the undo button's title among it.
        await InvokeAsync(StateHasChanged);
    }

