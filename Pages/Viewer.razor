    ///<summary>This page's handle, for the press anywhere else that puts the drop-down away - see registerBarMenu - and for the palette's key and the page being hidden.</summary>
    private DotNetObjectReference<Viewer>? appSettingsHandle;

    ///
    ///Hangs the settings drop-down on the bar's menus and reads which look the page opened in.
    ///
    ///Once, on the first render. The drop-down is registered by its id, so it is the same entry however often
    ///the bar is drawn - and a press elsewhere with nothing open asks nothing of a menu that is not there.
    ///
    private async Task registerAppSettings()
    {
        appSettingsHandle = DotNetObjectReference.Create(this);

        await js.InvokeVoidAsync("registerBarMenu", appSettingsHandle, "settingsPicker", "settingsMenu", nameof(OnAppSettingsDismissed));

        //And the command palette's key, on the same handle - the palette is the shell's, like the menu.
        if (!viewerOnly)
            await js.InvokeVoidAsync("commandPalette.watch", appSettingsHandle);

        //And the page being hidden, when the open file is written whole. See writeWhole.
        await js.InvokeVoidAsync("gdsExitSave.whenHidden", appSettingsHandle, nameof(OnPageHidden));

        darkMode = await js.InvokeAsync<string>("currentTheme") == "dark";

        //A render of its own when it was left on, since the views are already drawn without the panel.
        debugInfo = await js.InvokeAsync<bool>("frameMeterChosen");

        //And whether previews draw themselves - see autoPreview. On unless it was turned off here.
        autoPreview = await js.InvokeAsync<string?>("gdsLocalStorage.get", AutoPreviewKey) != "off";

        askTour = await askAboutTour();

        if (debugInfo || !autoPreview || askTour)
            StateHasChanged();
    }

