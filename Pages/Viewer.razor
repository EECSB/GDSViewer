    ///<summary>The hue on its own, at full strength - the background the field's two gradients wash out.</summary>
    private string hueColor()
    {
        return new HsvColor(pickedColor.Hue, 1, 1).ToHex();
    }

    ///<summary>A 0-to-1 position as the percentage the marker is placed at.</summary>
    private string percent(double fraction)
    {
        return (fraction * 100).ToString("F2", CultureInfo.InvariantCulture) + "%";
    }

    private async Task fieldPressed(MouseEventArgs e)
    {
        await pickFromField(e);
