    ///frameMeter.js remembers the choice and does the counting; this only decides whether the views put the
    ///panel it writes into on the page. Read off the script on the first render, like the theme.
    ///
    private bool debugInfo = false;

    ///
    ///**Whether a preview draws itself** as soon as a row is pointed at - a cell's in the 2D and 3D views' trees and the
    ///text's list, a file's in History and Examples - or waits for a press on Generate preview. One switch, under each of
    ///the five, remembered in this browser: off is for a file or a machine where a whole cell or chip drawn on every hover
    ///is a pause nobody asked for.
    ///
    private bool autoPreview = true;

    private const string AutoPreviewKey = "gdsviewer.autoPreview";

    ///
    ///Auto-generate preview, ticked or not under any of the four previews - which are all this one switch. Ticked with
    ///a file waiting for its press, that file is drawn now, as it would have been.
    ///
    private async Task autoPreviewChosen(bool on)
    {
        autoPreview = on;

        string kept = "off";

        if (on)
            kept = "on";

        try
        {
            await js.InvokeAsync<bool>("gdsLocalStorage.set", AutoPreviewKey, kept);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            //The setting works for this visit either way; what is lost is the next one's, and a visitor whose storage
            //refuses the app has a console to find out why in.
            Console.WriteLine($"The auto-generate preview setting could not be kept for the next visit: {ex.Message}");
        }

        if (on && previewWaiting)
            await generatePreview();

        StateHasChanged();
    }

