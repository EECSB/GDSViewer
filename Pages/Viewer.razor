    #region Initialization ***********************************

    protected override async Task OnInitializedAsync()
    {
        //Read once here rather than on every file open. It has to be before anything can open a file, and
        //it is: the ?file= path waits on exampleListFetched, which loadExampleFileList sets below.
        await loadStoredLayerNames();

        //The PDKs, before anything can open too: the one in use names and checks what opens. A single read of
        //this app's own storage, so it holds nothing up the way a second fetch would - see the WhenAll below.
        var kept = await pdkStore.LoadAsync();

        pdks = kept ?? PdkList.Fresh();
        pdksKept = kept is not null;

        //
        //**Together, not one after the other.**
        //
        //Each is one same-origin read and none needs another, and awaiting them in sequence put an extra round
        //trip in front of the example list - which is what everything downstream waits on. That moved the app's
        //own fallback open later by exactly that much, into collision with a file dropped in at the same moment:
        //measured, the DXF specs went from stable to five flaky in four runs, and back to stable when this read
        //was taken out. WhenAll costs the slowest of them rather than the sum - and there are four of the
        //built-ins' files since gf180mcu and ihp-sg13g2 shipped beside sky130.
        //
        await Task.WhenAll(loadShippedPdks(), loadExampleFileList());

        await carryIntoPdk();
    }

    ///
    ///The layermaps that ship, read once, so a bundled example arrives named - each built-in's, by its id.
    ///
    ///**Because every example in the picker is drawn in a built-in**, a cell or a design built from one. The app
    ///deliberately compiles no PDK table in - see the note in Known gaps - and that is still right for a file
    ///somebody opens off their own machine, which could be any technology. It was never right for the files
    ///the app itself chose to ship: their processes are known, the mappings for them are sitting in the same
    ///folder, and leaving them as bare numbers meant the one feature that needs a mapping - Trace net - was a
    ///grayed-out button on every file the app offers.
    ///
    ///Read here rather than per open, because each is one small file from this app's own origin and every
    ///example open would otherwise wait on it. Best effort: a viewer that would not draw because a
    ///convenience file was missing is worse than one that shows numbers.
    ///
    ///**And the decks beside them**, at start rather than on the open that needs one, for the same reason: each is a
    ///file of about ten kilobytes, and fetching it per example open would put a round trip in front of every one.
    ///Best effort too - a viewer that would not draw because a convenience file was missing is worse than one that
    ///shows an empty rule panel.
    ///
    private async Task loadShippedPdks()
    {
        var reads = new List<Task>();

        foreach (var shipped in Pdk.BuiltIns)
        {
            reads.Add(loadShipped(shipped.LayersPath, "layermap", text => shippedLayers[shipped.Id] = text));
            reads.Add(loadShipped(shipped.RulesPath, "deck", text => shippedRules[shipped.Id] = text));
        }

        await Task.WhenAll(reads);
    }

    ///<summary>One file a built-in ships with, handed to <paramref name="keep"/> - or said to the console when it cannot be read.</summary>
    private async Task loadShipped(string path, string what, Action<string> keep)
    {
        try
        {
            keep(await httpClient.GetStringAsync(path));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the bundled {what} from {path}: {ex.Message}");
        }
    }

    ///
    ///The AI models a developer's dev-secrets.json holds, added under Settings - see DevSecrets. Only a Development build
    ///has the store ask for the file at all.
    ///
    ///**Not in a browser a test is driving.** Playwright runs the same Development build, and its specs set up the models
    ///they want: one that found the developer's real key under Settings would spend it, and on a machine without the
    ///file, every spec would see the request for it fail. Best effort, like the layermap above.
    ///
    private async Task seedDevModels()
    {
        try
        {
            if (await js.InvokeAsync<bool>("isAutomatedInterOp"))
                return;

            //Only into this browser's own models: a host app's service has the models it gives, and no file of a developer's.
            if (aiService is GDSViewer.Ai.BrowserAiService browser)
                await browser.SeedAsync(httpClient);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not add the models in {GDSViewer.Ai.DevSecrets.Path}: {ex.Message}");
        }
    }

    ///
    ///The built-ins' layermaps as they ship, by PDK id - none for one that could not be read. Served from beside the
    ///examples, since they are about them. See loadShippedPdks.
    ///
    private Dictionary<string, string> shippedLayers = new Dictionary<string, string>();

    ///<summary>The built-ins' decks as they ship, by PDK id, read beside their layermaps. See loadShippedPdks.</summary>
    private Dictionary<string, string> shippedRules = new Dictionary<string, string>();

    ///<summary>
    ///Seeds the layer names from the saved session, so a file opened by a ?file= link on a fresh page is
    ///named too - not only one restored from a session.
    ///</summary>
    private async Task loadStoredLayerNames()
    {
        var session = SavedSession.Deserialize(await storage.GetAsync(SessionStorageKey));

        if (session is null)
            return;

        //The names the visitor chose to carry, from before there were PDKs: carried into sky130 once, which is where
        //carrying lives now - see carryIntoPdk.
        carriedBeforePdks = session.CarriedLayerNames ?? "";

        //The deck alongside the names, for the same reason and by the same route. A reload that put one
        //back and not the other sent somebody to the file picker for something they had already chosen.
        restoreDeck(session.Deck);

        //And which of its rules were switched off, which belong to the deck and come back with it - the
        //bundled one too, which is laid back over an example rather than stored.
        rulesOff = new HashSet<string>(session.RulesOff);
    }

    ///
    ///What the page hosting this asked for, read out of the address.
    ///
    ///Re-read on every parameter change rather than held from the first, so the back button through a set of
    ///embed links lands on what each of them says - the same reason ?view= is applied here.
    ///
    private Embedding embedding = new Embedding();

    ///<summary>Whether the embed's settings have been put on screen, which is done once and after the file.</summary>
    private bool embeddingApplied = false;

    ///<summary>Only the canvas, for a page that wants a picture rather than an editor.</summary>
    private bool viewerOnly
    {
        get { return embedding.Mode == AppMode.Viewer; }
    }

    ///<summary>The whole app, with everything that would change the file turned off.</summary>
    private bool noEditing
    {
        get { return embedding.Mode == AppMode.NoEdit; }
    }

    ///
    ///Whether the layer list may be added to and taken from.
    ///
    ///**Not in 3D**, on top of the read-only case. Adding a layer is for putting a shape on it and removing
    ///one takes its shapes with it, and neither of those is a thing this view can show you doing: there is no
    ///draw tool, and a stack rebuilt under a press that gave no sign of being an edit is a surprise. The list
    ///is still there to say what is in the file and to turn slabs on and off, which is what it is for here.
    ///
    ///**Nor beside the text.** The list is there to say what the layer numbers in the records are and to check
    ///the rules; a layer taken out from here would rewrite the text under the editor, over whatever has been
    ///typed and not saved. So 2D is the only place this is true.
    ///
    private bool layersAreEditable
    {
        get { return !noEditing && view == ViewType.View2DSvg; }
    }

    ///
    ///Whether a layer can be added to the list - in 2D, and **beside the text as well** (2026-11-01, asked for). A
    ///layer added has no shapes, so it writes no record and the text under the editor is left as it is, typing and all:
    ///the list gains a row to name, color and draw on later. Taking one out still rewrites the text, so that stays 2D's.
    ///
    private bool layersCanBeAdded
    {
        get { return !noEditing && (view == ViewType.View2DSvg || view == ViewType.ViewText); }
    }

    ///
    ///Whether pressing a row does anything at all, which is what earns it a pointer.
    ///
    ///Two different somethings. In 2D the press takes that layer as the one a shape goes on, which is only a
    ///question while there is a tool out to draw with; in 3D there is no shape to place, so it flashes the
    ///slab the row names instead. Both are a press with an answer, so both get the cursor that says one is
    ///there - and in the text view, where neither is true, a row gets no such cursor.
    ///
    ///The eye and the lock are their own buttons and carry their own cursors, so a row with no draw tool out
    ///is still a row with two things on it that can be pressed.
    ///
    ///And in either view while a layer's settings are up, since a press moves them to the row pressed - see
    ///layerRowPressed.
    ///
    private bool layerRowsRespondToPress
    {
        get { return drawingView is not null || viewer is Viewer3D || settingsFor is not null; }
    }

    ///
    ///How long a row stays lit, and how many times it brightens while it does.
    ///
    ///**The same pair as the slab's own flash** in ThreeInterop's PULSE_MS and PULSE_BEATS. A row that beats
    ///at a different rate from the thing it names reads as two events rather than as one thing answering.
    ///
    private const int ROW_PULSE_MS = 1250;

    ///
    ///Which row is flashing, and a count of how many flashes have been started.
    ///
    ///The count is what lets a second press cancel the first one's clear. Without it the first flash's timer
    ///comes back a moment into the second flash and puts the light out, so pressing two rows in a row leaves
    ///the second one dark - the bug looks like the flash being unreliable rather than like a stale timer.
    ///
    private LayerKey? pulsingLayer;
    private int pulseRun;

    ///
    ///Lights a row, and puts it out again when the flash has run.
    ///
    ///**Cleared before it is set**, with a render in between. A CSS keyframe animation runs when the class
    ///arrives and not again while it stays, so pressing the same row twice would light it once: the class is
    ///already there and the browser has already finished with it. Taking it off, letting a render carry that,
    ///then putting it back is what makes the second press flash.
    ///
    private async Task flashLayerRow(LayerKey id)
    {
        pulseRun++;

        var mine = pulseRun;

        pulsingLayer = null;

        StateHasChanged();

        await Task.Delay(1);

        pulsingLayer = id;

        StateHasChanged();

        await Task.Delay(ROW_PULSE_MS);

        //A later press owns the light now, and putting it out here would cut that one short.
        if (pulseRun != mine)
            return;

        pulsingLayer = null;

        StateHasChanged();
    }

    ///<summary>
    ///Applies ?view= from the address, on the first load and on every later change to it - which covers
    ///arriving on a shared link, and the back button walking through one.
    ///
    ///An address with no view stays that way rather than being rewritten to say "2d": a bare link should
    ///keep working as a bare link, and it already lands where a bare link should.
    ///</summary>
    protected override void OnParametersSet()
    {
        view = viewOf(ViewSlug);

        //Read here rather than held from the first load, so walking back through a set of embed links lands
        //on what each of them says. Its own parse rather than [SupplyParameterFromQuery] - see Embedding.
        embedding = Embedding.ReadFrom(NavigationManager.Uri);

        //And the picker rebuilt if this address names files the built list does not have. See
        //injectedSignature: the list is put together before this runs.
        if (exampleListFetched && injectedSignature() != injectedInList)
            rebuildFilteredExamples();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            inIframe = await js.InvokeAsync<bool>("isInIframe");

            await registerAppSettings();

            //Not awaited by the render: the models are for Settings and the chat, which hear when they arrive.
            _ = seedDevModels();
        }

        await openFileFromQuery();

        //A tab's name put in a box to rename, with what is typed replacing it - see startRenamingTab.
        if (focusTabRename)
        {
            focusTabRename = false;

            try
            {
                await js.InvokeVoidAsync("selectAllIn", tabRenameBox);
            }
            catch { }
        }

        //A restored session's own controls, once the view that owns them exists - which is this render.
        await applyRestoredSettings();

        //A tab double-clicked while it was put away, on screen now and done coming back: its box opens.
        if (renameWhenOn >= 0 && renameWhenOn == activeTab && !restoringState)
        {
            startRenamingTab(activeTab);

            StateHasChanged();
        }

        //And the same for a view that was simply switched to, which destroys the component holding them.
        await applyCarriedSettings();

        //
        //And then what the address asked for, over the top.
        //
        //**Here rather than only after a restore**, because a restore is one of several ways to arrive: a
        //?file= link opens its file directly and never goes near the session, and hooking this to the
        //restore alone meant an embed that named a file - which is nearly all of them - had every one of its
        //other settings quietly ignored. Measured: banner and mode worked, and full, grid, tool and pitch
        //did not.
        //
        //Guarded on having been done, so it lands once and a later change to any of these is the visitor's.
        await applyEmbedding();

        //Re-render once whenever the active view changes, so its toolbar appears now that @ref has been
        //assigned. Comparing instances rather than using a flag means this settles by itself: the next
        //pass sees them equal and stops.
        if (ReferenceEquals(toolbarRenderedFor, viewer))
            return;

        toolbarRenderedFor = viewer;

        StateHasChanged();
    }

    ///<summary>
    ///Reads the manifests - each PDK's cells', which the build generates from their folder, and its designs',
    ///which are written by hand. All at once, for the reason OnInitializedAsync gives: everything downstream
    ///waits on this.
    ///</summary>
    private async Task loadExampleFileList()
    {
        var cells = readManifest(ExampleManifestPath);
        var credited = readDesigns(DesignManifestPath);
        var theirCells = pdkExamples.Select(pdk => readManifest(pdk.CellManifestPath)).ToList();
        var theirCredits = pdkExamples.Select(pdk => readDesigns(pdk.DesignManifestPath)).ToList();

        exampleFiles = await cells;

        var sky130Designs = await credited;

        designs = sky130Designs.ToList();
        designFiles = sky130Designs.Select(design => design.File).ToList();

        for (int i = 0; i < pdkExamples.Count; i++)
        {
            var theirDesigns = await theirCredits[i];

            pdkExamples[i].Cells = await theirCells[i];
            pdkExamples[i].Designs = theirDesigns.Select(design => design.File).ToList();
            designs.AddRange(theirDesigns);
        }

        assistantExamples = examplesForAssistant();

        //Set either way: the list has been tried, so ?file= should stop waiting and say what it found.
        exampleListFetched = true;

        //The picker draws from the filtered list, so it has to be built once the names are in - otherwise
        //the popup opens on an empty list until something is typed into the filter.
        rebuildFilteredExamples();
    }

    ///<summary>
    ///One manifest's names, or none. A failure here only costs the example picker those entries, so it is
    ///reported to the console rather than to the user.
    ///</summary>
    private async Task<List<string>> readManifest(string path)
    {
        try
        {
            return await httpClient.GetFromJsonAsync(path, SavedJson.Default.ListString) ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the example file list from {path}: {ex.Message}");

            return new List<string>();
        }
    }

    ///<summary>One PDK's designs and their credits, or none - on the same terms as readManifest.</summary>
    private async Task<List<BundledDesign>> readDesigns(string path)
    {
        try
        {
            return await httpClient.GetFromJsonAsync(path, SavedJson.Default.ListBundledDesign) ?? new List<BundledDesign>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the design list from {path}: {ex.Message}");

            return new List<BundledDesign>();
        }
    }

