    ///
    ///**use_pdk, the assistant's Set PDK** (2026-11-01, asked for): the PDK of that name put in use, as the PDK manager's
    ///use pill does, and its layers laid on - every one on a layout that waits for one, as the empty layer list's Set PDK
    ///does, and since later the same day, asked for, the ones a layout drawn in it lacks. See usePdk and
    ///startWithPdkLayers. **Not on a file from another process**, whose layers it would name wrongly - see fileFitsPdk.
    ///Says which layers came in, by the names the list shows, for the model to draw on, and whether it was in use already.
    ///
    private async Task<GDSViewer.Ai.PdkUsed> usePdkForAssistant(string name)
    {
        var pdk = pdks.Pdks.FirstOrDefault(each => each.Name == name);

        if (pdk is null || gds is null)
            return new GDSViewer.Ai.PdkUsed(Array.Empty<string>(), false, false);

        bool wasInUse = pdks.InUse.Id == pdk.Id;

        if (pdks.Selected != pdk.Id)
        {
            pdks.Selected = pdk.Id;

            await savePdks();

            await reapplyPdk();
        }

        var laid = new List<string>();

        if (layersWaitForPdk || fileFitsPdk())
        {
            var had = gds.AdditionalInformation.Layers.Keys.ToHashSet();

            await startWithPdkLayers();

            foreach (var row in checkboxItems)
            {
                if (!had.Contains(row.Id))
                    laid.Add(row.Label);
            }
        }

        StateHasChanged();

        return new GDSViewer.Ai.PdkUsed(laid, fileUnderPdk, wasInUse);
    }

    ///<summary>The PDK's layers for read_rules: name, pair and role, one to a line, as the PDK manager lists them.</summary>
    private IReadOnlyList<string> ruleLayers()
    {
        var names = LayerNames.Parse(pdkLayers(rulesPdk()));
        var lines = new List<string>();

        foreach (var pair in names.Pairs)
        {
            if (!names.Names.TryGetValue(pair, out string? name) || name.Length == 0)
                continue;

            string role = LayerRole.None.ToString();

            if (names.Roles.TryGetValue(pair, out var known))
                role = known.ToString();

            lines.Add($"{name} {pair} {role}");
        }

        return lines;
    }

    private async Task replaceRules(string deck)
    {
        var pdk = rulesPdk();

        //A built-in reads the deck it ships with until it is changed, so that deck is no change of its own.
        if (pdk.BuiltIn && deck == shippedRulesOf(pdk))
            pdk.Rules = null;
        else
            pdk.Rules = deck;

        await pdkEdited(pdk);
    }

    private async Task replaceLayers(string layermap)
    {
        var pdk = rulesPdk();

        //As the deck: the layermap a built-in ships with is no change of its own.
        if (pdk.BuiltIn && layermap == LayerNames.Parse(shippedLayersOf(pdk)).Write())
            pdk.Layers = null;
        else
            pdk.Layers = layermap;

        await pdkEdited(pdk);
    }

