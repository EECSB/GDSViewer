    ///
    ///What the assistant is told about where the person is, gathered as they press Send.
    ///
    ///**The cell they have open becomes the cell the tools work in.** "Draw a pad here" means the cell on screen, and
    ///a model that went on drawing into whatever it opened three messages ago would put it somewhere nobody is
    ///looking. Looking at the whole layout leaves the tools where they were.
    ///
    ///What the 2D view shows is said only when the view is showing the cell the tools work in, and in that cell's
    ///coordinates: the view is in the layout's, and a cell opened through a placement is moved and turned from them.
    ///
    private async Task<GDSViewer.Ai.LayoutFacts> describeForAssistant(AgentSession session)
    {
        if (gds is null)
            return new GDSViewer.Ai.LayoutFacts();

        Viewer2DSvg? drawing = null;

        if (view == ViewType.View2DSvg)
            drawing = viewer as Viewer2DSvg;

        var editing = drawing?.EditingContext;

        if (editing is not null)
            session.Cell = editing.Structure;

        string? working = GDSViewer.Ai.LayoutToolRunner.WorkingCell(session);

        var tops = new List<string>();
        var summaries = Hierarchy.Summarize(gds);

        foreach (var summary in summaries)
        {
            if (summary.IsTop)
                tops.Add(summary.Name);
        }

        var layers = new List<string>();
        var locked = new List<string>();

        foreach (var row in checkboxItems)
        {
            layers.Add(row.Label);

            if (row.IsLocked)
                locked.Add(row.Label);
        }

        var selected = new List<int>();
        var cells = new HashSet<string>();

        if (drawing is not null)
        {
            foreach (var (model, cell) in drawing.ChosenShapes)
            {
                selected.Add(session.IdOf(model));
                cells.Add(cell);
            }
        }

        string? selectedIn = null;

        if (cells.Count == 1)
            selectedIn = cells.First();

        //A top cell is drawn where its own coordinates put it, so with nothing opened the view is in the coordinates of
        //whichever top the tools work in.
        bool viewIsWorkingCell = false;

        if (editing is not null)
            viewIsWorkingCell = editing.Structure == working;
        else if (working is not null)
            viewIsWorkingCell = tops.Contains(working);

        (double, double, double, double)? shown = null;

        if (drawing is not null && viewIsWorkingCell)
            shown = await areaShownIn(editing, session.MicronsPerUnit);

        return new GDSViewer.Ai.LayoutFacts
        {
            FileName = CurrentlySelectedFileName,
            MicronsPerUnit = session.MicronsPerUnit,
            Layers = layers,
            Locked = locked,
            CellCount = summaries.Count,
            TopCells = tops,
            WorkingCell = working,
            Editing = editing?.Structure,
            Selected = selected,
            SelectedIn = selectedIn,
            Shown = shown,
            View = viewNamed(view),
            DeckLoaded = drcDeck is not null,
            CanLook = true,
            RulesPdk = rulesPdk().Name,
            HasExamples = assistantExamples is not null,
            PdkNames = pdks.Pdks.Select(each => each.Name).ToList(),
            PdkInUse = pdks.InUse.Name,
            WaitsForPdk = layersWaitForPdk
        };
    }

    ///<summary>What the 2D view shows, in microns in the coordinates of the cell open in it - or null when it cannot say.</summary>
    private async Task<(double, double, double, double)?> areaShownIn(CellContext? editing, double micronsPerUnit)
    {
        ShownArea? area = null;

        try
        {
            area = await js.InvokeAsync<ShownArea?>("viewAreaShown");
        }
        catch (Microsoft.JSInterop.JSException) { }

        if (area is null)
            return null;

        var corners = new List<(double X, double Y)>
        {
            (area.X, area.Y),
            (area.X + area.Width, area.Y),
            (area.X, area.Y + area.Height),
            (area.X + area.Width, area.Y + area.Height)
        };

        double left = double.MaxValue;
        double bottom = double.MaxValue;
        double right = double.MinValue;
        double top = double.MinValue;

        foreach (var (x, y) in corners)
        {
            double localX = x;
            double localY = y;

            if (editing is not null)
            {
                if (editing.ToLocal(x, y) is not (double inX, double inY))
                    return null;

                localX = inX;
                localY = inY;
            }

            left = Math.Min(left, localX);
            right = Math.Max(right, localX);
            bottom = Math.Min(bottom, localY);
            top = Math.Max(top, localY);
        }

        return (left * micronsPerUnit, bottom * micronsPerUnit, right * micronsPerUnit, top * micronsPerUnit);
    }

    ///<summary>The area the 2D view reports, in the layout's own units.</summary>
    private sealed class ShownArea
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private static string viewNamed(ViewType type)
    {
        if (type == ViewType.View3D)
            return "3D";

        if (type == ViewType.ViewText)
            return "text";

        return "2D";
    }

    ///
    ///A picture for the assistant's look: drawn by the browser from what LayoutPicture builds, without the layers the
    ///person has hidden.
    ///
    private async Task<GDSViewer.Ai.LlmToolOutput> lookForAssistant(GDSViewer.Ai.LookRequest request, CancellationToken ct)
    {
        if (gds is null)
            return new GDSViewer.Ai.LlmToolOutput { Text = "No file is open.", IsError = true };

        var hidden = new HashSet<LayerKey>();

        foreach (var row in checkboxItems)
        {
            if (!row.IsSelected)
                hidden.Add(row.Id);
        }

        var draft = GDSViewer.Ai.LayoutPicture.Draft(gds, request.Cell, request.Area, request.MicronsPerUnit, hidden, out string why);

        if (draft is null)
            return new GDSViewer.Ai.LlmToolOutput { Text = why, IsError = true };

        string? png = null;

        try
        {
            png = await js.InvokeAsync<string?>("layoutPictureBase64", ct, draft.Document, draft.Width, draft.Height);
        }
        catch (Microsoft.JSInterop.JSException) { }

        if (string.IsNullOrEmpty(png))
            return new GDSViewer.Ai.LlmToolOutput { Text = "The browser could not draw the picture.", IsError = true };

        return new GDSViewer.Ai.LlmToolOutput { Text = draft.Says, Png = png };
    }

    ///
    ///A change made outside the 2D view - the assistant's, or the shell's own - which went onto the same history as
    ///anything done by hand, so it is followed by the same things: the 2D view's own after-edit when that view is up,
    ///with what was made picked out, and the shell's otherwise, which redraws whichever view is.
    ///
    private async Task changedOnHistory(IReadOnlyList<GDS.ElementModel> made)
    {
        if (view == ViewType.View2DSvg && viewer is Viewer2DSvg drawing)
            await drawing.AfterOutsideEdit(made);
        else
            await onFileEdited();
    }

