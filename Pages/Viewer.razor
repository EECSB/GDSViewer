    ///
    ///What the assistant's use_pdk chooses from - see PdkTools: the PDKs by name, the one in use, whether the layout waits
    ///for one's layers, and the deck the file is checked against once one is in use.
    ///
    private GDSViewer.Ai.PdkShelf? pdkShelfMade = null;

    private GDSViewer.Ai.PdkShelf pdkShelf
    {
        get
        {
            pdkShelfMade ??= new GDSViewer.Ai.PdkShelf
            {
                Names = () => pdks.Pdks.Select(each => each.Name).ToList(),
                InUse = () => pdks.InUse.Name,
                Waiting = () => layersWaitForPdk,
                Use = usePdkForAssistant,
                Deck = () => drcDeck
            };

            return pdkShelfMade;
        }
