    ///across the list and the picture follows it, and when the pointer leaves the answer is the file that
    ///is actually open, not whichever row it happened to pass over last.
    ///</summary>
    private (string Markup, string ViewBox)? selectedPreview = null;

    ///<summary>What the list is narrowed to, and the rows that survive it.</summary>
    private string exampleFilter = "";
    private List<ExampleRow> filteredExamples = new List<ExampleRow>();

    ///<summary>The injected files the built list holds. See injectedSignature.</summary>
    private string injectedInList = "";

    ///<summary>
    ///One line of the example list: either a file to open, or the heading over a group of them.
    ///
    ///Headings are rows rather than markup around groups because the list is virtualized - Virtualize
    ///renders a window of one flat sequence, so anything that has to appear in the right place has to be
    ///in that sequence. It also means a heading scrolls away with its group rather than hanging over the
    ///wrong one.
    ///</summary>
    private readonly record struct ExampleRow(string Name, bool IsHeading);

    private const string TestExamplesHeading = "Test GDS Files";
    private const string Sky130ExamplesHeading = "Sky130 GDS Examples";

    ///
    ///The embedder's own files, over the ones that ship with the app.
    ///
    ///First in the list, because a page that went to the trouble of naming its own files means those to be
    ///the ones on offer - and named for where they came from rather than "Examples", so somebody who did
    ///not build the page can tell whose files these are.
    ///
    private const string InjectedExamplesHeading = "From this page";

    ///<summary>Matches the CSS. Virtualize needs to know a row's height to know how many fit.</summary>
    private const float ExampleRowHeight = 22;

    ///<summary>
    ///Thumbnails already built, so going back over the list a second time costs nothing.
    ///
    ///Capped, because each one is the file's whole geometry as markup - a few tens of kilobytes - and
    ///hovering the length of the list would otherwise hold every bundled cell in memory at once.
    ///</summary>
    private readonly Dictionary<string, (string Markup, string ViewBox)> previewCache = new Dictionary<string, (string, string)>();
    private readonly Queue<string> previewCacheOrder = new Queue<string>();
    private const int MaximumCachedPreviews = 40;

    ///<summary>
    ///The row the preview is currently for, and the wait that stops a sweep across the list fetching
    ///every file it passes over.
    ///</summary>
    private string previewFor = "";
    private CancellationTokenSource? previewWait = null;
    private const int PreviewHoverDelayMs = 160;

    ///<summary>
    ///The row whose settings are open, or null when the popup is closed.
