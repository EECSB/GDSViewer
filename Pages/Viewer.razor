    ///what the checkbox should say.
    ///</summary>
    private CheckboxItem? settingsFor = null;

    ///<summary>What that layer is being named, while the box at the top of its settings is being typed in.</summary>
    private string settingsName = "";

    ///<summary>
    ///The color the open picker is showing, in the terms the picker works in.
    ///
    ///Kept as hue, saturation and value rather than as the hex the layer stores, because the trip back
    ///from hex loses things a picker has to hold on to: every gray is hue zero, and black is every hue at
    ///once. Reading the layer's color back on each render would swing the slider to red the moment a color
    ///was dragged to the bottom of the field, and leave it there when it was dragged back up.
    ///</summary>
    private HsvColor pickedColor = new HsvColor(0, 0, 1);

    ///<summary>Where the popup opens, from the click that opened it. See <see cref="openLayerSettings"/>.</summary>
    private double pickerLeft = 0;
    private double pickerTop = 0;

    ///<summary>The picker's width, which placing it beside the pointer has to know. Matches the CSS.</summary>
    private const int PickerWidth = 260;

    ///<summary>
    ///The saturation-and-value field's size, which turning a pointer offset into a color has to know.
    ///Matches the CSS: a mouse event carries where it landed, not what it landed on.
    ///</summary>
    private const double FieldWidth = 216;
    private const double FieldHeight = 130;

    ///<summary>Colors chosen recently, newest first. Kept across files, since a scheme is the user's.</summary>
    private List<string> recentColors = new List<string>();

    ///<summary>
    ///How many recent colors to offer. A shortcut rather than a history: past a handful the row stops
    ///being something you can pick from at a glance, which is the only thing it is for.
    ///</summary>
    private const int MaximumRecentColors = 12;

    ///<summary>
    ///Whether what is loaded still matches the file it came from. An untouched example can be fetched
    ///again by name, where an edited one has to be carried in the session as bytes.
    ///</summary>
    private bool fileEdited = false;

