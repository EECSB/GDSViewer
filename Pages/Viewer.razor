    ///Not to be confused with <c>history</c>, which is the list of files that have been opened.
    ///</summary>
    private readonly EditHistory editHistory = new EditHistory();

    ///<summary>
    ///The view whose toolbar the last render drew. @ref is only assigned once a render has completed, so
    ///the pass that switches views draws no toolbar and this is what asks for the one more pass needed.
    ///</summary>
    private IRenderable? toolbarRenderedFor = null;

    private ViewType view = ViewType.View2DSvg;

    ///<summary>
    ///Which view to show, from ?view= in the address. This is what makes a link - or the QR code, which
    ///exists to get you from a desktop onto a phone or a headset - land on the view it was taken from
    ///rather than always on the 2D one.
    ///</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewSlug { get; set; }

    ///<summary>
    ///Which bundled example to open, from ?file= in the address - the file name without its .gds. An
    ///uploaded file cannot be named here: it exists only in the tab it was dropped into.
    ///</summary>
    [SupplyParameterFromQuery(Name = "file")]
    public string? FileSlug { get; set; }

    ///<summary>The example that ?file= has already been acted on for, so a re-render does not fetch it again.</summary>
    private string? openedFileSlug = null;

    ///<summary>
    ///Whether the example list has been fetched, which ?file= cannot be resolved without.
    ///
    ///It matters because OnInitializedAsync yields on that fetch, so Blazor renders once before it
    ///returns - and the first OnAfterRenderAsync therefore runs while the list is still empty. Without
    ///this, a linked example was reported as not existing.
    ///</summary>
    private bool exampleListFetched = false;

    ///<summary>
    ///What the picker shows. Bound rather than left to a hardcoded selected option so that arriving on a
    ///?file= link, or an upload clearing it, leaves the picker agreeing with what is loaded.
    ///</summary>
    private string selectedExample = "";
    public string CurrentlySelectedFileName { get; set; } = "";
    public string CurrentlySelectedFileType { get; set; } = "";
    private List<CheckboxItem> checkboxItems = new List<CheckboxItem>();

    ///<summary>Whether anything is named, which is what the "clear" link is offered for.</summary>
    private bool layerNamesLoaded = false;

    ///<summary>
    ///Where the whole session lives. One key rather than one per setting, because the pieces only make
    ///sense together - a layer's visibility means nothing without the file that has that layer.
    ///</summary>
    private const string SessionStorageKey = "gdsviewer.session";

    ///<summary>
    ///A restored session waiting for the view it belongs to. The view is created by the render after the
    ///file is opened, so its settings cannot be applied at the moment the session is read.
    ///</summary>
    private SavedSession? restoredSession = null;

    ///<summary>
    ///Tried once and only once. OnAfterRenderAsync runs on every render, and a session that failed to
    ///restore must not be retried on each of them.
    ///</summary>
    private bool sessionRestoreAttempted = false;

    //The shell had a handle here for the view menu's dismissal. The view switch is three buttons now, so
    //there is no menu to dismiss and nothing calling back - see the toolbar's own comment.

    ///<summary>
    ///Set while a saved state is being put back, so that nothing writes over it half-applied.
