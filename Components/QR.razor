@using System.Drawing;
@using System.Drawing.Imaging;
@using Net.Codecrete.QrCodeGenerator;
@using System.Text;

@if (!string.IsNullOrEmpty(QrCodeSVG))
{
    <div class="popupDiv popupZIndex_0 popupInView">
        <div class="col">

            @*
                mb-3 rather than mb-5, twice. Three rems above the code and three below it is 96 pixels of
                nothing in a popup whose whole job is to be as big as the view will allow - and every pixel
                of it came off the code, since what decides the code's size is the height left over.
            *@
            <div class="popupHeading">
                <span class="popupHeadingName">QR Code</span>

                <button class="buttonStyle2 closeButton" @onclick="() => { QrCodeSVG = string.Empty; }" title="Close the QR code">&times;</button>
            </div>

            @*
                No margin under it: the popup's own padding is the space round the code, the same on all four
                sides - see GenerateQRCode.
            *@
            <div class="row">
                <div class="d-flex justify-content-center">
                    @*The address the code opens, beside it, so a spec can read what a phone would.*@
                    <div class="svgContainer" data-link="@QrCodeText">
                        @((MarkupString)QrCodeSVG)
                    </div>
                </div>
            </div>

        </div>
    </div>
}

@code {
    public string QrCodeSVG { get; set; } = "";

    ///<summary>What the code says - the address a phone opens on scanning it.</summary>
    public string QrCodeText { get; set; } = "";

    ///
    ///The code as an SVG whose box is the code: a unit a module, and nothing round it.
    ///
    ///**It was 300 units square with each module 300 over the modules across, in whole units** - so a code 53
    ///modules across was drawn 265 units wide and the last 35 were white, a band down the right and along the
    ///bottom of the popup that read as the code sitting off center. The popup's padding is the space round it now,
    ///the same on every side. Each row's run of dark modules is one stretch of a single path.
    ///
    public void GenerateQRCode(string text)
    {
        QrCodeText = text;

        var qrCode = QrCode.EncodeText(text, QrCode.Ecc.Medium);

        int size = qrCode.Size;

        var runs = new StringBuilder();

        for (int y = 0; y < size; y++)
        {
            int x = 0;

            while (x < size)
            {
                if (!qrCode.GetModule(x, y))
                {
                    x++;

                    continue;
                }

                int start = x;

                while (x < size && qrCode.GetModule(x, y))
                    x++;

                runs.Append($"M{start},{y}h{x - start}v1h-{x - start}z");
            }
        }

        QrCodeSVG = $@"<svg xmlns=""http://www.w3.org/2000/svg"" version=""1.1"" viewBox=""0 0 {size} {size}"" preserveAspectRatio=""xMidYMid meet"" shape-rendering=""crispEdges"">
<rect width=""100%"" height=""100%"" fill=""white""/>
<path d=""{runs}"" fill=""black""/>
</svg>";

        StateHasChanged();
    }
}
