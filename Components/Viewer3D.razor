@using System.Runtime.InteropServices;
@using GdsII;
@using GDSViewer.Models;

@using Layer = GdsII.Layer;
@using Point = GdsII.Element.Point;
@using static GdsII.GDS.Record;

@inject IJSRuntime js;
@inject NavigationManager Navigation;
@inject TextureStore textures;

@implements IAsyncDisposable

@*
    The scene, and beside it the file's cells - see CellTree3D.

    **The scene and everything over it in a box of their own**, the way the 2D view puts its drawing in .viewCanvas:
    the tree is a column of the wrapper, and what is placed over the scene - the frame rate, the headset row, the
    game's panels - is placed against the scene rather than against the wrapper, so the tree opening moves none of
    it onto itself. The canvas is sized from #container, which three.js watches - see resizeToContainer.
*@
<div id="threeWrapper" class="viewWrapper">
    <div class="viewCanvas">
        <div id="container"></div>

        @*The live link's chip, in the bottom left as in the 2D view - see Corner.*@
        @Corner

        @*The frame rate, while Debug info is on. Empty here: frameMeter.js fills it, the same as in the 2D view.*@
        @if (DebugInfo)
        {
            <div id="frameMeter" class="frameMeter" aria-hidden="true"></div>
        }

        @*
            The three ways of getting the layout onto something you wear or hold, together.

            VR and AR are built by three.js and put in here by the interop rather than positioned one at a
            time, which is what they used to be: two wrappers pulled back up over the canvas by an offset each,
            so moving the pair meant editing two numbers in a JS file and hoping. This row owns where they go.

            The one in the markup is ours - a headset can enter VR from the page it is already on, but a phone
            has to be told which page, and a QR code is how. Ordered after them, since it is the fallback of
            the three rather than the first thing to reach for.
        *@
        <div id="xrButtons" class="xrButtons">
            <button type="button" id="openOnPhone" class="xrButton" @onclick="getQRCode"
                    title="Show a QR code of this page, to open the same file and view on a phone or headset">
                <img class="xrButtonIcon" src="./resources/Images/Icons/qr.png" alt="" />
                OPEN ON PHONE
            </button>
        </div>

        @*
            The chip game: a little car driven over the tops of the layers. See ChipGame in js/ThreeInterop.js.

            Started and stopped from the shell's Settings menu - see ToggleGame - so all the view itself shows is
            this, while it runs.
        *@
        @if (gameRunning)
        {
            @*
                What the keys do, and which layer the car is on. The two empty boxes are filled in by the interop -
                the layer as the car moves, the message when something happens - which is why they have ids.

                **The car's keys, the plane's or the jet's**, by which one is being played: the interop puts gameHudPlane or
                gameHudJet on the panel - see ChipGame.showVehicle - and the stylesheet shows that one's list and hides the
                rest. gameForAir is the plane's and the jet's both.

                **Its × puts it away**, and Settings, Game controls brings it back - see ChipGame.setPanel. The interop
                listens for the press, since it is what keeps whether the panel is open, with the rest of the game's options.

                **A key and a word or two**, in two columns, since 2026-11-03: each line had been a sentence - the missile's
                said what it was fired at, and a line said how long the weapons take to overheat - which the game itself
                shows, and the panel was a wall of text. How a game is played is in the docs; this is what the keys are.
            *@
            <div id="gameHud" class="gameHud">
                <div class="gameHudHead">
                    <div id="gameLayer" class="gameLayer"></div>
                    <button type="button" id="gameHudClose" class="buttonStyle2 closeButton gameHudClose"
                            aria-label="Close the game's panel" title="Close the panel. Settings, Game controls opens it again">&times;</button>
                </div>
                <div class="gameKeys gameForCar">
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span><span>Drive, or the arrows</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Space</kbd></span><span>Jump, hold to fly</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Shift</kbd></span><span>Boost</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Mouse</span><span>Look round</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>P</kbd></span><span>Plane, then jet</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>V</kbd></span><span>First or third person</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>H</kbd><span class="gameKeyOr">/</span><kbd>M</kbd></span><span>Horn / sound</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>R</kbd><span class="gameKeyOr">/</span><kbd>Esc</kbd></span><span>Restart / stop</span></div>
                </div>
                <div class="gameKeys gameForPlane">
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>W</kbd><kbd>S</kbd></span><span>Faster, slower</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>A</kbd><kbd>D</kbd></span><span>Yaw</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>↑</kbd><kbd>↓</kbd></span><span>Pitch</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>←</kbd><kbd>→</kbd></span><span>Roll</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Mouse</span><span>Stick: the middle level, the edges loop</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Click<span class="gameKeyOr">/</span><kbd>F</kbd></span><span>Gun</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Space</kbd></span><span>Level out</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Shift</kbd></span><span>Boost</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>P</kbd></span><span>Jet</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>V</kbd></span><span>First or third person</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>H</kbd><span class="gameKeyOr">/</span><kbd>M</kbd></span><span>Horn / sound</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>R</kbd><span class="gameKeyOr">/</span><kbd>Esc</kbd></span><span>Restart / stop</span></div>
                </div>
                <div class="gameKeys gameForJet">
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>W</kbd><kbd>S</kbd></span><span>Faster, slower</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>A</kbd><kbd>D</kbd></span><span>Yaw</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>↑</kbd><kbd>↓</kbd></span><span>Pitch</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>←</kbd><kbd>→</kbd></span><span>Roll</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Mouse</span><span>Stick: the middle level, the edges loop</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Click<span class="gameKeyOr">/</span><kbd>F</kbd></span><span>Gun</span></div>
                    <div class="gameKey"><span class="gameKeyCaps">Right-click<span class="gameKeyOr">/</span><kbd>G</kbd></span><span>Missile</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Space</kbd></span><span>Level out</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>Shift</kbd></span><span>Afterburner</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>P</kbd></span><span>Car</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>V</kbd></span><span>First or third person</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>H</kbd><span class="gameKeyOr">/</span><kbd>M</kbd></span><span>Horn / sound</span></div>
                    <div class="gameKey"><span class="gameKeyCaps"><kbd>R</kbd><span class="gameKeyOr">/</span><kbd>Esc</kbd></span><span>Restart / stop</span></div>
                </div>

                @*
                    What the game is played with: what is being played and from where, the top speed, the size and how small
                    that goes, how far the view reaches, which way the stick goes, lock on, limit jump, the layers' texture,
                    the neon, the sound and the music.

                    Set and read by the interop rather than bound here - see ChipGame.showOptions and onOption - since
                    the game is what uses them and this browser is what keeps them. No values in the markup either, so
                    a render of this component never puts back what somebody has just dragged. The two lists have their
                    options, which are what they offer rather than what is chosen.

                    Lock on is guardrails and climbing: the car cannot drive off the edge of what it is on, and drives
                    up any wall it is pointed into - a via, and the metal over it. Limit jump is a meter of four jumps
                    that fills again by itself - see chipGame's charge. Both are the car's alone, so they are shown for
                    the car; Invert pitch is the plane's and the jet's, and shown for them.

                    **Headed Settings**, under the rule that parts them from the keys; the heading names the group for a
                    screen reader too.
                *@
                <div class="gameOptions" role="group" aria-labelledby="gameOptionsHead">
                    <div id="gameOptionsHead" class="gameOptionsHead">Settings</div>

                    <label class="gameOption" for="gameVehicle"
                           title="The car, the plane or the jet. P goes through them in turn">
                        <span class="gameOptionName">Vehicle</span>
                        <select id="gameVehicle" class="gameOptionPick">
                            <option value="car">Car</option>
                            <option value="plane">Plane</option>
                            <option value="jet">Jet</option>
                        </select>
                    </label>

                    <label class="gameOption" for="gameView"
                           title="Behind it, or from the driver's seat. V switches it too">
                        <span class="gameOptionName">View</span>
                        <select id="gameView" class="gameOptionPick">
                            <option value="third">Third person</option>
                            <option value="first">First person</option>
                        </select>
                    </label>

                    <label class="gameOption" for="gameTopSpeed"
                           title="How fast the car goes flat out, in its own widths a second - the plane two and a half times that, and the jet five. Shift still boosts on top of it">
                        <span class="gameOptionName">Top speed</span>
                        <input id="gameTopSpeed" type="range" min="0.5" max="15" step="0.5" />
                        <output id="gameTopSpeedSaid" class="gameOptionSaid" for="gameTopSpeed"></output>
                    </label>

                    @*
                        The size, and after it a box for how small the slider goes - the way the layers' Distance has a box
                        for how far its slider reaches. The slider's least is the box's, put on by the interop; the 0.01
                        here is only the least there is. A row rather than a label, since a label holds one control.

                        **Named for what is being played** - Car size, Plane size or Jet size - by the stylesheet, the way the
                        key lists are. It said Car size in the plane and the jet, which have the one size between them.
                    *@
                    <div class="gameOption"
                         title="How big the car, the plane or the jet is, against the car this layout gets: a tenth of it to start with, and half of it at the most. Its speed and its jump go with it">
                        <label class="gameOptionName" for="gameCarSize"><span class="gameForCar">Car size</span><span class="gameForPlane">Plane size</span><span class="gameForJet">Jet size</span></label>
                        <input id="gameCarSize" type="range" min="0.01" max="0.5" step="0.01" />
                        <output id="gameCarSizeSaid" class="gameOptionSaid" for="gameCarSize"></output>
                        <input id="gameCarSmallest" class="gameOptionLeast" type="number" min="0.01" max="0.45" step="0.01"
                               aria-label="How small the size slider goes"
                               title="How small the size slider goes, from a hundredth of the car this layout gets to 0.45 of it. Enter sets it" />
                    </div>

                    <label class="gameOption" for="gameDrawDistance"
                           title="How far the view reaches, as a share of the chip's width. All draws all of it; less fades the far side into the background. The 3D view's own draw distance, set to All as the game starts and put back when it stops">
                        <span class="gameOptionName">Draw distance</span>
                        <input id="gameDrawDistance" type="range" min="0.05" max="1" step="0.05" />
                        <output id="gameDrawDistanceSaid" class="gameOptionSaid" for="gameDrawDistance"></output>
                    </label>

                    @*The neon's haze - see GAME_HAZE_REACHES in js/ThreeInterop.js. Both are grayed out with Neon glow off, which has none.*@
                    <label class="gameOption" for="gameHaze"
                           title="How far the neon's haze reaches before it hides what is behind it: left is thicker and nearer, right thinner and further, and the far end has none. 1× is where it starts">
                        <span class="gameOptionName">Haze reach</span>
                        <input id="gameHaze" type="range" min="-3" max="3" step="0.5" />
                        <output id="gameHazeSaid" class="gameOptionSaid" for="gameHaze"></output>
                    </label>

                    <div class="gameOptionChecks">
                        <label class="gameOptionCheck"
                               title="The haze thins as the camera climbs, so the chip shows from up high. Unticked, it stays as thick as it is down by the chip, however high you fly">
                            <input id="gameHazeClimbs" type="checkbox" />
                            Haze thins with height
                        </label>

                        <label class="gameOptionCheck gameForAir"
                               title="Up and the mouse forward pull the nose up, rather than push it down the way a stick does">
                            <input id="gameInvertPitch" type="checkbox" />
                            Invert pitch
                        </label>

                        <label class="gameOptionCheck gameForCar"
                               title="Guardrails: the car cannot drive off the edge of what it is on. And it climbs any wall it drives into - a via up to the metal over it. A jump is still the way off">
                            <input id="gameLockOn" type="checkbox" />
                            Lock on
                        </label>

                        <label class="gameOptionCheck gameForCar"
                               title="Four jumps, one a press, coming back by themselves at one every two seconds. Run dry, the meter has to fill all the way - eight seconds - before the car jumps again">
                            <input id="gameLimitJump" type="checkbox" />
                            Limit jump
                        </label>

                        <label class="gameOptionCheck"
                               title="A grid on the layers' tops, their walls shaded and the metal polished - and a layer's own texture, where it has one. The 3D view's Show textures, ticked as the game starts and put back when it stops">
                            <input id="gameTexture" type="checkbox" />
                            Apply texture
                        </label>

                        <label class="gameOptionCheck"
                               title="The layers' edges and the grid on their tops lit in each layer's own color over darker faces, a glow round everything bright - the electrons, the shots, the flame - the backdrop dimmed, and a haze over the distance">
                            <input id="gameNeon" type="checkbox" />
                            Neon glow
                        </label>

                        <label class="gameOptionCheck" title="The engine, the tires on a hard turn or a hard stop, a blip for every jump, the horn and the shots. M switches it too">
                            <input id="gameSound" type="checkbox" />
                            Sound
                        </label>

                        <label class="gameOptionCheck" title="A tune for each: synthwave in the car, 8-bit in the plane and the jet. Sound off silences it too">
                            <input id="gameMusic" type="checkbox" />
                            Music
                        </label>
                    </div>
                </div>
            </div>

            @*
                Across the top of the view: the score, and under it Limit jump's meter - a cell a jump, filled by the interop
                as the jumps come back, and hidden unless the jumps are limited in the car. See ChipGame.showHud.

                In the plane and the jet the weapons' heat is there instead: a bar for the gun and, in the jet, one for the
                missiles, filled by the interop as they heat - see ChipGame.showHeat. Not in the jet in first person, where
                its HUD says it.
            *@
            <div class="gameTop">
                <div class="gameScore" title="Ten for every electron driven into or shot down">
                    Score <output id="gameScore">0</output>
                </div>

                <div id="gameJumps" class="gameJumps" hidden title="Jumps left. Run dry, it has to fill again before the next">
                    <span class="gameJumpsName">Jumps</span>
                    <span class="gameJumpCell"><span class="gameJumpFill"></span></span>
                    <span class="gameJumpCell"><span class="gameJumpFill"></span></span>
                    <span class="gameJumpCell"><span class="gameJumpFill"></span></span>
                    <span class="gameJumpCell"><span class="gameJumpFill"></span></span>
                </div>

                <div id="gameHeat" class="gameHeat" hidden>
                    <span id="gameHeatGun" class="gameHeatOne"
                          title="How hot the gun is. Three seconds of fire overheats it, and then it fires nothing until it has cooled all the way - five seconds">
                        <span class="gameHeatName">Gun</span>
                        <span class="gameHeatCell"><span class="gameHeatFill"></span></span>
                    </span>
                    <span id="gameHeatMissiles" class="gameHeatOne"
                          title="How hot the missiles are. Three seconds of fire overheats them, and then they fire nothing until they have cooled all the way - five seconds">
                        <span class="gameHeatName">Missiles</span>
                        <span class="gameHeatCell"><span class="gameHeatFill"></span></span>
                    </span>
                </div>
            </div>

            @*
                Where the gun's rounds go, in the plane and the jet - the jet's only from behind it, its HUD being the sight in
                first person - and in the jet a bracket round the electron a missile would go after. Put over their places on
                screen every frame by the interop - see ChipGame.showSights.
            *@
            <div id="gameCrosshair" class="gameCrosshair" hidden></div>
            <div id="gameLock" class="gameLock" hidden></div>

            @*
                The jet's HUD, in the middle of the view: its pitch ladder, heading, speed, height and bank, drawn by the interop
                every frame while the jet is flown in first person - see ChipGame.showJetHud - and the pointer through it to the
                view.
            *@
            <canvas id="gameJetHud" class="gameJetHud" hidden aria-hidden="true"></canvas>

            <div id="gameToast" class="gameToast" aria-live="polite"></div>
        }
    </div>

    @*
        The file's cells down the left of the scene, while the shell's Cells switch is on - the 2D view's tree, read
        rather than worked on: a press on a placement or a shape puts the camera on it. See CellTree3D.
    *@
    @if (CellTreeOpen)
    {
        <CellTree3D Gds="Gds" Layout="layout" OnClosed="OnCellTreeClosed" OnGoTo="goTo"
                    AutoPreview="AutoPreview" OnAutoPreviewChanged="OnAutoPreviewChanged" />
    }

    @*Fixed to the window rather than to this corner of it, so it does not matter where in here it sits.*@
    <QR @ref="qrCodeComponent" />
</div>

@code {
    #region Components ***************************************

    //Filled in by @ref, so null until this component has rendered once.
    private QR? qrCodeComponent;

    #endregion ***********************************************

    #region Variables ****************************************

    private bool isFirstRender = true;

    private FlattenedLayout? layout = null;

    ///
    ///The file <see cref="layout"/> and <see cref="merged"/> were built from.
    ///
    ///**Reference equality against the file, which is the only thing that says the geometry changed.** The
    ///spacing slider, a layer toggle and a redraw all hand the same object back; a different object is a
    ///different file, or a session restored. An edit mutates a library in place and so slips past this, which
    ///is why the 2D view re-flattens unconditionally after one. There is no editor here, but the file can still
    ///change under this view - the assistant's window stays up across views, and the MCP server edits whichever
    ///one is showing - so the shell says so, and this is forgotten: see FileEditedInPlace.
    ///
    private GDS? flattenedFrom = null;

    ///<summary>The file this view had drawn and was told has changed in place, until it is built again - see FileEditedInPlace.</summary>
    private GDS? editedInPlace = null;

    ///
    ///**The file changed in place**, by something other than this view: the assistant, or the MCP server. The next draw
    ///builds its scene again rather than drawing the one from before the change.
    ///
    ///**The same file, so not a new arrival**: the camera stays where somebody put it, and the shell is not told a scene
    ///is ready - nothing was waiting on one. See takeNewFile.
    ///
    public void FileEditedInPlace()
    {
        if (flattenedFrom is null)
            return;

        editedInPlace = flattenedFrom;
        flattenedFrom = null;
    }

    ///<summary>
    ///Each layer's geometry merged into as few outlines as cover the same ground.
    ///
    ///**Because two slabs at the same height fight over which is in front.** A layer's shapes are allowed
    ///to overlap - 171 of the 897 bundled cells have a layer that does - and extruded separately their top
    ///faces land on exactly the same plane, which is the one thing a depth buffer cannot decide. The
    ///result flickers between the two as the camera moves. Merged, there is one face.
    ///
    ///Held rather than recomputed, because it depends only on the file. The spacing slider redraws the
    ///whole scene on every step of a drag and changes no geometry, so running a clipping pass over the
    ///layout there would be the most expensive thing in the app happening for no reason at all - which,
    ///until <see cref="flattenedFrom"/> existed, is exactly what it did.
    ///
    ///**The layers are held by reference**, which is what lets the slider work at all without re-merging:
    ///`SetStackingOffsets` writes new heights onto the very `Layer` objects these outlines point at.
    ///</summary>
    private List<Booleans.Outline> merged = new List<Booleans.Outline>();

    ///
    ///Where the Distance slider is, which is now also where a newly opened file gets stacked.
    ///
    ///**Started at the number a file actually opens at.** This was 10 - under the slider's own minimum of
    ///50, so the browser clamped the thumb to 50 and the mismatch never showed. It shows the moment this
    ///value is applied to a file, which is what <see cref="Render"/> does below, so it has to be the same
    ///default the library stacks with rather than a number that only looked right while nothing read it.
    ///
    ///That number is zero now, and the slider's minimum is zero with it: the spacing is the spread
    ///added to the process stack rather than a distance measured from the even stack's rung height, so a
    ///file opens at the heights its layermap gives it. See DefaultLayerSpread.
    ///
    private int userSetlayerSpacing = AdditionalGDSInformation.DefaultLayerSpread;

    ///<summary>The scene backdrop, kept so it can be written into a session and put back.</summary>
    private string background = "none";

    ///
    ///The backdrop a game is played against: Neon, put up as it starts. The view's settings change it while the game runs,
    ///as they change the game's draw distance and textures.
    ///
    private const string GameBackdrop = "background4.jpg";

    ///
    ///The view's own backdrop while a game has put its own up in its place, or null while no game has - see ToggleGame.
    ///
    ///**It is the one a session keeps**, and the one stopping puts back: the game's is the game's, the way its draw
    ///distance and textures are - see ChipGame.start in ThreeInterop.js. Kept since 2026-10-14, when games started
    ///against Neon.
    ///
    private string? backdropBeforeGame = null;
    private bool cinematicViewToggle = false;

    ///<summary>Whether the chip game is running. Not saved: a game is something being played, not a setting.</summary>
    private bool gameRunning = false;
    private bool hidden = true;
    public string ModelDownloadFileType { get; set; } = ".stl";

    ///<summary>
    ///How tall a label is drawn, in layout units. Matches the 2D view's font size so the two views agree
    ///on how big a pin name is next to the geometry it names.
    ///</summary>
    private const int LabelHeight = 60;


    //Null until the shell has a file open, which is the state the view starts in.
    [Parameter]
    public GDS? Gds { get; set; }
    [Parameter]
    public List<CheckboxItem>? ShowLayers { get; set; }

    ///<summary>
    ///Raised when one of this view's own controls moves, so the shell can keep the session current.
    ///
    ///The shell cannot see these otherwise - a slider lives in the view that owns it and re-renders only
    ///itself - so without this an opacity or a layer spacing was written to a session solely by chance,
    ///whenever something else happened to trigger a save afterwards.
    ///</summary>
    [Parameter]
    public EventCallback OnSettingsChanged { get; set; }


    ///
    ///Raised when what the shell draws of this view has to be drawn again - the settings under its cube opening or
    ///closing, or a tick in them moving - and nothing else.
    ///
    ///**The bar is rendered by the shell, not by this view.** A RenderFragment handed over is drawn during
    ///*that* component's render, so this one calling StateHasChanged draws the view and leaves the bar
    ///exactly as it was. The 2D view learned this the same way, with a menu that opened only when
    ///something else happened to redraw the page.
    ///
    [Parameter]
    public EventCallback OnToolChanged { get; set; }

    ///
    ///Raised once a file's scene has been built, so the shell can take down the note that says it is loading.
    ///Once per file: a toggled layer or a spacing step builds again without anybody waiting on it.
    ///
    [Parameter]
    public EventCallback OnDrawn { get; set; }

    ///<summary>Whether a file has arrived whose scene the shell has not been told about yet.</summary>
    private bool announceDrawn = false;

    ///
    ///The load that file arrived as part of, whose pace its first scene is built at - or null for one that came
    ///without a load. Kept from the merge rather than read off <see cref="Loading"/> at the draw, which by then can
    ///be the next load's: the way back from a cancel of this one, which would build this file's scene at its pace.
    ///
    private Pacer? scenePace = null;

    ///<summary>Names the exported model after the file on screen.</summary>
    [Parameter]
    public string FileName { get; set; } = "";

    ///<summary>
    ///The bundled example a link can name, or null when what is open is not one - an upload, or a file the
    ///page around the app brought. For the QR code, because the address does not follow what is open.
    ///</summary>
    [Parameter]
    public string? LinkFile { get; set; }

