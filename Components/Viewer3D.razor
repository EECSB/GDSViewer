    ///
    ///A placement or a shape pressed in the tree: the camera put on that box of the layout, and a frame flashed round it -
    ///see frameCameraOnInterOp. Nothing while Admire, a game or a headset has the camera.
    ///
    private async Task goTo(Bounds box)
    {
        await js.InvokeVoidAsync("frameCameraOnInterOp", box.Left, box.Bottom, box.Right, box.Top);
    }

    ///
    ///Asks the shell for its load in hand, or null - what a file's layers are merged at the pace of, so the page
    ///answers while a big one is merged and Cancel can stop it. See Render and Pacer.
    ///
    ///A parameter rather than an argument, for the reason the 2D view's Prepared is one: this view draws itself as
    ///it mounts, before the shell can hand it anything, and Blazor sets parameters before that. And a question
    ///rather than a value for the 2D view's reason - see its Loading.
    ///
    [Parameter]
    public Func<Pacer?>? Loading { get; set; }

    ///
    ///**The view's own settings**, which hang from the cube of the shell's view switch while this view is on: the shell
    ///draws them under it, asks for them with ShowViewSettings and puts them away with OnViewSettingsDismissed. See the
    ///switch in Viewer.razor.
    ///
    public RenderFragment SettingsMenu => (__builder) =>
    {
        @*
            How far the view draws, and whether the layers show their textures - a grid on the tops, the walls shaded,
            the metal polished, and a layer's own picture where it has one.

            The game's panel has the same two, and they are these: a game turns the textures on and draws everything as
            it starts, has them while it runs, and puts them back the way they were when it stops. So the interop keeps
            them - in this browser, see VIEW_OPTIONS in ThreeInterop.js - and the menu reads them from it as it opens,
            and moves them there as they change, rather than this view holding a copy the game would not know about.

            **And Admire and the backdrop**, so the view's settings are all in one place - and both are set here and
            nowhere else since 2026-10-17. Admire had a button in the view's corner, and the backdrop one of its own
            along the bar, beside one for this menu; the cube took the menu and the menu took the two. Admire is set
            through cinematicView, so a game stops for it. Unlike a menu that asks one question, this one stays open as a
            backdrop is chosen: it is one of several things set here, and the next to try is a press away.
        *@
        <div id="viewSettingsMenu" class="shapePicker viewSettingsMenu" role="group" aria-label="3D view settings">
            <label class="viewSetting" for="viewDrawDistance"
                   title="How far the view reaches past the near side of the layout, as a share of the chip's width. All draws all of it; less fades the far side into the background">
                <span class="viewSettingName">Draw distance</span>
                <input id="viewDrawDistance" type="range" min="0.05" max="1" step="0.05"
                       value="@drawDistance.ToString(CultureInfo.InvariantCulture)" @oninput="drawDistanceMoved" />
                <output id="viewDrawDistanceSaid" class="viewSettingSaid" for="viewDrawDistance">@drawDistanceSaid()</output>
            </label>

            <div class="form-check form-switch settingsSwitch"
                 title="A grid on the layers' tops, their walls shaded and the metal polished - and a layer's own texture, where it has one. Off, the flat colors">
                <input id="viewTextures" class="form-check-input" type="checkbox" role="switch"
                       checked="@showTextures" @onchange="texturesToggled" />
                <label class="form-check-label" for="viewTextures">Show textures</label>
            </div>

            <div class="form-check form-switch settingsSwitch"
                 title="Slowly orbit the camera around the layout. A game stops for it">
                <input id="viewAdmire" class="form-check-input" type="checkbox" role="switch"
                       checked="@cinematicViewToggle" @onchange="admireToggled" />
                <label class="form-check-label" for="viewAdmire">Admire</label>
            </div>

            <div id="viewBackground" class="viewSettingBackdrops"
                 role="group" aria-labelledby="viewBackgroundName">
                <span id="viewBackgroundName" class="viewSettingName">Background</span>

                @*
                    **A picture of each one, because the names were guesses.** "Future Room" and "Neon" are what
                    somebody called two photographs, and no arrangement of words says what a backdrop looks like -
                    which is the whole question being asked. The menu shows them.

                    The pictures are 128 pixels wide and a couple of kilobytes each, generated once from the
                    backdrops and committed beside them. The backdrops themselves run to nine megabytes, so a menu
                    that showed those would fetch thirteen to open.
                *@
                @foreach ((string file, string says) in Backdrops)
                {
                    <button class="shapePick backgroundPick @(background == file ? "shapePickOn" : "")"
                            data-background="@file"
                            @onclick="() => backdropChosen(file)">
                        <span class="shapePickMark">@(background == file ? "✓" : "")</span>

                        @*
                            The plain scene has no photograph, so its swatch is the gray the scene
                            actually is - which is a truer preview than a crossed-out box.
                        *@
                        @if (file == "none")
                        {
                            <span class="backgroundSwatch backgroundSwatchPlain"></span>
                        }
                        else
                        {
                            <img class="backgroundSwatch" src="./resources/Images/Background/preview/@file" alt="" />
                        }

                        <span class="backgroundName">@says</span>
                    </button>
                }
            </div>
        </div>
    };

    ///<summary>This view's own toolbar controls. The shell renders them; it does not know what they are.</summary>
    public RenderFragment Toolbar => (__builder) =>
    {
        @*
            The model download and the format it writes, as one control - the same pair the shell's own
            download makes with its .gds/.oas picker, and for the same reason: neither half means anything
            without the other.

            The icon was a PNG on a bare <img> with a cursor over it, which is what every button in this bar
            used to be. Drawn inline on a blue square now, so it takes the button's color, stays sharp at
            any zoom, and is reachable by keyboard - an <img> with an @@onclick never was.
        *@
        <div class="col-1 toolbarItem toolbarGroupEnd" style="align-self: end;">
            <div class="joinedPair">
                <button id="downloadModel" class="buttonStyle2 toolbarButton buttonIcon fileButton joinedStart"
                        @onclick="download3DObject"
                        aria-label="Download 3D model"
                        title="Download 3D model">
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" stroke-linejoin="round"
                              d="M8 1.8v8.8M4.8 7.4 8 10.6l3.2-3.2M2.2 10.4v2.6a1.2 1.2 0 0 0 1.2 1.2h9.2a1.2 1.2 0 0 0 1.2-1.2v-2.6" />
                    </svg>
                </button>

                @*value plus @@onchange rather than @@bind, so the shell hears about it and can save.*@
                <select id="modelFormat" class="formatPicker joinedEnd" value="@ModelDownloadFileType" @onchange="changeModelFileType"
                        aria-label="3D file type"
                        title="Which 3D format the download button beside this saves the model in">
                    <option value=".stl">STL</option>
