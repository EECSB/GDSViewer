    #endregion ***********************************************



    #region Initialization ***********************************

    //Async Task rather than async void: an exception out of a void one cannot be awaited by anything, so
    //it never reaches Blazor's error handling and is lost as an unobserved rejection. That matters most
    //here, where the first render sets up WebGL and a failure would otherwise leave a blank canvas and
    //nothing in the console to say why.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        isFirstRender = firstRender;

        if (firstRender)
        {
            viewerNumber = ++viewersBuilt;

            await js.InvokeVoidAsync("registerThree", viewerNumber);
            await js.InvokeVoidAsync("startRender3DInterOp");

            //Applied here rather than only in ApplySettings, because a restored session hands its settings
            //over before this view has had its first render - so the scene did not exist to be dressed yet
            //and that call was ignored. Everything else in a session is C# state that survives the wait;
            //the background is the one piece that lives in the scene.
            if (background != "none")
                await js.InvokeVoidAsync("changeBackgroundInterOp", background);

            //One listener for the life of the view rather than one per opening, which would have to be
            //taken away again by every path that closes the menu. The 2D view hangs up its own the same way.
            //The menu's opener is the shell's cube, which it hangs from - see SettingsOpener.
            menuHandle ??= DotNetObjectReference.Create(this);

            await js.InvokeVoidAsync("registerBarMenu", menuHandle, "viewSettingsMenu", SettingsOpener, "OnViewSettingsDismissed");

            //The same handle, for where the camera comes to rest. Registered before the draw, so a turn of
            //the wheel during a slow one is still heard.
            await js.InvokeVoidAsync("registerCamera", menuHandle);

            await Render(Gds, ShowLayers);
        }

        //
        //And the camera goes back where a session left it, once there is a viewer to move.
        //
        //Here rather than in ApplySettings for the same reason the backdrop is: a restored session hands its
        //settings over *before* this view has had its first render, so there was nothing to point yet.
        //
        //**This does now compete with a fit**, unlike when the camera opened at a fixed distance and stayed
        //there. The first draw of a file frames it - see frameAfterDrawing - so the two are ordered rather
        //than left to race: that fit is skipped outright when there is a camera waiting here, and this
        //lands afterwards in the case where it is not.
        //
        if (cameraToRestore.Length > 0)
        {
            string camera = cameraToRestore;
            cameraToRestore = "";

            await js.InvokeVoidAsync("applyCameraInterOp", camera);
        }
    }

    #endregion ***********************************************



    #region Methods ******************************************

    private void getQRCode()
    {
        //Only reachable from a button inside this component's own markup, so the @ref is filled by now.
        if (qrCodeComponent is null)
            return;

        //
        //The whole address, not just the base, with the file, this view and the camera written into it:
        //scanning it on a headset or phone opens this file's 3D view looking where this one is, rather than
        //dropping you in the 2D one to find it again. Written here because the address follows neither the
        //file nor the camera - see the shell's takeOutOfAddress. A file no link can reach is taken out rather
        //than left out, since inside an iframe the address can still name the one the page opened with.
        //
        var wanted = new Dictionary<string, object?>
        {
            ["file"] = LinkFile,
            ["view"] = "3d"
        };

        if (cameraSeen.Length > 0)
            wanted["camera"] = cameraSeen.Replace(' ', ',');

        qrCodeComponent.GenerateQRCode(Navigation.GetUriWithQueryParameters(wanted));
    }

    ///<summary>Coalesces a drag across the spacing slider; see <see cref="Settling"/>.</summary>
    private readonly Settling settlingSpacing = new Settling();

    ///
    ///Where each layer sits in the stacking order, by pair.
    ///
    ///Built once per draw and handed over with each shape, so the slider can restack what is on screen
    ///without another marshal - see <see cref="restackLayers"/>. Rebuilt rather than kept, because a file
    ///opening or an edit can add a layer and shift everything above it.
    ///
    private Dictionary<LayerKey, int> stackingOrder = new Dictionary<LayerKey, int>();

    private int stackedAt(LayerKey key)
    {
        if (stackingOrder.TryGetValue(key, out int at))
            return at;

        return 0;
    }

    ///
    ///Notes where each layer sits in the order, before anything is described by it.
    ///
    ///Called at the top of a draw rather than only from the slider, because the index goes over *with* each
    ///shape - built afterwards, every shape would have gone over as layer zero and a restack would have
    ///moved the whole scene to one height.
    ///
    private void takeStackingOrder()
    {
        stackingOrder = new Dictionary<LayerKey, int>();

        if (Gds is null)
            return;

        var ordered = Gds.AdditionalInformation.OrderedLayers();

        for (int at = 0; at < ordered.Count; at++)
            stackingOrder[ordered[at].Key] = at;
    }

    ///
    ///Whether this layer has a place on the wafer, and so a place in this view.
    ///
    ///**True for everything on a file with no process table**, which is every file that has not been given
    ///a layermap with heights in it. There the even stack this view draws is the only statement about
    ///order there is, and leaving layers out of it would empty the view of most files.
    ///
    ///Once a file does carry heights, though, a layer without one is not a layer sitting a little wrong -
    ///it is a layer the process table says nothing about, and its offset is its index in a list. That is
    ///a marker, an area id, a pin or label purpose no row was written for. It is drawn in 2D as it always
    ///was and it keeps its row in the sidebar; what it does not get is a slab at a height nobody chose.
    ///Give it a height in the layer settings and it comes back, because then somebody has chosen one.
    ///
    private bool stacked(Layer layer)
    {
        if (Gds is null)
            return true;

        if (!Gds.AdditionalInformation.HasProcessStack)
            return true;

        return layer.CustomHeight is not null;
    }

    ///
    ///Moves the layers already in the scene, rather than building it again.
    ///
    ///**This is what makes the slider live.** It was settled instead - one redraw once the drag stopped -
    ///because a redraw hands three.js the whole scene: measured at 7.6 seconds per step on a
    ///twenty-thousand-element layout, so applying every step made a drag a minute and a half of frozen tab.
    ///The debounce was the right answer to that cost and the wrong answer to the question, which is that
    ///moving a layer up the stack is a Y translation on geometry that is already built.
    ///
    ///So the offsets go over on their own - one number per layer, tens of them, no geometry - and the view
    ///sets the height of each mesh and each label it already has. The settled full redraw stays behind it,
    ///because the session still has to be written and a layer that has just become visible still has to be
    ///built; what has moved off the drag is the part that cost seconds.
    ///
    private async Task restackLayers()
    {
        if (Gds is null)
            return;

        takeStackingOrder();

        var ordered = Gds.AdditionalInformation.OrderedLayers();

        var offsets = new int[ordered.Count];

        for (int at = 0; at < ordered.Count; at++)
            offsets[at] = ordered[at].Value.Offset;

        await js.InvokeVoidAsync("restackLayers", offsets);
    }

    ///
    ///How far apart the layers are stacked.
    ///
    ///**Split in two rather than settled.** This is bound `@oninput` and every step used to hand three.js the
    ///whole scene again: measured at 7.6 seconds per step on a twenty-thousand-element layout, so a drag
    ///across the control was a minute and a half of frozen tab, and the answer at the time was to apply it
    ///once the drag stopped. Caching the merge behind it - see <see cref="flattenedFrom"/> - took a large
    ///part of the per-step cost off and nowhere near all of it, because what was left was the marshal and the
    ///rebuild rather than anything computed here.
    ///
    ///What was wrong with that answer is that moving a layer up the stack is a Y translation on geometry that
    ///is already built, so the cheap half now runs every step and only the redraw and the session write are
    ///settled - see <see cref="restackLayers"/> and <see cref="sliderChanged"/>.
    ///
    ///<summary>
    ///How far apart the layers are stacked, for the sidebar - which renders the slider now, and has no other
    ///way to read where it should sit.
    ///</summary>
    public int LayerSpacing
    {
        get { return userSetlayerSpacing; }
    }

    ///<summary>Public for the same reason: the control lives in the shell's sidebar and reports back here.</summary>
    public async Task AdjustLayerSpacing(ChangeEventArgs e)
    {
        await sliderChanged(e);
    }

    ///
    ///How far the Distance slider reaches, which the box beside it sets.
    ///
    ///**One reach does not suit every file.** The slider stopped at 700, which pulls a standard cell well apart
    ///and does little to a chip a couple of hundred microns across with thirty layers in it, where the stack at
    ///the slider's end was still a sliver against the width of the layout. Typed rather than worked out from the
    ///file, since how far apart is far enough depends on what somebody wants to see between.
    ///
    ///Saved with the distance, so a file left pulled wide comes back that way.
    ///
    private int spacingRange = 700;

    ///<summary>The least the reach can be. The slider's own steps are ones, so a reach of 100 is already fine.</summary>
    public const int LeastSpacingRange = 100;

    ///
    ///The most it can be. Each layer is lifted by the distance times its place up the stack, in 32-bit integers,
    ///so a file would need over twenty thousand places in its stack to run out at this - and a hundred thousand a
    ///step already stands thirty layers far taller than any bundled design is wide.
    ///
    public const int MostSpacingRange = 100000;

    ///<summary>How far the slider reaches, for the box the shell renders beside it.</summary>
    public int SpacingRange
    {
        get { return spacingRange; }
    }

    ///
    ///Sets how far the slider reaches, from the box beside it.
    ///
    ///**A distance past the new reach comes down to it**, so the slider and the stack go on agreeing: a thumb
    ///pinned to the end of its track while the stack is drawn wider than that would be the control misreporting
    ///the picture. Raising the reach moves nothing, since the thumb only gets a longer track to slide along.
    ///
    ///**Taken on a change, not on every keystroke**, which is why the box is bound @onchange. Typing 5000 passes
    ///through 5, 50 and 500 on the way, and each of those would have pulled the distance down with it.
    ///
    public async Task AdjustSpacingRange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int given))
            return;

        spacingRange = Math.Clamp(given, LeastSpacingRange, MostSpacingRange);

        if (userSetlayerSpacing > spacingRange)
        {
            await spreadLayers(spacingRange);

            return;
        }

        await OnSettingsChanged.InvokeAsync();
    }

    private async Task sliderChanged(ChangeEventArgs e)
    {
        await spreadLayers(Convert.ToInt32(e.Value, CultureInfo.InvariantCulture));
    }

    ///<summary>Spreads the stack to a distance: the slider's, or a reach brought down under where it was.</summary>
    private async Task spreadLayers(int spacing)
    {
        userSetlayerSpacing = spacing;

        //The slider is only reachable with a file on screen, but nothing in the type system says so.
        if (Gds is null)
            return;

        //
        //Every step, because this is the part that has to keep up with the thumb.
        //
        //One step per layer, which is the rule the initial stacking uses too - hence calling into it rather
        //than repeating the walk here, where the two could come to disagree about what a step is.
        //
        Gds.AdditionalInformation.SetStackingOffsets(userSetlayerSpacing);

        await restackLayers();

        //And the expensive half once the drag stops: the session write, and a redraw so anything the scene
        //does not already hold - a layer switched on mid-drag - is built. See restackLayers for why the
        //cheap half is no longer behind this.
        await settlingSpacing.After(async () =>
        {
            await Render(Gds, ShowLayers);

            await OnSettingsChanged.InvokeAsync();
        });
    }

    ///
    ///The backdrops, in the order the menu lists them, with what each is called.
    ///
    ///The names are somebody's, and are kept: they are what a returning user recognizes. What they are not
    ///is a description, which is why each row shows the thing itself.
    ///
    ///Public for the share popup, which offers the same five for an embed and should not keep a list of its own.
    ///
    public static readonly (string File, string Says)[] Backdrops = new[]
    {
        ("none", "No Background"),
        ("background1.jpg", "White"),
        ("background2.jpg", "White Room"),
        ("background3.jpg", "Future Room"),
        ("background4.jpg", "Neon")
    };

    ///<summary>Held so the dismissal listener can call back into this component. Disposed with the view.</summary>
    private DotNetObjectReference<Viewer3D>? menuHandle;

    ///
    ///Which of the page's 3D viewers this view built, so that its teardown takes down that one and no other.
    ///
    ///**Numbered, because the order is not this view's to choose.** The view being left and the one replacing
    ///it can be a render apart, and by the time the old one's teardown arrives the new one may have built a
    ///viewer of its own. See unregisterThree in ThreeInterop.js.
    ///
    private static int viewersBuilt = 0;

    private int viewerNumber = 0;

    ///<summary>Where the camera is, as its position and what it orbits, or empty until it has been moved.</summary>
    private string cameraSeen = "";

    ///<summary>The one a session carried, applied once there is a viewer to move. Cleared as it is used.</summary>
    private string cameraToRestore = "";

    ///<summary>
    ///Whether the draw about to happen is the first of a file, and so the one that should frame it.
    ///
    ///Set beside <see cref="flattenedFrom"/>, which is the only thing here that means "a file this view has
    ///not drawn yet" - a layer toggle and a spacing step both arrive with the same file and must not move
    ///the camera.
    ///</summary>
    private bool frameAfterDrawing = false;

    ///
    ///Where the camera came to rest, kept so the session can put it back.
    ///
    ///Reported on settle rather than per frame - an orbit is a stream of events and only the last of them is
    ///worth keeping - and never while Admire is running, since that turns the camera itself and what it
    ///would save is an arbitrary point on a circle. See reportCameraWhenStill for both.
    ///
    ///Unchanged is not a change: putting the camera back through the controls raises the same event that
    ///reports it, and without this that would be one session write for every restore.
    ///
    [JSInvokable]
    public async Task OnCameraSettled(double x, double y, double z, double atX, double atY, double atZ)
    {
        //Invariant, because a session written where decimals are commas has to be readable where they are not.
        string where = string.Join(' ',
            x.ToString(CultureInfo.InvariantCulture),
            y.ToString(CultureInfo.InvariantCulture),
            z.ToString(CultureInfo.InvariantCulture),
            atX.ToString(CultureInfo.InvariantCulture),
            atY.ToString(CultureInfo.InvariantCulture),
            atZ.ToString(CultureInfo.InvariantCulture));

        if (where == cameraSeen)
            return;

        cameraSeen = where;

        await OnSettingsChanged.InvokeAsync();
    }

    ///
    ///A backdrop chosen in the view's settings, which stay open - see the menu. Drawn again for the tick, the menu being
    ///drawn by the shell; see OnToolChanged.
    ///
    private async Task backdropChosen(string file)
    {
        await putBackdropUp(file);

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>The backdrop `file` up behind the scene, and the session told. Nothing when it is the one up already.</summary>
    private async Task putBackdropUp(string file)
    {
        if (file == background)
            return;

        background = file;

        await js.InvokeVoidAsync("changeBackgroundInterOp", background);

        await OnSettingsChanged.InvokeAsync();
    }

    private async Task changeModelFileType(ChangeEventArgs e)
    {
        ModelDownloadFileType = e.Value?.ToString() ?? ".stl";

        await OnSettingsChanged.InvokeAsync();
    }

    ///
    ///The id of the cube in the shell's view switch, which this view's settings hang from: the opener the listener for a
    ///press anywhere else leaves alone, pressing it being how the menu is asked for - see registerBarMenu. The shell gives
    ///the cube this id, so the two cannot name it two ways.
    ///
    public const string SettingsOpener = "viewPick3D";

    ///<summary>Whether the view's settings menu is showing. Not saved: it is a panel being open.</summary>
    private bool viewSettingsOpen = false;

    ///<summary>Whether the shell is to draw the settings under its cube - see SettingsMenu.</summary>
    public bool ViewSettingsOpen => viewSettingsOpen;

    ///<summary>
    ///What the menu shows of the view's own settings - the draw distance, a share of the chip's width from a twentieth
    ///to all of it, and Show textures - as the interop had them when it opened. See ShowViewSettings.
    ///</summary>
    private double drawDistance = 1;
    private bool showTextures = false;

    ///
    ///Opens the view's settings menu, saying what the settings are on the scene now: a game's, while one runs, since its
    ///panel sets the same two. Read each time it opens for that reason, rather than kept here.
    ///
    ///Public for the shell, whose cube asks for it - pressed, or pointed at, while this view is on.
    ///
    public async Task ShowViewSettings()
    {
        if (viewSettingsOpen)
            return;

        try
        {
            var options = await js.InvokeAsync<ViewOptions>("viewOptionsInterOp");

            drawDistance = options.DrawDistance;
            showTextures = options.Textures;
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            //The menu opens with what it last showed rather than not at all, and the console says why that may not
            //be what the scene has.
            Console.WriteLine($"The 3D view's settings could not be read off the scene, so the menu shows the last ones it had: {ex.Message}");
        }

        viewSettingsOpen = true;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///Puts the menu away: a press somewhere other than it or the cube, through the listener the 2D view's menus share,
    ///and the pointer leaving the two, through the shell. Public and JSInvokable for both.
    ///
    [JSInvokable]
    public async Task OnViewSettingsDismissed()
    {
        if (!viewSettingsOpen)
            return;

        viewSettingsOpen = false;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///The draw distance, onto the scene as the slider moves. **Not drawn again here**: the bar is the shell's, and a
    ///render of the whole shell for every step of a drag is what a slider must not cost - the interop says the new share
    ///beside it instead, the way it does when the game's panel moves it. See Viewer3D.showViewMenu in ThreeInterop.js.
    ///
    private async Task drawDistanceMoved(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value))
            return;

        drawDistance = value;

        await js.InvokeVoidAsync("setViewOptionInterOp", "drawDistance", value);
    }

    ///<summary>Show textures, onto the scene - every layer's, at once.</summary>
    private async Task texturesToggled(ChangeEventArgs e)
    {
        showTextures = e.Value is bool on && on;

        await js.InvokeVoidAsync("setViewOptionInterOp", "textures", showTextures);
    }

    ///
    ///Admire from the view's settings, the one place it is set: a game running stops for it - see cinematicView. Drawn
    ///again after, for the backdrop's tick: a game stopping puts the view's own backdrop back.
    ///
    private async Task admireToggled(ChangeEventArgs e)
    {
        bool on = e.Value is bool value && value;

        if (on != cinematicViewToggle)
            await cinematicView();

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>The draw distance as the menu says it: All at the end that draws everything, a percentage short of it.</summary>
    private string drawDistanceSaid()
    {
        if (drawDistance >= 1)
            return "All";

        return FormattableString.Invariant($"{Math.Round(drawDistance * 100)}%");
    }

    ///<summary>The view's own settings as the interop has them - see viewOptionsInterOp in ThreeInterop.js.</summary>
    private sealed class ViewOptions
    {
        public double DrawDistance { get; set; } = 1;
        public bool Textures { get; set; }
    }

    ///<summary>
    ///The four controls this view owns, the camera among them.
    ///
    ///It was not, once, and the reasoning against it was that an orbit is where you happen to be looking
    ///rather than a setting. What settled it the other way is that a view somebody has turned to see
    ///between two layers is a view they *arranged*, and handing it back is the whole reason to have looked.
    ///Coming back to the opening angle instead throws that away every time.
    ///</summary>
    public void WriteSettings(SavedSession session)
    {
        session.LayerSpacing = userSetlayerSpacing;
        session.SpacingRange = spacingRange;
        session.Background = backdropBeforeGame ?? background;
        session.ModelFileType = ModelDownloadFileType;
        session.View3DCamera = cameraSeen;
    }

    ///<summary>
    ///Applied before the first draw, so the stack is already spread and the scene already dressed rather
    ///than jumping to it. The background is the one that has to reach JS, since the scene owns it.
    ///</summary>
    public async Task ApplySettings(SavedSession session)
    {
        userSetlayerSpacing = session.LayerSpacing;

        //Never short of the distance itself, so the thumb has somewhere to stand: a session written by hand can
        //carry a distance past the reach it names, and lowering the distance to fit would be changing the stack.
        spacingRange = Math.Clamp(Math.Max(session.SpacingRange, session.LayerSpacing), LeastSpacingRange, MostSpacingRange);

        //While a game runs its backdrop stays up, and the session's is the view's own, for stopping to put back.
        if (backdropBeforeGame is not null)
            backdropBeforeGame = session.Background;
        else
            background = session.Background;

        ModelDownloadFileType = session.ModelFileType;

        //Held rather than applied: there is no viewer yet on the path this arrives by. See the end of
        //OnAfterRenderAsync, where it lands.
        cameraToRestore = session.View3DCamera;

        if (Gds is not null)
            Gds.AdditionalInformation.SetStackingOffsets(userSetlayerSpacing);

        //Only worth the interop when it is not the default the scene starts at.
        if (background != "none")
            await js.InvokeVoidAsync("changeBackgroundInterOp", background);
    }

    ///<summary>
    ///Puts the whole stack back in the middle of the window, however far it has been orbited away from.
    ///
    ///Straight through to JS, because everything the answer depends on is there: where the meshes actually
    ///ended up, how wide the window is, and what angle the camera sees through. None of that is knowable
    ///from here, and a C# guess at it would be a second opinion about a scene it cannot see.
    ///</summary>
    public async Task CenterView()
    {
        await js.InvokeVoidAsync("centerCameraInterOp");
    }

    ///<summary>
    ///Zooms from the buttons beside Center: the camera toward or away from what it turns around, by the same
    ///notches as the 2D view. See zoomCameraInterOp, which also reports where the camera stopped.
    ///</summary>
    public async Task ZoomBy(int notches)
    {
        await js.InvokeVoidAsync("zoomCameraInterOp", notches);
    }

    ///<summary>
    ///Flashes one layer's slabs, for a press on its row in the layer list.
    ///
    ///**Which slab is which is the one thing this view cannot say.** Nine slabs seen at an angle, several of
    ///them the same size and some of them hidden behind others, and a list of names beside them that says
    ///nothing about where any of them is. In 2D a press on a row picks the layer to draw on; here there is
    ///nothing to draw, so the press is free to answer the question the view actually raises.
    ///
    ///Handed over as the stacking index rather than the layer pair, because that is what a slab was built
    ///knowing - see <see cref="stackedAt"/> and the userData a mesh carries for restacking.
    ///
    ///A layer with nothing on it has no slab and no place in the stack; nothing flashes, which is its own
    ///answer.
    ///</summary>
    public async Task PulseLayer(LayerKey key)
    {
        if (!stackingOrder.ContainsKey(key))
            return;

        try
        {
            await js.InvokeVoidAsync("pulseLayerInterOp", stackedAt(key));
        }
        catch { }
    }

    private async Task download3DObject()
    {
        await js.InvokeVoidAsync("download3DModelInterOp", FileName, ModelDownloadFileType);
    }

    private async Task cinematicView()
    {
        //
        //Admire switched on mid-game ends the game, for the reason starting a game turns Admire off: both fly the
        //camera. Left running, the game kept the camera and Admire said it was on and did nothing until it stopped.
        //
        if (!cinematicViewToggle && gameRunning)
        {
            gameRunning = false;

            await js.InvokeVoidAsync("stopGameInterOp");
            await putBackdropBack();
        }

        cinematicViewToggle = !cinematicViewToggle;

        await playSound(cinematicViewToggle);

        await js.InvokeVoidAsync("cinematicViewInterOp", cinematicViewToggle);
    }

    ///<summary>Whether the chip game is running, for the shell's Settings menu to say Play or Stop.</summary>
    public bool GameRunning => gameRunning;

    ///
    ///Starts the chip game, or stops the one that is running. The shell's, from its Settings menu.
    ///
    ///**Admire goes off first.** Both fly the camera every frame and only one of them can, and the switch that
    ///says it is on is this component's to turn off - so it is turned off here rather than overruled quietly in JS.
    ///
    ///The game can decline to start, when nothing drawn is left to drive on, and nothing is shown then.
    ///
    ///**Against Neon**, which a game starts with and stopping takes down again - see backdropBeforeGame.
    ///
    ///**A render of its own**, for the panel of keys: a press in the shell's menu renders the shell, and this
    ///component is not redrawn by that - see OnToolChanged.
    ///
    public async Task ToggleGame()
    {
        if (gameRunning)
        {
            gameRunning = false;

            await js.InvokeVoidAsync("stopGameInterOp");
            await putBackdropBack();
        }
        else
        {
            if (cinematicViewToggle)
                await cinematicView();

            menuHandle ??= DotNetObjectReference.Create(this);

            gameRunning = await js.InvokeAsync<bool>("startGameInterOp", menuHandle, layerNames());

            if (gameRunning)
                await putGameBackdropUp();
        }

        StateHasChanged();
    }

    ///Neon up behind a game that has just started, with the view's own backdrop kept for when it stops.
    private async Task putGameBackdropUp()
    {
        backdropBeforeGame = background;

        if (background == GameBackdrop)
            return;

        background = GameBackdrop;

        await js.InvokeVoidAsync("changeBackgroundInterOp", background);
    }

    ///
    ///The view's own backdrop back up as a game stops, whatever the view's settings put up while it ran - which was
    ///the game's. Nothing when no game put one up.
    ///
    private async Task putBackdropBack()
    {
        if (backdropBeforeGame is null)
            return;

        string own = backdropBeforeGame;

        backdropBeforeGame = null;

        if (own == background)
            return;

        background = own;

        await js.InvokeVoidAsync("changeBackgroundInterOp", background);
    }

    ///
    ///Each layer's name in stacking order, which is how a slab in the scene knows which layer it is.
    ///
    ///Handed over once when the game starts rather than with every shape, which is what keeps the draw's
    ///marshal the size it was - see packShapes.
    ///
    private List<string> layerNames()
    {
        var names = new List<string>();

        if (Gds is null)
            return names;

        foreach (var layer in Gds.AdditionalInformation.OrderedLayers())
            names.Add(layer.Value.DisplayName);

        return names;
    }

    ///<summary>The game's panel open again, after its × put it away. The shell's, from its Settings menu.</summary>
    public async Task ShowGamePanel()
    {
        if (!gameRunning)
            return;

        await js.InvokeVoidAsync("showGamePanelInterOp");
    }

    ///
    ///The game stopped by something other than the Settings menu: Escape, a headset, or nothing left to drive on. The
    ///view's own backdrop goes back up as it does for the menu - see putBackdropBack.
    ///
    [JSInvokable]
    public async Task OnGameEnded()
    {
        if (!gameRunning)
            return;

        gameRunning = false;

        await putBackdropBack();

        StateHasChanged();
    }

    private async Task playSound(bool playSound)
    {
        hidden = !playSound;

        StateHasChanged();
    }

    ///<summary>The merge of a file that has just arrived, while it is under way, and which file - see Render.</summary>
    private Task? arriving;

    private GDS? arrivingFile;

    ///
    ///What a file this view has not drawn yet needs before it can be: its layout and each layer merged.
    ///
    ///**At the pace of the shell's load, when there is one** - see Loading. The merge is most of what opening a
    ///chip in this view costs, fourteen seconds of the RGB mixer on the dev server, and at the load's pace the page
    ///answers meanwhile and Cancel stops it.
    ///
    private async Task takeNewFile(GDS file, FlattenedLayout? prepared)
    {
        //
        //**The slider's value, onto the file that has just arrived.**
        //
        //Spacing is not an argument to the draw the way the 2D view's opacity is - it is written onto
        //the Layer objects themselves, by SetStackingOffsets, and a new file brings new ones. Layer
        //discovery stacks them at the library's default and nothing put the slider's value back, so
        //opening a second file with the Distance set to 700 drew it at 50 while the control still read
        //700. Nudging the slider was the only thing that ever applied it, which is what made it look
        //like the control had stopped working rather than never having been consulted.
        //
        //Here rather than at the top of Render because this is the one branch that means "a file
        //this view has not drawn yet". A layer toggle and a spacing change both come back through there
        //with the same file, and neither should re-stack anything - a height typed in by hand would be
        //the thing lost. SetStackingOffsets is absolute, and a layer that carries its own height rests
        //there, so running it once per file is both enough and safe.
        //
        file.AdditionalInformation.SetStackingOffsets(userSetlayerSpacing);

        var pacer = Loading?.Invoke();

        FlattenedLayout flat;

        //Handed over by the shell when it has one; see IRenderable.
        if (prepared is not null)
            flat = prepared;
        else if (pacer is not null)
            flat = await GdsFlattener.FlattenAsync(file, () => stillWanted(file, pacer));
        else
            flat = GdsFlattener.Flatten(file);

        List<Booleans.Outline> outlines;

        if (pacer is not null)
            outlines = await Booleans.MergeByLayerAsync(flat.Elements, () => stillWanted(file, pacer));
        else
            outlines = Booleans.MergeByLayer(flat.Elements);

        //A newer file arrived while this one merged: that one is drawn, and this is not.
        if (!ReferenceEquals(file, Gds))
            return;

        layout = flat;
        merged = outlines;
        flattenedFrom = file;

        //The file this view already showed, changed in place: the camera and the shell are left as they are.
        bool sameFile = ReferenceEquals(editedInPlace, file);

        editedInPlace = null;

        if (sameFile)
            return;

        //And this is the draw that frames it - see frameAfterDrawing.
        frameAfterDrawing = true;

        //And a scene the shell is waiting on - see OnDrawn - built at the pace of the load it is waiting as part of.
        announceDrawn = true;
        scenePace = pacer;
    }

    ///
    ///The pause a file's merge waits on: the load's, and given up once the file is not this view's any more.
    ///
    ///**A view can be handed a file only to have it replaced while it merges.** The view a tab is left in mounts
    ///before the tab's file is read, and merges the file still on screen - which the tab's own replaces a few seconds
    ///later. Merged to the end anyway, that was the old file's whole merge for nothing, beside the new one's.
    ///
    private ValueTask stillWanted(GDS file, Pacer pacer)
    {
        if (!ReferenceEquals(file, Gds))
            throw new OperationCanceledException();

        return pacer.Pause();
    }

    public async Task Render(GDS? gds, List<CheckboxItem>? showLayers, FlattenedLayout? prepared = null)
    {
        //Save if needed for re-render on layer spacing change.
        if (gds is not null)
            this.Gds = gds;

        if(showLayers is not null)
            this.ShowLayers = showLayers;

        if (Gds is null || ShowLayers is null)
            return;

        //
        //Resolving the hierarchy and merging each layer only depend on the file, so both are done once per
        //file rather than on every layer-spacing change.
        //
        //**Against the file itself, not against whether one was passed.** This said `gds is not null`, and
        //every caller passes the field it already has - `sliderChanged` hands over `Gds`, and so does the
        //shell on a layer toggle - so the condition was true every time and the comment above it was simply
        //untrue. The Layer Distance slider is bound `@oninput`, which made a drag across it one flatten and
        //one *merge* per pixel: measured at 5.2 seconds each on a half-million-element layout, for a change
        //that moves no geometry at all.
        //
        //The same mistake, and the same fix, as Viewer2DSvg - see the note there, which was written when the
        //opacity slider was found doing this.
        //
        if (!ReferenceEquals(Gds, flattenedFrom))
        {
            var file = Gds;

            //
            //**One merge of a file, however many draws ask for it, and one draw after it.** The shell draws as it
            //switches into this view and the view draws as it mounts, and with the merge at the load's pace the
            //second arrives while the first is still merging - so it waits on that one rather than merging the file
            //a second time, and leaves the drawing to it too: by the time the merge is done the view has a viewer,
            //and the first draw finds it. Two draws of the RGB mixer were five seconds of packing and building the
            //same scene twice. What the second was asked to show - a layer switched off meanwhile - is read when the
            //first draws, so nothing it asked for is lost.
            //
            bool merging = true;
            Task waiting;

            if (arriving is Task already && ReferenceEquals(arrivingFile, file))
            {
                merging = false;
                waiting = already;
            }
            else
            {
                waiting = takeNewFile(file, prepared);
                arrivingFile = file;
                arriving = waiting;
            }

            try
            {
                await waiting;
            }
            catch (OperationCanceledException)
            {
                //Given up while it merged: nothing of it is drawn, and the shell puts back what was on screen.
                return;
            }
            finally
            {
                if (ReferenceEquals(arriving, waiting))
                {
                    arriving = null;
                    arrivingFile = null;
                }
            }

            //A newer file arrived while this one merged, and its own draw takes care of it.
            if (!ReferenceEquals(file, Gds) || !ReferenceEquals(flattenedFrom, file))
                return;

            //Waited on another draw's merge, which draws it.
            if (!merging)
                return;
        }

        if (layout is null)
            return;

        //
        //**Given up once merged**, where no pause looked: nothing of it is built. The shell is putting back what was
        //on screen, and a scene of this file would hold that up - and say it was done before the way back was.
        //
        if (announceDrawn && scenePace is { Canceled: true })
        {
            announceDrawn = false;

            return;
        }

        List<object> labels = new List<object>();

        //One set each for the whole pass, rather than searching the list once per element. Shared with the
        //2D view so both agree on what "visible" and "labeled" mean.
        var visible = CheckboxItem.VisibleLayers(ShowLayers);
        var labeled = CheckboxItem.LabeledLayers(ShowLayers);

        //Before the shapes are described, since each layer carries its place - see takeStackingOrder.
        takeStackingOrder();

        //What is drawn, by layer, since a layer is one mesh - see packShapes. In the order the merge gave.
        var drawn = new List<DrawnLayer>();
        var drawnAt = new Dictionary<LayerKey, int>();

        foreach (var outline in merged)
        {
            if (!visible.Contains(outline.Layer.Key))
                continue;

            //
            //**A layer this file was never told the height of takes no part in the stack.**
            //
            //Only where the file carries a process table at all - see HasProcessStack, which is the whole
            //of the condition. Without one every layer is in this case and the even stack is what the view
            //is for; with one, an untold layer is one the table does not cover, and its offset is a number
            //nobody chose. Drawing it anyway is what put a ladder of cell-sized plates over every sky130
            //cell: nwell.pin, pwell.pin, areaid.standardc and the cell outline are each drawn to the full
            //cell, so each became a slab hanging in the sky over the layout with nothing underneath it.
            //
            if (!stacked(outline.Layer))
                continue;

            //An extrusion needs a closed outline, which takes at least three corners.
            if (outline.Boundary.Count < 3)
                continue;

            if (!drawnAt.TryGetValue(outline.Layer.Key, out int at))
            {
                at = drawn.Count;
                drawnAt[outline.Layer.Key] = at;
                drawn.Add(new DrawnLayer(outline.Layer, new List<Booleans.Outline>()));
            }

            drawn[at].Outlines.Add(outline);
        }

        //Labels come off the layout rather than the merge: a TEXT element is an anchor and a string, and
        //there is nothing about it to merge.
        foreach (var element in layout.Elements)
        {
            if (element.Text is null || !visible.Contains(element.Layer.Key))
                continue;

            //A label hangs off its layer's height, so a layer with no place in the stack has nowhere to
            //put one either. Same rule as the shapes above.
            if (!stacked(element.Layer))
                continue;

            if (labeled.Contains(element.Layer.Key) && element.Text.Length > 0 && element.Points.Count > 0)
                labels.Add(labelFor(element));
        }

        //The pictures the layers name, before the scene that puts them on - see sendTextures.
        await sendTextures(drawn);

        var (layers, points) = packShapes(drawn);

        //Which viewer it went into, or none - see the announcement below.
        int drewInto;

        var scene = new { layers = layers, points = points, labels = labels };

        //
        //**A file's first scene at the pace of its load**, when one is under way: the build is JavaScript, and
        //paced there the page answers while a chip's scene is made - and a cancel stops it, which it hears through
        //the load's token. Every other draw - a layer switched off, the stack spread - is the plain one.
        //
        if (announceDrawn && scenePace is Pacer pacer)
        {
            using var givenUp = pacer.Token.Register(() => _ = js.InvokeVoidAsync("cancelDrawInterOp"));

            drewInto = await js.InvokeAsync<int>("drawPacedInterOp", scene);
        }
        else
            drewInto = await js.InvokeAsync<int>("drawInterOp", scene);

        //
        //**The layout framed, rather than hoped to be where the camera happens to point.**
        //
        //The camera used to open at a fixed distance down Z and stay there, which worked only because the
        //stack happened to hang where it was looking. It stopped: extruded slabs used to run *downward*
        //from the plane they were drawn on and now run upward - the placement the process actually
        //describes - so the whole stack rose by its own height and the fixed camera was left aimed at its
        //underside. A mapped sky130 cell opened with the metals off the top of the frame.
        //
        //Fitting is what stops that being a standing risk. A number tuned to where the geometry sits today
        //is a number that is wrong the next time it moves, and this file has spent a while removing exactly
        //that kind of constant.
        //
        //Once per file, not per draw: a layer toggle and a spacing step come back through here with the
        //same file and must leave the camera alone, or the view would snap back every time a row was
        //switched off. A session's own camera is restored in OnAfterRender and is the one that wins - this
        //is for the file that arrives without one.
        //
        if (frameAfterDrawing)
        {
            frameAfterDrawing = false;

            if (cameraToRestore.Length == 0)
                await js.InvokeVoidAsync("centerCameraInterOp");
        }

        //
        //**And the shell told, once, that the scene is built**, which takes down the note saying it is loading.
        //Only once this view has registered a viewer: a draw asked for before then - the shell's own, on the way
        //into this view - lands on no viewer and builds nothing, and the view's first render draws again.
        //
        //**Asked of the draw itself, because the number alone raced it.** The shell's draw and this view's first
        //render run interleaved, and the number is taken at the top of that render, before its viewer is built -
        //so the shell's draw could land on nothing and still find it set. The loading note came down a draw
        //early, which nobody could see; Play game from another view starts the chip game here, and found no
        //scene to drive on. See playGame in Viewer.razor.
        //
        if (announceDrawn && viewerNumber > 0 && drewInto == viewerNumber)
        {
            announceDrawn = false;

            await OnDrawn.InvokeAsync();
        }
    }

    ///<summary>One layer's merged outlines, which the scene builds into one mesh.</summary>
    private sealed record DrawnLayer(Layer Layer, List<Booleans.Outline> Outlines);

    ///<summary>
    ///What is drawn, as the scene takes it: an entry per layer, and every corner of every outline in one
    ///block of bytes.
    ///
    ///**A layer is one mesh.** It was a mesh per merged outline, each with a material of its own, which put
    ///117,688 of them into the scene for the RGB mixer and a draw call for each into every frame. The scene
    ///builds a layer's outlines into one geometry now, so a frame costs a draw call per layer.
    ///
    ///**Bytes rather than objects, because the objects were most of the wait.** Each outline went over as an
    ///object holding a list of point objects, and for the RGB mixer that came to 27.5 million characters of
    ///JSON: about two seconds to write and hand over, and 1.2 more for the page to parse, before the first
    ///slab was built. The same corners as 32-bit integers are about 6 MB, which the page reads where they
    ///lie - a byte array crosses the interop as bytes rather than as text.
    ///
    ///**The holes go over as holes.** A triangulator takes an outline and its holes directly - the
    ///alternative is the keyhole a GDSII file has to use, a channel whose two edges lie on top of each
    ///other, and that is the case an ear-clipper is worst at. Fifty-five of them came out of merging the
    ///bundled cells, so this is not a hypothetical.
    ///
    ///Each outline is its corner count, its hole count and its corners, x then y; then each hole the same
    ///way, its count and its corners. A hole of fewer than three corners encloses nothing and is left out.
    ///The block is in the machine's own byte order, which is little-endian in WebAssembly and in every
    ///browser that reads it.
    ///
    ///A layer goes over as what drawing it needs rather than as the whole object, which would carry a key and
    ///two flags across the interop on every redraw for nothing: its color, height and thickness, its name and
    ///role - which say whether it is metal, and so how its surface looks - how many outlines it has, and where
    ///they start and end in the block, in 32-bit words.
    ///</summary>
    private (List<object> Layers, byte[] Points) packShapes(List<DrawnLayer> drawn)
    {
        int words = 0;

        foreach (var layer in drawn)
        {
            foreach (var outline in layer.Outlines)
            {
                words += 2 + (outline.Boundary.Count * 2);

                foreach (var hole in outline.Holes)
                {
                    if (hole.Count >= 3)
                        words += 1 + (hole.Count * 2);
                }
            }
        }

        var points = new byte[words * sizeof(int)];
        var written = MemoryMarshal.Cast<byte, int>(points.AsSpan());
        int next = 0;

        var layers = new List<object>();

        foreach (var layer in drawn)
        {
            int start = next;

            foreach (var outline in layer.Outlines)
            {
                int holes = 0;

                foreach (var hole in outline.Holes)
                {
                    if (hole.Count >= 3)
                        holes++;
                }

                written[next++] = outline.Boundary.Count;
                written[next++] = holes;

                next = writeCorners(written, next, outline.Boundary);

                foreach (var hole in outline.Holes)
                {
                    if (hole.Count < 3)
                        continue;

                    written[next++] = hole.Count;

                    next = writeCorners(written, next, hole);
                }
            }

            layers.Add(new
            {
                color = layer.Layer.Color,
                offset = layer.Layer.Offset,
                depth = layer.Layer.Depth,

                //What it is called and what it is for, when a layermap or somebody has said - which is how the view
                //tells the metal, to give it a metal's finish. See surfaceOf in ThreeInterop.js.
                name = layer.Layer.Name ?? string.Empty,
                role = layer.Layer.Role.ToString(),

                //The picture its surface is drawn with, by name - handed over beforehand, see sendTextures - and how big
                //a repeat of it is, in database units like everything else here.
                texture = layer.Layer.Texture ?? string.Empty,
                textureSize = textureSizeOf(layer.Layer),

                //Where this layer sits in the ordered list, so the spacing slider can move what is already
                //drawn instead of handing the scene over again. The only thing on the wire that is about
                //restacking rather than about drawing - see restackLayers.
                at = stackedAt(layer.Layer.Key),

                outlines = layer.Outlines.Count,
                start = start,
                end = next
            });
        }

        return (layers, points);
    }

    ///
    ///How big one repeat of a layer's texture is, in database units: what it was given, or a micron in this file's own
    ///units - see Layer.DefaultTextureMicrons. A micron when the file's UNITS give nothing usable, as the 2D view
    ///assumes too.
    ///
    private double textureSizeOf(Layer layer)
    {
        if (layer.TextureSize is int units)
            return units;

        double micronsPerUnit = Gds?.MicronsPerDatabaseUnit ?? 1;

        return Layer.DefaultTextureMicrons / micronsPerUnit;
    }

    ///<summary>The pictures already handed to the scene this view drew, by name - see sendTextures.</summary>
    private readonly HashSet<string> texturesSent = new HashSet<string>(StringComparer.Ordinal);

    ///
    ///Hands the scene the pictures the layers about to be drawn name, that it does not have yet - out of the browser's
    ///store, see TextureStore - so the draw that follows can put them on. Once each for the life of this view: the
    ///layer settings that change one are the 2D view's, and coming back to this view is a new scene.
    ///
    ///A name with no picture kept under it is left out, and the layer drawn without one.
    ///
    private async Task sendTextures(List<DrawnLayer> drawn)
    {
        foreach (var layer in drawn)
        {
            if (layer.Layer.Texture is not string name || name.Length == 0 || texturesSent.Contains(name))
                continue;

            texturesSent.Add(name);

            byte[]? picture = await textures.GetAsync(name);

            if (picture is null)
                continue;

            try
            {
                await js.InvokeVoidAsync("setTextureInterOp", name, picture);
            }
            catch { }
        }
    }

    ///<summary>A run of corners into the block, x then y. Hands back where the next word goes.</summary>
    private static int writeCorners(Span<int> written, int next, List<Point> corners)
    {
        foreach (var corner in corners)
        {
            written[next++] = corner.X;
            written[next++] = corner.Y;
        }

        return next;
    }

    ///<summary>
    ///Reduces a label to what the scene needs. The justification goes over as a name rather than an enum
    ///ordinal so the interop reads the same from either side, and the anchor is the only point a text
    ///element has.
    ///</summary>
    private object labelFor(Element element)
    {
        var anchor = element.Points[0];

        return new
        {
            text = element.Text,
            x = anchor.X,
            y = anchor.Y,
            height = LabelHeight,
            color = element.Layer.Color,
            offset = element.Layer.Offset,
            depth = element.Layer.Depth,
            at = stackedAt(element.Layer.Key),
            horizontal = element.Presentation.Horizontal.ToString(),
            vertical = element.Presentation.Vertical.ToString()
        };
    }

    ///
    ///Takes the scene down with the view, and lets go of the handle the settings menu's dismissal calls back
    ///through.
    ///
    ///Unlike the shell's, this view is unmounted every time somebody switches away from it - so a handle
    ///left open here is one per visit, each pinning a component that has otherwise been thrown away.
    ///
    ///**And the scene went on drawing after it.** The viewer was only disposed when the 3D view was next
    ///opened, so going back to 2D left the whole scene being drawn every frame into a canvas no longer in the
    ///page, with its WebGL context and everything it held on the GPU, until the next visit or a reload. See
    ///unregisterThree in ThreeInterop.js.
    ///
    ///**A teardown that fails is let go.** This runs inside the render that removes the view, and an
    ///exception out of it is an unhandled one - the error bar, for a scene that is going anyway.
    ///
    public async ValueTask DisposeAsync()
    {
        menuHandle?.Dispose();

        try
        {
            await js.InvokeVoidAsync("unregisterThree", viewerNumber);
        }
        catch { }
    }

    #endregion ***********************************************
}
