@using GDSViewer.Models;

@using Layer = GDSViewer.Models.Layer;
@using Point = GDSViewer.Models.Element.Point;
@using static GDSViewer.Models.GDS.Record;
@using GDSViewer.JsInterop;

@inject IJSRuntime jsRuntime;


<div class="viewWrapper">
    <div id="konvaCanvas"></div>
</div>


@code {
    #region Vraiables ****************************************

    [Parameter]
    public Pages.Viewer Parent { get; set; }
    [Parameter]
    public GDS Gds { get; set; }
    [Parameter]
    public List<CheckboxItem> ShowLayers { get; set; }

    private KonvaJsInterop konvaJsInterop;

    #endregion ***********************************************

    #region Initialization ***********************************

    private async Task InitializeToolbar()
    {
        Parent.ClearToolbarItems();

        RenderFragment backgroundDropdown = (__builder) =>
        {
            <div id="center" class="col-1 toolbarItem" style="align-self: end;">
                <select id="backgroundSelection">
                    <option value="lines">Lines</option>
                    <option value="dottedLines">Dots</option>
                    <option value="none" selected="selected">None</option>
                </select>
            </div>
        };

        Parent.AddToolbarItem(backgroundDropdown);


        RenderFragment centerButton = (__builder) =>
        {
            <div id="center" class="col-1 toolbarItem" style="align-self: end;" >
                <img style="height: 22px; padding: 1px; padding-right: 5px;" src="./resources/images/icons/center.png" />
            </div>
        };

        Parent.AddToolbarItem(centerButton);


        RenderFragment zoomInButton = (__builder) =>
        {
            <div id="zoomIn" class="col-1 toolbarItem" style="align-self: end;">
                <img style="height: 22px; padding: 1px; padding-right: 5px;" src="./resources/images/icons/zoomIn.png" />
            </div>
        };

        Parent.AddToolbarItem(zoomInButton);


        RenderFragment zoomOutButton = (__builder) =>
        {
            <div id="zoomOut" class="col-1 toolbarItem" style="align-self: end;">
                <img style="height: 22px; padding: 1px; padding-right: 5px;" src="./resources/images/icons/zoomOut.png" />
            </div>
        };

        Parent.AddToolbarItem(zoomOutButton);
    }

    protected override async Task OnInitializedAsync()
    {
        //await Render(Gds, ShowLayers);
        konvaJsInterop = new KonvaJsInterop(jsRuntime);
        await InitializeToolbar();
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            //Initilize Konvajs 2D library.
            await konvaJsInterop.InitializeKonva();
            //Send this objects reference to javascript so we can make calls to C# instance methods from it.
            //await commonJsInteropUtils.SendObjectReference(this);
            //Set selected item.
            //await konvaJsInterop.SelectItem(State.CurrentlySelectedComponent.ID);
        }
    }

    #endregion ***********************************************
}
