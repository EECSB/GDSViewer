@using GDSViewer.Models;

@*@using BlazorMonaco;
@using BlazorMonaco.Editor;
@using BlazorMonaco.Languages;*@

@inject IJSRuntime JSR;

<div id="gdsTextEditor"></div>
@*<textarea class="numbered" @bind="GdsAsText">@GdsAsText</textarea>*@


@code {
    #region Vraiables ****************************************

    private bool isFirstRender = true;

    public string GdsAsText { get; set; } = "";

    [Parameter]
    public Pages.Viewer Parent { get; set; }

    [Parameter]
    public GDS Gds { get; set; }

    #endregion ***********************************************



    #region Initialization ***********************************

    private async Task InitializeToolbar()
    {
        Parent.ClearToolbarItems();

        RenderFragment saveButton = (__builder) =>
        {
            <div class="col-1 toolbarItem" style="align-self: end;">
                <button @onclick="saveChanges" style="padding: 0; border: none;">
                    <img style="width: 25px;" src="./resources/images/icons/save.png" />
                </button>
            </div>
        };

        Parent.AddToolbarItem(saveButton);
    }

    protected override async Task OnInitializedAsync()
    {
        await Render(Gds, null);

        await InitializeToolbar();
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        isFirstRender = firstRender;

        if (firstRender)
        {
            await JSR.InvokeVoidAsync("InitializeMonaco", GdsAsText, "GDS");
        }
    }

    #endregion ***********************************************



    #region Methods ******************************************

    private async Task saveCurrent()
    {
        await saveChanges();
    }

    private async Task loadEditor(string text)
    {
        await JSR.InvokeVoidAsync("SetMonacoContent", text);
    }

    private async Task saveChanges()
    {
        GdsAsText = await JSR.InvokeAsync<string>("GetMonacoContent");

        Gds.Deserialize(GdsAsText);
    }

    public async Task Render(GDS gds, List<CheckboxItem> showLayers)
    {
        //Save if needed for re-render.
        if (gds is not null)
            this.Gds = gds;

        if (Gds is null)
            return;


        GdsAsText = Gds.AsText();

        if (!isFirstRender)
            await loadEditor(GdsAsText);

        StateHasChanged();
    }

    #endregion ***********************************************
}
