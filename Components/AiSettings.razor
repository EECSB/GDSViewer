@using GDSViewer.Ai
@implements IDisposable
@inject IAiService ai
@inject SpeechPreference speech
@inject ToolRoundsPreference toolRounds
@inject IJSRuntime js

@*
    The AI models on their own, rather than inside the chat that uses them: adding a key here is the one step the
    assistant needs, and the chat only picks among what is here.

    Ported from GraphDBViewer's LlmSettingsModal. Its sentence about where keys are kept is this app's whole answer -
    there is no server here to keep them on.

    And the MCP server, at the top since 2026-11-03 - see LiveLinkCard. A little taller for it.
*@
<FloatingWindow Id="aiSettingsWindow" Visible="Visible" OnClose="OnClose" Title="AI settings" StorageKey="ai-settings"
                Width="min(520px, 94vw)" Height="min(680px, 86vh)">
    @*
        The MCP server first, since 2026-11-03 (asked for), then the models. Only where the page may edit: the Viewer
        hands a read-only one no link, and the card is left out.
    *@
    @if (Link is not null)
    {
        <LiveLinkCard Link="Link" />
    }

    @*
        The models, their form and the note on keys, in a card of their own (2026-11-01, asked for). Named, with the AI
        assistant's spark, since 2026-11-03 (asked for) - each card here says what it is with an icon in front.
    *@
    <div class="aiSettingsCard">
        <div class="aiSettingsCardTitle">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path fill="currentColor" d="M6.4 1.6c.3 2.6 1.6 4 4.2 4.3-2.6.3-3.9 1.7-4.2 4.3-.3-2.6-1.6-4-4.2-4.3 2.6-.3 3.9-1.7 4.2-4.3z" />
                <path fill="currentColor" d="M11.6 8.6c.2 1.6 1 2.4 2.6 2.6-1.6.2-2.4 1-2.6 2.6-.2-1.6-1-2.4-2.6-2.6 1.6-.2 2.4-1 2.6-2.6z" />
            </svg>
            Models
        </div>

        <AiModels />

        @if (ai.ModelsEditable)
        {
            <p id="aiKeysKept" class="aiFormNote aiKeysKept">
                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
                Keys are kept in this browser and sent only to their provider, with what you type and what the assistant reads
                from the layout - and nothing is sent until you press Send.
            </p>
        }
        else
        {
            <p id="aiKeysKept" class="aiFormNote aiKeysKept">
                The models and your chats are kept @ai.KeptWhere. A conversation sends what you type and what the assistant
                reads from the layout to the model picked - nothing is sent until you press Send.
            </p>
        }

        @*
            How the AI assistant's microphone turns speech into words (2026-10-31, asked for): the browser's own recognition to
            begin with, live and free, or a recording the AI provider writes out, slower and billed but better with a layout's
            words. A card of its own from 2026-11-01; back in the models' card since 2026-11-03 (asked for), under the note on
            keys with room above it, as is the part after it.
        *@
        <div class="aiSettingsPart">
            <div class="aiFormRow aiSpeechRow">
                @*The assistant's own microphone.*@
                <span class="aiFormLabel aiSettingsCardTitle aiCardLabel">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                        <rect x="5.75" y="1.75" width="4.5" height="8" rx="2.25" />
                        <path d="M3.6 7.6a4.4 4.4 0 0 0 8.8 0M8 12v2.2M5.9 14.2h4.2" />
                    </svg>
                    Speech to text
                </span>

                <div class="sidebarPanelPick" role="group" aria-label="Speech to text">
                    <button id="aiSpeechBrowser" type="button" class="sidebarPanelChoice @(mode == SpeechMode.Browser ? "sidebarPanelChoiceOn" : "")"
                            aria-pressed="@(mode == SpeechMode.Browser ? "true" : "false")" @onclick="() => chooseAsync(SpeechMode.Browser)">Browser</button>
                    <button id="aiSpeechProvider" type="button" class="sidebarPanelChoice @(mode == SpeechMode.Provider ? "sidebarPanelChoiceOn" : "")"
                            aria-pressed="@(mode == SpeechMode.Provider ? "true" : "false")" @onclick="() => chooseAsync(SpeechMode.Provider)">AI provider</button>
                </div>
            </div>

            <p id="aiSpeechNote" class="aiFormNote">@speechNote()</p>
        </div>

        @*How long the assistant may go on calling tools before it asks (2026-11-01, asked for).*@
        <div class="aiSettingsPart">
            <label class="aiFormRow aiRoundsRow">
                @*Two arrows, one each way: the assistant and its tools going back and forth.*@
                <span class="aiFormLabel aiRoundsLabel aiSettingsCardTitle aiCardLabel">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2.5 5.2h10.5M10.4 2.6l2.6 2.6-2.6 2.6M13.5 10.8H3M5.6 8.2 3 10.8l2.6 2.6" />
                    </svg>
                    Tool rounds before asking
                </span>
                <input id="aiToolRounds" type="number" class="aiField aiNumber" min="@ToolRoundsPreference.Fewest" max="@ToolRoundsPreference.Most" step="1"
                       value="@rounds" @onchange="roundsChangedAsync" />
            </label>

            <p id="aiToolRoundsNote" class="aiFormNote">
                Each round sends the whole conversation again, and is billed. When an answer takes this many rounds, the assistant
                pauses and asks whether to go on for another as many.
            </p>
        </div>
    </div>
</FloatingWindow>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    ///<summary>This tab's end of the live link, or null on a page that may not edit, which leaves its card out.</summary>
    [Parameter]
    public LiveLink? Link { get; set; }

    ///
    ///How many times the MCP server was asked for, from the chip or the command palette, rather than AI settings as a
    ///whole - each brings its card into view. A count rather than a switch, so asking again while the window is up does too.
    ///
    [Parameter]
    public int LinkAsked { get; set; }

    private int linkShown;

    private bool showLink;

    private SpeechMode mode = SpeechMode.Browser;

    private int rounds = LlmProviderFactory.DefaultToolRounds;

    protected override async Task OnInitializedAsync()
    {
        speech.Changed += speechChanged;

        mode = await speech.GetAsync();
        rounds = await toolRounds.GetAsync();
    }

    public void Dispose()
    {
        speech.Changed -= speechChanged;
    }

    protected override void OnParametersSet()
    {
        if (LinkAsked == linkShown)
            return;

        linkShown = LinkAsked;
        showLink = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showLink || !Visible || Link is null)
            return;

        showLink = false;

        try
        {
            await js.InvokeVoidAsync("scrollToElement", "#liveLinkCard");
        }
        catch { }
    }

    private async Task speechChanged()
    {
        mode = await speech.GetAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task chooseAsync(SpeechMode chosen)
    {
        mode = chosen;

        await speech.SetAsync(chosen);
    }

    ///<summary>A number typed is kept, brought into range; anything else puts back the one there was.</summary>
    private async Task roundsChangedAsync(ChangeEventArgs e)
    {
        int typed = rounds;

        if (int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int parsed))
            typed = parsed;

        //Set to something else first, so a value brought back into range is drawn again even when it equals the old one.
        rounds = -1;
        StateHasChanged();

        rounds = await toolRounds.SetAsync(typed);
    }

    private string speechNote()
    {
        if (mode == SpeechMode.Provider)
            return "The microphone records until pressed again, and an OpenAI or Gemini model writes it out, told the layer names. More accurate with a layout's words, and billed; Claude models take no audio.";

        return "Words appear as you speak, free, by the browser's own recognition - Chrome's and Edge's send the audio to Google and Microsoft; other browsers have none.";
    }
}
