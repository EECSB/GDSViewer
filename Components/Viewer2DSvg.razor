        shapeMenuOpen = true;

        await OnToolChanged.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnShapeMenuDismissed()
    {
        if (!shapeMenuOpen)
            return;

        shapeMenuOpen = false;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///The pointer leaving the tools column, which puts away whatever was hanging off it.
    ///
    ///Both panels at once rather than one handler each, because leaving is one gesture and the column is
    ///what was left - which of the two happened to be open is not something the person moving the mouse was
    ///thinking about. It is a no-op when it is already shut.
    ///
    ///The press-anywhere-else route stays: it is the way out on a screen with no pointer to move off them.
    ///
    ///**Not while a box or a dropdown in it has the keyboard** (2026-11-01). Choosing the Generator's kind from its
    ///list leaves the pointer wherever the kind was in the list - over the drawing, as often as not - and the first move
    ///from there left the column and shut the menu, panel and all, so every kind was a trip back to the pencil. A number
    ///half typed went with it, before its box had said it changed. A press anywhere else still puts it away.
    ///
    private async Task leaveTools()
    {
        if (shapeMenuOpen && await js.InvokeAsync<bool>("typingIn", "shapePicker"))
            return;

        await OnShapeMenuDismissed();
    }

    ///<summary>What the Draw tool can do, or what has to happen first.</summary>
    private string drawDescription()
    {
        if (context is null)
            return "Open a cell first - a new shape has to go in one. Pick one from the cell tree, or click a shape to edit the cell it is in";

        return "Drag out a rectangle to add it to the cell being edited (D)";
    }


    ///
    ///Replaces the placement a chosen shape was reached through with a copy of what it places.
    ///
    ///The inverse of grouping, and the one that has to do arithmetic - which is the library's, in
    ///<see cref="Flattening.Edits"/>, so that this and the assistant's tools take a placement apart the same
    ///way. It used to be done here by moving every coordinate through the placement, which is right for a
    ///shape and wrong for anything with a width or an orientation of its own: a placement inside a turned
    ///instance came out unturned, and a path inside a magnified one came out at its old width.
    ///
    ///**An array comes apart whole**, from whichever of its places was clicked. Found by its first place
    ///only, it did nothing from any other - and from the first it took the whole array out and put one
    ///place's shapes back.
    ///
    private async Task flatten(ElementSource source)
    {
        if (Gds is null || placementThrough(source) is not (GDS.StructureModel inside, GDS.ElementModel placement))
            return;

        if (Flattening.Edits(Gds, inside, new[] { placement }) is not List<LayoutEdit> edits)
            return;

        History.Do(new CompoundEdit("Flatten", edits));

        await afterEdit();
    }

    ///
    ///What the Flatten button says, or why it cannot - which is only ever an array too big to take apart.
    ///
    ///Null when it can, so the button is disabled exactly when there is a reason to give.
    ///
    private string? flattenRefusal(ElementSource source)
    {
        if (Gds is null || placementThrough(source) is not (_, GDS.ElementModel placement))
            return null;

        long writing = Flattening.CountOf(Gds, placement);

        if (writing <= Flattening.MostElements)
            return null;

        return FormattableString.Invariant(
            $"This array would come apart into {writing:N0} shapes, and one flatten stops at {Flattening.MostElements:N0}");
    }

    private string flattenSays(ElementSource source)
    {
        if (flattenRefusal(source) is string why)
            return why;

        if (Gds is not null && placementThrough(source) is (_, GDS.ElementModel placement) && placement.Element is GDS.ArefModel)
            return "Put the shapes of every place in this array into the cell that places it, and take the array away";

        return "Put this instance's shapes into the cell that places it, and take the instance away";
    }

    ///
    ///The cell holding the placement a shape was reached through, and that placement: a single instance, or
    ///the array with a place there.
    ///
    private (GDS.StructureModel Inside, GDS.ElementModel Placement)? placementThrough(ElementSource source)
    {
        if (instancePlacement(source) is not (GDS.StructureModel inside, Transform into))
            return null;

        if (Hierarchy.PlacementAt(inside, source.Structure, into) is not GDS.ElementModel placement)
            return null;

        return (inside, placement);
    }

    ///
    ///The cell holding the instance a shape was reached through, and that instance's own transform inside it.
    ///
    ///**The chain ends in the shape's own structure, so the cell that holds the instance is the one before
    ///it.** Reaching for the last level names the placed cell rather than the placing one - which reads
    ///perfectly sensibly, hides the button on every shape there is, and is the whole of why flattening did
    ///nothing until it was checked in a browser.
    ///
    ///Both transforms in the chain go all the way out to the layout, and what an instance is written with is
    ///its transform inside its own parent - so the parent's is taken back off. That is identity whenever the
    ///parent is a top-level cell, which is most of the time and none of the reason to leave it out.
    ///
    private (GDS.StructureModel Inside, Transform Placement)? instancePlacement(ElementSource source)
    {
        var levels = source.Ancestry;

        if (levels.Count < 2)
            return null;

        if (structureNamed(levels[^2].Structure) is not GDS.StructureModel inside)
            return null;

        if (levels[^2].Placement.Inverse() is not Transform outOfParent)
            return null;

        return (inside, levels[^1].Placement.Then(outOfParent));
    }

    ///
    ///The instance every chosen shape was reached through, when the cell being edited is the one holding it.
    ///
    ///**Several shapes are allowed as long as they came through the same placement.** A band dragged across a
    ///placed cell catches all of it, and a selection that looks like "I have got hold of this instance" and
    ///then refuses to move it is worse than one that never offered.
    ///
    ///Null the moment anything chosen is not part of it - a shape the current cell holds directly, or a second
    ///instance. Shapes take precedence over instances everywhere below, so the two never both apply.
    ///
    private (GDS.StructureModel Inside, GDS.ElementModel Instance, ElementSource Through)? chosenInstance()
    {
        if (Gds is null || context is null || chosenIndexes.Count == 0)
            return null;

        GDS.StructureModel? holding = null;
        GDS.ElementModel? placement = null;
        ElementSource? through = null;

        foreach (var element in Chosen)
        {
            if (element.Source is not ElementSource source)
                return null;

            //The instance has to be one *this* cell holds. Acting on a placement two levels up would change a
            //cell nobody is looking at, which is the rule every other edit here follows.
            if (source.Ancestry.Count < 2 || source.Ancestry[^2].Structure != context.Structure)
                return null;

            if (instancePlacement(source) is not (GDS.StructureModel inside, Transform into))
                return null;

            if (Hierarchy.PlacementAt(inside, source.Structure, into) is not GDS.ElementModel instance)
                return null;

            if (placement is null)
            {
                holding = inside;
                placement = instance;
                through = source;
            }
            else if (!ReferenceEquals(placement, instance))
                return null;
        }

        if (holding is null || placement is null || through is null)
            return null;

        return (holding, placement, through);
    }

    ///<summary>Whether the buttons are about to act on a placement rather than on shapes.</summary>
    private bool EditingInstance
    {
        get { return Editable.Count == 0 && chosenInstance() is not null; }
    }

    ///
    ///Every placement the selection reaches, deduplicated - which is what deleting a set of them needs.
    ///
    ///**Where <see cref="chosenInstance"/> asks a stricter question and gives up sooner.** That one answers
    ///"is this selection one instance", because turning or moving needs a single thing to act on: two
    ///placements turned about their own middles are two different pictures, and there is no one answer to
    ///give. Deleting has no such problem - taking out five placements is taking out five records - so it is
    ///the one action that can be offered on a band dragged across a whole layout.
    ///
    ///That is exactly what was missing. A band across a file of ten placed cells caught ninety shapes, none
    ///of them the current cell's own, and the panel offered a copy button and nothing else: no Delete, and
    ///the Delete key did nothing either, because both went through the single-instance question and got
    ///null.
    ///
    ///The same rule as the single case on what counts: the placement has to be one *this* cell holds.
    ///Deleting something two levels up would change a cell nobody is looking at.
    ///
    ///In the order they were first reached, so what undo puts back goes back the way it came out.
    ///
    private List<(GDS.StructureModel Inside, GDS.ElementModel Instance)> chosenInstances()
    {
        var found = new List<(GDS.StructureModel Inside, GDS.ElementModel Instance)>();

        if (Gds is null || context is null || chosenIndexes.Count == 0)
            return found;

        var already = new HashSet<GDS.ElementModel>();

        foreach (var element in Chosen)
        {
            if (element.Source is not ElementSource source)
                continue;

            if (source.Ancestry.Count < 2 || source.Ancestry[^2].Structure != context.Structure)
                continue;

            if (instancePlacement(source) is not (GDS.StructureModel inside, Transform into))
                continue;

            if (Hierarchy.PlacementAt(inside, source.Structure, into) is not GDS.ElementModel instance)
                continue;

            if (already.Add(instance))
                found.Add((inside, instance));
        }

        return found;
    }

    ///
    ///Whether Delete is about to take placements out rather than shapes.
    ///
    ///Shapes win when there are any, the way they do everywhere else here: a selection holding both is a
    ///selection of shapes, and the placements it happens to cross are context.
    ///
    private bool DeletingInstances
    {
        get { return Editable.Count == 0 && chosenInstances().Count > 0; }
    }

    ///<summary>What the button says, since one and five are different enough to be worth spelling out.</summary>
    private string deleteInstancesSays()
    {
        int many = chosenInstances().Count;

        if (many == 1)
            return "Delete instance";

        return FormattableString.Invariant($"Delete {many} instances");
    }

    ///
    ///What acting on the chosen placement will act on, said before a button is pressed.
    ///
    ///**An array is one placement**, so a click on any place of one chooses all of it - and moving, turning
    ///or deleting it moves, turns or deletes every place. Saying "one instance" over a grid of them would be
    ///the note that makes that a surprise.
    ///
    private string instanceNote()
    {
        if (chosenInstance() is not (_, GDS.ElementModel instance, ElementSource through))
            return "";

        if (instance.Element is GDS.ArefModel)
            return $"one place of an array of {through.Structure} — moving, turning or deleting acts on the whole array";

        return $"one instance of {through.Structure} — moving, turning or deleting acts on the instance";
    }

    ///
    ///Turns or mirrors a placement where it sits, by composing rather than by rewriting its angle.
    ///
    ///**Out to the layout, turned there, and back into the cell that holds it.** The button says what it
    ///looks like on screen, and what has to be written is an angle in the holding cell's own frame - which
    ///are the same number only when that cell is drawn square. Composing matrices gets the mirrored and
    ///turned cases right without a case for each; see <see cref="Hierarchy.Through(IReadOnlyList{GDS.Record}, Transform)"/>.
    ///
    ///**The placement's own records, put through the turn**, rather than a placement rebuilt from what the
    ///turn comes to. Rebuilding wrote a single instance whatever it was given - so turning an array kept
    ///one place of it and lost the rest - and dropped anything else the placement carried.
    ///
    ///Deleted and added back at the same index, so it keeps its place in the cell and undo puts back exactly
    ///what was there.
    ///
    private async Task turnInstance(Turn turn, string named)
    {
        if (Gds is null || context is null)
            return;

        if (chosenInstance() is not (GDS.StructureModel inside, GDS.ElementModel instance, _))
            return;

        if (recordsOf(instance) is not List<GDS.Record> span)
            return;

        if (context.Placement.Inverse() is not Transform back)
            return;

        var box = Measure.BoundsOf(layoutOf(Chosen));

        if (box.IsEmpty)
            return;

        double pivotX = Math.Round((box.Left + (double)box.Right) / 2);
        double pivotY = Math.Round((box.Bottom + (double)box.Top) / 2);

        //Out of the cell to where it is drawn, turned there, and brought back into the cell that writes it.
        var turning = context.Placement.Then(Turning.About(turn, pivotX, pivotY)).Then(back);

        if (Hierarchy.Through(span, turning) is not List<GDS.Record> rebuilt)
            return;

        int index = inside.Elements.IndexOf(instance);

        if (index < 0)
            return;

        //**Back at the same index**, which is what lets the choice survive. Deleting and adding at the end
        //would leave the cell holding the same elements in a different order, the flattened layout would come
        //out in a different order with it, and what is chosen afterwards would be some other shape - so
        //turning an instance twice would turn two different things.
        History.Do(new CompoundEdit(named, new List<LayoutEdit>
        {
            new DeleteElement(Gds, inside, instance),
            new AddElement(Gds, inside, index, rebuilt, named)
        }));

        await afterEdit(keepChosen: true);
    }

    ///<summary>A distance in the layout's coordinates, in microns - or unchanged when the file gives no scale.</summary>
    private double atMicrons(long units)
    {
        if (micronsPerUnit() is not double microns || microns <= 0)
            return units;

        return Math.Round(units * microns, 4);
    }

    ///<summary>How big what is chosen is, to be read rather than typed into.</summary>
    private string describeSize()
    {
        var box = chosenBounds();

        if (micronsPerUnit() is not double microns || microns <= 0)
            return FormattableString.Invariant($"{box.Width:N0} by {box.Height:N0} units");

        return FormattableString.Invariant(
            $"{box.Width * microns:0.####} by {box.Height * microns:0.####} µm ({box.Width:N0} by {box.Height:N0} units)");
    }

    private async Task changeAtX(ChangeEventArgs e)
    {
        await moveTo(e, true);
    }

    private async Task changeAtY(ChangeEventArgs e)
    {
        await moveTo(e, false);
    }

    ///
    ///Moves what is chosen so that edge of its box lands on the number that was typed.
    ///
    ///A move rather than anything new: the difference between where it is and where it is being asked to be
    ///is a distance, and every distance in this view goes into the cell the same way a drag does. So this
    ///reaches the same edit the pointer does, and is exact wherever a drag is.
    ///
    private async Task moveTo(ChangeEventArgs e, bool across)
    {
        if (Gds is null || context is null)
            return;

        if (!SvgWriter.TryParseNumber(e.Value?.ToString(), out double given))
            return;

        if (double.IsNaN(given) || double.IsInfinity(given))
            return;

        double units = given;

        if (micronsPerUnit() is double microns && microns > 0)
            units = given / microns;

        var box = chosenBounds();

        double wanted = Math.Round(units);

        double dx = 0;
        double dy = 0;

        if (across)
            dx = wanted - box.Left;
        else
            dy = wanted - box.Bottom;

        await nudgeChosen(dx, dy);
    }

    private async Task changeSizeX(ChangeEventArgs e)
    {
        await sizeTo(e, true);
    }

    private async Task changeSizeY(ChangeEventArgs e)
    {
        await sizeTo(e, false);
    }

    ///
    ///Scales what is chosen so that its box is the size that was typed.
    ///
    ///**Anchored on the corner the position names**, so growing a shape leaves the number in the At box where
    ///it was - two boxes that moved each other would be two boxes nobody could use together.
    ///
    ///Along the axis that was typed and no other. A shape has a width and a height and they are two numbers;
    ///making one of them change the other would be a decision this cannot make for somebody.
    ///
    ///Unlike a move, this rounds: every corner moves by its own fraction of a unit. The note under the boxes
    ///says so, and <see cref="Scaling"/> says why.
    ///
    private async Task sizeTo(ChangeEventArgs e, bool across)
    {
        if (Gds is null || context is null)
            return;

        var moving = Editable;

        if (moving.Count == 0)
            return;

        if (!SvgWriter.TryParseNumber(e.Value?.ToString(), out double given))
            return;

        double units = given;

        if (micronsPerUnit() is double microns && microns > 0)
            units = given / microns;

        var box = chosenBounds();

        long was = box.Height;

        if (across)
            was = box.Width;

        if (Scaling.Factor(was, Math.Round(units)) is not double factor)
            return;

        //Nothing asked for. A change event fires when focus leaves a box that was only looked at, and an undo
        //step for a size nobody altered is a step somebody has to press past.
        if (Math.Abs(factor - 1) < 1e-9)
            return;

        double byX = 1;
        double byY = 1;

        if (across)
            byX = factor;
        else
            byY = factor;

        var edits = new List<LayoutEdit>();
        var already = new HashSet<GDS.ElementModel>();

        //**Distinct models, not distinct shapes**, for the same reason a drag is: two chosen shapes may be
        //two instances of one element, and scaling that element twice would scale it by the square.
        foreach (var element in moving)
        {
            if (element.Source is not ElementSource source || !already.Add(source.Model))
                continue;

            if (structureNamed(source.Structure) is not GDS.StructureModel structure)
                continue;

            if (Scaling.Coordinates(context, source.Model, byX, byY, box.Left, box.Bottom) is not int[] after)
                continue;

            edits.Add(new ReshapeElement(structure, source.Model, after, "Resize"));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit("Resize", edits));

        await afterEdit(keepChosen: true);
    }

    private string netDescription(Element net)
    {
        if (net.Layer.Role == LayerRole.None)
            return "Nothing has said what this layer is for, so a net cannot be traced through it. Set a role in the layer settings, or load a layermap with a role column";

        //A label sits on a conducting layer and conducts nothing, so its role alone would let it through.
        if (!Nets.TakesPart(net))
            return "A label names a net rather than being part of one. Choose the metal underneath it to trace from there";

        return FormattableString.Invariant($"Choose everything electrically joined to this, through {net.Layer.DisplayName} and whatever vias reach it");
    }

    ///
    ///Picks out what is on the same net as the chosen shape, nearest first.
    ///
    ///**Across the whole layout, not just the cell being edited.** A net is a physical thing and it runs
    ///through however many cells it runs through - stopping at the edge of the one being looked at would
    ///answer a question nobody asked. What comes back is a plain selection, so everything that already works
    ///on one works on this.
    ///
    ///**A number of shapes at a time**, the number beside Next - see Nets.Begin. Asked for on a supply net, the
    ///whole of it is tens of thousands of shapes chosen and outlined at once, where the first hundred out from
    ///the wire are what somebody following it is looking at.
    ///
    private async Task traceNet()
    {
        if (layout is null || chosenIndexes.Count != 1)
            return;

        var walk = Nets.Begin(layout, chosenIndexes[0]);

        if (walk.Found.Count == 0)
            return;

        netWalk = walk;

        await traceFurther();
    }

    ///<summary>The trace taken another step out, and what it has reached chosen.</summary>
    private async Task traceFurther()
    {
        if (layout is null || netWalk is not Nets.Walk walk)
            return;

        int most = netStep;

        if (most <= 0)
            most = int.MaxValue;

        walk.Step(most);

        //The names belong to the net rather than to whatever is selected: the same labels over a rubber band
        //would be whatever happened to be caught, which reads the same and claims much less.
        await choose(walk.Found.Order().ToList(), walk, Nets.NamesOn(layout, walk.Found));

        StateHasChanged();
    }

    ///<summary>The trace so far, while what is chosen is what it reached. Null otherwise.</summary>
    private Nets.Walk? netWalk = null;

    ///<summary>How many more shapes a step of the trace reaches, or zero for the rest of the net.</summary>
    private int netStep = NetSteps[0];

    ///<summary>The steps offered beside Next. Zero is all of what is left.</summary>
    private static readonly int[] NetSteps = { 100, 500, 1000, 5000, 0 };

    private static string netStepName(int many)
    {
        if (many <= 0)
            return "all";

        return many.ToString("N0", CultureInfo.InvariantCulture);
    }

    private void changeNetStep(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int many))
            netStep = many;
    }

    ///<summary>What the traced net is called, when the layout says. Empty for anything not traced.</summary>
    private List<string> netNames = new List<string>();

    ///<summary>Whether what is chosen came from a trace, which is what makes "no label" worth saying.</summary>
    private bool netTraced = false;

    ///<summary>The one chosen label the cell being edited holds, which is the only one that can be retyped.</summary>
    private (GDS.StructureModel Structure, GDS.ElementModel Model)? chosenLabel()
    {
        if (Editable.Count != 1 || Only is not Element one || one.Source is not ElementSource source)
            return null;

        if (RetextElement.TextOf(source.Model) is null)
            return null;

        if (structureNamed(source.Structure) is not GDS.StructureModel structure)
            return null;

        return (structure, source.Model);
    }

    ///
    ///Changes what the chosen label says.
    ///
    ///One record written rather than an element rebuilt, so the label keeps its place in the file, its
    ///justification and its identity - and the selection is kept, because nothing was added or removed.
    ///
    private async Task changeChosenLabelText(ChangeEventArgs e)
    {
        if (chosenLabel() is not (GDS.StructureModel structure, GDS.ElementModel model))
            return;

        string says = AddElement.AsAscii(e.Value?.ToString() ?? "");

        //An empty label is invisible in every view and would only be found by reading the records, which is
        //the same guard placing one goes through.
        if (says.Length == 0 || says == RetextElement.TextOf(model))
            return;

        History.Do(new RetextElement(structure, model, says));

        await afterEdit(keepChosen: true);
    }

    ///<summary>
    ///Moves the chosen shapes by a distance in the layout's coordinates, as one step - which is what a drag
    ///does once the pointer has been let go of.
    ///</summary>
    private async Task nudgeChosen(double dx, double dy)
    {
        await OnElementDragged(dx, dy);
    }


    ///
    ///Whether the lens has opened the bigger picture.
    ///
    ///Not saved, and cleared whenever the thumbnail changes: it is a look at one cell, and leaving it up
    ///over a different one would be a picture of something nobody asked about.
    ///
    private bool bigPreviewOpen = false;

    private async Task showBigPreview(bool showing)
    {
        if (bigPreviewOpen == showing)
            return;

        bigPreviewOpen = showing;

        //The panel is drawn by this view, so a render here is enough - the bar has nothing to redraw.
        StateHasChanged();

        await Task.CompletedTask;
    }

    ///<summary>Which cell the pointer is on, or empty when it is on none.</summary>
    private string cellPreviewFor = "";

    ///
    ///The picture in the frame - a PNG's or an SVG's address, or empty - and whose it is: a picture stays while the next is drawn,
    ///and until then it is still the cell before's.
    ///
    private string cellPreviewPicture = "";

    private string cellPreviewShownFor = "";

    ///<summary>Whether that cell has been drawn - a cell may be drawn and hold nothing. False while it waits for Generate preview.</summary>
    private bool cellPreviewDrawn = false;

    ///<summary>Whether the cell pointed at is being drawn, which the frame shows once that has taken a moment.</summary>
    private bool cellPreviewDrawing = false;

    ///<summary>The pictures drawn for the tree, and the one being drawn - see PreviewPictures.</summary>
    private readonly PreviewPictures cellPictures = new PreviewPictures(MostCachedCellPreviews);

    ///
    ///How big the pictures are drawn, a side at least, in CSS pixels: the bigger picture the lens opens, which is the same
    ///one - see .cellPreviewLarge, which is never more than this. The frame under the rows shows it smaller.
    ///
    private const int LargePreviewPixels = 440;

    ///
    ///**Auto-generate preview**: whether a row pointed at is drawn by itself, or waits for a press on the frame. The
    ///shell's - one switch with the text's list and the History and Examples previews, under each of them; see
    ///AutoPreviewSwitch.
    ///
    [Parameter]
    public bool AutoPreview { get; set; } = true;

    ///<summary>The box under the frame, ticked or not - the shell holds the switch and remembers it.</summary>
    [Parameter]
    public EventCallback<bool> OnAutoPreviewChanged { get; set; }

    ///<summary>The box, ticked: the shell told, and a cell already waiting for its press drawn now, as it would have been.</summary>
    private async Task autoPreviewToggled(ChangeEventArgs e)
    {
        bool on = e.Value is bool ticked && ticked;

        await OnAutoPreviewChanged.InvokeAsync(on);

        if (on && cellPreviewFor.Length > 0 && !cellPreviewDrawn)
            await generateCellPreview();
    }

    ///<summary>Generate preview, pressed: the cell pointed at, drawn now - no pause, since this is the look being asked for.</summary>
    private async Task generateCellPreview()
    {
        cellPreviewWait?.Cancel();

        if (Gds is null || cellPreviewFor.Length == 0)
            return;

        await buildCellPreview(cellPreviewFor);
    }

    ///
    ///The wait before a hover counts as a look.
    ///
    ///The same 160ms the example list uses. Running the pointer down twenty rows to reach the one at the
    ///bottom is not twenty requests to see a cell, and drawing each on the way costs twenty flattens for
    ///nineteen pictures nobody looked at.
    ///
    private const int CellPreviewDelayMs = 160;

    private const int MostCachedCellPreviews = 40;

    private CancellationTokenSource? cellPreviewWait;

    ///
    ///Draws the cell under the pointer, after a pause.
    ///
    ///**Flattened from that cell rather than from the file's top**, which is what makes this a picture of
    ///the row rather than of the library - see GdsFlattener.Flatten(gds, name). A cell placed four hundred
    ///times is drawn once, on its own, at whatever size it actually is.
    ///
    ///No guard on how much work that is. Flattening one cell is a subset of flattening the whole library,
    ///which this view already does on every open and every edit - so the worst cell here costs less than
    ///something already paid for, and the cache means it is paid once.
    ///
    private async Task previewCell(string name)
    {
        if (name == cellPreviewFor)
            return;

        await drawCellPreview(name);
    }

    ///
    ///Draws a cell for the tree after the pause a look waits - whether or not it is the one showing already,
    ///which is how a cell edited under the pointer is drawn again. See forgetCellPreviews.
    ///
    private async Task drawCellPreview(string name)
    {
        cellPreviewWait?.Cancel();

        var waiting = new CancellationTokenSource();
        cellPreviewWait = waiting;

        try
        {
            await Task.Delay(CellPreviewDelayMs, waiting.Token);
        }
        catch (TaskCanceledException)
        {
            //The pointer moved on. Whichever row it moved to is the one being waited for now.
            return;
        }

        if (Gds is null)
            return;

        //A cell taken away or renamed while it was being looked at, or not in a file opened since.
        if (Hierarchy.Named(Gds, name) is null)
        {
            await forgetCellPreview();

            return;
        }

        cellPreviewFor = name;

        if (cellPictures.TryGet(name, out string drawn))
        {
            cellPictures.Stop();

            cellPreviewPicture = drawn;
            cellPreviewShownFor = name;
            cellPreviewDrawn = true;
            cellPreviewDrawing = false;

            //The list lives in the bar, and the bar is drawn by the shell - so a render asked for here
            //redraws the view and leaves the picture exactly as it was. See OnToolChanged.
            await OnToolChanged.InvokeAsync();

            return;
        }

        //
        //**Not drawn until asked, with Auto-generate preview off**: the frame says Generate preview, for this cell. One
        //drawn already is shown above, since that costs nothing.
        //
        if (!AutoPreview)
        {
            cellPictures.Stop();

            cellPreviewPicture = "";
            cellPreviewShownFor = "";
            cellPreviewDrawn = false;
            cellPreviewDrawing = false;
            bigPreviewOpen = false;

            await OnToolChanged.InvokeAsync();

            return;
        }

        await buildCellPreview(name);
    }

    ///
    ///Draws a cell for the tree now, keeps it, and shows it - see drawCellPreview, and generateCellPreview.
    ///
    ///**At a pace, and given up when the pointer moves on** - see PreviewPictures. The flatten is the cell's own, of the
    ///file as it stands at each pause: an edit between two of them throws the pictures away and gives this one up
    ///before the walk reads any further - see forgetCellPreviews - so a picture is never of half of each.
    ///
    ///Drawn the size of the bigger picture the lens opens, so that one is sharp too.
    ///
    private async Task buildCellPreview(string name)
    {
        if (Gds is null)
            return;

        var gds = Gds;

        cellPreviewDrawing = true;
        cellPreviewDrawn = false;

        await OnToolChanged.InvokeAsync();

        var pixels = await PreviewPictures.PixelsFor(js, "#cellTreePreview", LargePreviewPixels);

        //The pointer gone from the tree while the frame was measured, or on another cell, which draws its own.
        if (cellPreviewFor != name)
            return;

        string? picture = await cellPictures.DrawAsync(
            name,
            async pacer => await GdsFlattener.FlattenAsync(gds, name, pacer.Pause),
            pixels,
            CellPreviewOpacity);

        //Given up, for another cell or for none: whichever gave it up has its own picture to show.
        if (picture is null)
        {
            cellPreviewDrawing = cellPictures.Drawing;

            return;
        }

        //Only if it is still the cell pointed at: the walk let the page in as it went, and the pointer may have left.
        if (cellPreviewFor != name)
            return;

        cellPreviewPicture = picture;
        cellPreviewShownFor = name;
        cellPreviewDrawn = true;
        cellPreviewDrawing = false;

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>Solid enough to read as a shape at thumbnail size, where the view's own half goes to mush.</summary>
    private const float CellPreviewOpacity = 0.85f;

    ///<summary>The pointer has left the list, so there is nothing being looked at - and nothing worth drawing on.</summary>
    private async Task forgetCellPreview()
    {
        cellPreviewWait?.Cancel();
        cellPictures.Stop();

        if (cellPreviewFor.Length == 0)
            return;

        cellPreviewFor = "";
        cellPreviewPicture = "";
        cellPreviewShownFor = "";
        cellPreviewDrawn = false;
        cellPreviewDrawing = false;

        //And the bigger picture with it - it is a look at one cell, and there is no cell now.
        bigPreviewOpen = false;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///Throws away every cell drawn for the tree, because what they were drawn from has changed: an edit, or
    ///another file.
    ///
    ///**They were kept for good.** Pointing at a cell, deleting a shape from it and pointing at it again showed
    ///the shape still there, and so did every look until the page was reloaded - and a file opened after it
    ///showed the first file's picture for any cell the two shared a name with.
    ///
    ///**All of them, not only the cell edited.** A cell's picture has every cell it places drawn into it, so an
    ///edit to a leaf changes the picture of everything above it. Drawing one again is a flatten of that cell,
    ///paid when somebody next points at it.
    ///
    ///The one being looked at is drawn again, or it would go on showing the cell as it was until the pointer
    ///left its row and came back.
    ///
    private void forgetCellPreviews()
    {
        //And the one being drawn, given up at its next pause - before its walk reads any of the file as it is now.
        cellPictures.ForgetAll();
        cellPreviewDrawing = false;

        if (cellPreviewFor.Length == 0)
            return;

        //
        //Not awaited, and after the pause a look waits: so a run of edits - an arrow key held down on a shape
        //chosen from the tree, with the pointer still over it - draws the cell once, after the last of them,
        //rather than holding up every step with a flatten of a cell that may be the whole chip.
        //
        _ = drawCellPreview(cellPreviewFor);
    }

    #region Carrying a cell to where it goes *****************

    ///<summary>Which cell is in hand, or empty when none is.</summary>
    private string carrying = "";

    ///
    ///Picks a cell up out of the tree, to be put down where the pointer next lands.
    ///
    ///**The whole cell, drawn, following the cursor.** Placing was four controls on the context bar - a
    ///dropdown of names, an angle, a mirrored checkbox and a button - to say a thing that a picture under
    ///the pointer says by itself, and the instance landed at the middle of the view rather than anywhere
    ///chosen.
    ///
    ///The drawing is built here, once, and moved by the browser: a cell is however many hundred shapes, and
    ///rebuilding that through the component on every pointer move would be a render per pixel. See
    ///startCarrying in the interop, which moves a transform instead.
    ///
    ///Drawn with the layers that are showing rather than all of them, so what follows the pointer is what
    ///will be on screen once it is down. Named for the same reason a preview is - the markup carries a
    ///&lt;style&gt; block, and an unnamed one would repaint the layout it is being carried over.
    ///
    private async Task carryCell(string name)
    {
        if (Gds is null || !canPlace(name))
            return;

        var cell = GdsFlattener.Flatten(Gds, name);

        var showing = new HashSet<LayerKey>();

        if (ShowLayers is not null)
            showing = new HashSet<LayerKey>(CheckboxItem.VisibleLayers(ShowLayers));

        //One thing at a time: writing or a picture whose frame is up is put down for good first, and a cell or a
        //Generator structure already in hand put back. See emptyHand.
        await emptyHand();

        carrying = name;

        await forgetCellPreview();

        keyHandle ??= DotNetObjectReference.Create(this);

        //
        //Held by the middle of its shapes rather than by its origin.
        //
        //A cell's origin is wherever the file says it is, and grouping shapes into a cell keeps the
        //coordinates they already had - so a cell made from something drawn two thousand units out has its
        //origin two thousand units from anything in it. Carried by that, the cell hangs off the side of the
        //screen while the cursor holds an empty patch of nothing.
        //
        //An empty cell has no middle, and 0,0 is the only answer for one: there is nothing to hold it by.
        //
        double middleX = 0;
        double middleY = 0;

        if (Preview.BoxOf(cell) is (int left, int top, int width, int height))
        {
            middleX = left + (width / 2.0);
            middleY = top + (height / 2.0);
        }

        string drawn = SvgWriter.Build(
            cell,
            showing,
            CarriedOpacity,
            new HashSet<LayerKey>(),
            null,
            null,
            0,
            SvgWriter.PictureToken("carried" + name));

        await js.InvokeVoidAsync("startCarrying", keyHandle, drawn, middleX, middleY);

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>Solid, because the group it goes into is already faded - see carryNode.</summary>
    private const float CarriedOpacity = 1f;

    ///<summary>A cell chosen under the pencil: picked up as from the tree, and the menu put away, its question answered.</summary>
    private async Task carryFromMenu(string name)
    {
        shapeMenuOpen = false;

        await carryCell(name);
    }

    ///
    ///The cells the pencil's menu offers to put down: every one canPlace allows in the cell being edited.
    ///
    ///By name rather than in the tree's order, because this is a list to find a name in rather than a picture
    ///of what holds what - the tree is still there for that.
    ///
    ///**Held until something could change the answer**: an edit, another file, or another cell entered.
    ///canPlace walks the hierarchy once for each cell it is asked about, and the menu renders again with
    ///everything else in the view - the same reason the tree's own rows are held. See treeRows.
    ///
    private List<string> placeableCells()
    {
        if (Gds is null || context is null)
            return new List<string>();

        string key = $"{treeStamp}|{context.Structure}";

        if (placeableCache is not null && ReferenceEquals(placeableFor, Gds) && placeableKey == key)
            return placeableCache;

        placeableCache = Gds.StreamFormat.Structures
            .Select(Hierarchy.NameOf)
            .Where(canPlace)
            .Order(StringComparer.Ordinal)
            .ToList();

        placeableFor = Gds;
        placeableKey = key;

        return placeableCache;
    }

    private List<string>? placeableCache;
    private GDS? placeableFor;
    private string placeableKey = "";

    ///
    ///Picks up a cell the shell has just put in the library, so an imported file arrives under the pointer.
    ///
    ///**Enters a cell first if none is being edited**, which is the difference between this and carrying one
    ///from the tree. A placement goes *into* a cell, so there has to be one - and the tree's route into
    ///carrying always runs through a visitor who has already entered one. Somebody importing a file has
    ///not: they pressed Open, answered a question, and are now holding a layout with nowhere to put it.
    ///
    ///The cell entered is the one on screen, which is the only cell they can be said to be looking at. It is
    ///left entered afterwards on purpose - it is where the thing they just placed now lives, and leaving it
    ///silently would put the next edit somewhere else.
    ///
    ///Nothing happens for a file open for reading, or a name that is not in the library: both are the
    ///shell asking for something this view cannot do, and neither is worth a message the visitor did not
    ///ask a question to get.
    ///
    public async Task CarryImported(string name, string into)
    {
        if (Gds is null || ReadOnly || name.Length == 0)
            return;

        //
        //**The shell made this edit, so nothing here has noticed it yet.**
        //
        //An import adds cells to the same GDS object this view is already holding, which is a change no
        //reference comparison can see - the tree is cached against a stamp precisely because of that, and
        //every edit made *through* this view bumps it in afterEdit. An edit made around the view has to say
        //so itself, or the imported cells are in the library and absent from the tree that lists it.
        //
        treeChanged();

        if (Hierarchy.Named(Gds, name) is null)
            return;

        if (context is null && into.Length > 0 && Hierarchy.Named(Gds, into) is not null)
            await useContext(CellContext.Of(into));

        if (context is null)
            return;

        await carryCell(name);
    }

    ///
    ///Puts the carried cell down where the pointer was.
    ///
    ///The same records the old button wrote, through the same Hierarchy call - what changed is where the
    ///point comes from and how the angle was chosen, not what ends up in the file.
    ///
    ///A Generator structure in hand lands here too, under the same name, since the browser carries both the
    ///same way and only says where and which way up. See dropStamp.
    ///
    [JSInvokable]
    public async Task OnCellDropped(double x, double y, int angle, bool mirrored)
    {
        if (stamp is not null)
        {
            await dropStamp(x, y, angle, mirrored);

            return;
        }

        if (Gds is null || context is null || carrying.Length == 0)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        //Checked again on the way down, not only on the way up: the cell being edited can be left and
        //another entered while something is in hand, and a placement that made a loop would be a library
        //with no bottom.
        if (!canPlace(carrying))
        {
            await OnCarryStopped();

            return;
        }

        if (context.ToLocal(x, y) is not (double localX, double localY))
            return;

        var at = new Element.Point((int)Math.Round(localX), (int)Math.Round(localY));

        History.Do(new AddElement(
            Gds,
            structure,
            Hierarchy.PlacementRecords(carrying, at, mirrored, angle),
            "Place cell"));

        //Still in hand afterwards, so a row of the same cell is a row of clicks. Escape is what puts it back.
        await afterEdit();
    }

    ///<summary>The cell or Generator structure was put back rather than put down - Escape, or a placement that would have looped.</summary>
    [JSInvokable]
    public async Task OnCarryStopped()
    {
        if (!await putBack())
            return;

        await OnToolChanged.InvokeAsync();

        StateHasChanged();
    }

    ///<summary>Whether that cell can go in this one without either ending up inside the other.</summary>
    private bool canPlace(string name)
    {
        if (Gds is null || context is null || name.Length == 0)
            return false;

        if (Hierarchy.Named(Gds, name) is null)
            return false;

        return !Hierarchy.Reaches(Gds, name, context.Structure);
    }

    #endregion ***********************************************

    #region Writing and pictures, as shapes ******************

    ///
    ///A mark made into outlines, in hand and waiting to be put down. See carryMark.
    ///
    ///**A stamp rather than a cell.** What lands is the outlines themselves, on the layer being drawn on -
    ///geometry, the way every other shape the pencil makes is, rather than a placement of something defined
    ///somewhere else. A mark on a chip is mask shapes like any other, and a checker measures it like any other.
    ///
    ///Carried the way a cell is - the same group under the pointer, the same Ctrl+R and Ctrl+M, the same Esc -
    ///because from the hand's side it is the same thing: a drawing to put down somewhere, as many times as
    ///there are clicks. See carryCell. Writing and pictures were carried this way too, until each was put down
    ///once and sized by a frame instead; see Piece.
    ///
    ///The outlines are in database units, and the middle is the point the pointer holds, in the same units.
    ///
    private sealed record Stamp(StampKind Kind, string Says, List<List<Point>> Outlines, double MiddleX, double MiddleY);

    ///<summary>What a stamp in hand is, or a piece just put down: writing, a picture, or a mark - Generator's structures.</summary>
    private enum StampKind { Text, Picture, Mark }

    ///<summary>The mark in hand, or null. Never at the same time as a cell.</summary>
    private Stamp? stamp;

    ///
    ///What the line over the drawing says, while writing or a picture is being sized, about which way up it comes out.
    ///
    ///**The right way round here, which is mirrored in the file** (2026-10-21, asked for). This view puts the format's
    ///upward Y onto the screen's downward one - long-standing, see the 2D view in the documentation - and the 3D view
    ///frames a layout the same way round, so nothing drawn can read right both here and in KLayout or on the die.
    ///Until this date it was drawn for the file and read here as an upside-down mirror image of itself, "Text"
    ///starting with an upturned T; it was asked to read right here. That is mirror writing on silicon, and nothing
    ///else in this app would show that it was - so this says it, and Mirror down, in the frame's menu and on Ctrl+M,
    ///puts it upright there.
    ///
    private const string UprightHere = "It reads the right way round here, so in the file and on the chip - this view draws Y downward - it is mirrored top to bottom. Mirror down (Ctrl+M) puts it upright there.";

    ///<summary>The longest line of writing taken: 120 characters is 719 squares, which is a long way past a part number.</summary>
    private const int LongestStampText = 120;

    ///<summary>The most lines writing takes: a few lines pasted whole, a name and an address, rather than a page.</summary>
    private const int MostWritingLines = 12;

    ///<summary>What writing put down with the Text row says until it is typed over, the way a label says "label".</summary>
    private const string DefaultWriting = "Text";

    ///
    ///The most squares a picture is drawn across, or down.
    ///
    ///A logo is a few dozen to a couple of hundred squares wide. A photograph read at its own resolution would
    ///be millions, and a layout of millions of shapes is not a logo - it is a file that takes a minute to open.
    ///
    private const int MostPictureSquares = 256;

    ///<summary>The fewest squares across a picture is read down to when it breaks into too many specks. See readPictureAt.</summary>
    private const int LeastPictureSquares = 8;

    ///<summary>The largest picture file read. A logo is kilobytes; this is room for a careless export.</summary>
    private const long MaximumPictureSize = 16 * 1024 * 1024;

    ///
    ///The most separate outlines one picture may put down.
    ///
    ///A word is a few dozen and a logo a few hundred. A photograph read into squares is thousands of specks,
    ///each its own boundary and its own step into the file - measured on Mosfet in a development build, a noisy
    ///picture 128 squares across came out as 1,044 of them and took 1.6 seconds to put down, and one 256 across
    ///as 4,263 taking 11.7. A tab that stops answering for that long reads as a crash, and nothing a logo needs
    ///comes near the ceiling.
    ///
    private const int MostPictureShapes = 2000;

    ///
    ///The largest writing or picture taken, along its longest side, in microns: a centimeter.
    ///
    ///Nothing on a die is drawn bigger, and the ceiling keeps the arithmetic inside the file's coordinates -
    ///a GDSII coordinate is a 32-bit integer, and a corner dragged out past the window is not.
    ///
    private const double MostMicrons = 10_000;

    ///<summary>A picture file, kept so its frame's corner can draw it again at another size without asking for the file twice.</summary>
    private sealed record PictureFile(string Name, string Type, byte[] Bytes);

    ///<summary>A picture as the interop hands it back: its size in squares, its own size in pixels, which side was drawn, and a row of # and . for each.</summary>
    private sealed class PictureSquares
    {
        public int Width { get; set; }
        public int Height { get; set; }
        public int NaturalWidth { get; set; }
        public int NaturalHeight { get; set; }
        public string Drawn { get; set; } = "";
        public string[] Rows { get; set; } = Array.Empty<string>();
    }

    ///<summary>
    ///A length in microns as a whole number of the file's units, and never none.
    ///
    ///A file that says nothing usable about its scale is taken at one unit to the micron, the same choice a
    ///path's width makes: a size somebody typed should put *something* down.
    ///</summary>
    private int unitsFor(double microns)
    {
        double perUnit = 1;

        if (micronsPerUnit() is double scale && scale > 0)
            perUnit = scale;

        return (int)Math.Clamp(Math.Round(microns / perUnit), 1, int.MaxValue / 4);
    }

    ///
    ///Whether a bitmap at this size stays inside the coordinates a GDSII file can hold.
    ///
    ///Said rather than wrapped round. A coordinate is a 32-bit integer, and arithmetic that overflows does not
    ///fail, it puts the shapes somewhere else.
    ///
    private bool fitsTheFile(bool[,] lit, int square)
    {
        long longest = Math.Max(lit.GetLength(0), lit.GetLength(1));

        if (longest * square <= int.MaxValue / 4)
            return true;

        drawRefusal = "That is too big for this file: at its size it runs past the largest coordinate a GDSII file can hold. Make it smaller.";

        return false;
    }

    ///
    ///Writing or a picture just put down, and still sized and moved by the frame round it - see showPiece in the
    ///interop. Asked for 2026-10-19, in place of the Text and Image rows' boxes: a height for writing, and for a
    ///picture the size of a square, how many squares across and which side of it is the shape.
    ///
    ///**Down at once, as one step, and put down again in place of itself** when the frame's corner or middle is
    ///dragged, its words are typed over or another layer is picked: the step is taken back and taken again, so
    ///one undo still takes all of it - the way a label just placed is named. Let go of by Enter, Escape, a press
    ///anywhere else, or any other step at all; after that it is shapes like any others.
    ///
    ///Its bitmap is kept, so moving it or putting it on another layer reads nothing again; only a picture sized
    ///to a different number of squares across is read again, from the bytes it came in as. Left and Top are the
    ///frame's corner nearest the origin, in the layout's units as this view has them - the top left on screen.
    ///
    ///**Kept as read, and turned where it lies** (2026-10-21): the bitmap is the words or the picture the way they
    ///read, and Quarters and MirroredDown say how it lies - so the words typed again, or a picture read again at
    ///another size, come out turned the same way. See Seen, and turnPiece.
    ///
    private sealed record Piece(
        StampKind Kind,
        IReadOnlyList<string> Lines,
        PictureFile? Picture,
        int NaturalWidth,
        int NaturalHeight,
        int Across,
        bool[,] Lit,
        int Square,
        long Left,
        long Top,
        LayerKey Layer,
        string Structure,
        int Version)
    {
        ///<summary>How many quarters it is turned to the right as it is seen, zero to three, after MirroredDown.</summary>
        public int Quarters { get; init; }

        ///<summary>Whether it is mirrored top to bottom, before it is turned - which is how it reads in the file and on the chip.</summary>
        public bool MirroredDown { get; init; }

        ///<summary>How many squares across it lies: the bitmap's, or its rows when a quarter turn has it on its side.</summary>
        public int Columns
        {
            get
            {
                if (Quarters % 2 == 1)
                    return Lit.GetLength(0);

                return Lit.GetLength(1);
            }
        }

        public int Rows
        {
            get
            {
                if (Quarters % 2 == 1)
                    return Lit.GetLength(1);

                return Lit.GetLength(0);
            }
        }

        ///<summary>How wide it is, in the layout's units: its squares at the size of one.</summary>
        public long Width => (long)Columns * Square;

        public long Height => (long)Rows * Square;

        ///<summary>The bitmap the way it is seen in this view: mirrored and turned as asked, its first row at the top of the screen.</summary>
        public bool[,] Seen()
        {
            var lit = Lit;

            if (MirroredDown)
                lit = Raster.MirroredDown(lit);

            return Raster.Turned(lit, Quarters);
        }

        ///<summary>What the line over the drawing calls it: the words, cut short, or the picture's name.</summary>
        public string Says
        {
            get
            {
                if (Picture is not null)
                    return Picture.Name;

                string words = string.Join(" ", Lines);

                if (words.Length > 24)
                    words = words[..23] + "…";

                return $"“{words}”";
            }
        }
    }

    ///<summary>The writing or picture whose frame is up, or null.</summary>
    private Piece? piece;

    ///<summary>Whether the piece is still the last step taken, in the cell being edited. Anything else, and it is let go of.</summary>
    private bool pieceLive()
    {
        return piece is not null && History.Version == piece.Version && context is not null && context.Structure == piece.Structure;
    }

    ///
    ///Lets go of the piece and takes its frame away - its words kept first, when their box is open, since moving on
    ///to something else is not a request to lose them. See commitWords.
    ///
    private async Task settlePiece()
    {
        if (wordsOpen)
            await commitWords(framed: false);

        wordsOpen = false;
        wordsJustPlaced = false;

        if (piece is null)
            return;

        piece = null;

        try
        {
            await js.InvokeVoidAsync("hidePiece");
        }
        catch (JSException) { }
    }

    ///<summary>The frame round the piece, where it is - see showPiece in the interop.</summary>
    private async Task showFrame()
    {
        if (piece is null)
            return;

        keyHandle ??= DotNetObjectReference.Create(this);

        string kind = "picture";

        if (piece.Kind == StampKind.Text)
            kind = "text";

        await js.InvokeVoidAsync("showPiece", keyHandle, kind, piece.Left, piece.Top, piece.Width, piece.Height, PieceArrows);
    }

    ///<summary>The frame's two arrows, drawn as the toolbar's Turn left and Turn right are - see drawPieceFrame in the interop.</summary>
    private static readonly object PieceArrows = new
    {
        left = SvgWriter.IconFor(SvgWriter.ShapeIcon.TurnLeft),
        right = SvgWriter.IconFor(SvgWriter.ShapeIcon.TurnRight)
    };

    ///<summary>The Draw tool's refusal outside a cell, for anything else that would put a shape down there.</summary>
    private const string NoCellToDrawInto = "Nothing to draw into: a new shape goes in a cell. Pick one from the cell tree, or click a shape to edit the cell it is in.";

    ///<summary>Whether there is a cell to put something into, said out loud when there is not - the way the Draw tool says it.</summary>
    private bool canPutDown()
    {
        if (Gds is null || ReadOnly)
            return false;

        if (context is not null)
            return true;

        drawRefusal = NoCellToDrawInto;

        StateHasChanged();

        return false;
    }

    ///
    ///The layer something put down without a click of the pencil goes on - the pencil's own answer: the layer being
    ///drawn on while the pencil is out, and otherwise the chosen shapes' layer when they are all on one, the layer
    ///being drawn on, or the first the file has. See startDrawingShapes.
    ///
    private LayerKey pieceLayer()
    {
        var layers = drawableLayers();

        if (drawingShapes && layers.Any(layer => layer.Key.Equals(drawOn)))
            return drawOn;

        var chosenOn = ChosenByLayer().Keys.ToList();

        if (chosenOn.Count == 1 && layers.Any(layer => layer.Key.Equals(chosenOn[0])))
            return chosenOn[0];

        if (layers.Count == 0 || layers.Any(layer => layer.Key.Equals(drawOn)))
            return drawOn;

        return layers[0].Key;
    }

    ///<summary>How finely a square's size goes: a step of the grid while snapping, so what is put down lands on it, and a unit when not.</summary>
    private int squareStep()
    {
        if (!snapping)
            return 1;

        return Math.Max(1, (int)Math.Round(gridUnits()));
    }

    ///
    ///The square nearest a size: a whole number of steps, on the deck's grid of the layer being drawn on, at least one
    ///step - and no larger than keeps the bitmap's longest side within a centimeter and within what a file holds.
    ///
    ///**`fine` for a size somebody dragged**, which goes by the deck's grid alone. A step of the view's grid is what a
    ///first size is rounded to, so writing starts out lined up with it; but a square of writing twenty-three of them
    ///wide on a 50 nm grid moves a corner 1,150 nm a step - a corner dragged a sensible distance came back where it
    ///was. The deck's grid is what the corners have to be on, and its steps are a tenth of that.
    ///
    private int squareNear(double units, bool[,] lit, bool fine = false)
    {
        int step = squareStep();

        if (fine)
            step = 1;

        long longest = Math.Max(1, Math.Max(lit.GetLength(0), lit.GetLength(1)));

        double perUnit = 1;

        if (micronsPerUnit() is double scale && scale > 0)
            perUnit = scale;

        long most = Math.Max(1, Math.Min((long)(MostMicrons / perUnit / longest), (int.MaxValue / 4) / longest));
        long steps = Math.Max(1, (long)Math.Round(units / step));

        return onDeckGrid((int)Math.Clamp(steps * step, 1, most));
    }

    ///<summary>What is on screen, in the layout's units, as the interop measures it - see shownArea.</summary>
    private sealed class ShownArea
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private async Task<ShownArea?> areaShown()
    {
        try
        {
            return await js.InvokeAsync<ShownArea?>("shownArea");
        }
        catch (JSException)
        {
            return null;
        }
    }

    ///
    ///Where something put down without a click goes: the point given - a drop, the pointer - or else the middle of
    ///what is on screen, on the grid while snapping, so the squares land on it.
    ///
    private async Task<(double X, double Y)> landing(LayoutPoint? at)
    {
        if (at is not null)
            return (at.X, at.Y);

        if (await areaShown() is not ShownArea area)
            return (0, 0);

        int step = squareStep();

        double x = Math.Round((area.X + (area.Width / 2)) / step) * step;
        double y = Math.Round((area.Y + (area.Height / 2)) / step) * step;

        return (x, y);
    }

    ///
    ///Where a bitmap's corner goes for its middle to be on a point - a whole number of squares in from it, so that
    ///with the grid on the squares land on the grid the point is on.
    ///
    private static (long Left, long Top) heldBy(double x, double y, bool[,] lit, int square)
    {
        long left = (long)Math.Round(x) - ((long)(lit.GetLength(1) / 2) * square);
        long top = (long)Math.Round(y) - ((long)(lit.GetLength(0) / 2) * square);

        return (left, top);
    }

    ///
    ///Puts a piece down as one step - or in place of itself when `replacing`, taking its step back first so it stays
    ///one - and shows the frame round it unless told not to. False when there is nowhere to put it.
    ///
    ///**Each corner taken into the cell on its own**, the way a drawn shape's corners are - so writing put down on
    ///a cell that is turned comes out turned with it rather than square to the cell - from a corner that is a whole
    ///number of units, so every square comes out the same size.
    ///
    ///**The right way round as it is seen here** (2026-10-21, asked for): Raster puts a bitmap's first row highest,
    ///which is upright in the file and on the chip and mirrored in this view, which draws Y downward. So it is given
    ///what is seen mirrored down, and the first row lands at the least Y - the top of the screen. It was put down
    ///upright in the file, and read "Text" as an upside-down mirror image here; Mirror down puts it that way again.
    ///
    private async Task<bool> putPiece(Piece wanted, bool replacing, bool framed = true)
    {
        if (Gds is null || context is null || ReadOnly)
            return false;

        //In place of itself only while it is still the last step: anything taken since, and there is nothing of it to take back.
        if (replacing && !pieceLive())
            return false;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return false;

        if (!fitsTheFile(wanted.Lit, wanted.Square))
            return false;

        var outlines = Raster.Polygons(Raster.MirroredDown(wanted.Seen()), wanted.Square);

        if (outlines.Count == 0)
            return false;

        var edits = new List<LayoutEdit>();

        foreach (var outline in outlines)
        {
            var local = new List<Point>(outline.Count);

            foreach (var corner in outline)
            {
                if (context.ToLocal(wanted.Left + corner.X, wanted.Top + corner.Y) is not (double localX, double localY))
                    return false;

                local.Add(new Point((int)Math.Round(localX), (int)Math.Round(localY)));
            }

            edits.Add(new AddElement(Gds, structure, wanted.Layer, local));
        }

        string named = "Place image";

        if (wanted.Kind == StampKind.Text)
            named = "Place text";

        if (replacing)
            History.Undo();

        History.Do(new CompoundEdit(named, edits));

        piece = wanted with { Structure = context.Structure, Version = History.Version };
        drawRefusal = "";

        await afterEdit();

        if (framed)
            await showFrame();

        return true;
    }

    #region Writing ******************************************

    ///
    ///Words as the lines they are written in: tabs as four spaces, each line's end trimmed, the empty lines at either
    ///end dropped, and no more than the most lines, or characters a line, that writing takes.
    ///
    private static List<string> linesOf(string text)
    {
        var lines = new List<string>();

        foreach (string raw in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            string line = raw.Replace("\t", "    ").TrimEnd();

            if (line.Length > LongestStampText)
                line = line[..LongestStampText];

            lines.Add(line);
        }

        while (lines.Count > 0 && lines[0].Trim().Length == 0)
            lines.RemoveAt(0);

        while (lines.Count > 0 && lines[^1].Trim().Length == 0)
            lines.RemoveAt(lines.Count - 1);

        if (lines.Count > MostWritingLines)
            lines.RemoveRange(MostWritingLines, lines.Count - MostWritingLines);

        return lines;
    }

    ///
    ///Writing's first size: a capital a fourteenth of what is on screen tall, so it comes out readable at the zoom
    ///it was asked for at - and no wider than most of the screen, for a long line pasted.
    ///
    private int startingTextSquare(bool[,] lit, ShownArea? area)
    {
        if (area is null || !(area.Height > 0) || lit.GetLength(1) == 0)
            return squareNear(squareStep(), lit);

        double square = area.Height / 14 / PixelFont.Height;

        if (lit.GetLength(1) * square > area.Width * 0.8)
            square = area.Width * 0.8 / lit.GetLength(1);

        return squareNear(square, lit);
    }

    ///<summary>Writing put down with its middle on a point, at a size that suits what is on screen, on the layer it would be drawn on.</summary>
    private async Task<bool> startWriting(IReadOnlyList<string> lines, double x, double y)
    {
        var lit = PixelFont.Lines(lines);

        if (lit.GetLength(1) == 0)
            return false;

        await emptyHand();

        var layer = pieceLayer();

        drawOn = layer;

        int square = startingTextSquare(lit, await areaShown());
        var (left, top) = heldBy(x, y, lit, square);

        return await putPiece(new Piece(StampKind.Text, lines, null, 0, 0, 0, lit, square, left, top, layer, "", 0), replacing: false);
    }

    ///
    ///The Text row's click: writing put down there reading "Text", and a box under it for the words - the way a label
    ///is placed, and for the same reason: it says something before it is typed.
    ///
    [JSInvokable]
    public async Task OnWritingPlaced(double x, double y)
    {
        if (!canPutDown())
            return;

        if (!await startWriting(new[] { DefaultWriting }, x, y))
            return;

        wordsJustPlaced = true;

        await openWords();
    }

    ///
    ///Words pasted onto the drawing, written as shapes where the pointer is, or else in the middle of what is on
    ///screen - each line of them a line of writing. See onEditorPaste in the interop, which tells words from shapes.
    ///
    [JSInvokable]
    public async Task OnTextPasted(string text)
    {
        if (!canPutDown())
            return;

        var lines = linesOf(text);

        if (lines.Count == 0)
            return;

        var (x, y) = await landing(await js.InvokeAsync<LayoutPoint?>("pointerLayoutPoint"));

        await startWriting(lines, x, y);
    }

    ///<summary>Whether the box for writing's words is open, and whether the writing it is for was put down a moment ago.</summary>
    private bool wordsOpen;
    private bool wordsJustPlaced;

    private string wordsText = "";

    ///<summary>What the words were when the box opened, so keeping them unchanged is not a step.</summary>
    private string wordsWas = "";

    ///<summary>Where the box goes, in pixels from the corner of the view: under the frame. See pieceBox in the interop.</summary>
    private (double X, double Y) wordsAt = (0, 0);

    private bool focusWords;

    private ElementReference wordsBox;

    ///<summary>Opens the box for the words under the frame of the writing that is up, and hands it the keyboard.</summary>
    private async Task openWords()
    {
        if (piece is null || piece.Kind != StampKind.Text)
            return;

        if (await js.InvokeAsync<LabelBox?>("pieceBox") is not LabelBox box)
            return;

        wordsText = string.Join("\n", piece.Lines);
        wordsWas = wordsText;
        wordsAt = (box.X, box.Y + box.Height + 6);
        wordsOpen = true;
        focusWords = true;

        StateHasChanged();
    }

    ///<summary>A double-click on writing whose frame is up, or Edit text in the frame's menu, opens the box for its words.</summary>
    [JSInvokable]
    public async Task OnPieceRetyped()
    {
        if (!pieceLive() || piece?.Kind != StampKind.Text)
            return;

        wordsJustPlaced = false;

        await openWords();
    }

    private void changeWords(ChangeEventArgs e)
    {
        wordsText = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps the words - Shift+Enter starts another line - and Escape takes them back. Both then close the box.</summary>
    private async Task onWordsKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await commitWords(framed: true);

            return;
        }

        if (e.Key == "Escape")
            await cancelWords();
    }

    ///
    ///A press somewhere other than the box keeps the words - a press on the writing's own frame with the frame still
    ///up, and anywhere else putting the writing down for good. See onDismissRetype in the interop.
    ///
    [JSInvokable]
    public async Task OnWordsDismissed(bool onFrame)
    {
        if (!wordsOpen)
            return;

        if (onFrame)
        {
            await commitWords(framed: true);

            return;
        }

        await settlePiece();

        StateHasChanged();
    }

    ///
    ///Keeps what was typed: the writing put down again saying it, in place of itself, so typing the words is part of
    ///the step that put it down. The same words, or none, change nothing - a box cleared and left was somebody
    ///stopping, not asking for the writing to go.
    ///
    private async Task commitWords(bool framed)
    {
        var lines = linesOf(wordsText);
        string was = wordsWas;

        wordsOpen = false;
        wordsJustPlaced = false;

        if (piece is null || piece.Kind != StampKind.Text || lines.Count == 0 || string.Join("\n", lines) == was)
        {
            StateHasChanged();

            return;
        }

        await putPiece(piece with { Lines = lines, Lit = PixelFont.Lines(lines) }, replacing: true, framed: framed);
    }

    ///
    ///Escape in the box. On writing put down a moment ago with the Text row, the writing goes too - what was there
    ///before was nothing, and "Text" left behind would be the gesture half done. Otherwise only the box closes.
    ///
    private async Task cancelWords()
    {
        bool placed = wordsJustPlaced;

        wordsOpen = false;
        wordsJustPlaced = false;

        if (placed && pieceLive())
        {
            piece = null;

            History.Undo();

            await js.InvokeVoidAsync("hidePiece");

            await afterEdit();

            return;
        }

        StateHasChanged();
    }

    #endregion ***********************************************

    #region Pictures *****************************************

    ///<summary>A picture read into squares, the number across it was read at, and its own size in pixels.</summary>
    private sealed record PictureRead(bool[,] Lit, int Across, int NaturalWidth, int NaturalHeight);

    ///
    ///How many squares across a picture is read at for a width: one a pixel of its own, up to the most a picture is
    ///read at - unless that would make a square finer than a step, and then fewer, so a picture made small is drawn
    ///at the detail its size can hold. With no width yet, as many as it has pixels.
    ///
    ///A step of the view's grid for a first size, and of the deck's for a size somebody dragged - see squareNear.
    ///
    private int pictureAcross(int naturalWidth, double width, bool fine = false)
    {
        int across = Math.Clamp(naturalWidth, 1, MostPictureSquares);
        int step = squareStep();

        if (fine)
            step = deckGrid(drawOn);

        if (width > 0 && width / across < step)
            across = Math.Max(1, (int)Math.Floor(width / step));

        return across;
    }

    ///<summary>A picture read into squares by the browser, so many across - nothing for one a pixel - or null when it cannot read it as one.</summary>
    private async Task<PictureSquares?> readPicture(PictureFile file, int across)
    {
        try
        {
            return await js.InvokeAsync<PictureSquares?>("pictureSquares", file.Bytes, file.Type, across, MostPictureSquares);
        }
        catch (JSException)
        {
            return null;
        }
    }

    ///
    ///A picture read for a width - its own size learned from the first read when it is not known yet.
    ///
    ///**Said when it cannot be done**, in the refusal's place over the drawing: a file the browser cannot read as a
    ///picture, and one that is all ground, with nothing on it that its border is not. A picture that breaks into
    ///more specks than one may put down is read again fewer squares across until it does not - there is no box to
    ///ask for that in any more - and one that still does at the fewest is said as a photograph.
    ///
    private async Task<PictureRead?> readPictureAt(PictureFile file, double width, int naturalWidth, bool fine = false)
    {
        int across = 0;

        if (naturalWidth > 0)
            across = pictureAcross(naturalWidth, width, fine);

        var squares = await readPicture(file, across);

        if (squares is null || squares.Rows.Length == 0)
        {
            drawRefusal = $"{file.Name} could not be read as a picture. A PNG, JPEG, GIF, BMP, WebP or SVG can.";

            return null;
        }

        //Read at one square a pixel to learn its size, and again at fewer for a width that cannot hold them all.
        int wanted = pictureAcross(squares.NaturalWidth, width, fine);

        if (wanted < squares.Width && await readPicture(file, wanted) is PictureSquares fewer && fewer.Rows.Length > 0)
            squares = fewer;

        var lit = Raster.FromRows(squares.Rows);
        int specks = Raster.Polygons(lit, 1).Count;

        while (specks > MostPictureShapes && squares.Width > LeastPictureSquares)
        {
            int narrower = Math.Max(LeastPictureSquares, (int)(squares.Width * 0.7));

            if (await readPicture(file, narrower) is not PictureSquares again || again.Rows.Length == 0)
                break;

            squares = again;
            lit = Raster.FromRows(squares.Rows);
            specks = Raster.Polygons(lit, 1).Count;
        }

        if (specks == 0)
        {
            drawRefusal = $"Nothing in {file.Name} to draw: it is all the one shade its border is, and the border is taken for the ground.";

            return null;
        }

        if (specks > MostPictureShapes)
        {
            drawRefusal = FormattableString.Invariant($"{file.Name} comes out as {specks:N0} separate shapes even {LeastPictureSquares} squares across, past the {MostPictureShapes:N0} a picture may put down - that is a photograph rather than a logo. Simplify the picture first.");

            return null;
        }

        return new PictureRead(lit, squares.Width, squares.NaturalWidth, squares.NaturalHeight);
    }

    ///
    ///A picture's first width: a third of what is on screen across, or for a tall one half of it down - so it comes
    ///out a size that suits the zoom it was asked for at. Nothing when nothing says what is on screen.
    ///
    private static double startingPictureWidth(int naturalWidth, int naturalHeight, ShownArea? area)
    {
        if (area is null || !(area.Width > 0) || !(area.Height > 0) || naturalWidth <= 0 || naturalHeight <= 0)
            return 0;

        double width = area.Width / 3;

        if (width * naturalHeight / naturalWidth > area.Height / 2)
            width = (area.Height / 2) * naturalWidth / naturalHeight;

        return width;
    }

    ///
    ///A picture file, read and put down: where it was dropped or pasted - the interop says, once - or else in the
    ///middle of what is on screen, for one chosen from the Image row.
    ///
    ///**The file input is the one way in**, from the row, a drop and a paste alike - see handPicture in the
    ///interop - so all three read, refuse and place the same way. Read whole into memory and kept, so the frame's
    ///corner can draw it again at another size without the file being asked for again.
    ///
    private async Task pictureChosen(InputFileChangeEventArgs e)
    {
        byte[]? bytes = null;
        string failed = "";

        try
        {
            await using var stream = e.File.OpenReadStream(MaximumPictureSize);
            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            bytes = memory.ToArray();
        }
        catch (Exception ex)
        {
            failed = ex.Message;
        }

        //Read or not, so choosing the same file again - changed, or after a failure - is a change the input
        //reports. See forgetChosenFile.
        await js.InvokeVoidAsync("forgetChosenFile", "stampPicture");

        var at = await js.InvokeAsync<LayoutPoint?>("takePictureAt");

        shapeMenuOpen = false;

        if (bytes is null)
        {
            drawRefusal = $"Could not read {e.File.Name}: {failed}";

            return;
        }

        if (!canPutDown())
            return;

        await startPicture(new PictureFile(e.File.Name, e.File.ContentType, bytes), at);
    }

    ///<summary>A picture put down with its middle on a point, at a size that suits what is on screen, on the layer it would be drawn on.</summary>
    private async Task startPicture(PictureFile file, LayoutPoint? at)
    {
        await emptyHand();

        var layer = pieceLayer();

        drawOn = layer;

        var area = await areaShown();

        if (await readPictureAt(file, 0, 0) is not PictureRead read)
        {
            StateHasChanged();

            return;
        }

        double width = startingPictureWidth(read.NaturalWidth, read.NaturalHeight, area);

        if (width > 0 && pictureAcross(read.NaturalWidth, width) < read.Across)
        {
            if (await readPictureAt(file, width, read.NaturalWidth) is not PictureRead fewer)
            {
                StateHasChanged();

                return;
            }

            read = fewer;
        }

        if (!(width > 0))
            width = read.Across * squareStep();

        int square = squareNear(width / read.Across, read.Lit);
        var (x, y) = await landing(at);
        var (left, top) = heldBy(x, y, read.Lit, square);

        var made = new Piece(StampKind.Picture, Array.Empty<string>(), file, read.NaturalWidth, read.NaturalHeight, read.Across, read.Lit, square, left, top, layer, "", 0);

        if (!await putPiece(made, replacing: false))
            StateHasChanged();
    }

    #endregion ***********************************************

    #region The frame's corner, middle and keys **************

    ///
    ///The frame's corner let go of at a new width: the writing or the picture put down again that wide, its
    ///proportions kept and its top left corner where it was, in place of itself.
    ///
    ///A picture sized to hold a different number of squares across is read again - more detail as it grows, up to a
    ///square a pixel, and less as it shrinks past what its squares can be. A size that comes out as the square it
    ///already is changes nothing, and the frame goes back round it.
    ///
    [JSInvokable]
    public async Task OnPieceSized(double width)
    {
        if (!pieceLive() || piece is null)
        {
            await settlePiece();

            StateHasChanged();

            return;
        }

        var was = piece;
        var lit = was.Lit;
        int across = was.Across;

        //How wide it is as read - its height on screen, while a quarter turn has it on its side - which is what a picture is read across.
        double ownWidth = width * lit.GetLength(1) / Math.Max(1, was.Columns);

        if (was.Kind == StampKind.Picture && was.Picture is not null && pictureAcross(was.NaturalWidth, ownWidth, fine: true) != was.Across)
        {
            if (await readPictureAt(was.Picture, ownWidth, was.NaturalWidth, fine: true) is not PictureRead read)
            {
                await showFrame();

                StateHasChanged();

                return;
            }

            lit = read.Lit;
            across = read.Across;
        }

        int square = squareNear(ownWidth / Math.Max(1, lit.GetLength(1)), lit, fine: true);

        if (ReferenceEquals(lit, was.Lit) && square == was.Square)
        {
            await showFrame();

            return;
        }

        if (!await putPiece(was with { Lit = lit, Across = across, Square = square }, replacing: true))
        {
            await showFrame();

            StateHasChanged();
        }
    }

    ///<summary>The frame's middle let go of somewhere else: the piece put down again there, in place of itself.</summary>
    [JSInvokable]
    public async Task OnPieceMoved(double dx, double dy)
    {
        if (!pieceLive() || piece is null)
        {
            await settlePiece();

            StateHasChanged();

            return;
        }

        long left = piece.Left + (long)Math.Round(dx);
        long top = piece.Top + (long)Math.Round(dy);

        if (!await putPiece(piece with { Left = left, Top = top }, replacing: true))
            await showFrame();
    }

    ///
    ///The piece turned a quarter or mirrored where it lies, in place of itself - asked for 2026-10-21, as part of
    ///putting it down rather than a step on the shapes after: R and Shift+R, Ctrl+M, the frame's arrows and its menu.
    ///
    ///**A quarter about its middle, by whole squares**, so squares that were on the grid stay on it and two turns
    ///come back to the corner they left; a mirror leaves the frame where it is. Its words are kept first when their
    ///box is open, since the box sits under the frame and a turn moves the frame.
    ///
    private async Task turnPiece(Turn turn)
    {
        if (!pieceLive() || piece is null)
        {
            await settlePiece();

            StateHasChanged();

            return;
        }

        if (wordsOpen)
            await commitWords(framed: false);

        if (piece is null)
            return;

        var was = piece;
        int quarters = was.Quarters;
        bool mirrored = was.MirroredDown;
        long left = was.Left;
        long top = was.Top;

        if (turn == Turn.Quarter || turn == Turn.ThreeQuarters)
        {
            int by = 1;

            if (turn == Turn.ThreeQuarters)
                by = 3;

            quarters = (quarters + by) % 4;
            left += ((was.Columns - was.Rows) / 2) * (long)was.Square;
            top += ((was.Rows - was.Columns) / 2) * (long)was.Square;
        }
        else
        {
            //A mirror after the turns is the same mirror before them with the turns the other way - and across is down and a half turn.
            quarters = (4 - quarters) % 4;

            if (turn == Turn.FlipX)
                quarters = (quarters + 2) % 4;

            mirrored = !mirrored;
        }

        if (!await putPiece(was with { Quarters = quarters, MirroredDown = mirrored, Left = left, Top = top }, replacing: true))
            await showFrame();
    }

    ///<summary>R, Shift+R, Ctrl+M or one of the frame's arrows: "right", "left", "across" or "down" - see onPieceKey in the interop.</summary>
    [JSInvokable]
    public async Task OnPieceTurned(string how)
    {
        var turn = Turn.Quarter;

        if (how == "left")
            turn = Turn.ThreeQuarters;
        else if (how == "across")
            turn = Turn.FlipX;
        else if (how == "down")
            turn = Turn.FlipY;

        await turnPiece(turn);
    }

    ///
    ///The frame's own menu, raised by the right button on it: a quarter either way, a mirror either way, and taking it
    ///back - each line saying its key, so the menu is where the keys are learned. Mirror down is how it reads in the
    ///file and on the chip.
    ///
    ///**Writing's words first** (2026-11-01, asked for): the box under the frame opened again, as a double-click on it
    ///does - see OnPieceRetyped.
    ///
    private List<MenuLine?> pieceMenuLines()
    {
        var lines = new List<MenuLine?>();

        if (piece?.Kind == StampKind.Text)
        {
            lines.Add(Action("Edit text", OnPieceRetyped, true, "Change the words (double-click)", SvgWriter.ShapeIcon.Rename));
            lines.Add(null);
        }

        lines.AddRange(new List<MenuLine?>
        {
            Action("Turn left", () => turnPiece(Turn.ThreeQuarters), true, "A quarter to the left, about its middle (Shift+R)", SvgWriter.ShapeIcon.TurnLeft),
            Action("Turn right", () => turnPiece(Turn.Quarter), true, "A quarter to the right, about its middle (R)", SvgWriter.ShapeIcon.TurnRight),
            null,
            Action("Mirror across", () => turnPiece(Turn.FlipX), true, "Mirror left to right", SvgWriter.ShapeIcon.MirrorAcross),
            Action("Mirror down", () => turnPiece(Turn.FlipY), true, "Mirror top to bottom (Ctrl+M) - upright in the file and on the chip, which this view draws Y downward to", SvgWriter.ShapeIcon.MirrorDown),
            null,
            Action("Delete", deletePiece, true, "Take it back (Delete)", SvgWriter.ShapeIcon.Delete)
        });

        return lines;
    }

    ///<summary>Delete from the frame's menu: the frame taken away, and the piece with it - see OnPieceDeleted.</summary>
    private async Task deletePiece()
    {
        try
        {
            await js.InvokeVoidAsync("hidePiece");
        }
        catch (JSException) { }

        await OnPieceDeleted();
    }

    ///<summary>Put down for good - Enter, Escape, or a press somewhere else. The interop has taken the frame away already.</summary>
    [JSInvokable]
    public async Task OnPieceDone()
    {
        await settlePiece();

        StateHasChanged();
    }

    ///<summary>Delete or Backspace with the frame up: the piece taken back, which is its one step undone.</summary>
    [JSInvokable]
    public async Task OnPieceDeleted()
    {
        bool live = pieceLive();

        wordsOpen = false;
        wordsJustPlaced = false;
        piece = null;

        if (!live)
        {
            StateHasChanged();

            return;
        }

        History.Undo();

        await afterEdit();
    }

    #endregion ***********************************************

    ///
    ///The stamp, drawn the way its layer is drawn, for the pointer to carry.
    ///
    ///On that layer whether or not the layer is showing. A shape drawn onto a hidden layer is still drawn while
    ///it is being placed - see drawableLayers - and a stamp that followed the pointer invisibly would be a
    ///pointer carrying nothing anybody could aim. A layer the table has not got yet, the first shape of a new
    ///library, is drawn in the gray a new layer gets.
    ///
    private string stampDrawing()
    {
        if (stamp is null || Gds is null)
            return "";

        if (!Gds.AdditionalInformation.Layers.TryGetValue(drawOn, out var layer))
            layer = new Layer(drawOn, AdditionalGDSInformation.NewLayerColor);

        var drawn = new FlattenedLayout();

        foreach (var outline in stamp.Outlines)
            drawn.Elements.Add(new Element { Layer = layer, Points = outline });

        return SvgWriter.Build(
            drawn,
            new HashSet<LayerKey> { drawOn },
            CarriedOpacity,
            new HashSet<LayerKey>(),
            null,
            null,
            0,
            SvgWriter.PictureToken("stamp"));
    }

    ///
    ///Puts the stamp down: every outline, on the layer being drawn on, as one step.
    ///
    ///**Each corner taken through the placement and back into the cell on its own**, the way a drawn shape's
    ///corners are - so a mark put down on a cell that is turned comes out turned with it rather than square to
    ///the cell. The placement is the one a cell's record would carry, from the same transform the flattener
    ///uses, so the shapes land exactly where the picture under the pointer was.
    ///
    ///The point is rounded once, before anything is turned, so every corner moves by the same whole number of
    ///units. Rounding each corner after would round a point that lands on a half one way at one corner and
    ///the other way at the next, and a square would come out a unit wider than its neighbor.
    ///
    ///One step on the undo stack however many outlines - a mark is one thing put down, not one per piece of it.
    ///
    private async Task dropStamp(double x, double y, int angle, bool mirrored)
    {
        if (Gds is null || context is null || stamp is null)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var placed = Transform.ForPlacement(
            mirrored,
            1,
            angle,
            Math.Round(x, MidpointRounding.AwayFromZero),
            Math.Round(y, MidpointRounding.AwayFromZero));

        var edits = new List<LayoutEdit>();

        foreach (var outline in stamp.Outlines)
        {
            var local = new List<Point>(outline.Count);

            foreach (var corner in outline)
            {
                (double turnedX, double turnedY) = placed.ApplyTo(corner.X, corner.Y);

                if (context.ToLocal(turnedX, turnedY) is not (double localX, double localY))
                    return;

                local.Add(new Point((int)Math.Round(localX), (int)Math.Round(localY)));
            }

            edits.Add(new AddElement(Gds, structure, drawOn, local));
        }

        History.Do(new CompoundEdit("Place " + stamp.Says.ToLowerInvariant(), edits));

        //Still in hand afterwards, like a cell: a row of the same mark is a row of clicks.
        await afterEdit();
    }

    #endregion ***********************************************

    #region Marks made from numbers **************************

    ///<summary>Which kind of mark the panel shows. A die frame to start, since a die starts there.</summary>
    private string markKey = Marks.All[0].Key;

    ///
    ///What has been typed for each family of kinds, by the family and then by the setting's name - see MarkMaker.Family.
    ///
    ///**Kept per kind**, so going back to a kind finds its numbers as they were left - an arm length typed for
    ///a cross is not an arm length for a Greek cross, though both call it an arm. **Except across one structure's
    ///layers** (2026-11-01): a spiral inductor's turns are its underpass's and its vias' turns too, and a cross's arm
    ///the window's, so they share one set - layers drawn from two sets of numbers would not meet.
    ///
    private readonly Dictionary<string, Dictionary<string, double>> markValues = new Dictionary<string, Dictionary<string, double>>();

    ///<summary>Why the mark asked for last could not be made, or empty.</summary>
    private string markProblem = "";

    private MarkMaker markMaker()
    {
        return Marks.Named(markKey) ?? Marks.All[0];
    }

    private double markValue(MarkSetting setting)
    {
        if (markValues.TryGetValue(markMaker().Family, out var typed) && typed.TryGetValue(setting.Name, out double value))
            return value;

        return setting.Start;
    }

    ///<summary>What the panel's numbers come to, where the kind says - see MarkMaker.NoteFor. Empty where it does not.</summary>
    private string markNote()
    {
        markValues.TryGetValue(markMaker().Family, out var typed);

        return markMaker().NoteFor(typed ?? new Dictionary<string, double>());
    }

    ///<summary>A setting's name as the panel shows it: the library's own word, capitalized.</summary>
    private static string labelOf(MarkSetting setting)
    {
        return char.ToUpperInvariant(setting.Name[0]) + setting.Name[1..];
    }

    private async Task changeMarkKind(ChangeEventArgs e)
    {
        if (e.Value is string key && Marks.Named(key) is not null)
            markKey = key;

        markProblem = "";

        //What is in hand is what the panel shows, so a different kind is a different mark in hand.
        if (stamp?.Kind == StampKind.Mark)
            await carryMark();

        await OnToolChanged.InvokeAsync();
    }

    private async Task changeMarkSetting(MarkSetting setting, ChangeEventArgs e)
    {
        double value = realNumber(e, markValue(setting));

        string family = markMaker().Family;

        if (!markValues.TryGetValue(family, out var typed))
        {
            typed = new Dictionary<string, double>();
            markValues[family] = typed;
        }

        typed[setting.Name] = value;
        markProblem = "";

        if (stamp?.Kind == StampKind.Mark)
            await carryMark();

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///Makes the mark the panel describes and picks it up.
    ///
    ///**A mark that cannot be made is said, not carried.** A frame whose line is wider than half the die is
    ///not a strange frame, it is a mistake - so the library says what is wrong and the panel shows it, and a
    ///mark already in hand that the new numbers cannot make is put back rather than left as it was, which
    ///would be carrying something the panel no longer describes.
    ///
    private async Task carryMark()
    {
        if (Gds is null || context is null)
            return;

        var maker = markMaker();

        markValues.TryGetValue(maker.Family, out var typed);

        var made = maker.Make(typed ?? new Dictionary<string, double>(), unitsFor);

        //
        //**A mark's curves are worked out, so its corners go on the deck's grid** - see deckGrid. Its straight
        //edges are on it already when its numbers are, and stay where they are. One the grid would spoil - a ring
        //only a few steps across - is said like any other mark that cannot be made.
        //
        int grid = deckGrid(drawOn);
        var outlines = made.Outlines.Select(outline => Grid.Snap(outline, grid)).ToList();
        string? refused = made.Problem;

        if (refused is null && grid > 1 && outlines.Any(notAShape))
            refused = $"That is too small for {deckGridSaid(drawOn)}: put on it, the outline would cross itself or come out flat. Make it larger, or turn snapping off.";

        //
        //Said in the panel, which is drawn in the bar the shell owns - so the bar is told, or the sentence
        //would wait for whatever redrew the bar next. Every other way out of here tells it too.
        //
        if (refused is string problem)
        {
            markProblem = problem;

            if (stamp?.Kind == StampKind.Mark)
                await OnCarryStopped();

            await OnToolChanged.InvokeAsync();

            return;
        }

        //Inside what a GDSII coordinate holds, with room to be placed anywhere - the same bound writing has.
        var box = Bounds.Of(outlines.SelectMany(outline => outline));

        if (Math.Max(box.Width, box.Height) > int.MaxValue / 4)
        {
            markProblem = "That is too big for this file: at its size it runs past the largest coordinate a GDSII file can hold. Make it smaller.";

            await OnToolChanged.InvokeAsync();

            return;
        }

        markProblem = "";

        //
        //Anything else in hand is let go of first - writing or a picture whose frame is up put down for good, a cell
        //put back, see emptyHand - but not this structure made again from new numbers, which is swapped for its new
        //drawing where it is and keeps its turn.
        //
        bool redrawing = stamp is not null;

        if (!redrawing)
            await emptyHand();

        //Held by its middle, which is where every mark is drawn round - see Marks.
        stamp = new Stamp(StampKind.Mark, maker.Name, outlines, 0, 0);
        carrying = "";
        drawRefusal = "";

        keyHandle ??= DotNetObjectReference.Create(this);

        if (redrawing)
            await js.InvokeVoidAsync("replaceCarried", stampDrawing(), 0, 0);
        else
            await js.InvokeVoidAsync("startCarrying", keyHandle, stampDrawing(), 0, 0);

        await OnToolChanged.InvokeAsync();
    }

    #endregion ***********************************************

    ///
    ///One row of the docked tree, at whichever of its levels it belongs to.
    ///
    ///The cell rows are the library popup's rows, drawn by cellRow below so the two panels cannot drift.
    ///What is here is the levels the popup does not have - a placement, a layer, and a shape on it - and the
    ///twisty, which in this panel is a control rather than a mark.
    ///
    private RenderFragment<Hierarchy.TreeRow> treeRow => row =>
    @*
        The indent is a variable as well as padding, because the guide lines are drawn to it - see
        .cellRowPair in the CSS, where a background repeats one line per level across exactly that width.
    *@
    @*
        The right button raises what can be done to the row - see openTreeMenu, and the note there on why
        the same three words mean three different things at the three levels.

        On the pair rather than on each control inside it, so the whole row answers: the twisty, the swatch
        and the gap after the name are all part of the row a person is pointing at, and a menu that came up
        on the name and not on the number beside it would read as unreliable rather than as precise.
    *@
    @<div class="cellRowPair treeRow@(row.Kind)" style="--indent: @(row.Depth * 14)px;" data-depth="@row.Depth" data-kind="@row.Kind.ToString().ToLowerInvariant()"
         @oncontextmenu="e => openTreeMenu(e, row)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        @*
            The twisty, as a button where there is something to fold and a blank where there is not.

            A chevron rather than a filled triangle, and drawn rather than typed: the arrows a font has are
            each a different weight from the next and none of them matches the app's own line work, which is
            what made a column of them look like punctuation rather than a control. This one turns a quarter
            when it opens, which is the same gesture every file tree makes.

            A fixed width either way, so the names line up down a level rather than stepping in and out by
            whether a row happens to have anything under it.
        *@
        @if (row.Folds)
        {
            <button class="cellRowTwisty cellRowFold @(row.Open ? "cellRowFoldOpen" : "")"
                    data-fold="@row.Key"
                    @onclick="() => toggleTreeRow(row)"
                    aria-expanded="@(row.Open ? "true" : "false")"
                    aria-label="@(row.Open ? "Collapse" : "Expand")"
                    title="@CellTreeText.Fold(row)">
                <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M4.5 2.5 L8 6 L4.5 9.5" fill="none" stroke="currentColor"
                          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        }
        else
        {
            <span class="cellRowTwisty" aria-hidden="true">@(row.Repeats ? "↳" : "")</span>
        }

        @*
            The row is a text box while it is the one being renamed, whatever kind of row it is: a cell, a
            layer, or nothing. One box for all of them, because a box over a row is a box over a row - what
            differs is where the typing goes, which the row that opened it decided. See RowRename.
        *@
        @if (renamingRow is RowRename renaming && renaming.RowKey == row.Key)
        {
            <input type="text"
                   class="cellRowNameBox"
                   value="@renamingText"
                   @oninput="changeRenamedRow"
                   @onkeydown="onRowRenameKey"
                   @onblur="keepRenamedRow"
                   @ref="rowRenameBox"
                   placeholder="@renaming.Was" />
        }
        else if (row.Kind == Hierarchy.TreeRowKind.Cell)
        {
            <button class="cellRow @(context is not null && context.Structure == row.Cell!.Name ? "cellRowOn" : "")"
                    @onclick="() => openCell(row.Cell!.Name)"
                    @onmouseenter="() => previewCell(row.Cell!.Name)"
                    @onfocus="() => previewCell(row.Cell!.Name)"
                    title="@CellTreeText.About(row.Cell!)">
                <span class="cellRowName">@row.Cell!.Name</span>
                <span class="cellRowCounts">@CellTreeText.Counts(row.Cell!)</span>
            </button>

            @*
                The row opens the cell; the square beside it picks the cell up.

                Two things rather than one, because the row already had a meaning and it is the only one
                there is: clicking a name is how a cell with nothing in it at all is reached, and every
                other way in starts from clicking a shape that an empty cell does not have.

                Only offered where it could be put down - inside a cell, and not for a cell that already
                contains this one, which would be a library with no bottom. See canPlace.
            *@
            @if (canPlace(row.Cell!.Name))
            {
                <button class="cellRowPlace" data-place="@row.Cell!.Name"
                        @onclick="() => carryCell(row.Cell!.Name)"
                        @onmouseenter="() => previewCell(row.Cell!.Name)"
                        aria-label="Place @row.Cell!.Name"
                        title="Pick it up, and click where it should go. Ctrl+R turns it, Ctrl+M mirrors it, Esc puts it back">
                    @*
                        A cell, and the crosshair it is being positioned by.

                        **It was an arrow coming down into a tray**, which is the shape of putting something
                        down and also, exactly, the shape of the app's own download button two panels away -
                        the same glyph twice in one screen for two unrelated things. This says the two parts
                        of what the square actually does: here is a cell, and here is the point you are
                        holding it by.
                    *@
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="1.3" y="5.4" width="8.6" height="8.6" rx="1.3"
                              fill="none" stroke="currentColor" stroke-width="1.5" />
                        <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                              d="M9.6 3.6h5.6M12.4 0.8v5.6" />
                    </svg>
                </button>
            }
        }
        else if (row.Kind == Hierarchy.TreeRowKind.Layer)
        {
            @*
                A layer of the cell above it, with the swatch it is drawn in.

                The same swatch the layer picker and the sidebar use, because it is the same layer - a
                number beside a color is how this app has said "layer" everywhere else, and a tree that
                spelled it differently would be a second vocabulary for one thing.
            *@
            <button class="cellRow cellRowLayer"
                    @onclick="() => toggleTreeRow(row)"
                    title="@CellTreeText.Layer(row, nameOfLayer(row.Layer))">
                @*
                    The pattern shows here too, for the reason the sidebar's does: two layers a shade apart
                    are told apart in the drawing by their hatch, and a flat swatch in the tree would be the
                    one place that stopped saying which is which.
                *@
                @if (fillOfLayer(row.Layer) == LayerFill.None)
                {
                    <span class="layerSwatch" style="background-color: @colorOf(row.Layer);"></span>
                }
                else
                {
                    <svg class="layerSwatch layerSwatchFilled" viewBox="0 0 16 16" aria-hidden="true">
                        @((MarkupString)SvgWriter.SwatchFor(fillOfLayer(row.Layer), colorOf(row.Layer), $"treeFill_{SvgWriter.ClassFor(row.Layer)}", 16, patternColorOfLayer(row.Layer), patternPixelsOfLayer(row.Layer)))
                    </svg>
                }
                <span class="cellRowName">@nameOfLayer(row.Layer)</span>
                <span class="cellRowCounts">@row.Count</span>
            </button>
        }
        else if (row.Kind == Hierarchy.TreeRowKind.Shape)
        {
            @*
                One shape of the file, which a press finds in the layout and chooses.

                Named by what it is and where it starts rather than by a number: an index into a cell means
                nothing to somebody reading a layout, where "boundary at 350, -1200" is a thing that can be
                looked for on screen.
            *@
            <button class="cellRow cellRowShape"
                    @onclick="() => chooseFromTree(row)"
                    title="Find this shape in the layout and choose it">
                <span class="cellRowName">@CellTreeText.Shape(row)</span>
            </button>
        }
        else if (row.Kind == Hierarchy.TreeRowKind.Placement)
        {
            @*
                One placement of the cell above it, said as the text view's list says it - where it is in the cell
                placing it, and how it is turned or arrayed. A press takes hold of it in the layout and puts the view
                on it; the twisty opens what it draws. See chooseInstanceFromTree.
            *@
            <button class="cellRow cellRowPlacement"
                    @onclick="() => chooseInstanceFromTree(row)"
                    @onmouseenter="() => previewCell(row.Structure)"
                    @onfocus="() => previewCell(row.Structure)"
                    title="Choose this placement of @row.Structure in @row.Inside, and go to it">
                <span class="cellRowName">@Hierarchy.DescribePlacement(row.Placement!)</span>
            </button>
        }
        else
        {
            @*What a cap left out, said rather than silently dropped. See Hierarchy.MostShapesListed and MostPlacementsListed.*@
            <span class="cellRow cellRowRest">@row.Count.ToString("N0", CultureInfo.InvariantCulture) more</span>
        }
    </div>;

    #region What a row offers on the right button *************

    ///
    ///The menu a tree row raises: rename, copy and delete, meaning whichever of those the row is about.
    ///
    ///**The same three words at all three levels, and three different things each time.** A cell is renamed
    ///in the library and copied into a second cell; a layer is renamed in the table the whole app shares and
    ///its shapes are copied onto the clipboard; a shape is a shape. Saying so per row rather than offering a
    ///lowest common denominator is the point of a menu that knows what it was raised on.
    ///
    ///Nothing that cannot be done is offered as something that can: a line the state refuses is drawn
    ///disabled with the reason on it, the way the panel's buttons are, rather than left out - a control that
    ///vanishes is one nobody can ask why about.
    ///
    private async Task openRowMenu(MouseEventArgs e, List<MenuLine?> lines)
    {
        if (lines.Count == 0)
            return;

        menuLines = lines;

        await placeMenu(e);
    }

    private async Task openTreeMenu(MouseEventArgs e, Hierarchy.TreeRow row)
    {
        if (row.Kind == Hierarchy.TreeRowKind.Cell && row.Cell is Hierarchy.CellSummary cell)
        {
            await openRowMenu(e, cellRowLines(cell.Name));

            return;
        }

        if (row.Kind == Hierarchy.TreeRowKind.Layer)
        {
            await openRowMenu(e, layerLines(row.Layer, row.Structure));

            return;
        }

        if (row.Kind == Hierarchy.TreeRowKind.Shape)
            await openRowMenu(e, shapeRowLines(row));
    }

    ///
    ///What a cell row offers.
    ///
    ///The same three the bar above the view offers for the cell being edited, aimed at the row instead - so
    ///a cell that is not the one open can be renamed without entering it first, which was the only way.
    ///
    private List<MenuLine?> cellRowLines(string name)
    {
        int placed = 0;

        if (Gds is not null)
            placed = Hierarchy.PlacementsOf(Gds, name);

        string renameWhy = $"Type a new name for {name}";
        string copyWhy = $"Make a second cell holding the same shapes as {name}";

        if (ReadOnly)
        {
            renameWhy = "This file is open for reading";
            copyWhy = renameWhy;
        }

        var lines = new List<MenuLine?>
        {
            Action(
                "Rename",
                () => startTreeRename(name),
                !ReadOnly,
                renameWhy,
                SvgWriter.ShapeIcon.Rename),

            Action(
                "Copy",
                () => copyTreeCell(name),
                !ReadOnly,
                copyWhy,
                SvgWriter.ShapeIcon.Copy),

            null,

            Action(
                "Delete",
                () => deleteTreeCell(name),
                !ReadOnly && placed == 0,
                deleteCellSays(name, placed),
                SvgWriter.ShapeIcon.Delete)
        };

        return lines;
    }

    private string deleteCellSays(string name, int placed)
    {
        if (ReadOnly)
            return "This file is open for reading";

        if (placed > 0)
        {
            string verb = "s name";

            if (placed == 1)
                verb = " names";

            return FormattableString.Invariant($"{placed} placement{verb} this cell. Flatten or delete those first");
        }

        return FormattableString.Invariant($"Take {name} out of the library, with everything in it");
    }

    ///
    ///What a layer row offers, in a named cell.
    ///
    ///**Renaming a layer is not an edit to the file.** A layer's name is the app's own label for a pair of
    ///numbers, shared by every file opened afterwards, so it goes back to the shell rather than onto the
    ///undo stack - see OnLayerRenamed. Copy and Delete are edits, and are the ordinary ones.
    ///
    ///`inCell` is which cell's shapes those two act on. A layer runs through the whole library and deleting
    ///"every shape on met1" would be an edit nobody could see the extent of; the cell the row sits under is
    ///the scope the row is already showing a count for.
    ///
    private List<MenuLine?> layerLines(LayerKey key, string inCell)
    {
        int found = shapesOnLayer(key, inCell).Count;
        string them = "shapes";

        if (found == 1)
            them = "shape";

        bool editable = !ReadOnly && found > 0 && context is not null && context.Structure == inCell;

        string why = "";

        if (ReadOnly)
            why = "This file is open for reading";
        else if (found == 0)
            why = FormattableString.Invariant($"Nothing is on {nameOfLayer(key)} in {inCell}");
        else if (context is null || context.Structure != inCell)
            why = FormattableString.Invariant($"Open {inCell} first - shapes are only editable in the cell being edited");

        string copyLabel = FormattableString.Invariant($"Copy {found} {them}");
        string deleteLabel = FormattableString.Invariant($"Delete {found} {them}");

        if (found == 1)
        {
            copyLabel = "Copy the shape";
            deleteLabel = "Delete the shape";
        }

        string copyWhy = FormattableString.Invariant($"Put every {nameOfLayer(key)} shape in {inCell} on the clipboard");
        string deleteWhy = FormattableString.Invariant($"Take every {nameOfLayer(key)} shape out of {inCell}");

        if (why.Length > 0)
        {
            copyWhy = why;
            deleteWhy = why;
        }

        return new List<MenuLine?>
        {
            Action(
                "Rename",
                () => startLayerRename(key),
                true,
                FormattableString.Invariant($"Type a new name for layer {key}"),
                SvgWriter.ShapeIcon.Rename),

            Action(
                copyLabel,
                () => copyOnLayer(key, inCell),
                editable,
                copyWhy,
                SvgWriter.ShapeIcon.Copy),

            null,

            Action(
                deleteLabel,
                () => deleteOnLayer(key, inCell),
                editable,
                deleteWhy,
                SvgWriter.ShapeIcon.Delete)
        };
    }

    ///
    ///What a shape row offers.
    ///
    ///**Rename is a label's line and nothing else's.** A boundary has no name to change - it has a layer and
    ///a set of corners - so the line is there and refuses, rather than the menu being a different length for
    ///a row that looks the same. Retyping a label is the one thing here that is a rename in any sense.
    ///
    private List<MenuLine?> shapeRowLines(Hierarchy.TreeRow row)
    {
        bool label = row.Shape?.Element is GDS.TextModel;

        string retypeWhy = "Only a label has words to change";

        if (label)
            retypeWhy = "Type new words for this label";

        return new List<MenuLine?>
        {
            Action(
                "Rename",
                () => retypeFromTree(row),
                label && !ReadOnly,
                retypeWhy,
                SvgWriter.ShapeIcon.Rename),

            Action(
                "Copy",
                () => copyFromTree(row),
                !ReadOnly,
                "Put this shape on the clipboard",
                SvgWriter.ShapeIcon.Copy),

            null,

            Action(
                "Delete",
                () => deleteFromTree(row),
                !ReadOnly,
                "Take this shape out of the cell",
                SvgWriter.ShapeIcon.Delete)
        };
    }

    ///
    ///Renaming in the row itself rather than in a dialog.
    ///
    ///The same reasoning the layer sidebar's name box is written under: a name is only worth choosing next
    ///to the thing it names, and a box in the middle of the screen puts the list of every other name behind
    ///it. This one serves all three levels, because a text box over a row is a text box over a row whatever
    ///the row holds - what differs is where the typing goes, which is the delegate.
    ///
    private sealed record RowRename(string RowKey, string Was, Func<string, Task> Keep);

    private RowRename? renamingRow = null;

    private string renamingText = "";

    private bool focusRowRename = false;

    private ElementReference rowRenameBox;

    private void startRenamingRow(string rowKey, string was, Func<string, Task> keep)
    {
        renamingRow = new RowRename(rowKey, was, keep);
        renamingText = was;
        focusRowRename = true;
    }

    private void changeRenamedRow(ChangeEventArgs e)
    {
        renamingText = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps it, Escape abandons it, and clicking away keeps it - as the sidebar's box does.</summary>
    private async Task onRowRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            renamingRow = null;

            return;
        }

        if (e.Key == "Enter")
            await keepRenamedRow();
    }

    private async Task keepRenamedRow()
    {
        if (renamingRow is not RowRename renaming)
            return;

        string typed = renamingText.Trim();

        renamingRow = null;

        //Unchanged is not an edit. Without this, opening the box and pressing Enter would put a step on the
        //undo stack that renames a cell to the name it already has.
        if (typed == renaming.Was)
            return;

        await renaming.Keep(typed);
    }

    private Task startTreeRename(string name)
    {
        startRenamingRow(cellRowKeyOf(name), name, typed => renameTreeCell(name, typed));

        return Task.CompletedTask;
    }

    ///
    ///The row a cell is drawn on, so the box opens on the row that was pressed.
    ///
    ///A cell placed by two parents is two rows and the tree keys them by path - see Hierarchy.TreeRow.Key -
    ///but a rename is about the cell rather than about one of its rows, so the first row showing that cell
    ///is as good an answer as any and is the one somebody will be looking at.
    ///
    private string cellRowKeyOf(string name)
    {
        foreach (var row in treeRows())
        {
            if (row.Kind == Hierarchy.TreeRowKind.Cell && row.Cell is Hierarchy.CellSummary cell && cell.Name == name)
                return row.Key;
        }

        return name;
    }

    private async Task renameTreeCell(string was, string name)
    {
        if (Gds is null || ReadOnly)
            return;

        name = AddElement.AsAscii(name);

        if (name.Length == 0 || Hierarchy.Named(Gds, name) is not null)
            return;

        History.Do(new RenameStructure(Gds, was, name));

        await afterEdit();

        //Only if the rename was of the cell being edited. Renaming some other cell from the tree must not
        //move where you are, which is what enterRenamed would do.
        if (context is not null && context.Structure == was)
            await enterRenamed(was, name);
    }

    ///
    ///Duplicates a cell of the tree under a name nothing is using.
    ///
    ///**Named rather than asked for**, unlike the bar's Copy, which has a box beside it holding a name.
    ///There is no box on a menu line, and stopping to invent a name is not what somebody pressing Copy on a
    ///row is doing - the copy can be renamed afterwards from the same menu, on the row it lands on.
    ///
    private async Task copyTreeCell(string name)
    {
        if (Gds is null || ReadOnly)
            return;

        if (structureNamed(name) is not GDS.StructureModel copying)
            return;

        string called = freeCellName(name);

        var records = new List<GDS.Record>();

        foreach (var element in copying.Elements)
        {
            if (recordsOf(element) is List<GDS.Record> span)
                records.AddRange(span);
        }

        History.Do(new CompoundEdit("Copy cell", new List<LayoutEdit>
        {
            new AddStructure(Gds, called, records)
        }));

        await afterEdit();
    }

    ///<summary>"MOSFET" becomes "MOSFET_1", then _2, and so on past whatever is already there.</summary>
    private string freeCellName(string name)
    {
        for (int at = 1; at < 1000; at++)
        {
            string tried = AddElement.AsAscii(FormattableString.Invariant($"{name}_{at}"));

            if (tried.Length > 0 && Hierarchy.Named(Gds!, tried) is null)
                return tried;
        }

        return AddElement.AsAscii(FormattableString.Invariant($"{name}_COPY"));
    }

    private async Task deleteTreeCell(string name)
    {
        if (Gds is null || ReadOnly || Hierarchy.PlacementsOf(Gds, name) > 0)
            return;

        History.Do(new RemoveStructure(Gds, name));

        //There is nowhere to be any more, but only if it was this cell you were in.
        if (context is not null && context.Structure == name)
            context = null;

        await afterEdit();
    }

    ///
    ///The shapes one layer holds in one cell, as places in the drawn layout.
    ///
    ///In the instance being looked through, not in every placement of the cell: those are the shapes a click
    ///would land on, and the ones an edit acts through. See drawnFrom, which picks by the same rule.
    ///
    private List<int> shapesOnLayer(LayerKey key, string inCell)
    {
        var found = new List<int>();

        if (layout is null)
            return found;

        for (int i = 0; i < layout.Elements.Count; i++)
        {
            var element = layout.Elements[i];

            if (element.Source is not ElementSource source || source.Structure != inCell)
                continue;

            if (!element.Layer.Key.Equals(key))
                continue;

            if (context is not null && !context.IsLookingThrough(element))
                continue;

            found.Add(i);
        }

        return found;
    }

    ///
    ///Copying and deleting a layer's shapes, by choosing them and running what the panel already runs.
    ///
    ///**Through the selection rather than around it.** Copy has to gather the same records Copy gathers and
    ///Delete has to make the same one-step edit Delete makes, so a second path to either would be a second
    ///thing to keep in step - and the selection moving to what is about to be acted on is not a side effect
    ///worth avoiding, it is what somebody who asked for this can see happening.
    ///
    private async Task copyOnLayer(LayerKey key, string inCell)
    {
        await choose(shapesOnLayer(key, inCell));

        await copyChosen();
    }

    private async Task deleteOnLayer(LayerKey key, string inCell)
    {
        var found = shapesOnLayer(key, inCell);

        if (found.Count == 0)
            return;

        await choose(found);

        string action = FormattableString.Invariant($"Delete {found.Count}");

        if (found.Count == 1)
            action = "Delete";

        await deleteChosen(action);
    }

    ///<summary>Renaming a layer from the tree, which the shell owns - see OnLayerRenamed.</summary>
    private Task startLayerRename(LayerKey key)
    {
        startRenamingRow(layerRowKeyOf(key), nameOfLayer(key), typed => OnLayerRenamed.InvokeAsync(new LayerRename(key, typed)));

        return Task.CompletedTask;
    }

    private string layerRowKeyOf(LayerKey key)
    {
        foreach (var row in treeRows())
        {
            if (row.Kind == Hierarchy.TreeRowKind.Layer && row.Layer.Equals(key))
                return row.Key;
        }

        return key.ToString();
    }

    ///
    ///Asked to name a layer, which is not an edit to the file.
    ///
    ///A layer's name is the app's own label for a pair of numbers, kept for every file opened afterwards, so
    ///it belongs to the shell's table rather than to this view's undo stack. The sidebar already writes it;
    ///this only says which one and what to.
    ///
    [Parameter]
    public EventCallback<LayerRename> OnLayerRenamed { get; set; }

    ///
    ///The menu for a layer row of the sidebar, which the shell owns the markup of and this owns the answers.
    ///
    ///**StateHasChanged, unlike every other way the menu opens.** A component re-renders itself after its
    ///own event handlers; this one is called straight from the parent's, so nothing has told it the menu is
    ///now open and it would sit there unrendered until something else happened to redraw the view.
    ///
    public async Task OpenLayerMenu(MouseEventArgs e, LayerKey key)
    {
        //The cell being edited, or the top of the tree when nothing is: the same scope the tree's own layer
        //rows use, so a layer means the same thing whichever list it is right-clicked in.
        string inCell = context?.Structure ?? topCellName();

        await openRowMenu(e, layerLines(key, inCell));

        StateHasChanged();
    }

    ///<summary>What the tree calls the outermost cell, for a menu raised with no cell open.</summary>
    private string topCellName()
    {
        foreach (var row in treeRows())
        {
            if (row.Kind == Hierarchy.TreeRowKind.Cell && row.Cell is Hierarchy.CellSummary cell)
                return cell.Name;
        }

        return "";
    }

    ///
    ///The three a shape row offers, each by choosing the shape and running what already does it.
    ///
    ///Choosing it also descends into its cell, which is what makes the edit legal - see chooseFromTree. A
    ///row of a cell nobody is inside would otherwise offer a Delete that quietly did nothing.
    ///
    private async Task copyFromTree(Hierarchy.TreeRow row)
    {
        await chooseFromTree(row);

        await copyChosen();
    }

    private async Task deleteFromTree(Hierarchy.TreeRow row)
    {
        await chooseFromTree(row);

        await deleteChosen();
    }

    ///
    ///Retyping a label from its row.
    ///
    ///Opened after the render rather than here, because the box is placed over the label in the drawing and
    ///choosing the row has just replaced that drawing - `labelBox` would measure markup that is about to be
    ///thrown away. The same trick, and for the same reason, as remarkChosen.
    ///
    private async Task retypeFromTree(Hierarchy.TreeRow row)
    {
        await chooseFromTree(row);

        retypeAfterRender = row.Shape;
    }

    ///<summary>The label to open the box over once the drawing holding it is in the page.</summary>
    private GDS.ElementModel? retypeAfterRender = null;

    private async Task openRetypeAfterRender()
    {
        if (retypeAfterRender is not GDS.ElementModel wanted)
            return;

        retypeAfterRender = null;

        if (layout is null)
            return;

        //
        //The one chooseFromTree chose: a label in a cell placed several times is drawn at each placement, and the
        //box goes over the one the row was under. The first drawn only when that one is not chosen.
        //
        int? over = null;

        foreach (int chosen in chosenIndexes)
        {
            if (chosen < layout.Elements.Count && layout.Elements[chosen].Source is ElementSource held && ReferenceEquals(held.Model, wanted))
            {
                over = chosen;

                break;
            }
        }

        for (int at = 0; over is null && at < layout.Elements.Count; at++)
        {
            if (layout.Elements[at].Source is ElementSource source && ReferenceEquals(source.Model, wanted))
                over = at;
        }

        if (over is not int found || layout.Elements[found].Text is not string says)
            return;

        //Already in the file, so Escape puts the old words back rather than taking a placement away.
        justPlaced = null;

        await openRetype(found, says);
    }

    #endregion ***********************************************

    ///<summary>Cells at the top whose twisty is shut. One not in here is open, which is where the tree starts.</summary>
    private readonly HashSet<string> foldedCells = new HashSet<string>();

    ///
    ///Everything else whose twisty is open: a layer showing its shapes, a placed cell its placements, a placement
    ///what it draws. One not in here is shut, which is where it starts - see Hierarchy.TreeRow.StartsOpen.
    ///
    private readonly HashSet<string> openedRows = new HashSet<string>();

    ///
    ///The docked tree's rows: cells, their layers, and the shapes on an opened one.
    ///
    ///**Held rather than rebuilt.** The panel re-renders for anything that touches the view - a pointer
    ///crossing a row, a selection, a tool - and building this walks every structure in the library and every
    ///element of each. On the bundled cells that is nothing; on a real library it is the same order of work
    ///as flattening the file, and doing it per render would put that on every mouse move.
    ///
    ///Thrown away when the file changes under it, which an edit does in place - so a stamp rather than the
    ///object's identity. See afterEdit, and treeStillSays for the edits that change no row.
    ///
    private List<Hierarchy.TreeRow>? treeCache = null;
    private GDS? treeCacheFor = null;
    private int treeCacheStamp = -1;
    private int treeStamp = 0;

    ///<summary>How many times the rows have been built, so a tree built again is told from the one drawn.</summary>
    private int treeBuilds = 0;

    private List<Hierarchy.TreeRow> treeRows()
    {
        if (Gds is null)
            return new List<Hierarchy.TreeRow>();

        if (treeCache is not null && ReferenceEquals(treeCacheFor, Gds) && treeCacheStamp == treeStamp)
            return treeCache;

        treeCache = Hierarchy.Tree(Gds, foldedCells, openedRows);
        treeCacheFor = Gds;
        treeCacheStamp = treeStamp;
        treeBuilds++;

        return treeCache;
    }

    ///
    ///Everything the tree's rows are drawn from, as one string, so they are drawn again only when it changes -
    ///see KeptUntilChanged.
    ///
    ///**The rows were a quarter of a second of every render of this view.** The RGB mixer's tree is 1,246 rows
    ///and ten thousand nodes, nine tenths of the page, and a render built every one of them again: each cell row
    ///asked whether its cell could be placed, which walks the hierarchy, each layer row looked its layer up five
    ///times in a list sorted afresh for each, and every handler was a new one for the browser to be handed. A
    ///render comes with a settle, a selection, a tool, a pointer over a row - so on a published build a pan of the
    ///mixer cost 0.55 s in two freezes a second after letting go, with or without the picture being drawn again.
    ///
    ///What a row shows: the rows themselves, built again with the file or a fold; the cell being edited, which is
    ///lit, and which decides what can be placed; the row being renamed and what has been typed into it; and each
    ///layer's name and look, which a locked layer drops out of.
    ///
    private string treeLooks()
    {
        var said = new StringBuilder();

        //First, so a tree built again for a different file or a fold is counted before it is said.
        treeRows();

        said.Append(treeBuilds.ToString(CultureInfo.InvariantCulture));
        said.Append('|');
        said.Append(context?.Structure ?? "");

        if (renamingRow is RowRename renaming)
        {
            said.Append('|');
            said.Append(renaming.RowKey);
            said.Append('=');
            said.Append(renamingText);
        }

        foreach (var layer in drawableLayers())
        {
            said.Append('|');
            said.Append(layer.Key.ToString());
            said.Append(',');
            said.Append(layer.DisplayName);
            said.Append(',');
            said.Append(layer.Color);
            said.Append(',');
            said.Append(layer.Fill.ToString());
            said.Append(',');
            said.Append(layer.PatternColor);
            said.Append(',');
            said.Append(layer.PatternPixels?.ToString(CultureInfo.InvariantCulture));
        }

        return said.ToString();
    }

    ///<summary>The tree has to be built again: the file changed, or a twisty was pressed.</summary>
    private void treeChanged()
    {
        treeStamp++;
    }

    ///
    ///Opens or shuts what is under a row.
    ///
    ///Two sets rather than one, because the rows start differently: a cell at the top is open unless it has
    ///been shut, and everything under it is shut unless it has been opened. Which is not a quirk - the top is
    ///the file everybody came for, and under it are the shapes, which can be a hundred thousand rows, and the
    ///placements, which can be a filler cell's four hundred under every cell placing it.
    ///
    private async Task toggleTreeRow(Hierarchy.TreeRow row)
    {
        if (!row.Folds)
            return;

        if (row.StartsOpen)
        {
            if (!foldedCells.Remove(row.Key))
                foldedCells.Add(row.Key);
        }
        else
        {
            if (!openedRows.Remove(row.Key))
                openedRows.Add(row.Key);
        }

        treeChanged();

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>What a layer is called in the tree, which is what it is called everywhere else in the app.</summary>
    private string nameOfLayer(LayerKey key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is Layer named)
            return named.DisplayName;

        return key.ToString();
    }

    ///<summary>A layer's color, for the swatch. Nothing for a layer the file draws but the table has not.</summary>
    private string colorOf(LayerKey key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is Layer found)
            return found.Color;

        return "transparent";
    }

    ///<summary>What is drawn over that layer's color, so the tree's swatch says what the drawing does.</summary>
    private LayerFill fillOfLayer(LayerKey key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is Layer found)
            return found.Fill;

        return LayerFill.None;
    }

    ///<summary>The pattern's own color, or null where it follows the layer's - the same as the sidebar's.</summary>
    private string? patternColorOfLayer(LayerKey key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is Layer found)
            return found.PatternColor;

        return null;
    }

    ///<summary>How coarse the pattern is, so a layer set coarser reads coarser in the tree too.</summary>
    private int patternPixelsOfLayer(LayerKey key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is Layer found)
            return found.PatternPixels ?? Layer.DefaultPatternPixels;

        return Layer.DefaultPatternPixels;
    }

    ///
    ///Finds the shape a row stands for in the layout, and chooses it.
    ///
    ///By the element the row carries rather than by a count: the tree holds the file's own ElementModel, and
    ///the flattener hangs one on every shape it draws, so the two meet at the object itself. A count would
    ///have to agree with the flattener about ordering, and the two would drift the first time either changed.
    ///
    ///**And by the placements above the row.** A cell placed many times draws the same element many times, and a
    ///shape row under a placement of it stands for the one drawn there - see Hierarchy.DrawnFor - so that is the
    ///one chosen, and the cell is entered through that instance.
    ///
    private async Task chooseFromTree(Hierarchy.TreeRow row)
    {
        if (layout is null || row.Shape is null)
            return;

        if (Hierarchy.DrawnFor(layout, row) is [int drawn])
            await enterCellOf(drawn, new List<int> { drawn });
    }

    ///
    ///Takes hold of the placement a row stands for, and puts the view on it.
    ///
    ///**Taken hold of from the cell placing it**, the way a first click on an instance takes hold of it there -
    ///see descendsOnClick - so moving, turning, deleting or flattening it is the next press. Found by the shapes
    ///it draws, through it and every placement above it, since a selection is made of drawn shapes.
    ///
    ///**And framed**, as a fault from the rule check is: the row says where the placement is in the file, and
    ///the drawing is where somebody wants to see it - a cell placed four hundred times is four hundred places to
    ///look, and the one asked about may be any of them.
    ///
    private async Task chooseInstanceFromTree(Hierarchy.TreeRow row)
    {
        if (layout is null || row.Placement is null)
            return;

        var drawn = Hierarchy.DrawnFor(layout, row);

        if (drawn.Count == 0 || layout.Elements[drawn[0]].Source is not ElementSource through)
            return;

        var covers = Bounds.Empty;

        foreach (int at in drawn)
            covers = covers.Union(layout.Elements[at].Box);

        chosenIndexes = new List<int> { drawn[0] };

        await useContext(CellContext.At(through).To(row.Via.Count), keepChosen: true);

        await FrameOn(covers);
    }

    ///
    ///Opens a cell by name.
    ///
    ///**Through a shape in it when there is one, and directly when there is not.** Going through a shape
    ///gives the whole chain it was reached by, so the breadcrumb reads the way it does after a click and
    ///going back up lands where it should. A cell with nothing in it has no such shape - and is exactly the
    ///cell somebody opening it from a list wants to draw the first thing into.
    ///
    private async Task openCell(string name)
    {
        await useContext(contextOf(name));
    }

    ///
    ///The context for a cell, through a shape in it where the layout has one.
    ///
    ///Through a shape gives the whole chain the cell was reached by, so the breadcrumb reads the way it
    ///does after a click and going back up lands where it should. `CellContext.Of` is the other way in: one
    ///level and no transform, which is what a cell looked at directly is - and the only honest answer for a
    ///cell placed several times, since there is no single place it sits.
    ///
    ///Split out from openCell so opening a file can take the context without the rest of what entering a
    ///cell does - see Render, where the top cell is set before the first markup is built rather than
    ///through a second render afterwards.
    ///
    private CellContext contextOf(string name)
    {
        if (layout is not null)
        {
            foreach (var element in layout.Elements)
            {
                if (element.Source is ElementSource source && source.Structure == name)
                    return CellContext.At(source);
            }
        }

        return CellContext.Of(name);
    }

    ///<summary>
    ///The longest a cell may be called. The format's own limit on a structure name, and files do exist that
    ///break it - this caps what can be typed rather than refusing what was read.
    ///</summary>
    public const int LongestCellName = 32;

    ///<summary>Whether the cell's own actions are showing. Not saved: it is a panel being open.</summary>
    private bool cellActionsOpen = false;

    ///
    ///Whether the cell tree is docked open down the side of the view.
    ///
    ///**The shell's, though this draws it.** The button that opens it stands beside the one for the layer
    ///list, and that list is the shell's - it is there for the 3D view as well, where this component does
    ///not exist. A pair of switches split across two owners would be a pair that could only be found on one
    ///screen. So the flag is the shell's, the panel is this view's, and the two meet at a parameter - the
    ///same arrangement ShowLayers already has.
    ///
    ///
    ///The live link's chip, drawn in the canvas's bottom left just above where the pointer is, rather than fixed to the
    ///window's corner over the side panel (2026-11-03, asked for). Handed in by the Viewer, which owns the link.
    ///
    [Parameter]
    public RenderFragment? Corner { get; set; }

    [Parameter]
    public bool CellTreeOpen { get; set; }

    ///<summary>The cross on the panel, which is the shell's switch reached from where the panel is.</summary>
    [Parameter]
    public EventCallback OnCellTreeClosed { get; set; }

    ///<summary>Whether the frame rate is shown in the drawing's corner. The shell's switch; see frameMeter.js.</summary>
    [Parameter]
    public bool DebugInfo { get; set; }

    private string renameTo = "";

    private async Task toggleCellActions()
    {
        cellActionsOpen = !cellActionsOpen;

        //Filled with what it is called now, so renaming is a change to a name rather than typing one out.
        if (cellActionsOpen && context is not null)
            renameTo = context.Structure;

        await OnToolChanged.InvokeAsync();

        //Kept, unlike every other panel here - see SavedSession.CellActions for which ones can be and why.
        await OnSettingsChanged.InvokeAsync();
    }

    private async Task changeRenameTo(ChangeEventArgs e)
    {
        renameTo = e.Value?.ToString() ?? "";

        await OnToolChanged.InvokeAsync();
    }

    private bool canRename()
    {
        if (Gds is null || context is null)
            return false;

        string name = AddElement.AsAscii(renameTo);

        return name.Length > 0 && name != context.Structure && Hierarchy.Named(Gds, name) is null;
    }

    private string renameDescription()
    {
        if (Gds is null || context is null)
            return "";

        string name = AddElement.AsAscii(renameTo);

        if (name.Length == 0)
            return "A cell has to be called something";

        if (name == context.Structure)
            return "That is what it is called already";

        if (Hierarchy.Named(Gds, name) is not null)
            return FormattableString.Invariant($"This library already has a cell called {name}");

        return FormattableString.Invariant($"Call it {name}, and every placement of it with it");
    }

    ///
    ///Renames the cell being edited.
    ///
    ///The context is rebuilt on the new name, because everything about where you are is held by name - the
    ///breadcrumb, what counts as editable, which shapes are drawn faded. Left alone, the very next redraw
    ///would be looking for a cell that no longer answers to that.
    ///
    private async Task renameCell()
    {
        if (Gds is null || context is null || !canRename())
            return;

        string was = context.Structure;
        string name = AddElement.AsAscii(renameTo);

        History.Do(new RenameStructure(Gds, was, name));

        cellActionsOpen = false;

        await afterEdit();

        //Back into the same cell under its new name, so the rename does not also throw you out of it.
        await enterRenamed(was, name);
    }

    private string copyCellDescription()
    {
        if (Gds is null || context is null)
            return "";

        string name = AddElement.AsAscii(renameTo);

        if (name.Length == 0)
            return "A cell has to be called something";

        if (name == context.Structure)
            return "A copy needs a name of its own";

        if (Hierarchy.Named(Gds, name) is not null)
            return FormattableString.Invariant($"This library already has a cell called {name}");

        return FormattableString.Invariant($"Make a second cell called {name} holding the same shapes, and open it");
    }

    ///
    ///Duplicates the cell being edited under a new name.
    ///
    ///**Its records, taken from the library.** A path comes across as a path with its width and its ends, a
    ///label with what it says, a placement as a placement of the same cell - which is what makes this a copy
    ///rather than a tracing of the outlines the cell happens to draw.
    ///
    ///Nothing places the copy, so this view draws it as a top of its own until an instance is put down. That
    ///is the honest thing for it to be: a cell nothing references is exactly what has just been made, and
    ///hiding it would leave somebody looking for the copy they asked for.
    ///
    private async Task copyCell()
    {
        if (Gds is null || context is null || !canRename())
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel copying)
            return;

        string name = AddElement.AsAscii(renameTo);

        var records = new List<GDS.Record>();

        foreach (var element in copying.Elements)
        {
            if (recordsOf(element) is List<GDS.Record> span)
                records.AddRange(span);
        }

        //Wrapped so the undo button says what happened rather than what it was made of. AddStructure calls
        //itself "Make cell", which is what grouping a selection does and is not what this was.
        History.Do(new CompoundEdit("Copy cell", new List<LayoutEdit>
        {
            new AddStructure(Gds, name, records)
        }));

        cellActionsOpen = false;

        await afterEdit();

        //Into the copy, which is the cell somebody who just made one wants to be looking at.
        await openCell(name);
    }

    ///<summary>Finds the cell again after a rename, by looking for a shape that is now in it.</summary>
    private async Task enterRenamed(string was, string name)
    {
        if (layout is null)
            return;

        foreach (var element in layout.Elements)
        {
            if (element.Source is ElementSource source && source.Structure == name)
            {
                await useContext(CellContext.At(source));

                return;
            }
        }
    }

    private bool canDeleteCell()
    {
        if (Gds is null || context is null)
            return false;

        return Hierarchy.PlacementsOf(Gds, context.Structure) == 0;
    }

    private string deleteCellDescription()
    {
        if (Gds is null || context is null)
            return "";

        int placed = Hierarchy.PlacementsOf(Gds, context.Structure);

        if (placed > 0)
        {
            string verb = "s name";

            if (placed == 1)
                verb = " names";

            return FormattableString.Invariant($"{placed} placement{verb} this cell. Flatten or delete those first");
        }

        return "Take this cell out of the library, with everything in it";
    }

    ///
    ///Takes the cell being edited out of the library.
    ///
    ///**Refused while anything still places it.** Deleting a cell something references leaves every one of
    ///those instances naming a cell that is not there - a file that parses, opens, and draws nothing where
    ///they were. The count is on the button so the answer to "why not" is there before it is pressed.
    ///
    private async Task deleteCell()
    {
        if (Gds is null || context is null || !canDeleteCell())
            return;

        History.Do(new RemoveStructure(Gds, context.Structure));

        cellActionsOpen = false;

        //There is nowhere to be any more, so the context goes with the cell.
        context = null;

        await afterEdit();
    }

    ///<summary>What a new cell is called before anybody types anything else.</summary>
    private const string CellStem = "CELL";

    private string cellName = CellStem;

    private async Task changeCellName(ChangeEventArgs e)
    {
        cellName = e.Value?.ToString() ?? "";

        await OnToolChanged.InvokeAsync();
    }

    private bool canMakeCell()
    {
        if (Gds is null || DistinctEditable == 0)
            return false;

        string name = AddElement.AsAscii(cellName);

        return name.Length > 0 && Hierarchy.Named(Gds, name) is null;
    }

    private string makeCellDescription()
    {
        if (Gds is null)
            return "";

        string name = AddElement.AsAscii(cellName);

        if (name.Length == 0)
            return "A cell has to be called something";

        if (Hierarchy.Named(Gds, name) is not null)
            return FormattableString.Invariant($"This library already has a cell called {name}");

        return FormattableString.Invariant($"Take them into a cell called {name} and place one here");
    }

    ///<summary>
    ///Sets the name a new cell would take to one nothing is using, when the box still holds the last one
    ///that was used - so making two cells in a row does not need the name typed again.
    ///</summary>
    private void freshenCellName()
    {
        if (Gds is null)
            return;

        if (cellName.Length == 0 || Hierarchy.Named(Gds, AddElement.AsAscii(cellName)) is not null)
            cellName = Hierarchy.UnusedName(Gds, CellStem);
    }

    ///<summary>
    ///The layer the chosen shapes are on, or nothing at all when they are not all on one - which is what the
    ///picker shows as a dash rather than naming whichever happened to be first.
    ///</summary>
    private string chosenLayerName()
    {
        var keys = Editable.Select(element => element.Layer.Key).Distinct().Take(2).ToList();

        if (keys.Count != 1)
            return "";

        return keys[0].ToString();
    }

    ///<summary>Whether the layer list is open. Not saved: it is a list being open, not a setting.</summary>
    private bool chosenLayerOpen = false;

    ///<summary>What the button reads: the layer's name, or that they are not all on one.</summary>
    private string chosenLayerLabel()
    {
        string key = chosenLayerName();

        if (key.Length == 0)
            return "on more than one layer";

        if (drawableLayers().FirstOrDefault(layer => layer.Key.ToString() == key) is Layer named)
            return named.DisplayName;

        return key;
    }

    ///<summary>A layer's color by its key as text, for the swatch on the button. White for no one layer.</summary>
    private string colorOfKey(string key)
    {
        if (drawableLayers().FirstOrDefault(layer => layer.Key.ToString() == key) is Layer found)
            return found.Color;

        return "transparent";
    }

    private void toggleChosenLayer()
    {
        chosenLayerOpen = !chosenLayerOpen;
    }

    ///<summary>Takes a layer from the list, which closes it and moves what is chosen onto that layer.</summary>
    private async Task chooseLayer(LayerKey key)
    {
        chosenLayerOpen = false;

        await moveChosenToLayer(key);
    }

    ///
    ///Moves the chosen shapes onto another layer.
    ///
    ///**Two numbers written into records they already have.** Not a delete and a redraw: the shapes keep
    ///their geometry, their properties, their place in the file and their identity, and only what they are
    ///*for* changes. A label moves by its TEXTTYPE and a boundary by its DATATYPE, which the edit reads off
    ///the element rather than guessing from the record's name.
    ///
    ///The layers offered are the ones the file already has, for the same reason the Draw tool offers those:
    ///moving something onto a layer nothing else uses is a real thing to want and a rarer one than moving it
    ///onto a layer that is already there.
    ///
    private async Task moveChosenToLayer(LayerKey key)
    {
        if (Gds is null || context is null)
            return;

        if (drawableLayers().FirstOrDefault(layer => layer.Key.Equals(key)) is not Layer onto)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var edits = new List<LayoutEdit>();
        var already = new HashSet<GDS.ElementModel>();

        foreach (var element in Editable)
        {
            if (element.Source is not ElementSource source || !already.Add(source.Model))
                continue;

            //Already there. Skipped rather than written as a change to what it is, which would undo to the
            //same picture and take a press of the stack to do it.
            if (element.Layer.Key.Equals(onto.Key))
                continue;

            edits.Add(new RelayerElement(Gds, structure, source.Model, onto.Key));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit("Change layer", edits));

        //Kept: nothing was added or removed, so every index still names the shape it named.
        await afterEdit(keepChosen: true);
    }

    ///
    ///Combines the chosen shapes into what the operation makes of them.
    ///
    ///**In the cell's own coordinates, not the layout's.** A set operation does not care how the cell it is
    ///in was placed - the union of two shapes, turned, is the turn of their union - so there is nothing to
    ///convert and, better, nothing to round. Every other edit here has to go out through the placement and
    ///back; this one is the exception, and it is the exception because the arithmetic commutes.
    ///
    ///**Labels take no part.** A label is an anchor and a string rather than an area, so it is left out
    ///rather than being handed to a clipper as a shape with no width.
    ///
    ///The result lands on the layer of the first shape chosen, which is also the one subtraction takes as
    ///its side - one rule for "which of these is the main one" rather than two.
    ///
    private async Task combineChosen(BooleanOperation operation, string named)
    {
        var taking = combinable();

        if (taking.Count < 2)
            return;

        drawRefusal = "";

        if (ontoDeckGrid(Booleans.CombineAll(outlinesOf(taking), operation), layerOf(taking[0]), $"{named} was not done") is not List<List<Element.Point>> made)
            return;

        await replaceWith(taking, made, named);
    }

    ///<summary>
    ///Moves every edge of the chosen shapes outwards by the distance in the box, or inwards for a negative
    ///one. Shrinking something away to nothing is an answer rather than a failure - it is how a minimum
    ///width is checked.
    ///</summary>
    private async Task growChosen()
    {
        var taking = combinable();

        if (taking.Count == 0 || growUnits() == 0)
            return;

        drawRefusal = "";

        if (ontoDeckGrid(Booleans.Grow(outlinesOf(taking), growUnits()), layerOf(taking[0]), $"{NameOfGrow} was not done") is not List<List<Element.Point>> made)
            return;

        await replaceWith(taking, made, NameOfGrow);
    }

    private string NameOfGrow
    {
        get
        {
            if (growMicrons < 0)
                return "Shrink";

            return "Grow";
        }
    }

    ///
    ///Takes the shapes that went in out, and puts what came out in - as one step.
    ///
    ///An empty result is allowed through. Intersecting two shapes that do not touch, or shrinking one past
    ///its own narrowest part, genuinely produces nothing, and refusing to do it would be refusing to answer
    ///the question that was asked. It is one press of undo either way.
    ///
    private async Task replaceWith(
        List<GDS.ElementModel> taking,
        List<List<Element.Point>> made,
        string named)
    {
        if (Gds is null || context is null)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var onLayer = layerOf(taking[0]);

        var edits = new List<LayoutEdit>();

        foreach (var model in taking)
            edits.Add(new DeleteElement(Gds, structure, model));

        foreach (var outline in made)
        {
            if (outline.Count < 3)
                continue;

            edits.Add(new AddElement(Gds, structure, onLayer, outline));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit(named, edits));

        //Everything that went in has gone and what came out is new, so the numbering has moved and the
        //indexes no longer name what they named. See afterEdit.
        await afterEdit();
    }

    ///
    ///The chosen shapes a set operation can take, in the order they were chosen.
    ///
    ///Distinct elements, because two instances of one are one thing to combine; with an area, because a
    ///label is not one; and only what the cell holds, which is the rule everything here follows.
    ///
    private List<GDS.ElementModel> combinable()
    {
        var taking = new List<GDS.ElementModel>();

        if (context is null)
            return taking;

        foreach (var element in Editable)
        {
            if (element.Source is not ElementSource source || taking.Contains(source.Model))
                continue;

            if (element.Text is not null)
                continue;

            //An area of three corners or more, worked out the way the picture works it out - so a path counts
            //by its outline, a straight one included, and a hairline that covers nothing does not count at all.
            if (GdsFlattener.OutlineOf(source.Model) is List<Element.Point> outline && outline.Count >= 3)
                taking.Add(source.Model);
        }

        return taking;
    }

    ///<summary>Their outlines in the cell's own coordinates, which is where the operation happens.</summary>
    private static List<IReadOnlyList<Element.Point>> outlinesOf(List<GDS.ElementModel> models)
    {
        var outlines = new List<IReadOnlyList<Element.Point>>();

        //
        //**A path by its outline, not by its centerline.** Its XY is the line down its middle, and reading that
        //as corners grew or combined the triangle a wire with one bend makes rather than the wire. See
        //GdsFlattener.OutlineOf.
        //
        foreach (var model in models)
        {
            if (GdsFlattener.OutlineOf(model) is List<Element.Point> outline)
                outlines.Add(outline);
        }

        return outlines;
    }

    private static LayerKey layerOf(GDS.ElementModel model)
    {
        short number = -1;

        if (model.Element is GDS.IHasLayer element)
        {
            if (element.LAYER?.Data is Int2Data layer)
                number = layer.Value;

            if (element.DataTypeRecord?.Data is Int2Data dataType)
                return new LayerKey(number, dataType.Value);
        }

        return new LayerKey(number, LayerKey.UnknownDataType);
    }

    private async Task changeGrowBy(ChangeEventArgs e)
    {
        growMicrons = realNumber(e, growMicrons);

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>
    ///How far to grow, in the cell's own coordinates.
    ///
    ///Through the placement's scale, because a cell placed at half size draws a shape at half size - so a
    ///tenth of a micron on screen is two tenths inside it. One line for something almost no file does, and
    ///the alternative is a distance that quietly means something else on the cells that do.
    ///</summary>
    private int growUnits()
    {
        if (micronsPerUnit() is not double microns || microns <= 0)
            return (int)Math.Round(growMicrons);

        double units = growMicrons / microns;

        if (context is not null && context.Placement.Scale is double scale && scale > 0)
            units = units / scale;

        return (int)Math.Round(units);
    }

    private string growDescription()
    {
        if (growUnits() == 0)
            return "A distance of nothing would move no edge";

        return FormattableString.Invariant($"Move every edge by {growUnits():N0} database units");
    }

    #region Corners ******************************************

    ///<summary>How far along each edge a corner is rounded or cut, in microns. Kept from one press to the next, like the grow distance.</summary>
    private double cornerMicrons = 0.1;

    private async Task changeCornerBy(ChangeEventArgs e)
    {
        cornerMicrons = Math.Max(0, realNumber(e, cornerMicrons));

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>The same distance in the cell's own coordinates, through the placement's scale - see growUnits.</summary>
    private int cornerUnits()
    {
        if (micronsPerUnit() is not double microns || microns <= 0)
            return (int)Math.Round(cornerMicrons);

        double units = cornerMicrons / microns;

        if (context is not null && context.Placement.Scale is double scale && scale > 0)
            units = units / scale;

        return (int)Math.Round(units);
    }

    ///
    ///How many straight steps a quarter turn of a rounded corner is drawn in.
    ///
    ///**The ellipse's sides, a quarter of them.** How round a round thing is was already a setting, under the
    ///pencil beside the ellipse, and a corner and an ellipse drawn in one sitting should be equally round.
    ///
    private int stepsPerQuarter()
    {
        return Math.Max(1, ellipseSides / 4);
    }

    private string cornersDescription(bool rounding)
    {
        if (cornerUnits() <= 0)
            return "A distance of nothing would change no corner";

        if (rounding)
            return FormattableString.Invariant($"Round every corner to an arc of radius {cornerUnits():N0} database units, in {stepsPerQuarter()} steps a quarter turn - smaller where an edge is too short to give that much");

        return FormattableString.Invariant($"Cut every corner off {cornerUnits():N0} database units along each edge - less where an edge is too short to give that much");
    }

    private async Task roundCorners()
    {
        int radius = cornerUnits();
        int steps = stepsPerQuarter();

        await reshapeCorners(outline => Corners.Round(outline, radius, steps), "Round corners");
    }

    private async Task cutCorners()
    {
        int size = cornerUnits();

        await reshapeCorners(outline => Corners.Cut(outline, size), "Cut corners");
    }

    ///
    ///Every chosen shape's corners rounded or cut, as one step.
    ///
    ///**Each shape stays on its own layer, and where it was in the file.** A boundary has its corners
    ///rewritten in place - the same element with its properties, and the kind of edit the drawing can follow
    ///without flattening the library again (see GdsFlattener.Reflatten). A path has no corners of its own to
    ///rewrite: its outline is worked out from a centerline and a width, so it becomes the boundary of that
    ///outline with the corners changed, which is the only thing rounding a wire's corners can mean.
    ///
    ///In the cell's own coordinates, like the set operations: a corner rounded and then placed turned is the
    ///turned corner rounded, so there is nothing to go out through the placement for.
    ///
    private async Task reshapeCorners(Func<List<Element.Point>, List<Element.Point>> reshape, string named)
    {
        if (Gds is null || context is null || cornerUnits() <= 0)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var edits = new List<LayoutEdit>();
        var kept = new List<GDS.ElementModel>();
        var added = new List<AddElement>();

        //How many the deck's grid would spoil, and the layer of one of them for the sentence that says so.
        int spoiled = 0;
        var spoiledOn = drawOn;

        drawRefusal = "";

        foreach (var model in combinable())
        {
            if (GdsFlattener.OutlineOf(model) is not List<Element.Point> outline)
                continue;

            //
            //**The new corners are worked out, so they go on the deck's grid** - see deckGrid. A shape the grid
            //would spoil is left as it was and said, rather than written crossing itself: an arc within a step
            //of an edge it is not on can land across it, and something a step or two across can come out flat.
            //
            int grid = deckGrid(layerOf(model));
            var made = Grid.Snap(reshape(outline), grid);

            if (grid > 1 && notAShape(made))
            {
                spoiled++;
                spoiledOn = layerOf(model);

                continue;
            }

            //Nothing to change - a shape with no corner the distance can reach - is left alone rather than
            //rewritten as itself, which would be a step of undo that does nothing.
            if (made.Count < 3 || made.SequenceEqual(outline))
                continue;

            if (model.Element is GDS.BoundaryModel)
            {
                var coordinates = new int[made.Count * 2];

                for (int i = 0; i < made.Count; i++)
                {
                    coordinates[i * 2] = made[i].X;
                    coordinates[(i * 2) + 1] = made[i].Y;
                }

                edits.Add(new ReshapeElement(structure, model, coordinates, named));
                kept.Add(model);

                continue;
            }

            var adding = new AddElement(Gds, structure, layerOf(model), made);

            edits.Add(new DeleteElement(Gds, structure, model));
            edits.Add(adding);
            added.Add(adding);
        }

        //Said whether or not the rest changed: one shape left alone among several done is still one to know about.
        if (spoiled == 1)
            drawRefusal = $"One shape was left as it was: on {deckGridSaid(spoiledOn)} its new corners would cross or flatten it. Try a larger distance.";
        else if (spoiled > 1)
            drawRefusal = $"{spoiled} shapes were left as they were: on {deckGridSaid(spoiledOn)} their new corners would cross or flatten them. Try a larger distance.";

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit(named, edits));

        //A boundary rewritten in place is the element it was, so what was chosen still is. A path that became
        //a boundary is a new element, and the new one is what is picked out.
        if (added.Count == 0)
        {
            await afterEdit(keepChosen: true);

            return;
        }

        await afterEdit(choosing: kept.Concat(added.Select(edit => edit.Made).OfType<GDS.ElementModel>()).ToList());
    }

    #endregion ***********************************************

    ///
    ///Opens the array's boxes, and the first time it does, sets the pitch from what is chosen.
    ///
    ///Edge to edge with the original rather than a number picked out of the air: the size of the thing being
    ///repeated is the only sensible default, and it is the one somebody abutting standard cells wants without
    ///changing anything. Only on the first open, so a pitch that was typed is not overwritten by reopening.
    ///
    private async Task toggleArray()
    {
        arrayOpen = !arrayOpen;

        if (arrayOpen && !arrayPitchChosen)
        {
            var box = Measure.BoundsOf(layoutOf(Editable));

            if (!box.IsEmpty && micronsPerUnit() is double microns && microns > 0)
            {
                arrayPitchX = Math.Round(box.Width * microns, 4);
                arrayPitchY = Math.Round(box.Height * microns, 4);
            }
        }

        await OnToolChanged.InvokeAsync();
    }

    ///<summary>Whether the pitch is somebody's rather than the one worked out from the first selection.</summary>
    private bool arrayPitchChosen = false;

    private async Task changeArrayColumns(ChangeEventArgs e)
    {
        arrayColumns = Math.Clamp(wholeNumber(e, arrayColumns), 1, MostAcross);

        await OnToolChanged.InvokeAsync();
    }

    private async Task changeArrayRows(ChangeEventArgs e)
    {
        arrayRows = Math.Clamp(wholeNumber(e, arrayRows), 1, MostAcross);

        await OnToolChanged.InvokeAsync();
    }

    private async Task changeArrayPitchX(ChangeEventArgs e)
    {
        arrayPitchX = realNumber(e, arrayPitchX);
        arrayPitchChosen = true;

        await OnToolChanged.InvokeAsync();
    }

    private async Task changeArrayPitchY(ChangeEventArgs e)
    {
        arrayPitchY = realNumber(e, arrayPitchY);
        arrayPitchChosen = true;

        await OnToolChanged.InvokeAsync();
    }

    private static int wholeNumber(ChangeEventArgs e, int unchanged)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int given))
            return unchanged;

        return given;
    }

    private static double realNumber(ChangeEventArgs e, double unchanged)
    {
        if (!SvgWriter.TryParseNumber(e.Value?.ToString(), out double given))
            return unchanged;

        if (double.IsNaN(given) || double.IsInfinity(given))
            return unchanged;

        return given;
    }

    ///<summary>A pitch in microns as a distance in the layout's own coordinates.</summary>
    private double arrayUnits(double microns)
    {
        if (micronsPerUnit() is not double perUnit || perUnit <= 0)
            return Math.Round(microns);

        return Math.Round(microns / perUnit);
    }

    ///
    ///Repeats the chosen shapes into a grid of copies.
    ///
    ///**Copies rather than an array reference.** GDSII has an `AREF` for exactly this and it would be a
    ///fraction of the size - but an AREF places a *cell*, and a selection of shapes is not one. Making a cell
    ///out of a selection is a thing this editor cannot do yet; when it can, this is where the two would meet.
    ///
    ///The pitch is a distance on screen, so it is brought into the cell the same way a drag is - which is
    ///what makes a row of copies march across the screen rather than across the cell's own axes when the cell
    ///is placed turned.
    ///
    ///Rows go **down** the screen for a positive pitch, which is what somebody asking for three rows means.
    ///A negative pitch goes the other way, which is the whole of the "which direction" question answered
    ///without another control.
    ///
    ///
    ///The placement an array reference would repeat, when there is one.
    ///
    ///Exactly one shape chosen, and reached through an instance the cell being edited holds. One rather than
    ///several because an array repeats *a placement*: with two shapes chosen from the same instance the
    ///answer would be the same array either way, which reads as though the second choice did something.
    ///
    ///**A single instance, held by the cell being edited.** One that is an array already has its grid, and an
    ///array of an array is not something the format has a record for: offered anyway, the button wrote a
    ///second set of counts into the array and the app stopped on reading it back. One two levels down is in
    ///a cell nobody is looking at - the rule every other edit here follows.
    ///
    private ElementSource? arrayableInstance()
    {
        if (context is null || Only is not Element one || one.Source is not ElementSource source)
            return null;

        if (source.Ancestry.Count < 2 || source.Ancestry[^2].Structure != context.Structure)
            return null;

        if (placementThrough(source) is not (_, GDS.ElementModel placement) || placement.Element is not GDS.SrefModel)
            return null;

        return source;
    }

    private bool ArrayingInstance
    {
        get { return arrayableInstance() is not null; }
    }

    private bool canArray()
    {
        if (ArrayingInstance)
            return arrayColumns * arrayRows > 1;

        return ArrayCopies > 0;
    }

    ///
    ///Repeats a placement as one array record rather than as a copy per place.
    ///
    ///What the format has an AREF for, and what the copying path cannot do: a hundred by a hundred is a
    ///single record instead of ten thousand elements. It became possible the moment cells could be made -
    ///an AREF places a *cell*, and until then there was never one to point at.
    ///
    private async Task arrayInstance(ElementSource source)
    {
        if (Gds is null || context is null)
            return;

        if (placementThrough(source) is not (GDS.StructureModel inside, GDS.ElementModel instance))
            return;

        if (recordsOf(instance) is not List<GDS.Record> span)
            return;

        //The pitch is a distance on screen, so both step vectors are brought into the cell holding the
        //instance the same way a drag is.
        double stepX = arrayUnits(arrayPitchX);
        double stepY = arrayUnits(arrayPitchY);

        (int acrossX, int acrossY) = localDistance(stepX, 0) ?? (0, 0);
        (int downX, int downY) = localDistance(0, stepY) ?? (0, 0);

        if (arrayColumns > 1 && acrossX == 0 && acrossY == 0)
            return;

        if (arrayRows > 1 && downX == 0 && downY == 0)
            return;

        if (Hierarchy.AsArray(span, arrayColumns, arrayRows, acrossX, acrossY, downX, downY) is not List<GDS.Record> made)
            return;

        var edits = new List<LayoutEdit>
        {
            new DeleteElement(Gds, inside, instance),
            new AddElement(Gds, inside, made, "Array")
        };

        History.Do(new CompoundEdit("Array", edits));

        await afterEdit();
    }

    private async Task makeArray()
    {
        if (Gds is null || context is null)
            return;

        //A placement can be repeated as one record; loose shapes have to be copied.
        if (arrayableInstance() is ElementSource instance)
        {
            await arrayInstance(instance);

            return;
        }

        if (ArrayCopies == 0)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var models = new List<GDS.ElementModel>();

        foreach (var element in Editable)
        {
            if (element.Source is ElementSource source && !models.Contains(source.Model))
                models.Add(source.Model);
        }

        if (models.Count == 0)
            return;

        double stepX = arrayUnits(arrayPitchX);
        double stepY = arrayUnits(arrayPitchY);

        //A pitch that rounds to nothing would stack every copy on the original, which is a pile of shapes
        //nobody can tell apart and a file that is quietly larger for no reason.
        if (arrayColumns > 1 && stepX == 0)
            return;

        if (arrayRows > 1 && stepY == 0)
            return;

        var edits = new List<LayoutEdit>();

        for (int row = 0; row < arrayRows; row++)
        {
            for (int column = 0; column < arrayColumns; column++)
            {
                //The one already there.
                if (row == 0 && column == 0)
                    continue;

                if (localDistance(column * stepX, row * stepY) is not (int localX, int localY))
                    continue;

                foreach (var model in models)
                {
                    if (AddElement.CopyOf(Gds, structure, model, localX, localY) is LayoutEdit copy)
                        edits.Add(copy);
                }
            }
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit("Array", edits));

        //Not kept: every copy is a new element, so the numbering after the first one has shifted and the
        //indexes no longer name what they named. See afterEdit.
        await afterEdit();
    }

    ///
    ///Brings the chosen shapes into line on one edge, or spaces them out evenly.
    ///
    ///**One box per element, not one per shape on screen.** A cell placed three times draws three of
    ///everything in it, and all three answer to the same records - so lining up "each shape" would be asking
    ///three copies of one element to sit in three different places. Every distinct element is measured once,
    ///through the placement being looked through, and moves once.
    ///
    ///That is also what makes the answer the same whichever instance happened to be clicked: the box is
    ///worked out from the element's own coordinates put through the current placement, not from whichever
    ///copy the pointer landed on.
    ///
    private async Task lineUpChosen(Edge? edge, Along? along, string named)
    {
        if (Gds is null || context is null)
            return;

        var models = new List<GDS.ElementModel>();
        var boxes = new List<Bounds>();

        foreach (var element in Editable)
        {
            if (element.Source is not ElementSource source || models.Contains(source.Model))
                continue;

            var box = layoutBoxOf(source.Model);

            if (box.IsEmpty)
                continue;

            models.Add(source.Model);
            boxes.Add(box);
        }

        //Two to line up, three to space out - with two there is no gap between them to divide.
        if (models.Count < 2 || (along is not null && models.Count < 3))
            return;

        IReadOnlyList<(int Dx, int Dy)> offsets;

        if (edge is Edge which)
            offsets = Aligning.Aligned(boxes, which);
        else
            offsets = Aligning.SpacedOut(boxes, along!.Value);

        //One structure for the lot: everything editable is what the current cell holds, by definition.
        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var edits = new List<LayoutEdit>();

        for (int i = 0; i < models.Count; i++)
        {
            //Already where it is being asked to go. Skipped rather than written as a move by nothing, which
            //would fill the undo stack with steps that undo to the same picture.
            if (localDistance(offsets[i].Dx, offsets[i].Dy) is not (int localX, int localY))
                continue;

            edits.Add(new MoveElement(structure, models[i], localX, localY));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit(named, edits));

        await afterEdit(keepChosen: true);
    }

    ///<summary>
    ///One element's box as it is drawn, worked out from its own coordinates through the current placement
    ///rather than read off whichever instance was clicked.
    ///</summary>
    private Bounds layoutBoxOf(GDS.ElementModel model)
    {
        if (context is null || model.Element.XY?.Data is not Int4Data xy || xy.Values.Length < 2)
            return Bounds.Empty;

        var drawn = new List<Element.Point>();

        for (int i = 0; i + 1 < xy.Values.Length; i += 2)
        {
            (double x, double y) = context.ToLayout(xy.Values[i], xy.Values[i + 1]);

            drawn.Add(new Element.Point((int)Math.Round(x), (int)Math.Round(y)));
        }

        return Bounds.Of(drawn);
    }

    private async Task turnChosen(Turn turn, string named)
    {
        if (Gds is null || context is null)
            return;

        //What the cell holds, not everything caught - the same rule delete follows, and for the same reason.
        var moving = Editable;

        if (moving.Count == 0)
        {
            await turnInstance(turn, named);

            return;
        }

        var box = Measure.BoundsOf(layoutOf(moving));

        if (box.IsEmpty)
            return;

        double pivotX = Math.Round((box.Left + (double)box.Right) / 2);
        double pivotY = Math.Round((box.Bottom + (double)box.Top) / 2);

        var edits = new List<LayoutEdit>();
        var already = new HashSet<GDS.ElementModel>();

        //**Distinct models, not distinct shapes.** Two chosen shapes may be two instances of one element,
        //and turning that element twice would turn it half a circle.
        foreach (var element in moving)
        {
            if (element.Source is not ElementSource source || !already.Add(source.Model))
                continue;

            if (structureNamed(source.Structure) is not GDS.StructureModel structure)
                continue;

            if (Turning.Coordinates(context, source.Model, turn, pivotX, pivotY) is not int[] after)
                continue;

            edits.Add(new ReshapeElement(structure, source.Model, after, named));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit(named, edits));

        await afterEdit(keepChosen: true);
    }

    ///<summary>A layout of just those shapes, so their box can be measured with the same code as any other.</summary>
    private static FlattenedLayout layoutOf(IEnumerable<Element> shapes)
    {
        var only = new FlattenedLayout();

        only.Elements.AddRange(shapes);

        return only;
    }

    ///<summary>Takes the chosen shapes out of the cells they belong to, as one step.</summary>
    ///<summary><paramref name="named"/> is what the undo stack reads, so a cut says Cut rather than Delete.</summary>
    private async Task deleteChosen(string named = "Delete")
    {
        if (Gds is null)
            return;

        var edits = new List<LayoutEdit>();
        var already = new HashSet<GDS.ElementModel>();

        //**What the cell holds, not everything chosen.** A rubber band across the view catches shapes from
        //cells that are only being shown, and taking one of those out would be a change nobody asked for
        //in a cell nobody is looking at. The button is offered on the same condition; the two agreeing is
        //what stops the panel promising something different from what the press does.
        foreach (var element in Editable)
        {
            if (element.Source is not ElementSource source || !already.Add(source.Model))
                continue;

            var structure = structureNamed(source.Structure);

            if (structure is not null)
                edits.Add(new DeleteElement(Gds, structure, source.Model));
        }

        //
        //Nothing of this cell's own was caught, but placements it holds may have been - and taking those out
        //is a change to this cell rather than to the ones they place, which is the only reason it is allowed.
        //
        //**All of them, not the one.** This asked chosenInstance, which answers only when the selection is
        //exactly one placement - so a band across ten placed cells deleted nothing, and the Delete key did
        //nothing, silently. Turning and moving still ask the stricter question, because two placements
        //turned about their own middles have no single answer; taking records out has no such problem.
        //
        if (edits.Count == 0)
        {
            foreach (var (inside, instance) in chosenInstances())
                edits.Add(new DeleteElement(Gds, inside, instance));
        }

        if (edits.Count == 0)
            return;

        History.Do(new CompoundEdit(named, edits));

        await afterEdit();
    }

    ///
    ///Takes the chosen shapes onto the clipboard and out of the cell, as one step.
    ///
    ///Copy and then delete, which is what a cut is - and one entry on the undo stack rather than two,
    ///because the delete is already a single CompoundEdit and copying is not an edit at all.
    ///
    ///The clipboard carries labels for this to be safe: cut has to give back everything it takes, and Copy
    ///used to skip them. See <see cref="Copied"/>.
    ///
    private async Task cutChosen()
    {
        //Nothing this cell holds is nothing to take out, and copying anyway would be half a cut: the
        //clipboard would fill while the shapes stayed where they were. The button is offered on the same
        //condition, so the two cannot disagree.
        if (Editable.Count == 0)
            return;

        await copyChosen();

        await deleteChosen("Cut");
    }

    private GDS.StructureModel? structureNamed(string name)
    {
        return Gds?.StreamFormat.Structures
            .FirstOrDefault(each => (each.STRNAME?.Data as AsciiData)?.Value == name);
    }

    ///
    ///Copies the chosen shapes, in the layout's coordinates.
    ///
    ///The layout's rather than the cell's, so what is copied can be pasted anywhere: a shape taken from one
    ///cell and put into another arrives where it looked like it was, which is the only place somebody who
    ///copied it would expect. The clipboard is this view's own - putting a layout on the system one would
    ///mean choosing a serialization for it, and nothing else can read this anyway.
    ///
    ///**But the system's says that shapes were copied** (2026-10-19), since a paste writes the words it finds
    ///there as shapes now - and without that, words copied anywhere at any time before would be written in
    ///place of the shapes just copied. See markShapesCopied in the interop.
    ///
    private async Task copyChosen()
    {
        clipboard = Chosen
            .Where(element => element.Text is not null || element.Points.Count >= 3)
            .Select(element => new Copied(element.Layer.Key, element.Points.ToList(), element.Text))
            .ToList();

        if (clipboard.Count > 0)
        {
            try
            {
                await js.InvokeVoidAsync("markShapesCopied", clipboard.Count);
            }
            catch (JSException) { }
        }

        //
        //The bar is the shell's, so this component re-rendering itself does not redraw it - the same reason
        //the tool highlight needed a callback.
        //
        //Paste is no longer up there, so nothing in the bar depends on a copy any more. Kept because a copy
        //still changes what the *menu* offers, and because leaving the shell a render behind the component
        //is the kind of thing that only shows later, on whatever is added to the bar next.
        //
        await OnToolChanged.InvokeAsync();
    }

    ///<summary>Where the menu was asked for, in the window's own pixels, or null while it is closed.</summary>
    private (double X, double Y)? menuAt = null;

    private ElementReference shapeMenuBox;

    ///<summary>Whether the menu has yet to be given the keyboard. See OnAfterRenderAsync.</summary>
    private bool focusShapeMenu = false;

    ///
    ///One line of the menu: something to do, or something that opens onto more.
    ///
    ///A null in the lists built below is a rule between two groups, which is why these are held as nullable
    ///rather than as a type with a "this one is a rule" flag on it - a rule has no name, no action and no
    ///state, and giving it a shape of its own would mean answering four questions about it that never come
    ///up.
    ///
    private sealed class MenuLine
    {
        public string Says { get; init; } = "";

        public string? Tells { get; init; }

        public bool Offered { get; init; } = true;

        ///<summary>What pressing it does, on a line that does something.</summary>
        public Func<Task>? Does { get; init; }

        ///<summary>What it opens onto, on a line that opens rather than acts.</summary>
        public List<MenuLine?>? Opens { get; init; }

        ///
        ///The picture in front of the words, where the action has one.
        ///
        ///Null on the lines that do not - "New cell" is one: a picture invented for it would be a glyph
        ///nobody recognizes taking up the column that makes the recognizable ones scannable. The column is
        ///held open either way, so the words still line up.
        ///
        ///Trace net used to be in that group and no longer is. The rule was never "leave the unusual ones
        ///blank" but "do not invent"; a run of metal turning up a level through a via is not an invention,
        ///it is the thing on screen.
        ///
        public SvgWriter.ShapeIcon? Shows { get; init; }
    }

    private static MenuLine Action(string says, Func<Task> does, bool offered = true, string? tells = null, SvgWriter.ShapeIcon? shows = null)
    {
        return new MenuLine { Says = says, Does = does, Offered = offered, Tells = tells, Shows = shows };
    }

    private static MenuLine Opening(string says, List<MenuLine?> onto, string? tells = null, SvgWriter.ShapeIcon? shows = null)
    {
        return new MenuLine { Says = says, Opens = onto, Tells = tells, Shows = shows };
    }

    ///<summary>
    ///Opens the menu where the pointer is, if there is anything for it to act on.
    ///
    ///In window pixels, because the menu is placed with position:fixed - which means no conversion into the
    ///wrapper's coordinates, and nothing to get wrong when the page is scrolled or the view is full screen.
    ///</summary>
    private async Task openShapeMenu(MouseEventArgs e)
    {
        //
        //**On the frame of writing or a picture just put down, the frame's own menu** - see pieceMenuLines. Otherwise
        //the press would choose the one square of it under the pointer, and Turn would turn that square alone.
        //
        if (pieceLive() && await js.InvokeAsync<bool>("pieceAt", e.ClientX, e.ClientY))
        {
            menuLines = pieceMenuLines();

            await placeMenu(e);

            return;
        }

        await chooseForMenu(e);

        //
        //Nothing under the pointer and nothing chosen before it is nothing to offer, so the menu stays shut
        //and the press has done nothing at all.
        //
        //**Unless there is something to paste**, which is the one line that is not about a selection - and
        //pressing on empty canvas is exactly where somebody means to put it. Without this the menu is shut
        //at the only moment Paste is the thing being reached for.
        //
        if (chosenIndexes.Count == 0 && !(context is not null && clipboard.Count > 0))
            return;

        //Null means "the canvas menu", which is rebuilt from the selection on every render rather than
        //held. See the foreach in the markup.
        menuLines = null;

        await placeMenu(e);
    }

    ///
    ///Puts the menu at the pointer, deciding which way it grows.
    ///
    ///Shared by the canvas and by every row that raises one, so a menu opened on a layer near the foot of
    ///the sidebar behaves like a menu opened on a shape near the foot of the view.
    ///
    private async Task placeMenu(MouseEventArgs e)
    {
        //
        //Which way the submenus open, decided once when the menu does.
        //
        //A submenu sits to the right of the line that opens it, which off the right-hand end of the window
        //is a panel nobody can read. Asked here rather than in CSS because it is a comparison against the
        //window's own width, which a stylesheet has no way to make.
        //
        var window = await js.InvokeAsync<WindowSize>("windowSize");

        menuOpensLeftward = (window.Width - e.ClientX) < RoomASubmenuNeeds;

        //
        //And which end of it is pinned.
        //
        //The half rather than the menu's own height, which is not knowable before it is drawn: pinned to
        //whichever side of the pointer has more of the window on it, the menu has at least half a window to
        //grow into, and ten lines of it is about a quarter of that.
        //
        menuFromBottom = window.Height - e.ClientY;
        menuOpensUpward = e.ClientY > (window.Height / 2);

        menuAt = (e.ClientX, e.ClientY);
        focusShapeMenu = true;
    }

    ///
    ///The lines of a menu raised on a row, or null for the canvas menu.
    ///
    ///**Held rather than rebuilt, unlike the canvas menu.** That one is about whatever is chosen, which is
    ///a thing that can change while the menu is open; this one is about the row that was pressed, and the
    ///row is not on screen to be pressed again. Building it at render time would mean carrying which row it
    ///was as state anyway, and then answering what the menu should say once that row has been deleted by
    ///the very line that deleted it.
    ///
    private List<MenuLine?>? menuLines = null;

    ///<summary>Whether the menu grows upwards from the pointer rather than down from it.</summary>
    private bool menuOpensUpward = false;

    ///<summary>How far the pointer was off the foot of the window, for when it does.</summary>
    private double menuFromBottom = 0;

    ///<summary>Where the menu is pinned: at its top under the pointer, or at its bottom above it.</summary>
    private string menuVerticalStyle()
    {
        if (menuAt is not (double _, double menuY))
            return "";

        if (menuOpensUpward)
            return FormattableString.Invariant($"bottom: {SvgWriter.FormatNumber(menuFromBottom)}px;");

        return FormattableString.Invariant($"top: {SvgWriter.FormatNumber(menuY)}px;");
    }

    ///<summary>Whether the submenus open to the left, because there is no room on the right.</summary>
    private bool menuOpensLeftward = false;

    ///<summary>Two menus' width, which is what a submenu needs beside the one that opened it.</summary>
    private const double RoomASubmenuNeeds = 320;

    ///<summary>How big the window is, as the interop hands it back.</summary>
    private sealed class WindowSize
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }

    ///
    ///Makes the shape under the pointer the one the menu will be about.
    ///
    ///**A right-click on something not chosen chooses it**, which is what every editor does and what this
    ///did not. Measured: right-clicking a shape nothing had selected opened no menu at all, and doing it
    ///over one shape while another was chosen opened a menu about the *other* one - so Delete on a shape
    ///under the pointer took away one somewhere else.
    ///
    ///**A right-click inside the selection leaves it alone.** Choosing several and then asking for the menu
    ///over one of them must not throw the other three away, which is the whole reason the two cases are told
    ///apart rather than the click simply being passed to the select tool.
    ///
    ///Nothing under the pointer also leaves it alone. The menu over bare canvas is still about whatever is
    ///chosen, which is how a selection reaches its actions when the shapes themselves are behind the panel.
    ///
    private async Task chooseForMenu(MouseEventArgs e)
    {
        if (layout is null)
            return;

        var at = await js.InvokeAsync<LayoutPoint?>("layoutPointAt", e.ClientX, e.ClientY);

        if (at is null)
            return;

        //No label to reconcile against: the browser found nothing here, because this is not the event that
        //went to the picture. Labels are still picked by their own outline through Picking.
        int found = HitTest(at.X, at.Y, -1);

        if (found < 0)
            return;

        if (chosenIndexes.Contains(found))
            return;

        await choose(new List<int> { found });
    }

    ///<summary>A place in the layout's own units, as the conversion in JS hands it back.</summary>
    private sealed class LayoutPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    private void closeShapeMenu()
    {
        menuAt = null;
        menuLines = null;
    }

    private async Task chooseFromMenu(Func<Task>? does)
    {
        //Nullable because a line that opens a submenu has no action of its own. Those are not rendered as
        //something to press, so this is a guard against a fourth kind of line rather than against anything
        //the markup can produce today.
        if (does is null)
            return;

        //Closed first. Every one of these rebuilds the picture, and a menu still open over it is one the
        //next render has to place again for no reason.
        closeShapeMenu();

        await does();
    }

    ///<summary>Escape puts it away. Tab moves through it, which buttons do without being asked.</summary>
    private void onShapeMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            closeShapeMenu();
    }

    ///
    ///What the menu offers, in order, with a null where a rule goes.
    ///
    ///**Built from the conditions the buttons are written under, not from a copy of them.** Every line calls
    ///the method its button calls and appears when its button appears, so the two cannot drift - and the
    ///words are the constants the undo step is named with, so a line says what it will be called afterwards.
    ///
    private List<MenuLine?> shapeMenuItems()
    {
        var lines = new List<MenuLine?>();

        //
        //**Paste, which is the one line here that is not about what is chosen.**
        //
        //It was a labeled button in the toolbar that appeared the moment anything was copied, pushing the
        //undo pair along and rearranging the bar as a side effect of a copy. Here it is beside Copy and Cut,
        //where the other two thirds of the clipboard already were - and the menu opens for it alone, so a
        //press on empty canvas is a way to paste rather than a press that does nothing.
        //
        //First, because with nothing chosen it is the only line there is.
        //
        if (context is not null && clipboard.Count > 0)
        {
            string pasteLabel = FormattableString.Invariant($"Paste {clipboard.Count}");

            if (clipboard.Count == 1)
                pasteLabel = "Paste";

            lines.Add(Action(
                pasteLabel,
                pasteClipboard,
                true,
                "Put the copied shapes into the cell being edited, under the pointer and ready to be moved (Ctrl+V)",
                SvgWriter.ShapeIcon.Paste));

            if (chosenIndexes.Count > 0)
                lines.Add(null);
        }

        //And everything below acts on a selection, so it is left out when there is none.
        if (chosenIndexes.Count == 0)
            return lines;

        lines.Add(Action("Copy", copyChosen, true, "Copy the chosen shapes (Ctrl+C)", SvgWriter.ShapeIcon.Copy));

        if (Editable.Count > 0)
        {
            lines.Add(Action("Cut", cutChosen, true, "Onto the clipboard and out of the cell, as one step (Ctrl+X)", SvgWriter.ShapeIcon.Cut));

            lines.Add(Action("Delete", () => deleteChosen(), true, "Remove them from the cell. Every instance of it loses them (Delete)", SvgWriter.ShapeIcon.Delete));
        }
        else if (DeletingInstances)
            lines.Add(Action(deleteInstancesSays(), () => deleteChosen(), true, "Take them out. The cells they place stay in the library", SvgWriter.ShapeIcon.Delete));

        if (Editable.Count > 0 || EditingInstance)
        {
            lines.Add(null);

            //
            //Short words inside, because the line that opened them has already said the verb.
            //
            //The action still carries the whole phrase - the constants the undo step is named with - so
            //pressing "Right" under "Turn" leaves a step called "Turn right", which is what the toolbar
            //will offer to take back.
            //
            lines.Add(Opening("Turn", new List<MenuLine?>
            {
                Action("Left", () => turnChosen(Turn.ThreeQuarters, TurnLeftName), true, "Turn a quarter to the left, about the middle of what is chosen", SvgWriter.ShapeIcon.TurnLeft),
                Action("Right", () => turnChosen(Turn.Quarter, TurnRightName), true, "Turn a quarter to the right, about the middle of what is chosen", SvgWriter.ShapeIcon.TurnRight),
                null,
                Action("Mirror across", () => turnChosen(Turn.FlipX, MirrorAcrossName), true, "Mirror left to right, about the middle of what is chosen", SvgWriter.ShapeIcon.MirrorAcross),
                Action("Mirror down", () => turnChosen(Turn.FlipY, MirrorDownName), true, "Mirror top to bottom, about the middle of what is chosen", SvgWriter.ShapeIcon.MirrorDown)
            }, "Turn or mirror what is chosen, about its own middle", SvgWriter.ShapeIcon.Turn));
        }

        if (DistinctEditable > 1)
        {
            lines.Add(Opening("Combine", new List<MenuLine?>
            {
                Action(UnionName, () => combineChosen(BooleanOperation.Or, UnionName), true, "One shape covering everything they cover between them", SvgWriter.ShapeIcon.Union),
                Action(SubtractName, () => combineChosen(BooleanOperation.Not, SubtractName), true, "The first one chosen, with all the others cut out of it", SvgWriter.ShapeIcon.Subtract),
                Action(IntersectName, () => combineChosen(BooleanOperation.And, IntersectName), true, "Only where every one of them covers", SvgWriter.ShapeIcon.Intersect),
                Action(ExcludeName, () => combineChosen(BooleanOperation.Xor, ExcludeName), true, "Where an odd number of them cover, so an overlap of two cancels out", SvgWriter.ShapeIcon.Exclude)
            }, "Make one shape out of the ones chosen", SvgWriter.ShapeIcon.Union));

            lines.Add(Opening("Line up", lineUpLines(), "Bring their edges into line, or even out the space between them", SvgWriter.ShapeIcon.AlignLeft));
        }

        if (Editable.Count > 0 || ArrayingInstance || DistinctEditable > 0 || Only is Element)
            lines.Add(null);

        if (Editable.Count > 0 || ArrayingInstance)
            lines.Add(Action("Array…", toggleArray, true, "Repeat these into a grid of copies at a pitch you choose", SvgWriter.ShapeIcon.Array));

        if (DistinctEditable > 0)
            lines.Add(Action("New cell", groupIntoCell, canMakeCell(), makeCellDescription(), SvgWriter.ShapeIcon.NewCell));

        if (Only is Element net && layout is not null)
            lines.Add(Action("Trace net", traceNet, Nets.TakesPart(net), netDescription(net), SvgWriter.ShapeIcon.TraceNet));

        return lines;
    }

    ///
    ///Lining up, and spacing out, which share a submenu.
    ///
    ///One list rather than two: they are the same question asked of the same shapes - where should these sit
    ///relative to each other - and a submenu of two lines for the second half would be a menu that costs more
    ///to open than it holds.
    ///
    ///Spacing needs three, because two shapes have no gap between them to divide. The same condition the
    ///buttons carry, so the rule above it goes too when they do: a rule with nothing under it is a stray mark
    ///at the bottom of a submenu.
    ///
    private List<MenuLine?> lineUpLines()
    {
        var lines = new List<MenuLine?>
        {
            Action("Left", () => lineUpChosen(Edge.LeastX, null, LeftName), true, "Bring their left edges into line", SvgWriter.ShapeIcon.AlignLeft),
            Action("Center", () => lineUpChosen(Edge.MiddleX, null, CenterName), true, "Bring them onto one vertical line through their middles", SvgWriter.ShapeIcon.AlignCenterX),
            Action("Right", () => lineUpChosen(Edge.MostX, null, RightName), true, "Bring their right edges into line", SvgWriter.ShapeIcon.AlignRight),
            Action("Top", () => lineUpChosen(Edge.LeastY, null, TopName), true, "Bring their top edges into line", SvgWriter.ShapeIcon.AlignTop),
            Action("Middle", () => lineUpChosen(Edge.MiddleY, null, MiddleName), true, "Bring them onto one horizontal line through their middles", SvgWriter.ShapeIcon.AlignMiddleY),
            Action("Bottom", () => lineUpChosen(Edge.MostY, null, BottomName), true, "Bring their bottom edges into line", SvgWriter.ShapeIcon.AlignBottom)
        };

        if (DistinctEditable > 2)
        {
            lines.Add(null);

            lines.Add(Action("Space out across", () => lineUpChosen(null, Along.X, AcrossName), true, "Even out the spacing of their middles from left to right", SvgWriter.ShapeIcon.SpaceAcross));
            lines.Add(Action("Space out down", () => lineUpChosen(null, Along.Y, DownName), true, "Even out the spacing of their middles from top to bottom", SvgWriter.ShapeIcon.SpaceDown));
        }

        return lines;
    }

    ///
    ///Puts the clipboard into the cell being edited, under the pointer, chosen, with the Select tool in hand.
    ///
    ///**Where the pointer is**, which is where somebody about to paste is already looking. It used to go a
    ///tenth of its own width down and to the right of where it was copied from - far enough to be visibly a
    ///second shape and no further, which on a layout at the fit could be a copy landing off screen. The
    ///offset survives as the fallback for a paste with no pointer to go to: the keyboard shortcut pressed
    ///before the mouse has ever been over the view, and every headless caller.
    ///
    ///**Chosen afterwards, with Select in hand**, because a paste is the middle of a gesture rather than the
    ///end of one - what follows is almost always dragging the copies somewhere. Landing them unselected with
    ///whatever tool was in hand meant finding them again and picking them out by hand first.
    ///
    ///The tool is taken up *before* the edit: <see cref="pickShapes"/> clears the selection, so switching
    ///afterwards would throw away the very shapes this went to the trouble of choosing.
    ///
    private async Task pasteClipboard()
    {
        if (Gds is null || context is null || clipboard.Count == 0)
            return;

        var structure = structureNamed(context.Structure);

        if (structure is null)
            return;

        var whole = Bounds.Empty;

        foreach (var copied in clipboard)
            whole = whole.Union(Bounds.Of(copied.Points));

        var (dx, dy) = await pasteOffset(whole);

        if (!selecting || moving)
            await startSelecting();

        var added = new List<AddElement>();

        foreach (var copied in clipboard)
        {
            var moved = new List<Element.Point>();

            foreach (var point in copied.Points)
            {
                if (context.ToLocal(point.X + dx, point.Y + dy) is not (double x, double y))
                    return;

                moved.Add(new Element.Point((int)Math.Round(x), (int)Math.Round(y)));
            }

            //A label is a point and a string rather than an outline, and goes in as one - offset by the
            //same step as everything else, so a shape and the label naming it stay together.
            if (copied.Says is string says)
            {
                if (moved.Count > 0)
                    added.Add(new AddElement(Gds, structure, copied.Layer, moved[0], says));

                continue;
            }

            added.Add(new AddElement(Gds, structure, copied.Layer, moved));
        }

        History.Do(new CompoundEdit("Paste", new List<LayoutEdit>(added)));

        //Applied by now, so each one knows the node it made - which is how the copies are found again in a
        //layout that has just been flattened afresh. See drawnFrom.
        await afterEdit(choosing: added.Select(edit => edit.Made).OfType<GDS.ElementModel>().ToList());
    }

    ///
    ///How far the clipboard moves to get where it is being pasted, in the layout's own units.
    ///
    ///The middle of what was copied goes to the pointer rather than a corner of it: a corner means the shape
    ///appears beside the cursor rather than under it, and for a selection of several there is no corner that
    ///is obviously the one being held.
    ///
    ///The fallback is the original behavior, and its size is the reason it was: a tenth of the widest thing
    ///being pasted, so the copy is offset in proportion to itself rather than by a fixed number of units
    ///that is invisible on a chip and enormous on a contact.
    ///
    private async Task<(long X, long Y)> pasteOffset(Bounds whole)
    {
        var at = await js.InvokeAsync<LayoutPoint?>("pointerLayoutPoint");

        if (at is not null && !whole.IsEmpty)
        {
            long middleX = whole.Left + (whole.Width / 2);
            long middleY = whole.Bottom + (whole.Height / 2);

            return ((long)Math.Round(at.X) - middleX, (long)Math.Round(at.Y) - middleY);
        }

        long step = Math.Max(1, Math.Max(whole.Width, whole.Height) / 10);

        return (step, step);
    }

    ///
    ///One copied element: its layer, its points in the layout's coordinates, and what it says if it is a
    ///label.
    ///
    ///**Labels are carried because Cut has to give back everything it takes.** They used not to be - Copy
    ///quietly skipped them - which was survivable while copying left the original where it was, and stopped
    ///being survivable the moment there was a Cut: a selection of a shape and its label would have come back
    ///from a paste as the shape alone, with the label gone and nothing holding it.
    ///
    private sealed record Copied(LayerKey Layer, List<Element.Point> Points, string? Says = null);

    ///<summary>
    ///What was last copied. Not saved into a session, and not shared between views - a clipboard is
    ///something you are in the middle of doing.
    ///</summary>
    private List<Copied> clipboard = new List<Copied>();

    private async Task undo()
    {
        if (History.Undo())
            await afterEdit();
    }

    ///
    ///What follows a change made from outside this view - the assistant's - which went onto the same history.
    ///
    ///Everything an edit made here is followed by, through the same method, with the shapes it made picked out: the
    ///way a paste leaves what it pasted chosen, so what the assistant just drew is the thing a press of Delete or a
    ///drag would act on.
    ///
    public async Task AfterOutsideEdit(IReadOnlyCollection<GDS.ElementModel> made)
    {
        await afterEdit(false, made);
    }

    private async Task redo()
    {
        if (History.Redo())
            await afterEdit();
    }

    ///
    ///What every edit has to do afterwards.
    ///
    ///The hierarchy is resolved again, because an edit is the one thing that changes it - which is also
    ///why flattenedFrom is left alone: the file is the same object, and clearing it would make the next
    ///ordinary redraw resolve everything a second time for nothing.
    ///
    ///The selection goes. It pointed at an element of the old layout, and the same shape in the new one is
    ///a different object at a different index.
    ///
    ///
    ///`choosing` is for the edits that *add*, where keepChosen cannot help: the indexes it would hold on to
    ///name whatever the new shapes pushed along. Named by their library nodes instead, which the flatten
    ///below carries onto the elements it builds, so the shapes just made are the ones picked out.
    ///
    private async Task afterEdit(bool keepChosen = false, IReadOnlyCollection<GDS.ElementModel>? choosing = null)
    {
        if (Gds is null)
            return;

        var reshaped = changedInPlace();

        //An edit changes the library in place, so the tree it was built from is the same object with
        //different contents - which nothing but a stamp can notice. See treeRows, and treeStillSays for the
        //edits that leave every row as it was.
        if (!treeStillSays(reshaped))
            treeChanged();

        //And the cells it draws when a row is pointed at were drawn from the file as it was. See forgetCellPreviews.
        forgetCellPreviews();

        //
        //**Only the shapes the edit changed are drawn again, when that is all it did.** A move, a corner, a
        //turn, a layer or a label changes those elements and nothing else, and flattening the whole library
        //to find that out was most of what an edit cost on a real chip. See GdsFlattener.Reflatten - and
        //anything else, or anything it is not sure of, is flattened again as it always was.
        //
        var before = layout;
        var after = reflattened(reshaped);

        //
        //**And the cell's placements are not counted again.** A layout worked out from the one before it has
        //the same elements from the same placements, only some of them drawn again where they were, so the
        //cell being edited is placed exactly as often as it was. Counting walks every element: 38 ms of each
        //corner drop on the RGB mixer. See countPlacements.
        //
        if (after is not null && before is not null && ReferenceEquals(placementsCountedIn, before))
            placementsCountedIn = after;

        layout = after ?? GdsFlattener.Flatten(Gds);
        flattenedAt = History.Version;

        //
        //**Kept for the edits that leave every element where it was in the file.**
        //
        //A move, a corner drag and a turn all change coordinates and nothing else, so the flattener produces
        //the same elements in the same order and the indexes still name the same shapes. Anything that adds
        //or removes one shifts what comes after it, and holding on to an index across that would highlight
        //a shape nobody chose.
        //
        //Worth keeping because two of these in a row is one gesture: turning something a half turn is two
        //presses of the same button, and having to find the shape again in between is not that.
        //
        //
        //**Before keepChosen, because an add is the case keepChosen is written not to handle.** The two are
        //never both asked for, and if they ever were, naming the shapes is the answer that survives the
        //indexes having moved.
        //
        if (choosing is not null && choosing.Count > 0)
        {
            chosenIndexes = drawnFrom(choosing);

            remarkChosen = chosenIndexes.Count > 0;
        }
        else if (keepChosen && chosenIndexes.Count > 0)
        {
            remarkChosen = true;
        }
        else
        {
            chosenIndexes = new List<int>();

            await js.InvokeVoidAsync("clearSelection");
        }

        //
        //**One redraw, and the shell's is the one worth having.**
        //
        //This used to draw here and then tell the shell, which rebuilt the layer list and called back into
        //Render - so every edit built the whole SVG twice and handed the browser two documents to parse. At
        //twenty thousand elements that was most of the 8.4 seconds an edit took.
        //
        //The shell's pass is the one to keep, because it comes *after* getLayers: an edit can put a shape on
        //a layer the file did not have, and this view's own copy of the layer list does not know about it
        //yet. Drawing here first showed the file for an instant without the new shape on it.
        //
        //Only when something is listening, though. Nothing else builds this component today, but a view that
        //quietly stopped drawing because nobody wired an event up is a bad way to find that out.
        //
        if (!OnFileChanged.HasDelegate)
        {
            redraw();

            return;
        }

        //The file has changed, so the shell has to know: the text view reads the same records, and a
        //session that did not carry the edit would lose it.
        await OnFileChanged.InvokeAsync();
    }

    ///
    ///The elements the step just taken changed in place, or null when it did anything else.
    ///
    ///**Exactly one step since the layout was last worked out**, which is what makes the step's own word on
    ///what it changed the whole truth. Two steps, a Clear, or a restored stack, and this is null - so the view
    ///flattens, and builds the tree again.
    ///
    private IReadOnlyCollection<GDS.ElementModel>? changedInPlace()
    {
        if (History.Version != flattenedAt + 1)
            return null;

        return History.LastStep?.Reshaped;
    }

    ///
    ///The layout after the step just taken, worked out from the one on screen - or null when it has to be
    ///flattened again. See changedInPlace.
    ///
    private FlattenedLayout? reflattened(IReadOnlyCollection<GDS.ElementModel>? reshaped)
    {
        if (layout is null || Gds is null)
            return null;

        return GdsFlattener.Reflatten(layout, Gds, reshaped);
    }

    ///
    ///Whether the tree's rows still say what they said before the step just taken, so they need not be built
    ///and drawn again.
    ///
    ///**A move, a corner, a turn or a label retyped changes no row but the shape's own.** The cells, what each
    ///one places, the layers it draws on and how many shapes are on each are all as they were - which is
    ///everything the tree shows until a layer is opened, and an opened layer lists its shapes by where they
    ///start or what they say. So the rows stay, unless one of them is a shape the step changed - or a placement,
    ///whose row says where it is.
    ///
    ///Drawing them again was most of what an edit cost on a real library. On the RGB mixer it was 270 ms of
    ///the 450 ms a corner drop froze the page for, every one of 1,246 rows drawn to say what it said before.
    ///
    private bool treeStillSays(IReadOnlyCollection<GDS.ElementModel>? reshaped)
    {
        if (reshaped is null || History.LastStep is not LayoutEdit step || !step.KeepsLayers)
            return false;

        if (treeCache is null || !ReferenceEquals(treeCacheFor, Gds))
            return false;

        var changed = new HashSet<GDS.ElementModel>(reshaped);

        foreach (var row in treeCache)
        {
            if (row.Shape is not null && changed.Contains(row.Shape))
                return false;

            //A placement's row says where it is, and every row under it says where it draws - so it moving is
            //all of those changing. They are under its row, so its row is the one to ask about.
            if (row.Placement is not null && changed.Contains(row.Placement))
                return false;
        }

        return true;
    }

    ///<summary>Which step of the history the layout on screen was worked out after. See reflattened.</summary>
    private int flattenedAt = -1;

    ///
    ///Where the given library elements ended up in the drawn layout.
    ///
    ///By reference, not by coordinates. Pasting on top of what was copied makes two shapes with the same
    ///corners on the same layer, and there is nothing in the geometry to tell the copy from the original -
    ///so a search by outline would pick one of the two at random and leave the other unmarked.
    ///
    ///**One drawn shape per model, not all of them.** A cell placed three times draws everything in it three
    ///times, so adding one element to it puts three shapes on screen. The one in the instance being looked
    ///through is the one a click would have landed on - see CellContext.IsLookingThrough - and the other two
    ///are the ones that move with it, which the view already says by drawing them faded. Marking all three
    ///as chosen would claim a selection of three where there is one thing to move.
    ///
    private List<int> drawnFrom(IReadOnlyCollection<GDS.ElementModel> models)
    {
        var found = new List<int>();

        if (layout is null)
            return found;

        var wanted = new HashSet<GDS.ElementModel>(models);

        for (int i = 0; i < layout.Elements.Count; i++)
        {
            var element = layout.Elements[i];

            if (element.Source is not ElementSource source || !wanted.Contains(source.Model))
                continue;

            if (context is not null && !context.IsLookingThrough(element))
                continue;

            found.Add(i);
        }

        return found;
    }

    ///<summary>The box around what is chosen, measured with the same code as any other layout's.</summary>
    private Bounds chosenBounds()
    {
        return Measure.BoundsOf(layoutOf(Chosen));
    }

    ///<summary>
    ///One shape's area, in square database units and in square microns when the file gives a scale.
    ///</summary>
    private string describeArea(Element shape)
    {
        double area = Measure.AreaOf(shape.Points);

        if (micronsPerUnit() is not double microns)
            return FormattableString.Invariant($"{area:N0} sq units");

        return FormattableString.Invariant($"{area:N0} sq units ({area * microns * microns:0.####} sq µm)");
    }

    ///<summary>Switches the pointer to dragging out rectangles into the cell being edited.</summary>
    private async Task startDrawingShapes()
    {
        //
        //**Refused out loud.** A new shape has to go in a cell, and outside one this returned and left no
        //trace: the button is disabled, so a click does nothing visible, and the D shortcut does not go
        //near the button at all - it called straight in here and stopped. What that looks like from the
        //outside is a drawing tool that draws nothing, which is indistinguishable from a broken one.
        //
        //Said where the drawing hints are said, because it is about the gesture that was just attempted,
        //and it names the way out rather than only the rule.
        //
        if (context is null)
        {
            drawRefusal = NoCellToDrawInto;

            //Asked for, because the keyboard is one of the two ways in and it does not render by itself:
            //OnShortcut is called from JS, and a [JSInvokable] does not re-render the way an @onclick does.
            //Without this the button said it and the D key still went quiet, which is the half that was
            //reported.
            StateHasChanged();

            return;
        }

        drawRefusal = "";

        await emptyHand();

        var layers = drawableLayers();

        //
        //**The layer of the shapes chosen with the select tool, when they are all on one** - asked for 2026-10-19:
        //picking out a met1 shape and then taking the pen meant met1, and the pen opened on the first layer the file
        //has. Shapes on several layers say nothing about which one is meant, and leave the layer as it was.
        //
        var chosenOn = ChosenByLayer().Keys.ToList();

        if (chosenOn.Count == 1 && layers.Any(layer => layer.Key.Equals(chosenOn[0])))
            drawOn = chosenOn[0];

        measuring = false;
        selecting = false;
        moving = false;
        drawingShapes = true;
        chosenIndexes = new List<int>();

        //The first layer the file has, unless something already chosen is still one of them - so switching
        //away from the tool and back does not silently move which layer the next shape lands on.
        if (layers.Count > 0 && !layers.Any(layer => layer.Key.Equals(drawOn)))
            drawOn = layers[0].Key;

        await js.InvokeVoidAsync("stopRuler");
        await js.InvokeVoidAsync("stopSelecting");

        drawHandle ??= DotNetObjectReference.Create(this);

        await js.InvokeVoidAsync("startDrawing", drawHandle, drawMode(), ellipseSides, pathWidthUnits());

        await toolChosen();
    }

    ///<summary>Switches which shape a drag or a run of clicks makes, letting go of whatever was in hand - see emptyHand.</summary>
    private async Task useShape(DrawShape shape)
    {
        await emptyHand();

        drawShape = shape;

        //The question has been answered, so the menu goes. It opened to be chosen from, and a menu that
        //stayed up afterwards would sit over the layout waiting to be dismissed by a press that had already
        //been given - the pencil brings it back if the answer was the wrong one.
        shapeMenuOpen = false;

        await js.InvokeVoidAsync("setDrawMode", drawMode(), ellipseSides, pathWidthUnits());

        await OnToolChanged.InvokeAsync();
    }

    private string drawMode()
    {
        if (drawShape == DrawShape.Polygon)
            return "poly";

        if (drawShape == DrawShape.Ellipse)
            return "ellipse";

        if (drawShape == DrawShape.Label)
            return "text";

        if (drawShape == DrawShape.Writing)
            return "writing";

        if (drawShape == DrawShape.Path)
            return "path";

        return "rect";
    }

    ///<summary>
    ///How wide a path drawn from now on is, in microns - which is what a width is, everywhere anybody talks
    ///about one. The file's own units are a nanometer on most files and nobody routes by counting those.
    ///</summary>
    private double pathWidthMicrons = 0;

    private Paths.Ends pathEnds = Paths.Ends.Flush;

    ///<summary>
    ///The same width in the file's units, which is what both the record and the preview need.
    ///
    ///A file that says nothing usable about its scale is taken at one unit to the micron rather than being
    ///refused - the same choice the grid makes, and for the same reason: a width somebody typed should put
    ///*something* down.
    ///</summary>
    private int pathWidthUnits()
    {
        if (micronsPerUnit() is not double microns || microns <= 0)
            return (int)Math.Round(pathWidthMicrons);

        return (int)Math.Round(pathWidthMicrons / microns);
    }

    ///<summary>
    ///Changed while a path may be half drawn, so the preview widens rather than being thrown away - which is
    ///why this does not go through setDrawMode, whose job is to start a different shape.
    ///</summary>
    private async Task changePathWidth(ChangeEventArgs e)
    {
        if (SvgWriter.TryParseNumber(e.Value?.ToString(), out double given) && given >= 0)
            pathWidthMicrons = given;

        await js.InvokeVoidAsync("setPathWidth", pathWidthUnits());

        await OnToolChanged.InvokeAsync();
    }

    private async Task changePathEnds(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out Paths.Ends given))
            pathEnds = given;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///The one chosen path the cell being edited holds, with what it is currently drawn with.
    ///
    ///One at a time, because a width belongs to an element rather than to a selection - two paths of
    ///different widths would have to show one number, and a number that is only true of half of what is
    ///chosen is worse than no box at all.
    ///
    private (GDS.StructureModel Structure, GDS.ElementModel Model, int Width, Paths.Ends Ends)? chosenPath()
    {
        if (Editable.Count != 1 || Only is not Element one || one.Source is not ElementSource source)
            return null;

        if (structureNamed(source.Structure) is not GDS.StructureModel structure)
            return null;

        if (Paths.Of(source.Model) is not (int width, Paths.Ends ends))
            return null;

        return (structure, source.Model, width, ends);
    }

    private async Task changeChosenPathWidth(ChangeEventArgs e)
    {
        if (chosenPath() is not (GDS.StructureModel _, GDS.ElementModel _, int _, Paths.Ends ends))
            return;

        if (!SvgWriter.TryParseNumber(e.Value?.ToString(), out double microns) || microns < 0)
            return;

        double perUnit = 1;

        if (micronsPerUnit() is double scale && scale > 0)
            perUnit = scale;

        await rewritePath((int)Math.Round(microns / perUnit), ends, "Path width");
    }

    private async Task changeChosenPathEnds(ChangeEventArgs e)
    {
        if (chosenPath() is not (GDS.StructureModel _, GDS.ElementModel _, int width, Paths.Ends _))
            return;

        if (!Enum.TryParse(e.Value?.ToString(), out Paths.Ends given))
            return;

        await rewritePath(width, given, "Path ends");
    }

    ///
    ///Writes a chosen path's width and ends, as one step.
    ///
    ///**Rebuilt rather than changed in place**, because a path with no WIDTH record has to grow one - see
    ///<see cref="Paths.Rewritten"/>. Back at the same index, so what is chosen afterwards is still the path
    ///that was just changed and the next change lands on the same element.
    ///
    private async Task rewritePath(int width, Paths.Ends ends, string named)
    {
        if (Gds is null || chosenPath() is not (GDS.StructureModel structure, GDS.ElementModel model, int was, Paths.Ends had))
            return;

        //Nothing asked for. A change event fires when focus leaves a box that was only looked at, and an
        //undo step for a number nobody altered is a step somebody has to press past.
        if (width == was && ends == had)
            return;

        if (recordsOf(model) is not List<GDS.Record> span)
            return;

        if (Paths.Rewritten(span, width, ends) is not List<GDS.Record> rebuilt)
            return;

        int index = structure.Elements.IndexOf(model);

        if (index < 0)
            return;

        History.Do(new CompoundEdit(named, new List<LayoutEdit>
        {
            new DeleteElement(Gds, structure, model),
            new AddElement(Gds, structure, index, rebuilt, named)
        }));

        await afterEdit(keepChosen: true);
    }

    ///
    ///A path clicked out point by point, arriving as one flat run of x and y in the layout's coordinates.
    ///
    ///**A centerline, not an outline.** What goes into the file is the line down the middle plus a width, so
    ///two points is a legitimate path where two corners would be a polygon with no area - which is the one
    ///place this differs from <see cref="OnPolygonDrawn"/> on the way in. The exception is a path the deck's
    ///grid cannot hold while snapping, which goes in as its outline.
    ///
    [JSInvokable]
    public async Task OnPathDrawn(double[] coordinates)
    {
        if (Gds is null || context is null || coordinates.Length < 4)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var along = new List<Element.Point>();

        for (int i = 0; i + 1 < coordinates.Length; i += 2)
        {
            //Each point brought back through the placement on its own, so a path drawn onto a cell that is
            //turned comes out turned with it rather than square to the cell and skewed on screen.
            if (context.ToLocal(coordinates[i], coordinates[i + 1]) is not (double localX, double localY))
                return;

            along.Add(new Element.Point((int)Math.Round(localX), (int)Math.Round(localY)));
        }

        int width = pathWidthUnits();

        if (Paths.Records(drawOn, along, width, pathEnds) is null)
            return;

        //A new gesture, so whatever the last one was refused for is not this one's reason.
        drawRefusal = "";

        //
        //**A path's outline is worked out, not placed**, so while snapping it goes on the deck's grid - see
        //deckGrid. The check reads a path by its outline, half the width either side of every corner, and along a
        //slanted run or round an end that lands between grid points wherever the points are. Such a path is drawn
        //as its outline, a polygon on the grid, as the assistant's draw_path draws one - see Grid.PathOutlineOff.
        //A wire that comes back within its own width of itself stays a path, since no one polygon is its outline.
        //
        int grid = deckGrid(drawOn);

        if (Grid.PathOutlineOff(along, width, pathEnds, grid) is (List<Element.Point> outline, string parts))
        {
            if (Grid.Crossing(outline) is not null)
            {
                drawRefusal = $"Kept a path: it comes back over itself, and no one polygon is the outline of a wire that does - so its outline is off {deckGridSaid(drawOn)} along its {parts}.";
            }
            else
            {
                var polygon = Grid.Snap(outline, grid);

                if (notAShape(polygon))
                {
                    drawRefusal = $"Too narrow for {deckGridSaid(drawOn)}: put on it, its outline comes out flat or crossing itself. Draw it wider, or turn snapping off.";

                    //Called from the browser, which does not redraw the way a press does.
                    StateHasChanged();

                    return;
                }

                //Named for the tool it was drawn with, which is what the undo button should say it takes back.
                History.Do(new CompoundEdit("Draw path", new List<LayoutEdit> { new AddElement(Gds, structure, drawOn, polygon) }));

                drawRefusal = $"Drawn as a polygon on {deckGridSaid(drawOn)}: along its {parts}, a path's outline lands between grid points. Turn snapping off to draw a path.";

                await afterEdit();

                return;
            }
        }

        History.Do(new AddElement(Gds, structure, drawOn, along, width, pathEnds));

        await afterEdit();
    }

    ///
    ///A label placed at a point in the layout's coordinates, and opened for typing where it landed.
    ///
    ///Brought into the cell the same way a corner is, so a label placed on a cell that is turned lands where
    ///it was clicked rather than wherever that point maps to unturned.
    ///
    ///**It says something before it is typed.** A label goes down reading "label" and the box opens over it
    ///with that selected, so the first keystroke replaces it. Placing an empty one and typing into nothing
    ///would mean an element that is invisible in every view for as long as the box is open - and if the box
    ///were abandoned, one that could only be found by reading the records.
    ///
    [JSInvokable]
    public async Task OnLabelPlaced(double x, double y)
    {
        if (Gds is null || context is null)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        if (context.ToLocal(x, y) is not (double localX, double localY))
            return;

        var at = new Element.Point((int)Math.Round(localX), (int)Math.Round(localY));

        var placing = new AddElement(Gds, structure, drawOn, at, DefaultLabel);

        History.Do(placing);

        justPlaced = (structure, drawOn, at);

        await afterEdit();

        //Opened from here, inside the event, rather than from OnAfterRenderAsync. The box is put where the
        //label is *drawn*, and that node is not in the page yet - so `labelBox` waits for it on the browser
        //side. Asking from a render callback instead left the answer in a continuation whose re-render was
        //sometimes never flushed, and the box just never appeared: a race that only showed itself once a
        //probe's own awaits were taken back out.
        await openRetype(placedLabel(at, DefaultLabel), DefaultLabel);
    }

    ///
    ///What it took to place the label the open box belongs to, when that box belongs to one just placed.
    ///
    ///Kept so that naming it is one step on the undo stack rather than two. A label is put down and then
    ///typed, which is two edits; but it is one gesture, and somebody who has placed a label once should not
    ///have to press undo twice to be rid of it - the same rule joining a drawn shape follows.
    ///
    ///Null whenever the box was opened on a label that was already there, where retyping genuinely is its
    ///own edit on something that existed before.
    ///
    private (GDS.StructureModel Structure, LayerKey Layer, Element.Point At)? justPlaced = null;

    ///
    ///Where a label just placed ended up in the flattened layout, or minus one when it cannot be found.
    ///
    ///**By where it is and what it says, not by which object it is.** An index kept from before the edit
    ///names something else afterwards, since adding an element shifts everything after it - and the model
    ///is no better, because an edit hands the shell a library and what comes back is not guaranteed to be
    ///the same objects. A point and a string are the same either side of all of that.
    ///
    ///The last match wins, and the one instance being looked through rather than merely one of the cell's:
    ///a cell placed three times draws its label three times, and the box goes over the copy that was
    ///clicked. Two labels at one point saying one thing are on top of each other, so either will do.
    ///
    private int placedLabel(Element.Point at, string says)
    {
        if (layout is null)
            return -1;

        int found = -1;

        for (int i = 0; i < layout.Elements.Count; i++)
        {
            var element = layout.Elements[i];

            if (element.Text != says)
                continue;

            if (context is not null && !context.IsLookingThrough(element))
                continue;

            if (element.Source?.Model.Element.XY?.Data is not Int4Data xy || xy.Values.Length < 2)
                continue;

            if (xy.Values[0] == at.X && xy.Values[1] == at.Y)
                found = i;
        }

        return found;
    }

    ///
    ///A label double-clicked, which opens the box over it whatever tool is in hand.
    ///
    ///Whatever tool, because retyping a name is not a mode - it is a thing you notice while doing something
    ///else, and having to go and find a tool first is what makes people leave the typo.
    ///
    [JSInvokable]
    public async Task OnLabelRetyped(int index)
    {
        if (layout is null || index < 0 || index >= layout.Elements.Count)
            return;

        if (layout.Elements[index].Text is not string says)
            return;

        //Only where an edit would land. A label in a cell this one is not inside cannot be changed from
        //here, and a box that took the typing and then dropped it would be worse than no box.
        if (context is null || !context.Holds(layout.Elements[index]))
            return;

        //And not on a locked layer, which a click already passes through. A hidden one's labels are not in
        //the page to be double-clicked, so the lock is the case this is for.
        if (!Picking.InReach(layout.Elements[index], reachableLayers()))
            return;

        //This one was already in the file, so keeping what is typed writes a record rather than replacing a
        //placement - and Escape has an old string to put back rather than a placement to take away.
        justPlaced = null;

        await openRetype(index, says);
    }

    ///<summary>Puts the box over the label and hands it the keyboard.</summary>
    private async Task openRetype(int index, string says)
    {
        if (index < 0)
            return;

        if (await js.InvokeAsync<LabelBox?>("labelBox", index) is not LabelBox box)
            return;

        retypingLabel = index;
        retypingText = says;
        retypingWas = says;
        retypingAt = (box.X, box.Y);
        focusRetypeBox = true;

        StateHasChanged();
    }

    ///<summary>Where a label is drawn, in pixels from the corner of the view.</summary>
    private sealed class LabelBox
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void changeRetypedText(ChangeEventArgs e)
    {
        retypingText = e.Value?.ToString() ?? "";
    }

    ///<summary>Enter keeps what is typed, Escape puts back what was there. Both then close the box.</summary>
    private async Task onRetypeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await commitRetype();

            return;
        }

        if (e.Key == "Escape")
            await cancelRetype();
    }

    ///
    ///Closes the box without keeping what was typed.
    ///
    ///For a label that was already there, that is simply putting the old string back - nothing was written.
    ///For one placed a moment ago it means taking the placement back, because what was there before is
    ///nothing, and leaving a label reading "label" behind would be the gesture half-done.
    ///
    private async Task cancelRetype()
    {
        bool placed = justPlaced is not null;

        retypingText = retypingWas;
        retypingLabel = -1;
        justPlaced = null;

        if (!placed)
        {
            StateHasChanged();

            return;
        }

        History.Undo();

        await afterEdit();
    }

    ///
    ///Keeps what was typed.
    ///
    ///**One step on the undo stack, not two.** Placing a label and naming it is one gesture, so naming a
    ///label that was just placed takes the placement back and puts it down again saying the right thing,
    ///rather than writing a second edit over the first. Retyping one that was already there is genuinely its
    ///own edit, and is written as one record - so the label keeps its place in the file, its justification
    ///and its identity.
    ///
    ///An empty box keeps what was there rather than writing nothing. A label with no string is invisible in
    ///every view and could only be found by reading the records, and somebody who cleared the box and
    ///clicked away did not mean to make one disappear - they meant to stop.
    ///
    ///
    ///A press somewhere other than the box keeps what is in it and closes it.
    ///
    ///What `@onblur` used to do, and blur was wrong: the picture is rebuilt on every edit and a rebuild
    ///takes the box's element with it, firing a blur nobody asked for - which closed the box a few
    ///milliseconds after it opened, every time. A pointer going down elsewhere is a person deciding to stop.
    ///
    [JSInvokable]
    public async Task OnRetypeDismissed()
    {
        if (retypingLabel < 0)
            return;

        await commitRetype();
    }

    private async Task commitRetype()
    {
        int index = retypingLabel;
        string says = AddElement.AsAscii(retypingText);
        var placed = justPlaced;

        retypingLabel = -1;
        justPlaced = null;

        if (says.Length == 0 || says == retypingWas)
        {
            StateHasChanged();

            return;
        }

        if (placed is (GDS.StructureModel into, LayerKey layer, Element.Point at))
        {
            if (Gds is null)
                return;

            History.Undo();
            History.Do(new AddElement(Gds, into, layer, at, says));

            await afterEdit();

            return;
        }

        if (index < 0 || layout is null || index >= layout.Elements.Count)
            return;

        if (layout.Elements[index].Source is not ElementSource source)
            return;

        if (structureNamed(source.Structure) is not GDS.StructureModel structure)
            return;

        History.Do(new RetextElement(structure, source.Model, says));

        await afterEdit(keepChosen: true);
    }

    private async Task changeEllipseSides(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int given))
            return;

        ellipseSides = Math.Clamp(given, FewestSides, MostSides);

        await js.InvokeVoidAsync("setDrawMode", drawMode(), ellipseSides, pathWidthUnits());

        await OnToolChanged.InvokeAsync();
        await OnSettingsChanged.InvokeAsync();
    }

    ///<summary>
    ///How far a straight side falls inside the curve it stands in for, as a share of the radius.
    ///
    ///A share rather than a distance, because the count is chosen before anything has been dragged - so the
    ///only honest thing to say about it is one that does not depend on how big the shape turns out to be.
    ///</summary>
    private string sidesDescription()
    {
        double error = 1 - Math.Cos(Math.PI / Math.Max(FewestSides, ellipseSides));

        return FormattableString.Invariant($"Each side falls {error:P2} of the radius inside a true curve");
    }

    private async Task toggleGrid()
    {
        showGrid = !showGrid;

        await applyGrid();
    }

    private async Task toggleSnapping()
    {
        snapping = !snapping;

        await applyGrid();
    }

    private async Task toggleShapeSnap()
    {
        snapToShapes = !snapToShapes;

        await applyGrid();
    }

    ///<summary>
    ///Turns joining on or off. Nothing to hand the browser - the merge happens where the shape is put into
    ///the cell, so only the toolbar and the session need to hear about it.
    ///</summary>
    private async Task toggleJoin()
    {
        joining = !joining;

        await OnToolChanged.InvokeAsync();
        await OnSettingsChanged.InvokeAsync();
    }

    ///<summary>Whether joining means anything for the shape being drawn: only the ones that enclose an area.</summary>
    private static bool joinable(DrawShape shape)
    {
        return shape == DrawShape.Rectangle
            || shape == DrawShape.Polygon
            || shape == DrawShape.Ellipse;
    }

    ///
    ///Whether the tool in hand can bring shapes together, and so whether the switch is worth offering.
    ///
    ///Drawing an area shape, or moving one - a drag with Select does the same thing a drag with Move does.
    ///Pan and Measure move the view rather than anything in it, and a switch shown there would be one whose
    ///scope you had to work out from the tool beside it.
    ///
    private bool joins()
    {
        if (drawingShapes)
            return joinable(drawShape);

        return selecting || moving;
    }

    ///
    ///The pitch the file itself suggests, in microns.
    ///
    ///Its own grid raised by tens until it is worth drawing - see <see cref="Grid.Opening"/>, which is where
    ///the arithmetic and the reasoning live. Here is only the measuring: the longer side of everything the
    ///flattened layout holds.
    ///
    private void openOnFileGrid()
    {
        if (layout is null || layout.Elements.Count == 0)
            return;

        //Out of the layout's index, which a large layout needs for its first picture anyway - this was a walk
        //of every element of its own, on every file opened.
        var extent = layout.Index.Extent;

        //A library of nothing but labels has boxes with no size, and nothing to work a pitch out from.
        if (extent.IsEmpty)
            return;

        long across = Math.Max(extent.Width, extent.Height);

        gridMicrons = Grid.Opening(Gds, across) * (micronsPerUnit() ?? 1);
    }

    private async Task changeGridPitch(ChangeEventArgs e)
    {
        if (!SvgWriter.TryParseNumber(e.Value?.ToString(), out double given))
            return;

        if (given <= 0 || double.IsNaN(given) || double.IsInfinity(given))
            return;

        //Typed, so it is theirs from here on and no file gets to change it back. Saved, so that stays true
        //tomorrow - the alternative is a pitch that quietly reverts the next time a file is opened.
        pitchChosen = true;

        //Read in whatever the box beside it says, and held in microns.
        gridMicrons = given * micronsPer(gridUnit);

        await applyGrid();
    }

    ///
    ///Says the same pitch in a different unit, without moving a line.
    ///
    ///The pitch itself is untouched: only how it is written changes, so a grid at one micron reads 1000 as
    ///soon as nanometers are picked and goes on being a grid at one micron. Still an applyGrid, because the
    ///choice goes into the session and the toolbar has to redraw for the box to show the new number.
    ///
    private async Task changeGridUnit(ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out GridUnit given))
            return;

        gridUnit = given;

        await applyGrid();
    }

    ///<summary>How many microns one of a unit is. A database unit falls back to a micron on a file that cannot say.</summary>
    private double micronsPer(GridUnit unit)
    {
        if (unit == GridUnit.Nanometer)
            return 0.001;

        if (unit == GridUnit.Millimeter)
            return 1000;

        if (unit == GridUnit.DatabaseUnit)
            return micronsPerUnit() ?? 1;

        return 1;
    }

    ///<summary>The pitch as the box shows it, which is the microns it is held in said in the unit that is chosen.</summary>
    private double gridInChosenUnit()
    {
        return gridMicrons / micronsPer(gridUnit);
    }

    ///
    ///How small a number the box will take and what its arrows move by.
    ///
    ///Both move with the unit rather than staying at what suits one of them: a tenth is a sensible nudge in
    ///microns and an absurd one in nanometers, where it is a hundred picometers. Database units are whole
    ///numbers in the file, so a step of one is the only one that means anything.
    ///
    private (string Floor, string Step) gridBox()
    {
        if (gridUnit == GridUnit.Nanometer)
            return ("0.1", "1");

        if (gridUnit == GridUnit.Millimeter)
            return ("0.000001", "0.01");

        if (gridUnit == GridUnit.DatabaseUnit)
            return ("1", "1");

        return ("0.0001", "0.1");
    }

    ///<summary>What a unit is called where there is room for two characters and no more.</summary>
    private static string nameOf(GridUnit unit)
    {
        if (unit == GridUnit.Nanometer)
            return "nm";

        if (unit == GridUnit.Millimeter)
            return "mm";

        if (unit == GridUnit.DatabaseUnit)
            return "database units";

        return "µm";
    }

    ///<summary>
    ///Hands the grid over to the view, and tells the shell so it goes into the session.
    ///
    ///The toolbar is redrawn through OnToolChanged rather than by this component, since the switches live
    ///in a fragment the *shell* renders - the same reason the tool highlight needed one.
    ///</summary>
    private async Task applyGrid()
    {
        await js.InvokeVoidAsync("applyGrid", showGrid, snapping, gridUnits(), snapToShapes);

        await OnToolChanged.InvokeAsync();
        await OnSettingsChanged.InvokeAsync();
    }

    ///<summary>
    ///The grid pitch in the coordinates everything else here is in.
    ///
    ///**Never below one.** GDSII coordinates are whole numbers, so a pitch that rounded to nothing would
    ///snap every point to itself and draw a line at every integer - which at any normal zoom is a solid
    ///color over the whole layout. A file whose UNITS say nothing usable is taken at face value instead:
    ///the number in the box is then database units, which is what the label says.
    ///</summary>
    private double gridUnits()
    {
        if (micronsPerUnit() is not double microns || microns <= 0)
            return Math.Max(1, Math.Round(gridMicrons));

        return Math.Max(1, Math.Round(gridMicrons / microns));
    }

    ///
    ///What the pitch comes to in the file's own units, which is the only place the two meet - and what grid
    ///the file itself was drawn on, which nothing else says.
    ///
    ///**The file's own grid is worth knowing and not worth snapping to.** Nothing in a GDSII file records
    ///it, but it is recoverable: every coordinate divides by it, so the greatest common divisor of the lot
    ///is it. That is a number somebody laying out on this file wants - it is the finest placement the file
    ///is built to - and it belongs in the readout rather than in the pitch, because a grid drawn at five
    ///nanometers is 178 lines across the view and reads as a wash.
    ///
    private string gridDescription()
    {
        string drawnOn = "";
        int pitch = fileGrid();

        if (pitch > 1)
        {
            if (micronsPerUnit() is double each && each > 0)
                drawnOn = FormattableString.Invariant($". This file is drawn on a grid of {pitch * each:0.#####} µm ({pitch} units)");
            else
                drawnOn = FormattableString.Invariant($". This file is drawn on a grid of {pitch} database units");
        }

        if (micronsPerUnit() is not double microns || microns <= 0)
            return $"This file's UNITS record says nothing usable, so the pitch is in database units{drawnOn}";

        //Said the other way round when database units are the unit chosen, or it would read "1000 database
        //units is 1000 database units" and tell nobody anything.
        if (gridUnit == GridUnit.DatabaseUnit)
            return FormattableString.Invariant($"{gridUnits():N0} database units is {gridMicrons:0.####} µm{drawnOn}");

        return FormattableString.Invariant($"{gridInChosenUnit():0.####} {nameOf(gridUnit)} is {gridUnits():N0} database units{drawnOn}");
    }

    ///
    ///The grid the file was drawn on - see Grid.Of - held until the library changes.
    ///
    ///**Held, because the bar asks on every one of its renders.** The grid's tooltip says what the file was
    ///drawn on, and the bar renders with the shell: a tool taken up, a switch flipped, a selection that moves
    ///the sidebar's mark. Worked out each time, that walked every coordinate in the library twice a render -
    ///on the RGB mixer in the dev server, 124 ms of the 134 the shell took to render, and under 1 ms held.
    ///
    ///Keyed on the history's version as well as the file, because an edit changes the library in place:
    ///every step through the history moves the version, and nothing changes the records without a step.
    ///
    private int fileGrid()
    {
        if (fileGridHeld is int held && ReferenceEquals(fileGridFor, Gds) && fileGridAt == History.Version)
            return held;

        int found = Grid.Of(Gds);

        fileGridHeld = found;
        fileGridFor = Gds;
        fileGridAt = History.Version;

        return found;
    }

    private int? fileGridHeld;
    private GDS? fileGridFor;
    private int fileGridAt = -1;

    ///<summary>
    ///Whether the Draw tool is the one in hand.
    ///
    ///Public for the sidebar, which becomes a layer picker while it is - the shell owns that list and has no
    ///other way to know a shape is about to be drawn.
    ///</summary>
    public bool DrawingShapes
    {
        get { return drawingShapes; }
    }

    ///<summary>Which layer a drawn shape goes on, so the sidebar can mark the row it is.</summary>
    public LayerKey DrawOn
    {
        get { return drawOn; }
    }

    ///
    ///How many of the chosen shapes each layer holds, so the sidebar can mark those rows the way it marks the
    ///one being drawn on.
    ///
    ///**Every chosen shape, not only the ones the cell being edited holds.** This says where the shapes are,
    ///not what an edit would act on - that is the question the panel's layer picker answers, and why it asks
    ///Editable. A shape reached through a placed cell is outlined in the view like any other, and it is on a
    ///layer like any other.
    ///
    ///Counted rather than only listed, for the row's tooltip: after a band, "3 of the 40 chosen shapes" says
    ///more than a row lit the same as every other one.
    ///
    public Dictionary<LayerKey, int> ChosenByLayer()
    {
        var counts = new Dictionary<LayerKey, int>();

        foreach (var element in Chosen)
        {
            counts.TryGetValue(element.Layer.Key, out int count);

            counts[element.Layer.Key] = count + 1;
        }

        return counts;
    }

    ///<summary>Whether two counts by layer are the same, layer for layer.</summary>
    private static bool sameCounts(Dictionary<LayerKey, int> one, Dictionary<LayerKey, int> other)
    {
        if (one.Count != other.Count)
            return false;

        foreach (var (key, count) in one)
        {
            if (!other.TryGetValue(key, out int theirs) || theirs != count)
                return false;
        }

        return true;
    }

    ///
    ///Takes a layer as the one to draw on, for a click on its row in the sidebar.
    ///
    ///The same answer as the toolbar's list, reached the other way. The list is where the layer *is*, and
    ///going up to a dropdown to name the one already under the pointer is a detour - so the row is a
    ///control while the Draw tool is out, and the list it always was the rest of the time.
    ///
    ///Only a layer the file has, which is the same set the toolbar offers: this comes from the shell, and a
    ///view should not take a layer number on trust from outside itself.
    ///
    public async Task UseDrawLayer(LayerKey layer)
    {
        if (!drawingShapes || drawOn == layer)
            return;

        if (!drawableLayers().Any(one => one.Key == layer))
            return;

        drawOn = layer;

        //A mark in hand goes down on the layer now chosen, so it is drawn in that layer's colors from here on
        //rather than the last one's.
        if (stamp is not null)
            await js.InvokeVoidAsync("replaceCarried", stampDrawing(), stamp.MiddleX, stamp.MiddleY);

        //And writing or a picture just put down is put down again on it, in place of itself - on its squares as
        //that layer's deck has its grid.
        if (pieceLive() && piece is not null)
            await putPiece(piece with { Layer = layer, Square = onDeckGrid(piece.Square) }, replacing: true);

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///The layers the file already has, in the order the sidebar lists them, less any that are locked.
    ///
    ///**A locked layer is not one to draw on**, for the same reason a click cannot land on it: locking says
    ///this layer is not being worked on. Filtered here rather than at the press, so the one list answers
    ///both questions - which row a press may take (see UseDrawLayer, which asks this) and which layer the
    ///pen opens on (see startDrawingShapes, which asks the same).
    ///
    ///Locked layers only. A hidden one is left in: hiding is about the picture, and the layer somebody is
    ///about to draw a shape onto is a reasonable thing to have out of sight while they place it.
    ///
    private List<Layer> drawableLayers()
    {
        if (Gds is null)
            return new List<Layer>();

        var all = Gds.AdditionalInformation.OrderedLayers().Select(entry => entry.Value);

        if (ShowLayers is null)
            return all.ToList();

        var locked = CheckboxItem.LockedLayers(ShowLayers);

        return all.Where(layer => !locked.Contains(layer.Key)).ToList();
    }

    ///<summary>How many microns one database unit is, from the file's UNITS record, or null when it cannot be read.</summary>
    private double? micronsPerUnit()
    {
        return Gds?.MicronsPerDatabaseUnit;
    }

    ///<summary>Coalesces a drag across the opacity slider; see <see cref="Settling"/>.</summary>
    private readonly Settling settlingOpacity = new Settling();

    ///<summary>
    ///How see-through the shapes are drawn, for the sidebar - which renders the slider now, and has no other
    ///way to read where it should sit.
    ///</summary>
    public float Opacity
    {
        get { return opacity; }
    }

    ///
    ///Sets how see-through the shapes are drawn. Public for the same reason: the slider is in the shell's
    ///sidebar and calls back in here.
    ///
    ///**Settled rather than applied per step.** This is bound `@oninput`, and each step rebuilds the whole
    ///SVG *and* fires OnSettingsChanged - which base64s the library, deflates it and writes it to storage three
    ///times. On a small file that is free and the preview stays live; on anything real it was a drag that took
    ///seconds per notch.
    ///
    public async Task AdjustOpacity(ChangeEventArgs e)
    {
        if (Gds is null)
            return;

        if (ShowLayers is null)
            return;

        if (!SvgWriter.TryParseOpacity(e.Value?.ToString(), out opacity))
            return;

        await settlingOpacity.After(async () =>
        {
            await Render(Gds, ShowLayers);

            await OnSettingsChanged.InvokeAsync();
        });
    }

    ///<summary>
    ///This view's own controls. The pan and zoom are not saved; see the known gaps.
    ///
    ///The grid is here and the tool is not, which is the line between the two: a pitch is something about
    ///how you work on this file and worth coming back to, where a tool is what your hand is doing right now
    ///and coming back to a layout already in a mode you have forgotten choosing is its own small puzzle.
    ///</summary>
    public void WriteSettings(SavedSession session)
    {
        session.Opacity = opacity;
        session.ShowGrid = showGrid;
        session.SnapToGrid = snapping;
        session.SnapToShapes = snapToShapes;
        session.GridMicrons = gridMicrons;
        session.GridUnit = gridUnit.ToString();
        session.PitchChosen = pitchChosen;
        session.Joining = joining;
        session.EllipseSides = ellipseSides;

        session.PathWidthMicrons = pathWidthMicrons;
        session.PathEnds = pathEnds.ToString();
        session.View2DBox = viewBoxSeen;
        session.EditingCell = context?.Structure ?? "";
        session.Tool = toolInUse();
        session.CellActions = cellActionsOpen;
    }

    public async Task ApplySettings(SavedSession session)
    {
        opacity = session.Opacity;
        showGrid = session.ShowGrid;
        snapping = session.SnapToGrid;
        snapToShapes = session.SnapToShapes;
        joining = session.Joining;

        //
        //Guarded, because a session is a file on a disk somebody else may have written. A negative pitch or
        //one that is not a number at all is refused; zero is not, because zero is what "follow the file"
        //is written as - and a session saved before there was such a thing carries the one micron it was
        //using, which keeps that person's grid where they left it.
        //
        if (session.GridMicrons > 0 && !double.IsNaN(session.GridMicrons) && !double.IsInfinity(session.GridMicrons))
            gridMicrons = session.GridMicrons;

        //Whether the pitch above is theirs or the file's, which decides if the next file may change it.
        pitchChosen = session.PitchChosen;

        //Both held rather than applied: the file has to be flattened before there is a cell to enter, and
        //the drawing has to be in the page before there is anything to look at. See the end of
        //OnAfterRenderAsync, where the pair of them land.
        viewBoxToRestore = session.View2DBox;
        cellToRestore = session.EditingCell;
        toolToRestore = session.Tool;

        //Straight in: it is a bool on a bar that is only drawn when there is a context, and entering the
        //cell below is what puts that bar back.
        cellActionsOpen = session.CellActions;


        //So putting the tool back is not itself a change worth writing.
        toolSaved = "Pan";

        if (session.Tool.Length > 0)
            toolSaved = session.Tool;

        //Only how the pitch is written, so a name this build does not know costs the unit and not the pitch.
        if (Enum.TryParse(session.GridUnit, out GridUnit savedUnit))
            gridUnit = savedUnit;

        //Clamped rather than guarded, for the same reason: a session is a file on a disk somebody else may
        //have written, and two sides is not a shape.
        ellipseSides = Math.Clamp(session.EllipseSides, FewestSides, MostSides);

        //Guarded the same way, and for the same reason: a negative width is not a path, and a name this build
        //does not know is a session written by a later one.
        if (session.PathWidthMicrons >= 0 && !double.IsNaN(session.PathWidthMicrons) && !double.IsInfinity(session.PathWidthMicrons))
            pathWidthMicrons = session.PathWidthMicrons;

        if (Enum.TryParse(session.PathEnds, out Paths.Ends savedEnds))
            pathEnds = savedEnds;

        await js.InvokeVoidAsync("applyGrid", showGrid, snapping, gridUnits(), snapToShapes);

        //The switches live in a fragment the *shell* renders, so restoring the values behind them is not
        //enough to make them look pressed - the same reason the tool highlight needed this. Without it a
        //grid came back drawn over the layout with both its switches showing off.
        await OnToolChanged.InvokeAsync();
    }

    public async Task Render(GDS? gds, List<CheckboxItem>? showLayers, FlattenedLayout? prepared = null)
    {
        //Save if needed for re-render on opacity change.
        if (gds is not null)
            this.Gds = gds;

        if (showLayers is not null)
            this.ShowLayers = showLayers;


        if (Gds is null || ShowLayers is null)
            return;

        //
        //Resolving the hierarchy depends only on the file, so it is done once per file.
        //
        //**Against the file itself, not against whether one was passed.** Every caller here passes the
        //current one - AdjustOpacity hands over the field it already has - so a check for "was a file
        //given" was true on every opacity step, and the whole hierarchy was being resolved again for a
        //change that moves no geometry. It also threw away the cell being edited each time, which is what
        //made it visible: dragging the slider dropped you out of the cell you were in.
        //
        if (Gds is not null && !ReferenceEquals(Gds, flattenedFrom))
        {
            //The shell flattened it as it opened the file, so a second pass here would be the same work
            //twice - and is what made a 2D to 3D and back again cost a flatten each way. See IRenderable.
            layout = prepared ?? GdsFlattener.Flatten(Gds);
            flattenedFrom = Gds;
            flattenedAt = History.Version;

            //A file whose first picture the shell is waiting on - see OnDrawn.
            announceDrawn = true;

            //
            //And the load it is waiting as part of, whose pace that picture is drawn at - see drawFirstPicture. One
            //still being written for the last file is let go of, with whatever was owed to it: it is a picture of
            //a file no longer open, and this one's draw is below.
            //
            firstPicturePace = Loading?.Invoke();
            firstPicture = null;
            redrawOwed = false;

            //Pictures of the last file's cells, which may share names with this one's. See forgetCellPreviews.
            forgetCellPreviews();

            //A different file, so whatever cell was being edited is not in it. The undo stack is *not*
            //cleared here: it belongs to the shell now, which knows the difference between a different file
            //and this view being built for the second time - and this cannot tell the two apart, since a
            //view that has just been created has never flattened anything.
            context = null;

            //
            //And straight into its own top cell, which is where anything added to it has to go.
            //
            //**Because a file has to be in a cell before it can be drawn into**, and nothing on screen said
            //so: the view opened outside every cell, a state with no picture of its own - it looked
            //identical, and all it changed was that Draw sat disabled and its shortcut did nothing at all.
            //A top is a cell nothing places, so it is what the flattener draws on its own account and what
            //the picker previews: the thing the file is about, and where somebody already thinks they are.
            //
            //Only where there is exactly one. A library with several tops has no cell that "the top cell"
            //names, and choosing one would be answering a question nobody asked - so those open outside a
            //cell as before, and Draw says why when it is pressed. See startDrawingShapes.
            //
            //**Here rather than after the render, and by assignment rather than through useContext.**
            //Entering a cell redraws, and a redraw at that point rebuilt the markup after ApplySettings had
            //appended the grid to it - so an embed asking for `grid=true` lost its grid until whatever
            //render came next, which is a race an embed has no reason to run. Set before the first markup
            //is built there is no second render to lose anything to, and everything else useContext does
            //for a *change* of cell - clearing the selection, redrawing, saving - is either already
            //happening below or is about a file that was open before this one.
            //
            //A session that named a cell still wins: OnAfterRenderAsync restores it over the top.
            //
            if (onlyTopCell() is string top)
                context = contextOf(top);

            //And it is somewhere else, and probably some other size. See fitToDrawing.
            refit = true;

            //And a large one is framed before anything is drawn of it. See waitingForFit.
            waitingForFit = layout.Elements.Count > CullAbove;

            //And it is drawn on some other grid, so the pitch is worked out again for it - unless somebody
            //has typed one, which makes it theirs and not the file's. See Grid.Opening.
            if (!pitchChosen)
                openOnFileGrid();
        }

        if (layout is null)
            return;

        //
        //Every shape is about to be replaced, so the one that was picked out is not there any more - and
        //neither is the node JS was holding to keep it highlighted. Both let go rather than left pointing
        //at something that is gone.
        //
        //**Unless an edit is carrying its selection across this redraw.** An edit reaches here too: it tells
        //the shell the file changed, and the shell renders every view. So a turn that had just gone to the
        //trouble of keeping what was chosen had it dropped again one call later, and the buttons that do the
        //turning went with it - which made turning something twice impossible.
        //
        if (!remarkChosen)
        {
            chosenIndexes = new List<int>();

            await js.InvokeVoidAsync("clearSelection");
        }

        redraw();
    }

    ///<summary>
    ///Lets go of the handle JS holds.
    ///
    ///A DotNetObjectReference pins the component on the managed side until it is disposed, so leaving the
    ///view without releasing it keeps this instance - and the whole flattened layout it holds - alive for
    ///as long as the tab is open.
    ///</summary>
    public void Dispose()
    {
        selectionHandle?.Dispose();
        selectionHandle = null;

        drawHandle?.Dispose();
        drawHandle = null;

        //The keyboard listener outlives this component - it is on the window - so it checks that the view is
        //still in the page before it reaches for this. Released here all the same, since a handle nothing can
        //call is a handle that should not be pinning the component.
        keyHandle?.Dispose();
        keyHandle = null;
    }

    #endregion ***********************************************
}
