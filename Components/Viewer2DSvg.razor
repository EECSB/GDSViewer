@using System.Globalization;
@using System.Text;

@using GdsII;
@using GDSViewer.Models;

@using Layer = GdsII.Layer;
@using Point = GdsII.Element.Point;
@using static GdsII.GDS.Record;

@inject IJSRuntime js;

@implements IDisposable

@*
    The opacity slider used to be here, as an overlay across the top of the view. It is under the layer list
    now - see the sidebar in Pages/Viewer - because it is a property of how the layers are drawn and it was
    sitting on top of the very thing it dims, which is a control you have to look past to see its effect.
*@
<div id="svgWrapper" class="viewWrapper">
    @*
        The drawing, and everything drawn over it.

        **A box of its own, because the wrapper stopped being the drawing.** The bar above the view, the
        selection panel, the readout and the view's own buttons are placed against their nearest
        positioned ancestor - which was the wrapper, and was the same box as the canvas until a sidebar
        became a column inside it. After that the wrapper was the tree *plus* the drawing: the bar
        centered on the pair and so sat over the panel, and the panel started at the tree's own left edge.

        One box around the canvas puts every one of them back where it belongs, and none of them has to
        know a sidebar exists.
    *@
    <div class="viewCanvas">
        @*
            The frame rate, while Debug info is on in the settings. Empty here: frameMeter.js fills it, so
            nothing that measures how fast the view draws makes it draw anything more. First in the canvas,
            so the selection panel can step down below it - see .frameMeter in app.css.
        *@
        @if (DebugInfo)
        {
            <div id="frameMeter" class="frameMeter" aria-hidden="true"></div>
        }

        @*
            Which cell is being edited, and the way back out.

            Every level is a button rather than only the last, because a chain three deep is climbed by
            picking the level you want and not by pressing "up" until you arrive somewhere familiar.
        *@
        @if (context is not null)
        {
            <div id="contextBar" class="contextBar">
                <button class="buttonStyle2 smallButton contextCrumb" @onclick="leaveCell"
                        title="Stop editing and look at the whole layout again">All</button>

                @for (int level = 0; level < context.Levels.Count; level++)
                {
                    int at = level;

                    <span class="contextArrow">&rsaquo;</span>

                    <button class="buttonStyle2 smallButton contextCrumb @(at == context.Depth ? "contextCrumbOn" : "")"
                            @onclick="() => enterLevel(at)"
                            title="Edit this cell">@context.Levels[at].Structure</button>
                }

                @*
                    How many times the cell is placed, not how many shapes are in it. The first is the
                    multiplier on an edit and the reason to say anything at all; the second is a fact about
                    the cell that nobody needs while working in it - and reading "21 instances" off a flat
                    file with 21 shapes in one structure is how the difference showed itself.
                *@
                @if (placements > 1)
                {
                    <span class="contextCount" title="How many times this cell is placed. An edit moves all of them">
                        placed @placements times
                    </span>
                }

                @*
                    What is in hand, while something is.

                    Placing was four controls on this bar - a dropdown, an angle, a mirrored checkbox and a
                    button - and the instance landed at the middle of the view rather than anywhere chosen.
                    It is a cell picked up from the tree and put down where you click now, so all that is
                    left to say here is which one, and how to stop. See carryCell.
                *@
                @if (carrying.Length > 0)
                {
                    <span id="carryingCell" class="contextCarrying"
                          title="Click where it should go. Ctrl+R turns it, Ctrl+M mirrors it, Esc puts it back">
                        placing @carrying &mdash; Ctrl+R turns, Esc stops
                    </span>
                }
                else if (stamp is not null)
                {
                    @*The same line for a mark in hand, which is carried the same way. See carryMark.*@
                    <span id="carryingStamp" class="contextCarrying"
                          title="Click where it should go, on the layer being drawn on. Ctrl+R turns it, Ctrl+M mirrors it, Esc puts it back">
                        placing @stamp.Says &mdash; Ctrl+R turns, Esc stops
                    </span>
                }
                else if (piece is not null)
                {
                    @*Writing or a picture just put down, while its frame is up - see Piece.*@
                    <span id="pieceHint" class="contextCarrying"
                          title="Drag the frame's corner to size it and its middle to move it. R turns it a quarter to the right and Shift+R to the left - so do the arrows over it - Ctrl+M mirrors it, and a right-click on it offers all of them. Enter, Esc or a click elsewhere puts it down, Delete takes it back. @UprightHere">
                        @piece.Says &mdash; drag its corner, R turns, Enter when done
                    </span>
                }

                @*
                    What can be done to the cell itself rather than to what is in it. Behind a disclosure,
                    because renaming and deleting are things somebody does once and the bar is read constantly.
                *@
                <button id="cellActions" class="buttonStyle2 smallButton contextCrumb @(cellActionsOpen ? "contextCrumbOn" : "")"
                        @onclick="toggleCellActions"
                        disabled="@ReadOnly"
                        title="Rename or delete this cell">&hellip;</button>

                @if (cellActionsOpen)
                {
                    <input id="renameTo" class="renameBox" type="text" maxlength="@LongestCellName"
                           value="@renameTo" @oninput="changeRenameTo"
                           placeholder="new name" title="What to call this cell instead" />

                    @*
                        The three of them as pictures, with the words in the tooltip and the aria-label.

                        **The bar is the one thing over the canvas whose width is somebody else's problem.**
                        It holds a breadcrumb that grows a crumb per level and a name box beside it, and it is
                        centered - so every character these three spent pushed the crumbs somebody is
                        navigating by out towards the edges. A pencil, a copy mark and a bin are read without
                        being told, which is the same reason the selection panel's own row of squares lost its
                        words; see the note by Trace net for the case where a glyph does *not* say enough.
                    *@
                    <button id="renameCell" class="buttonStyle2 smallButton contextCrumb contextCrumbIconOnly" @onclick="renameCell"
                            disabled="@(!canRename())" aria-label="Rename" title="@renameDescription()">
                        <svg class="contextCrumbIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Rename))</svg>
                    </button>

                    @*
                        The same box named the new copy, because renaming and copying both answer "call it what?"
                        and two boxes for one question would be one too many. Which button is pressed says which
                        was meant.
                    *@
                    <button id="copyCell" class="buttonStyle2 smallButton contextCrumb contextCrumbIconOnly" @onclick="copyCell"
                            disabled="@(!canRename())" aria-label="Copy to" title="@copyCellDescription()">
                        <svg class="contextCrumbIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Copy))</svg>
                    </button>

                    <button id="deleteCell" class="buttonStyle2 smallButton contextCrumb contextCrumbIconOnly selectionDelete" @onclick="deleteCell"
                            disabled="@(!canDeleteCell())" aria-label="Delete cell" title="@deleteCellDescription()">
                        <svg class="contextCrumbIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Delete))</svg>
                    </button>
                }
            </div>
        }


        @if (drawRefusal.Length > 0)
        {
            @*
                Why the pencil would not do what was asked, or did it differently - a path drawn as its outline on
                the deck's grid, a piece the grid left out - in the hint's place and its shape.

                **First in the chain**, ahead of the drawing hints and the rule check: it is about the gesture
                somebody just made. It used to sit below the hints on the grounds that it could only be up when
                they were not - the pencil refusing to be taken up at all - but the Draw menu's Text and Image
                answer with it too, a picture that could not be read, and those are asked with the pencil in
                hand and a hint already showing.

                It is an error rather than a hint: what was asked did not happen, or not as asked, and the line has
                to read as the reason and not as an instruction that was followed - so it is in the error red, where
                the hints are orange.
            *@
            <div id="drawRefusal" class="drawHint viewNotice drawHintError">
                <span>@drawRefusal</span>

                <button id="drawRefusalClose" class="viewNoticeClose" @onclick="dismissDrawRefusal"
                        aria-label="Close this message" title="Close">&times;</button>
            </div>
        }
        else if (drawingShapes && drawShape == DrawShape.Polygon)
        {
            @*
                What a polygon is waiting for. Only while one is being drawn: a rectangle needs no telling, and
                a line of instructions that is always there is a line nobody reads by the third time.
            *@
            <div id="drawHint" class="drawHint">
                click each corner &middot; click the first again, double-click or Enter to close &middot; Backspace takes one back &middot; Esc cancels
            </div>
        }
        else if (drawingShapes && drawShape == DrawShape.Ellipse)
        {
            <div id="drawHint" class="drawHint">
                drag out an ellipse &middot; hold Shift for a circle &middot; @ellipseSides sides
            </div>
        }
        else if (drawingShapes && drawShape == DrawShape.Label)
        {
            @*
                No mention of retyping here. A double-click *in this mode* places a label and then another,
                because that is what a click means while the Label shape is out - retyping one is a
                double-click with any other tool in hand.
            *@
            <div id="drawHint" class="drawHint">
                click to place a label and type it where it lands &middot; Enter keeps it, Esc takes it back
            </div>
        }
        else if (Notice.Length > 0)
        {
            @*
                What the rule check found, in the hint's place and its shape.

                **Last in the same chain rather than a box of its own**, so a hint and a result can never
                be stacked on each other. While a shape is being drawn the hint is the more useful of the
                two - it is about the gesture in progress - and the result comes back the moment the shape
                is finished, which is also when it would have been rechecked anyway.
            *@
            <div id="drcNotice" class="drawHint viewNotice @(NoticeIsFault ? "drawHintFault" : "drawHintClear")">
                <span>@Notice</span>

                @*
                    A way to put it away, which the drawing hints above do not need.

                    Those come and go with the tool in hand - stop drawing and the line goes. This one is
                    about a run that has finished, so nothing else is going to take it off the drawing, and
                    it sits over the layout somebody may now want to look at. The markers stay: this closes
                    the sentence, not the result. Clear in the panel is what takes the marks off.
                *@
                <button id="drcNoticeClose" class="viewNoticeClose" @onclick="dismissNotice"
                        aria-label="Close this message" title="Close">&times;</button>
            </div>
        }

        @*
            What was clicked. In the corner of the view rather than in the toolbar, because it is about the
            thing under the cursor rather than about the file - and because it appears and goes away, which a
            control in a bar cannot do without the bar changing height under everything else.
        *@
        @if (chosenIndexes.Count > 0)
        {
            <div id="selectionPanel" class="selectionPanel">
                @*
                    Which layer they are on, at the top, where the panel used to only *say* it.

                    A heading naming the layer and a picker for the layer further down were the same fact twice,
                    and the one you could act on was the one out of sight. Applied on choosing rather than
                    behind a second press: a select is already two gestures, and a picker that needs a button
                    beside it is one that gets left showing a layer nothing is on.

                    **Built rather than a `select`, for the swatch.** An `option` holds text and nothing else -
                    no markup, no reliable background - so a colored square beside each layer is not something a
                    native dropdown can be made to do. The sidebar already draws layers as a swatch and a name,
                    and this is that list again where the layer is being changed.
                *@
                @if (DistinctEditable > 0)
                {
                    <div class="layerPickerRow">
                        <span class="arrayBetween">On layer</span>

                        <div class="layerPicker">
                            <button id="chosenLayer" class="layerPickerButton" @onclick="toggleChosenLayer"
                                    data-layer="@chosenLayerName()"
                                    title="Move them onto another layer. Their shape and their place do not change">
                                <span class="layerSwatch" style="background-color: @colorOfKey(chosenLayerName());"></span>
                                <span class="layerPickerName">@chosenLayerLabel()</span>
                                <span class="layerPickerArrow" aria-hidden="true">&#9662;</span>
                            </button>

                            @if (chosenLayerOpen)
                            {
                                <div id="chosenLayerList" class="layerPickerList">
                                    @foreach (var layer in drawableLayers())
                                    {
                                        <button class="layerPickerOption @(layer.Key.ToString() == chosenLayerName() ? "layerPickerOptionOn" : "")"
                                                data-layer="@layer.Key.ToString()"
                                                @onclick="() => chooseLayer(layer.Key)">
                                            <span class="layerSwatch" style="background-color: @layer.Color;"></span>
                                            <span class="layerPickerName">@layer.DisplayName</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Only is Element one)
                {
                    @if (one.Source is ElementSource source)
                    {
                        @*
                            The chain, which is the answer to "what am I actually looking at" in a hierarchical
                            layout - a shape drawn here may belong to a cell placed a thousand times.

                            Named, because on a file one level deep the chain is a single cell name and read as a
                            stray word - "mosfet" under a layer picker looks like the name of the file, which on
                            the bundled example it happens to match. The tooltip said what it was and you had to
                            hover to find out.
                        *@
                        <div class="selectionRow" title="The chain of cells this shape was reached through">
                            <span class="arrayBetween">Cell:</span> @source.ToString()
                        </div>

                        @if (!source.IsDirectlyEditable)
                        {
                            @*
                                What is worth knowing before an edit, rather than a description of where you
                                are.

                                It read "in a placed cell - editing it changes every instance", and the first
                                half was the breadcrumb above saying itself again: the chain already shows the
                                cell was reached through a placement. What is left is the part nobody can see
                                from the screen, with a mark in front of it that says "this is a warning"
                                before the sentence is read.
                            *@
                            <div class="selectionRow selectionNote noteWithIcon">
                                <svg class="noteIcon" viewBox="0 0 16 16" aria-hidden="true">
                                    <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
                                    <path d="M8 7.2v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <circle cx="8" cy="4.8" r="0.9" fill="currentColor" />
                                </svg>

                                <span>editing it changes every instance</span>
                            </div>
                        }

                        @*
                            There was an Edit button here, and clicking the shape does what it did.

                            It cost three actions to move one thing - click the shape, press Edit, click the
                            shape again, because entering a cell re-marks every shape and so let go of the
                            selection - and nothing was decided in between. A click already says which cell it
                            means: the cell of the shape under it.
                        *@

                        @*
                            The way back out of hierarchy, offered where the chain is shown because that is where
                            somebody is already reading which instance they are looking through.
                        *@
                        @if (source.Ancestry.Count >= 2 && context is not null && context.Structure == source.Ancestry[^2].Structure)
                        {
                            <button id="flattenInstance" class="buttonStyle2 smallButton selectionAction" @onclick="() => flatten(source)"
                                    disabled="@(flattenRefusal(source) is not null)"
                                    title="@flattenSays(source)">
                                Flatten this @source.Structure
                            </button>
                        }
                    }

                    @*
                        **What the buttons below will act on, said before they are pressed.**

                        Dragging a shape that belongs to a placed cell moves the *placement*, not the shape - which
                        is what every layout editor does and is still a surprise the first time, because what is
                        under the pointer is a shape. Saying so here is cheaper than finding out by moving a cell
                        that is placed four hundred times.
                    *@
                    @if (EditingInstance)
                    {
                        <div class="selectionRow selectionNote" id="instanceNote">
                            @instanceNote()
                        </div>
                    }
                }

                @*
                    Taking what is chosen into a cell of its own.

                    **At the end of the first section, with what is chosen rather than with what is done to it.**
                    It reads as the last line of the answer to "what am I looking at": a shape, in this cell,
                    reached through this chain - and, if you like, in a cell of its own called this. Everything
                    below the rule acts on the shapes where they are; this is the one control that changes what
                    "where they are" means.

                    A name box beside it, defaulted to one nothing is using - a cell has to be called something,
                    and being asked to invent a name before finding out whether the button works is a poor first
                    move.
                *@
                @if (DistinctEditable > 0)
                {
                    @*
                        The name and the button that uses it, joined into one control.

                        They were a box and a button with a gap between them, which reads as two things that
                        happen to be adjacent - the same seam the download button and its format picker close,
                        and for the same reason: neither half means anything without the other.
                    *@
                    <div class="selectionRow newCellRow">
                        <input id="cellName" class="labelText joinedStart" type="text" maxlength="32"
                               value="@cellName" @oninput="changeCellName"
                               placeholder="cell name" title="What the new cell will be called" />

                        <button id="makeCell" class="buttonStyle2 smallButton selectionAction lineUpButton joinedEnd"
                                @onclick="groupIntoCell" disabled="@(!canMakeCell())"
                                title="@makeCellDescription()">New cell</button>
                    </div>
                }

                @*
                    The actions, on whatever is chosen. Copy takes anything; the rest need the current cell to
                    hold it, since editing a shape from elsewhere would change a cell nobody is looking at.

                    Above the numbers rather than below them, which is where these sat until now.

                    The panel answers three questions in order - what is chosen, what can be done to it, and what
                    it measures - and the doing was last, under a bounds line, an at-and-by pair, a size pair, a
                    path width and a Grow by. Every one of those is a number somebody reads when they want a
                    number; none of them is on the way to cutting a shape. Putting the eight squares directly
                    under what they act on means the common thing is reached without passing the rare one, and
                    the numbers are no further from the top of the panel than they were from its bottom.
                *@
                @*What is chosen, above; what can be done to it, below. See .panelDivider.*@
                <div class="panelDivider"></div>

                <div class="selectionActions">
                    @*
                        Copy, Cut and Delete as icons rather than words.

                        The three of them are the shortest words in the panel and took a row to themselves; as
                        three squares they take a third of it, and a pair of scissors is read faster than "Cut"
                        by anyone who has used any editor. The word moves to aria-label, where a screen reader
                        still says it, and the title keeps the whole sentence including the shortcut.
                    *@
                    <button id="copyShapes" class="buttonStyle2 smallButton selectionAction actionIcon" @onclick="copyChosen"
                            aria-label="Copy"
                            title="Copy the chosen shapes, to paste into whichever cell is being edited (Ctrl+C)">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <rect x="5.2" y="1.8" width="9" height="9" rx="1.4"
                                  fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M10.8 13.2v0.6a1.4 1.4 0 0 1-1.4 1.4H3.2a1.4 1.4 0 0 1-1.4-1.4V6.6a1.4 1.4 0 0 1 1.4-1.4h0.6"
                                  fill="none" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>

                    @*
                        Array, beside Copy because that is what it is: copying, more than once and onto a grid.
                        The icon says so - the two squares of Copy with a third behind them.

                        A disclosure rather than an action, so it carries aria-expanded and the boxes it opens
                        are the first thing under the rule below this row.
                    *@
                    @if (Editable.Count > 0 || ArrayingInstance)
                    {
                        <button id="arrayOpen" class="buttonStyle2 smallButton selectionAction actionIcon @(arrayOpen ? "selectionActionOn" : "")"
                                @onclick="toggleArray"
                                aria-label="Array" aria-expanded="@(arrayOpen ? "true" : "false")"
                                title="Repeat these into a grid of copies at a pitch you choose">
                            @*
                                The one in front whole, the two behind it as the corner each shows past it.
                                Three outlines drawn in full would cross each other twice, and at fifteen
                                pixels a crossing is a smudge rather than a square.
                            *@
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <rect x="1.4" y="6.4" width="8.2" height="8.2" rx="1.4"
                                      fill="none" stroke="currentColor" stroke-width="1.5" />
                                <path d="M4.6 4.4h5.6a1.4 1.4 0 0 1 1.4 1.4v5.6"
                                      fill="none" stroke="currentColor" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M7.8 1.4h5.6a1.4 1.4 0 0 1 1.4 1.4v5.6"
                                      fill="none" stroke="currentColor" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    }

                    @*
                        Cut is offered on the same condition as Delete rather than beside Copy, because it is a
                        delete that keeps a copy: it can only act on what the cell being edited actually holds.
                        Copy has no such limit - anything on screen can be copied out of a cell that is only
                        being shown.
                    *@
                    @if (Editable.Count > 0)
                    {
                        <button id="cutShapes" class="buttonStyle2 smallButton selectionAction actionIcon" @onclick="cutChosen"
                                aria-label="Cut"
                                title="Take the chosen shapes onto the clipboard and out of the cell, as one step (Ctrl+X)">
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M4 1.8 11.4 12.2M12 1.8 4.6 12.2"
                                      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <circle cx="4.1" cy="13" r="1.9" fill="none" stroke="currentColor" stroke-width="1.5" />
                                <circle cx="11.9" cy="13" r="1.9" fill="none" stroke="currentColor" stroke-width="1.5" />
                            </svg>
                        </button>
                    }

                    @if (Editable.Count > 0)
                    {
                        <button id="deleteShape" class="buttonStyle2 smallButton selectionAction selectionDelete actionIcon" @onclick="() => deleteChosen()"
                                aria-label="Delete"
                                title="Remove them from the cell. Every instance of the cell loses them (Delete)">
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M2.6 4.1h10.8M6.4 4.1V2.6h3.2v1.5M4.2 4.1l0.7 9.1a1.3 1.3 0 0 0 1.3 1.2h3.6a1.3 1.3 0 0 0 1.3-1.2l0.7-9.1"
                                      fill="none" stroke="currentColor" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M6.7 6.7v5M9.3 6.7v5"
                                      fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                            </svg>
                        </button>
                    }
                    @*
                        On every placement the selection reaches, not only on a selection that is exactly one.

                        A band dragged across a layout of placed cells used to offer nothing at all: none of
                        the shapes are the current cell's own, and the single-instance question the button
                        asked said no the moment there were two. Copy was the only thing on the row.
                    *@
                    else if (DeletingInstances)
                    {
                        <button id="deleteInstance" class="buttonStyle2 smallButton selectionAction selectionDelete" @onclick="() => deleteChosen()"
                                title="Take them out of the cell being edited. The cells they place stay in the library (Delete)">
                            @deleteInstancesSays()
                        </button>
                    }

                    @*
                        Turning and mirroring, on whatever the current cell holds - on this same row, behind a
                        rule.

                        They were a row of their own, on the grounds that four alternatives are not four more
                        actions and that sitting against Delete makes the button that removes things twice as
                        easy to hit by accident. Both still hold. A divider says them in a couple of pixels
                        rather than in a whole row, and seven squares cross the panel with room left over.
                    *@
                    @*
                        **This view draws the layout's Y downwards**, where a layout format counts it upwards - so
                        the quarter turn the arithmetic calls positive is the one that looks like a turn to the
                        right here. That is the whole of the difference and this is the only place it is applied:
                        the arrow, the words and the operation sit together, button after button, so the three can be
                        read against each other. Getting it backwards looks perfectly correct until somebody compares the button
                        to the screen.
                    *@
                    @if (Editable.Count > 0 || EditingInstance)
                    {
                        @*
                            The rule and the four of them as one piece, so that when the row does have to wrap it
                            wraps here. With an instance chosen the delete is a word rather than a square and the
                            seven no longer fit: loose, that put three turns on one line and the fourth alone on
                            the next, which reads as a mistake. See .turnGroup.
                        *@
                        <div class="turnGroup">
                            <div class="actionDivider"></div>

                            <button id="turnLeft" class="buttonStyle2 smallButton selectionAction turnButton actionIcon"
                                    @onclick="() => turnChosen(Turn.ThreeQuarters, TurnLeftName)"
                                    title="Turn a quarter to the left, about the middle of what is chosen">
                                <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.TurnLeft))</svg>
                            </button>

                            <button id="turnRight" class="buttonStyle2 smallButton selectionAction turnButton actionIcon"
                                    @onclick="() => turnChosen(Turn.Quarter, TurnRightName)"
                                    title="Turn a quarter to the right, about the middle of what is chosen">
                                <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.TurnRight))</svg>
                            </button>

                            <button id="mirrorAcross" class="buttonStyle2 smallButton selectionAction turnButton actionIcon"
                                    @onclick="() => turnChosen(Turn.FlipX, MirrorAcrossName)"
                                    title="Mirror left to right, about the middle of what is chosen">
                                <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.MirrorAcross))</svg>
                            </button>

                            <button id="mirrorDown" class="buttonStyle2 smallButton selectionAction turnButton actionIcon"
                                    @onclick="() => turnChosen(Turn.FlipY, MirrorDownName)"
                                    title="Mirror top to bottom, about the middle of what is chosen">
                                <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.MirrorDown))</svg>
                            </button>
                        </div>
                    }
                </div>

                @*
                    What the Array square opens onto: how many, and how far apart.

                    Behind a disclosure, because it is the one thing here that needs numbers typed into it and
                    the panel is long enough already - four boxes on every selection would make everybody pay
                    for something most selections do not want.

                    Inside the squares' own section, under the row that opens it and above the rule that ends
                    it. A disclosure belongs with the control that opened it: past the rule these read as the
                    start of the next group rather than as the inside of this one, and the rule then fell
                    between a button and the boxes it had just put on screen.
                *@
                @if ((Editable.Count > 0 || ArrayingInstance) && arrayOpen)
                {
                    @*
                        On a ground of its own, so it reads as what the pressed square opened.

                        These are the only rows in the panel that appear because a button is held down, and
                        without something tying them to it they are three more rows in a column of rows - the
                        square is lit at the top and the boxes are somewhere below it, with no telling that one
                        is the other's inside. A darker patch says it in the way a menu says it.
                    *@
                    <div id="arrayOpened" class="arrayOpened">
                    @*
                        How many, and how far apart, on one line.

                        They were two rows, which read as two questions - and they are one: "three by one, by
                        this much". Said across a line it is a sentence, and the disclosure is a row shorter in a
                        panel that is long already.

                        The boxes are sized to what goes in them; see .arrayCount and .arrayPitch. A count is at
                        most two digits, and one built to hold six was six digits of white space saying nothing.
                    *@
                    <div class="selectionRow arrayRow">
                        <input id="arrayColumns" class="arrayCount arrayHowMany" type="number" min="1" max="@MostAcross" step="1"
                               value="@arrayColumns" @onchange="changeArrayColumns"
                               title="How many across, counting the one that is already there" />

                        <span class="arrayBetween">&times;</span>

                        <input id="arrayRows" class="arrayCount arrayHowMany" type="number" min="1" max="@MostAcross" step="1"
                               value="@arrayRows" @onchange="changeArrayRows"
                               title="How many down, counting the one that is already there" />

                        @*"by pitch", so the line reads as one sentence rather than as a row and a label for it.*@
                        <span class="arrayBetween">by pitch</span>

                        <input id="arrayPitchX" class="arrayCount arrayPitch" type="number" step="0.1"
                               value="@SvgWriter.FormatNumber(arrayPitchX)" @onchange="changeArrayPitchX"
                               title="How far apart across, in microns. Negative goes the other way" />

                        <input id="arrayPitchY" class="arrayCount arrayPitch" type="number" step="0.1"
                               value="@SvgWriter.FormatNumber(arrayPitchY)" @onchange="changeArrayPitchY"
                               title="How far apart down, in microns. Negative goes the other way" />

                        <span class="arrayBetween">&#181;m</span>
                    </div>

                    <div class="selectionActions">
                        @*
                            What pressing it does, said as a sentence beginning with the verb.

                            "Array 3 × 1" was the noun, which reads as a label for the boxes above rather than as
                            a button - and the other two things this button can say already began with "Add". All
                            three now do, so the row under the numbers is always what happens next.

                            Set at .lineUpButton's size, which is what every other word button in the panel is at
                            - it was the one left at the panel's own, and a full-size button under a row of small
                            boxes is the loudest thing in a disclosure that is meant to be quiet.
                        *@
                        <button id="arrayMake" class="buttonStyle2 smallButton selectionAction lineUpButton" @onclick="makeArray"
                                disabled="@(!canArray())"
                                title="@arrayDescription()">
                            @if (ArrayingInstance)
                            {
                                <text>Add @arrayColumns &times; @arrayRows array</text>
                            }
                            else if (ArrayCopies == 0)
                            {
                                <text>Nothing to add</text>
                            }
                            else
                            {
                                <text>Add @ArrayCopies more</text>
                            }
                        </button>
                    </div>
                    </div>
                }

                @*
                    The squares, and whatever they have opened, on a section of their own.

                    They are the only rows here that act on the shapes *as they are* - copy them, cut them,
                    turn them, repeat them - where everything under this rule is a number that describes the
                    shapes rather than an instruction to change them. Ruled off, they read as the set they
                    are rather than as the first of a column of controls that keeps going. See .panelDivider.
                *@
                <div class="panelDivider"></div>

                @*What the panel is about, in the two shapes it comes in: one shape, or a set of them.*@
                @if (Only is Element drawn)
                {
                    @*
                        What a label says, as a box rather than as a line to read. Placing drawn already needs the
                        words typed before the click, so a label placed with a typo could only be deleted and put
                        down again - and every TEXT element carries a STRING, so this is drawn record written.
                    *@
                    @if (drawn.Text is not null && chosenLabel() is not null)
                    {
                        <div class="selectionRow arrayRow" id="labelRow">
                            @*
                                Still named, not only editable. The box says what it says; the word beside it is
                                what the thing *is*, which is the question the panel answers first for every other
                                kind of element and should not stop answering because this drawn grew a control.
                            *@
                            <span class="arrayBetween">label</span>

                            <input id="chosenLabelText" class="renameBox" type="text" maxlength="@AddElement.LongestLabel"
                                   value="@drawn.Text" @onchange="changeChosenLabelText"
                                   title="What this label says. GDSII holds plain ASCII, so anything else is dropped" />
                        </div>
                    }
                    else if (drawn.Text is not null)
                    {
                        <div class="selectionRow">label &ldquo;@drawn.Text&rdquo;</div>
                    }
                    else
                    {
                        <div class="selectionRow">@drawn.Points.Count corners, @describeArea(drawn)</div>
                    }
                }
                else
                {
                    @*
                        Several. What they have in common rather than a list of them, which for a rubber band
                        over a dense cell would be a panel taller than the view.
                    *@

                    <div class="selectionHeading">@chosenIndexes.Count shapes</div>

                    <div class="selectionRow">on @string.Join(", ", Chosen.Select(shape => shape.Layer.Key.ToString()).Distinct().Order())</div>
                }


                @*
                    What the traced net is called, when the layout says.

                    Only after a trace, because it is the *net's* name: the same labels over an arbitrary
                    selection would be whatever happened to be caught, which is a different and much weaker
                    claim. Cleared the moment anything else is chosen; see traceNet.

                    Two names on one net is shown rather than hidden - it is either two spellings of the same
                    thing or two nets that are shorted, and both are worth knowing about.
                *@
                @if (netNames.Count > 0)
                {
                    <div class="selectionRow" id="netName">
                        net @string.Join(", ", netNames.Select(name => $"“{name}”"))

                        @if (netNames.Count > 1)
                        {
                            <span class="selectionNote"> &mdash; @netNames.Count names on one net</span>
                        }
                    </div>
                }
                else if (netTraced)
                {
                    <div class="selectionRow selectionNote" id="netName">no label sits on this net</div>
                }

                @*
                    How far the trace has got, and the way on.

                    **A trace goes out a number of shapes at a time** - see traceNet - so a supply net of tens of
                    thousands does not have to be had all at once to see where a wire goes. Next reaches that many
                    more, nearest first, and the number is the one beside it.
                *@
                @if (netWalk is Nets.Walk walk)
                {
                    <div class="selectionRow arrayRow" id="netSteps">
                        @if (walk.Done)
                        {
                            <span class="selectionNote">the whole net, @walk.Found.Count shapes</span>
                        }
                        else
                        {
                            <span class="selectionNote">@walk.Found.Count shapes so far</span>

                            <button id="netNext" class="buttonStyle2 smallButton" @onclick="traceFurther"
                                    title="Reach further along the net, the next shapes out first">Next</button>

                            <select id="netStep" value="@netStep" @onchange="changeNetStep"
                                    title="How many more shapes each step reaches">
                                @foreach (int many in NetSteps)
                                {
                                    <option value="@many">@netStepName(many)</option>
                                }
                            </select>
                        }
                    </div>
                }

                <div class="selectionRow selectionNote">@chosenBounds().ToString()</div>

                @*
                    Where it is, as a number that can be typed into.

                    **Its position first.** Typing a corner is a move, and a move is exact. The size can be typed
                    too, in the two boxes under these, but that is a scale, which rounds every corner of the shape
                    by a different amount - and the line under them says so.

                    In microns, like everything else somebody types into this view - a database unit is a
                    nanometer on most files, and nobody places anything by counting those.
                *@
                @if (Editable.Count > 0)
                {
                    <div class="selectionRow arrayRow">
                        <span class="arrayBetween">At</span>

                        <input id="atX" class="arrayCount" type="number" step="0.01"
                               value="@SvgWriter.FormatNumber(atMicrons(chosenBounds().Left))" @onchange="changeAtX"
                               title="Where its left edge is, in microns" />

                        <input id="atY" class="arrayCount" type="number" step="0.01"
                               value="@SvgWriter.FormatNumber(atMicrons(chosenBounds().Bottom))" @onchange="changeAtY"
                               title="Where its top edge is, in microns - this view draws Y downwards" />

                        <span class="arrayBetween">&#181;m</span>
                    </div>

                    @*
                        And how big it is.

                        **A size typed is a scale, and a scale rounds.** Every corner moves by its own fraction of
                        a unit, where a move shifts them all by the same whole number - so this cannot be exact
                        the way the position above it is, and the note says so rather than leaving it to be found
                        out. It is still the only way to make two shapes the same size on purpose.

                        Anchored on the same corner the position names, so growing a shape leaves the number in
                        the At box where it was.
                    *@
                    @*
                        Not for a label on its own. A label's box on screen is the words it draws, and its
                        coordinates are the single point they hang from - so scaling one would move the anchor and
                        change nothing about the size the box is showing. In a group it scales like anything else.
                    *@
                    @if (Only is not Element alone || alone.Text is null)
                    {
                        <div class="selectionRow arrayRow" id="sizeRow">
                            <span class="arrayBetween">By</span>

                            <input id="sizeX" class="arrayCount" type="number" min="0" step="0.01"
                                   value="@SvgWriter.FormatNumber(atMicrons(chosenBounds().Width))" @onchange="changeSizeX"
                                   title="How wide it is, in microns. Typing one scales what is chosen about its left edge" />

                            <input id="sizeY" class="arrayCount" type="number" min="0" step="0.01"
                                   value="@SvgWriter.FormatNumber(atMicrons(chosenBounds().Height))" @onchange="changeSizeY"
                                   title="How tall it is, in microns. Typing one scales what is chosen about its top edge" />

                            <span class="arrayBetween">&#181;m</span>
                        </div>

                        <div class="selectionRow selectionNote">@describeSize() &mdash; typing a size scales, and rounds</div>
                    }
                    else
                    {
                        <div class="selectionRow selectionNote">@describeSize()</div>
                    }
                }

                @*
                    What a path is drawn with. Only for a path, and only for one at a time: the width belongs to
                    the element rather than to the selection, and a box showing one number for two shapes that
                    differ would read as a fact and be a guess.

                    Here rather than in the Draw menu because this is the *chosen* shape's width, where the menu's
                    Path row holds the width of the next one to be drawn - two numbers that mean different things,
                    and one control for both would silently move whichever was not being looked at.
                *@
                @if (chosenPath() is (GDS.StructureModel _, GDS.ElementModel _, int width, Paths.Ends ends))
                {
                    <div class="selectionRow arrayRow" id="pathRow">
                        <span class="arrayBetween">Wide</span>

                        <input id="chosenPathWidth" class="arrayCount" type="number" min="0" step="0.01"
                               value="@SvgWriter.FormatNumber(atMicrons(width))" @onchange="changeChosenPathWidth"
                               title="How wide this path is drawn, in microns" />

                        <span class="arrayBetween">&#181;m</span>

                        <select id="chosenPathEnds" value="@ends" @onchange="changeChosenPathEnds"
                                title="How this path's two ends are finished">
                            <option value="@Paths.Ends.Flush">flush</option>
                            <option value="@Paths.Ends.Round">round</option>
                            <option value="@Paths.Ends.Extended">extended</option>
                        </select>
                    </div>
                }

                @*
                    Growing and shrinking, which is the other half of what a design rule is written in: "closer
                    than 200nm" is answered by growing one shape by that and asking whether it now touches.

                    Last of the numbers rather than first of the actions, which is where this used to sit. It is
                    a distance typed in microns and applied to what is chosen, which is what At and By are too -
                    and read down one column the three of them say so.

                    **The name is on the button, not on a label beside it.** The other rows here are readings
                    with a word to say what they are; this one is a thing you do, and "Grow by" on the button
                    that does it says the same in one place rather than two. The box keeps the name for anything
                    that reads the panel aloud, where a label written on a button two elements away is not
                    attached to the field at all.

                    The button leads the row, where the word would have been, and is sized to the box so the
                    two read as one control - see .growButton.
                *@
                @if (DistinctEditable > 0)
                {
                    @*
                        The word on the button is the verb; the preposition stands between it and the number.

                        "Grow by" on the button read as one long label with a box after it, where the row is
                        really a sentence with a blank in it - grow, by, this much, of these. The same shape as
                        the Array row above, which says "by" between its two counts, and as the At and By rows
                        below. Named in full for a reader through aria-label, since a screen reader takes the
                        button on its own and "Grow" alone does not say by what.
                    *@
                    <div class="selectionRow arrayRow">
                        <button id="growApply" class="buttonStyle2 smallButton selectionAction lineUpButton growButton"
                                @onclick="growChosen" disabled="@(growUnits() == 0)"
                                aria-label="Grow by"
                                title="@growDescription()">Grow</button>

                        <span class="arrayBetween">by</span>

                        <input id="growBy" class="arrayCount" type="number" step="0.05" aria-label="Grow by"
                               value="@SvgWriter.FormatNumber(growMicrons)" @onchange="changeGrowBy"
                               title="How far every edge moves outwards, in microns. Negative shrinks" />

                        <span class="arrayBetween">&#181;m</span>
                    </div>

                    @*
                        Rounding every corner of what is chosen, or cutting it off.

                        Under Grow because it is the same kind of thing: a distance in microns, put to every shape
                        chosen, as one press of undo. Two buttons sharing one box rather than two rows, since the
                        distance means the same to both - how far along each edge a corner goes, which for a round
                        one is its radius.
                    *@
                    <div class="selectionRow arrayRow" id="cornersRow">
                        <button id="roundCorners" class="buttonStyle2 smallButton selectionAction lineUpButton growButton"
                                @onclick="roundCorners" disabled="@(cornerUnits() <= 0 || combinable().Count == 0)"
                                aria-label="Round corners by"
                                title="@cornersDescription(rounding: true)">Round</button>

                        <button id="cutCorners" class="buttonStyle2 smallButton selectionAction lineUpButton growButton"
                                @onclick="cutCorners" disabled="@(cornerUnits() <= 0 || combinable().Count == 0)"
                                aria-label="Cut corners by"
                                title="@cornersDescription(rounding: false)">Cut</button>

                        <span class="arrayBetween">by</span>

                        <input id="cornerBy" class="arrayCount" type="number" min="0" step="0.05" aria-label="Round or cut corners by"
                               value="@SvgWriter.FormatNumber(cornerMicrons)" @onchange="changeCornerBy"
                               title="How far along each edge a corner is rounded or cut, in microns - a rounded corner's radius" />

                        <span class="arrayBetween">&#181;m</span>
                    </div>
                }

                @*What it measures, above; what else can be done to it, below. See .panelDivider.*@
                <div class="panelDivider"></div>


                @*
                    The four set operations, on the shapes the cell holds.

                    **Subtract has a side and the others do not.** It is the first shape chosen with the rest
                    taken out of it, where union, intersect and exclude are about all of them at once - which is
                    why the panel says which one is first rather than leaving it to be discovered.
                *@
                @if (DistinctEditable > 1)
                {
                    <div class="selectionRow selectionLabel">Combine</div>

                    <div class="selectionActions">
                        <button id="combineUnion" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Union"
                                @onclick="() => combineChosen(BooleanOperation.Or, UnionName)"
                                title="One shape covering everything they cover between them">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Union))</svg>
                        </button>

                        <button id="combineSubtract" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Subtract"
                                @onclick="() => combineChosen(BooleanOperation.Not, SubtractName)"
                                title="The first one chosen, with all the others cut out of it">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Subtract))</svg>
                        </button>

                        <button id="combineIntersect" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Intersect"
                                @onclick="() => combineChosen(BooleanOperation.And, IntersectName)"
                                title="Only where every one of them covers">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Intersect))</svg>
                        </button>

                        <button id="combineExclude" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Exclude"
                                @onclick="() => combineChosen(BooleanOperation.Xor, ExcludeName)"
                                title="Where an odd number of them cover, so an overlap of two cancels out">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Exclude))</svg>
                        </button>
                    </div>
                }

                @*
                    Lining up, and spacing out. Only once there is more than one shape, because neither means
                    anything about one - which also keeps the panel for a single shape exactly as short as it
                    was.

                    The same note about Y as the turn buttons above: this view draws it downwards, so what looks
                    like the top edge is the *least* Y here and the format would call it the bottom.
                *@
                @if (DistinctEditable > 1)
                {
                    <div class="selectionRow selectionLabel">Line up</div>

                    <div class="selectionActions">
                        <button id="alignLeft" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align left"
                                @onclick="() => lineUpChosen(Edge.LeastX, null, LeftName)"
                                title="Bring their left edges into line">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignLeft))</svg>
                        </button>

                        <button id="alignCenter" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align center"
                                @onclick="() => lineUpChosen(Edge.MiddleX, null, CenterName)"
                                title="Bring them onto one vertical line through their middles">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignCenterX))</svg>
                        </button>

                        <button id="alignRight" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align right"
                                @onclick="() => lineUpChosen(Edge.MostX, null, RightName)"
                                title="Bring their right edges into line">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignRight))</svg>
                        </button>

                        <button id="alignTop" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align top"
                                @onclick="() => lineUpChosen(Edge.LeastY, null, TopName)"
                                title="Bring their top edges into line">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignTop))</svg>
                        </button>

                        <button id="alignMiddle" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align middle"
                                @onclick="() => lineUpChosen(Edge.MiddleY, null, MiddleName)"
                                title="Bring them onto one horizontal line through their middles">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignMiddleY))</svg>
                        </button>

                        <button id="alignBottom" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Align bottom"
                                @onclick="() => lineUpChosen(Edge.MostY, null, BottomName)"
                                title="Bring their bottom edges into line">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.AlignBottom))</svg>
                        </button>
                    </div>
                }

                @*
                    What this piece of metal is attached to.

                    **A selection, not a separate highlight.** The net comes back as the chosen shapes, so it is
                    drawn by the machinery that already draws a selection, counted by the heading that already
                    counts one, and can be moved or measured like anything else that was picked. A second kind of
                    highlight would be a second thing to explain and a second thing to clear.

                    Offered only when a layer has been told what it is for, since without that the answer is
                    always "just this shape" - see Nets. What it says when it cannot be asked is in the title.

                    At the foot of the actions rather than at their head, where it used to be. Everything else
                    in the section does something *to* the chosen shapes; this one throws the selection away and
                    picks a different one. That is where a row of actions ends rather than where it starts, and
                    it puts it beside Array, the other button that answers with more panel instead of an edit.
                *@
                @if (Only is Element net && layout is not null)
                {
                    <div class="selectionActions">
                        @*
                            Refused on the same condition the walk refuses - Nets.TakesPart, asked in one place,
                            because a button offered on something the walk will not follow is a button that does
                            nothing when pressed.
                        *@
                        @*
                            The glyph *and* the words, unlike the squares above.

                            Copy, cut and delete are marks everybody already reads, so the words came off
                            them. Nothing is a universally known picture of "find everything joined to this",
                            and this is a button somebody presses once in a while rather than a dozen times
                            an hour - so the picture goes in front of the words rather than instead of them.
                        *@
                        <button id="traceNet" class="buttonStyle2 smallButton selectionAction selectionActionSays" @onclick="traceNet"
                                disabled="@(!Nets.TakesPart(net))" title="@netDescription(net)">
                            <svg class="contextCrumbIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.TraceNet))</svg>
                            <span>Trace net</span>
                        </button>
                    </div>
                }

                @*
                    Three, because two shapes have no gap between them to divide - and a button that is there
                    and does nothing is one that has to be pressed to find that out.
                *@
                @if (DistinctEditable > 2)
                {
                    <div class="selectionRow selectionLabel">Space out</div>

                    <div class="selectionActions">
                        <button id="spaceAcross" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Space out across"
                                @onclick="() => lineUpChosen(null, Along.X, AcrossName)"
                                title="Even out the spacing of their middles from left to right. The outermost two stay where they are">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.SpaceAcross))</svg>
                        </button>

                        <button id="spaceDown" class="buttonStyle2 smallButton selectionAction actionIcon"
                                aria-label="Space out down"
                                @onclick="() => lineUpChosen(null, Along.Y, DownName)"
                                title="Even out the spacing of their middles from top to bottom. The outermost two stay where they are">
                            <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.SpaceDown))</svg>
                        </button>
                    </div>
                }
            </div>
        }
        @*
            Where the pointer is. Its text is written by JS on every movement rather than through the component,
            so Blazor deliberately does not own what is inside it - see showCursorAt.
        *@
        <div id="cursorAt" class="cursorAt" title="Where the pointer is, in the file's own units"></div>

        @*The live link's chip, just above where the pointer is - see Corner.*@
        @Corner

        @*
            What a label says, typed where the label is.

            Over the canvas rather than in the toolbar, because a name belongs to a place: the words and the
            point they land on are one decision, and splitting them across the screen made placing a label a
            matter of typing here, looking there, and remembering which of the two you had already done.

            An HTML input rather than anything inside the SVG. SVG has no editable text, and a foreignObject
            would put a box in the layout's coordinates - which is the one space it must not be in, since it has
            to stay a readable size whatever the zoom.
        *@
        @if (retypingLabel >= 0)
        {
            <input id="canvasLabelText" class="canvasLabelText" type="text" maxlength="@AddElement.LongestLabel"
                   style="left: @SvgWriter.FormatNumber(retypingAt.X)px; top: @SvgWriter.FormatNumber(retypingAt.Y)px;"
                   value="@retypingText"
                   @oninput="changeRetypedText"
                   @onkeydown="onRetypeKey"
                   @ref="retypeBox"
                   placeholder="label"
                   title="What this label says. Enter keeps it, Escape puts it back. GDSII holds plain ASCII, so anything else is dropped" />
        }

        @*
            What writing says, typed under it - the label's box, for writing just put down with the Text row or
            double-clicked while its frame is up. A box of several lines, since pasted writing keeps its line breaks:
            Shift+Enter starts another, and Enter keeps them. See openWords.

            **Its keys are its own.** The box is gone by the time the drawing's key handler hears the Enter that kept
            the words, so that handler asks where a key was typed rather than what has the keyboard now - see
            onEditorKey in the interop. Asked only the second, Enter went on to put the writing down for good.
        *@
        @if (wordsOpen)
        {
            <textarea id="canvasWritingText" class="canvasLabelText canvasWritingText" maxlength="@(LongestStampText * MostWritingLines)"
                      rows="@Math.Clamp(wordsText.Split('\n').Length, 1, MostWritingLines)"
                      style="left: @SvgWriter.FormatNumber(wordsAt.X)px; top: @SvgWriter.FormatNumber(wordsAt.Y)px;"
                      value="@wordsText"
                      @oninput="changeWords"
                      @onkeydown="onWordsKey"
                      @ref="wordsBox"
                      placeholder="what to write"
                      spellcheck="false"
                      title="What to write: letters, digits and punctuation, anything else drawn as a question mark. Enter keeps it, Shift+Enter starts another line, Escape takes it back"></textarea>
        }

        @*
            The browser's own menu is off over the drawing whichever tool is in hand.

            It used to be off only while `selecting`, which is set by pickShapes - so Select and Move had it
            suppressed and Pan, Measure and Draw did not. openShapeMenu runs on all five, and it opens on
            anything already chosen or on a full clipboard, so with the pen in hand a right-click raised the
            app's menu *and* the browser's on top of it.

            Not tool-shaped at all, on reflection: this is the app's canvas and it has its own menu here, so
            the browser's belongs to a page that is not this one. The condition that is left is whether
            there is a drawing under the pointer, since before a file is open there is nothing of ours to
            put in its place.
        *@
        @*
            The picture, then the markers in markup of their own.

            **After**, so the markers sit over the layout rather than under it: SVG paints in document order and
            there is no z-index to appeal to. **Their own**, so a step through a deck's faults changes the markers
            and nothing else - they were appended to the picture's string, and every step handed the browser the
            whole drawing again, eleven million characters of it on the RGB mixer. Left alone, the picture's
            string is the same object as last time, which Blazor's diff passes over at once.
        *@
        <svg id="gdsSVG" viewBox="-2000 -1000 4000 4000" xmlns="http://www.w3.org/2000/svg"
             @oncontextmenu="openShapeMenu" @oncontextmenu:preventDefault="@(layout is not null)">
            @((MarkupString)svgString)@((MarkupString)markersDrawn)
        </svg>

        @*
            The same actions, where the pointer already is.

            A layout is worked at arm's length from the panel: the shape is under the cursor in the middle of the
            view and the buttons are three hundred pixels away down the side, which is a round trip for every
            turn and every delete.

            **The same actions, not a second set of them.** Every line here calls the method its button calls and
            is offered on the same condition, from one list rather than from a copy of the panel's - see
            shapeMenuItems. Two lists of what may be done to a selection would disagree the first time either
            changed, and the one that disagreed would be the one nobody was testing.

            Nothing typed into. At, By, Grow by and the array's pitch are boxes rather than commands, and a menu
            line that opens a box is a worse way to reach a box already on screen.

            **The right button picks what it lands on**, the way it does in every editor: right-clicking a shape
            nothing had selected opened no menu at all, and doing it over one shape while another was chosen
            offered to delete the other. See chooseForMenu, which also says why a right-click *inside* a
            selection of several leaves all of them alone.

            The browser's own menu is suppressed while the Select tool is in hand and a file is open, because
            that is when the right button belongs to the view - which does mean a right-click on bare canvas
            with nothing chosen offers nothing at all rather than Reload and Save as. Deciding that per press
            is not possible: preventDefault has to be asked for before the handler has looked at where the
            pointer was, so the choice is per tool or not at all. With any other tool in hand, or no file, the
            browser's menu comes up as usual.
        *@
        @if (menuAt is (double menuX, double menuY))
        {
            @*
                A sheet behind it that takes the next press. Cheaper than a document listener and it cannot be
                left behind, because it exists only while the menu does - and it catches a second right-click
                as well, which is what closes one menu before another opens.

                **Closed on the click, not on the press**, so the sheet is still in front at the release. On
                pointerdown it is gone by then, and the release lands on the view - which today is harmless,
                because what the view selects on is the press it never heard. That is a thin thing to rely on:
                it puts half a gesture into a handler that is written to expect both halves, which is the same
                trap the middle button is guarded against in onPointerUp. Waiting for the click means the view
                hears none of it, whatever it is listening for.
            *@
            <div class="shapeMenuBackdrop" @onclick="closeShapeMenu"
                 @oncontextmenu="closeShapeMenu" @oncontextmenu:preventDefault="true"></div>

            @*
                Anchored at the pointer, from the top or from the bottom.

                **Not held in by a height, because a height means scrolling and scrolling means clipping.** The
                first version capped the menu to the room below the click and let it scroll; overflow on one axis
                computes to auto on the other, which turned the menu into a scroll box - and a scroll box clips
                what is positioned inside it, which is every submenu. The submenu was never drawn; its width
                became a horizontal scrollbar instead.

                So the menu is as tall as it is, and staying on screen is a matter of which end is pinned. Low in
                the window it grows upwards from the pointer, which needs no height to work out: bottom is the
                distance from the click to the foot of the window, and the menu takes whatever it needs above it.
            *@
            <div id="shapeMenu" class="shapeMenu @(menuOpensLeftward ? "shapeMenuLeftward" : "")" role="menu" tabindex="-1" @ref="shapeMenuBox"
                 style="left: @SvgWriter.FormatNumber(menuX)px; @menuVerticalStyle()"
                 @onkeydown="onShapeMenuKey">
                @*
                    The canvas menu is built at render time so it always describes the selection as it is
                    now; a menu raised on a row is built once, when the row was pressed, because that is
                    what it is about - see menuLines.
                *@
                @foreach (var line in menuLines ?? shapeMenuItems())
                {
                    if (line is null)
                    {
                        <div class="shapeMenuRule"></div>
                    }
                    else if (line.Opens is List<MenuLine?> onto)
                    {
                        @*
                            A line that opens rather than acts.

                            Held open by CSS on hover and on focus-within rather than by a flag in the component:
                            a submenu that lives in state has to be told when to close as well, which means every
                            way of leaving it - the pointer moving to a sibling, to the parent, out of the menu
                            entirely, or the keyboard going somewhere else - and getting one of those wrong
                            leaves a panel hanging over the layout. :hover already knows all of them.
                        *@
                        <div class="shapeMenuOpens">
                            <button class="shapeMenuItem shapeMenuParent" role="menuitem"
                                    aria-haspopup="true" title="@line.Tells">
                                @if (line.Shows is SvgWriter.ShapeIcon parentIcon)
                                    {
                                        <svg class="shapeMenuIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(parentIcon))</svg>
                                    }
                                    else
                                    {
                                        <span class="shapeMenuIcon" aria-hidden="true"></span>
                                    }

                                    <span class="shapeMenuSays">@line.Says</span>

                                <span class="shapeMenuArrow" aria-hidden="true">&#8250;</span>
                            </button>

                            <div class="shapeSubmenu" role="menu">
                                @foreach (var inner in onto)
                                {
                                    if (inner is null)
                                    {
                                        <div class="shapeMenuRule"></div>
                                    }
                                    else
                                    {
                                        <button class="shapeMenuItem" role="menuitem" disabled="@(!inner.Offered)"
                                                title="@inner.Tells"
                                                @onclick="() => chooseFromMenu(inner.Does)">
                                            @if (inner.Shows is SvgWriter.ShapeIcon innerIcon)
                                    {
                                        <svg class="shapeMenuIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(innerIcon))</svg>
                                    }
                                    else
                                    {
                                        <span class="shapeMenuIcon" aria-hidden="true"></span>
                                    }

                                    <span class="shapeMenuSays">@inner.Says</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="shapeMenuItem" role="menuitem" disabled="@(!line.Offered)"
                                title="@line.Tells"
                                @onclick="() => chooseFromMenu(line.Does)">
                            @if (line.Shows is SvgWriter.ShapeIcon lineIcon)
                                    {
                                        <svg class="shapeMenuIcon" viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(lineIcon))</svg>
                                    }
                                    else
                                    {
                                        <span class="shapeMenuIcon" aria-hidden="true"></span>
                                    }

                                    <span class="shapeMenuSays">@line.Says</span>
                        </button>
                    }
                }
            </div>
        }

        @*
            Saving the picture, in the corner of the picture.

            It was a button in the bar at the top, worded, among the controls that change what is on screen.
            This one does not change anything - it takes what is already there - so it belongs with the view
            rather than with the things acting on it, and a camera says that in less room than two words.

            Bottom right, which is the corner nothing else uses: the breadcrumb and the readouts are along the
            top and the cursor position sits bottom left.

            **One camera, and a choice of what it saves.** It was two buttons side by side, the camera for an SVG
            and a picture icon for a PNG, so which was which had to be learned from the tooltips. The menu names
            both and says how they differ: the PNG is the view as pixels, for a slide or a message, where an SVG
            of a quarter of a million shapes is more than anything wants; the SVG is every shape.
        *@
        <button id="downloadImage" class="iconButton viewAction" @onclick="toggleImageMenu"
                aria-label="Download Image" aria-haspopup="menu" aria-expanded="@(imageMenuOpen ? "true" : "false")"
                title="Save this view as a picture - a PNG or an SVG">
            <svg viewBox="0 0 16 16" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"
                      d="M1.6 4.9h2.9l1.1-1.7h4.8l1.1 1.7h2.9a.9.9 0 0 1 .9.9v6.4a.9.9 0 0 1-.9.9H1.6a.9.9 0 0 1-.9-.9V5.8a.9.9 0 0 1 .9-.9Z" />
                <circle cx="8" cy="9.1" r="2.6" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
        </button>

        @if (imageMenuOpen)
        {
            <div id="imageMenu" class="imageMenu" role="menu" aria-label="Download Image">
                @*Drawn by the browser exactly as it is on screen - see downloadViewPng in the interop.*@
                <button id="downloadPng" class="shapePick" role="menuitem" @onclick="savePng"
                        title="Save this view as a PNG picture - exactly what is on screen, at twice its size">
                    PNG picture
                    <small>What is on screen, at twice its size</small>
                </button>

                <button id="downloadSvg" class="shapePick" role="menuitem" @onclick="saveSvg"
                        title="Save this view as an SVG image - every shape, at the current opacity, with the hidden layers left out">
                    SVG drawing
                    <small>Every shape, framed on what is on screen</small>
                </button>
            </div>
        }

        @*The assistant's spark was here, beside the camera, until the bar had room for it - see #askAiButton in the shell.*@
    </div>

    @*
        The file's cells as a tree, down the side of the layout.

        The same rows as the library under the book, from the same Hierarchy.Tree - one definition of what a
        cell row is, used in both places, because two that had to be kept in step would not be.

        What is different is how long it stays: this one is opened by a press and closed by one, where the
        library goes the moment the pointer leaves the column. That is what makes it usable for reading a
        hierarchy rather than for picking a name off a list.

        A column of the wrapper, beside the box that holds the drawing - so it takes its width out of the
        canvas the way the layer sidebar on the right does, rather than floating over the layout. See
        .viewCanvas, which is what keeps the panel and the bar inside it placed against the drawing.
    *@
    @if (CellTreeOpen)
    {
        @*
            Letting go of the preview when the pointer leaves the *panel*, not the rows.

            It was on the rows, which is where the pointer picks a cell - and that made the lens below them
            unreachable: moving down onto it left the rows, which cleared the preview, which took the lens
            away before the pointer arrived. The panel is what "still looking at this cell" means.
        *@
        <div id="cellTree" class="cellTree" @onmouseleave="forgetCellPreview">
            @*
                The edge, to drag the panel wider or narrower.

                On the inner edge, which is the one a pointer arrives at from the drawing. It sets a variable
                rather than a width, because the selection panel steps aside by the same number - see
                sidebars.js. The drawing beside it is a flex item, so it simply takes what is left.

                Its own width goes back to the panel's default when it is shut and opened again: a drag is
                for the layout in front of you now, where the session is for the next one.
            *@
            <div class="sidebarGrabber sidebarGrabberRight"
                 data-sidebar-grab="cellTree"
                 data-sidebar-apply="svgWrapper"
                 data-sidebar-variable="--cell-tree"
                 data-sidebar-towards="right"
                 role="separator" aria-orientation="vertical"
                 title="Drag to resize"></div>

            @*The layer list's heading, which is the same heading - see .sidebarTitle.*@
            <div class="sidebarTitle">
                <b>Cells</b>

                <button id="cellTreeClose" class="cellListClose"
                        @onclick="OnCellTreeClosed"
                        aria-label="Close the cell tree"
                        title="Close">&#128473;</button>
            </div>

            <div class="cellTreeRows">
                @if (Gds is null)
                {
                    <div class="cellTreeNone">No file open</div>
                }
                else
                {
                    @*Drawn again only when something they show has changed - see treeLooks.*@
                    <KeptUntilChanged Stamp="@treeLooks()">
                        @foreach (var row in treeRows())
                        {
                            @treeRow(row)
                        }
                    </KeptUntilChanged>
                }
            </div>

            @*
                The cell under the pointer, drawn.

                The same picture the library shows, from the same previewCell and the same cache - the rows
                already ask for it, since both panels draw the same row. What was missing was somewhere in
                this one to put it.

                **Under the rows rather than beside them.** The library's hangs off the side because that
                panel is pinned to the right of the view and has the whole canvas to grow into. This one is
                the left edge, and a picture growing right from it would cross the layout somebody is
                looking at. Under, it costs the bottom of a panel that is already there.

                Only while a row is being looked at, and it takes the rows' space rather than adding to it -
                so the panel is one height whether or not anything is under the pointer, instead of growing
                a picture and pushing its own rows up.
            *@
            @*
                **A picture, not markup**, since 2026-10-17, drawn at a pace and given up when the pointer moves on -
                see PreviewPictures. A chip's top cell is the whole chip, and its markup froze the page as the
                Examples list's did. While one is drawn the picture before it stays, faded after a moment, beside a
                note saying so.
            *@
            @*The edge over the picture, to drag it taller or shorter against the rows - asked for 2026-10-19. See sidebars.js.*@
            <div class="previewGrabber" data-sidebar-grab="cellTreePreview" data-sidebar-apply="cellTree" data-sidebar-variable="--cell-preview"
                 data-sidebar-axis="y" data-sidebar-towards="up" role="separator" aria-orientation="horizontal" title="Drag to resize the picture"></div>

            <div id="cellTreePreview" class="cellTreePreviewFrame @(cellPreviewDrawing ? "isDrawing" : "")">
                @if (cellPreviewFor.Length == 0)
                {
                    @*
                        Nothing is being pointed at, so there is nothing to draw - but the frame stays.

                        It used to come and go with the pointer, which meant the rows above it grew and shrank
                        by two hundred pixels as the pointer crossed the list: point at a row, everything
                        below it jumps, and the row under the pointer is now a different one. An empty frame
                        costs the space it was always going to take.
                    *@
                    <span class="cellPreviewEmpty">Point at a cell</span>
                }
                else if (cellPreviewPicture.Length > 0)
                {
                    <img class="cellPreview" src="@cellPreviewPicture" alt="Drawing of @cellPreviewShownFor" />
                }
                else if (!cellPreviewDrawn && !cellPreviewDrawing)
                {
                    @*Auto-generate preview is off, so the cell pointed at waits for this press - see AutoPreview.*@
                    <button id="cellPreviewGenerate" class="previewGenerate" @onclick="generateCellPreview"
                            title="Draw @cellPreviewFor">
                        <span class="previewGenerateSays">Generate preview</span>
                        <span class="previewGenerateName">@cellPreviewFor</span>
                    </button>
                }
                else if (!cellPreviewDrawing)
                {
                    @*A cell may hold nothing at all, and a library is allowed to contain one.*@
                    <span class="cellPreviewEmpty">@cellPreviewFor is empty</span>
                }

                @if (cellPreviewDrawing)
                {
                    <span class="previewDrawing" role="status">
                        <span class="viewLoadingSpinner" aria-hidden="true"></span>
                        <span>Drawing @cellPreviewFor</span>
                    </span>
                }

                @*
                    The lens, and the bigger picture it opens.

                    The panel is a column and its width is the column's, so the drawing in it is about as big
                    as a thumbnail gets - which is enough to tell two cells apart and not enough to read one.
                    The popup this panel replaced had three hundred pixels because it floated over the canvas
                    with room to spare.

                    So the room is borrowed rather than taken: pointing at the lens opens a square over the
                    layout beside the panel, and moving off it closes it. Nothing is docked, nothing is
                    remembered, and the tree stays the width it was.

                    On hover rather than on a press, because it is a look rather than a decision - the same
                    gesture the thumbnail underneath it already answers to. The button is still a button, so
                    it can be reached and fired from a keyboard, which hovering cannot be.
                *@
                @if (cellPreviewPicture.Length > 0)
                {
                    <button id="cellPreviewLens" class="cellPreviewLens"
                            @onmouseenter="() => showBigPreview(true)"
                            @onfocus="() => showBigPreview(true)"
                            @onmouseleave="() => showBigPreview(false)"
                            @onblur="() => showBigPreview(false)"
                            aria-label="See @cellPreviewShownFor larger"
                            title="See it larger">
                        @*A glass with a handle, which is what everything else calls "look closer".*@
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <circle cx="7" cy="7" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6" />
                            <path d="M10.3 10.3 14 14" fill="none" stroke="currentColor"
                                  stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </button>

                    @*The same picture, which is drawn the size of this one - see buildCellPreview.*@
                    @if (bigPreviewOpen)
                    {
                        <div id="cellPreviewLarge" class="cellPreviewLarge">
                            <img class="cellPreview" src="@cellPreviewPicture" alt="Drawing of @cellPreviewShownFor, larger" />
                        </div>
                    }
                }
            </div>

            @*
                Whether pointing at a row draws it, or the frame waits for a press - one switch with the text's list and the
                History and Examples previews, which the shell keeps. See AutoPreviewSwitch.
            *@
            <label class="previewAuto cellPreviewAuto" title="@AutoPreviewSwitch.Title">
                <input id="cellTreeAutoPreview" type="checkbox" checked="@AutoPreview" @onchange="autoPreviewToggled" />
                Auto-generate preview
            </label>
        </div>
    }
</div>

@code {
    #region Variables ****************************************

    private float opacity = 0.5f;
    private string svgString = "";
    private FlattenedLayout? layout = null;

    ///<summary>
    ///The file <see cref="layout"/> was built from, so the hierarchy is resolved once per file rather than
    ///once per redraw. Compared by reference: an edit produces a new library rather than changing one.
    ///</summary>
    private GDS? flattenedFrom = null;

    ///<summary>
    ///Whether the pointer is measuring rather than panning.
    ///
    ///Not saved into a session. A tool is what you are doing right now rather than how you left the file,
    ///and coming back to a layout already in a mode you have forgotten choosing is its own small puzzle.
    ///</summary>
    private bool measuring = false;

    ///<summary>Whether the pointer is picking shapes out rather than panning.</summary>
    private bool selecting = false;

    ///<summary>Whether the pointer is dragging out new rectangles.</summary>
    private bool drawingShapes = false;

    ///<summary>Which layer a drawn shape goes on. Set to the first the file has when drawing starts.</summary>
    private LayerKey drawOn = new LayerKey(0, 0);

    ///<summary>What the Draw tool makes.</summary>
    private enum DrawShape { Rectangle, Polygon, Ellipse, Path, Label, Writing }

    ///<summary>What a label says before anybody has said otherwise, so a click puts something readable down.</summary>
    private const string DefaultLabel = "label";

    ///
    ///The label being typed, by its place in the flattened layout, or minus one when none is.
    ///
    ///An index rather than the model, because that is what the browser can find the drawn node by - and the
    ///box has to be put where the label *is*, which only the page knows.
    ///
    ///Nothing here is saved into a session. A half-typed name is what you are in the middle of doing rather
    ///than how you left the file.
    ///
    private int retypingLabel = -1;

    ///<summary>Where the box goes, in pixels from the corner of the view. See labelBox in the interop.</summary>
    private (double X, double Y) retypingAt = (0, 0);

    ///<summary>What is in the box. Committed on Enter or on leaving it, dropped on Escape.</summary>
    private string retypingText = "";

    ///<summary>What it said before, so Escape has something to put back.</summary>
    private string retypingWas = "";

    ///<summary>Whether the box has yet to be given the keyboard. Set when it opens; see OnAfterRenderAsync.</summary>
    private bool focusRetypeBox = false;

    private ElementReference retypeBox;

    private DrawShape drawShape = DrawShape.Rectangle;

    ///<summary>
    ///How many sides stand in for an ellipse.
    ///
    ///**A layout format has no curves.** GDSII knows boundaries and paths and nothing else, so a circle on a
    ///chip is a many-sided polygon and always has been - which makes the number of sides a decision somebody
    ///has to make rather than something to hide behind a smooth preview. Sixty-four is within about a tenth
    ///of a percent of round, and a via that only ever gets a dozen is a real thing to want.
    ///</summary>
    private int ellipseSides = 64;

    ///<summary>Fewer than three is not a shape; more than this is a file nobody wanted.</summary>
    private const int FewestSides = 3;

    private const int MostSides = 512;

    ///<summary>Whether the grid is drawn. Saved into a session: it is how you left the file, not what you are doing.</summary>
    private bool showGrid = true;

    ///<summary>
    ///Whether the pointer lands on the grid.
    ///
    ///Apart from whether the grid is *drawn*, because the two are genuinely different wants: snapping to a
    ///pitch you know without a grid over the geometry is common, and so is a grid to read distances against
    ///while placing something off it.
    ///</summary>
    private bool snapping = true;

    ///<summary>
    ///Whether the pointer lands on the corners and edges of shapes already drawn.
    ///
    ///Apart from the grid, and ahead of it: somebody holding the pointer over a corner means that corner,
    ///and rounding to the nearest grid crossing afterwards would put it a fraction off with nothing to say
    ///why. Butting one shape against another exactly is the thing a grid cannot do.
    ///</summary>
    private bool snapToShapes = false;

    ///<summary>
    ///Whether a drawn shape becomes one with what it lands on, on the same layer.
    ///
    ///Off by default. A drawn shape staying the shape that was drawn is what somebody who has not asked for
    ///anything else means, and the union is not reversible by drawing: undo takes it back, but nothing else
    ///can say afterwards where one stroke ended and the next began.
    ///</summary>
    private bool joining = false;

    ///
    ///How far apart the grid lines are, in microns.
    ///
    ///In microns rather than in database units because that is the unit anybody laying out a chip thinks
    ///in - a contact is 0.2 of one, a standard cell a few. The file's own UNITS record says how many
    ///database units that is, which is the only place the two meet; see <see cref="gridUnits"/>. It is held
    ///in microns whatever the box beside it is showing; see <see cref="gridUnit"/>.
    ///
    ///**A round number rather than the file's own grid**, which was tried and is worse. <see cref="Grid"/>
    ///reads the real one back out of the coordinates - five database units on Mosfet - and defaulting to it
    ///drew 178 lines across the view where a micron draws six, which is a wash rather than a grid. It also
    ///took the tenth-line reading, the level of detail and the corner-beats-grid precedence out of view at
    ///the default zoom, all three of which the grid exists for.
    ///
    ///And the reason for doing it did not survive checking: snapping to a micron lands on multiples of a
    ///thousand database units, and a thousand divides by five, so a point placed on this grid was already on
    ///the file's own. Nothing was ever put off-grid. What the file's grid is worth is *saying* - see
    ///gridDescription - not being snapped to.
    ///
    private double gridMicrons = 1;

    ///
    ///Whether the pitch above was typed by somebody rather than worked out from the file.
    ///
    ///The pitch follows the file until it is taken over, and then it stays taken over. Saved, because a
    ///choice that reverted the next time a file was opened would be worse than not offering it - and it is
    ///the *fact of having chosen* that is saved, not just the number: the number alone cannot say whether
    ///it came from a person or from the last file, and only one of those should survive the next one.
    ///
    private bool pitchChosen = false;

    ///<summary>What a grid pitch can be typed and read in.</summary>
    private enum GridUnit { Nanometer, Micron, Millimeter, DatabaseUnit }

    ///
    ///Which of those the box beside the pitch is showing.
    ///
    ///**A way of writing the pitch, not the pitch.** Choosing one re-expresses the same distance - a grid at
    ///one micron reads 1000 the moment nanometers are picked, and the lines do not move. The number typed
    ///afterwards is read in whatever is chosen, and turned back into microns on the way in, so nothing below
    ///this needs to know a unit was ever chosen.
    ///
    ///Database units are in the list because the file's own grid is quoted in them - the readout says
    ///Mosfet is drawn on five - and typing five somewhere you can see that number is the point of having it.
    ///A file whose UNITS say nothing usable has no conversion to offer, so a database unit is taken as a
    ///micron there, which is the same fiction <see cref="gridUnits"/> already keeps.
    ///
    private GridUnit gridUnit = GridUnit.Micron;

    ///<summary>
    ///What is picked out, by place in the flattened layout.
    ///
    ///Indexes rather than elements, because that is what the view marks shapes by and what a rubber band
    ///comes back as - and holding both would be two answers to keep in step.
    ///</summary>
    private List<int> chosenIndexes = new List<int>();

    ///<summary>The chosen shapes themselves, in the order they were picked.</summary>
    private IEnumerable<Element> Chosen
    {
        get
        {
            if (layout is null)
                yield break;

            foreach (int index in chosenIndexes)
            {
                if (index >= 0 && index < layout.Elements.Count)
                    yield return layout.Elements[index];
            }
        }
    }

    ///
    ///The chosen shapes as the library holds them, each once and with the cell it is in - for the assistant, which
    ///is told what is selected in the numbers its tools use.
    ///
    ///**Once each**, because a shape in a cell placed four times is four elements on screen and one in the file, and
    ///"#7, #7, #7, #7" would read as four shapes.
    ///
    public IReadOnlyList<(GDS.ElementModel Model, string Cell)> ChosenShapes
    {
        get
        {
            var shapes = new List<(GDS.ElementModel, string)>();
            var seen = new HashSet<GDS.ElementModel>(ReferenceEqualityComparer.Instance);

            foreach (var element in Chosen)
            {
                if (element.Source is ElementSource source && seen.Add(source.Model))
                    shapes.Add((source.Model, source.Structure));
            }

            return shapes;
        }
    }

    ///<summary>The cell being edited and the placement it is looked at through, or null when the whole layout is being looked at.</summary>
    public CellContext? EditingContext
    {
        get { return context; }
    }

    ///<summary>The one chosen shape, or null when none or several are - which most of the panel is about.</summary>
    private Element? Only
    {
        get
        {
            if (chosenIndexes.Count != 1)
                return null;

            return Chosen.FirstOrDefault();
        }
    }

    ///<summary>What an edit would act on: the chosen shapes the current cell actually holds.</summary>
    private List<Element> Editable
    {
        get
        {
            if (context is null)
                return new List<Element>();

            return Chosen.Where(context.Holds).ToList();
        }
    }

    ///<summary>
    ///Which cell is being edited, or null when the whole layout is simply being looked at.
    ///
    ///Not saved into a session, for the same reason the tool is not: it is where you are in the file right
    ///now, and coming back to a layout already inside a cell you have forgotten descending into is its own
    ///small puzzle.
    ///</summary>
    private CellContext? context = null;

    ///<summary>Why the last gesture was refused or done differently from how it was asked, or empty. Shown where the hints are.</summary>
    private string drawRefusal = "";

    ///
    ///The file's one top cell, or null where it does not have exactly one.
    ///
    ///A top is a cell nothing places, so it is what the flattener draws on its own account. Files written
    ///by a tool usually have one and it is the thing the file is about; a library can have several, and
    ///then "the top cell" is not a fact about the file but a question for whoever opened it.
    ///
    private string? onlyTopCell()
    {
        if (Gds is null)
            return null;

        string? only = null;

        foreach (var summary in Hierarchy.Summarize(Gds))
        {
            if (!summary.IsTop)
                continue;

            if (only is not null)
                return null;

            only = summary.Name;
        }

        return only;
    }

    ///<summary>
    ///How many times the cell being edited is placed, which is the multiplier on an edit. Counted when the
    ///context changes rather than on every render.
    ///</summary>
    private int placements = 0;

    ///<summary>
    ///What has been changed and what can be taken back.
    ///
    ///**The shell's, not this view's.** An undo stack belongs to the file rather than to whichever view
    ///happens to be on screen: this component is destroyed and rebuilt every time somebody looks at the 3D
    ///view and comes back, and a history that lived here went with it. It is also what the shell writes into
    ///a session, which is what lets it outlive the page.
    ///
    ///Defaulted rather than left null so the toolbar can read it during the first render, before the shell
    ///has handed one over.
    ///</summary>
    [Parameter]
    public EditHistory History { get; set; } = new EditHistory();

    ///<summary>
    ///The handle JS calls back through.
    ///
    ///Held so it can be disposed: a DotNetObjectReference pins the component on the managed side until it
    ///is, so leaving the view without releasing it keeps this instance and the file it holds alive for as
    ///long as the tab is open.
    ///</summary>
    private DotNetObjectReference<Viewer2DSvg>? selectionHandle;

    ///<summary>The same, for the drawing tool. Two rather than one shared, so each is released with its own tool.</summary>
    private DotNetObjectReference<Viewer2DSvg>? drawHandle;

    ///<summary>
    ///And one for the keyboard, which belongs to the view rather than to any tool - a shortcut is another way
    ///to press a button that is already there, and the buttons are not all one tool's.
    ///</summary>
    private DotNetObjectReference<Viewer2DSvg>? keyHandle;

    //Null until the shell has a file open, which is the state the view starts in.
    ///
    ///Whether the page hosting this has said the file may not be changed.
    ///
    ///**Every control that would change it is turned off rather than taken away.** A missing button leaves
    ///somebody wondering whether the app can do the thing at all; one that is visibly off says the page has
    ///decided, which is the true statement. The tooltips say so in words.
    ///
    ///Pan, Measure and Select stay: they read the layout rather than change it, and a viewer you cannot
    ///measure with or ask what a shape is on is most of the way to being a picture.
    ///
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public GDS? Gds { get; set; }

    ///
    ///The flattened layout the shell already has for <see cref="Gds"/>, or null when it has none current.
    ///
    ///**A parameter rather than an argument, because of when it is needed.** `Render` takes one too, and for
    ///every call the shell makes that is enough - but a view builds itself before the shell can call
    ///anything, and `OnInitializedAsync` renders. Passing nothing there meant a view entered for the second
    ///time resolved the whole hierarchy for itself and the shell's own call arrived afterwards, carrying the
    ///layout it had kept all along, too late to save the work. Blazor sets parameters before it initializes
    ///a component, which is exactly the ordering this needs.
    ///
    ///Read once, on the way in. Nothing re-renders when it changes: the shell calls `Render` for that, and a
    ///view that redrew itself whenever the shell re-flattened would draw twice for every edit.
    ///
    [Parameter]
    public FlattenedLayout? Prepared { get; set; }

    ///
    ///Asks the shell for its load in hand, or null - what a large layout's first picture is drawn at the pace of, so
    ///the page answers while it is written out and Cancel can stop it. See drawFirstPicture and Pacer.
    ///
    ///**Asked when a file arrives, rather than handed over as a value**, which is only as new as the shell's last
    ///render: a load can begin and put its file in before the shell renders again - New pressed while a big file
    ///loads does - and the view would draw at the pace of the load before it, which that one had just canceled.
    ///
    [Parameter]
    public Func<Pacer?>? Loading { get; set; }

    [Parameter]
    public List<CheckboxItem>? ShowLayers { get; set; }

    ///
    ///The layers anything that picks may take a shape from: drawn, and not locked.
    ///
    ///**Hidden as well as locked.** <see cref="CheckboxItem.EditableLayers"/> is the set HitTest has always
    ///handed Picking.At, and a band and Select All asked only about the lock - on the reading that whether
    ///a band should skip a hidden layer was not a lock's business. So a band caught shapes nobody could see,
    ///by their boxes, and they came back as dashed outlines over empty canvas. A click with a pixel of
    ///movement in it is a band, so to somebody pressing on a hidden layer's patch of the drawing it was a
    ///click choosing six layers' worth of shapes they had put away. A layer that is not on the canvas is not
    ///in reach, which is the rule the click already kept.
    ///
    ///**The fade alone does not do it.** Whether a shape can be chosen is settled here, in C#, by
    ///<see cref="Picking.At"/> walking the layout - the browser only reports where the pointer was. So a
    ///`pointer-events` rule over the drawing grays the shapes out and changes nothing about which of them
    ///answers: they go pale and go on being picked up and dragged around. That was measured, the hard way.
    ///
    ///Null with no layer list, which is every layer. Built once per gesture and asked per element through
    ///<see cref="Picking.InReach"/>: a band over a large layout asks about every element in it.
    ///
    private IReadOnlySet<LayerKey>? reachableLayers()
    {
        if (ShowLayers is null)
            return null;

        return CheckboxItem.EditableLayers(ShowLayers);
    }

    ///<summary>
    ///Design rule markers, as markup to lay over the drawing. Empty when no check has been run.
    ///
    ///**Markup rather than the violations themselves**, because the shell is what runs a check and what
    ///holds the deck, and this view's job is to draw. Handing down a built string keeps the drawing side
    ///free of any opinion about what a rule is - and it is what lets Blazor draw the markers, next to
    ///<see cref="svgString"/>, instead of a second thing put on the DOM afterwards, which is how the
    ///selection highlight works and why that one has to be reapplied after every redraw.
    ///</summary>
    [Parameter]
    public string Markers { get; set; } = "";

    ///<summary>The markers on screen, so a change to the parameter is told from a re-render.</summary>
    private string markersDrawn = "";

    ///<summary>
    ///What the last rule check found, in one line, or empty when none has been run.
    ///
    ///**Over the drawing, where the drawing hint goes**, because it is the same kind of statement: one
    ///line about what you are looking at right now, that appears and goes away. The faults themselves are
    ///the markers - this is the part a marker cannot say, which is how many there are and whether every
    ///rule actually ran.
    ///
    ///A string rather than the result, for the same reason <see cref="Markers"/> is markup: the shell
    ///holds the deck and runs the check, and this view draws.
    ///</summary>
    [Parameter]
    public string Notice { get; set; } = "";

    ///<summary>
    ///Whether that notice is bad news, so it can be colored like the markers rather than like a hint.
    ///</summary>
    [Parameter]
    public bool NoticeIsFault { get; set; }

    ///<summary>
    ///The rule deck in force, or null. **Only for its grid** - see <see cref="deckGrid"/>. The shell holds the
    ///deck and runs the check, as it does for <see cref="Markers"/>.
    ///</summary>
    [Parameter]
    public DrcDeck? Deck { get; set; }

    ///
    ///The grid the deck asks a layer's corners to sit on, for the corners a tool here works out rather than the
    ///ones somebody places: an ellipse's, a rounded or cut corner's, the squares of writing and pictures, a mark's
    ///curves, a path's outline where it slants or ends round. One - the database unit, which is where they always
    ///went - while snapping is off, with no deck, or where the deck asks nothing of the layer.
    ///
    ///**Snapping is the switch for it.** Snapping is what puts a placed corner on a grid, and these are the
    ///corners nobody placed: with it on they go where the check wants them, the grid the assistant's tools draw
    ///on - see <see cref="DrcDeck.GridFor"/>. Rounded to the database unit, a worked-out corner is nearly always
    ///between two grid points, and a circle on sky130 broke `grid.1` at most of its corners.
    ///
    private int deckGrid(LayerKey layer)
    {
        if (!snapping || Deck is null)
            return 1;

        return Deck.GridFor(layer);
    }

    ///<summary>That grid the way a refusal says it: "the deck's 0.005 µm grid (grid.1)".</summary>
    private string deckGridSaid(LayerKey layer)
    {
        int grid = deckGrid(layer);
        string rules = "";

        if (Deck is not null)
            rules = string.Join(" and ", Deck.GridRulesFor(layer).Select(rule => rule.Id));

        if (micronsPerUnit() is double scale && scale > 0)
            return FormattableString.Invariant($"the deck's {grid * scale:0.######} µm grid ({rules})");

        return FormattableString.Invariant($"the deck's {grid}-unit grid ({rules})");
    }

    ///<summary>A size worked out in database units as a whole number of the deck's grid steps on the layer being drawn on, and never none.</summary>
    private int onDeckGrid(int units)
    {
        int grid = deckGrid(drawOn);

        return Math.Max(grid, Grid.Snap(units, grid));
    }

    ///<summary>Whether an outline put on a grid has stopped being a shape: fewer than three corners, crossing itself, or covering nothing.</summary>
    private static bool notAShape(IReadOnlyList<Element.Point> outline)
    {
        return outline.Distinct().Count() < 3 || Grid.Crossing(outline) is not null || Measure.AreaOf(outline) == 0;
    }

    ///
    ///What a set operation or a grow made, put on the deck's grid of the layer it goes on - or null, with the
    ///reason on the refusal line, when the grid would fold a piece of it.
    ///
    ///**Every corner of it is worked out**, so it goes on the grid as an ellipse's does while snapping is on - see
    ///deckGrid. A boolean puts a corner wherever two edges cross, at the nearest database unit, and a grow moves
    ///every edge there is; a corner kept from a shape that went in is on the grid already if the shape was. See
    ///Grid.SnapAll.
    ///
    ///**A piece narrower than a step all along is left out**, and the line says so: on the grid it is a line. A
    ///fold is the grid moving a corner across an edge it was within a step of, at a sharp point or a narrow neck,
    ///and the piece it spoils is part of the answer - so <paramref name="instead"/> is what happens then, which the
    ///line leads with.
    ///
    private List<List<Element.Point>>? ontoDeckGrid(List<List<Element.Point>> made, LayerKey layer, string instead)
    {
        int grid = deckGrid(layer);

        if (grid <= 1)
            return made;

        var snapped = Grid.SnapAll(made, grid);

        if (snapped.Fold is not null)
        {
            drawRefusal = $"{instead}: on {deckGridSaid(layer)} the result would cross itself, a corner within a step of an edge landing across it. Turn snapping off to make it on the database unit.";

            return null;
        }

        if (snapped.Flattened == 1)
            drawRefusal = $"One piece narrower than a step of {deckGridSaid(layer)} was left out.";
        else if (snapped.Flattened > 1)
            drawRefusal = $"{snapped.Flattened} pieces narrower than a step of {deckGridSaid(layer)} were left out.";

        return snapped.Outlines;
    }

    ///<summary>
    ///Raised when the cross on that notice is pressed. The shell holds the text, so it is what clears it.
    ///</summary>
    [Parameter]
    public EventCallback OnNoticeDismissed { get; set; }

    private async Task dismissNotice()
    {
        await OnNoticeDismissed.InvokeAsync();
    }

    ///<summary>
    ///Takes the Draw refusal off the drawing. This view's own line, so it is put away here rather than
    ///through the shell the way the rule check's is.
    ///</summary>
    private void dismissDrawRefusal()
    {
        drawRefusal = "";
    }

    ///<summary>
    ///Raised when one of this view's own controls moves, so the shell can keep the session current.
    ///
    ///The shell cannot see these otherwise - a slider lives in the view that owns it and re-renders only
    ///itself - so without this an opacity was written to a session solely by chance, whenever something
    ///else happened to trigger a save afterwards.
    ///</summary>
    [Parameter]
    public EventCallback OnSettingsChanged { get; set; }

    ///<summary>
    ///Raised when the active tool changes, so the shell redraws the bar the buttons are in.
    ///
    ///**This view's own StateHasChanged cannot do it.** The toolbar is a RenderFragment the *shell*
    ///renders, so which button looks pressed is decided during the shell's render rather than this
    ///component's - and switching tools left the highlight on the one that was pressed before.
    ///
    ///Held apart from <see cref="OnSettingsChanged"/> rather than reusing it, because that one saves a
    ///session and a tool is not part of one: it is what you are doing now, not how you left the file.
    ///</summary>
    [Parameter]
    public EventCallback OnToolChanged { get; set; }

    ///<summary>
    ///Raised when an edit changes the file, so the shell saves it and the other views see it.
    ///
    ///The same callback the text editor's save uses: both change the same records, and what has to happen
    ///afterwards is the same either way.
    ///</summary>
    [Parameter]
    public EventCallback OnFileChanged { get; set; }

    ///
    ///Raised once a file's first picture is on the page, so the shell can take down the note that says it is
    ///loading. Once per file: a pan or an edit redraws without anybody waiting on it.
    ///
    [Parameter]
    public EventCallback OnDrawn { get; set; }

    ///<summary>Whether a file has arrived whose first picture the shell has not been told about yet.</summary>
    private bool announceDrawn = false;

    ///<summary>This view's own toolbar controls. The shell renders them; it does not know what they are.</summary>
    public RenderFragment Toolbar => (__builder) =>
    {
        @*
            The tools, of which pan is the one the view is in when nothing else is chosen. One group
            because they are mutually exclusive - the pointer can only be doing one thing - and the
            first of what will be several once there is something to edit.
        *@
        @*
            Named, because the highlight style is shared with the other groups of alternatives beside it -
            which shape a drawn thing is, whether the grid is on - and "exactly one tool is lit" is a
            question about these four and not about every pressed button in the bar.
        *@
        @*
            Pictures rather than words.

            Five words is the widest group in the bar, on the one row the whole app has to share, and none of
            the five was earning its width: a hand, a dimension line, a pointer, four arrows and a pencil are
            the icons every drawing program has used for these since drawing programs had icons. The word
            moves to aria-label, where a reader still says it, and the tooltip keeps the whole sentence and
            the shortcut - which is the part a word never said.

            **Not the same class the undo arrows carry, exactly.** Those are lit all the time; these are lit
            one at a time, and which one is the only thing this group says. toolButtonOn stays conditional.
        *@
        @*
            The gap that says the tools are a group ends after Merge, which is always in the bar now whether
            or not it is drawn - so the fence lives on that column and this one never carries it.
        *@
        @*
            Two things hang off this column - the library from the book and the shape choices from the
            pencil - and both go when the pointer does. One handler, because leaving the column is one
            gesture however many panels happen to be open under it.
        *@
        <div class="col-1 toolbarItem toolbarTools toolbarPopupHost" style="align-self: end;" @onmouseleave="leaveTools">
            @*
                No word over them.

                Every other column in the bar is named because its controls are words too and the label is
                what tells one group of words from the next. These are pictures, which is the one case where
                a heading is the only text in the column and reads as the loudest thing in it - and "Tool"
                over a hand, a ruler and a pencil is a caption on something nobody needed captioned.
            *@
            <div id="toolGroup" class="toolGroup">
                <button id="panTool" class="buttonStyle2 toolbarButton toolButton buttonIcon @(measuring || selecting || drawingShapes ? "" : "toolButtonOn")"
                        @onclick="usePan"
                        aria-label="Pan"
                        title="Drag to pan the layout, scroll to zoom (P)">
                    @*A hand, which is what the pointer becomes.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.3"
                              stroke-linecap="round" stroke-linejoin="round"
                              d="M4.6 8.6V5.1a1.15 1.15 0 1 1 2.3 0v2.6M6.9 7.7V4.1a1.15 1.15 0 1 1 2.3 0v3.6M9.2 7.7V4.8a1.15 1.15 0 1 1 2.3 0v2.9M11.5 7.9V6.3a1.15 1.15 0 1 1 2.3 0v4.1c0 2.3-1.9 4.1-4.2 4.1H8.3c-1.3 0-2-.4-2.6-1.2L3 9.8a1.15 1.15 0 0 1 1.9-1.3z" />
                    </svg>
                </button>

                <button id="measureTool" class="buttonStyle2 toolbarButton toolButton buttonIcon @(measuring ? "toolButtonOn" : "")"
                        @onclick="startMeasuring"
                        aria-label="Measure"
                        title="Click once to start a measurement and again to finish it. Distances are in database units and microns (M)">
                    @*A dimension line: the distance between two ends, which is what it reports.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.5"
                              stroke-linecap="round"
                              d="M2.4 8h11.2M2.4 4.6v6.8M13.6 4.6v6.8" />
                    </svg>
                </button>

                <button id="selectTool" class="buttonStyle2 toolbarButton toolButton buttonIcon @(selecting && !moving ? "toolButtonOn" : "")"
                        @onclick="startSelecting"
                        aria-label="Select"
                        title="Click a shape to see which cell it belongs to, what it is on and how big it is (S)">
                    @*The pointer itself, filled - an outlined cursor at fifteen pixels is a shape nobody reads.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="currentColor"
                              d="M3.4 1.9v11.4l3-3 1.9 4.1 1.9-.9-1.9-4 4.1-.2z" />
                    </svg>
                </button>

                <button id="moveTool" class="buttonStyle2 toolbarButton toolButton buttonIcon @(moving ? "toolButtonOn" : "")"
                        @onclick="startMoving"
                        disabled="@ReadOnly"
                        aria-label="Move"
                        title="Click a shape and drag it. The whole shape moves, and its corners cannot be pulled out of it by accident (V)">
                    @*Four ways at once, which is the difference from dragging a corner.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.4"
                              stroke-linecap="round" stroke-linejoin="round"
                              d="M8 1.8v12.4M1.8 8h12.4M8 1.8 6 3.8M8 1.8l2 2M8 14.2l-2-2M8 14.2l2-2M1.8 8l2-2M1.8 8l2 2M14.2 8l-2-2M14.2 8l-2 2" />
                    </svg>
                </button>

                @*
                    **Shown always, and usable only inside a cell.**

                    It used to be left out entirely until a cell was being edited, on the grounds that a
                    Draw tool which could not draw is a puzzle rather than a control. The puzzle is worse
                    the other way round: five icons become four, the row changes width, and the one that
                    went is the one somebody was looking for - which reads as the button having been taken
                    away rather than as it not applying yet.

                    It was disabled next, with the tooltip carrying the reason. Better, but a tooltip is
                    read by somebody who already suspects there is something to read - and pressing a
                    disabled button produces nothing at all, which is the same silence the missing button
                    had. It is live now and answers when pressed, in the same place the drawing hints are
                    said. See startDrawingShapes.

                    Still disabled where editing itself is off, which is a fact about the whole app and not
                    about this file's cells - there is no way out of it to describe.
                *@
                <button id="drawTool" class="buttonStyle2 toolbarButton toolButton buttonIcon @(drawingShapes ? "toolButtonOn" : "")"
                        @onclick="startDrawingShapes"
                        @onmouseenter="showShapeMenu"
                        disabled="@ReadOnly"
                        aria-label="Draw"
                        aria-expanded="@(drawingShapes && shapeMenuOpen ? "true" : "false")"
                        title="@drawDescription()">
                    @*A pencil, which is the one of these five that adds something.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.4"
                              stroke-linecap="round" stroke-linejoin="round"
                              d="M2.6 13.4h2.6l8-8a1.85 1.85 0 0 0-2.6-2.6l-8 8zM10.2 3.6l2.2 2.2" />
                    </svg>
                </button>
            </div>

            @*
                Where the Draw menu's Image row gets its file from.

                **Out here rather than in the menu**, which only exists while it is open. The menu closes as the
                pointer leaves it, and the pointer leaves it to answer the file dialog - so an input inside
                would be gone by the time there was a file for it, taking the change event with it.
            *@
            <InputFile id="stampPicture" style="display: none;" accept="image/*" OnChange="pictureChosen" />

            @*
                Which shape the pencil draws, under the pencil.

                It was a column of five words in the bar - Rectangle, Polygon, Ellipse, Path, Label - which
                is the widest thing the bar ever carried and was there for as long as the tool was, whether
                or not anybody was about to change it. It belongs to the pencil rather than beside it, so it
                hangs from the pencil and goes away when the answer has been given.

                Opened by choosing Draw and by pointing at it, closed by a press anywhere else - see
                onDismissBarMenus in the interop, which does not swallow that press. A press meant for the canvas draws and
                closes this on the way past, which is what dismissing on a click ought to mean.
            *@
            @if (drawingShapes && shapeMenuOpen)
            {
                @*
                    A drawing of each, in front of its name.

                    Five words in a column is a list you have to read; the shapes they name are the one thing
                    about them that can be shown rather than said. Drawn inline in the same 16-unit box and
                    the same 1.4 stroke as every icon in the bar, so they take the line's own color and stay
                    sharp at any zoom - and so the one that is chosen goes white with the word it belongs to.
                *@
                <div id="shapePicker" class="shapePicker" role="group" aria-label="Shape">
                    <button id="rectangleShape" class="shapePick @(drawShape == DrawShape.Rectangle && !carryingAnything ? "shapePickOn" : "")"
                            @onclick="() => useShape(DrawShape.Rectangle)"
                            title="Drag out a rectangle">
                        <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <rect x="2.2" y="3.8" width="11.6" height="8.4" rx="0.6"
                                  fill="none" stroke="currentColor" stroke-width="1.4" />
                        </svg>
                        Rectangle
                    </button>

                    <button id="polygonShape" class="shapePick @(drawShape == DrawShape.Polygon && !carryingAnything ? "shapePickOn" : "")"
                            @onclick="() => useShape(DrawShape.Polygon)"
                            title="Click each corner. Click the first one again, double-click or press Enter to close it">
                        @*Five sides, which is the fewest that reads as "polygon" rather than as a triangle or a box.*@
                        <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <path d="M8 2.1 14.3 6.7 11.9 14H4.1L1.7 6.7z"
                                  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        </svg>
                        Polygon
                    </button>

                    @*
                        A shape with settings of its own carries them on its own row.

                        **They used to be in the toolbar.** Width, µm and the ends picker appeared up there
                        the moment Path was chosen, and Sides when Ellipse was - so the bar changed shape
                        under everything else in it depending on which shape was in hand, and the widest
                        thing it ever carried was there for a shape somebody had already finished choosing.
                        A property of a shape belongs to that shape, and the row naming it is where it is.

                        Held open by :hover and :focus-within rather than by a flag, the same way the menu
                        over the shapes holds its submenus - see .shapeMenuOpens. A panel that lives in state
                        has to be told when to close as well, which means every way of leaving it, and
                        getting one of those wrong leaves it hanging over the bar.

                        The panel is a *child* of the picker, which is what keeps the picker open while the
                        pointer is in it: these close on mouse-out, and an absolutely positioned child is
                        still a descendant, so the leave never fires. Same reason the two file lists are
                        rendered inside the column their buttons are in.
                    *@
                    <div class="shapePickOpens">
                        <button id="ellipseShape" class="shapePick @(drawShape == DrawShape.Ellipse && !carryingAnything ? "shapePickOn" : "")"
                                @onclick="() => useShape(DrawShape.Ellipse)"
                                title="Drag out an ellipse. Hold Shift while dragging for a circle">
                            @*Wider than it is tall, or it is a circle - and a circle is what Shift gets you.*@
                            <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                <ellipse cx="8" cy="8" rx="6.2" ry="4.4"
                                         fill="none" stroke="currentColor" stroke-width="1.4" />
                            </svg>
                            Ellipse

                            <span class="shapePickArrow" aria-hidden="true">&#8250;</span>
                        </button>

                        @*
                            How round a round thing is, which is a decision and not a detail: the format has
                            no curves, so an ellipse is however many sides somebody asked for.
                        *@
                        <div class="shapePickPanel" @onclick:stopPropagation="true">
                            <label class="shapePickField">
                                <span>Sides</span>

                                <input id="ellipseSides" class="gridPitch" type="number" min="@FewestSides" max="@MostSides" step="4"
                                       value="@ellipseSides" @onchange="changeEllipseSides"
                                       title="How many straight sides stand in for the curve" />

                                <span class="gridUnit" title="@sidesDescription()">&#8776;</span>
                            </label>
                        </div>
                    </div>

                    <div class="shapePickOpens">
                        <button id="pathShape" class="shapePick @(drawShape == DrawShape.Path && !carryingAnything ? "shapePickOn" : "")"
                                @onclick="() => useShape(DrawShape.Path)"
                                title="Click each turn of a wire. Click the last point again, double-click or press Enter to end it">
                            @*Open and turning, with the round ends and corners a drawn path actually has.*@
                            <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                <path d="M2 12.4 6 6.6l3.4 3.2L14 3.8"
                                      fill="none" stroke="currentColor" stroke-width="1.6"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Path

                            <span class="shapePickArrow" aria-hidden="true">&#8250;</span>
                        </button>

                        @*
                            How wide the wire is, and how its ends are finished. In real units like everything
                            else typed into this view - a path's width is a dimension of the thing being made,
                            and nobody routes by counting database units.
                        *@
                        <div class="shapePickPanel" @onclick:stopPropagation="true">
                            <label class="shapePickField">
                                <span>Width</span>

                                <input id="pathWidth" class="gridPitch" type="number" min="0" step="0.01"
                                       value="@SvgWriter.FormatNumber(pathWidthMicrons)" @onchange="changePathWidth"
                                       title="How wide the path is drawn. Zero is a hairline, which is what a path with no width record means" />

                                <span class="gridUnit">&#181;m</span>
                            </label>

                            <label class="shapePickField">
                                <span>Ends</span>

                                <select id="pathEnds" value="@pathEnds" @onchange="changePathEnds"
                                        title="How the two ends are finished">
                                    <option value="@Paths.Ends.Flush">flush</option>
                                    <option value="@Paths.Ends.Round">round</option>
                                    <option value="@Paths.Ends.Extended">extended</option>
                                </select>
                            </label>
                        </div>
                    </div>

                    <button id="labelShape" class="shapePick @(drawShape == DrawShape.Label && !carryingAnything ? "shapePickOn" : "")"
                            @onclick="() => useShape(DrawShape.Label)"
                            title="Type a label and click to place it, centered on where you clicked">
                        @*A letter, because the thing this places is writing and nothing else here is.*@
                        <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <path d="M3.3 13.2 8 2.8l4.7 10.4M5.4 9.8h5.2"
                                  fill="none" stroke="currentColor" stroke-width="1.4"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Label
                    </button>

                    @*
                        Writing as shapes, which is a different thing from a label.

                        A label is a string attached to a point - a pin name, a net - that a viewer draws and a
                        mask does not. This is lettering on the chip itself: the words drawn in squares on the
                        layer being drawn on, as boundaries, which is how a part number or a name gets onto
                        silicon. See PixelFont for why squares.

                        **Placed the way a label is** (2026-10-19): a click puts it down reading "Text", with a box
                        under it for the words and a frame round it whose corner sizes it - see OnWritingPlaced. It
                        was typed into a box here with a height beside it, written, and carried to where it went.
                        Words pasted onto the drawing are written the same way; see OnTextPasted.
                    *@
                    <button id="textShape" class="shapePick @(drawShape == DrawShape.Writing && !carryingAnything ? "shapePickOn" : "")"
                            @onclick="() => useShape(DrawShape.Writing)"
                            title="Write text as shapes on the layer being drawn on: click where it goes and type it. Words pasted onto the drawing are written too">
                        @*A capital in outline, block-cut: a letter that is a shape, where Label's is a stroke.*@
                        <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <path d="M2.4 2.4h11.2v3.2H9.6v8H6.4v-8h-4z"
                                  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        </svg>
                        Text
                    </button>

                    @*
                        A picture as shapes - a logo, for a corner of the die.

                        Read by the browser, which is the only thing here that can open a PNG, into squares - its dark
                        parts, its light ones or whatever is not see-through, whichever its border says is not the
                        ground (see drawnSide) - and the squares merged into outlines on the layer being drawn on.

                        **The row opens the file dialog**, and the picture lands in the middle of the view with a
                        frame round it whose corner sizes it - 2026-10-19, in place of boxes for the size of a square,
                        the squares across and which side is the shape. One dropped on the drawing lands where it was
                        let go, and one pasted where the pointer is. See pictureChosen.

                        The file input itself is outside the menu - see stampPicture - because the menu closes when
                        the pointer leaves it, and an input removed while its dialog is open has nowhere to deliver
                        the file to.
                    *@
                    <label id="imageShape" for="stampPicture" class="shapePick"
                           title="Turn a picture - a logo, say - into shapes on the layer being drawn on. Dropping one onto the drawing, or pasting one, does the same">
                        @*A picture, the way every app draws one: a frame, a hill and a sun.*@
                        <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                            <rect x="1.7" y="2.7" width="12.6" height="10.6" rx="1.2"
                                  fill="none" stroke="currentColor" stroke-width="1.4" />
                            <path d="M3.6 11.4 6.8 7.8l2.4 2.4 1.5-1.5 1.9 2.7"
                                  fill="none" stroke="currentColor" stroke-width="1.3"
                                  stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="10.6" cy="5.6" r="1.1" fill="currentColor" />
                        </svg>
                        Image
                    </label>

                    @*
                        A structure made from its numbers: a die frame, the crosses a mask is aligned by, a structure a
                        process is checked with, an inductor, a coupler, an antenna, a clock tree, pads, a ring resonator, a
                        channel. See Marks in the library.

                        **Generator rather than Mark** (2026-10-21): four of the ten are marks, and the row is a way of
                        making any of them from a few numbers - what a layout editor calls a parametric cell, put down
                        here as shapes. Only the words changed; the library, the ids and a kind's key are as they were.

                        The kind first and then the kind's own numbers, which are written down in the library with
                        what each means - so the panel is built from that list rather than knowing any of them. Picked
                        up by Place and carried like a cell: it follows the pointer, goes down on every click on the
                        layer being drawn on, turns with Ctrl+R and is put back by Esc - or by choosing any other shape
                        or tool, see emptyHand. A number changed while it is in hand changes what is in hand.

                        **Lit while it is in hand, and the shape rows are not** - a click puts the structure down, not a
                        rectangle, so a row lit beside it would say two things are in hand.

                        **The numbers are typed into a drawing of the kind** (2026-11-01, asked for): each box sits beside
                        the part of the structure it sets, on a dimension drawn there, and pointing at a box or typing in it
                        lights that dimension - see MarkFigures. They were a column of names and boxes, which said what a
                        number was called and not which part of the thing it was.

                        **Structure rather than Kind, and Place with an icon** (2026-11-03, asked for): the field's name
                        says what is being chosen, and the button carries an arrow putting something down, like the
                        rows above it carry their shapes.
                    *@
                    <div class="shapePickOpens shapePickFromTop">
                        <button id="markShape" class="shapePick @(stamp?.Kind == StampKind.Mark ? "shapePickOn" : "")"
                                title="Generate a structure from its numbers - a die frame, an alignment cross, a test structure, an inductor, a coupler, an antenna, a clock tree, pads, a ring resonator, a channel - and click where it goes">
                            @*A crosshair in a frame: an alignment mark inside a die, the two things this starts with.*@
                            <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                <rect x="1.7" y="1.7" width="12.6" height="12.6" rx="0.6"
                                      fill="none" stroke="currentColor" stroke-width="1.3" />
                                <path d="M8 4.3v7.4M4.3 8h7.4"
                                      fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>
                            Generator

                            <span class="shapePickArrow" aria-hidden="true">&#8250;</span>
                        </button>

                        <div id="markPanel" class="shapePickPanel" @onclick:stopPropagation="true">
                            <label class="shapePickField">
                                <span>Structure</span>

                                <select id="markKind" value="@markKey" @onchange="changeMarkKind"
                                        title="What to generate">
                                    @foreach (var group in Marks.All.GroupBy(maker => maker.Group))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var maker in group)
                                            {
                                                <option value="@maker.Key">@maker.Name</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </label>

                            @{
                                var shown = markMaker();
                                var figure = MarkFigures.For(shown);
                            }

                            <div id="markFigure" class="markFigure" data-kind="@shown.Key">
                                @((MarkupString)figure.Svg)

                                @for (int index = 0; index < shown.Settings.Count; index++)
                                {
                                    var asked = shown.Settings[index];
                                    var (chipX, chipY) = figure.Chips[asked.Name];

                                    <label class="markChip markChip@(index) @(asked.Unit.Length == 0 ? "markChipCount" : "")"
                                           style="left: @(chipX)px; top: @(chipY)px;" title="@asked.Says">
                                        <span class="markChipName">@labelOf(asked)</span>

                                        <span class="markChipBox">
                                            <input class="markSetting" type="number" min="0" step="@(asked.Whole ? "1" : "any")"
                                                   data-setting="@asked.Name"
                                                   value="@SvgWriter.FormatNumber(markValue(asked))"
                                                   @onchange="e => changeMarkSetting(asked, e)" />

                                            <span class="markChipUnit">@asked.Unit</span>
                                        </span>
                                    </label>
                                }
                            </div>

                            <span class="shapePickNote shapePickAside">@markMaker().Says.</span>

                            @*What the numbers come to, where the kind says - an inductance, a resistor's squares - see MarkMaker.NoteFor.*@
                            @if (markNote().Length > 0)
                            {
                                <span id="markNote" class="shapePickNote shapePickAside">@markNote().</span>
                            }

                            @if (markProblem.Length > 0)
                            {
                                <span id="markProblem" class="shapePickNote shapePickAside shapePickProblem">@markProblem</span>
                            }

                            <button id="pickUpMark" class="buttonStyle2 smallButton shapePickGo" @onclick="carryMark"
                                    title="Click where it should go, and again for another. Ctrl+R turns it, Ctrl+M mirrors it, Esc puts it back">
                                @*An arrow coming down onto a line: something put down where it lands.*@
                                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                    <path d="M8 1.8v8.4M4.4 6.8 8 10.4l3.6-3.6M2.6 13.8h10.8"
                                          fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Place
                            </button>
                        </div>
                    </div>

                    @*
                        A cell, put down where the pointer lands.

                        **Under the pencil as well as in the tree**, because placing a cell is drawing with a
                        bigger brush: it adds something to the cell being edited, at a point the pointer
                        chooses. Somebody holding the pencil looks here for what it can put down, and the tree
                        may not even be open.

                        The cells listed are the ones canPlace allows - not the one being edited, and nothing
                        that already holds it, which would make a library with no bottom. Choosing one picks it
                        up exactly as the tree's square does: it follows the pointer and goes down on the next
                        click, again on every click after, and Esc puts it back with the pencil still in hand -
                        as choosing another shape or tool does. The row is lit while one is in hand, as
                        Generator's is.

                        The row itself chooses nothing, so a press on it only opens the list - which on a touch
                        screen, with no hover, is how the list is reached at all.
                    *@
                    <div class="shapePickOpens">
                        <button id="cellShape" class="shapePick @(carrying.Length > 0 ? "shapePickOn" : "")"
                                title="Pick a cell up, and click where it should go. Ctrl+R turns it, Ctrl+M mirrors it, Esc puts it back">
                            @*The tree's own picture of placing one: a cell, and the crosshair it is held by.*@
                            <svg class="shapePickIcon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                <rect x="1.3" y="5.4" width="8.6" height="8.6" rx="1.3"
                                      fill="none" stroke="currentColor" stroke-width="1.5" />
                                <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                      d="M9.6 3.6h5.6M12.4 0.8v5.6" />
                            </svg>
                            Cell

                            <span class="shapePickArrow" aria-hidden="true">&#8250;</span>
                        </button>

                        <div id="cellPicker" class="shapePickPanel shapePickCells" role="menu" aria-label="Cell to place" @onclick:stopPropagation="true">
                            @if (placeableCells().Count == 0)
                            {
                                <span class="shapePickNone">No other cell can go in this one</span>
                            }
                            else
                            {
                                @foreach (string cell in placeableCells())
                                {
                                    var picking = cell;

                                    <button class="shapePick" role="menuitem" data-place="@picking"
                                            @onclick="() => carryFromMenu(picking)"
                                            title="Pick up @picking and click where it should go">@picking</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

        @*
            The grid, which is two switches and a distance.

            Both switches, because showing a grid and landing on one are different wants: a pitch you know
            is worth snapping to without lines over the geometry, and lines are worth having to read
            distances against while placing something deliberately off them.
        *@
        @*
            Becoming one thing rather than two.

            With this on, a shape that comes to rest on another one on its layer stops being a second shape
            and becomes part of the first - which is how a wide thing gets built out of pieces, and how a
            square dropped between two runs closes the gap into one shape rather than three that touch. Off
            by default, because a shape staying the shape it was is the less surprising of the two.

            **However it got there.** Drawing and dragging are two ways of putting a shape somewhere, and a
            switch that only meant one of them would be a switch you had to remember the scope of.

            Outside the Draw group for that reason: it belongs to the tools that can bring shapes together,
            which is Draw, Select and Move. Not to Pan or Measure, which move the view rather than anything
            in it - and not to the Path or Label shapes, since a centerline and a string are not areas to
            merge.
        *@
        @*
            One switch, and no word over one switch.

            A column headed Join holding a single button called Merge said the same thing twice and used
            two rows to do it. The picture says it once.

            Next to the tools rather than out past the grid: it belongs to Draw, Select and Move, and it
            appears and disappears with them - a switch that comes and goes should do it beside the thing
            it comes and goes with, not at the far end of the bar where its arrival shoves everything
            along.

            **Its room is kept whether it is here or not.** It was rendered conditionally, so picking up the
            pointer moved the grid pitch, the unit and everything else in the bar 92 pixels sideways - and a
            control that walks away from under the cursor because a different control appeared is the sort
            of thing that gets blamed on the mouse. Hidden rather than removed: the column, its gutter and
            its fence stay exactly where they were, and only the button stops being drawn.

            visibility rather than opacity, so what is left is not merely faint - it takes no clicks, no
            focus, and is not read out.
        *@
        <div class="col-1 toolbarItem toolbarGroupEnd toolbarGroupAlone" style="align-self: end;">
            <div class="toolGroup @(joins() ? "" : "toolGroupReserved")">
                <button id="joinToggle" class="buttonStyle2 toolbarButton toolButton buttonIcon @(joining ? "toolButtonOn" : "")"
                        @onclick="toggleJoin"
                        aria-label="Merge"
                        aria-hidden="@(joins() ? "false" : "true")"
                        title="Merge a shape into whatever it lands on, drawn or dragged, when they are on the same layer">
                    @*
                        Two squares that overlap, with the ground they share filled in.

                        The union outline this replaced was a single blob at fifteen pixels - a picture
                        of one shape, which says nothing about two. What the switch is about is the
                        overlap: shapes that meet stop being two, and the filled part is where they meet.
                    *@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <rect x="1.7" y="1.7" width="8.2" height="8.2" rx="1.2"
                              fill="none" stroke="currentColor" stroke-width="1.4" />
                        <rect x="6.1" y="6.1" width="8.2" height="8.2" rx="1.2"
                              fill="none" stroke="currentColor" stroke-width="1.4" />
                        <rect x="6.1" y="6.1" width="3.8" height="3.8" fill="currentColor" />
                    </svg>
                </button>
            </div>
        </div>

        @*
            No word over it either, for the same reason the tools have none: the picture is the label.

            The three switches are behind the icon rather than beside it. They were the second-widest column
            in the bar and are set once and left - Show, Snap and Shapes are a state of how you are working
            rather than a thing being chosen shot by shot - where the pitch is typed at constantly and stays
            in the open.
        *@
        @*
            The last of this view are the grid controls, so the fence after them is what closes the row -
            the same line every other group ends with, rather than the row simply running out.
        *@
        @*The three switches go when the pointer leaves the column, the way every other panel in the bar does.*@
        <div class="col-1 toolbarItem toolbarGrid toolbarGroupEnd" style="align-self: end;" @onmouseleave="OnGridMenuDismissed">
            <div class="toolGroup">
                @*
                    The icon, flush against the number it governs, because they are one control: the grid,
                    and how far apart it is. A gap between them would read as two things that happen to be
                    adjacent, which is how the whole column read when it was five separate boxes.
                *@
                @*
                    Opened by a press and by a hover, and closed by neither.

                    A press that toggled would never open it: the pointer arrives before the button goes
                    down, so the hover has already opened it and the press shuts it again. Both gestures
                    mean "show me"; a press somewhere else is what means "no thanks".
                *@
                <button id="gridMenu" class="buttonStyle2 toolbarButton buttonIcon gridMenuButton @(showGrid || snapping || snapToShapes ? "gridMenuButtonOn" : "")"
                        @onclick="showGridMenu"
                        @onmouseenter="showGridMenu"
                        aria-label="Grid" aria-expanded="@(gridMenuOpen ? "true" : "false")"
                        title="Show the grid, snap to it, or snap to shapes">
                    @*Squares, which is what a grid is - two lines each way rather than a mesh, at this size.*@
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
                              d="M1.8 1.8h12.4v12.4H1.8zM6 1.8v12.4M10 1.8v12.4M1.8 6h12.4M1.8 10h12.4" />
                    </svg>
                </button>

                @*
                    The pitch in force, which is the file's own until somebody types over it. Emptying the
                    box hands it back - see gridMicrons.
                *@
                <input id="gridPitch" class="gridPitch" type="number" min="@gridBox().Floor" step="@gridBox().Step"
                       value="@SvgWriter.FormatNumber(gridInChosenUnit())" @onchange="changeGridPitch"
                       title="@gridDescription()" />

                @*
                    What that number is in, which is a choice rather than a label.

                    A native select this time, unlike the layer picker: an option here holds a word and
                    nothing else, which is all a unit is - there is no swatch to put beside it.
                *@
                <select id="gridUnit" class="gridUnitPick" value="@gridUnit" @onchange="changeGridUnit"
                        title="@gridDescription()">
                    <option value="@GridUnit.Nanometer">nm</option>
                    <option value="@GridUnit.Micron">&#181;m</option>
                    <option value="@GridUnit.Millimeter">mm</option>
                    <option value="@GridUnit.DatabaseUnit">units</option>
                </select>
            </div>

            @*
                The three switches, behind the icon.

                Lines rather than buttons, and each says whether it is on - a menu of toggles is read down
                rather than scanned, so the state belongs on the line instead of in its color.
            *@
            @if (gridMenuOpen)
            {
                <div id="gridPicker" class="shapePicker" role="group" aria-label="Grid">
                    <button id="gridToggle" class="shapePick @(showGrid ? "shapePickOn" : "")"
                            @onclick="toggleGrid"
                            title="Draw a grid at the pitch beside this, with a heavier line every tenth (G)">
                        <span class="shapePickMark">@(showGrid ? "✓" : "")</span> Show grid
                    </button>

                    <button id="snapToggle" class="shapePick @(snapping ? "shapePickOn" : "")"
                            @onclick="toggleSnapping"
                            title="Land every corner and every drag on the nearest grid crossing">
                        <span class="shapePickMark">@(snapping ? "✓" : "")</span> Snap to grid
                    </button>

                    <button id="shapeSnapToggle" class="shapePick @(snapToShapes ? "shapePickOn" : "")"
                            @onclick="toggleShapeSnap"
                            title="Land on the corners and edges of shapes already drawn, in preference to the grid">
                        <span class="shapePickMark">@(snapToShapes ? "✓" : "")</span> Snap to shapes
                    </button>
                </div>
            }
        </div>
        @*
            The width, the ends and the sides used to be here, appearing as the shape in hand changed. They
            hang off their own shape's row in the picker now - see .shapePickOpens - so the bar stops
            rearranging itself around a choice that has already been made.
        *@

        @*
            **Paste was a labeled button up here and is not any more.**

            It appeared in the bar the moment anything was copied and pushed the undo pair along with it, so
            copying a shape rearranged the toolbar - and it is the one clipboard action that was not already
            beside the others. Copy and Cut live on the selection panel and in the menu over the shapes;
            Paste now lives in that menu too, where the thing it is about to do is under the pointer, and on
            Ctrl+V, which is where most hands look for it first.
        *@

        @if (History.CanUndo || History.CanRedo)
        {
            @*
                Two arrows and no word above them.

                Undo and redo are the pair everything else in the bar is named to distinguish itself from,
                and the arrow for each is one of the few icons that needs no label anywhere. What they will
                actually take back is still in the tooltip, which is the part a word could never have said.

                Inline SVG rather than an image, like the layer row's gear: it inherits the button's color,
                stays sharp at any zoom, and is not another file to vendor.
            *@
            <div class="col-1 toolbarItem" style="align-self: end;">
                <div class="toolGroup">
                    <button id="undoEdit" class="buttonStyle2 toolbarButton toolButton toolButtonOn buttonIcon"
                            disabled="@(!History.CanUndo || ReadOnly)" @onclick="undo"
                            aria-label="Undo"
                            title="@(History.NextUndo is null ? "Nothing to undo" : $"Undo {History.NextUndo} (Ctrl+Z)")">
                        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M6.5 3 3 6.5 6.5 10M3 6.5h6.25a3.25 3.25 0 1 1 0 6.5H7.5" />
                        </svg>
                    </button>

                    <button id="redoEdit" class="buttonStyle2 toolbarButton toolButton toolButtonOn buttonIcon"
                            disabled="@(!History.CanRedo || ReadOnly)" @onclick="redo"
                            aria-label="Redo"
                            title="@(History.NextRedo is null ? "Nothing to redo" : $"Redo {History.NextRedo} (Ctrl+Y)")">
                        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.7"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  d="M9.5 3 13 6.5 9.5 10M13 6.5H6.75a3.25 3.25 0 1 0 0 6.5H8.5" />
                        </svg>
                    </button>
                </div>
            </div>
        }

        @*
            The library used to sit here, alone at the far end of the bar. It is in with the tools now, where
            it is reached for - see the button itself, in the tool group above.
        *@

    };

    #endregion ***********************************************



    #region Initialization ***********************************

    protected override async Task OnInitializedAsync()
    {
        //With whatever the shell has already worked out - see Prepared, and the flatten count that found
        //this drawing the same conclusion twice.
        await Render(Gds, ShowLayers, Prepared);
    }

    ///<summary>
    ///Takes up the markers handed down when they are not the ones on screen.
    ///
    ///**Taken, not redrawn.** They are markup of their own beside the picture, so the render that follows
    ///this changes them and leaves the picture as it is. They were part of <see cref="svgString"/> once,
    ///which made every step through a deck's faults a redraw of the whole drawing.
    ///</summary>
    protected override void OnParametersSet()
    {
        dropWhatWentOutOfReach();

        markersDrawn = Markers;
    }

    ///<summary>Which layers were hidden or locked when this last looked, so a change can be spotted.</summary>
    private string outOfReachFor = "";

    ///
    ///Lets go of anything a new lock, or a layer just hidden, has put out of reach.
    ///
    ///**Narrowed rather than cleared**, so locking a layer nothing chosen is on leaves the selection alone.
    ///Only the part that has just gone out of reach is dropped.
    ///
    ///Without this, locking with a selection already made leaves shapes chosen on the locked layer and the
    ///move tool goes on dragging them: they were picked while they were still pickable, and nothing asks
    ///again on the way into a drag. That is the same fault the fade-only attempt had, reached from the
    ///other side.
    ///
    ///**Hiding as well.** The redraw a hidden layer causes usually puts the whole selection down anyway, but
    ///not while an edit or a pan of a large layout is carrying it across - see remarkChosen - and then the
    ///chosen shapes on the hidden layer stayed chosen, outlined over a canvas with nothing on it.
    ///
    ///Compared as a string rather than by set equality: this runs on every parameter set, and building two
    ///sets to compare them per render is more than a joined list of the few pairs that are ever put away.
    ///
    private void dropWhatWentOutOfReach()
    {
        if (ShowLayers is null)
            return;

        var putAway = ShowLayers.Where(item => !item.IsSelected || item.IsLocked).Select(item => item.Id).OrderBy(key => key);
        string outOfReach = string.Join("|", putAway);

        if (outOfReach == outOfReachFor)
            return;

        outOfReachFor = outOfReach;

        if (layout is null || chosenIndexes.Count == 0)
            return;

        var reachable = reachableLayers();
        var kept = new List<int>();

        foreach (int index in chosenIndexes)
        {
            if (index < 0 || index >= layout.Elements.Count)
                continue;

            if (Picking.InReach(layout.Elements[index], reachable))
                kept.Add(index);
        }

        if (kept.Count == chosenIndexes.Count)
            return;

        //Not awaited: this runs inside OnParametersSet, and what choose does past setting the selection is
        //a redraw this render is about to do anyway.
        _ = choose(kept);
    }

    //Async Task rather than async void: an exception out of a void one cannot be awaited by anything, so
    //it never reaches Blazor's error handling and is lost as an unobserved rejection.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            keyHandle ??= DotNetObjectReference.Create(this);

            await js.InvokeVoidAsync("registerSVGEvents", keyHandle);

            //Retyping is not a tool, so its handle is hung up once rather than when something is chosen: a
            //label is double-clicked with whatever is in hand, including nothing.
            await js.InvokeVoidAsync("startRetyping", keyHandle);

            //And this view's two menus in the bar, for the same reason: one listener for the life of the
            //view rather than one per opening, which would have to be taken away by every path that closes
            //them. The shell hangs up its own for the view picker. The camera's, in the corner of the view, is
            //the same kind of menu and goes on the same list.
            await js.InvokeVoidAsync("registerBarMenu", keyHandle, "shapePicker", "drawTool", "OnShapeMenuDismissed");
            await js.InvokeVoidAsync("registerBarMenu", keyHandle, "gridPicker", "gridMenu", "OnGridMenuDismissed");
            await js.InvokeVoidAsync("registerBarMenu", keyHandle, "imageMenu", "downloadImage", "OnImageMenuDismissed");

        }

        //The box has to be in the page before it can be given the keyboard, which is the render after the
        //one that asked for it - the same reason the selection is marked here rather than where the edit
        //happened. Only the focus is done from here; opening the box is done inside the event that placed
        //the label, where StateHasChanged is reliable.
        if (focusRetypeBox)
        {
            focusRetypeBox = false;

            await js.InvokeVoidAsync("selectAllIn", retypeBox);
        }
        else if (retypingLabel >= 0)
        {
            //A rebuild of the picture takes the box's element with it, so the keyboard has to be put back
            //or the next keystroke goes nowhere. Without selecting - that would wipe out what is being
            //typed every time anything else on the page changed.
            await js.InvokeVoidAsync("keepFocusIn", retypeBox);
        }

        //The same reason as the box above: the menu is in the page the render after the one that asked for
        //it, and it needs the keyboard before Escape can reach it. Its own branch rather than another arm
        //of that chain, because a label can be being retyped while the menu opens over it.
        if (focusShapeMenu && menuAt is not null)
        {
            focusShapeMenu = false;

            await shapeMenuBox.FocusAsync();
        }

        //And the tree's own name box, which arrives the same render late as the two above.
        if (focusRowRename && renamingRow is not null)
        {
            focusRowRename = false;

            await js.InvokeVoidAsync("selectAllIn", rowRenameBox);
        }

        //A label being retyped from its row: the box goes over the label in the drawing, and the drawing is
        //only in the page now. See retypeFromTree.
        await openRetypeAfterRender();

        //After every render, not only the first. Blazor owns the markup inside the SVG and replaces it
        //wholesale, which takes the grid with it - so rather than working out whether this particular
        //render was one of those, it is put back each time. Setting three values is cheaper than being
        //wrong about it.
        await js.InvokeVoidAsync("applyGrid", showGrid, snapping, gridUnits(), snapToShapes);

        //
        //And whatever is being carried, which is appended into the SVG the same way the grid is.
        //
        //**Belt and braces, and said so rather than left to look load-bearing.** Measured after this was
        //restored: the carried group survives a drop, a layer switched off, and the opacity slider - every
        //render this view has - because it is appended as a sibling of the region Blazor owns rather than
        //inside it. Kept because that is a fact about how Blazor happens to diff a MarkupString and not
        //something the component promises, and because the cost of being wrong is a cell following the
        //pointer invisibly while clicks go on placing it. One lookup when nothing is in hand.
        //
        await js.InvokeVoidAsync("restoreCarried");

        //
        //And the frame round writing or a picture just put down, appended the same way - or taken away, when some
        //other step has been taken since or another cell entered, which is the piece let go of. See Piece.
        //
        if (piece is not null && !pieceLive())
        {
            piece = null;
            wordsOpen = false;
            wordsJustPlaced = false;

            await js.InvokeVoidAsync("hidePiece");

            StateHasChanged();
        }
        else if (piece is not null)
        {
            await js.InvokeVoidAsync("restorePiece");
        }

        //The words' box, the render after it opened - and back to it after a rebuild took the keyboard, the way the
        //label's box is kept. See openWords.
        if (focusWords)
        {
            focusWords = false;

            await js.InvokeVoidAsync("selectAllIn", wordsBox);
        }
        else if (wordsOpen)
        {
            await js.InvokeVoidAsync("keepFocusIn", wordsBox);
        }

        //What a database unit is worth, for the readout to say microns rather than a bare number. Here
        //rather than once, because opening a different file can change it.
        await js.InvokeVoidAsync("setScale", micronsPerUnit());

        //
        //A file that has just been opened is framed, once.
        //
        //Here rather than where the file arrives, for the same reason the selection is: the fit is measured
        //off the drawn nodes, and those do not exist until the render that follows has been put in the page.
        //
        //Once, because after that where you are looking is *yours* - refitting on every render would undo
        //every pan and every zoom the moment anything else changed.
        //
        if (refit)
        {
            refit = false;

            await fitView();
        }

        //
        //And back into the cell that was being edited, if a session named one.
        //
        //Before the viewBox rather than after, because entering a cell rebuilds the markup - and that
        //rebuild is a redraw and not a refit, so it leaves the view where it is and the box below still
        //lands on the right place. Held until here because the file has to be flattened first: openCell
        //looks for a shape in the cell so that the whole breadcrumb comes back, and there are no shapes to
        //look at until the layout exists.
        //
        //Refused if the file no longer has a cell by that name, which is what a session outliving a rename
        //looks like - and which openCell would otherwise answer by inventing a context for a cell that is
        //not there.
        //
        if (cellToRestore.Length > 0 && layout is not null)
        {
            string cell = cellToRestore;
            cellToRestore = "";

            //
            //The box the actions panel renames through, which the toggle fills and a restore did not.
            //
            //Without it the panel comes back open with an empty box, which disables Rename and Copy to - a
            //panel that is open and can do nothing, which is worse than one that is shut.
            //
            //**Before entering the cell rather than after**, and from the name in hand rather than from the
            //context it is about to set. Entering is what re-renders this view; setting the box afterwards
            //writes it into a field whose render has already gone by, and nothing else asks for another.
            //
            if (cellActionsOpen)
                renameTo = cell;

            if (Gds is not null && Hierarchy.Named(Gds, cell) is not null)
                await openCell(cell);
        }

        //
        //And the tool that was in hand, after the cell rather than before it.
        //
        //Draw refuses to be picked up outside a cell - it checks for itself and does nothing - so taking it
        //up before the context was back would leave the view in Pan with a session that said Draw, and the
        //next save would agree with the screen and lose it for good.
        //
        //A name this build does not know is left alone for the same reason it costs nothing elsewhere: the
        //view opens in Pan, which is where an unreadable answer should leave it.
        //
        if (toolToRestore.Length > 0)
        {
            string tool = toolToRestore;
            toolToRestore = "";

            if (tool == "Measure")
                await startMeasuring();
            else if (tool == "Select")
                await startSelecting();
            else if (tool == "Move")
                await startMoving();
            else if (tool == "Draw")
                await startDrawingShapes();
        }

        //
        //And a file that has been *reopened* goes back where it was left, which lands after that fit.
        //
        //After rather than instead, and that ordering is not a detail. Restoring a session opens the file
        //first - which is a new file to this view, so it frames it - and hands over the settings a render
        //later, because the view is created by the render in between. So the fit has already happened by
        //the time there is a box to put back, and this is the second word on it.
        //
        //It also means the fit is the fallback for a box that will not parse: applyViewBox refuses one and
        //what is left on screen is the framing, which is what the view did before any of this.
        //
        if (viewBoxToRestore.Length > 0)
        {
            string box = viewBoxToRestore;
            viewBoxToRestore = "";

            //
            //**And kept as where the view is looking**, which only the settle report used to say - and putting
            //a box on the view raises no settle, so the next save wrote an empty one over the box just put
            //back. The address hid that while it held on to box= for a reload to read again; it lets go of it
            //now, so the session has to keep the box itself, and Share reads it from here too.
            //
            //Saved as a settle is, because the save that put it here ran before it landed.
            //
            if (await js.InvokeAsync<bool>("applyViewBox", box) && box != viewBoxSeen)
            {
                viewBoxSeen = box;

                await OnSettingsChanged.InvokeAsync();
            }
        }

        //An edit that kept its selection marks it again here rather than where the edit happened, because
        //the highlight is a class on a node and those nodes do not exist until the render that follows the
        //edit has actually been put in the page.
        if (remarkChosen)
        {
            remarkChosen = false;

            await markChosen();
        }

        //
        //**And the shell told, once, that a file's first picture is on the page**, which takes down the note
        //saying it is loading. Last, so the fit above has drawn a large layout by now: until a large one is
        //framed nothing of it is drawn at all - see waitingForFit.
        //
        //
        //Not while the first picture is still being written - the page answers meanwhile, and renders, so this runs
        //again before that picture is done - and not for one given up, whose load has already put things back.
        //
        if (announceDrawn && !waitingForFit && firstPicture is null && layout is not null && !ReferenceEquals(firstPictureGivenUp, layout))
        {
            announceDrawn = false;

            await OnDrawn.InvokeAsync();
        }
    }

    ///<summary>Set by an edit that kept what was chosen; see <see cref="afterEdit"/>.</summary>
    private bool remarkChosen = false;

    ///<summary>Set when a different file has been flattened, so the next render frames it.</summary>
    private bool refit = false;

    ///
    ///Set while a large layout waits to be framed, so nothing is drawn of it before then.
    ///
    ///**The fit used to be measured off the drawing**, so a file had to be drawn before it could be framed -
    ///and at that point nothing knew where the view would be or how big a pixel was, so the first picture
    ///of a large layout was all of it: 21 million characters for the RGB mixer, eleven seconds on the dev
    ///server, replaced the moment the fit landed by the 63,000 shapes big enough to see at it.
    ///
    ///A large layout is framed off its own extent instead - see <see cref="fitView"/> - and drawn once, for
    ///the frame it is actually seen at. Below <see cref="CullAbove"/> nothing changes: the whole layout is
    ///drawn and the fit measures it, since what is drawn is all of it there.
    ///
    private bool waitingForFit = false;

    ///
    ///Frames the layout: by what is drawn when that is all of it, by its extent when it is not.
    ///
    ///**Measuring the drawing is wrong for a large layout twice over.** It needs the whole layout drawn
    ///first - see <see cref="waitingForFit"/> - and once the view draws only what is on screen, it frames
    ///that: Center, zoomed into a large layout, framed the window it was already looking through.
    ///
    ///The extent is of the layers that are drawn, which is what measuring the drawing gave. Should the view
    ///not be there to frame - the interop answers null - the whole layout is drawn and measured as before,
    ///which is slow and right.
    ///
    private async Task fitView()
    {
        if (layout is null || ShowLayers is null || layout.Elements.Count <= CullAbove)
        {
            waitingForFit = false;

            await js.InvokeVoidAsync("fitToDrawing");

            return;
        }

        var extent = layout.Index.ExtentOf(CheckboxItem.VisibleLayers(ShowLayers));
        double[]? report = null;

        if (!extent.IsEmpty)
        {
            report = await js.InvokeAsync<double[]?>(
                "fitToBounds",
                extent.Left,
                extent.Bottom,
                Math.Max(1, extent.Width),
                Math.Max(1, extent.Height));
        }

        waitingForFit = false;

        if (report is not { Length: 5 })
        {
            shown = null;

            redraw();

            await js.InvokeVoidAsync("fitToDrawing");

            return;
        }

        //What the interop's own report would have said, taken now rather than when it arrives, so the
        //first picture is drawn for this frame. The report still comes, and finds nothing to do.
        shown = drawnAround(windowFrom(report[0], report[1], report[2], report[3]));
        unitsPerPixel = report[4];

        await drawFirstPicture();
    }

    ///<summary>The load a large layout's first picture is drawn at the pace of, until it has been - see drawFirstPicture.</summary>
    private Pacer? firstPicturePace = null;

    ///
    ///The first picture being written out now, by its own token - or null when none is - so nothing else draws over
    ///it meanwhile. A token rather than a flag, so one that was let go of for a newer file, and finishes late, cannot
    ///speak for the picture that took its place.
    ///
    private object? firstPicture = null;

    ///<summary>The layout whose first picture was given up - its load canceled or overtaken - so nothing is announced for a picture never drawn.</summary>
    private FlattenedLayout? firstPictureGivenUp = null;

    ///<summary>Whether a redraw was asked for while the first picture was being written, and is owed once it is.</summary>
    private bool redrawOwed = false;

    ///
    ///A large layout's first picture, drawn at the pace of the load that opened it: on the dev server the RGB
    ///mixer's is five seconds of writing, and at the load's pace the page answers meanwhile and Cancel stops it.
    ///
    ///**Built on the side and put up whole**, so a load given up halfway leaves the view as empty as it was while
    ///it waited for the fit, rather than with half a picture in it - and nothing is announced, since the shell has
    ///already put back what was on screen. See Viewer.razor's cancelLoad.
    ///
    ///**Nothing else draws meanwhile.** The page answers now, so a pan or a layer switched off can ask for a redraw
    ///in the middle of this - and that redraw would be the whole picture again, all at once. It is owed instead, and
    ///drawn once this is, for wherever the view has got to by then.
    ///
    ///With no load to pace it - a refit with nothing loading - it is the ordinary redraw.
    ///
    private async Task drawFirstPicture()
    {
        var pacer = firstPicturePace;

        firstPicturePace = null;

        if (pacer is null || layout is null || ShowLayers is null)
        {
            redraw();

            return;
        }

        //Given up before it began - and not to be drawn the ordinary way instead, which is all of it at once.
        if (pacer.Canceled)
        {
            firstPictureGivenUp = layout;

            return;
        }

        countPlacements();

        markersDrawn = Markers;

        var visible = CheckboxItem.VisibleLayers(ShowLayers);
        var labeled = labeledAtThisZoom();
        var window = shownBox();
        long smallest = smallestWorthDrawing();
        string from = drawnFrom(visible, labeled, window, smallest);

        var drawing = layout;
        var cell = context;
        var mine = new object();

        string picture;

        firstPicture = mine;

        //At the load's pace, and given up at the next pause once let go of for a newer file - rather than written to
        //the end for nothing, beside that one's.
        Func<ValueTask> pause = () =>
        {
            if (!ReferenceEquals(firstPicture, mine))
                throw new OperationCanceledException();

            return pacer.Pause();
        };

        try
        {
            picture = await SvgWriter.BuildAsync(drawing, visible, opacity, labeled, cell, window, smallest, pause);
        }
        catch (OperationCanceledException)
        {
            //Given up with its load - or let go of for a newer file, which is that one's business.
            if (ReferenceEquals(firstPicture, mine))
            {
                firstPicture = null;
                firstPictureGivenUp = drawing;
            }

            return;
        }

        //Let go of for a newer file while it was written, which draws its own.
        if (!ReferenceEquals(firstPicture, mine))
            return;

        firstPicture = null;

        //Or the file was edited meanwhile, which makes this a picture of what is no longer there.
        if (!ReferenceEquals(drawing, layout))
        {
            redrawOwed = false;

            redraw();

            return;
        }

        built = picture;
        layoutBuilt = drawing;
        builtFrom = from;

        //
        //**And the cell may have been entered again while it was written.** A session that names a cell enters it as
        //the file arrives, and so does a link that sets anything at all: it hands the view the state on screen, top
        //cell included, and entering the cell the view is already in is a new context all the same. Drawn alike, this
        //is that context's picture too, so it is kept as one rather than written a second time; a cell drawn
        //differently is drawn below, by the redraw that entering it asked for.
        //
        //This picture used to be thrown away whenever the context was not the same object - and the redraw owed to
        //it with it, which left a large file opened from a link with nothing drawn at all.
        //
        if (drawsAlike(cell, context))
            contextBuilt = context;
        else
            contextBuilt = cell;

        svgString = built;

        StateHasChanged();

        if (redrawOwed || !ReferenceEquals(contextBuilt, context))
        {
            redrawOwed = false;

            redraw();
        }
    }

    ///
    ///Whether two cells being edited draw the same picture: the same cell, looked at through the same placement of
    ///it, which is all a picture asks of one - see CellContext.Holds and IsLookingThrough, which SvgWriter fades by.
    ///
    private static bool drawsAlike(CellContext? one, CellContext? other)
    {
        if (one is null || other is null)
            return one is null && other is null;

        return one.Structure == other.Structure && one.Placement.Equals(other.Placement);
    }

    ///<summary>The box a view report names, out to whole units on every side.</summary>
    private static Bounds windowFrom(double left, double bottom, double right, double top)
    {
        return new Bounds((int)Math.Floor(left), (int)Math.Floor(bottom), (int)Math.Ceiling(right), (int)Math.Ceiling(top));
    }

    #region Drawing only what is worth drawing *****************************************

    ///
    ///How many elements a layout must hold before anything is left out of the markup.
    ///
    ///**Below this, every shape is drawn, always.** A viewer that quietly omits things is one nobody should
    ///trust with a layout they are checking, and on a standard cell there is nothing to gain: measured, the
    ///whole bundled corpus draws in single-digit milliseconds. So the machinery only engages where the
    ///numbers said it has to - and every existing test, which works on files of tens of shapes, goes on
    ///exercising the path that draws everything.
    ///
    ///Twenty thousand is where the browser was measured to fall over: 57 ms per pointer move, about
    ///seventeen frames a second, against 3 ms on the bundled cell. Half of that is the point to start.
    ///
    ///**That reason has since expired, and a different one took its place.** A layer is one path now
    ///whatever it holds, so a frame costs the same with twenty thousand shapes on screen as with sixteen -
    ///both are at the display's limit. What leaving a shape out saves is bytes, and bytes are what a
    ///rebuild pays: zoomed in, an edit marshals a couple of kilobytes rather than a megabyte. The threshold
    ///still reads right for that, which is luck rather than judgment, so it is written down.
    ///
    public const int CullAbove = 10000;

    ///
    ///What the picture was last drawn for: the area on screen as JavaScript last reported it, grown by
    ///<see cref="ViewMargin"/> on every side.
    ///
    ///Null when nothing has reported one yet, or when the layout is small enough not to bother - either way
    ///meaning "draw all of it".
    ///
    private Bounds? shown = null;

    ///
    ///How much is drawn past each edge of the screen, as a share of its width and height.
    ///
    ///**So an ordinary pan moves nothing new into view and costs nothing at all**; only a pan that leaves the
    ///margin behind is worth a rebuild. Half a viewport each way, which is a drag most of the way across the
    ///window. It is also what a drag shows past the edges while it moves the picture already drawn - see
    ///showViewBox in the interop.
    ///
    private const double ViewMargin = 0.5;

    ///
    ///The area on screen with the margin added, which is what gets drawn.
    ///
    ///Held to what a coordinate can be rather than wrapped past it, the way <see cref="Bounds.Grown"/> is - a
    ///view zoomed far enough out reaches the edge of the range, and the far side of it is not more of the same.
    ///
    private static Bounds drawnAround(Bounds seen)
    {
        if (seen.IsEmpty)
            return seen;

        long acrossBy = (long)Math.Ceiling(seen.Width * ViewMargin);
        long downBy = (long)Math.Ceiling(seen.Height * ViewMargin);

        return new Bounds(
            coordinate(seen.Left - acrossBy),
            coordinate(seen.Bottom - downBy),
            coordinate(seen.Right + acrossBy),
            coordinate(seen.Top + downBy));
    }

    private static int coordinate(long value)
    {
        return (int)Math.Clamp(value, int.MinValue, int.MaxValue);
    }

    ///
    ///How many layout units one screen pixel covered when the picture on screen was drawn, for deciding what
    ///is too small to see. A zoom out that keeps the picture keeps this with it - see stillDrawnFor.
    ///
    private double unitsPerPixel = 0;

    ///
    ///What the markup is culled to, or null to draw everything.
    ///
    ///The box already carries its margin - see <see cref="OnViewBoxChanged"/> - so a shape half off screen
    ///still draws, and a small pan moves nothing out of it.
    ///
    private Bounds? shownBox()
    {
        if (layout is null || layout.Elements.Count <= CullAbove)
            return null;

        return shown;
    }

    ///
    ///The area, in square layout units, below which a shape is not worth drawing.
    ///
    ///One pixel's worth. A shape smaller than that is a shape the browser is being asked to lay out, raster
    ///and composite in order to change the color of less than a single pixel - which at a full-chip zoom is
    ///most of a real layout.
    ///
    ///Zero, meaning draw everything, until something has said how big a pixel is.
    ///
    private long smallestWorthDrawing()
    {
        if (layout is null || layout.Elements.Count <= CullAbove || unitsPerPixel <= 0)
            return 0;

        long pixel = (long)(unitsPerPixel * unitsPerPixel);

        if (pixel <= 0)
            return 0;

        //
        //**Never applied if it would leave nothing.**
        //
        //Zoom far enough out and every shape in the layout is under a pixel at once - so the rule that drops
        //what cannot be seen drops the whole picture, and the view goes blank while the file is still open.
        //Measured: forty notches out and twenty thousand shapes became none. Somebody zooming out to find
        //their layout would be looking at an empty screen with nothing to say why.
        //
        //A shape too small to see is still worth drawing when it is the only thing there is.
        //
        //Asked of the layout's index, which has the largest shape's box to hand - this was a walk of every
        //element on every redraw until it found one.
        //
        if (layout.Index.LargestArea >= pixel)
            return pixel;

        return 0;
    }

    ///
    ///Where the view is looking, once panning or zooming has stopped.
    ///
    ///**Reported on settle, not per frame.** Panning is a viewBox attribute and nothing else - no round trip
    ///and no rebuild - which is exactly why it is smooth, and rebuilding the markup sixty times a second
    ///would be the surest way to make it not. JavaScript waits for the gesture to end before saying anything.
    ///
    ///**And drawn with a margin around it** - see <see cref="ViewMargin"/> - so a pan that stays inside what
    ///was drawn costs nothing at all. That was the intent from the start and was not so until 2026-10-09: the
    ///box arrived with the margin already on and was compared with the last one, and any pan at all moves a
    ///grown box out of the last on its leading edge. On the RGB mixer in a Release build a 300-pixel drag
    ///rebuilt for 121 ms at the fit.
    ///
    ///**Zooming out without leaving what was drawn keeps it too.** The picture then holds shapes that have
    ///shrunk under a pixel since, which is a little more raster and nothing wrong, where drawing it again is a
    ///tenth to a third of a second there. Zooming in draws again, since a shape left out for being under a
    ///pixel may be over one now - and so does a zoom across the line where labels become readable.
    ///
    [JSInvokable]
    public async Task OnViewBoxChanged(double left, double bottom, double right, double top, double perPixel)
    {
        if (layout is null || layout.Elements.Count <= CullAbove)
            return;

        var seen = windowFrom(left, bottom, right, top);

        if (shown is Bounds drawn && drawn.Contains(seen) && stillDrawnFor(perPixel))
            return;

        shown = drawnAround(seen);
        unitsPerPixel = perPixel;

        redraw();

        //The highlight is a class on a node, and the nodes have just been replaced.
        remarkChosen = chosenIndexes.Count > 0;

        await Task.CompletedTask;
    }

    ///
    ///Whether the picture on screen was drawn at a zoom it still holds good at: the same one or further out,
    ///with labels on the same side of readable.
    ///
    private bool stillDrawnFor(double perPixel)
    {
        if (perPixel < unitsPerPixel - 0.001)
            return false;

        return SvgWriter.LabelsLegibleAt(perPixel) == SvgWriter.LabelsLegibleAt(unitsPerPixel);
    }

    ///
    ///Puts the layout back in the middle of the window, at the size it opens on.
    ///
    ///**And forgets where you were.** The fit reports no settle of its own - see fitToDrawing, where that
    ///is deliberate, because the frame a file opens on is one a reopen works out for itself and recording
    ///it would cost a session write on every file opened. Pressing this lands in exactly that state, so the
    ///box the session is holding has to go: leaving it would put the view back somewhere else on the next
    ///visit, which is the opposite of what somebody just asked for.
    ///
    ///Emptying it is what makes the next open frame the drawing, and is the same value a file nobody has
    ///moved carries.
    ///
    public async Task CenterView()
    {
        await fitView();

        viewBoxSeen = "";

        await OnSettingsChanged.InvokeAsync();
    }

    ///
    ///Zooms from the buttons beside Center: that many of the wheel's notches, about the middle of the view.
    ///
    ///Nothing comes back from the call. What the view settles on is reported the way a turn of the wheel's is -
    ///see zoomViewBy in the interop - so the picture is drawn for it and the session hears where it stopped.
    ///
    public async Task ZoomBy(int notches)
    {
        await js.InvokeVoidAsync("zoomViewBy", notches);
    }

    ///<summary>
    ///Puts the view on a box, with room around it.
    ///
    ///What clicking a violation does. Framed *exactly* on the fault it would fill the window edge to edge,
    ///which is the one view that says nothing about why it is a fault - a spacing violation is a gap, and a
    ///gap without the two shapes on either side of it is a rectangle. The margin is a share of the box
    ///rather than a fixed distance, so it works the same on a 150-nanometer sliver and on a whole cell.
    ///
    ///A minimum size as well, because a marker can have no extent at all: an off-grid fault is a single
    ///coordinate, and a viewBox of zero width is one the browser stops drawing at.
    ///</summary>
    public async Task FrameOn(Bounds bounds)
    {
        if (bounds.IsEmpty)
            return;

        double width = Math.Max(bounds.Width, MarkerFrameLeast);
        double height = Math.Max(bounds.Height, MarkerFrameLeast);

        double margin = Math.Max(width, height) * MarkerFrameMargin;

        double left = bounds.Left - ((width - bounds.Width) / 2) - margin;
        double bottom = bounds.Bottom - ((height - bounds.Height) / 2) - margin;

        string box = string.Join(
            ' ',
            SvgWriter.FormatNumber(left),
            SvgWriter.FormatNumber(bottom),
            SvgWriter.FormatNumber(width + (margin * 2)),
            SvgWriter.FormatNumber(height + (margin * 2)));

        await js.InvokeVoidAsync("applyViewBox", box);
    }

    ///<summary>
    ///How much room is left around a marker, as a share of its longest side.
    ///
    ///Two thirds each way, so the fault is about a third of what is on screen and its surroundings are the
    ///rest. Enough to see what a gap is a gap *between*.
    ///</summary>
    private const double MarkerFrameMargin = 0.65;

    ///<summary>
    ///The smallest box the view is put on, in database units - a micron on a nanometer grid.
    ///
    ///For a marker with no size. An off-grid fault is one coordinate, and framing on a point is a viewBox
    ///of zero width, which browsers respond to by drawing nothing at all.
    ///</summary>
    private const double MarkerFrameLeast = 1000;

    ///<summary>Where the view is looking, as a viewBox, or empty until something has said.</summary>
    private string viewBoxSeen = "";

    ///<summary>The one a session carried, applied once the drawing is in the page. Cleared as it is used.</summary>
    private string viewBoxToRestore = "";

    ///<summary>The cell a session was left in, entered once the file is flattened. Cleared as it is used.</summary>
    private string cellToRestore = "";

    ///<summary>The tool a session was left in, taken up after the cell. Cleared as it is used.</summary>
    private string toolToRestore = "";

    ///
    ///Where the view came to rest, kept so the session can put it back.
    ///
    ///**Separate from <see cref="OnViewBoxChanged"/>**, which gives up early on a layout small enough not to
    ///need culling and is told the area shown - the viewBox with whatever bands the window adds either side
    ///of it. That is right for deciding what to draw; a session keeps the viewBox that was set.
    ///
    ///Reported on settle rather than per frame, so a drag is one save and not a hundred - the same bargain
    ///the culling report makes, and for the same reason. Unchanged is not a change: opening a file frames
    ///it, and the frame arrives here before anything has moved.
    ///
    [JSInvokable]
    public async Task OnViewSettled(double x, double y, double width, double height)
    {
        //Invariant, because a session written where decimals are commas has to be readable where they are not.
        string box = string.Join(' ',
            x.ToString(CultureInfo.InvariantCulture),
            y.ToString(CultureInfo.InvariantCulture),
            width.ToString(CultureInfo.InvariantCulture),
            height.ToString(CultureInfo.InvariantCulture));

        if (box == viewBoxSeen)
            return;

        viewBoxSeen = box;

        await OnSettingsChanged.InvokeAsync();
    }

    #endregion ***********************************************

    #endregion ***********************************************



    #region Methods ******************************************

    ///
    ///Saves the layout as an image.
    ///
    ///**Built again rather than copied off the screen**, which is what it used to be - and that was wrong in
    ///a way nothing would have said out loud. Above <see cref="CullAbove"/> elements the view draws only what
    ///is on screen and only what is bigger than a pixel, so a copy of it is a copy of that: measured, a
    ///download while zoomed into a twenty-thousand-element layout held **sixteen shapes**. A viewer that
    ///quietly saves a fraction of the layout is worse than one that refuses to save at all.
    ///
    ///So the picture is built with no viewport and no smallest size, which is the whole layout, and it needs
    ///nothing stripped out of it afterwards: the grid, the ruler, the handles, the rubber band, the drawing
    ///preview and the selection are things somebody is doing *to* the layout rather than things it contains,
    ///and none of them are in what this builds.
    ///
    ///The viewBox comes off the screen, so the file frames what was being looked at.
    ///
    private async Task downloadSvg()
    {
        if (layout is null || ShowLayers is null)
            return;

        string whole = SvgWriter.Build(
            layout,
            CheckboxItem.VisibleLayers(ShowLayers),
            opacity,
            CheckboxItem.LabeledLayers(ShowLayers),
            context);

        await js.InvokeVoidAsync("downloadSvg", "mySvg.svg", whole);
    }

    ///
    ///Saves the view as a PNG: the picture the SVG camera saves, drawn by the browser at twice the view's size.
    ///
    ///Built again the same way, for the same reason - see downloadSvg - and drawn over exactly the area the
    ///view shows. A browser that will not make a canvas that large says so, in the place a refused drawing
    ///says why.
    ///
    private async Task downloadPng()
    {
        if (layout is null || ShowLayers is null)
            return;

        string whole = SvgWriter.Build(
            layout,
            CheckboxItem.VisibleLayers(ShowLayers),
            opacity,
            CheckboxItem.LabeledLayers(ShowLayers),
            context);

        string? problem = await js.InvokeAsync<string?>("downloadViewPng", "view.png", whole);

        if (problem is not null)
            drawRefusal = problem;
    }

    ///<summary>Whether the camera's menu is open, offering a PNG or an SVG. Not saved: it is a panel being open.</summary>
    private bool imageMenuOpen = false;

    ///<summary>The camera, which opens its menu and shuts it again on a second press.</summary>
    private void toggleImageMenu()
    {
        imageMenuOpen = !imageMenuOpen;
    }

    ///<summary>A press anywhere but the menu or the camera, reported by registerBarMenu.</summary>
    [JSInvokable]
    public void OnImageMenuDismissed()
    {
        if (!imageMenuOpen)
            return;

        imageMenuOpen = false;

        StateHasChanged();
    }

    ///
    ///The two choices, which put the menu away before the picture is built.
    ///
    ///**Before, and shown to be gone**, because building the picture holds the page: the whole layout, which on
    ///the RGB mixer is seconds on the dev server. A menu left standing over a page that has stopped answering
    ///reads as the press not having landed. See Painting.
    ///
    private async Task savePng()
    {
        imageMenuOpen = false;

        StateHasChanged();
        await js.AfterPaintAsync();

        await downloadPng();
    }

    private async Task saveSvg()
    {
        imageMenuOpen = false;

        StateHasChanged();
        await js.AfterPaintAsync();

        await downloadSvg();
    }

    ///<summary>
    ///Switches the pointer from panning to measuring.
    ///
    ///The file's scale goes over with it, so the reading can be given in microns as well as in database
    ///units - which is the unit anybody in this field actually thinks in. Null when the file's UNITS say
    ///nothing usable, and the reading is then in database units alone rather than in an invented scale.
    ///</summary>
    private async Task startMeasuring()
    {
        await emptyHand();

        measuring = true;
        selecting = false;
        moving = false;
        drawingShapes = false;
        chosenIndexes = new List<int>();

        await js.InvokeVoidAsync("stopSelecting");
        await js.InvokeVoidAsync("stopDrawing");
        await js.InvokeVoidAsync("startRuler", micronsPerUnit());

        await toolChosen();
    }

    ///<summary>Back to the tool the view is in when nothing else is chosen, which puts every other one down.</summary>
    private async Task usePan()
    {
        await emptyHand();

        measuring = false;
        selecting = false;
        moving = false;
        drawingShapes = false;
        chosenIndexes = new List<int>();

        await js.InvokeVoidAsync("stopRuler");
        await js.InvokeVoidAsync("stopSelecting");
        await js.InvokeVoidAsync("stopDrawing");

        await toolChosen();
    }

    ///<summary>
    ///Switches the pointer to picking shapes out.
    ///
    ///A handle goes over so JS can call back with what was clicked, which is the one thing that cannot be
    ///done by return value: the click happens long after the call that set the tool.
    ///</summary>
    private async Task startSelecting()
    {
        await pickShapes(withHandles: true);
    }

    ///
    ///The same, with the corner handles out of the way.
    ///
    ///**A drag moves the whole shape here, and cannot reshape it.** The handles sit on top of the shape they
    ///belong to and are tested before it - they have to be, or a click meant for one would re-select the
    ///shape under it and take the handles away. The cost is that a chosen shape has a ring of corners that
    ///all catch a drag, and on a small one there is barely anywhere left to take hold of it: aiming to move
    ///a shape and pulling a corner out of it instead is a slip that looks like the tool working.
    ///
    ///So moving is its own tool rather than a modifier. Choosing, the rubber band, and everything the panel
    ///offers are unchanged; the only difference is that nothing intercepts a drag.
    ///
    private async Task startMoving()
    {
        await pickShapes(withHandles: false);
    }

    ///
    ///Switches the pointer to picking shapes out, with or without the handles that reshape one.
    ///
    ///A handle goes over so JS can call back with what was clicked, which is the one thing that cannot be
    ///done by return value: the click happens long after the call that set the tool.
    ///
    private async Task pickShapes(bool withHandles)
    {
        await emptyHand();

        measuring = false;
        selecting = true;
        moving = !withHandles;
        drawingShapes = false;
        chosenIndexes = new List<int>();

        await js.InvokeVoidAsync("stopRuler");
        await js.InvokeVoidAsync("stopDrawing");

        selectionHandle ??= DotNetObjectReference.Create(this);

        await js.InvokeVoidAsync("startSelecting", selectionHandle, withHandles);

        await toolChosen();
    }

    ///<summary>Whether the tool in hand is Move rather than Select - the same picking, without the handles.</summary>
    private bool moving = false;

    ///
    ///Which tool is in hand, as the one word a session holds.
    ///
    ///Worked out from the four switches rather than kept beside them, so there is nothing to hold in step:
    ///the switches are what the view actually reads, and a fifth field saying the same thing would only
    ///ever be a chance for the two to disagree. Pan is none of them, which is what it has always been.
    ///
    private string toolInUse()
    {
        if (measuring)
            return "Measure";

        if (drawingShapes)
            return "Draw";

        if (moving)
            return "Move";

        if (selecting)
            return "Select";

        return "Pan";
    }

    ///<summary>What was last written into a session, so choosing the tool already in hand writes nothing.</summary>
    private string toolSaved = "Pan";

    ///
    ///The bar redrawn and the session written, which is what choosing a tool now means.
    ///
    ///It used to be the redraw alone, and the note on OnToolChanged said why: a tool is what you are doing
    ///now rather than how you left the file. That was the right line to draw until somebody asked for the
    ///tool back, and the answer to "which of these is a setting" is theirs rather than mine.
    ///
    ///**Only on a change.** Every tool button calls its method whether or not it was already lit, and the
    ///keyboard shortcuts reach the same methods - so without this, pressing P twice would write twice, and
    ///pressing the tool you are already in would write for nothing at all.
    ///
    private async Task toolChosen()
    {
        //Any tool actually taken up answers the refusal: it was about the one gesture that could not be
        //made, and a line still saying so under a different tool is about nothing on screen.
        drawRefusal = "";

        await OnToolChanged.InvokeAsync();

        if (toolInUse() == toolSaved)
            return;

        toolSaved = toolInUse();

        await OnSettingsChanged.InvokeAsync();
    }

    ///
    ///Lets go of whatever is in hand before something else is taken up - a tool, one of the pencil's shapes, a cell or a
    ///Generator structure to carry, or writing or a picture (2026-10-21, asked for). A cell or a structure being carried
    ///is put back, the way Esc puts it back; writing or a picture whose frame is up is put down for good, its words kept;
    ///and a polygon or a path half drawn is dropped, as choosing another shape always dropped it.
    ///
    ///**What is carried takes every press before any tool does**, for as long as it is carried - see onPointerDown in
    ///the interop. Choosing Text with a Generator structure in hand left the structure in hand, so the next click put
    ///down another structure rather than writing; choosing Select left it too, and a click meant to pick a shape out
    ///put one down. One thing in hand at a time, and it is the one asked for last.
    ///
    private async Task emptyHand()
    {
        await settlePiece();

        await putBack();

        await js.InvokeVoidAsync("clearDrawing");
    }

    ///<summary>Puts back the cell or Generator structure in hand, the way Esc does. False when nothing was in hand.</summary>
    private async Task<bool> putBack()
    {
        if (carrying.Length == 0 && stamp is null)
            return false;

        carrying = "";
        stamp = null;

        await js.InvokeVoidAsync("stopCarrying");

        return true;
    }

    ///<summary>Whether a cell or a Generator structure is in hand, which a click puts down whatever the pencil's shape is.</summary>
    private bool carryingAnything => carrying.Length > 0 || stamp is not null;

    ///
    ///A shortcut, by name.
    ///
    ///**One way in, dispatching to the same methods the buttons call.** A shortcut that did its own version
    ///of undo, or of delete, would be a second implementation to keep in step with the first - and the one
    ///that gets forgotten is always the one nobody is looking at. What the keyboard adds is a way to reach
    ///these, not a set of things only it can do.
    ///
    ///Anything the current state does not allow is nothing: Delete with nothing chosen, Paste with an empty
    ///clipboard. Each of those already checks for itself, because the button that does it is not on screen
    ///in that state either.
    ///
    ///Draw outside a cell is the one that answers rather than going quiet - it is a whole tool refusing, not
    ///one action having nothing to act on. It says so through the same method the button calls, which is
    ///what makes the two agree. See startDrawingShapes.
    ///
    [JSInvokable]
    public async Task OnShortcut(string what)
    {
        if (what == "undo")
            await undo();
        else if (what == "redo")
            await redo();
        else if (what == "copy")
            await copyChosen();
        else if (what == "cut")
            await cutChosen();
        else if (what == "paste")
            await pasteClipboard();
        else if (what == "all")
            await chooseEverything();
        else if (what == "delete")
            await deleteChosen();
        else if (what == "none")
            await choose(new List<int>());
        else if (what == "pan")
            await usePan();
        else if (what == "measure")
            await startMeasuring();
        else if (what == "select")
            await startSelecting();
        else if (what == "move")
            await startMoving();
        else if (what == "draw")
            await startDrawingShapes();
        else if (what == "grid")
            await toggleGrid();
    }

    ///
    ///Picks out everything the cell being edited holds, or the whole layout when no cell is being edited.
    ///
    ///What the current cell holds rather than every shape on screen, because that is what all the things
    ///worth doing to a selection act on - and choosing a thousand shapes that cannot be changed only to have
    ///every button stay away is a worse answer than choosing the ones that can.
    ///
    private async Task chooseEverything()
    {
        if (layout is null)
            return;

        var picked = new List<int>();
        var reachable = reachableLayers();

        for (int i = 0; i < layout.Elements.Count; i++)
        {
            //"Everything" means everything that can be worked on: what is drawn and not locked.
            if (!Picking.InReach(layout.Elements[i], reachable))
                continue;

            if (context is null || context.Holds(layout.Elements[i]))
                picked.Add(i);
        }

        await choose(picked);
    }

    ///<summary>
    ///What the pointer landed on, by its place in the flattened layout. Minus one for the background,
    ///which clears rather than leaving the last thing picked out.
    ///</summary>
    ///
    ///Which element is under a point, for the click that is about to be made of it.
    ///
    ///**Synchronous on purpose.** The answer decides, at pointer-down, whether the drag that may follow is
    ///a shape being moved or a rubber band being pulled - so it has to be known before the pointer moves,
    ///not one round trip later. Blazor WebAssembly runs .NET on the same thread as the page, so
    ///`invokeMethod` returns a value; on a server-hosted app it could not, which is worth knowing before
    ///anyone tries to host one.
    ///
    ///Cheap enough to do per click: a walk of the layout testing cached boxes, and the shape's real outline
    ///only for the few that could be it. See <see cref="Picking"/>.
    ///
    [JSInvokable]
    public int HitTest(double x, double y, int label)
    {
        if (layout is null || ShowLayers is null)
            return -1;

        var at = new Element.Point((int)Math.Round(x), (int)Math.Round(y));
        var reachable = reachableLayers();

        int found = Picking.At(layout, at, reachable, context);

        //A label the browser found under the pointer, if there was one. Labels are still drawn as their
        //own nodes, so the two answers have to be reconciled - see Picking.Preferred.
        if (label < 0 || label >= layout.Elements.Count)
            return found;

        //
        //**And only one within reach, like the geometry.** What the browser hands over is the nearest node
        //carrying an element's index, and that is not only a label: the dashed outline drawn round a chosen
        //shape carries one too. So a shape chosen on a layer since hidden was chosen again by pressing on its
        //own outline, and a locked layer's labels - full strength, since the fade is a rule on paths - went
        //on answering clicks the layer's shapes no longer took.
        //
        if (!Picking.InReach(layout.Elements[label], reachable))
            return found;

        return Picking.Preferred(layout, context, found, label);
    }

    [JSInvokable]
    public async Task OnElementSelected(int index, bool adding)
    {
        if (layout is null || index < 0 || index >= layout.Elements.Count)
        {
            await choose(new List<int>());

            return;
        }

        var picked = new List<int>();

        if (adding)
        {
            picked.AddRange(chosenIndexes);

            //Holding the modifier over one already chosen takes it out again, which is the half of
            //"toggle" that a selection is unusable without.
            if (!picked.Remove(index))
                picked.Add(index);
        }
        else
        {
            picked.Add(index);
        }

        //
        //**Clicking a shape is what puts you in its cell.** There was a button for this, and it cost three
        //actions to move one thing: click the shape, press Edit - which let go of the selection, because
        //entering re-marks every shape - and click the shape again. Nothing was learned in between.
        //
        //Only for a plain click. Adding to a selection is about the set rather than about where to work,
        //and a modifier-click on a shape of another cell would otherwise throw away what was held.
        //
        if (!adding && !heldByContext(index) && descendsOnClick(index))
        {
            await enterCellOf(index, picked);

            return;
        }

        await choose(picked);
    }

    ///
    ///Whether this click should descend, or only pick out what it landed on.
    ///
    ///**A placement is a thing in its own right, and a click has to be able to mean it.** Moving, turning,
    ///mirroring, deleting and flattening an instance all act on the placement rather than on the cell's
    ///contents, and the only way to say which one is meant is which one is chosen - so descending on every
    ///click would take all five away. Descending on the *second* click is the usual way out of that, and it
    ///reads the way it behaves: the first click takes hold of the thing, another goes inside it.
    ///
    ///A shape the top structure owns outright has no placement to take hold of instead, so there is nothing
    ///to choose between and it descends at once. That is the flat file, which is most of them, and it is
    ///the case the button was most obviously in the way of.
    ///
    private bool descendsOnClick(int index)
    {
        if (layout is null || layout.Elements[index].Source is not ElementSource source)
            return false;

        if (source.IsDirectlyEditable)
            return true;

        //The second click on the same shape: it was taken hold of, and this one goes inside.
        return chosenIndexes.Count == 1 && chosenIndexes[0] == index;
    }

    ///<summary>Whether the cell being edited is already the one that shape belongs to.</summary>
    private bool heldByContext(int index)
    {
        if (context is null || layout is null)
            return false;

        return context.Holds(layout.Elements[index]);
    }

    ///
    ///Descends into the clicked shape's cell and leaves it chosen.
    ///
    ///The selection has to be re-applied *after* the redraw entering causes, not before: the marks are on
    ///the markup, and the markup is about to be replaced. `remarkChosen` is what carries it across, the
    ///same way an edit that keeps its selection does.
    ///
    private async Task enterCellOf(int index, List<int> picked)
    {
        if (layout is null || layout.Elements[index].Source is not ElementSource source)
        {
            await choose(picked);

            return;
        }

        chosenIndexes = picked;

        await useContext(CellContext.At(source), keepChosen: true);
    }

    ///<summary>
    ///Everything the rubber band caught, by its box in the layout's coordinates.
    ///
    ///Whether a shape is in the box is answered here rather than in the browser: the geometry is here, and
    ///two places both believing they know would be a selection that shows one thing and acts on another.
    ///Caught by touching rather than by being wholly inside, which is what a drag across a dense layout is
    ///usually reaching for.
    ///</summary>
    [JSInvokable]
    public async Task OnBandSelected(double fromX, double fromY, double toX, double toY, bool adding)
    {
        if (layout is null)
            return;

        var box = new Bounds(
            (int)Math.Round(Math.Min(fromX, toX)),
            (int)Math.Round(Math.Min(fromY, toY)),
            (int)Math.Round(Math.Max(fromX, toX)),
            (int)Math.Round(Math.Max(fromY, toY)));

        var picked = new List<int>();

        if (adding)
            picked.AddRange(chosenIndexes);

        //A band takes what a click would take. It used to sweep up every faded shape it crossed, and every
        //hidden one, which is the same fault as clicking one - see reachableLayers.
        foreach (int caught in Picking.Caught(layout, box, reachableLayers()))
        {
            if (!picked.Contains(caught))
                picked.Add(caught);
        }

        //
        //**A band lands in the cell it caught, the same way a click does.**
        //
        //Clicking a shape a top structure owns outright descends into that structure at once - see
        //descendsOnClick - so a click is a way into a cell and a band was not. Dragging one over a second
        //top-level cell left every shape in it chosen, none of them editable from where you were, and a
        //panel offering Copy and nothing else: no Delete, and no word about why.
        //
        //Reported that way, on a file whose cells are two tops rather than one placed in the other.
        //
        if (!adding && bandLandsIn(picked) is int landing)
        {
            await enterCellOf(landing, picked);

            return;
        }

        await choose(picked);
    }

    ///
    ///The one shape to descend through when a band caught a whole cell, or null when it did not.
    ///
    ///Three conditions, and each rules out a case where descending would be wrong.
    ///
    ///**Nothing of the current cell's own**, because a selection holding any of those is a selection about
    ///where you already are, and leaving would throw that away.
    ///
    ///**All at depth zero**, which is the same test descendsOnClick makes before it descends at once. A
    ///shape reached through a placement is deliberately not this: a placement is a thing in its own right
    ///and taking hold of it is what lets it be moved, turned or deleted, so a band over one leaves it
    ///chosen rather than diving past it.
    ///
    ///**All from one structure**, because there is no single cell to enter otherwise - and entering the
    ///first of several would be a guess dressed up as an answer.
    ///
    private int? bandLandsIn(List<int> picked)
    {
        if (layout is null || context is null || picked.Count == 0)
            return null;

        string? named = null;

        foreach (int index in picked)
        {
            if (heldByContext(index))
                return null;

            if (layout.Elements[index].Source is not ElementSource source || !source.IsDirectlyEditable)
                return null;

            named ??= source.Structure;

            if (named != source.Structure)
                return null;
        }

        //Already inside it, which a band over the cell being edited from a level above can be.
        if (named == context.Structure)
            return null;

        return picked[0];
    }

    ///<summary>
    ///Makes that set the selection: marks it in the view, and puts handles on it when it is one shape the
    ///current cell may change.
    ///
    ///Handles on one only. On a dozen shapes at once they would be a hundred circles over the geometry,
    ///and a corner drag has no meaning across a set anyway.
    ///</summary>
    private async Task choose(List<int> picked, Nets.Walk? tracing = null, List<string>? named = null)
    {
        var wasOn = ChosenByLayer();

        chosenIndexes = picked;

        //A different selection is a different question, so whatever a trace found stops being the answer -
        //unless this is the trace, which hands its walk and the net's names in with what it reached. Handed in
        //rather than set afterwards, or the panel renders once without them and the trace's rows flicker out
        //and back on every step. See traceFurther for why the names are not worked out from the selection.
        netWalk = tracing;
        netTraced = tracing is not null;
        netNames = named ?? new List<string>();

        //And the layer list closes with it. It names the layer of whatever was chosen when it opened, so
        //left open over a new selection it is a list of somewhere else - and the next thing clicked in it
        //would move shapes the person had stopped looking at.
        chosenLayerOpen = false;

        await markChosen();

        //
        //**And the sidebar, when what it marks has changed.** Which rows are lit for the selection is decided
        //in the shell's render, like the row marked for drawing, and this view's own StateHasChanged does not
        //cause one - see OnToolChanged. Only on a change: most clicks land on another shape of a layer already
        //lit, or on bare canvas with nothing chosen, and redrawing the shell for those draws it the same.
        //
        //What was chosen before this call is what the sidebar is showing, because every other way the
        //selection changes redraws the shell already: a tool taken up, a cell entered or left, an edit, and a
        //redraw the shell asked for itself.
        //
        if (sameCounts(wasOn, ChosenByLayer()) || !OnToolChanged.HasDelegate)
        {
            StateHasChanged();

            return;
        }

        //
        //**Instead of this view's own render, not as well as it.** The shell draws this view again as part of
        //its own render, so asking for both drew the whole view twice for every click that moved the mark.
        //
        await OnToolChanged.InvokeAsync();
    }

    ///<summary>
    ///Puts the highlight and the handles on whatever is currently chosen.
    ///
    ///Apart from <see cref="choose"/>, because an edit that keeps its selection has to do this *after* the
    ///render that follows it - the nodes being marked do not exist until then.
    ///</summary>
    private async Task markChosen()
    {
        await js.InvokeVoidAsync("showSelection", chosenIndexes, chosenOutlines());

        //Not while moving: a handle is there to be pulled, and the tool exists so that nothing is.
        if (!moving && Only is Element one && context is not null && context.Holds(one) && one.Text is null)
        {
            await js.InvokeVoidAsync("showVertexHandles", handlesOn(one));
        }
        else
        {
            await js.InvokeVoidAsync("clearVertexHandles");
        }
    }

    ///
    ///The corners of each chosen shape, for the highlight to be drawn from.
    ///
    ///**Sent rather than looked up.** The highlight used to be a class put on the shape's own node, which
    ///worked while there was one node per shape; the geometry is one path per layer now, and a class on
    ///that would outline the whole layer. So the few shapes that are chosen are drawn again, over the top.
    ///
    ///Few is the point. A selection is one shape, or a band's worth - not the layout - so this stays a
    ///handful of nodes and a selection stays instant, which is what it has to be. Rebuilding the markup to
    ///change what is chosen would cost the whole file per click.
    ///
    ///Empty entries for the labels: those are still nodes of their own and are marked rather than redrawn.
    ///
    private List<string> chosenOutlines()
    {
        var outlines = new List<string>();

        if (layout is null)
            return outlines;

        foreach (int index in chosenIndexes)
        {
            if (index < 0 || index >= layout.Elements.Count || layout.Elements[index].Text is not null)
            {
                outlines.Add("");

                continue;
            }

            var corners = new StringBuilder();

            foreach (var corner in layout.Elements[index].Points)
            {
                if (corners.Length > 0)
                    corners.Append(' ');

                corners.Append(corner.X.ToString(CultureInfo.InvariantCulture));
                corners.Append(',');
                corners.Append(corner.Y.ToString(CultureInfo.InvariantCulture));
            }

            outlines.Add(corners.ToString());
        }

        return outlines;
    }

    ///
    ///Where a shape's corner handles go: on the coordinates the *file* holds, not on the ones it draws.
    ///
    ///**They are the same list for a boundary and they are not for a path.** A path is stored as a
    ///centerline and drawn as the outline built around it, so a three-point wire draws six corners - and
    ///handles put on those would be six handles for three coordinates. Dragging one calls
    ///<see cref="OnCornerDragged"/>, which moves the coordinate at that index: the back half would be past
    ///the end and do nothing, and the front half would move a point that is not where the hand is.
    ///
    ///Put through the shape's own placement, which is what the flattener did to arrive at the drawn points -
    ///so for a boundary this is exactly what was there before, and for a cell placed turned the handles land
    ///on the corners as they appear rather than as the cell stores them.
    ///
    private static IEnumerable<object> handlesOn(Element one)
    {
        if (one.Source is not ElementSource source || source.Model.Element.XY?.Data is not Int4Data xy)
            return one.Points.Select(point => new { x = point.X, y = point.Y });

        var corners = new List<object>();

        for (int i = 0; i + 1 < xy.Values.Length; i += 2)
        {
            var at = source.Placement.Apply(xy.Values[i], xy.Values[i + 1]);

            corners.Add(new { x = at.X, y = at.Y });
        }

        return corners;
    }

    ///<summary>
    ///One corner dragged, in the layout's coordinates - brought into the cell the same way a whole shape
    ///is, since a corner of a turned cell moves in the same turned space the shape does.
    ///</summary>
    [JSInvokable]
    public async Task OnCornerDragged(int corner, double dx, double dy)
    {
        //One shape only, which is what handles are shown on: a corner drag has no meaning across a set.
        if (Gds is null || context is null || Only is not Element one || one.Source is not ElementSource source)
            return;

        if (!context.Holds(one))
            return;

        //The corner being dragged is what should land on the grid, not the distance it traveled.
        if (corner >= 0 && corner < one.Points.Count)
            (dx, dy) = ontoGrid(one.Points[corner].X, one.Points[corner].Y, dx, dy);

        if (localDistance(dx, dy) is not (int localX, int localY))
            return;

        if (structureNamed(source.Structure) is not GDS.StructureModel structure)
            return;

        History.Do(new MoveVertex(structure, source.Model, corner, localX, localY));

        await afterEdit(keepChosen: true);
    }

    ///<summary>
    ///A rectangle dragged out, given by two opposite corners in the layout's coordinates.
    ///
    ///Axis-aligned on screen rather than in the cell: the four corners are built in the layout's space and
    ///each brought back through the placement, so a rectangle drawn on a cell that is turned comes out
    ///turned with it rather than square to the cell and skewed on screen.
    ///</summary>
    [JSInvokable]
    public async Task OnRectangleDrawn(double fromX, double fromY, double toX, double toY)
    {
        double left = Math.Min(fromX, toX);
        double right = Math.Max(fromX, toX);
        double bottom = Math.Min(fromY, toY);
        double top = Math.Max(fromY, toY);

        await drawOutline(new[] { (left, bottom), (right, bottom), (right, top), (left, top) });
    }

    ///<summary>
    ///A polygon clicked out corner by corner, arriving as one flat run of x and y in the layout's
    ///coordinates.
    ///
    ///Flat rather than a list of pairs because that is what crosses the interop boundary cheaply, and
    ///because the browser has no idea what a point is here - it is only ever passing numbers back that it
    ///got from the same transform a rectangle's corners go through.
    ///</summary>
    [JSInvokable]
    public async Task OnPolygonDrawn(double[] coordinates)
    {
        if (coordinates.Length < 6)
            return;

        var corners = new List<(double, double)>();

        for (int i = 0; i + 1 < coordinates.Length; i += 2)
            corners.Add((coordinates[i], coordinates[i + 1]));

        await drawOutline(corners);
    }

    ///<summary>
    ///Puts an outline given in the layout's coordinates into the cell being edited.
    ///
    ///Each corner is brought back through the placement on its own, which is what makes a shape drawn onto
    ///a cell that is turned come out turned with it rather than square to the cell and skewed on screen.
    ///</summary>
    private async Task drawOutline(IEnumerable<(double X, double Y)> corners)
    {
        if (Gds is null || context is null)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var outline = new List<Element.Point>();

        foreach ((double x, double y) in corners)
        {
            if (context.ToLocal(x, y) is not (double localX, double localY))
                return;

            outline.Add(new Element.Point((int)Math.Round(localX), (int)Math.Round(localY)));
        }

        //A new gesture, so whatever the last one was refused for is not this one's reason.
        drawRefusal = "";

        //
        //**An ellipse's corners are worked out, not placed**, so they go on the deck's grid - see deckGrid. The
        //preview drew them where the arithmetic put them, a fraction of a grid step away. A rectangle's and a
        //polygon's corners are where the pointer put them, which snapping has already seen to.
        //
        if (drawShape == DrawShape.Ellipse && deckGrid(drawOn) > 1)
        {
            outline = Grid.Snap(outline, deckGrid(drawOn));

            if (notAShape(outline))
            {
                drawRefusal = $"Too small for {deckGridSaid(drawOn)}: put on it, its corners come out flat. Drag it out larger, or turn snapping off.";

                //Called from the browser, which does not redraw the way a press does.
                StateHasChanged();

                return;
            }
        }

        //A shape with two distinct corners has no area, whatever the third one repeated. The browser stops
        //a stray click from becoming a rectangle; this is the same guard for the outline that got here by
        //some other route.
        if (outline.Distinct().Count() < 3)
            return;

        //Joining, when the shape lands on something already on the layer: one step that takes those shapes
        //out and puts their union with this one in. An add followed by a merge would draw the same picture
        //and cost two presses of undo, which is two presses to get back a shape that was never separately
        //there.
        //
        //Asked here as well as in the toolbar, so the rule about which shapes this is for is one rule rather
        //than two. Nothing that is not an area reaches this method today - a path and a label each have
        //their own - and the switch that stays on behind a hidden button is what that guards against.
        if (joining && joinable(drawShape))
        {
            var touching = joinedTo(structure, drawOn, new[] { outline });

            if (touching.Count > 0)
            {
                var joining = outlinesOf(touching);
                joining.Add(outline);

                //On the deck's grid like any union. One the grid would fold is drawn unjoined rather than not at
                //all: the shape is what was asked for, and the join is the switch's doing.
                if (ontoDeckGrid(Booleans.CombineAll(joining, BooleanOperation.Or), drawOn, "Drawn, not joined") is List<List<Element.Point>> joined)
                {
                    await replaceWith(touching, joined, "Draw joined");

                    return;
                }
            }
        }

        History.Do(new AddElement(Gds, structure, drawOn, outline));

        await afterEdit();
    }

    ///
    ///The shapes already in the cell that a new outline on this layer would become one with.
    ///
    ///Followed as a chain rather than in one pass, because what the new shape reaches may itself reach
    ///further: a square painted into the gap between two runs that already touch should come out one shape,
    ///not a new shape welded to the nearer run with the far one left sitting beside it.
    ///
    ///**Boundaries only.** A path is a centerline and a width rather than a region, a label is a string, and
    ///an instance is somebody else's cell. None of them is an area this can add to, and quietly turning one
    ///into a boundary is not a merge.
    ///
    ///Boxes decide what touches what, and <see cref="Bounds.Intersects"/> counts touching, so two rectangles
    ///sharing an edge are in. Boxes rather than real outlines because being generous costs nothing that
    ///shows: a shape pulled in that turns out to meet nothing comes back out of the union unchanged, as its
    ///own outline.
    ///
    ///
    ///<paramref name="except"/> is what is already going into the union - the shapes being moved, whose own
    ///outlines seed the search. Without it they would find themselves, and a shape would be deleted twice.
    ///
    private static List<GDS.ElementModel> joinedTo(
        GDS.StructureModel structure,
        LayerKey layer,
        IReadOnlyList<IReadOnlyList<Element.Point>> outlines,
        ISet<GDS.ElementModel>? except = null)
    {
        var candidates = new List<(GDS.ElementModel Model, Bounds Box)>();

        foreach (var model in structure.Elements)
        {
            if (model.Element is not GDS.BoundaryModel)
                continue;

            if (layerOf(model) != layer)
                continue;

            if (except is not null && except.Contains(model))
                continue;

            if (model.Element.XY?.Data is not Int4Data xy || xy.Values.Length < 6)
                continue;

            candidates.Add((model, boundsOf(xy)));
        }

        var taken = new List<GDS.ElementModel>();

        //Breadth first, taking each shape out of the running as it is reached, so every shape is tested
        //against every box at most once however long the chain runs.
        var reaching = new Queue<Bounds>();

        foreach (var outline in outlines)
            reaching.Enqueue(Bounds.Of(outline));

        while (reaching.Count > 0)
        {
            var box = reaching.Dequeue();

            for (int i = candidates.Count - 1; i >= 0; i--)
            {
                if (!box.Intersects(candidates[i].Box))
                    continue;

                taken.Add(candidates[i].Model);
                reaching.Enqueue(candidates[i].Box);

                candidates.RemoveAt(i);
            }
        }

        return taken;
    }

    ///<summary>The box around an element's coordinates, in whatever space they are already in.</summary>
    private static Bounds boundsOf(Int4Data xy)
    {
        var corners = new List<Element.Point>();

        for (int i = 0; i + 1 < xy.Values.Length; i += 2)
            corners.Add(new Element.Point(xy.Values[i], xy.Values[i + 1]));

        return Bounds.Of(corners);
    }

    ///<summary>
    ///A distance in the layout's coordinates, as one in the cell's.
    ///
    ///Two points converted rather than the distance itself: a translation put through a transform picks
    ///up that transform's own offset as well, which for a placed cell is wherever it was placed.
    ///</summary>
    ///
    ///Adjusts a move so that what is being moved lands *on* the grid, rather than a whole number of steps
    ///from wherever it happened to be.
    ///
    ///**A file drawn on an incompatible grid was never pulled onto the current one.** Both ends of a drag
    ///are snapped, so the distance between them is always a multiple of the pitch - which means a shape
    ///that started off the grid kept its offset for ever, however many times it was moved. Snapping was
    ///quietly preserving the file's old grid instead of applying the one in force.
    ///
    ///So the *result* is snapped rather than the distance. The anchor is the given point - the left-bottom
    ///corner of what is chosen for a whole shape, the corner itself for a corner drag - which is the
    ///coordinate the panel prints as "At", so what lands on the grid is the number somebody can read.
    ///
    ///In the layout's own coordinates, where the pitch is defined. The move is converted into the cell's
    ///afterwards by <see cref="localDistance"/>, so a placement that only shifts a cell comes out right;
    ///one that also scales it does not, and neither did anything else here that reasons in layout units.
    ///
    private (double X, double Y) ontoGrid(double anchorX, double anchorY, double dx, double dy)
    {
        if (!snapping)
            return (dx, dy);

        double step = gridUnits();

        if (step <= 0)
            return (dx, dy);

        return (alignedOn(anchorX, dx, step), alignedOn(anchorY, dy, step));
    }

    ///
    ///One axis of that, and only if it moved.
    ///
    ///An arrow key moves in one direction, and pulling the other axis onto the grid at the same time means a
    ///press of Right that also slides the shape down - measured at 460 units on the bundled cell, which is
    ///nobody's idea of what that key does. A drag moves both and so aligns both; a nudge aligns the way it
    ///was nudged, and the other axis comes on when it is moved in turn.
    ///
    private static double alignedOn(double anchor, double delta, double step)
    {
        if (delta == 0)
            return delta;

        double lands = anchor + delta;

        return delta + ((Math.Round(lands / step) * step) - lands);
    }

    private (int X, int Y)? localDistance(double dx, double dy)
    {
        if (context is null)
            return null;

        if (context.ToLocal(0, 0) is not (double zeroX, double zeroY))
            return null;

        if (context.ToLocal(dx, dy) is not (double movedX, double movedY))
            return null;

        int localX = (int)Math.Round(movedX - zeroX);
        int localY = (int)Math.Round(movedY - zeroY);

        if (localX == 0 && localY == 0)
            return null;

        return (localX, localY);
    }

    ///<summary>
    ///Descends into the cell a shape belongs to.
    ///
    ///The whole layout stays drawn - everything outside the cell is faded rather than hidden, which is
    ///what "in place" means: a cell edited without its surroundings is a cell edited blind.
    ///</summary>
    private async Task enterCell(ElementSource source)
    {
        await useContext(CellContext.At(source));
    }

    ///<summary>Jumps to one level of the chain, which is what makes a breadcrumb a way out and not a label.</summary>
    private async Task enterLevel(int depth)
    {
        if (context is null)
            return;

        await useContext(context.To(depth));
    }

    private async Task leaveCell()
    {
        await useContext(null);
    }

    ///
    ///Enters, leaves or changes the cell being edited.
    ///
    ///`keepChosen` is for the click that enters a cell by landing on one of its shapes: the shape stays
    ///chosen across the change, which is what makes clicking it enough to start working on it. Everything
    ///else - the breadcrumb, All, leaving on a new file - lets go, because what was chosen belonged to the
    ///cell being left.
    ///
    private async Task useContext(CellContext? entered, bool keepChosen = false)
    {
        string wasEditing = context?.Structure ?? "";

        context = entered;

        //Whichever way this went, the refusal is about a cell that is no longer the one open - and leaving
        //a cell earns its own answer next time Draw is asked for rather than inheriting the last one.
        drawRefusal = "";

        if (!keepChosen)
            chosenIndexes = new List<int>();

        //Every shape is about to be marked differently, so the highlight and what it pointed at both go.
        //What is chosen is remembered in chosenIndexes rather than in the markup, so it survives this and
        //is put back by remarkChosen once the new markup is on screen.
        await js.InvokeVoidAsync("clearSelection");

        remarkChosen = keepChosen && chosenIndexes.Count > 0;

        redraw();

        await OnToolChanged.InvokeAsync();

        //
        //And a save, because which cell is open is now part of a session.
        //
        //It was only OnToolChanged, which redraws the bar and deliberately writes nothing - the note on it
        //says a tool is not part of a session, and that was true of the context too until it started coming
        //back.
        //
        //**Only when the cell actually changed.** This runs on every click that lands on a shape, and most
        //of those are another shape in the cell already open - so writing unconditionally would put a store
        //write behind a large share of the clicks in the editor, to record something that had not moved.
        //What is left is entering a cell, walking the breadcrumb and leaving, which is a handful of times in
        //a sitting and the same price a grid switch pays.
        //
        if ((entered?.Structure ?? "") != wasEditing)
            await OnSettingsChanged.InvokeAsync();
    }

    ///<summary>
    ///Rebuilds the markup for the current context, without re-resolving the hierarchy.
    ///
    ///Flattening depends only on the file, and descending into a cell changes nothing about the file - so
    ///doing the walk again on every step through a breadcrumb would be the most expensive thing in the
    ///view happening for no reason at all.
    ///</summary>
    private void redraw()
    {
        if (layout is null || ShowLayers is null)
            return;

        //The first picture is still being written at the load's pace - see drawFirstPicture, which draws this then.
        if (firstPicture is not null)
        {
            redrawOwed = true;

            return;
        }

        countPlacements();

        markersDrawn = Markers;

        //
        //**Nothing at all until a large layout has been framed.** See waitingForFit: what is worth drawing
        //depends on where the view is and how big a pixel is, and neither is known until the fit.
        //
        if (waitingForFit)
        {
            svgString = "";

            StateHasChanged();

            return;
        }

        var visible = CheckboxItem.VisibleLayers(ShowLayers);
        var labeled = labeledAtThisZoom();
        var window = shownBox();
        long smallest = smallestWorthDrawing();

        //
        //**Not built again from the same things.** A redraw is asked for from all over this view and the
        //shell - a render, a settle, a cell entered, settings handed over - and several of them often come
        //in a row with nothing changed in between: opening the RGB mixer built the same eleven-million
        //character picture three times over, six and a half seconds each on the dev server. So what the
        //picture is built from is written down, and an identical list is the picture already on screen.
        //
        //Everything Build reads is in it: the layout and the cell being edited by reference, since both are
        //replaced rather than changed; which layers are drawn and labeled; the opacity; the window and the
        //smallest size; and each drawn layer's color and fill, which are changed in place on the layer.
        //
        string from = drawnFrom(visible, labeled, window, smallest);

        if (!ReferenceEquals(layout, layoutBuilt) || !ReferenceEquals(context, contextBuilt) || from != builtFrom)
        {
            built = SvgWriter.Build(layout, visible, opacity, labeled, context, window, smallest);

            layoutBuilt = layout;
            contextBuilt = context;
            builtFrom = from;
        }

        //The markers go next to it in markup of their own - see the SVG element.
        svgString = built;

        StateHasChanged();
    }

    ///<summary>The picture as Build last made it, without the markers, and what it was made from.</summary>
    private string built = "";

    private FlattenedLayout? layoutBuilt = null;

    private CellContext? contextBuilt = null;

    private string builtFrom = "";

    ///
    ///Everything a picture is built from that is not held by reference, as one string to compare.
    ///
    ///**Each drawn layer's appearance as well as whether it is drawn.** A color or a fill is changed on the
    ///layer itself and the layout still points at the same layer, so nothing about the layout says it changed
    ///- and a picture kept across a color change would be the old color.
    ///
    private string drawnFrom(IReadOnlySet<LayerKey> visible, IReadOnlySet<LayerKey> labeled, Bounds? window, long smallest)
    {
        var said = new StringBuilder();

        said.Append(SvgWriter.FormatOpacity(opacity));
        said.Append('|');
        said.Append(window?.ToString() ?? "all");
        said.Append('|');
        said.Append(smallest.ToString(CultureInfo.InvariantCulture));

        if (ShowLayers is null || Gds is null)
            return said.ToString();

        foreach (var item in ShowLayers)
        {
            if (!visible.Contains(item.Id))
                continue;

            said.Append('|');
            said.Append(item.Id.ToString());

            if (labeled.Contains(item.Id))
                said.Append('+');

            if (Gds.AdditionalInformation.Layers.TryGetValue(item.Id, out var layer))
            {
                said.Append(layer.Color);
                said.Append(',');
                said.Append(layer.Fill.ToString());
                said.Append(',');
                said.Append(layer.PatternColor);
                said.Append(',');
                said.Append(layer.PatternPixels?.ToString(CultureInfo.InvariantCulture));
            }
        }

        return said.ToString();
    }

    ///
    ///The layers whose labels are drawn: what the rows say, unless the view is too far out to read any name.
    ///
    ///Only above <see cref="CullAbove"/>, the same as everything else this view leaves out - below it every
    ///label is drawn at every zoom, as it always was. See <see cref="SvgWriter.LabelsLegibleAt"/>.
    ///
    private IReadOnlySet<LayerKey> labeledAtThisZoom()
    {
        var labeled = CheckboxItem.LabeledLayers(ShowLayers!);

        if (layout is null || layout.Elements.Count <= CullAbove)
            return labeled;

        if (SvgWriter.LabelsLegibleAt(unitsPerPixel))
            return labeled;

        return new HashSet<LayerKey>();
    }

    ///
    ///How many times the cell being edited is placed, worked out when the layout or the cell changes.
    ///
    ///Distinct placements of the cell, not shapes in it: many shapes share one placement, and it is the
    ///placements that say how many copies an edit moves.
    ///
    ///**Once per layout and cell, not once per redraw**, which is what the note on placements always said
    ///and what was not so: it was counted again on every redraw, a walk of every element - and on opening,
    ///a file is already in its top cell, so that was every redraw there was.
    ///
    private void countPlacements()
    {
        string cell = context?.Structure ?? "";

        if (ReferenceEquals(layout, placementsCountedIn) && cell == placementsCountedFor)
            return;

        placementsCountedIn = layout;
        placementsCountedFor = cell;
        placements = 0;

        if (context is null || layout is null)
            return;

        placements = layout.Elements
            .Where(context.Holds)
            .Select(element => element.Source!.Placement)
            .Distinct()
            .Count();
    }

    private FlattenedLayout? placementsCountedIn = null;

    private string placementsCountedFor = "";

    ///
    ///A drag, arriving as a distance in the layout's coordinates.
    ///
    ///**Brought into the cell before it is written.** A cell placed at a quarter turn draws its shapes
    ///sideways, so dragging one to the right on screen means moving it *up* in the cell - and the number
    ///that goes into the file is the second. Two points are converted rather than the distance itself,
    ///because a translation put through a transform picks up that transform's own offset.
    ///
    ///Rounded once, here. GDSII coordinates are whole numbers, so a drag lands on the grid whatever the
    ///pointer did.
    ///
    [JSInvokable]
    public async Task OnElementDragged(double dx, double dy)
    {
        if (Gds is null || context is null)
            return;

        //Only what the current cell holds may be moved. Anything else is showing, not editable.
        var moving = Editable;

        if (moving.Count == 0)
        {
            await dragInstance(dx, dy);

            return;
        }

        //Landed on the grid rather than a whole number of steps from wherever it was. See ontoGrid.
        Bounds standing = chosenBounds();

        (dx, dy) = ontoGrid(standing.Left, standing.Bottom, dx, dy);

        if (localDistance(dx, dy) is not (int localX, int localY))
            return;

        //**Distinct models, not distinct shapes.** Two chosen shapes may be two instances of one element,
        //and moving that element once per instance would move it twice as far as it was dragged.
        var edits = new List<LayoutEdit>();
        var already = new HashSet<GDS.ElementModel>();

        foreach (var element in moving)
        {
            if (element.Source is not ElementSource source || !already.Add(source.Model))
                continue;

            if (structureNamed(source.Structure) is GDS.StructureModel structure)
                edits.Add(new MoveElement(structure, source.Model, localX, localY));
        }

        if (edits.Count == 0)
            return;

        if (joining && joinMoved(already, localX, localY) is List<LayoutEdit> merged)
        {
            History.Do(new CompoundEdit("Move joined", merged));

            //Everything that went in has gone and what came out is new, so the indexes no longer name what
            //they named - unlike a plain move, which leaves every element where it was in the file.
            await afterEdit();

            return;
        }

        History.Do(new CompoundEdit("Move", edits));

        await afterEdit(keepChosen: true);
    }

    ///
    ///The whole move, as taking the shapes out and putting their union with what they land on back in - or
    ///null when they land on nothing and a plain move is the honest edit.
    ///
    ///**Worked out before the move rather than after it.** The shapes have to be where they are going before
    ///anything can say what they touch, and applying the move first would mean a second edit afterwards -
    ///two presses of undo for one drag. A moved outline is its corners plus the distance, which is exact, so
    ///the question can be answered without moving anything.
    ///
    ///By layer, because that is what joining means: two shapes on different layers are two shapes wherever
    ///they are. Shapes on a layer that meet nothing keep their `MoveElement` - identity and place in the
    ///file are worth keeping when there is nothing to gain by rewriting them.
    ///
    private List<LayoutEdit>? joinMoved(HashSet<GDS.ElementModel> moved, int dx, int dy)
    {
        if (Gds is null || context is null)
            return null;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return null;

        //A new gesture, so whatever the last one was refused for is not this one's reason.
        drawRefusal = "";

        var edits = new List<LayoutEdit>();
        bool joined = false;

        foreach (var layer in moved.Select(layerOf).Distinct().ToList())
        {
            var onLayer = moved.Where(model => layerOf(model) == layer).ToList();

            //Areas only, and the rest of what was dragged simply moves. A label and a path travel on a
            //layer without being areas on it, and sweeping them into the union would delete them - the
            //shapes going in come back out as one outline, and a string is not part of an outline.
            var areas = new List<GDS.ElementModel>();
            var shifted = new List<IReadOnlyList<Element.Point>>();

            foreach (var model in onLayer)
            {
                var outline = shiftedOutline(model, dx, dy);

                if (outline.Count < 3)
                    continue;

                areas.Add(model);
                shifted.Add(outline);
            }

            foreach (var model in onLayer.Where(model => !areas.Contains(model)))
                edits.Add(new MoveElement(structure, model, dx, dy));

            var touching = joinedTo(structure, layer, shifted, moved);

            if (areas.Count == 0 || touching.Count == 0)
            {
                foreach (var model in areas)
                    edits.Add(new MoveElement(structure, model, dx, dy));

                continue;
            }

            joined = true;

            var all = new List<IReadOnlyList<Element.Point>>(shifted);
            all.AddRange(outlinesOf(touching));

            //On the deck's grid like any union, and a move the grid would fold is made unjoined - see Draw joined.
            if (ontoDeckGrid(Booleans.CombineAll(all, BooleanOperation.Or), layer, "Moved, not joined") is not List<List<Element.Point>> union)
                return null;

            foreach (var model in areas)
                edits.Add(new DeleteElement(Gds, structure, model));

            foreach (var model in touching)
                edits.Add(new DeleteElement(Gds, structure, model));

            foreach (var outline in union)
            {
                if (outline.Count < 3)
                    continue;

                edits.Add(new AddElement(Gds, structure, layer, outline));
            }
        }

        if (!joined)
            return null;

        return edits;
    }

    ///<summary>An element's corners moved by a distance, in the cell's own coordinates - through the one transform every placement is applied with, see Transform.</summary>
    private static List<Element.Point> shiftedOutline(GDS.ElementModel model, int dx, int dy)
    {
        var corners = new List<Element.Point>();

        if (model.Element is not GDS.BoundaryModel || model.Element.XY?.Data is not Int4Data xy)
            return corners;

        var shift = new Transform(1, 0, 0, 1, dx, dy);

        for (int i = 0; i + 1 < xy.Values.Length; i += 2)
            corners.Add(shift.Apply(xy.Values[i], xy.Values[i + 1]));

        return corners;
    }

    ///
    ///The same drag, when what was caught belongs to a cell placed here rather than to this one.
    ///
    ///**It moves the placement, which moves everything the placement draws.** Dragging a shape of a placed
    ///cell cannot move that shape alone - the shape lives in another cell and moving it there would move it
    ///in every other instance too. The instance is the thing this cell owns, so the instance is what moves,
    ///which is what a layout editor does and what the note above the buttons says it will do.
    ///
    ///One MoveElement on the reference, because a placement's XY is its single reference point.
    ///
    private async Task dragInstance(double dx, double dy)
    {
        if (chosenInstance() is not (GDS.StructureModel inside, GDS.ElementModel instance, ElementSource _))
            return;

        if (localDistance(dx, dy) is not (int localX, int localY))
            return;

        History.Do(new CompoundEdit("Move", new List<LayoutEdit>
        {
            new MoveElement(inside, instance, localX, localY)
        }));

        await afterEdit(keepChosen: true);
    }

    ///<summary>
    ///What the undo button calls each of them, which is what the person who pressed it saw happen - not
    ///what the arithmetic underneath is called.
    ///</summary>
    private const string TurnLeftName = "Turn left";

    private const string TurnRightName = "Turn right";

    private const string MirrorAcrossName = "Mirror across";

    private const string MirrorDownName = "Mirror down";

    ///<summary>
    ///And the same for lining up. **This view draws Y downwards**, so the edge that looks like the top is
    ///the *least* Y - which a layout format would call the bottom. Applied here and nowhere else.
    ///</summary>
    private const string LeftName = "Line up left";

    private const string CenterName = "Line up centers";

    private const string RightName = "Line up right";

    private const string TopName = "Line up top";

    private const string MiddleName = "Line up middles";

    private const string BottomName = "Line up bottom";

    private const string AcrossName = "Space out across";

    private const string DownName = "Space out down";

    private const string UnionName = "Union";

    private const string SubtractName = "Subtract";

    private const string IntersectName = "Intersect";

    private const string ExcludeName = "Exclude";

    ///<summary>How far growing moves every edge, in microns - the same unit the grid and the array use.</summary>
    private double growMicrons = 0.1;

    ///<summary>Whether the array's boxes are showing. Not saved: it is a panel being open, not a setting.</summary>
    private bool arrayOpen = false;

    private int arrayColumns = 3;

    private int arrayRows = 1;

    ///<summary>
    ///How far apart the copies go, in microns - the same unit the grid pitch is in, and for the same reason.
    ///
    ///Set from the size of what is chosen the first time the boxes are opened, so the copies sit edge to
    ///edge with the original rather than on top of it. That is the commonest thing anybody wants and it
    ///needs no thought; a pitch of nothing at all would produce a pile.
    ///</summary>
    private double arrayPitchX = 1;

    private double arrayPitchY = 1;

    ///<summary>
    ///How many across or down a single array may be.
    ///
    ///Each copy is a real element with all of its records, not a reference to one - GDSII has an AREF for
    ///that, and an AREF places a *cell*, which is a thing this editor cannot yet make. So a big array is a
    ///big file, and this is the line past which somebody has almost certainly typed a number by accident.
    ///</summary>
    public const int MostAcross = 200;

    ///<summary>And the most elements one press may add, whatever the two counts multiply out to.</summary>
    public const int MostCopies = 2000;

    ///<summary>
    ///How many elements the array would add: every place in the grid but the one already occupied, times
    ///the number of separate elements chosen. Zero when there is nothing to add or too much.
    ///</summary>
    private int ArrayCopies
    {
        get
        {
            long places = ((long)arrayColumns * arrayRows) - 1;

            if (places < 1)
                return 0;

            long total = places * DistinctEditable;

            if (total > MostCopies)
                return 0;

            return (int)total;
        }
    }

    private string arrayDescription()
    {
        if (ArrayingInstance)
        {
            if (arrayColumns * arrayRows <= 1)
                return "One across and one down is the instance that is already there";

            return FormattableString.Invariant(
                $"Repeat this placement as one array record, {arrayColumns} by {arrayRows}, at {arrayUnits(arrayPitchX):N0} by {arrayUnits(arrayPitchY):N0} database units");
        }

        if (ArrayCopies == 0 && arrayColumns * arrayRows <= 1)
            return "One across and one down is the shape that is already there";

        if (ArrayCopies == 0)
            return FormattableString.Invariant($"That would add more than {MostCopies:N0} shapes at once");

        return FormattableString.Invariant(
            $"Add {ArrayCopies:N0} more, at {arrayUnits(arrayPitchX):N0} by {arrayUnits(arrayPitchY):N0} database units");
    }

    ///<summary>
    ///How many separate elements the chosen shapes come to, which is what lining up acts on.
    ///
    ///Not how many shapes are on screen: a cell placed three times draws three of everything in it, and all
    ///three are the same records. Two instances of one element are one thing to line up, and offering the
    ///buttons for them would offer to move a shape into line with itself.
    ///</summary>
    private int DistinctEditable
    {
        get
        {
            return Editable
                .Where(element => element.Source is not null)
                .Select(element => element.Source!.Model)
                .Distinct()
                .Count();
        }
    }

    ///
    ///Turns or mirrors the chosen shapes, as one step.
    ///
    ///About the middle of what will actually move, rounded to a whole unit. Rounded because a quarter turn
    ///about a whole-numbered point maps whole numbers onto whole numbers and one about a half unit rounds
    ///every corner in the shape; the shape lands at most half a unit from where the exact middle would put
    ///it, which on a chip is half a nanometer.
    ///
    ///
    ///Takes the chosen shapes into a cell of their own, and puts an instance of it where they were.
    ///
    ///**Their coordinates are kept exactly as they are, and the instance goes at the origin.** Re-basing the
    ///contents to the corner of what was chosen would read better in the new cell and would add an offset to
    ///every coordinate in it - a rounding on the way in and another on the way back out. Keeping them means
    ///the picture does not move by so much as a unit, and grouping then ungrouping is the file it was.
    ///
    ///Only what the cell being edited holds, and only geometry: a placement is not something this can take
    ///into a cell without deciding what happens to what *it* places, which is a question nobody asked.
    ///
    private async Task groupIntoCell()
    {
        if (Gds is null || context is null)
            return;

        if (structureNamed(context.Structure) is not GDS.StructureModel structure)
            return;

        var taking = new List<GDS.ElementModel>();

        foreach (var element in Editable)
        {
            if (element.Source is not ElementSource source || taking.Contains(source.Model))
                continue;

            //A reference placed inside a new cell would still be a reference, and the new cell would then
            //place whatever it places - which is a hierarchy nobody asked for.
            if (Hierarchy.PlacedBy(source.Model) is not null)
                continue;

            taking.Add(source.Model);
        }

        if (taking.Count == 0)
            return;

        string name = AddElement.AsAscii(cellName);

        if (name.Length == 0 || Hierarchy.Named(Gds, name) is not null)
            return;

        //Copied before anything is deleted, since deleting takes the records out of the library this reads.
        var contents = new List<GDS.Record>();

        foreach (var model in taking)
        {
            if (recordsOf(model) is List<GDS.Record> span)
                contents.AddRange(span);
        }

        if (contents.Count == 0)
            return;

        var edits = new List<LayoutEdit> { new AddStructure(Gds, name, contents) };

        foreach (var model in taking)
            edits.Add(new DeleteElement(Gds, structure, model));

        edits.Add(new AddElement(
            Gds,
            structure,
            Hierarchy.PlacementRecords(name, new Element.Point(0, 0), false, 0),
            "Place"));

        History.Do(new CompoundEdit("Make cell", edits));

        freshenCellName();

        await afterEdit();
    }

    ///<summary>An element's records, copied, so they can go into a cell that does not exist yet.</summary>
    private List<GDS.Record>? recordsOf(GDS.ElementModel model)
    {
        if (Gds is null)
            return null;

        int start = Gds.Records.IndexOf(model.Element.Opening);
        int end = Gds.Records.IndexOf(model.ENDEL);

        if (start < 0 || end < start)
            return null;

        var copied = new List<GDS.Record>();

        foreach (var record in Gds.Records.GetRange(start, end - start + 1))
            copied.Add(new GDS.Record((short)record.Type, record.Data?.Encode() ?? Array.Empty<byte>()));

        return copied;
    }

    ///
    ///Whether the shape choices are showing under the pencil.
    ///
    ///Open on choosing Draw and on pointing at the pencil, shut by a press anywhere else. Not saved: it is a
    ///panel being open, which is a thing about this minute rather than about the file.
    ///
    private bool shapeMenuOpen = true;

    ///
    ///Whether the grid's three switches are showing under their icon.
    ///
    ///Shut to begin with, unlike the shapes: that one opens because choosing Draw is a question about which
    ///shape, where nothing about opening a file is a question about the grid.
    ///
    ///Opened by a press and by a hover, and closed by neither: a press that toggled would never open it,
    ///because the pointer arrives before the button goes down and the hover has already opened it.
    ///
    private bool gridMenuOpen = false;

    private async Task showGridMenu()
    {
        if (gridMenuOpen)
            return;

        gridMenuOpen = true;

        await OnToolChanged.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnGridMenuDismissed()
    {
        if (!gridMenuOpen)
            return;

        gridMenuOpen = false;

        await OnToolChanged.InvokeAsync();
    }

    ///
    ///Pointing at the pencil brings it back, which is how it returns once it has been dismissed.
    ///
    ///**Through OnToolChanged, not StateHasChanged.** The menu lives in the Toolbar fragment, and that is
    ///rendered by the shell rather than by this component - so re-rendering this one leaves the bar exactly
    ///as it was. Every other control up there says the same thing by calling this, which is why they work.
    ///
    ///Missing it is a quiet kind of wrong: dismissing the menu appeared to work, because the press that
    ///dismissed it also drew a shape, and the edit that followed re-rendered the bar for its own reasons.
    ///
    private async Task showShapeMenu()
    {
        if (shapeMenuOpen)
