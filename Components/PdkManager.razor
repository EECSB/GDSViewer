    private async Task finishRenamingAsync()
    {
        if (!renaming)
            return;

        renaming = false;

        string typed = renameText.Trim();

        if (shown.BuiltIn || typed.Length == 0 || typed == shown.Name)
            return;

        string was = shown.Name;

