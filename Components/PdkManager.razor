    private async Task applyLayersAsync()
    {
        string? text = null;

        try
        {
            text = await js.InvokeAsync<string?>("getTextEditorValue", layersEditorId);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            layersSays = $"The layermap could not be read out of the editor: {ex.Message}";

            return;
        }

        //No editor to read: a panel that never got one says so above, and nothing was typed anywhere to apply.
        if (text is null)
        {
            layersSays = "There is no layermap text to apply yet.";

            return;
        }

        var parsed = LayerNames.Parse(text);

        //A built-in reads the layermap it ships with until it is changed, so that one is no change of its own.
        if (shown.BuiltIn && text == ShippedLayers.GetValueOrDefault(shown.Id, ""))
            shown.Layers = null;
        else
            shown.Layers = text;

        read();

        layersSays = layersApplied(parsed);

        await OnEdited.InvokeAsync(shown);
    }

    private static string layersApplied(LayerNames parsed)
    {
        string said = $"Applied: {counted(parsed.Count, "layer")}.";

        if (parsed.Problems.Count == 0)
            return said;

        return $"{said} {counted(parsed.Problems.Count, "line")} it could not use - {parsed.Problems[0]}";
    }

