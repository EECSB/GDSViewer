    #region The rules as a table and a form

    ///<summary>Whether the rules are shown as the deck's text rather than as a table - the table, to begin with.</summary>
    private bool rulesAsText;

    ///<summary>The line of the rule open in the form, 0 for a rule being added, or null while the form is shut.</summary>
    private int? ruleEditing;

    ///<summary>The line of the rule whose × was pressed once, which a second press takes out - 0 for none.</summary>
    private int ruleRemoving;

    ///<summary>What to bring into view once the table has drawn it - see OnAfterRenderAsync - or null for nothing.</summary>
    private string? scrollTo;

    private string formId = "";
    private DrcCheck formCheck = DrcCheck.Width;
    private string formFirst = "";
    private string formSecond = "";
    private string formValue = "";
    private string formDescription = "";
    private string formExcept = "";
    private string formWindow = "";
    private string formStep = "";
    private string formMetric = "";
    private string formProblem = "";

    ///<summary>The checks the form offers - every one the engine measures - in the order a rule manual tends to go.</summary>
    private static readonly DrcCheck[] Checks =
    {
        DrcCheck.Width,
        DrcCheck.Space,
        DrcCheck.Notch,
        DrcCheck.Enclosure,
        DrcCheck.Area,
        DrcCheck.HoleArea,
        DrcCheck.Density,
        DrcCheck.Antenna,
        DrcCheck.OffGrid
    };

    ///<summary>
    ///Words the reader takes for something else when they stand in a rule - a qualifier, or a metric - so a layer called
    ///one of them could not be named in a rule line at all.
    ///</summary>
    private static readonly HashSet<string> Reserved = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "except", "window", "step", "euclidean", "euclidian", "square", "projection", "parallel"
    };

    ///<summary>Whether each rule gets a switch: the deck checking the open file is this PDK's, so a switch does something.</summary>
    private bool rulesSwitch()
    {
        return RulesLive && shown.Id == Pdks.Selected;
    }

    private void showRulesAsText(bool asText)
    {
        rulesAsText = asText;

        closeRuleForm();
    }

    private void closeRuleForm()
    {
        ruleEditing = null;
        ruleRemoving = 0;
        formProblem = "";
    }

    private static string checkName(DrcCheck check)
    {
        if (check == DrcCheck.Space)
            return "spacing";

        if (check == DrcCheck.HoleArea)
            return "hole area";

        if (check == DrcCheck.OffGrid)
            return "off grid";

        return check.ToString().ToLowerInvariant();
    }

    private static string checkSaid(DrcRule rule)
    {
        if (rule.Metric is DrcMetric metric)
            return $"{checkName(rule.Check)}, {DrcDeck.MetricWord(metric)}";

        return checkName(rule.Check);
    }

    private static string operandSaid(string operand)
    {
        if (operand == DrcDeck.EveryLayer)
            return "every layer";

        return operand;
    }

    private static string layersSaid(DrcRule rule)
    {
        string said = operandSaid(rule.Operands[0]);

        if (rule.Operands.Count > 1)
        {
            if (rule.Check == DrcCheck.Enclosure)
                said += $" inside {rule.Operands[1]}";
            else if (rule.Check == DrcCheck.Antenna)
                said += $" to gate {rule.Operands[1]}";
            else
                said += $" to {rule.Operands[1]}";
        }

        if (rule.Except is string except)
            said += $", except inside {except}";

        return said;
    }

    ///<summary>What a limit is counted in: database units, square ones, tenths of a percent, or a ratio.</summary>
    private static string unitOf(DrcCheck check)
    {
        if (check == DrcCheck.Area || check == DrcCheck.HoleArea)
            return "dbu²";

        if (check == DrcCheck.Density)
            return "‰";

        if (check == DrcCheck.Antenna)
            return ": 1";

        return "dbu";
    }

    private static string limitSaid(DrcRule rule)
    {
        string said = $"{rule.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)} {unitOf(rule.Check)}";

        if (rule.Window > 0)
            said += $", window {rule.Window.ToString(System.Globalization.CultureInfo.InvariantCulture)} step {rule.Step.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

        return said;
    }

    ///<summary>Whether a check names a second layer: spacing may, an enclosure and an antenna must.</summary>
    private static bool takesSecond(DrcCheck check)
    {
        return check == DrcCheck.Space || check == DrcCheck.Enclosure || check == DrcCheck.Antenna;
    }

    private static bool needsSecond(DrcCheck check)
    {
        return check == DrcCheck.Enclosure || check == DrcCheck.Antenna;
    }

    private string firstLabel()
    {
        if (formCheck == DrcCheck.Antenna)
            return "Metal";

        return "Layer";
    }

    private string secondLabel()
    {
        if (formCheck == DrcCheck.Enclosure)
            return "Inside";

        if (formCheck == DrcCheck.Antenna)
            return "Gate";

        return "To";
    }

    private string valueLabel()
    {
        if (formCheck == DrcCheck.Density)
            return "Least (‰)";

        if (formCheck == DrcCheck.Antenna)
            return "Ratio (: 1)";

        if (formCheck == DrcCheck.OffGrid)
            return "Grid (dbu)";

        return $"Limit ({unitOf(formCheck)})";
    }

    private string valueTitle()
    {
        if (formCheck == DrcCheck.Area || formCheck == DrcCheck.HoleArea)
            return "The least area allowed, in square database units - square nanometers, for sky130, gf180mcu and ihp-sg13g2";

        if (formCheck == DrcCheck.Density)
            return "The least share of each window the layer must cover, in tenths of a percent: 300 is 30%";

        if (formCheck == DrcCheck.Antenna)
            return "The most metal allowed for each unit of gate it reaches: 400 is four hundred to one";

        if (formCheck == DrcCheck.OffGrid)
            return "The manufacturing grid every corner must sit on, in database units - 5 for sky130, gf180mcu and ihp-sg13g2";

        return "The limit, in database units - nanometers, for sky130, gf180mcu and ihp-sg13g2";
    }

    ///<summary>The deck's own names, in the order it gave them - its layers, then its derived layers.</summary>
    private List<string> deckNames()
    {
        return deck.Layers.Keys.Concat(deck.Derivations.Select(derivation => derivation.Name)).Distinct().ToList();
    }

    ///
    ///The PDK's layers the deck does not name yet, by their names in the layer table - offered under the deck's own, and
    ///declared as `layer name pair` when a rule naming one is saved, so nobody types a layer line to write a rule.
    ///
    ///A pair the deck has under another name is left out, being that layer already; so is a name a rule line could not
    ///hold - two words, a quote, a number, or a word the reader takes for a qualifier.
    ///
    private List<(string Name, LayerKey Pair)> undeclared()
    {
        var named = new HashSet<string>(deckNames(), StringComparer.Ordinal);
        var pairs = new HashSet<LayerKey>(deck.Layers.Values);
        var offered = new List<(string Name, LayerKey Pair)>();

        foreach (var pair in rows)
        {
            if (!layers.Names.TryGetValue(pair, out string? name) || !isRuleWord(name) || named.Contains(name) || pairs.Contains(pair))
                continue;

            named.Add(name);
            offered.Add((name, pair));
        }

        return offered;
    }

    private static bool isRuleWord(string word)
    {
        if (word.Length == 0 || word.StartsWith('#') || word == DrcDeck.EveryLayer || Reserved.Contains(word))
            return false;

        if (word.Any(character => char.IsWhiteSpace(character) || character == '"'))
            return false;

        return !long.TryParse(word, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out _);
    }

    private void startAddingRule()
    {
        ruleEditing = 0;
        ruleRemoving = 0;
        formProblem = "";
        scrollTo = "#pdkRuleForm";

        formId = "";
        formCheck = DrcCheck.Width;
        formFirst = "";
        formSecond = "";
        formValue = "";
        formDescription = "";
        formExcept = "";
        formWindow = "";
        formStep = "";
        formMetric = "";
    }

    private void startEditingRule(DrcRule rule)
    {
        ruleEditing = rule.Line;
        ruleRemoving = 0;
        formProblem = "";

        formId = rule.Id;
        formCheck = rule.Check;
        formFirst = rule.Operands[0];
        formSecond = "";

        if (rule.Operands.Count > 1)
            formSecond = rule.Operands[1];

        formValue = rule.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        formDescription = rule.Description;
        formExcept = rule.Except ?? "";
        formWindow = "";
        formStep = "";

        if (rule.Window > 0)
            formWindow = rule.Window.ToString(System.Globalization.CultureInfo.InvariantCulture);

        if (rule.Step > 0)
            formStep = rule.Step.ToString(System.Globalization.CultureInfo.InvariantCulture);

        formMetric = rule.Metric?.ToString() ?? "";
    }

    ///<summary>Another check chosen: what the old one took and this one does not is let go, so the line never carries it.</summary>
    private void checkChosen(ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out DrcCheck check))
            return;

        formCheck = check;

        if (!takesSecond(check))
            formSecond = "";

        if (check != DrcCheck.OffGrid && formFirst == DrcDeck.EveryLayer)
            formFirst = "";

        if (check != DrcCheck.Density)
        {
            formWindow = "";
            formStep = "";
        }

        if (!measuredBy())
            formMetric = "";
    }

    ///<summary>Whether the rule as the form has it can name a metric - see Drc.HasEdgeForm.</summary>
    private bool measuredBy()
    {
        int operands = 1;

        if (formSecond.Length > 0)
            operands = 2;

        return Drc.HasEdgeForm(formCheck, operands);
    }

    ///<summary>The rule the form describes, or null with <paramref name="problem"/> saying what is still wanted.</summary>
    private DrcRule? ruleFromForm(out string problem)
    {
        string id = formId.Trim();

        if (id.Length == 0)
        {
            problem = "Name the rule - met1.1, say.";

            return null;
        }

        if (!isRuleWord(id))
        {
            problem = "A rule's name is one word, with no quotes in it.";

            return null;
        }

        if (formFirst.Length == 0)
        {
            problem = $"Choose the layer the {checkName(formCheck)} is measured on.";

            return null;
        }

        var operands = new List<string> { formFirst };

        if (needsSecond(formCheck) && formSecond.Length == 0)
        {
            problem = $"Choose the layer it is {secondLabel().ToLowerInvariant()}.";

            return null;
        }

        if (takesSecond(formCheck) && formSecond.Length > 0)
            operands.Add(formSecond);

        if (!long.TryParse(formValue.Trim(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out long value) || value <= 0)
        {
            problem = "The limit is a whole number above zero.";

            return null;
        }

        int window = 0;
        int step = 0;

        if (formCheck == DrcCheck.Density)
        {
            if (!int.TryParse(formWindow.Trim(), out window) || window <= 0 || !int.TryParse(formStep.Trim(), out step) || step <= 0)
            {
                problem = "A density is measured over a window moved by a step - both whole numbers of database units, the step less than the window.";

                return null;
            }
        }

        DrcMetric? metric = null;

        if (formMetric.Length > 0 && Drc.HasEdgeForm(formCheck, operands.Count) && Enum.TryParse(formMetric, out DrcMetric chosen))
            metric = chosen;

        string? except = null;

        if (formExcept.Length > 0)
            except = formExcept;

        problem = "";

        return new DrcRule
        {
            Id = id,
            Check = formCheck,
            Operands = operands,
            Value = value,
            Description = formDescription.Trim(),
            Except = except,
            Window = window,
            Step = step,
            Metric = metric
        };
    }

    ///<summary>The line the form would write, for the reader to see what a rule is - or empty while it is not yet a rule.</summary>
    private string formLine()
    {
        var rule = ruleFromForm(out _);

        if (rule is null)
            return "";

        return DrcDeck.WriteRule(rule);
    }

    ///
    ///Writes the form's rule into the deck - in place of the rule it was opened on, or under the last rule - with a layer
    ///line for each of the PDK's layers it names that the deck did not, and makes that the PDK's rules.
    ///
    ///**Judged on its own first**, under the deck's layers and derived layers: whatever the reader says about that one
    ///line is about this rule, where the whole deck may already carry problems of its own that are nobody's fault here.
    ///Refused rather than half-applied, as the rules panel's own line box is.
    ///
    private async Task saveRuleAsync()
    {
        if (ruleEditing is not int editing)
            return;

        var rule = ruleFromForm(out string problem);

        if (rule is null)
        {
            formProblem = problem;

            return;
        }

        if (editing > 0 && !deck.Rules.Any(each => each.Line == editing))
        {
            formProblem = "That rule is no longer where the deck had it. Close this and try again.";

            return;
        }

        string line = DrcDeck.WriteRule(rule);
        string proposed;

        if (editing == 0)
            proposed = DrcDeck.WithRuleAdded(rulesText(shown), line);
        else
            proposed = DrcDeck.WithLine(rulesText(shown), editing, line);

        //After the rule went in, so the line it was found by still holds while it is replaced.
        var offered = undeclared();

        foreach (string name in rule.Operands.Append(rule.Except ?? "").Distinct())
        {
            foreach (var layer in offered)
            {
                if (layer.Name == name)
                    proposed = DrcDeck.WithLayerDeclared(proposed, layer.Name, layer.Pair);
            }
        }

        string declared = DrcDeck.WithoutRules(proposed);
        var before = DrcDeck.Parse(declared);
        var alone = DrcDeck.Parse(declared + "\n" + line);

        string? complaint = alone.Problems.FirstOrDefault(each => !before.Problems.Contains(each));

        if (complaint is null && alone.Rules.Count == 0)
            complaint = alone.Refused.FirstOrDefault() ?? "That reads as no rule.";

        if (complaint is not null)
        {
            formProblem = complaint;

            return;
        }

        closeRuleForm();

        await editorShows(proposed);

        await rulesBecomeAsync(proposed);

        if (editing == 0)
            rulesSays = $"Added {rule.Id}.";
        else
            rulesSays = $"Changed {rule.Id}.";

        //Where it landed, which for a rule added is under the last - out of sight of the form at the top.
        scrollTo = $"#pdkRuleList tr[data-rule=\"{rule.Id.Replace("\\", "\\\\")}\"]";
    }

    private async Task removeRuleAsync(DrcRule rule)
    {
        ruleRemoving = 0;

        if (rule.Line <= 0)
            return;

        string proposed = DrcDeck.WithLine(rulesText(shown), rule.Line, null);

        closeRuleForm();

        await editorShows(proposed);

        await rulesBecomeAsync(proposed);

        rulesSays = $"Removed {rule.Id}.";
    }

    ///
    ///The form, as a row of the table: in place of the rule it changes, or under the last rule for a rule being added -
    ///where the rule lands, the Add new rule row at the foot put away meanwhile. A row rather than a dialog, so the rules
    ///around it stay in view: a limit is often set against the rule beside it.
    ///
    ///Laid out since 2026-11-01 (asked for): everything the check measures on the first line, its exceptions and how
    ///it measures included, since they are part of the check; the description under it, a box no longer than a
    ///description is, that takes a second line only when the words run past the first; and a cross in the corner in
    ///place of a Cancel button beside Add.
    ///
    private RenderFragment RuleForm => @<tr class="pdkRuleFormRow">
        <td colspan="@ruleColumns()">
            <div id="pdkRuleForm" class="pdkRuleForm">
                <button id="pdkRuleClose" type="button" class="iconButton pdkRuleClose" aria-label="Close the form" title="Close the form, changing nothing"
                        @onclick="closeRuleForm"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>

                <div class="pdkRuleFields pdkRuleCheckFields">
                    <label class="pdkRuleField" title="What the rule is called where it is written down - met1.2, difftap.8. A label: it names what a check finds">
                        <span>Rule</span>
                        <input id="pdkRuleId" class="aiField" placeholder="met1.1" value="@formId" @oninput="e => formId = e.Value?.ToString() ?? string.Empty" />
                    </label>

                    <label class="pdkRuleField" title="What the rule measures">
                        <span>Check</span>
                        <select id="pdkRuleCheck" class="aiField" value="@formCheck.ToString()" @onchange="checkChosen">
                            @foreach (var check in Checks)
                            {
                                <option value="@check.ToString()">@checkName(check)</option>
                            }
                        </select>
                    </label>

                    <label class="pdkRuleField" title="The layer it is measured on - the deck's own, or one of this PDK's layers, which saving declares in the deck">
                        <span>@firstLabel()</span>
                        <select id="pdkRuleLayer" class="aiField" value="@formFirst" @onchange="e => formFirst = e.Value?.ToString() ?? string.Empty">
                            <option value="">choose…</option>

                            @if (formCheck == DrcCheck.OffGrid)
                            {
                                <option value="@DrcDeck.EveryLayer">every layer</option>
                            }

                            @LayerOptions
                        </select>
                    </label>

                    @if (takesSecond(formCheck))
                    {
                        <label class="pdkRuleField" title="@secondTitle()">
                            <span>@secondLabel()</span>
                            <select id="pdkRuleSecond" class="aiField" value="@formSecond" @onchange="secondChosen">
                                @if (needsSecond(formCheck))
                                {
                                    <option value="">choose…</option>
                                }
                                else
                                {
                                    <option value="">itself</option>
                                }

                                @LayerOptions
                            </select>
                        </label>
                    }

                    <label class="pdkRuleField" title="@valueTitle()">
                        <span>@valueLabel()</span>
                        <input id="pdkRuleValue" class="aiField pdkNumber" type="number" min="1" step="1" value="@formValue"
                               @oninput="e => formValue = e.Value?.ToString() ?? string.Empty" />
                    </label>

                    @if (formCheck == DrcCheck.Density)
                    {
                        <label class="pdkRuleField" title="The square the density is measured over, in database units">
                            <span>Window</span>
                            <input id="pdkRuleWindow" class="aiField pdkNumber" type="number" min="1" step="1" value="@formWindow"
                                   @oninput="e => formWindow = e.Value?.ToString() ?? string.Empty" />
                        </label>

                        <label class="pdkRuleField" title="How far the window moves between measurements - less than the window, so a sparse patch is not split between two">
                            <span>Step</span>
                            <input id="pdkRuleStep" class="aiField pdkNumber" type="number" min="1" step="1" value="@formStep"
                                   @oninput="e => formStep = e.Value?.ToString() ?? string.Empty" />
                        </label>
                    }

                    <label class="pdkRuleField" title="A layer inside which this rule does not apply - a marker region, say">
                        <span>Except inside</span>
                        <select id="pdkRuleExcept" class="aiField" value="@formExcept" @onchange="e => formExcept = e.Value?.ToString() ?? string.Empty">
                            <option value="">nowhere</option>
                            @LayerOptions
                        </select>
                    </label>

                    @if (measuredBy())
                    {
                        <label class="pdkRuleField" title="How the distance is measured. Sizing counts a corner as its two axes; euclidean is the true distance; parallel measures only edges running alongside each other">
                            <span>Measured</span>
                            <select id="pdkRuleMetric" class="aiField" value="@formMetric" @onchange="e => formMetric = e.Value?.ToString() ?? string.Empty">
                                <option value="">by sizing</option>
                                <option value="@DrcMetric.Euclidean.ToString()">euclidean</option>
                                <option value="@DrcMetric.Square.ToString()">square</option>
                                <option value="@DrcMetric.Projection.ToString()">parallel edges</option>
                            </select>
                        </label>
                    }
                </div>

                <div class="pdkRuleFoot">
                    @*One line, and a second only when the words need it - the deck writes a description on one line, so a line break typed is a space.*@
                    <label class="pdkRuleField pdkRuleFieldDescription" title="What a fault of this rule is called in the results">
                        <span>Description</span>
                        <textarea id="pdkRuleDescription" class="aiField pdkRuleDescription" rows="1" placeholder="Met1 width" value="@formDescription"
                                  @oninput="descriptionTyped"></textarea>
                    </label>

                    <code id="pdkRuleLine" class="pdkRuleLine" title="The rule as the deck writes it - what the Text view shows">@formLine()</code>

                    <button id="pdkRuleSave" class="buttonStyle2 smallButton rulesButton" @onclick="saveRuleAsync">@saveLabel()</button>
                </div>

                @if (formProblem.Length > 0)
                {
                    <div id="pdkRuleProblem" class="pdkRuleProblem" role="alert">@formProblem</div>
                }
            </div>
        </td>
    </tr>;

    ///<summary>The names a rule's layer can be, as options: the deck's own, then the PDK's layers the deck would declare.</summary>
    private RenderFragment LayerOptions => @<text>
        @{
            var own = deckNames();
            var offered = undeclared();
        }

        @if (own.Count > 0)
        {
            <optgroup label="In the rules">
                @foreach (string name in own)
                {
                    <option value="@name">@name</option>
                }
            </optgroup>
        }

        @if (offered.Count > 0)
        {
            <optgroup label="From the layers">
                @foreach (var layer in offered)
                {
                    <option value="@layer.Name">@layer.Name (@layer.Pair)</option>
                }
            </optgroup>
        }
    </text>;

    private void descriptionTyped(ChangeEventArgs e)
    {
        formDescription = (e.Value?.ToString() ?? "").Replace("\r\n", " ").Replace('\n', ' ');
    }

    private void secondChosen(ChangeEventArgs e)
    {
        formSecond = e.Value?.ToString() ?? "";

        if (!measuredBy())
            formMetric = "";
    }

    private string secondTitle()
    {
        if (formCheck == DrcCheck.Enclosure)
            return "The layer that has to surround the first by the limit";

        if (formCheck == DrcCheck.Antenna)
            return "The gate the metal's net reaches";

        return "The other layer, for spacing between two - or itself, for spacing within one";
    }

    private string saveLabel()
    {
        if (ruleEditing == 0)
            return "Add";

        return "Save";
    }

    private int ruleColumns()
    {
        if (rulesSwitch())
            return 7;

        return 6;
    }

    #endregion
}
