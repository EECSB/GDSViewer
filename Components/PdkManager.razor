    #region The layers

    private string nameOf(LayerKey pair)
    {
        if (layers.Names.TryGetValue(pair, out string? name))
            return name;

        return "";
    }

    private string roleOf(LayerKey pair)
    {
        if (layers.Roles.TryGetValue(pair, out var role))
            return role.ToString();

        return LayerRole.None.ToString();
    }

    private string heightOf(LayerKey pair)
    {
        if (layers.Stack.TryGetValue(pair, out var stack))
            return stack.Height.ToString(System.Globalization.CultureInfo.InvariantCulture);

        return "";
    }

    private string thicknessOf(LayerKey pair)
    {
        if (layers.Stack.TryGetValue(pair, out var stack))
            return stack.Thickness.ToString(System.Globalization.CultureInfo.InvariantCulture);

        return "";
    }

    ///
    ///A row's look as a swatch: its color with its pattern over it, drawn by the writer that fills the layer - or null for a
    ///row that says neither, which the palette colors and the table calls "auto".
    ///
    private string? swatchOf(LayerKey pair)
    {
        layers.Fills.TryGetValue(pair, out var fill);

        if (!layers.Colors.TryGetValue(pair, out string? color))
        {
            if (fill == LayerFill.None)
                return null;

            color = "#9e9e9e";
        }

        layers.PatternColors.TryGetValue(pair, out string? marks);

        int? pixels = null;

        if (layers.PatternSizes.TryGetValue(pair, out int size))
            pixels = size;

        return SvgWriter.SwatchFor(fill, color, $"pdkLook_{pair.Number}_{pair.DataType}", 24, marks, pixels);
    }

    private string lookTitle(LayerKey pair)
    {
        string look = "colored from the palette";

        if (layers.Colors.TryGetValue(pair, out string? color))
            look = color;

        if (layers.Fills.TryGetValue(pair, out var fill) && fill != LayerFill.None)
            look += $", {fill.ToString().ToLowerInvariant()}";

        if (layers.Textures.TryGetValue(pair, out string? texture))
            look += $", {texture} in 3D";

        return $"{pair}: {look}. Press to change its color, pattern and texture";
    }

    private async Task styleAsked(LayerKey pair, MouseEventArgs e)
    {
        await OnStyleLayer.InvokeAsync(new LayerStyleAsked(shown, pair, e.ClientX, e.ClientY));
    }

    ///<summary>Writes the table back into the shown PDK and says so.</summary>
    private async Task commitLayersAsync()
    {
        shown.Layers = layers.Write();

        read();

        await OnEdited.InvokeAsync(shown);
    }

    private async Task nameTypedAsync(LayerKey pair, ChangeEventArgs e)
    {
        string typed = (e.Value?.ToString() ?? "").Trim();

        if (typed.Length == 0)
            layers.Names.Remove(pair);
        else
            layers.Names[pair] = typed;

        await commitLayersAsync();
    }

    private async Task roleChosenAsync(LayerKey pair, ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out LayerRole role))
            return;

        if (role == LayerRole.None)
            layers.Roles.Remove(pair);
        else
            layers.Roles[pair] = role;

        await commitLayersAsync();
    }

    ///
    ///A height or a thickness typed. The two go together in a layermap, so the first given starts the other at what it
    ///would be without one - the height at nothing, the thickness at a layer's usual depth - and either left blank takes
    ///the row's stack away, back to where the 3D view stacks a layer nobody placed.
    ///
    private async Task stackTypedAsync(LayerKey pair, ChangeEventArgs e, bool height)
    {
        string typed = (e.Value?.ToString() ?? "").Trim();

        if (typed.Length == 0)
        {
            layers.Stack.Remove(pair);

            await commitLayersAsync();

            return;
        }

        if (!layers.Stack.TryGetValue(pair, out var stack))
            stack = (0, AdditionalGDSInformation.DefaultLayerDepth);

        if (!int.TryParse(typed, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int value))
            return;

        if (height)
            stack = (value, stack.Thickness);
        else
            stack = (stack.Height, Math.Max(0, value));

        layers.Stack[pair] = stack;

        await commitLayersAsync();
    }

    private async Task removeRowAsync(LayerKey pair)
    {
        layers.Remove(pair);

        if (shown.Start is not null)
            shown.Start.Remove(pair.ToString());

        await commitLayersAsync();
    }

    private async Task startToggledAsync(LayerKey pair, ChangeEventArgs e)
    {
        var chosen = new HashSet<LayerKey>(starts);

        if (e.Value is true)
            chosen.Add(pair);
        else
            chosen.Remove(pair);

        shown.Start = chosen.OrderBy(key => key).Select(key => key.ToString()).ToList();

        read();

        await OnEdited.InvokeAsync(shown);
    }

    ///<summary>The pair the add row describes, or null while it does not describe one.</summary>
    private LayerKey? pairToAdd()
    {
        if (!short.TryParse(addLayer, out short number) || number < 0)
            return null;

        if (!short.TryParse(addDataType, out short dataType) || dataType < 0)
            return null;

        return new LayerKey(number, dataType);
    }

    private bool canAdd()
    {
        return pairToAdd() is LayerKey pair && !rows.Contains(pair) && addName.Trim().Length > 0;
    }

    private string addTitle()
    {
        if (pairToAdd() is LayerKey pair && rows.Contains(pair))
            return $"{pair} is in the PDK already - change it in its row";

        return "Add a layer to this PDK: its layer number, its datatype and a name";
    }

    private async Task addRowAsync()
    {
        if (!canAdd() || pairToAdd() is not LayerKey pair)
            return;

        layers.Names[pair] = addName.Trim();

        //Started with, if this PDK says which layers a layout starts with: one added is one meant to be drawn on.
        if (shown.Start is not null && !shown.Start.Contains(pair.ToString()))
            shown.Start.Add(pair.ToString());

        addLayer = "";
        addDataType = "";
        addName = "";

        await commitLayersAsync();

        //Where it landed among the pairs, which is rarely next to the row it was added from.
        scrollTo = $"#pdkLayerTable tr[data-pair=\"{pair}\"]";
    }

    private async Task addKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await addRowAsync();
    }

    private async Task layersChosenAsync(InputFileChangeEventArgs e)
    {
        string text;

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaximumLayermap));

            text = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}: {ex.Message}");

            return;
        }
        finally
        {
            //Read or not, so choosing the same file again - edited since, say - is a change the input reports.
            await forgetChosen("pdkLayersImport");
        }

        var imported = LayerNames.Parse(text);

        if (imported.Count == 0)
        {
            await js.InvokeVoidAsync("alert", $"{e.File.Name} names no layers.\n\n{string.Join("\n", imported.Problems.Take(MostProblems))}");

            return;
        }

        layers.MergeFrom(imported);

        layersSays = layersSaid(imported);

        await commitLayersAsync();
    }

    ///
    ///How a layermap imported here read: how many layers it brought, and the first line it could not use, if any - said
    ///beside its Import, the way the rules say how a deck read. The layer panel's Import said it in a dialog until it
    ///came here (2026-10-19); a row that does not read names nothing, and nothing on the table would show it.
    ///
    private static string layersSaid(LayerNames imported)
    {
        string said = $"Imported: {counted(imported.Count, "layer")}.";

        if (imported.Problems.Count == 0)
            return said;

        return $"{said} {counted(imported.Problems.Count, "line")} it could not use - {imported.Problems[0]}";
    }

    private async Task exportLayersAsync()
    {
        await js.InvokeVoidAsync("BlazorDownloadFile", shown.Name + " layers.csv", "text/csv", layers.Write());
    }

    ///<summary>Whether the layers are shown as the layermap's text rather than as a table - the table, to begin with.</summary>
