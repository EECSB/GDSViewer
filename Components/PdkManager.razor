    #region A whole PDK, brought in and written out

    ///<summary>What Import offers to choose: a zip, or the files one would hold - a layermap, a deck and pictures.</summary>
    private const string PackageFiles = ".zip,.csv,.lyp,.drc,.txt,.md,.markdown,.html,.htm,.pdf,.png,.jpg,.jpeg,.webp,.gif,.bmp,application/zip,text/csv,image/*";

    ///<summary>The most files one import takes: a layermap, a deck and their pictures, a few dozen at the very most.</summary>
    private const int MostPackageFiles = 256;

    ///
    ///A PDK chosen or dropped - a zip, or its files together - added to the list under its own name and shown. See
    ///PdkPackage for how its files are told apart, and keepTextures for its pictures.
    ///
    private async Task packageChosenAsync(InputFileChangeEventArgs e)
    {
        if (e.FileCount > MostPackageFiles)
        {
            await forgetPackageInput();

            await js.InvokeVoidAsync("alert", $"That is {e.FileCount} files. A PDK is a layermap, a deck and their pictures - choose those, or a zip of them.");

            return;
        }

        var chosen = new List<(string Name, byte[] Bytes)>();

        foreach (var file in e.GetMultipleFiles(MostPackageFiles))
        {
            try
            {
                await using var stream = file.OpenReadStream(LayermapPackage.LargestUnpacked);
                using var memory = new MemoryStream();

                await stream.CopyToAsync(memory);

                chosen.Add((file.Name, memory.ToArray()));
            }
            catch (Exception ex)
            {
                await forgetPackageInput();

                await js.InvokeVoidAsync("alert", $"Could not read {file.Name}: {ex.Message}");

                return;
            }
        }

        //Read or not, so choosing or dropping the same files again is a change the input reports.
        await forgetPackageInput();

        var contents = PdkPackage.FromFiles(chosen);

        if (contents is null)
        {
            await js.InvokeVoidAsync("alert", "Choose a PDK: a zip holding its layermap - a CSV or a KLayout .lyp - and its rule deck (.drc), with the pictures its textures name beside them, or those files together.");

            return;
        }

        await addPackageAsync(contents, packageName(contents, chosen));
    }

    ///
    ///What an imported PDK is called: the folder its files were in, or else the zip's name - or the layermap's or the deck's
    ///without the " layers" or " rules" Export puts after the name. Made free of the names already taken when it is added.
    ///
    private static string packageName(PdkPackage.Contents contents, List<(string Name, byte[] Bytes)> chosen)
    {
        if (contents.Name is string folder && folder.Trim().Length > 0)
            return folder;

        var zip = chosen.FirstOrDefault(file => LayermapPackage.IsZip(file.Bytes));
        string name = "";

        if (zip.Name is not null)
            name = Path.GetFileNameWithoutExtension(zip.Name);
        else if (chosen.Count > 0)
            name = Path.GetFileNameWithoutExtension(chosen[0].Name);

        foreach (string suffix in new[] { " layers", " rules" })
        {
            if (name.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
                name = name.Substring(0, name.Length - suffix.Length);
        }

        if (name.Trim().Length == 0)
            return "Imported PDK";

        return name;
    }

    private async Task addPackageAsync(PdkPackage.Contents contents, string name)
    {
        string layermap = "";
        int layerCount = 0;
        var missing = new List<string>();

        if (contents.Layers is not null)
        {
            var parsed = LayerNames.Parse(contents.Layers);

            layerCount = parsed.Count;

            //Written out again, so a .lyp is kept as the CSV every other PDK is kept as.
            if (layerCount > 0)
                layermap = parsed.Write();

            missing = await keepTextures(parsed, contents.Files);
        }

        string rules = contents.Rules ?? "";
        var read = DrcDeck.Parse(rules);

        if (layerCount == 0 && read.Count == 0)
        {
            await js.InvokeVoidAsync("alert", $"{name} names no layers and holds no rules, so there is no PDK in it to add.");

            return;
        }

        var pdk = Pdks.Add(name, layermap, rules);

        pdk.Readme = contents.Readme;

        await OnListChanged.InvokeAsync();

        await showAsync(pdk);

        var said = new System.Text.StringBuilder($"Added {pdk.Name}: {counted(layerCount, "layer")} and {counted(read.Rules.Count, "rule")}.");

        if (read.Problems.Count + read.Refused.Count > 0)
            said.Append($" {counted(read.Problems.Count + read.Refused.Count, "line")} of its deck could not be used - see Rules.");

        if (missing.Count > 0)
            said.Append($" Not in it: {string.Join(", ", missing)}, so those layers have no texture in 3D.");

        importSays = said.ToString();
    }

    ///
    ///Keeps the pictures a layermap's texture column names, from the files that came with it, in this browser - the store
    ///the layer settings and the 3D view read them from - and hands back the names neither brought nor kept already.
    ///
    private async Task<List<string>> keepTextures(LayerNames names, IReadOnlyDictionary<string, byte[]> brought)
    {
        var missing = new List<string>();

        foreach (string name in names.Textures.Values.Distinct(StringComparer.Ordinal))
        {
            if (brought.TryGetValue(name, out byte[]? picture))
            {
                await textures.SetAsync(name, picture);

                continue;
            }

            if (await textures.GetAsync(name) is null)
                missing.Add(name);
        }

        return missing;
    }

