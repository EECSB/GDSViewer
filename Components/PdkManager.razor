    #region The README

    ///<summary>What a README can be, for its own input: Markdown, HTML, a PDF or text.</summary>
    private const string ReadmeFiles = ".md,.markdown,.html,.htm,.pdf,.txt,.png,.jpg,.jpeg,.gif,.webp,.svg,text/markdown,text/html,application/pdf,text/plain,image/*";

    ///<summary>The largest README taken, which is kept with the PDK in this browser: a manual's PDF, not a library's.</summary>
    private const long LargestReadme = 20 * 1024 * 1024;

    ///
    ///The built-ins' READMEs as they ship, by PDK id - sky130-README.md and the others, beside their layermaps
    ///and decks - each with the pictures it names fetched from beside it. One object each, so a render does not make it
    ///again. Read the first time the manager is shown.
    ///
    private readonly Dictionary<string, PdkReadme> shippedReadmes = new Dictionary<string, PdkReadme>();
    private bool shippedReadmesAsked;

    ///<summary>The README last drawn as a page, and the page - its pictures inline, so it is not made again each render.</summary>
    private PdkReadme? readmeHtmlFor;
    private string readmeHtmlText = "";
    private string readmeHtml = "";

    private string readmeAsHtml(PdkReadme readme)
    {
        if (readme != readmeHtmlFor || readme.Text != readmeHtmlText)
        {
            readmeHtmlFor = readme;
            readmeHtmlText = readme.Text ?? "";
            readmeHtml = MarkdownHtml.ToHtml(readmeHtmlText, readme.PictureUrl);
        }

        return readmeHtml;
    }

    ///<summary>A blob address the shown PDF README is drawn from, and the README it was made for - made after a render, let go of with the next.</summary>
    private string pdfUrl = "";
    private PdkReadme? pdfFor;

    ///<summary>What a PDK says about itself: its own README, or a built-in's shipped one, or null for none.</summary>
    private PdkReadme? readmeOf(Pdk pdk)
    {
        if (pdk.Readme is not null)
            return pdk.Readme;

        if (pdk.BuiltIn && shippedReadmes.TryGetValue(pdk.Id, out var shipped))
            return shipped;

        return null;
    }

    ///<summary>Every built-in's README, read once and all at once, since none waits on another.</summary>
    private async Task loadShippedReadmesAsync()
    {
        if (shippedReadmesAsked)
            return;

        shippedReadmesAsked = true;

        await Task.WhenAll(Pdk.BuiltIns.Select(loadShippedReadmeAsync));
    }

    private async Task loadShippedReadmeAsync(ShippedPdk shipped)
    {
        try
        {
            var readme = new PdkReadme { Name = "README.md", Text = await http.GetStringAsync(shipped.ReadmePath) };
            var pictures = new Dictionary<string, string>(StringComparer.Ordinal);
            string folder = shipped.ReadmePath.Substring(0, shipped.ReadmePath.LastIndexOf('/') + 1);

            //Its pictures, from beside it, as a README brought in a zip carries them - so Export writes them too.
            foreach (string path in MarkdownHtml.PicturesIn(readme.Text))
            {
                if (!PdkReadme.IsPicturePath(path))
                    continue;

                try
                {
                    pictures[path] = Convert.ToBase64String(await http.GetByteArrayAsync(folder + path));
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Could not read {path}, a picture the bundled README names: {ex.Message}");
                }
            }

            if (pictures.Count > 0)
                readme.Pictures = pictures;

            shippedReadmes[shipped.Id] = readme;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not read the bundled README from {shipped.ReadmePath}: {ex.Message}");
        }
    }

    ///<summary>The most files one README choice takes: the README and the pictures it shows.</summary>
    private const int MostReadmeFiles = 40;

    ///
    ///A README chosen for the PDK shown, in place of the one it has - with the pictures a Markdown one names chosen
    ///beside it, matched by their file names.
    ///
    private async Task readmeChosenAsync(InputFileChangeEventArgs e)
    {
        await forgetChosen("pdkReadmeImport");

        var chosen = e.GetMultipleFiles(MostReadmeFiles);
        var file = chosen.Where(each => PdkReadme.KindOf(each.Name) is not null).OrderByDescending(each => PdkReadme.IsNamedReadme(each.Name)).FirstOrDefault();

        if (file is null)
        {
            await js.InvokeVoidAsync("alert", "Choose a README: a Markdown, HTML, PDF or text file - and the pictures it shows, if it is Markdown that has any.");

            return;
        }

        if (file.Size > LargestReadme)
        {
            await js.InvokeVoidAsync("alert", $"{file.Name} is larger than the {LargestReadme / (1024 * 1024)} MB a README is kept at.");

            return;
        }

        var readme = PdkReadme.From(file.Name, await bytesOf(file, LargestReadme));

        if (readme is null)
            return;

        if (readme.Kind == PdkReadmeKind.Markdown)
        {
            var pictures = new Dictionary<string, string>(StringComparer.Ordinal);

            foreach (string path in MarkdownHtml.PicturesIn(readme.Text ?? ""))
            {
                string name = Path.GetFileName(path.Replace('\\', '/'));
                var picture = chosen.FirstOrDefault(each => each != file && each.Name == name);

                if (!PdkReadme.IsPicturePath(path) || picture is null || picture.Size > LargestReadme)
                    continue;

                pictures[path] = Convert.ToBase64String(await bytesOf(picture, LargestReadme));
            }

            if (pictures.Count > 0)
                readme.Pictures = pictures;
        }

        shown.Readme = readme;

        await OnEdited.InvokeAsync(shown);
    }

    private static async Task<byte[]> bytesOf(IBrowserFile file, long largest)
    {
        using var stream = file.OpenReadStream(largest);
        using var memory = new MemoryStream();

        await stream.CopyToAsync(memory);

        return memory.ToArray();
    }

    private async Task removeReadmeAsync()
    {
        shown.Readme = null;

        await OnEdited.InvokeAsync(shown);
    }

    private string removeReadmeTitle()
