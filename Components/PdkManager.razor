        {
            await js.InvokeVoidAsync("alert", $"Could not read {e.File.Name}: {ex.Message}");

            return;
        }
        finally
        {
            //The same, for a deck chosen again.
            await forgetChosen("pdkRulesImport");
        }

        var parsed = DrcDeck.Parse(text);

        if (parsed.Rules.Count == 0 && parsed.Refused.Count == 0)
        {
