    private static string rulesSaid(DrcDeck parsed)
    {
        int troubles = parsed.Problems.Count + parsed.Refused.Count;
        string rules = counted(parsed.Rules.Count, "rule");

        if (troubles == 0)
            return $"Applied: {rules}.";

        return $"Applied: {rules}, and {counted(troubles, "line")} it could not use - listed below.";
    }

    private static string counted(int count, string thing)
    {
        if (count == 1)
            return $"1 {thing}";

        return $"{count} {thing}s";
    }

