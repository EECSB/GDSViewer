    ///<summary>Makes a text the shown PDK's rules, saying how it read.</summary>
    private async Task rulesBecomeAsync(string text)
    {
        var parsed = DrcDeck.Parse(text);

        if (shown.BuiltIn && text == ShippedRules.GetValueOrDefault(shown.Id, ""))
            shown.Rules = null;
        else
