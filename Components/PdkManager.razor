@using GdsII
@using GDSViewer.Models
@using GDSViewer.Ai
@implements IAsyncDisposable
@inject IJSRuntime js
@inject TextureStore textures
@inject HttpClient http

@*
    The PDK manager: the PDKs kept - each a name, its layers and its rules - and which one is in use. Asked for
    2026-10-18.

    A window like the AI ones, but opened in the middle of the page and larger, since it is the thing being worked in
    while it is up (asked for the same day). The layers are a table, each row styled through the layer panel's own
    settings popup; the rules are a table and a form, or the deck's own text in the code editor. The layer and rule
    panels edit the PDK in use as well - see Viewer.razor's rememberLayer and rememberRules - so the two are one PDK.

    **What this changes, it changes on the list it is handed, and says so**: the shell keeps the list, and lays the PDK
    in use over the open file again. See Viewer.razor's pdkEdited and pdksChanged.
*@
<FloatingWindow Id="pdkManagerWindow" Visible="Visible" OnClose="OnClose" Title="PDK manager" StorageKey="pdk-manager"
                Width="min(1160px, 94vw)" Height="min(840px, 90vh)" Below="">
    <div class="pdkManager">
        @*
            The list, and a drop target for a whole PDK - a zip of its layermap, its deck and its pictures, or those files
            dropped together. See fileDrop.js, which hands a drop on anything marked data-drop-into to that input.
        *@
        <div class="pdkSide" data-drop-into="pdkPackageImport">
            @*
                The PDKs, and under the one shown its two lists, its layers and its rules - a tree, asked for 2026-10-19 in
                place of the tabs and their own Import and Export over the table. What is picked in it is what the squares
                under it act on: a PDK as a whole, or one of its lists.
            *@
            <div id="pdkList" class="pdkList" role="tree" aria-label="PDKs">
                @foreach (var pdk in Pdks.Pdks)
                {
                    var each = pdk;
                    bool open = each == shown;

                    <div class="pdkRow @(open && !branchPicked ? "pdkRowShown" : "") @(open ? "pdkRowOpen" : "")" role="treeitem"
                         aria-selected="@(open && !branchPicked ? "true" : "false")" aria-expanded="@(open ? "true" : "false")"
                         data-pdk="@each.Id" @onclick="() => pickPdkAsync(each)">
                        <svg class="pdkRowChevron" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="@(open ? "M4 6l4 4 4-4" : "M6 4l4 4-4 4")" fill="none" stroke="currentColor" stroke-width="1.6"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>

                        @*
                            Renamed where it is named, by a double-click - the box over the list that did it went 2026-10-19,
                            asked what it was for: on the built-in, which keeps its name, it did nothing at all.
                        *@
                        @if (open && renaming)
                        {
                            <input id="pdkName" class="aiField pdkRowRename" aria-label="Name" @ref="renameBox"
                                   @bind="renameText" @bind:event="oninput" @onkeydown="renameKeyAsync" @onkeydown:stopPropagation="true"
                                   @onblur="finishRenamingAsync" @onclick:stopPropagation="true" />
                        }
                        else
                        {
                            <span class="pdkRowName" title="@rowNameTitle(each)" @ondblclick="() => startRenaming(each)">@each.Name</span>
                        }

                        @*
                            The PDK in use, or the way to put the one shown in use - where the "Use this PDK" over the list
                            went. While picking for a new layout's layers the one in use offers it as well, since using it
                            is what lays them on - see Picking.
                        *@
                        @if (open && (Picking || each.Id != Pdks.Selected))
                        {
                            @*Pressed without taking the name's box out first - see useAsync, which keeps what was typed.*@
                            <button id="pdkUse" type="button" class="pdkInUse pdkUseButton" @onclick="useAsync" @onclick:stopPropagation="true"
                                    @onmousedown:preventDefault="true" title="@useTitle()">use</button>
                        }
                        else if (each.Id == Pdks.Selected)
                        {
                            <span class="pdkInUse" title="The PDK in use">in use</span>
                        }
                    </div>

                    @if (open)
                    {
                        <div id="pdkLayersTab" class="pdkBranch @(branchPicked && tab == Tab.Layers ? "pdkBranchOn" : "")" role="treeitem"
                             aria-selected="@(branchPicked && tab == Tab.Layers ? "true" : "false")" data-branch="layers"
                             @onclick="() => pickBranch(Tab.Layers)">Layers (@rows.Count)</div>

                        <div id="pdkRulesTab" class="pdkBranch @(branchPicked && tab == Tab.Rules ? "pdkBranchOn" : "")" role="treeitem"
                             aria-selected="@(branchPicked && tab == Tab.Rules ? "true" : "false")" data-branch="rules"
                             @onclick="() => pickBranch(Tab.Rules)">Rules (@deck.Rules.Count)</div>
                    }
                }

                <div class="pdkDropHint">Drop a PDK's zip here to add it</div>
            </div>

            @*
                What is picked - made, copied, brought in, written out, deleted - as pictures, the way the selection panel's
                own row is: a plus, the copy mark, the two arrows and the bin. New and Duplicate are about PDKs; Import,
                Export and the bin act on a PDK as a whole, as one zip, or on the list picked under it - a layermap or a
                deck. The words are in the tooltips and the labels.
            *@
            <div class="pdkSideButtons">
                <button id="pdkNew" class="buttonStyle2 smallButton actionIcon" @onclick="addNewAsync" aria-label="New PDK"
                        title="New: a PDK of your own, with no layers or rules yet - import them, or add them one at a time">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 2.6v10.8M2.6 8h10.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </button>

                <button id="pdkDuplicate" class="buttonStyle2 smallButton actionIcon aiQuiet" @onclick="duplicateAsync" aria-label="Duplicate"
                        title="Duplicate: a copy of the PDK shown, its layers and rules with it, to change without touching this one">
                    <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Copy))</svg>
                </button>

                <InputFile id="pdkPackageImport" style="display: none;" multiple accept="@PackageFiles" OnChange="packageChosenAsync" />
                <InputFile id="pdkLayersImport" style="display: none;" accept=".csv,.txt,.lyp,text/csv" OnChange="layersChosenAsync" />
                <InputFile id="pdkRulesImport" style="display: none;" accept=".drc,.txt,text/plain" OnChange="rulesChosenAsync" />
                <label for="@importInput()" id="pdkImport" class="buttonStyle2 smallButton actionIcon aiQuiet" role="button"
                       aria-label="@importLabel()" title="@importTitle()">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 10.6V2.4M4.8 5.4 8 2.2l3.2 3.2M2.4 10.4v2.4a1 1 0 0 0 1 1h9.2a1 1 0 0 0 1-1v-2.4" fill="none" stroke="currentColor"
                              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </label>

                <button id="pdkExport" class="buttonStyle2 smallButton actionIcon aiQuiet" @onclick="exportPickedAsync" aria-label="@exportLabel()"
                        title="@exportTitle()">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 2.2v8.2M4.8 7.4 8 10.6l3.2-3.2M2.4 10.4v2.4a1 1 0 0 0 1 1h9.2a1 1 0 0 0 1-1v-2.4" fill="none" stroke="currentColor"
                              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>

                @*
                    The built-in picked has Reset in the bin's place, since it cannot be deleted - back to the layers and rules
                    the app ships, offered once either has been changed. Its lists picked, the bin empties them as for any PDK.
                *@
                @if (!branchPicked && shown.BuiltIn)
                {
                    <button id="pdkReset" class="buttonStyle2 smallButton actionIcon aiQuiet" disabled="@(!shown.Changed)" @onclick="resetAsync"
                            aria-label="Reset" title="@resetTitle()">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.6 8.4a5.4 5.4 0 1 0 1.6-3.8L2.6 6.2M2.6 2.8v3.4H6" fill="none" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                }
                else
                {
                    <button id="pdkDelete" class="buttonStyle2 smallButton actionIcon selectionDelete" disabled="@(!canDelete())" @onclick="() => deleting = true"
                            aria-label="Delete" title="@deleteTitle()">
                        <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Delete))</svg>
                    </button>
                }

                @*
                    Help on PDKs, their layers and their rules, with the guides to writing their files - in the place of the
                    list, see pdkAbout. A square at the end of the row since 2026-10-19, set apart from the ones that change
                    something; it was an (i) over the list.
                *@
                <button id="pdkHelp" class="buttonStyle2 smallButton actionIcon aiQuiet pdkHelp @(aboutOpen ? "pdkHelpOn" : "")"
                        @onclick="() => aboutOpen = !aboutOpen" aria-pressed="@(aboutOpen ? "true" : "false")"
                        aria-label="About PDKs" title="What a PDK is, its layers and its rules, and how to write a layermap or a deck">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M5.6 6a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1.1.9-1.1 1.6v.6" fill="none" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="8" cy="12.9" r="1" fill="currentColor" />
                    </svg>
                </button>
            </div>

            @if (deleting && canDelete())
            {
                <div class="pdkDeleteAsk">
                    <span>@deleteAsked()</span>

                    <span class="pdkDeleteAnswers">
                        <button id="pdkDeleteSure" class="buttonStyle2 smallButton rulesButton aiDanger" @onclick="deletePickedAsync">Delete</button>
                        <button id="pdkDeleteKeep" class="buttonStyle2 smallButton rulesButton aiQuiet" @onclick="() => deleting = false">Keep</button>
                    </span>
                </div>
            }

            @if (importSays.Length > 0)
            {
                <div id="pdkImportSays" class="pdkImportSays" role="status">@importSays</div>
            }
        </div>

        @*
            The picked list and nothing over it: the PDK's name, its being in use, Use and Reset, which had a row here, are
            the tree's and the squares' since 2026-10-19.
        *@
        <div class="pdkDetail">
            @*
                What layers and design rules are, and how to write a layermap or a deck - since 2026-10-19 here, beside the
                tabs they are about, where the layer panel's info icon said it before. A layermap and a rule deck are both
                files somebody has to supply, nothing on screen says why, and this is where they are supplied.

                **In the place of the picked list while it is open**, rather than a box over the middle of the page: it is a
                few sections, read beside the tree they explain. The help square under the tree puts it away again, and so
                does its cross.
            *@
            @if (aboutOpen)
            {
                <div id="pdkAbout" class="pdkAbout">
                    <div class="pdkAboutHead">
                        <b>About PDKs</b>

                        <button id="pdkAboutClose" class="buttonStyle2 closeButton" @onclick="() => aboutOpen = false"
                                aria-label="Close" title="Close">&times;</button>
                    </div>

                    @*
                        **All three, one after another, whatever is picked** (2026-11-01, asked for): it was the PDK's, the
                        layers' or the rules' alone, by what the tree had picked, so finding the other two meant picking
                        something else.
                    *@
                    <section id="pdkAboutPdk" class="pdkAboutSection">
                        <h3 class="pdkAboutTitle">A PDK</h3>

                        <p>
                            A <b>process design kit</b> is what a foundry gives a designer for one of its processes: which
                            layers there are and what each one is, the rules a layout has to keep to be made, the devices and
                            their models, and the documents that explain them.
                        </p>

                        <p>
                            <b>A PDK here is the part of that a layout viewer needs</b>: its <b>layers</b>, a layermap naming,
                            coloring and stacking them, and its <b>rules</b>, a deck a layout is checked against - each under it
                            in the tree on the left - and a <b>README</b> saying what the PDK is, shown here when it is picked.
                        </p>

                        <p>
                            <b>It travels as one zip</b>, which Import brings in and Export writes out: a folder named for the
                            PDK, holding
                        </p>

                        <ul>
                            <li><code>name layers.csv</code> - the layermap (or a KLayout <code>.lyp</code>);</li>
                            <li><code>name rules.drc</code> - the rule deck;</li>
                            <li>the pictures its layermap's texture column names, for the 3D view;</li>
                            <li>
                                <code>README.md</code> - what the process is, its layers and devices, and where its own
                                documents are. Markdown is drawn here as a page; a README.html, README.pdf or README.txt
                                is shown as it is.
                            </li>
                        </ul>

                        <p>
                            Only the layermap or the deck has to be there. The guide to writing each is in its section below.
                        </p>
                    </section>

                    <section id="pdkAboutLayers" class="pdkAboutSection">
                        <h3 class="pdkAboutTitle">Layers</h3>

                        <p>
                            A GDSII file carries only numbers. <b>Nothing in the format records that 65/20 is diffusion</b>,
                            what color it should be drawn in, what it is for, or where it sits in the wafer.
                        </p>

                        <p>
                            So all of that comes from a <b>layermap</b> — a CSV of layer, datatype, name, color, height,
                            thickness and role — and a PDK holds one. The PDK in use names every file drawn in it; a file
                            from another process keeps bare numbers in palette colors, which is readable but says nothing
                            about it.
                        </p>

                        <p>
                            The <b>role</b> column is the one worth filling in: net tracing follows conductors through vias,
                            so a via with no role stops a net dead, and antenna rules are refused outright rather than
                            guessed at without it.
                        </p>

                        <p>
                            <b>A PDK's layers are kept here</b>, under it in the tree on the left: a PDK brought in whole as a zip, or made
                            new with its layermap imported or its layers added a row at a time, and put in use. To build a
                            layermap for a whole PDK, take the guide below and hand it to an AI with your PDK's layer table.
                        </p>

                        <button id="downloadLayermapGuide" class="buttonStyle2 smallButton rulesButton"
                                @onclick='() => downloadGuideAsync("WRITING-A-LAYERMAP.md")'>
                            Download the layermap-writing guide (.md)
                        </button>
                    </section>

                    <section id="pdkAboutRules" class="pdkAboutSection">
                        <h3 class="pdkAboutTitle">Design rules</h3>

                        <p>
                            A <b>design rule</b> is the foundry's answer to "how thin may this wire be, and how close may two
                            of them get". A deck of them, checked against your layout, is what catches a shape that could
                            not be manufactured.
                        </p>

                        <p>
                            <b>There is no standard file to download.</b> Design rules have no interchange format: a foundry
                            supporting three tools ships three separately maintained decks that are meant to agree, and
                            nothing converts between them. KLayout's is a Ruby program, Magic's is fused into its technology
                            file, and Calibre's SVRF is proprietary and usually under NDA. So a deck here is a small text
                            file you supply — the same arrangement as the layermap, and for the same licensing reason: one
                            PDK's tables are somebody else's work and do not belong compiled into a viewer that opens any
                            file.
                        </p>

                        <p>
                            The format is deliberately a fixed vocabulary rather than an expression language. <b>A rule this
                            build cannot measure is refused by name</b> — listed, and every result from that deck says "not
                            fully checked" — because a count of faults is only an answer when every rule actually ran.
                        </p>

                        <p class="infoPopupWarn">
                            This is not a signoff tool. It catches the obvious against the rules you give it; it is not a
                            tapeout.
                        </p>

                        <p>
                            <b>A PDK's rules are kept here</b>, under it in the tree on the left — sky130's working 30-rule deck to begin
                            with — read, made in a form, written as text, imported and exported; the PDK in use checks every
                            file drawn in it. To write a deck for your own PDK, take the guide below: it is the whole
                            grammar, written so you can hand it to an AI along with your PDK's rule document and get one
                            back.
                        </p>

                        <p>
                            <b>Ran KLayout's own DRC?</b> Open its report (.lyrdb), or drop it on the drawing, and what it
                            found is laid over the layout in blue, a category to a row. Clicking a row steps through its
                            markers.
                        </p>

                        <p>
                            <b>Nothing failing?</b> That is the expected answer — the bundled cells are signed-off sky130
                            layout, so a correct deck finds nothing in them. To see what a violation actually looks like,
                            check with a deck whose limits the layout cannot meet:
                        </p>

                        <div class="infoPopupActions">
                            <button id="downloadDeckGuide" class="buttonStyle2 smallButton rulesButton"
                                    @onclick='() => downloadGuideAsync("WRITING-A-DECK.md")'>
                                Download the deck-writing guide (.md)
                            </button>

                            <button id="loadStrictDeck" class="buttonStyle2 smallButton rulesButton infoPopupDemo"
                                    @onclick="() => OnDemoDeck.InvokeAsync()">
                                Load a deck that fails (demo)
                            </button>
                        </div>
                    </section>
                </div>
            }

            @*
                The PDK itself picked: what it says about itself - its README, rendered, or a note of what one would hold -
                rather than one of its lists, which show when they are picked under it (asked for 2026-11-01). The README
                comes in its zip and goes out with it; see PdkReadme.
            *@
            @if (!aboutOpen && !branchPicked)
            {
                <div id="pdkInfo" class="pdkInfo">
                    <InputFile id="pdkReadmeImport" style="display: none;" accept="@ReadmeFiles" multiple OnChange="readmeChosenAsync" />

                    @if (readmeOf(shown) is PdkReadme readme)
                    {
                        @if (readme.Kind == PdkReadmeKind.Markdown)
                        {
                            <div id="pdkReadme" class="pdkReadme">@((MarkupString)readmeAsHtml(readme))</div>
                        }
                        else if (readme.Kind == PdkReadmeKind.Html)
                        {
                            @*Sandboxed with nothing allowed: a page from somebody's zip shows, and runs nothing.*@
                            <iframe id="pdkReadme" class="pdkReadmeFrame" sandbox="" srcdoc="@readme.Text" title="@readme.Name"></iframe>
                        }
                        else if (readme.Kind == PdkReadmeKind.Pdf)
                        {
                            @if (pdfUrl.Length > 0)
                            {
                                <iframe id="pdkReadme" class="pdkReadmeFrame" src="@pdfUrl" title="@readme.Name"></iframe>
                            }
                        }
                        else
                        {
                            <pre id="pdkReadme" class="pdkReadmeText">@readme.Text</pre>
                        }

                        @*Under the README rather than over it, so the README's top lines up with the tree's (asked for 2026-11-01).*@
                        <div class="pdkInfoBar">
                            <span id="pdkReadmeName" class="pdkInfoFile" title="The file this PDK's information came in">@readme.Name</span>

                            <label for="pdkReadmeImport" id="pdkReadmeReplace" class="buttonStyle2 smallButton rulesButton aiQuiet pdkAiButton" role="button"
                                   title="Put another file in this one's place: Markdown, HTML, a PDF or text">
                                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                                    <path d="M13 6.5A5.2 5.2 0 0 0 3.4 4.6M3 9.5a5.2 5.2 0 0 0 9.6 1.9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <path d="M13.4 2.4v4.3H9.1M2.6 13.6V9.3h4.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Replace
                            </label>

                            @if (shown.Readme is not null)
                            {
                                <button id="pdkReadmeRemove" class="buttonStyle2 smallButton rulesButton aiQuiet" @onclick="removeReadmeAsync"
                                        title="@removeReadmeTitle()">Remove</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div id="pdkNoReadme" class="pdkInfoEmpty">
                            <b>No README for this PDK.</b>

                            <p>
                                A PDK's zip can say what the PDK is: put a <code>README.md</code> beside its layers CSV and its
                                rules <code>.drc</code> - or a README.html, README.pdf or README.txt - with the process, its layers
                                and devices, and where its own documents are. It shows here when the PDK is picked, and goes out
                                with it on Export.
                            </p>

                            <label for="pdkReadmeImport" id="pdkReadmeAdd" class="buttonStyle2 smallButton rulesButton" role="button"
                                   title="Give this PDK a README: Markdown, HTML, a PDF or text">Add a README</label>
                        </div>
                    }
                </div>
            }

            @*Both always drawn and one hidden, so the code editor in the rules is made once and keeps its place.*@
            <div class="pdkLayers" style="@(tab == Tab.Layers && branchPicked && !aboutOpen ? "" : "display: none;")">
                @*
                    The layers' bar, the rules' own (asked for 2026-11-01): the table or the layermap's text, Write with AI,
                    and how the last layermap imported or applied read.
                *@
                <div class="pdkRulesBar">
                    <div class="pdkViewSwitch" role="group" aria-label="How the layers are shown">
                        <button id="pdkLayersAsTable" class="pdkViewChoice @(layersAsText ? "" : "pdkViewChoiceOn")" aria-pressed="@(layersAsText ? "false" : "true")"
                                title="The layers as a table, each changed in its row" @onclick="() => showLayersAsText(false)">Table</button>
                        <button id="pdkLayersAsText" class="pdkViewChoice @(layersAsText ? "pdkViewChoiceOn" : "")" aria-pressed="@(layersAsText ? "true" : "false")"
                                title="The layermap's own text: a CSV row per layer" @onclick="() => showLayersAsText(true)">Text</button>
                    </div>

                    @*Layers written in the AI assistant, on this PDK - see LayerTools, and Viewer.razor's writeLayersWithAi.*@
                    <button id="pdkLayersAi" class="buttonStyle2 smallButton rulesButton pdkAiButton" @onclick="() => OnWriteLayers.InvokeAsync(shown)"
                            title="Open the AI assistant to write layers into this PDK: describe them, or attach the PDK's layer table, and it adds them to the layermap">
                        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                            <path fill="currentColor" d="M6.4 1.6c.3 2.6 1.6 4 4.2 4.3-2.6.3-3.9 1.7-4.2 4.3-.3-2.6-1.6-4-4.2-4.3 2.6-.3 3.9-1.7 4.2-4.3z" />
                            <path fill="currentColor" d="M11.6 8.6c.2 1.6 1 2.4 2.6 2.6-1.6.2-2.4 1-2.6 2.6-.2-1.6-1-2.4-2.6-2.6 1.6-.2 2.4-1 2.6-2.6z" />
                        </svg>
                        Write with AI
                    </button>

                    <span id="pdkLayersSays" class="pdkRulesSays" role="status">@layersSays</span>
                </div>

                <div class="pdkLayerText" style="@(layersAsText ? "" : "display: none;")">
                    <div id="pdkLayersEditor" class="pdkRulesEditor" @ref="layersEditorHost"></div>

                    <div class="pdkRulesFoot">
                        <button id="pdkLayersApply" class="buttonStyle2 smallButton rulesButton" @onclick="applyLayersAsync"
                                title="Make this text the PDK's layermap - every file drawn in it is named and drawn by it">Apply</button>
                        <button id="pdkLayersRevert" class="buttonStyle2 smallButton rulesButton aiQuiet" @onclick="revertLayersAsync"
                                title="Back to the layermap as it was last applied">Revert</button>
                    </div>
                </div>

                <div class="pdkLayerScroll" style="@(layersAsText ? "display: none;" : "")">
                    <table id="pdkLayerTable" class="pdkLayerTable">
                        <thead>
                            <tr>
                                <th title="In a new layout's layer list from the start - see Set PDK, under an empty list">Start</th>
                                <th title="How the layer is drawn - its color, its pattern and its texture in 3D. Press one to change it">Style</th>
                                <th>Layer</th>
                                <th>Name</th>
                                <th title="What tracing a net needs: a conductor carries one, a via joins the conductors it overlaps">Role</th>
                                <th title="How high the layer sits, in database units - nanometers, for sky130, gf180mcu and ihp-sg13g2">Height</th>
                                <th title="How thick the layer is, in the same units">Thickness</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in rows)
                            {
                                var pair = key;

                                <tr data-pair="@pair">
                                    <td>
                                        <input type="checkbox" class="pdkStart" checked="@starts.Contains(pair)" aria-label="@($"Start a layout with {pair}")"
                                               @onchange="e => startToggledAsync(pair, e)" />
                                    </td>
                                    @*
                                        The layer panel's own settings popup, opened on this row - its color, its pattern, its
                                        texture and the rest, as the gear on a layer in the sidebar opens them. It was a bare
                                        color picker, which left out everything else about how a layer is drawn. The popup is
                                        the shell's; see Viewer.razor's openPdkLayerSettings.
                                    *@
                                    <td class="pdkColorCell">
                                        <button class="pdkLook" aria-label="@($"How {pair} is drawn")" title="@lookTitle(pair)"
                                                @onclick="e => styleAsked(pair, e)">
                                            @if (swatchOf(pair) is string swatch)
                                            {
                                                <svg class="pdkLookSwatch" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid slice" aria-hidden="true">@((MarkupString)swatch)</svg>
                                            }
                                            else
                                            {
                                                <span class="pdkColorNone">auto</span>
                                            }
                                        </button>
                                    </td>
                                    <td class="pdkPair">@pair</td>
                                    <td>
                                        <input class="aiField pdkCellName" value="@nameOf(pair)" aria-label="@($"Name of {pair}")"
                                               @onchange="e => nameTypedAsync(pair, e)" />
                                    </td>
                                    <td>
                                        <select class="aiField pdkRole" value="@roleOf(pair)" aria-label="@($"Role of {pair}")" @onchange="e => roleChosenAsync(pair, e)">
                                            <option value="None">none</option>
                                            <option value="Conductor">conductor</option>
                                            <option value="Via">via</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input class="aiField pdkNumber" type="number" value="@heightOf(pair)" aria-label="@($"Height of {pair}")"
                                               @onchange="e => stackTypedAsync(pair, e, height: true)" />
                                    </td>
                                    <td>
                                        <input class="aiField pdkNumber" type="number" min="0" value="@thicknessOf(pair)" aria-label="@($"Thickness of {pair}")"
                                               @onchange="e => stackTypedAsync(pair, e, height: false)" />
                                    </td>
                                    <td>
                                        <button class="iconButton pdkRemove" aria-label="@($"Remove {pair}")" title="Take this layer out of the PDK"
                                                @onclick="() => removeRowAsync(pair)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>
                                    </td>
                                </tr>
                            }

                            @if (rows.Count == 0)
                            {
                                <tr>
                                    <td id="pdkNoLayers" class="pdkEmpty" colspan="8">No layers yet. Add one below, import a layermap, or write one as text.</td>
                                </tr>
                            }
                        </tbody>

                        @*
                            A layer added from the table's own last row, held to the bottom of the list as it scrolls, so it is
                            always in reach (asked for 2026-10-19; it was a row of its own under the table). Folded to Add new
                            layer, a gray row with a plus as the rules' is, until it is pressed (2026-11-01, asked for): then its
                            pair under the pairs and its name under the names. Enter in any of its fields adds it, and it stays
                            open for the next until its X.
                        *@
                        <tfoot>
                            @if (!layerAdding)
                            {
                                <tr class="pdkRuleAddRow">
                                    <td colspan="8">
                                        <button id="pdkLayerAdd" type="button" class="pdkRuleAddButton" @onclick="startAddingLayer"
                                                title="A layer added by its number, its datatype and a name">
                                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                                <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                            </svg>
                                            Add new layer
                                        </button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="pdkAddRow">
                                    <td colspan="2" class="pdkAddLabel">New layer</td>
                                    <td class="pdkAddPair">
                                        <input id="pdkAddLayer" class="aiField pdkNumber pdkAddNumber" type="number" min="0" max="32767" placeholder="layer"
                                               aria-label="Layer number of the layer to add" @bind="addLayer" @bind:event="oninput" @onkeydown="addKeyAsync"
                                               @ref="addLayerBox" />
                                        <span class="pdkAddSlash">/</span>
                                        <input id="pdkAddDataType" class="aiField pdkNumber pdkAddNumber" type="number" min="0" max="32767" placeholder="type"
                                               aria-label="Datatype of the layer to add" @bind="addDataType" @bind:event="oninput" @onkeydown="addKeyAsync" />
                                    </td>
                                    <td>
                                        <input id="pdkAddName" class="aiField pdkCellName" placeholder="name" aria-label="Name of the layer to add"
                                               @bind="addName" @bind:event="oninput" @onkeydown="addKeyAsync" />
                                    </td>
                                    <td colspan="3">
                                        <button id="pdkAdd" class="buttonStyle2 smallButton rulesButton" disabled="@(!canAdd())" @onclick="addRowAsync"
                                                title="@addTitle()">Add layer</button>
                                    </td>
                                    <td>
                                        <button id="pdkAddClose" class="iconButton pdkRemove" aria-label="Stop adding layers" title="Stop adding layers"
                                                @onclick="stopAddingLayer"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>
                                    </td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="pdkRules" style="@(tab == Tab.Rules && branchPicked && !aboutOpen ? "" : "display: none;")">
                @*
                    Two ways to the same deck: a table with a form, so a rule is made by choosing rather than by writing its
                    line (asked for 2026-10-18), and the deck's own text, for its comments, its derived layers and anything
                    the form does not offer. Either writes the text, which is what a deck is.
                *@
                <div class="pdkRulesBar">
                    <div class="pdkViewSwitch" role="group" aria-label="How the rules are shown">
                        <button id="pdkRulesAsTable" class="pdkViewChoice @(rulesAsText ? "" : "pdkViewChoiceOn")" aria-pressed="@(rulesAsText ? "false" : "true")"
                                title="The rules as a table, each changed in a form" @onclick="() => showRulesAsText(false)">Table</button>
                        <button id="pdkRulesAsText" class="pdkViewChoice @(rulesAsText ? "pdkViewChoiceOn" : "")" aria-pressed="@(rulesAsText ? "true" : "false")"
                                title="The deck's own text, with its layers, derived layers and comments" @onclick="() => showRulesAsText(true)">Text</button>
                    </div>

                    @*
                        Rules written in the AI assistant, on this PDK - asked for 2026-10-19 as a box here that asked a model for deck
                        lines from a sentence, and since 2026-10-31 the assistant's own window, asked for that day: it reads
                        the deck and its grammar and adds lines to it, a card for each - see RuleTools, and Viewer.razor's
                        writeRulesWithAi.
                    *@
                    <button id="pdkRulesAi" class="buttonStyle2 smallButton rulesButton pdkAiButton" @onclick="() => OnWriteRules.InvokeAsync(shown)"
                            title="Open the AI assistant to write rules into this PDK: describe them, or attach a rule manual, and it adds them as deck lines">
                        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                            <path fill="currentColor" d="M6.4 1.6c.3 2.6 1.6 4 4.2 4.3-2.6.3-3.9 1.7-4.2 4.3-.3-2.6-1.6-4-4.2-4.3 2.6-.3 3.9-1.7 4.2-4.3z" />
                            <path fill="currentColor" d="M11.6 8.6c.2 1.6 1 2.4 2.6 2.6-1.6.2-2.4 1-2.6 2.6-.2-1.6-1-2.4-2.6-2.6 1.6-.2 2.4-1 2.6-2.6z" />
                        </svg>
                        Write with AI
                    </button>

                    <span id="pdkRulesSays" class="pdkRulesSays" role="status">@rulesSays</span>
                </div>

                <div class="pdkRuleScroll" style="@(rulesAsText ? "display: none;" : "")">
                    <table id="pdkRuleList" class="pdkLayerTable pdkRuleTable">
                        <thead>
                            <tr>
                                @if (rulesSwitch())
                                {
                                    <th title="Checked when the rules run on a file drawn in this PDK">On</th>
                                }
                                <th>Rule</th>
                                <th>Check</th>
                                <th>Layers</th>
                                <th>Limit</th>
                                <th>Description</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in deck.Rules)
                            {
                                var each = rule;

                                @if (ruleEditing == each.Line)
                                {
                                    @RuleForm
                                }
                                else
                                {
                                    <tr class="pdkRule" data-rule="@each.Id" title="@each.Description">
                                        @if (rulesSwitch())
                                        {
                                            <td>
                                                <input type="checkbox" checked="@(!RulesOff.Contains(each.Id))" aria-label="@($"Check {each.Id}")"
                                                       @onchange="() => OnRuleToggled.InvokeAsync(each.Id)" />
                                            </td>
                                        }
                                        <td class="pdkRuleId">@each.Id</td>
                                        <td>@checkSaid(each)</td>
                                        <td>@layersSaid(each)</td>
                                        <td class="pdkRuleLimit">@limitSaid(each)</td>
                                        <td class="pdkRuleSays">@each.Description</td>
                                        <td class="pdkRuleActions">
                                            <button class="iconButton pdkRuleEdit" aria-label="@($"Change {each.Id}")" title="Change this rule"
                                                    @onclick="() => startEditingRule(each)">
                                                <svg viewBox="0 0 16 16" aria-hidden="true">@((MarkupString)SvgWriter.IconFor(SvgWriter.ShapeIcon.Rename))</svg>
                                            </button>

                                            @if (ruleRemoving == each.Line)
                                            {
                                                <button class="buttonStyle2 smallButton rulesButton aiDanger pdkRuleRemoveSure" @onclick="() => removeRuleAsync(each)"
                                                        title="Take this rule out of the PDK">Remove</button>
                                            }
                                            else
                                            {
                                                <button class="iconButton pdkRemove" aria-label="@($"Remove {each.Id}")" title="Take this rule out of the PDK - press again to be sure"
                                                        @onclick="() => ruleRemoving = each.Line"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }

                            @if (ruleEditing == 0)
                            {
                                @RuleForm
                            }
                            else if (deck.Rules.Count == 0)
                            {
                                <tr>
                                    <td id="pdkNoRules" class="pdkEmpty" colspan="@ruleColumns()">No rules yet. Add one below, import a deck, or write one as text.</td>
                                </tr>
                            }
                        </tbody>

                        @*
                            Add new rule, a gray row with a plus as the table's last, held to the bottom of the list as it scrolls
                            the way the layers' New layer row is (asked for 2026-11-01; it was the first row, and an Add rule
                            button in the bar over the table before that). Its form opens under the last rule, where the rule lands.
                        *@
                        @if (ruleEditing != 0)
                        {
                            <tfoot>
                                <tr class="pdkRuleAddRow">
                                    <td colspan="@ruleColumns()">
                                        <button id="pdkRuleAdd" type="button" class="pdkRuleAddButton" @onclick="startAddingRule"
                                                title="A rule made by choosing its check, its layers and its limit">
                                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                                <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                            </svg>
                                            Add new rule
                                        </button>
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <div class="pdkRuleText" style="@(rulesAsText ? "" : "display: none;")">
                    <div id="pdkRulesEditor" class="pdkRulesEditor" @ref="editorHost"></div>

                    <div class="pdkRulesFoot">
                        <button id="pdkRulesApply" class="buttonStyle2 smallButton rulesButton" @onclick="applyRulesAsync"
                                title="Make this text the PDK's rules - every file drawn in it is checked against them">Apply</button>
                        <button id="pdkRulesRevert" class="buttonStyle2 smallButton rulesButton aiQuiet" @onclick="revertRulesAsync"
                                title="Back to the rules as they were last applied">Revert</button>
                    </div>
                </div>

                @if (deck.Problems.Count > 0 || deck.Refused.Count > 0)
                {
                    <ul id="pdkRulesProblems" class="pdkRulesProblems">
                        @foreach (string problem in deck.Problems.Concat(deck.Refused).Take(MostProblems))
                        {
                            <li>@problem</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</FloatingWindow>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    ///<summary>Opened to pick a PDK for a new layout's layers, so the one in use offers its use pill too - see Viewer.razor's setPdk.</summary>
    [Parameter]
    public bool Picking { get; set; }

    ///<summary>The PDKs kept, which this changes in place - see the note at the top.</summary>
    [Parameter]
    public PdkList Pdks { get; set; } = PdkList.Fresh();

    ///<summary>The built-ins' layermaps and decks as they ship, by PDK id, which each reads until it is changed.</summary>
    [Parameter]
    public Dictionary<string, string> ShippedLayers { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public Dictionary<string, string> ShippedRules { get; set; } = new Dictionary<string, string>();

    ///<summary>Whether the deck checking the open file is the PDK in use's, so its rules can be switched on and off here.</summary>
    [Parameter]
    public bool RulesLive { get; set; }

    [Parameter]
    public IReadOnlySet<string> RulesOff { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<string> OnRuleToggled { get; set; }

    ///<summary>Asked to put a PDK in use, by its id.</summary>
    [Parameter]
    public EventCallback<string> OnUse { get; set; }

    ///<summary>Told a PDK's layers, rules, start or name changed.</summary>
    [Parameter]
    public EventCallback<Pdk> OnEdited { get; set; }

    ///<summary>Told a PDK was made or deleted.</summary>
    [Parameter]
    public EventCallback OnListChanged { get; set; }

    ///<summary>Asked to open the layer settings on a row of a PDK, from where it was pressed - see <see cref="LayerStyleAsked"/>.</summary>
    [Parameter]
    public EventCallback<LayerStyleAsked> OnStyleLayer { get; set; }

    ///<summary>The deck that fails on purpose asked for, from the rules' information - the shell's to load, over the open file.</summary>
    [Parameter]
    public EventCallback OnDemoDeck { get; set; }

    ///<summary>Write with AI pressed on a PDK: the shell opens the AI assistant to write rules into it - see Viewer.razor's writeRulesWithAi.</summary>
    [Parameter]
    public EventCallback<Pdk> OnWriteRules { get; set; }

    ///<summary>Write with AI pressed over a PDK's layers: the same, to write layers into it - see Viewer.razor's writeLayersWithAi.</summary>
    [Parameter]
    public EventCallback<Pdk> OnWriteLayers { get; set; }

    ///<summary>Whether the help on PDKs, layers and rules is up, in the place of the list - see pdkAbout. Put away each time the window opens.</summary>
    private bool aboutOpen;

    ///
    ///Hands over one of the two writing guides, fetched from where it is served - there is one copy of each, linked into
    ///the static files from docs/ by the csproj, so editing the documentation is editing what the app gives out.
    ///
    private async Task downloadGuideAsync(string name)
    {
        try
        {
            byte[] guide = await http.GetByteArrayAsync($"resources/{name}");

            await js.InvokeVoidAsync("BlazorDownloadFile", name, "text/markdown", guide);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Could not fetch {name}: {ex.Message}");
        }
    }

    ///
    ///A row's look asked for: which PDK, which of its layers, and where on the page the press was, for the popup to open
    ///beside it. The shell opens its own layer settings on it - the popup a layer in the sidebar opens - and writes what
    ///is chosen there into the PDK's layermap.
    ///
    public sealed record LayerStyleAsked(Pdk Pdk, LayerKey Pair, double X, double Y);

    private enum Tab
    {
        Layers,
        Rules
    }

    ///<summary>How many of a deck's problems are listed before the rest are left to the rules panel.</summary>
    private const int MostProblems = 8;

    private Tab tab = Tab.Layers;

    ///<summary>The PDK shown, which the window opens on the one in use.</summary>
    private Pdk shown = new Pdk();

    ///<summary>The shown PDK's layers, parsed, and the pairs they hold in order - the table's rows.</summary>
    private LayerNames layers = new LayerNames();
    private List<LayerKey> rows = new List<LayerKey>();

    ///<summary>The shown PDK's rules, parsed from what was last applied.</summary>
    private DrcDeck deck = DrcDeck.Parse("");

    ///<summary>The layers a new layout starts with in the shown PDK - see Pdk.StartingLayers.</summary>
    private HashSet<LayerKey> starts = new HashSet<LayerKey>();

    private bool deleting;
    private bool wasVisible;

    private string addLayer = "";
    private string addDataType = "";
    private string addName = "";

    private string rulesSays = "";

    ///<summary>What the last layermap imported into the PDK shown said - see layersSaid.</summary>
    private string layersSays = "";

    ///<summary>What the last import said: what it added, and what it could not bring.</summary>
    private string importSays = "";

    private ElementReference editorHost;

    ///<summary>The code editor's id in MonacoInterop.js, or 0 before it is made.</summary>
    private int editorId;

    ///<summary>Whether the editor is being made, so a second render does not make another.</summary>
    private bool makingEditor;

    protected override void OnParametersSet()
    {
        //Nothing to read while it is put away, and the page renders far more often than this is looked at.
        if (!Visible)
        {
            wasVisible = false;

            return;
        }

        //Opened on the PDK in use, every time it opens: that is the one the panels were just showing.
        if (!wasVisible || !Pdks.Pdks.Contains(shown))
        {
            shown = Pdks.InUse;
            deleting = false;
            rulesSays = "";
            layersSays = "";
            importSays = "";
            aboutOpen = false;
            branchPicked = false;
            renaming = false;
            layerAdding = false;
            closeRuleForm();
        }

        wasVisible = true;

        //Read again when what it shows has changed - edited from the panels while it was open, say.
        read();

        _ = loadShippedReadmesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible)
            await showPdfAsync();

        //The name's box just put in the tree, with the name selected so typing replaces it.
        if (focusRename)
        {
            focusRename = false;

            try
            {
                await js.InvokeVoidAsync("selectAllIn", renameBox);
            }
            catch { }
        }

        //The form just opened, or the rule it just added, brought into view in a table taller than the window.
        if (scrollTo is string selector)
        {
            scrollTo = null;

            try
            {
                await js.InvokeVoidAsync("scrollToElement", selector);
            }
            catch { }
        }

        //The add row's fields just put out, the caret in the first.
        if (focusAddLayer)
        {
            focusAddLayer = false;

            try
            {
                await addLayerBox.FocusAsync();
            }
            catch { }
        }

        await layersEditorAsync();

        //The editor is made the first time the text is shown on screen: a hidden window gives it no size to start from.
        if (!Visible || tab != Tab.Rules || !rulesAsText || editorId != 0 || makingEditor)
            return;

        makingEditor = true;

        try
        {
            editorId = await js.InvokeAsync<int>("createTextEditor", editorHost, rulesText(shown), "gdsdeck");
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            //Said in the panel: with no editor, Apply has nothing to read, and a button that does nothing with no
            //word about why is the worse of the two.
            rulesSays = $"The rules editor could not be made, so the text cannot be edited here: {ex.Message}";
        }

        makingEditor = false;
    }

    ///
    ///The layermap's editor, made the first time its text is shown, as the rules' is - and given the layermap again
    ///whenever it changed underneath it: from the table, an import, the AI assistant or another PDK picked.
    ///
    private async Task layersEditorAsync()
    {
        if (layersEditorId != 0)
        {
            if (!layersEditorStale)
                return;

            layersEditorStale = false;

            await layersEditorShows(layersText(shown));

            return;
        }

        if (!Visible || tab != Tab.Layers || !branchPicked || !layersAsText || makingLayersEditor)
            return;

        makingLayersEditor = true;
        layersEditorStale = false;

        try
        {
            layersEditorId = await js.InvokeAsync<int>("createTextEditor", layersEditorHost, layersText(shown), "gdslayermap");
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            layersSays = $"The layermap editor could not be made, so the text cannot be edited here: {ex.Message}";
        }

        makingLayersEditor = false;
    }

    public async ValueTask DisposeAsync()
    {
        foreach (int id in new[] { editorId, layersEditorId })
        {
            if (id == 0)
                continue;

            try
            {
                await js.InvokeVoidAsync("disposeTextEditor", id);
            }
            catch { }
        }
    }

    ///<summary>The shown PDK's layermap: its own, or for a built-in the one it ships with until it is changed.</summary>
    private string layersText(Pdk pdk)
    {
        return pdk.Layers ?? ShippedLayers.GetValueOrDefault(pdk.Id, "");
    }

    private string rulesText(Pdk pdk)
    {
        return pdk.Rules ?? ShippedRules.GetValueOrDefault(pdk.Id, "");
    }

    ///<summary>Reads the shown PDK's layers and rules again, and what a layout starts with - unless none of it has changed.</summary>
    private void read()
    {
        string layersNow = layersText(shown);
        string rulesNow = rulesText(shown);
        string startNow = string.Join(",", shown.Start ?? new List<string>()) + (shown.Start is null);

        if (shown == readFor && layersNow == readLayers && rulesNow == readRules && startNow == readStart)
            return;

        //A rule being changed in the form is found by its line, which a deck changed underneath it no longer means.
        if (shown != readFor || rulesNow != readRules)
            closeRuleForm();

        if (shown != readFor || layersNow != readLayers)
            layersEditorStale = true;

        readFor = shown;
        readLayers = layersNow;
        readRules = rulesNow;
        readStart = startNow;

        layers = LayerNames.Parse(layersNow);
        rows = layers.Pairs.ToList();
        deck = DrcDeck.Parse(rulesNow);
        starts = new HashSet<LayerKey>(shown.StartingLayers(layers, deck));
    }

    ///<summary>What was last read, so a render that changed none of it reads nothing - see read.</summary>
    private Pdk? readFor;
    private string readLayers = "";
    private string readRules = "";
    private string readStart = "";

    private async Task showAsync(Pdk pdk)
    {
        if (pdk == shown)
            return;

        shown = pdk;
        deleting = false;
        renaming = false;
        rulesSays = "";
        layersSays = "";

        //Another PDK picked is that PDK picked, not a list of it.
        branchPicked = false;
        layerAdding = false;

        read();

        await editorShows(rulesText(shown));
    }

    private void showTab(Tab chosen)
    {
        tab = chosen;

        closeRuleForm();
    }

    ///
    ///Whether one of the shown PDK's lists is picked in the tree, rather than the PDK itself - what Import, Export and the
    ///bin under the tree act on. The list shown on the right is the one last picked either way. Asked for 2026-10-19, in
    ///place of the tabs over the table and their own Import and Export.
    ///
    private bool branchPicked;

    ///<summary>A PDK picked in the tree: shown, and the squares under the tree acting on it as a whole.</summary>
    private async Task pickPdkAsync(Pdk pdk)
    {
        await showAsync(pdk);

        branchPicked = false;
        deleting = false;
    }

    ///<summary>One of the shown PDK's lists picked in the tree: shown, and the squares acting on it alone.</summary>
    private void pickBranch(Tab which)
    {
        showTab(which);

        branchPicked = true;
        deleting = false;
    }

    ///<summary>The input Import opens: a whole PDK's, or the picked list's.</summary>
    private string importInput()
    {
        if (!branchPicked)
            return "pdkPackageImport";

        if (tab == Tab.Layers)
            return "pdkLayersImport";

        return "pdkRulesImport";
    }

    private string importLabel()
