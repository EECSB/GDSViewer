    ///<summary>The add row's layer number, given the caret when the row opens - see OnAfterRenderAsync.</summary>
    private ElementReference addLayerBox;
    private bool focusAddLayer;

    private ElementReference layersEditorHost;

    ///<summary>The layermap's editor's id in MonacoInterop.js, or 0 before it is made - the rules' has its own.</summary>
    private int layersEditorId;
    private bool makingLayersEditor;

    ///<summary>Whether the layermap changed since the editor was last given it - see read, and OnAfterRenderAsync.</summary>
