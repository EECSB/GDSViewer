    ///<summary>The shown PDF README's blob address made, or let go of when no PDF is shown - after a render, which is when the frame is there.</summary>
    private async Task showPdfAsync()
    {
        PdkReadme? wanted = null;

        if (!aboutOpen && !branchPicked && readmeOf(shown) is PdkReadme readme && readme.Kind == PdkReadmeKind.Pdf)
            wanted = readme;

        if (wanted == pdfFor)
            return;

        if (pdfUrl.Length > 0)
        {
            try
            {
                await js.InvokeVoidAsync("revokeObjectUrl", pdfUrl);
            }
            catch { }
        }

        pdfFor = wanted;
        pdfUrl = "";

        if (wanted?.Pdf is not null)
        {
            try
            {
                pdfUrl = await js.InvokeAsync<string>("objectUrlOf", wanted.Pdf, "application/pdf");
            }
            catch { }
        }

        StateHasChanged();
    }

    #endregion

    ///<summary>The PDK shown as one zip - see PdkPackage - with the pictures its textures name that this browser keeps.</summary>
    private async Task exportPackageAsync()
    {
        var pictures = new Dictionary<string, byte[]>(StringComparer.Ordinal);

        foreach (string name in layers.Textures.Values.Distinct(StringComparer.Ordinal))
        {
            byte[]? picture = await textures.GetAsync(name);

            if (picture is not null)
                pictures[name] = picture;
        }

        byte[] zip = PdkPackage.Write(shown.Name, layers.Write(), rulesText(shown), pictures, readmeOf(shown));

        await js.InvokeVoidAsync("BlazorDownloadFile", PdkPackage.FileNameOf(shown.Name) + ".zip", "application/zip", zip);
    }

