        if (name == RuleTools.AddName)
            return RuleTools.AddTool.Description;

        if (name == LayerTools.ReadName)
            return LayerTools.ReadTool.Description;

        if (name == LayerTools.SetName)
            return LayerTools.SetTool.Description;

        if (name == ExampleTools.ListName)
