    ///
    ///Files chosen with the paperclip, or pasted or dropped and handed to its input: each read and put in the box, or
    ///turned away with why. One at a time, so a picture too big costs the others nothing - and one far too big is
    ///turned away on its size, before a byte of it is read.
    ///
    private async Task filesChosen(InputFileChangeEventArgs e)
    {
        var problems = new List<string>();

        foreach (var chosen in e.GetMultipleFiles(e.FileCount))
        {
            if (AiAttachment.Refusal(chosen.Name, chosen.ContentType, chosen.Size) is string refused)
            {
                problems.Add(refused);

                continue;
            }

            byte[] data;

            try
            {
                await using var stream = chosen.OpenReadStream(AiAttachment.MostBytes(AiAttachment.KindOf(chosen.Name, chosen.ContentType)));
                using var memory = new MemoryStream();

                await stream.CopyToAsync(memory);
                data = memory.ToArray();
            }
            catch (Exception failed)
            {
                problems.Add($"{chosen.Name} could not be read: {failed.Message}");

                continue;
            }

            if (chat.Attach(new AiAttachment(chosen.Name, chosen.ContentType, data)) is string problem)
                problems.Add(problem);
        }

        attachProblem = string.Join(" ", problems);
    }

    private void unattach(AiAttachment file)
    {
        chat.Unattach(file);
        attachProblem = "";
    }

    ///<summary>A tick in the files panel: a file left out of the conversation from here on, or sent with it again.</summary>
    private void includeChanged(AiAttachment file, ChangeEventArgs e)
    {
        bool include = e.Value is bool ticked && ticked;

        if (chat.Include(file, include) is string problem)
        {
            attachProblem = problem;
            ticksRefused++;

            return;
        }

        attachProblem = "";
    }

    ///<summary>Why a file in the box cannot go to the model picked, or null when it can.</summary>
    private string? notSentTo(AiAttachment file)
    {
        if (selected is null)
            return null;

        return AiAttachment.NotSentTo(selected.ProviderType, file);
    }

    ///<summary>The first file in the box the model picked cannot be sent, said as why Send waits: sent anyway, it would reach the model as a line saying it could not.</summary>
    private string? blocked()
    {
        foreach (var file in chat.Pending)
        {
            if (notSentTo(file) is string why)
                return why;
        }

        return null;
    }

    private string pendingChipTitle(AiAttachment file)
    {
        string said = $"{file.Name}, {AiAttachment.Size(file.Data.Length)}, goes with the next question";

        if (notSentTo(file) is string why)
            return why;

        return said;
    }

    private static string sentChipTitle(AiAttachment file)
    {
        string said = $"{file.Name}, {AiAttachment.Size(file.Data.Length)}";

        if (file.Excluded)
            return said + ". Left out of the conversation since - tick it in the files panel to send it again";

        return said + ". Sent again with every question - untick it in the files panel to stop";
    }

    ///<summary>What the ticked files and the waiting ones add to every question, under the files panel's lists.</summary>
    private string filesWeight()
    {
        if (selected is null)
            return "";

        long tokens = 0;
        int files = 0;

        foreach (var (_, file) in chat.SentFiles())
        {
            if (file.Excluded)
                continue;

            tokens += AiEstimate.Attachment(file, selected.ProviderType);
            files++;
        }

        foreach (var file in chat.Pending)
        {
            tokens += AiEstimate.Attachment(file, selected.ProviderType);
            files++;
        }

        if (files == 0)
            return "No file goes with the next question.";

        string said = $"These add about {AiPricing.About(tokens)} tokens to every question";

        if (askedPrice() is LlmPrice price)
            said += $", {AiPricing.Money(price.CostOfInput(tokens))} at this model's rates";

        return said + ".";
    }

    ///<summary>The next request as it would go now: the instructions, the tools, the conversation with its ticked files, and the box with its files.</summary>
    private long nextRequestTokens()
    {
        if (selected is null)
            return 0;

        string off = string.Join(",", chat.ToolsOff.Order(StringComparer.Ordinal));

        if (toolTokens < 0 || off != toolTokensFor)
        {
            toolTokens = AiEstimate.ToolTokens(LayoutToolRunner.ToolsFor(true, Look is not null, Rules is not null, chat.ToolsOff, Examples is not null, Pdks is not null));
            toolTokensFor = off;
        }

        var conversation = chat.BuildConversation();

        conversation.Add(LlmMessage.FromUser(prompt, chat.Pending.ToArray()));

        return AiEstimate.Request(LayoutPrompt.Build(lastFacts, chat.Mode, chat.ToolsOff), toolTokens, conversation, selected.ProviderType);
    }

    private string estimateLine()
    {
        if (selected is null)
            return "";

        long tokens = nextRequestTokens();
        string said = $"Next request: about {AiPricing.About(tokens)} tokens";

        if (askedPrice() is LlmPrice price)
            said += $", {AiPricing.Money(price.CostOfInput(tokens))} to send";

        return said;
    }

    private string estimateTitle()
    {
        var said = new List<string>
        {
            "What sending now puts in front of the model: its instructions, the editor's tools, this conversation with its ticked files, and the box.",
            "Every round of tool calls sends it again, and an answer is billed on top at the output rate - on Anthropic most of a round is read back from the cache, at a tenth of the rate or less.",
            "Counted from characters, at about 3.5 a token, a picture at 1,600 and a PDF page at 2,000; what was really billed shows under each answer."
        };

        if (selected is not null && AiPricing.For(selected, DateTime.UtcNow) is null)
            said.Add("This model has no rate, so no cost is shown: give it one under Settings, AI settings.");

        return string.Join(" ", said);
    }

    private string spentLine()
    {
        if (chat.Cost is decimal dollars)
            return "Spent: " + AiPricing.Money(dollars);

        var used = chat.Used;

        return $"Spent: {AiPricing.Count(used.InputTokens)} tokens in, {AiPricing.Count(used.OutputTokens)} out";
    }

    private string spentTitle()
    {
        var said = new StringBuilder("What the providers reported billing since this page opened - Clear does not take it back:");

        foreach (var (model, spent) in chat.Spend)
        {
            said.AppendLine();
            said.Append($"{model}: {AiPricing.Count(spent.Usage.InputTokens)} tokens in");

            if (spent.Usage.CachedInputTokens > 0)
                said.Append($" ({AiPricing.Count(spent.Usage.CachedInputTokens)} read from the cache)");

            said.Append($", {AiPricing.Count(spent.Usage.OutputTokens)} out, in {spent.Usage.Requests} requests");

            if (spent.Cost is decimal dollars)
                said.Append($" - {AiPricing.Money(dollars)}");
            else
                said.Append(" - no rate for this model");
        }

        return said.ToString();
    }

    private string ratesTitle()
    {
        if (selected is null)
            return "";

        string where = "Where the provider publishes its rates";

        if (askedPrice() is LlmPrice price)
            return $"{where}. The figures here use {price.Source}. A model's own rates can be set under Settings, AI settings";

        return $"{where}. This model has no rate here: give it one under Settings, AI settings";
    }

    ///<summary>What a run was billed for, in full, over the line under the answer it ended - see AiChat.UsageLine.</summary>
    private static string usageTitle(ChatTurn turn)
    {
        if (turn.Usage is not LlmUsage used)
            return "";

        var said = new StringBuilder($"What {turn.Model} was billed for here, every request of it: {AiPricing.Count(used.InputTokens)} tokens read");

        if (used.CachedInputTokens > 0 || used.CacheWriteTokens > 0)
            said.Append($", {AiPricing.Count(used.CachedInputTokens)} of them from the provider's cache and {AiPricing.Count(used.CacheWriteTokens)} written into it");

        said.Append($"; {AiPricing.Count(used.OutputTokens)} written");

        if (used.ReasoningTokens > 0)
            said.Append($", {AiPricing.Count(used.ReasoningTokens)} of them thinking");

        if (turn.Cost is null)
            said.Append(". There is no rate for this model, so no cost: give it one under Settings, AI settings");

        return said.Append('.').ToString();
    }

    ///<summary>What the empty box says: what to do with it, or, on a page that may not change the file, why it is off.</summary>
    private string promptPlaceholder()
    {
        if (ReadOnly)
            return "This viewer is read-only, so the assistant is off on this page";

        return "Describe a change, or type / for commands";
    }

    private string modeHint()
    {
        if (chat.Mode == ToolApprovalMode.Ask)
            return "Every step the assistant takes waits for you, looking included";

        if (chat.Mode == ToolApprovalMode.AutoRead)
            return "The assistant looks at the layout as it needs to. Every change waits for you to approve it";

        return "The assistant changes the layout without asking. You see each change, and each one is a step you can undo";
    }

    ///<summary>Enter sends; Shift+Enter breaks the line. The newline itself is refused in floatingWindow.js - see attachComposer.</summary>
    private async Task onKey(KeyboardEventArgs e)
    {
        if (await slashKeyAsync(e))
            return;

        if (e.Key != "Enter" || e.ShiftKey || e.IsComposing)
            return;

        if (await runTypedSlashAsync())
            return;

        await sendAsync();
    }

    ///
    ///The one button's press: Stop while an answer is coming, Send the rest of the time.
    ///
    ///**The second click of a double-click is not a Stop.** The first sends, the button turns into Stop under the
    ///pointer, and the second would stop what was sent a moment before - so while an answer is coming, a press the
    ///browser counts as the second of a pair is let go. A press from the keyboard counts none, and stops.
    ///
    private async Task sendOrStop(MouseEventArgs e)
    {
        if (chat.Generating)
        {
            if (e.Detail < 2)
                chat.Cancel();

            return;
        }

        if (await runTypedSlashAsync())
            return;

        await sendAsync();
    }

    ///<summary>Carries a paused run on: sent as a message of its own, with what is in the box kept there for after.</summary>
    private async Task continueAsync()
    {
        string typed = prompt;

        prompt = "Continue where you stopped.";

        await sendAsync();

        if (prompt.Length == 0)
            prompt = typed;
    }

    private async Task sendAsync()
    {
        if (!canSend() || selected is null || Gds is null)
            return;

        //Before the box is emptied, so a refusal leaves the words where they were.
        if (BeforeSend is not null && !await BeforeSend())
        {
            chat.Refuse("Nothing was sent: the text in the editor could not be read as GDSII, so the file is not what it shows. The message under the editor says which line - fix it and send again.");

            return;
        }

        string text = prompt.Trim();

        prompt = "";

        //Emptied in the page too, so the box shrinks to what is in it now. Nothing fires an input event when C#
        //clears a bound value.
        try
        {
            await js.InvokeVoidAsync("floatingWindow.resetComposer", promptBox);
        }
        catch { }

        if (session is null || !ReferenceEquals(session.Gds, Gds))
            session = new AgentSession(Gds, History) { HowToLoadRules = "The rules come from the PDK in use: give it some, or put one that has them in use, in the app's PDK manager." };

        session.Deck = Deck;
        session.RulesOff = RulesOff;
        session.Waived = Waived;

        var facts = new LayoutFacts();

        if (Describe is not null)
            facts = await Describe(session);

        lastFacts = facts;
        attachProblem = "";

        //Effort and fast mode are chosen per request, so they ride on a copy: set on the saved model, they would be saved with it.
        var provider = ai.CreateProvider(asked(selected));
        var runner = new LayoutToolRunner(session, Look) { Changed = changed, DiffsText = true, Off = chat.ToolsOff, Rules = Rules, Examples = Examples, Pdks = Pdks };

        int shown = chatShown;

        //As set under AI settings when this is sent, so a change there holds from the next message on.
        chat.MaxToolRounds = await toolRounds.GetAsync();

        var outcome = await chat.SendAsync(text, provider, LayoutPrompt.Build(facts, chat.Mode, chat.ToolsOff), runner);

        if (shown == chatShown)
            await keepChatAsync();

        //A question that failed with files gives them back to the box - see AiChat.GaveFilesBack - and its words with
        //them when the box is still empty, rather than leaving them to be typed again.
        if (outcome == ChatOutcome.Failed && chat.GaveFilesBack && string.IsNullOrWhiteSpace(prompt))
        {
            prompt = text;
            composerSized = false;
        }
    }

    ///<summary>A change landed: the page draws it, with the shapes it made picked out.</summary>
    private async Task changed(AgentResult result)
    {
        var made = new List<GDS.ElementModel>();

        if (session is not null)
        {
            foreach (int id in result.Made)
            {
                if (session.ShapeNumbered(id) is GDS.ElementModel model)
                    made.Add(model);
            }
        }

        await OnLayoutChanged.InvokeAsync(made);
    }

    ///<summary>What a card says happened, which depends on the kind of call and on how it ended.</summary>
    private static string cardTitle(ChatTurn turn)
    {
        string what = humanized(turn.ToolName);

        if (turn.Decision is null && turn.Changes)
            return $"Wants to change the layout: {what}";

        if (turn.Decision is null)
            return $"Wants to look: {what}";

        if (turn.Decision == false)
            return $"Asked to {what}";

        if (turn.Changes)
            return $"Changed the layout: {what}";

        return $"Looked: {what}";
    }

    ///<summary>A tool's name as words - draw_rectangle as "draw rectangle".</summary>
    private static string humanized(string toolName)
    {
        return toolName.Replace('_', ' ');
    }

    ///<summary>The call as the card shows it: the tool, and its arguments as the model wrote them, on one line each where they fit.</summary>
    private static string callShown(ChatTurn turn)
    {
        string arguments = turn.ArgumentsJson.Trim();

        if (arguments.Length == 0 || arguments == "{}")
            return turn.ToolName + "()";

        return turn.ToolName + " " + arguments;
    }
}
