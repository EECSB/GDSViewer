    #region Slash commands

    ///
    ///**A slash at the start of the box lists what the window can do** (2026-10-31, asked for, as Claude has them):
    ///its own actions - a new chat, compacting, saving the chat as text, the tools, the camera, a screenshot and the
    ///settings - and questions it is often asked, written out. Typing narrows the list; the arrows move through it, Enter
    ///or a press runs the one marked, Tab writes its name out to add words after it, and Escape puts the list away. A
    ///command that cannot run now stays listed, dimmed, saying why.
    ///
    ///A question command sends its question at once, with any words written after its name added to it; one that only
    ///starts a question - /rules - puts it in the box to finish. Nothing here reaches the model by its slash: a name
    ///that is no command is sent as it was written.
    ///
    private sealed record SlashCommand(string Name, string Says, string? Why);

    ///<summary>The marked row of the list, which the arrows move.</summary>
    private int slashIndex;

    ///<summary>The box's words when Escape put the list away - it stays away until they change.</summary>
    private string? slashDismissed;

    ///<summary>Why the command last asked for could not run, under the box until the next one.</summary>
    private string slashProblem = "";

    private const string DescribeQuestion = "Describe the open cell: what is in it, on which layers, and how it is laid out.";
    private const string CheckQuestion = "Check the open cell against the design rules, and explain each fault you find and how it could be fixed. Change nothing yet.";

    ///<summary>Every command, in the order listed, each with why it cannot run now or null.</summary>
    private List<SlashCommand> slashCommands()
    {
        string? busy = null;

        if (!canLeaveChat())
            busy = "Once the answer is in";

        string? asking = busy;

        if (asking is null)
            asking = askBlocked();

        string? newWhy = busy;

        if (newWhy is null && chat.Turns.Count == 0)
            newWhy = "This chat is new already";

        string? exportWhy = busy;

        if (exportWhy is null && chat.Turns.Count == 0)
            exportWhy = "Nothing has been said in this chat yet";

        string? offWhy = null;

        if (ReadOnly)
            offWhy = "The assistant is off on this page";

        string? settingsWhy = null;

        if (!OnOpenSettings.HasDelegate)
            settingsWhy = "The settings are not on this page";

        var commands = new List<SlashCommand>
        {
            new SlashCommand("new", "Start a new chat. This one stays in the chats list", newWhy),
            new SlashCommand("compact", "Replace the conversation so far with a briefing the assistant carries on from", compactBlocked()),
            new SlashCommand("export", "Save this chat as text", exportWhy),
            new SlashCommand("tools", "Choose the tools the assistant may use in this chat", null),
            new SlashCommand("camera", "Take a picture with your camera, for the next question", offWhy),
            new SlashCommand("screenshot", "Attach a screenshot of a screen, a window or a tab", offWhy),
            new SlashCommand("settings", "Open AI settings: the models, their keys, and speech to text", settingsWhy),
            new SlashCommand("describe", "Ask what is in the open cell, and how it is laid out", asking),
            new SlashCommand("check", "Ask for a check against the design rules, and what each fault means", asking)
        };

        if (Rules is not null)
            commands.Add(new SlashCommand("rules", $"Write design rules into {Rules.PdkName()}'s deck", busy));

        return commands;
    }

    ///<summary>Why a question cannot be sent now, beyond an answer coming: no model, no file, or a page the assistant is off on.</summary>
    private string? askBlocked()
    {
        if (ReadOnly)
            return "The assistant is off on this page";

        if (selected is null)
            return "Add a model under Settings, AI settings first";

        if (Gds is null)
            return "Open a file first";

        return blocked();
    }

    ///<summary>The name being typed after the box's leading slash, or null when the box holds anything else.</summary>
    private string? slashTyped()
    {
        if (prompt.Length == 0 || prompt[0] != '/')
            return null;

        string name = prompt.Substring(1);

        if (name.Any(character => !char.IsAsciiLetterLower(character)))
            return null;

        return name;
    }

    ///<summary>The commands whose names start with what is typed after the slash.</summary>
    private List<SlashCommand> slashMatches()
    {
        string? typed = slashTyped();

        if (typed is null)
            return new List<SlashCommand>();

        return slashCommands().Where(command => command.Name.StartsWith(typed, StringComparison.Ordinal)).ToList();
    }

    private bool slashShown()
    {
        if (ReadOnly || prompt == slashDismissed)
            return false;

        return slashMatches().Count > 0;
    }

    ///<summary>The command and its words when the box holds one written out - "/check met1 only" - or null.</summary>
    private (SlashCommand Command, string Words)? typedSlash()
    {
        string text = prompt.Trim();

        if (text.Length < 2 || text[0] != '/')
            return null;

        int end = 1;

        while (end < text.Length && char.IsAsciiLetterLower(text[end]))
            end++;

        if (end < text.Length && !char.IsWhiteSpace(text[end]))
            return null;

        string name = text.Substring(1, end - 1);
        var command = slashCommands().FirstOrDefault(each => each.Name == name);

        if (command is null)
            return null;

        return (command, text.Substring(end).Trim());
    }

    ///<summary>The list's keys while it is up. Answers whether the key was the list's.</summary>
    private async Task<bool> slashKeyAsync(KeyboardEventArgs e)
    {
        if (!slashShown() || e.IsComposing)
            return false;

        var offered = slashMatches();

        if (slashIndex >= offered.Count)
            slashIndex = 0;

        if (e.Key == "ArrowDown")
        {
            slashIndex = (slashIndex + 1) % offered.Count;

            return true;
        }

        if (e.Key == "ArrowUp")
        {
            slashIndex = (slashIndex + offered.Count - 1) % offered.Count;

            return true;
        }

        if (e.Key == "Escape")
        {
            slashDismissed = prompt;

            return true;
        }

        if (e.Key == "Tab")
        {
            prompt = $"/{offered[slashIndex].Name} ";

            return true;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await runSlashAsync(offered[slashIndex], string.Empty);

            return true;
        }

        return false;
    }

    ///<summary>Runs the command written out in the box, if it holds one. Answers whether it did, or said why it could not.</summary>
    private async Task<bool> runTypedSlashAsync()
    {
        var typed = typedSlash();

        if (typed is null)
            return false;

        await runSlashAsync(typed.Value.Command, typed.Value.Words);

        return true;
    }

    private async Task runSlashAsync(SlashCommand command, string words)
    {
        slashProblem = "";
        slashIndex = 0;

        if (command.Why is not null)
        {
            slashProblem = $"/{command.Name}: {command.Why}.";

            return;
        }

        string? question = null;

        if (command.Name == "describe")
            question = DescribeQuestion;
        else if (command.Name == "check")
            question = CheckQuestion;

        if (question is not null)
        {
            if (words.Length > 0)
                question = $"{question}\n\n{words}";

            prompt = question;
            await sendAsync();

            return;
        }

        if (command.Name == "rules" && Rules is not null)
        {
            prompt = $"Add these rules to {Rules.PdkName()}'s deck: {words}";
            composerSized = false;

            return;
        }

        await emptyBoxAsync();

        if (command.Name == "new")
            await newChatAsync();
        else if (command.Name == "compact")
            await compactAsync();
        else if (command.Name == "export")
            await exportAsync(chat, FileName);
        else if (command.Name == "tools")
            togglePicker();
        else if (command.Name == "camera" && !cameraOpen)
            await toggleCamera();
        else if (command.Name == "screenshot")
            await screenshotAsync();
        else if (command.Name == "settings")
            await OnOpenSettings.InvokeAsync();
    }

    ///<summary>Takes the command's words out of the box once it has run, and shrinks the box to match.</summary>
    private async Task emptyBoxAsync()
    {
        prompt = "";

        try
        {
            await js.InvokeVoidAsync("floatingWindow.resetComposer", promptBox);
        }
        catch { }
    }

