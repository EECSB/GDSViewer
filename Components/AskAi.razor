    }

    private string micLabel()
    {
        if (transcribing)
            return "Writing out what you said";

        if (listening)
            return "Stop listening";

        return "Speak your question";
    }

    ///
    ///What the microphone says when pointed at: what a press does in the way it is set to, and the other way and what it
    ///is better at - asked for 2026-10-31, so the provider's accuracy is a hover away.
    ///
    private string micTitle()
    {
        if (transcribing)
            return "Writing out what you said…";

        if (listening && listeningMode == SpeechMode.Provider)
            return "Recording - press to stop, and the AI provider writes it out";

        if (listening)
            return "Listening - press to stop";

        if (speechMode == SpeechMode.Provider)
            return "Speak your question: press, talk, and press again - an OpenAI or Gemini model writes it out, told the layer names, and the provider bills it. For live words as you talk, switch Speech to text to Browser under Settings, AI settings";

        if (!browserSpeech)
            return "This browser has no speech recognition of its own. Switch Speech to text to AI provider under Settings, AI settings, and the microphone records instead";

        return "Speak your question: your browser writes it into the box as you talk (Chrome and Edge send the audio to Google or Microsoft). For better accuracy with layer names and numbers, switch Speech to text to AI provider under Settings, AI settings";
    }

    private async Task micAsync()
    {
        if (ReadOnly || transcribing)
            return;

        speechProblem = "";

        if (listening)
        {
            await stopSpeechAsync();

            return;
        }

        listeningMode = speechMode;

        if (speechMode == SpeechMode.Browser)
        {
            if (!browserSpeech)
            {
                speechProblem = "This browser has no speech recognition of its own - Chrome and Edge have. Or switch Speech to text to AI provider under Settings, AI settings, and the microphone records instead.";

                return;
            }

            try
            {
                listening = await js.InvokeAsync<bool>("gdsSpeech.startListening", promptBox, handle);
            }
            catch { }

            if (!listening)
                speechProblem = "The browser's speech recognition could not start. Press the microphone again.";

            return;
        }

        string why = "The microphone could not be started.";

        try
        {
            why = await js.InvokeAsync<string>("gdsSpeech.startRecording", handle);
        }
        catch { }

        if (why.Length > 0)
        {
            speechProblem = why;

            return;
        }

        listening = true;
    }

    private async Task stopSpeechAsync()
    {
        if (listeningMode == SpeechMode.Browser)
        {
            try
            {
                await js.InvokeVoidAsync("gdsSpeech.stopListening");
            }
            catch { }

            return;
        }

        listening = false;
        transcribing = true;

        StateHasChanged();

        string recorded = "";

        try
        {
            recorded = await js.InvokeAsync<string>("gdsSpeech.stopRecording");
        }
        catch (Exception ex)
        {
            speechProblem = $"The recording could not be read: {ex.Message}";
        }

        await transcribeAsync(recorded);

        transcribing = false;
    }

    ///
    ///The browser's recognizer ended, or the recording reached its limit. Its words are in the box already, put there as
    ///if typed; a recording at its limit is written out as if the microphone had been pressed.
    ///
    [JSInvokable]
    public async Task OnSpeechEnded(string problem)
    {
        if (problem == "limit")
        {
            if (listening && listeningMode == SpeechMode.Provider)
                await stopSpeechAsync();

            StateHasChanged();

            return;
        }

        listening = false;

        if (problem.Length > 0)
            speechProblem = problem;

        composerSized = false;

        StateHasChanged();
    }

    ///<summary>Sends a recording to be written out, and puts what came back after what the box holds.</summary>
    private async Task transcribeAsync(string recorded)
    {
        if (recorded.Length == 0)
        {
            if (speechProblem.Length == 0)
                speechProblem = "Nothing was recorded.";

            return;
        }

        var saved = await ai.LoadModelsAsync();

        if (SpeechTranscriber.Pick(selected, saved.Values) is not LlmConnection model)
        {
            speechProblem = "Speech written out by the AI provider takes an OpenAI or Gemini model - add one under Settings, AI settings, or switch Speech to text to Browser there. Claude models take no audio.";

            return;
        }

        var stop = new CancellationTokenSource();

        transcribeStop = stop;

        try
        {
            var layers = new List<string>();

            if (Gds is not null)
                layers.AddRange(Gds.AdditionalInformation.Layers.Values.Select(layer => layer.Name ?? "").Where(name => name.Length > 0));

            var (text, problem) = await ai.TranscribeAsync(model, Convert.FromBase64String(recorded), SpeechTranscriber.Vocabulary(layers), stop.Token);

            if (problem is not null)
            {
                speechProblem = problem;

                return;
            }

            if (string.IsNullOrWhiteSpace(text))
            {
                speechProblem = "Nothing was heard in the recording.";

                return;
            }

            if (string.IsNullOrWhiteSpace(prompt))
                prompt = text.Trim();
            else
                prompt = prompt.TrimEnd() + " " + text.Trim();

            composerSized = false;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (transcribeStop == stop)
                transcribeStop = null;

            stop.Dispose();
        }
    }

