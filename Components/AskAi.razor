@using System.Text
@using GDSViewer.Ai
@using GdsII
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime js
@inject IAiService ai
@inject SpeechPreference speech
@inject ToolRoundsPreference toolRounds

@*
    The AI assistant: a conversation with a model about the layout that is open, in which the model reads and changes it with
    the layout's own tools.

    **Nothing it changes is beyond Undo.** Every change the model makes is one step on the history the person
    undoes with, among their own steps, and the approval mode decides which of them wait for a press first: on the
    middle rung, where the window starts, the model looks around freely and every change is a card somebody
    approves.

    Ported from GraphDBViewer's NlQueryModal - the transcript, the cards, Stop and Clear, the mode and the effort - with
    the conversation itself moved into AiChat, where a test can drive it. Clear became New chat on 2026-10-31, when the
    chats were kept: see the chats panel, and IAiService for where.

    **960 wide to begin with**, since 2026-10-31, when the chats and the files panels began open beside the conversation
    and 720 left it a column a quarter the window wide. 720 had been the least that kept the row along the box's foot to
    one line: the paperclip, the mode, the effort, the model, the (i) and Send, with the longest model name the picker
    shows before it cuts one off - see .aiSelect - which the ask-ai spec holds. It was 560, which put half the row on a
    second line; and 680 until the effort's first row said what default is, 44 pixels wider. Asked for 2026-10-18.
*@
<FloatingWindow Id="askAiWindow" Visible="Visible" OnClose="OnClose" Title="AI assistant" StorageKey="ask-ai"
                Width="min(960px, 94vw)" Height="min(680px, 86vh)">
    @*The spark the toolbar's button is, in front of the title, so the window says whose it is (2026-10-31, asked for).*@
    <TitleIcon>
        <svg viewBox="0 0 16 16" width="15" height="15">
            <path fill="currentColor" d="M6.4 1.6c.3 2.6 1.6 4 4.2 4.3-2.6.3-3.9 1.7-4.2 4.3-.3-2.6-1.6-4-4.2-4.3 2.6-.3 3.9-1.7 4.2-4.3z" />
            <path fill="currentColor" d="M11.6 8.6c.2 1.6 1 2.4 2.6 2.6-1.6.2-2.4 1-2.6 2.6-.2-1.6-1-2.4-2.6-2.6 1.6-.2 2.4-1 2.6-2.6z" />
        </svg>
    </TitleIcon>
    <ChildContent>
        @*
            The conversation and, when it is open, the files panel beside it. A file dropped anywhere on the two goes into the
            box for the next question, through the paperclip's own input - see fileDrop.js, which hands a drop on anything
            marked data-drop-into to that input. Not on a read-only page, where the assistant is off.
        *@
        <div class="aiChatRow aiDrop" data-drop-into="@dropInto()" @ref="chatRow">
            @*
                The chats kept, down the left as the Claude app has them (2026-10-31, asked for): New chat at the top, then the
                chat on screen and every one kept, the one changed last first, each opened by a press and carried on, and saved
                as text or thrown away from its own row - where Export and Clear in the title bar went. A chat is kept from its
                first question on, and again after every answer; until then it is the first row all the same. Where they are
                kept is the IAiService's: this browser, or a host app's account.

                **Open to begin with, and the files panel too**, each collapsed and opened again by its arrow in the window's
                margin on its side, and sized by dragging the divider at its inner edge - see attachSplits in
                floatingWindow.js, which keeps the widths. The switches in the title bar went for them, asked for that day.
            *@
            @if (chatsOpen)
            {
                <aside id="aiChats" class="aiChats" aria-label="Chats">
                    <button id="aiChatsNew" type="button" class="aiChatsNew" title="@newChatTitle()"
                            disabled="@(!canLeaveChat() || chat.Turns.Count == 0)" @onclick="newChatAsync">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                        New chat
                    </button>

                    <div class="aiChatsHead">Chats</div>

                    @*The chat on screen before it is kept: the first row, as it will be once its first answer is in.*@
                    @if (chatId is null)
                    {
                        <div id="aiChatNow" class="aiChatItem aiChatItemOn" aria-current="true" title="The chat on screen - kept here from its first question">
                            <span class="aiChatText">
                                <span class="aiChatTitle">@SavedChat.TitleFor(chat.Turns)</span>
                                <span class="aiChatWhen">Not kept yet</span>
                            </span>
                        </div>
                    }

                    @foreach (var kept in chats)
                    {
                        var each = kept;
                        bool current = each.Id == chatId;

                        if (deletingId == each.Id)
                        {
                            <div class="aiChatItem aiChatItemDeleting" data-chat="@each.Id">
                                <span class="aiChatAsk">Delete this chat? What it changed stays.</span>

                                <span class="aiChatAskButtons">
                                    <button type="button" class="aiChatDeleteYes" @onclick="() => deleteChatAsync(each.Id)">Delete</button>
                                    <button type="button" class="aiChatDeleteNo" @onclick="() => deletingId = null">Keep</button>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="aiChatItem @(current ? "aiChatItemOn" : "") @(canLeaveChat() || current ? "" : "aiChatItemOff")" data-chat="@each.Id"
                                 role="button" tabindex="0" aria-current="@(current ? "true" : "false")" title="@chatRowTitle(each)"
                                 @onclick="() => openChatAsync(each.Id)" @onkeydown="e => chatRowKey(e, each.Id)">
                                <span class="aiChatText">
                                    <span class="aiChatTitle">@each.Title</span>
                                    <span class="aiChatWhen">@chatWhen(each)</span>
                                </span>

                                <button type="button" class="aiChatButton aiChatExport" aria-label="Save as text"
                                        title="Save this chat as text: every question, answer and call, and what each answer was billed"
                                        disabled="@(current && chat.Generating)" @onclick="() => exportChatAsync(each)" @onclick:stopPropagation="true">
                                    <svg viewBox="0 0 16 16" aria-hidden="true">
                                        <path fill="currentColor" d="M8 1.5a.5.5 0 0 1 .5.5v7.79l2.65-2.64a.5.5 0 0 1 .7.7l-3.5 3.5a.5.5 0 0 1-.7 0l-3.5-3.5a.5.5 0 1 1 .7-.7L7.5 9.79V2a.5.5 0 0 1 .5-.5" />
                                        <path fill="currentColor" d="M2.5 10.5a.5.5 0 0 1 .5.5v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-2a.5.5 0 0 1 1 0v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2a.5.5 0 0 1 .5-.5" />
                                    </svg>
                                </button>

                                <button type="button" class="aiChatButton aiChatDelete" aria-label="Delete"
                                        title="Delete this chat. What the assistant changed stays, and can still be undone"
                                        disabled="@(current && !canLeaveChat())" @onclick="() => deletingId = each.Id" @onclick:stopPropagation="true">
                                    <svg viewBox="0 0 16 16" aria-hidden="true">
                                        <path fill="currentColor" d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path fill="currentColor" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </button>
                            </div>
                        }
                    }

                    <div class="aiChatsKept">Kept @ai.KeptWhere</div>
                </aside>
            }

            @*
                The chats' arrow, in the window's margin on the left, where it stays whether the panel is open or not (asked for
                2026-10-31: it moved with the panel's edge). The divider is for sizing alone, and only there while the panel is.
            *@
            <button id="aiChatsToggle" type="button" class="aiSplitToggle aiSplitToggleLeft" aria-expanded="@(chatsOpen ? "true" : "false")"
                    aria-label="@(chatsOpen ? "Collapse the chats" : "Open the chats")" title="@chatsTitle()" @onclick="toggleChats">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="@(chatsOpen ? "M10.25 3.5 5.75 8l4.5 4.5" : "M5.75 3.5 10.25 8l-4.5 4.5")" fill="none" stroke="currentColor" stroke-width="2.2"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            @if (chatsOpen)
            {
                <div class="aiSplit" data-split="chats" title="Drag to size the chats"></div>
            }

            <div id="aiTranscript" class="aiTranscript" @ref="scroller">
                @if (chat.Turns.Count == 0)
                {
                    <div class="aiIntro">
                        <p>
                            Describe a change to the layout, or ask about it - "draw a 2 µm met1 square at the origin", "what is
                            on poly in this cell?". The assistant uses the editor's own tools, and every change it makes is one
                            step you can undo.
                        </p>

                        @if (!ReadOnly)
                        {
                            <div id="aiExamples" class="aiExamples" aria-label="Examples to start from">
                                @foreach (string example in ExamplePrompts)
                                {
                                    <button type="button" class="aiExample" title="Put this in the box, to send or change first" @onclick="() => useExampleAsync(example)">@example</button>
                                }
                            </div>
                        }

                        <p>
                            What you type, and what the assistant reads from the layout - shapes, layers, and pictures of the
                            cell - is sent to the provider of the model picked below. Nothing is sent until you press Send.
                        </p>

                        @if (selected is null)
                        {
                            <p id="aiNoModel" class="aiIntroWarning">
                                There is no model yet. Add one, with your own key from Anthropic, OpenAI or Google, under
                                <button id="aiOpenSettings" class="aiLink" @onclick="OnOpenSettings">Settings, AI settings</button>.
                            </p>
                        }

                        @if (Gds is null)
                        {
                            <p class="aiIntroWarning">Open a layout, or start one, and the assistant works on that.</p>
                        }
                    </div>
                }

                @*
                    What a compaction folded away is still here, before its briefing - shown when asked, dimmed, and hidden
                    with a class rather than left out, so a card's diff is not drawn again each time it is shown.
                *@
                @{
                    int folded = chat.FoldedBefore;
                }

                @for (int i = 0; i < chat.Turns.Count; i++)
                {
                    var turn = chat.Turns[i];
                    string fold = foldClass(i, folded);

                    @if (turn.Kind == ChatTurn.User)
                    {
                        <div class="aiTurn aiTurnUser @fold">
                            <div class="aiQuestion">
                                @*The files it was sent with, over its words - struck through once unticked in the files panel.*@
                                @if (turn.Attachments.Count > 0)
                                {
                                    <div class="aiChips aiQuestionFiles">
                                        @foreach (var file in turn.Attachments)
                                        {
                                            <span class="aiChip @(file.Excluded ? "aiChipOff" : "")" title="@sentChipTitle(file)">@file.Name</span>
                                        }
                                    </div>
                                }

                                <div class="aiBubble aiBubbleUser">@turn.Text</div>
                            </div>
                        </div>
                    }
                    else if (turn.Kind == ChatTurn.Assistant)
                    {
                        <div class="aiTurn @fold">
                            <div class="aiBubble aiBubbleAssistant">@turn.Text</div>
                        </div>

                        @if (turn.Usage is not null)
                        {
                            <div class="aiUsage @fold" title="@usageTitle(turn)">@AiChat.UsageLine(turn)</div>
                        }
                    }
                    else if (turn.Kind == ChatTurn.Summary)
                    {
                        <div class="aiSummary @fold">
                            <div class="aiSummaryHead">
                                <span class="aiSummaryTitle">Conversation compacted</span>

                                @if (i == folded)
                                {
                                    <button id="aiShowEarlier" type="button" class="aiLink" @onclick="() => showEarlier = !showEarlier">@earlierToggle(folded)</button>
                                }
                            </div>

                            <div class="aiSummaryNote">The assistant carries on from this briefing. What came before it is not sent again.</div>
                            <div class="aiSummaryText">@turn.Text</div>

                            @if (turn.Attachments.Count > 0)
                            {
                                <div class="aiSummaryNote aiSummaryFiles">
                                    Its files are kept, unticked: @string.Join(", ", turn.Attachments.Select(file => file.Name)).
                                    <button type="button" class="aiLink" @onclick="() => filesOpen = true">Tick one in the files panel</button> to send it again.
                                </div>
                            }
                        </div>

                        @if (turn.Usage is not null)
                        {
                            <div class="aiUsage @fold" title="@usageTitle(turn)">@AiChat.UsageLine(turn)</div>
                        }
                    }
                    else if (turn.Kind == ChatTurn.Tool)
                    {
                        <div class="aiCard @(turn.Changes ? "aiCardChange" : "aiCardRead") @fold" data-tool="@turn.ToolName">
                            <div class="aiCardTitle">
                                @cardTitle(turn)

                                @if (turn.Auto)
                                {
                                    <span class="aiBadge" title="Run without asking, because of the setting below">auto</span>
                                }
                            </div>

                            <pre class="aiCode">@callShown(turn)</pre>

                            @if (turn.Decision is null)
                            {
                                <div class="aiCardButtons">
                                    @*
                                        The two answers are opposite, so they look it: the press that goes ahead in the app's blue,
                                        and the one that refuses in red. A change is not drawn as dangerous - it is one Undo away.
                                    *@
                                    <button class="buttonStyle2 smallButton rulesButton aiApprove" @onclick="() => chat.Decide(turn, true)">
                                        @(turn.Changes ? "Approve and change the layout" : "Approve")
                                    </button>

                                    <button class="buttonStyle2 smallButton rulesButton aiDanger aiDecline" @onclick="() => chat.Decide(turn, false)">Decline</button>
                                </div>
                            }
                            else if (turn.Decision == false)
                            {
                                <div class="aiCardNote">Declined. The assistant was told it was not done.</div>
                            }
                            else if (turn.Result is null)
                            {
                                <div class="aiCardNote">Running…</div>
                            }
                            else
                            {
                                <div class="aiCardNote">@(turn.ResultIsError ? "Refused. The assistant was told why:" : "Done. The assistant was told:")</div>
                                <pre class="aiCode @(turn.ResultIsError ? "aiCodeRefused" : "")">@turn.Result</pre>

                                @if (turn.Png is string png)
                                {
                                    <img class="aiPicture" src="data:image/png;base64,@png" alt="The picture the assistant was shown" />
                                }

                                @*
                                    What the change did to the file's text, whichever view it was asked for from - asked for
                                    2026-10-21. A Monaco diff, made into this once it is on the page: see showDiffs.
                                *@
                                @if (turn.TextChange is TextChange change)
                                {
                                    <div class="aiCardNote">What it did to the file's text:</div>
                                    <div id="aiTextDiff@(change.Id)" class="aiTextDiff"></div>
                                }
                            }
                        </div>
                    }
                    else if (turn.Kind == ChatTurn.Note || turn.Kind == ChatTurn.Reopened)
                    {
                        <div class="aiTurnNote @fold">@turn.Text</div>
                    }
                    else if (turn.Kind == ChatTurn.Paused)
                    {
                        @*A long run that was working, paused rather than failed (2026-11-01, asked for) - Continue only on the last turn.*@
                        <div class="aiTurnPaused @fold">
                            <span>@turn.Text</span>

                            @if (i == chat.Turns.Count - 1 && !chat.Generating)
                            {
                                <button id="aiContinue" type="button" class="buttonStyle2 smallButton aiContinueButton" @onclick="continueAsync">Continue</button>
                            }
                        </div>

                        @if (turn.Usage is not null)
                        {
                            <div class="aiUsage @fold" title="@usageTitle(turn)">@AiChat.UsageLine(turn)</div>
                        }
                    }
                    else
                    {
                        <div class="aiTurnError @fold">@turn.Text</div>

                        @*A run that failed or was stopped partway was still billed for what it sent.*@
                        @if (turn.Usage is not null)
                        {
                            <div class="aiUsage @fold" title="@usageTitle(turn)">@AiChat.UsageLine(turn)</div>
                        }
                    }
                }

                @if (chat.Compacting)
                {
                    <div id="aiThinking" class="aiThinking">Compacting the conversation…</div>
                }
                else if (chat.Generating)
                {
                    <div id="aiThinking" class="aiThinking">Thinking…</div>
                }
            </div>

            @*
                The slash commands (2026-10-31, asked for): a slash at the start of the box lists what the window can do,
                over the conversation's foot just above the box, narrowed as the name is typed - see the region below.
            *@
            @if (slashShown())
            {
                var offered = slashMatches();

                <div id="aiSlashMenu" class="aiSlashMenu" role="listbox" aria-label="Commands">
                    @for (int i = 0; i < offered.Count; i++)
                    {
                        var command = offered[i];
                        int index = i;

                        <div class="aiSlashItem @(index == slashIndex ? "aiSlashItemOn" : "") @(command.Why is null ? "" : "aiSlashItemOff")"
                             role="option" aria-selected="@(index == slashIndex ? "true" : "false")" data-command="@command.Name"
                             title="@(command.Why ?? command.Says)"
                             @onmouseenter="() => slashIndex = index" @onmousedown:preventDefault="true" @onclick="() => runSlashAsync(command, string.Empty)">
                            <span class="aiSlashName">/@command.Name</span>
                            <span class="aiSlashSays">@(command.Why ?? command.Says)</span>
                        </div>
                    }
                </div>
            }

            @*
                The model menu, from the model's button in the box's row: over the conversation's bottom right as the tool
                picker opens, the saved models with a check on the one picked, then the effort - a row that opens its
                levels in the menu's place - and fast mode on a model that offers it. As the Claude app's (asked for
                2026-11-01). A press anywhere else puts it away (registerBarMenu), and so does Escape.
            *@
            @if (modelMenuOpen)
            {
                <div id="aiModelMenu" class="aiModelMenu" role="menu" aria-label="Model and effort" tabindex="-1" @ref="modelMenuCard" @onkeydown="modelMenuKey">
                    @if (effortListOpen)
                    {
                        <button id="aiModelMenuBack" type="button" class="aiModelMenuItem aiModelMenuBack" @onclick="closeEfforts">
                            <svg class="aiModelMenuChevron" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Effort
                        </button>

                        @foreach (string offered in LlmConnection.EffortLevels(selected).Prepend(""))
                        {
                            string choosing = offered;

                            <button type="button" class="aiModelMenuItem" role="menuitemradio" aria-checked="@(effort == choosing ? "true" : "false")"
                                    data-effort="@choosing" @onclick="() => chooseEffort(choosing)">
                                <span class="aiModelMenuName">@(choosing.Length == 0 ? $"Default ({LlmConnection.DefaultEffort(selected)})" : effortName(choosing))</span>

                                @if (effort == choosing)
                                {
                                    <svg class="aiModelMenuCheck" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        @if (models.Count == 0)
                        {
                            <div id="aiModelMenuNone" class="aiModelMenuNote">No model yet. Add one under Settings, AI settings.</div>
                        }

                        @foreach (var (name, connection) in models)
                        {
                            string choosing = name;
                            bool on = selected?.Name == name;

                            <button type="button" class="aiModelMenuItem" role="menuitemradio" aria-checked="@(on ? "true" : "false")"
                                    data-model="@choosing" @onclick="() => chooseModel(choosing)">
                                <span class="aiModelMenuName">@name</span>
                                <span class="aiModelMenuValue">@providerSaid(connection)</span>

                                @if (on)
                                {
                                    <svg class="aiModelMenuCheck" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                            </button>
                        }

                        @if (effortSaid() is string effortNow)
                        {
                            <div class="aiModelMenuLine"></div>

                            <button id="aiModelMenuEffort" type="button" class="aiModelMenuItem" role="menuitem"
                                    title="How hard the model thinks before answering. Default sends no level, and the model thinks as its provider has it think"
                                    @onclick="openEfforts">
                                <span class="aiModelMenuName">Effort</span>
                                <span class="aiModelMenuValue">@effortNow</span>
                                <svg class="aiModelMenuChevron" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        }

                        @if (LlmConnection.SupportsFast(selected))
                        {
                            <div class="aiModelMenuLine"></div>
                            <div class="aiModelMenuGroup">Fast mode</div>

                            <button id="aiModelMenuFast" type="button" class="aiModelMenuItem" role="menuitemcheckbox" aria-checked="@(fast ? "true" : "false")"
                                    title="The same model, writing up to two and a half times as fast, at twice the price. Anthropic's Opus models only"
                                    @onclick="toggleFast">
                                <span class="aiModelMenuName">Enable fast mode</span>
                                <span class="aiSwitch @(fast ? "aiSwitchOn" : "")" aria-hidden="true"></span>
                            </button>

                            <div class="aiModelMenuNote">Up to 2.5× as fast, at twice the price.</div>
                        }

                        @*Manage models: AI settings, where models are added, changed and taken out (asked for 2026-11-01).*@
                        @if (OnOpenSettings.HasDelegate)
                        {
                            <div class="aiModelMenuLine"></div>

                            <button id="aiModelMenuManage" type="button" class="aiModelMenuItem" role="menuitem" @onclick="manageModelsAsync">
                                <span class="aiModelMenuName">Manage models</span>
                                <svg class="aiModelMenuChevron" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        }
                    }
                </div>
            }

            @*
                The tool picker: the tools the model may use in this conversation, by what they do, and Compact with what it
                costs - see its switch in the box's row. Over the conversation's bottom right, just above the switch; a press
                anywhere else puts it away (registerBarMenu), and so does Escape.
            *@
            @if (pickerOpen)
            {
                <div id="aiToolPicker" class="aiToolPicker" role="dialog" aria-label="Tools and compacting" tabindex="-1" @ref="pickerCard" @onkeydown="pickerKey">
                    <div class="aiToolPickerHead">Tools the assistant may use</div>

                    @foreach (var (title, names) in toolGroups())
                    {
                        <div class="aiToolPickerGroup">
                            <span class="aiToolPickerGroupName">@title</span>
                            <button type="button" class="aiLink" @onclick="() => setTools(names, true)">all</button>
                            <button type="button" class="aiLink" @onclick="() => setTools(names, false)">none</button>
                        </div>

                        <div class="aiToolPickerTools">
                            @foreach (var name in names)
                            {
                                <label class="aiToolPickerTool" title="@toolTitle(name)">
                                    <input type="checkbox" data-tool="@name" checked="@(!chat.ToolsOff.Contains(name))" @onchange="e => toolChanged(name, e)" />
                                    <span>@humanized(name)</span>
                                </label>
                            }
                        </div>
                    }

                    <div class="aiToolPickerNote">
                        A tool switched off is not offered to the model, which is told so. It stays off in the next conversation too,
                        until the page is reloaded.
                    </div>

                    <div class="aiToolPickerHead">This conversation</div>

                    <div class="aiToolPickerAction">
                        <button id="aiCompact" type="button" class="buttonStyle2 smallButton rulesButton" disabled="@(compactBlocked() is not null)"
                                title="Replace the conversation so far with a briefing the assistant carries on from" @onclick="compactAsync">Compact</button>
                        <span id="aiCompactPrice" class="aiToolPickerPrice">@compactLine()</span>
                    </div>
                </div>
            }

            @*
                The files panel: every file this conversation sends, each with a tick - unticked, it stays on screen and stops
                being sent - and the ones waiting for the next question. From ConfigurationRuleEditor (2026-10-29): there it is
                the remedy for a conversation that can take no more, and for one whose old screenshot is paid for again with every
                question. Beside the conversation, or over its right side in a window too narrow for both.
            *@
            @*The files' arrow, in the window's margin on the right, as the chats' is on the left.*@
            <button id="aiFilesToggle" type="button" class="aiSplitToggle aiSplitToggleRight" aria-expanded="@(filesOpen ? "true" : "false")"
                    aria-label="@(filesOpen ? "Collapse the files" : "Open the files")" title="@filesTitle()" @onclick="toggleFiles">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="@(filesOpen ? "M5.75 3.5 10.25 8l-4.5 4.5" : "M10.25 3.5 5.75 8l4.5 4.5")" fill="none" stroke="currentColor" stroke-width="2.2"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                @*How many files the conversation holds, while the panel that lists them is collapsed.*@
                @if (!filesOpen && fileCount() > 0)
                {
                    <span id="aiFilesCount" class="aiFilesCount">@fileCount()</span>
                }
            </button>

            @if (filesOpen)
            {
                <div class="aiSplit" data-split="files" title="Drag to size the files"></div>
            }

            @if (filesOpen)
            {
                <aside id="aiFiles" class="aiFiles" aria-label="Files in this conversation">
                    <div class="aiFilesHead">In this conversation</div>

                    @if (sentWith(false).Count == 0 && sentWith(true).Count > 0)
                    {
                        <div class="aiFilesNone">None sent since it was compacted.</div>
                    }
                    else if (sentWith(false).Count == 0)
                    {
                        <div class="aiFilesNone">None sent yet.</div>
                    }

                    @foreach (var (question, file) in sentWith(false))
                    {
                        <label class="aiFileRow @(file.Excluded ? "aiFileOff" : "")" title="@($"Sent with: {question.Text}")" @key="(file.Id, ticksRefused)">
                            <input type="checkbox" class="aiFileTick" checked="@(!file.Excluded)" @onchange="e => includeChanged(file, e)"
                                   aria-label="@($"Send {file.Name} with every question")" />
                            <span class="aiFileName">@file.Name</span>
                            <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                        </label>
                    }

                    @*
                        The files a compaction kept, on its briefing: read into it once and unticked since, so they stop being
                        paid for with every question - ticked, one goes again, ahead of the briefing. ConfigurationRuleEditor's
                        "From before the summary".
                    *@
                    @if (sentWith(true).Count > 0)
                    {
                        <div class="aiFilesHead">From before the summary</div>

                        @foreach (var (_, file) in sentWith(true))
                        {
                            <label class="aiFileRow @(file.Excluded ? "aiFileOff" : "")" title="Read into the summary when the conversation was compacted. Tick it to send it again with every question" @key="(file.Id, ticksRefused)">
                                <input type="checkbox" class="aiFileTick" checked="@(!file.Excluded)" @onchange="e => includeChanged(file, e)"
                                       aria-label="@($"Send {file.Name} with every question")" />
                                <span class="aiFileName">@file.Name</span>
                                <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                            </label>
                        }
                    }

                    <div class="aiFilesHead">With the next question</div>

                    @if (chat.Pending.Count == 0)
                    {
                        <div class="aiFilesNone">None. Attach one with the paperclip, paste a picture into the box, or drop files here.</div>
                    }

                    @foreach (var file in chat.Pending)
                    {
                        <div class="aiFileRow">
                            <span class="aiFileName" title="@file.Name">@file.Name</span>
                            <span class="aiFileSize">@AiAttachment.Size(file.Data.Length)</span>
                            <button type="button" class="aiChipRemove" aria-label="@($"Take {file.Name} off")" title="Take it off" @onclick="() => unattach(file)">&times;</button>
                        </div>
                    }

                    <div id="aiFilesWeight" class="aiFilesWeight">@filesWeight()</div>
                </aside>
            }
        </div>

        @*
            The suggestion to compact, priced: what the history costs every question now, and what compacting it costs once.
            ConfigurationRuleEditor's - suggested once enough has been asked and the history is long enough to be worth it,
            and put away until the next compaction or a new conversation.
        *@
        @if (suggestCompacting())
        {
            <div id="aiCompactSuggestion" class="aiSuggest">
                <span class="aiSuggestText">@compactSuggestion()</span>
                <button id="aiCompactNow" type="button" class="buttonStyle2 smallButton rulesButton" @onclick="compactAsync">Compact</button>
                <button id="aiCompactLater" type="button" class="aiLink" @onclick="() => chat.CompactSuggestionDismissed = true">Not now</button>
            </div>
        }

        @*The files waiting to go with the next question, each with its cross - the box's own, since that is where they go.*@
        @if (chat.Pending.Count > 0)
        {
            <div id="aiPending" class="aiChips">
                @foreach (var file in chat.Pending)
                {
                    <span class="aiChip @(notSentTo(file) is null ? "" : "aiChipBlocked")" title="@pendingChipTitle(file)">
                        <span class="aiChipName">@file.Name</span>
                        <span class="aiChipSize">@AiAttachment.Size(file.Data.Length)</span>
                        <button type="button" class="aiChipRemove" aria-label="@($"Take {file.Name} off")" title="Take it off" @onclick="() => unattach(file)">&times;</button>
                    </span>
                }
            </div>
        }

        @if (attachProblem.Length > 0)
        {
            <div id="aiAttachProblem" class="aiFormError">@attachProblem</div>
        }

        @if (slashProblem.Length > 0)
        {
            <div id="aiSlashProblem" class="aiFormWarning">@slashProblem</div>
        }

        @if (speechProblem.Length > 0)
        {
            <div id="aiSpeechProblem" class="aiFormError">@speechProblem</div>
        }

        @*The camera, live, over the box: Capture attaches the frame on screen to the next question, and the card goes.*@
        @if (cameraOpen)
        {
            <div id="aiCamera" class="aiCamera" role="dialog" aria-label="Camera" @onkeydown="cameraKey">
                <video id="aiCameraVideo" class="aiCameraVideo" @ref="cameraVideo" autoplay playsinline muted></video>

                @*Pictures rather than words (2026-10-31, asked for): a shutter under the picture, and a cross in the corner.*@
                <button id="aiCameraClose" type="button" class="aiBarButton aiCameraClose" aria-label="Close the camera" title="Close the camera"
                        @onclick="closeCamera">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>

                <div class="aiCameraRow">
                    @if (cameraProblem.Length > 0)
                    {
                        <span id="aiCameraProblem" class="aiFormError">@cameraProblem</span>
                    }
                    else
                    {
                        <button id="aiCameraCapture" type="button" class="aiCameraShutter" aria-label="Capture"
                                title="Take the picture on screen, and attach it to the next question" @onclick="captureAsync">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 5.2a1.2 1.2 0 0 1 1.2-1.2h1.9l1.1-1.6h3.6l1.1 1.6h1.9A1.2 1.2 0 0 1 14 5.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2A1.2 1.2 0 0 1 2 11.8z" />
                                <circle cx="8" cy="8.4" r="2.5" />
                            </svg>
                        </button>
                    }
                </div>
            </div>
        }

        @if (blocked() is string why)
        {
            <div id="aiCannotSend" class="aiFormWarning">@why</div>
        }

        @*
            The box and what goes with the next question, in one rounded frame as the Claude app has it (asked for
            2026-10-31, where a row of bordered fields sat under the box): the words on top, and along the frame's foot a
            slim row of borderless controls - the paperclip and how far the model may go at the start, the effort, the
            model, the (i) and Send at the end. A press anywhere in the frame's spare room puts the caret in the box.
        *@
        <div class="aiBox @(ReadOnly ? "aiBoxOff" : "") @(listening ? "aiBoxListening" : "")" @onclick="focusPrompt">
            <textarea id="aiPrompt" class="aiField aiPrompt" rows="1" @ref="promptBox" data-drop-into="@dropInto()"
                      placeholder="@promptPlaceholder()"
                      title="Enter sends. Shift+Enter starts a new line. A picture pasted here goes with the question"
                      disabled="@ReadOnly" data-slash-menu="@(slashShown() ? "open" : "closed")"
                      @bind="prompt" @bind:event="oninput" @onkeydown="onKey"></textarea>

            @*
                What the microphone hears, while it listens (2026-10-31, asked for, as the Claude app has it): bars that
                rise and fall with the sound, newest on the right, so a muted microphone shows at once. In the box's top
                right corner rather than the row under it (asked for the same day), so nothing in the row moves when it
                comes and goes; the words keep clear of it. Drawn by speech.js, which sets the bars' heights itself rather
                than through a render each tick.
            *@
            @if (listening)
            {
                <span id="aiMicLevel" class="aiMicLevel" @ref="micLevel" aria-hidden="true" title="What the microphone hears">
                    @for (int bar = 0; bar < MicLevelBars; bar++)
                    {
                        <span class="aiMicLevelBar"></span>
                    }
                </span>
            }

            <div class="aiBoxBar">
                @*
                    The paperclip: the browser's own file dialog, through an input of the page's own that a paste into the box
                    and a drop on the conversation go through too, so there is one way in - see attachFiles in floatingWindow.js.
                *@
                <InputFile id="aiAttachInput" style="display: none;" multiple accept="@AiAttachment.Accept" OnChange="filesChosen" disabled="@ReadOnly" />
                <label id="aiAttach" for="aiAttachInput" class="aiBarButton aiAttach @(ReadOnly ? "aiAttachOff" : "")" role="button"
                       aria-label="Attach files" title="@attachTitle()" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path fill="currentColor" d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0z" />
                    </svg>
                </label>

                @*
                    The camera (2026-10-31, asked for): a picture from a webcam, attached to the next question as a pasted one
                    is. Opens the camera in a card over the box; see camera.js.
                *@
                <button id="aiCameraToggle" type="button" class="aiBarButton aiCameraToggle @(cameraOpen ? "aiBarButtonOn" : "")"
                        aria-pressed="@(cameraOpen ? "true" : "false")" aria-label="Take a picture with the camera"
                        title="Take a picture with your camera, and attach it to the next question as a pasted picture is - for a model that sees pictures"
                        disabled="@ReadOnly" @onclick="toggleCamera" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 5.2a1.2 1.2 0 0 1 1.2-1.2h1.9l1.1-1.6h3.6l1.1 1.6h1.9A1.2 1.2 0 0 1 14 5.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2A1.2 1.2 0 0 1 2 11.8z" />
                        <circle cx="8" cy="8.4" r="2.5" />
                    </svg>
                </button>

                @*
                    A screenshot (2026-10-31, asked for): the browser's own picker of a screen, a window or a tab, and one frame
                    of it attached to the next question as a pasted picture is. See camera.js.
                *@
                <button id="aiScreenshot" type="button" class="aiBarButton aiScreenshot" aria-label="Attach a screenshot"
                        title="Take a screenshot - of a screen, a window or a browser tab, picked in your browser's own window - and attach it to the next question, for a model that sees pictures"
                        disabled="@ReadOnly" @onclick="screenshotAsync" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 5V3.2A1.2 1.2 0 0 1 3.2 2H5M11 2h1.8A1.2 1.2 0 0 1 14 3.2V5M14 11v1.8a1.2 1.2 0 0 1-1.2 1.2H11M5 14H3.2A1.2 1.2 0 0 1 2 12.8V11" />
                        <rect x="5" y="5.5" width="6" height="5" rx="0.8" />
                    </svg>
                </button>

                @*
                    How far the model may go on its own. Not remembered between visits: the rung that changes the layout
                    unasked is one nobody should find already on, and putting it back is one choice.
                *@
                <select id="aiMode" class="aiField aiSelect" value="@chat.Mode" @onchange="modeChosen" @onclick:stopPropagation="true" title="@modeHint()">
                    <option value="@ToolApprovalMode.Ask">Ask before every step</option>
                    <option value="@ToolApprovalMode.AutoRead">Ask before changes</option>
                    <option value="@ToolApprovalMode.AutoReadWrite">Change without asking</option>
                </select>

                @*Who answers, rather than what is being said to them - so it sits at the far end, beside Send.*@
                <div class="aiComposerEnd" @onclick:stopPropagation="true">
                    @*
                        The tool picker's switch: three sliders, and how many tools are switched off. ConfigurationRuleEditor's
                        context picker (2026-10-29) - the tools the model may use in this conversation, and Compact, which is
                        done to the conversation rather than sent with it. In this row since 2026-10-31, asked for, where it
                        was the title bar's one switch; its card opens over the conversation's foot, above it.
                    *@
                    <button id="aiToolPickerToggle" type="button" class="aiBarButton aiToolPickerToggle @(pickerOpen ? "aiBarButtonOn" : "")"
                            aria-pressed="@(pickerOpen ? "true" : "false")" aria-label="Tools and compacting" title="@pickerTitle()" @onclick="togglePicker">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                            <line x1="2" y1="4" x2="14" y2="4" stroke-linecap="round" />
                            <line x1="2" y1="8" x2="14" y2="8" stroke-linecap="round" />
                            <line x1="2" y1="12" x2="14" y2="12" stroke-linecap="round" />
                            <circle cx="5.5" cy="4" r="1.7" fill="currentColor" />
                            <circle cx="10.5" cy="8" r="1.7" fill="currentColor" />
                            <circle cx="7" cy="12" r="1.7" fill="currentColor" />
                        </svg>

                        @if (chat.ToolsOff.Count > 0)
                        {
                            <span id="aiToolPickerCount" class="aiFilesCount">@chat.ToolsOff.Count</span>
                        }
                    </button>

                    @*
                        The model and its effort in one button, the effort quieter beside the name, and a bolt while fast
                        mode is on - see the model menu. Only the models that think take an effort, so the rest show the
                        name alone.
                    *@
                    <button id="aiModelMenuToggle" type="button" class="aiModelToggle @(modelMenuOpen ? "aiModelToggleOn" : "")"
                            aria-haspopup="menu" aria-expanded="@(modelMenuOpen ? "true" : "false")" aria-label="AI model"
                            title="@modelMenuTitle()" @onclick="toggleModelMenu">
                        <span id="aiModelChosen" class="aiModelToggleName">@modelSaid()</span>

                        @if (effortSaid() is string level)
                        {
                            <span id="aiModelEffort" class="aiModelToggleEffort">@level</span>
                        }

                        @if (fast)
                        {
                            <svg id="aiModelFast" class="aiModelToggleFast" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M9.2 1.5 3.5 9h4l-1 5.5L12.5 7h-4z" fill="currentColor" />
                            </svg>
                        }

                        <svg class="aiModelToggleArrow" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.5 6.5 8 10l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>

                    @*
                        What the next request costs before it is sent, and what has been spent - ConfigurationRuleEditor's
                        price shown before the spending rather than after, for one conversation (2026-10-29, asked for). The
                        (i) shows it in a card while it is pointed at, and a press on it puts it on a line of its own under
                        the box, or takes it off again (2026-10-31; a card that opened on a press the day before). The rates
                        are the picked model's, with a link to where its provider publishes them.
                    *@
                    @if (meterShown())
                    {
                        <div class="aiMeterHolder">
                            <button id="aiMeterToggle" type="button" class="aiBarButton @(meterOn ? "aiBarButtonOn" : "")"
                                    aria-pressed="@(meterOn ? "true" : "false")" aria-label="@meterLabel()" @onclick="toggleMeter">
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                                    <circle cx="8" cy="4.9" r="0.9" fill="currentColor" />
                                    <path d="M8 7.2v4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                            </button>

                            @*Only while the line is off: with it on, the card would say what is already under the box.*@
                            @if (!meterOn)
                            {
                                <div id="aiMeterCard" class="aiMeterCard" role="tooltip">
                                    <span class="aiMeterNote">@meterHint()</span>
                                    @meterLines()
                                </div>
                            }
                        </div>
                    }

                    @*
                        Send and Stop are one button: Stop while an answer is coming, Send the rest of the time. The press
                        that sent a message is where the press that stops it goes, rather than on a second button that
                        appeared beside a grayed Send and pushed the row along. Asked 2026-10-18. One element in both
                        states, so a Send pressed with the pointer keeps its focus as it turns into Stop - see sendOrStop
                        for the double-click that would stop it. An arrow since 2026-10-31, and a square while it stops, on a rounded square.
                    *@
                    <button id="aiSend" class="aiSendStop @(chat.Generating ? "aiSendStopping" : "")" aria-label="@(chat.Generating ? "Stop" : "Send")"
                            @onclick="sendOrStop" disabled="@(!chat.Generating && !canSend())" title="@sendTitle()">
                        @if (chat.Generating)
                        {
                            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4.5" y="4.5" width="7" height="7" rx="1" fill="currentColor" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8 13V3.5M3.8 7.6 8 3.4l4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </button>

                    @*
                        The microphone (2026-10-31, asked for): speech into the box, by the browser's own recognition as the words
                        are said, or recorded and written out by the AI provider - chosen under Settings, AI settings, and said on
                        the button when pointed at. Red while it listens. The last of the row, after Send (asked for the same day).
                        See speech.js and SpeechTranscriber.
                    *@
                    <button id="aiMic" type="button" class="aiBarButton aiMic @(listening ? "aiMicOn" : "") @(transcribing ? "aiMicBusy" : "") @(micUsable() ? "" : "aiMicOff")"
                            aria-pressed="@(listening ? "true" : "false")" aria-label="@micLabel()" title="@micTitle()"
                            disabled="@(ReadOnly || transcribing)" @onclick="micAsync" @onclick:stopPropagation="true">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                            <rect x="5.75" y="1.75" width="4.5" height="8" rx="2.25" />
                            <path d="M3.6 7.6a4.4 4.4 0 0 0 8.8 0M8 12v2.2M5.9 14.2h4.2" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        @if (meterShown() && meterOn)
        {
            <div id="aiMeter" class="aiMeter">
                @meterLines()
            </div>
        }
    </ChildContent>
</FloatingWindow>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    ///<summary>The file that is open, which the tools work on. Null when there is none.</summary>
    [Parameter]
    public GDS? Gds { get; set; }

    ///<summary>How many times the file has been written from the text view: a new count is a fresh start, see OnParametersSet.</summary>
    [Parameter]
    public int FileRewrites { get; set; }

    ///<summary>The page's undo history, which every change the model makes goes onto.</summary>
    [Parameter]
    public EditHistory History { get; set; } = new EditHistory();

    [Parameter]
    public string FileName { get; set; } = "";

    ///<summary>Whether the page has said the file may not be changed, in which case the assistant is off.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    ///<summary>The rule deck loaded, if any - each change is checked against it.</summary>
    [Parameter]
    public DrcDeck? Deck { get; set; }

    ///<summary>The deck's rules switched off in the rules panel, which the assistant's checks leave out too.</summary>
    [Parameter]
    public IReadOnlySet<string> RulesOff { get; set; } = new HashSet<string>();

    ///<summary>The faults waived in the rules panel, which the assistant is not told to fix - see AgentSession.Waived.</summary>
    [Parameter]
    public IReadOnlySet<string> Waived { get; set; } = new HashSet<string>();

    ///<summary>What the page knows about where the person is - the cell, the selection, the view - for the prompt.</summary>
    [Parameter]
    public Func<AgentSession, Task<LayoutFacts>>? Describe { get; set; }

    ///<summary>Draws a picture for the look tool, or null when there is no way to.</summary>
    [Parameter]
    public Func<LookRequest, CancellationToken, Task<LlmToolOutput>>? Look { get; set; }

    ///<summary>The example layouts the app ships, for list_examples and read_example - see ExampleTools. Null for none.</summary>
    [Parameter]
    public ExampleLibrary? Examples { get; set; }

    ///
    ///Asked before anything is sent whether the file is ready to be read: in the text view, what has been typed is
    ///saved into it first. False when it could not be, and nothing is sent - the words stay in the box to send again.
    ///
    [Parameter]
    public Func<Task<bool>>? BeforeSend { get; set; }

    ///<summary>Told after every change the model makes, with the shapes it made, so the page draws it and picks them out.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<GDS.ElementModel>> OnLayoutChanged { get; set; }

    [Parameter]
    public EventCallback OnOpenSettings { get; set; }

    ///<summary>The PDK whose design rules the assistant reads and adds to, or null where there is none - see RuleTools.</summary>
    [Parameter]
    public RuleBook? Rules { get; set; }

    ///<summary>The person's PDKs, which use_pdk puts in use, or null where there are none to choose - see PdkTools.</summary>
    [Parameter]
    public PdkShelf? Pdks { get; set; }

    ///
    ///Puts words in the box to send, as a press elsewhere asks - the PDK manager's Write with AI - unless something of the
    ///person's own is being written there already, which is not thrown away for it.
    ///
    public void Offer(string text)
    {
        if (!string.IsNullOrWhiteSpace(prompt))
            return;

        prompt = text;
        composerSized = false;

        StateHasChanged();
    }

    private readonly AiChat chat = new AiChat();

    ///<summary>The id the chat on screen is kept under, or null until its first question is sent - see keepChatAsync.</summary>
    private string? chatId;

    ///<summary>When the chat on screen was first kept.</summary>
    private DateTime chatCreated;

    ///
    ///Counts the chats put on screen, so an answer that comes in after another chat was opened or started is not kept
    ///under the new one's id. Nothing can be switched while an answer is coming, but a reply arriving as Stop lands is
    ///the case this is for.
    ///
    private int chatShown;

    ///<summary>The chats kept, for the panel - read again whenever the service says they changed.</summary>
    private List<ChatSummary> chats = new List<ChatSummary>();

