    protected override async Task OnInitializedAsync()
    {
        chat.Changed += redraw;
        ai.ChatsChanged += chatsChanged;
        speech.Changed += speechChanged;

        speechMode = await speech.GetAsync();

        ai.ModelsChanged += modelsChanged;
        models = await ai.LoadModelsAsync();
        picked(models.Values.FirstOrDefault());

        await chatsChanged();
    }

    public void Dispose()
    {
        ai.ModelsChanged -= modelsChanged;
        chat.Changed -= redraw;
        ai.ChatsChanged -= chatsChanged;
        speech.Changed -= speechChanged;
        chat.Cancel();
        transcribeStop?.Cancel();
        handle?.Dispose();

        try
        {
            _ = js.InvokeVoidAsync("gdsSpeech.cancel");
            _ = js.InvokeVoidAsync("gdsCamera.close");
        }
        catch { }
