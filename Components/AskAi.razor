    ///
    ///Compact, from the picker or the suggestion: the conversation so far replaced by a briefing - see AiChat.CompactAsync.
    ///At the least effort a model takes, since a briefing carries facts across rather than reasoning about them.
    ///
    private async Task compactAsync()
    {
        if (compactBlocked() is not null || selected is null)
            return;

        pickerOpen = false;

        string least = "";

        if (LlmConnection.SupportsEffort(selected))
            least = "low";

        var provider = ai.CreateProvider(new LlmConnection(selected) { Effort = least });
        int shown = chatShown;

        if (await chat.CompactAsync(provider) == ChatOutcome.Answered)
            showEarlier = false;

        if (shown == chatShown)
            await keepChatAsync();
    }

