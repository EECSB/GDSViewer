    ///
    ///Keeps the chat on screen, under the id it was first kept with - from its first question on, after every answer
    ///and every compaction. A chat with no question in it is not kept: an empty one, or one where nothing was sent.
    ///
    private async Task keepChatAsync()
    {
        if (!chat.Turns.Any(turn => turn.Kind == ChatTurn.User))
            return;

        var now = DateTime.UtcNow;

        if (chatId is null)
        {
            chatId = SavedChat.NewId();
            chatCreated = now;
        }

        var kept = new SavedChat
        {
            Id = chatId,
            Title = SavedChat.TitleFor(chat.Turns),
            FileName = FileName,
            Created = chatCreated,
            Updated = now,
            Turns = SavedChat.Keep(chat.Turns)
        };

        try
        {
            await ai.SaveChatAsync(kept);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not keep the chat: {ex.Message}");
        }
    }

    ///
    ///A new chat in the window - the one that was on screen already kept, since it is kept after every answer. What
    ///Clear was, with nothing thrown away, so it asks nothing first.
    ///
    private async Task newChatAsync()
    {
        if (!canLeaveChat())
            return;

        await showChatAsync(null, Enumerable.Empty<ChatTurn>(), null);
    }

    ///<summary>Opens a kept chat, to read and carry on - with a line saying so, since its shape numbers were another session's.</summary>
    private async Task openChatAsync(string id)
    {
        if (id == chatId || !canLeaveChat())
            return;

        deletingId = null;

        SavedChat? kept = null;

        try
        {
            kept = await ai.LoadChatAsync(id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not open the chat: {ex.Message}");
        }

        //Gone from where it was kept - deleted in another tab, say. The list has been read again without it.
        if (kept is null)
        {
            await chatsChanged();

            return;
        }

        await showChatAsync(kept, kept.Unkept(), reopenedLine(kept));
    }

    ///<summary>What a reopened chat says where it was opened: which layout is open now, when that is not the one it was about.</summary>
    private string reopenedLine(SavedChat kept)
    {
        if (Gds is null)
            return "Opened again, with no layout open.";

        if (kept.FileName.Length > 0 && kept.FileName != FileName)
            return $"Opened again with {FileName} open - it was about {kept.FileName}.";

        return "Opened again.";
    }

    ///
    ///Puts a chat on screen in place of the one there: a kept one, or a new one when <paramref name="kept"/> is null.
    ///Either way the shapes are numbered afresh, as a new file numbers them, and the diffs on the cards go with them.
    ///
    private async Task showChatAsync(SavedChat? kept, IEnumerable<ChatTurn> turns, string? reopened)
    {
        chatShown++;

        if (kept is null)
        {
            chat.Clear();
            chatId = null;
            chatCreated = default;
        }
        else
        {
            chat.Restore(turns, reopened);
            chatId = kept.Id;
            chatCreated = kept.Created;
        }

        session = null;
        attachProblem = "";
        showEarlier = false;
        diffsShown.Clear();

        try
        {
            await js.InvokeVoidAsync("disposeTextDiffs");
        }
        catch { }
    }

    ///
    ///Saves a chat as text, to read back or paste in another day - ConfigurationRuleEditor's Export, from the chat's own
    ///row since 2026-10-31. The one on screen is saved as it stands; another is read from where it is kept.
    ///
    private async Task exportChatAsync(ChatSummary row)
    {
        var transcript = chat;
        string fileName = FileName;

        if (row.Id != chatId)
        {
            SavedChat? kept = null;

            try
            {
                kept = await ai.LoadChatAsync(row.Id);
            }
            catch { }

            if (kept is null)
            {
                await chatsChanged();

                return;
            }

            transcript = new AiChat();
            transcript.Restore(kept.Unkept(), null);
            fileName = kept.FileName;
        }

        await exportAsync(transcript, fileName);
    }

    ///<summary>Downloads a chat as text, named for its file and when - the chat on screen for /export, or a row's.</summary>
    private async Task exportAsync(AiChat transcript, string fileName)
    {
        if (transcript.Turns.Count == 0 || transcript.Generating)
            return;

        var now = DateTime.Now;
        string stamp = now.ToString("yyyyMMdd-HHmm", System.Globalization.CultureInfo.InvariantCulture);
        string subject = Path.GetFileNameWithoutExtension(fileName);
        string name = $"ai-assistant-{stamp}.txt";

        if (subject.Length > 0)
            name = $"ai-assistant-{subject}-{stamp}.txt";

        try
        {
            await js.InvokeVoidAsync("BlazorDownloadFile", name, "text/plain", transcript.Transcript(fileName, now));
        }
        catch (JSException ex)
        {
            //Said in the chat, where the export was asked for: a download that did not happen and nothing said is
            //a press on a button that did nothing.
            transcript.Refuse($"The export could not be downloaded: {ex.Message}");

            await redraw();
        }
    }

    ///<summary>Throws a chat away, once its row has been asked. The one on screen gives way to a new one.</summary>
    private async Task deleteChatAsync(string id)
    {
        deletingId = null;

        if (id == chatId)
        {
            if (!canLeaveChat())
                return;

            await newChatAsync();
        }

        try
        {
            await ai.DeleteChatAsync(id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not delete the chat: {ex.Message}");
        }
    }

