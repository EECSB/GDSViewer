    ///
    ///Another file opened under the conversation: whatever is running stops, the tools' session goes with the file it
    ///was about, and the transcript gets a line saying the model starts afresh - see AiChat.StartAfresh.
    ///
    protected override void OnParametersSet()
    {
        //
        //**A file written from the text view is every record new under the same object**, which is how this tells one
        //file from another - so the shell counts the writes, and one is the same fresh start another file is: the
        //session's shape numbers name nothing in the records that replaced theirs.
        //
        if (FileRewrites != seenRewrites)
        {
            seenRewrites = FileRewrites;
            session = null;

            if (Gds is not null && ReferenceEquals(Gds, seenGds))
                chat.StartAfresh("The file was saved from the text view, so the assistant starts afresh with it: what was said above is not sent again, and shape numbers start over.");
        }

        if (ReferenceEquals(Gds, seenGds))
            return;

        bool hadFile = seenGds is not null;

        seenGds = Gds;
        session = null;

        if (!hadFile)
            return;

        if (Gds is null)
            chat.StartAfresh("The file was closed, so the assistant starts afresh: what was said above is not sent again.");
        else
            chat.StartAfresh("Another file is open now, so the assistant starts afresh with it: what was said above is not sent again, and shape numbers start over.");
    }

    ///<summary>One attachment of the box to the page's scripts, said to the console by name when it fails - see OnAfterRenderAsync.</summary>
    private async Task attachAsync(string function, params object?[] arguments)
    {
        try
        {
            await js.InvokeVoidAsync(function, arguments);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"{function} failed, so that part of the AI assistant's window is not wired up: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!composerAttached)
        {
            composerAttached = true;

            handle = DotNetObjectReference.Create(this);

            //
            //Each attachment on its own, so one that fails costs itself and not the five after it - one try round
            //all six left the tool picker's menu, the splits and the microphone unattached when the composer's
            //script threw, and said nothing. What failed goes to the console with its name.
            //
            await attachAsync("floatingWindow.attachComposer", promptBox, 200);
            await attachAsync("floatingWindow.attachFiles", promptBox, "aiAttachInput");
            await attachAsync("registerBarMenu", handle, "aiToolPicker", "aiToolPickerToggle", "OnPickerDismissed");
            await attachAsync("registerBarMenu", handle, "aiModelMenu", "aiModelMenuToggle", "OnModelMenuDismissed");
            await attachAsync("floatingWindow.attachSplits", chatRow);

            try
            {
                browserSpeech = await js.InvokeAsync<bool>("gdsSpeech.browserSupported");
            }
            catch (JSException ex)
            {
                Console.WriteLine($"gdsSpeech.browserSupported failed, so the microphone is taken as unavailable: {ex.Message}");
            }

            StateHasChanged();
        }

        //A hidden window gives what is in it no height, so the box is measured once it is on screen - which is not
        //the first render, the window being hidden rather than not there.
        if (Visible && !composerSized)
        {
            composerSized = true;

            try
            {
                await js.InvokeVoidAsync("floatingWindow.growComposer", promptBox);
            }
            catch { }
        }
        else if (!Visible)
        {
            composerSized = false;
        }

        if (listening && !micLevelStarted)
        {
            micLevelStarted = true;

            try
            {
                await js.InvokeVoidAsync("gdsSpeech.showLevel", micLevel);
            }
            catch { }
        }
        else if (!listening)
        {
            micLevelStarted = false;
        }

        if (cameraOpen && !cameraStarted)
        {
            cameraStarted = true;

            try
            {
                cameraProblem = await js.InvokeAsync<string>("gdsCamera.open", cameraVideo);
            }
            catch (Exception ex)
            {
                cameraProblem = $"The camera could not be opened: {ex.Message}";
            }

            if (cameraProblem.Length > 0)
                StateHasChanged();
        }

        if (focusPicker)
        {
            focusPicker = false;

            try
            {
                await pickerCard.FocusAsync();
            }
            catch { }
        }

        if (focusModelMenu)
        {
            focusModelMenu = false;

            try
            {
                await modelMenuCard.FocusAsync();
            }
            catch { }
        }

        await showDiffs();

        string now = transcriptState();

        if (now == scrolledFor)
            return;

        scrolledFor = now;

        try
        {
            await js.InvokeVoidAsync("floatingWindow.scrollToEnd", scroller);
        }
        catch { }
    }

    ///
    ///The diffs of the cards that have just had one, each made once into the element its card has for it - see
    ///showTextDiff in MonacoInterop.js, which loads Monaco the first time, in whichever view the change came from.
    ///
    ///**Over a copy of the conversation, not the conversation.** Each diff is awaited, and the first loads Monaco, which
    ///takes seconds - while the run goes on adding cards. Walking the live list across that await threw the moment the
    ///next card came in, and took the page down with it: a rectangle approved, and the delete the model asked for next
    ///arriving while the rectangle's diff was still being drawn (2026-10-21).
    ///
    private async Task showDiffs()
    {
        foreach (var turn in chat.Turns.ToList())
        {
            if (turn.TextChange is not TextChange change || !diffsShown.Add(change.Id))
                continue;

            try
            {
                await js.InvokeVoidAsync("showTextDiff", $"aiTextDiff{change.Id}", change.Before, change.After, change.FirstLine);
            }
            catch { }
        }
    }

