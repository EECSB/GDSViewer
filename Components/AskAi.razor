    ///<summary>The tools by what they do, in the order the library lists them - with look among the reading ones, where there is a way to draw it.</summary>
    private List<(string Title, List<string> Names)> toolGroups()
    {
        var reading = new List<string>();
        var changing = new List<string>();

        foreach (var tool in AgentTools.All)
        {
            if (tool.Edits)
                changing.Add(tool.Name);
            else
                reading.Add(tool.Name);
        }

        if (Look is not null)
            reading.Add(LayoutToolRunner.LookName);

        var groups = new List<(string Title, List<string> Names)> { ("Reading the layout", reading), ("Changing it", changing) };

        if (Rules is not null)
        {
            groups.Add(("The PDK's design rules", new List<string> { RuleTools.ReadName, RuleTools.AddName }));
            groups.Add(("The PDK's layers", new List<string> { LayerTools.ReadName, LayerTools.SetName }));
        }

        if (Examples is not null)
            groups.Add(("The app's examples", new List<string> { ExampleTools.ListName, ExampleTools.ReadName }));

        if (Pdks is not null)
            groups.Add(("The PDK in use", new List<string> { PdkTools.UseName }));

        return groups;
    }

